import "collections"
import "string"

define main returning Int:
    set m to create_map()
    display f"empty: {map_size(m)}"
    set ok to map_insert(m and "a" and 1)
    display f"1 entry: {map_size(m)}"
    set ok to map_insert(m and "b" and 2)
    display f"2 entries: {map_size(m)}"
    set ok to map_insert(m and "a" and 3)
    display f"overwrite a: {map_size(m)}"
    return 0
