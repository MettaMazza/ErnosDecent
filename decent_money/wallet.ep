# ErnosDecent -- Cryptographic Wallet
# Component: decent_money/wallet.ep
# Implements: BIP39 mnemonic generation, PBKDF2 seed derivation, BIP44/SLIP0010 HD key derivation, keystore encryption
# Status: Production -- OperationTrojanClaude Phase 8

import "../decent_id/keys"
import "../stdlib/bridge/libsodium"
import "string"

# Helper to perform bitwise XOR arithmetically
define byte_xor with a as Int and b as Int returning Int:
    set res to 0
    set bit to 1
    set temp_a to a
    set temp_b to b
    repeat while bit < 256:
        set bit_a to temp_a modulo 2
        set bit_b to temp_b modulo 2
        if bit_a != bit_b:
            set res to res + bit
        set temp_a to temp_a / 2
        set temp_b to temp_b / 2
        set bit to bit * 2
    return res

# HMAC-SHA512 implementation
define hmac_sha512 with key_ptr as Int and key_len as Int and data_ptr as Int and data_len as Int and out_ptr as Int returning Int:
    set block_size to 128
    set hash_size to 64
    
    set padded_key to alloc_bytes(block_size)
    if key_len > block_size:
        sodium_sha512(padded_key and key_ptr and key_len)
    else:
        set i to 0
        repeat while i < key_len:
            poke_byte(padded_key and i and peek_byte(key_ptr and i))
            set i to i + 1
            
    set inner_input to alloc_bytes(block_size + data_len)
    set outer_input to alloc_bytes(block_size + hash_size)
    
    set i to 0
    repeat while i < block_size:
        set k_byte to peek_byte(padded_key and i)
        poke_byte(inner_input and i and byte_xor(k_byte and 54)) # 0x36 = 54
        poke_byte(outer_input and i and byte_xor(k_byte and 92)) # 0x5C = 92
        set i to i + 1
        
    set i to 0
    repeat while i < data_len:
        poke_byte(inner_input and block_size + i and peek_byte(data_ptr and i))
        set i to i + 1
        
    set inner_hash to alloc_bytes(hash_size)
    sodium_sha512(inner_hash and inner_input and block_size + data_len)
    
    set i to 0
    repeat while i < hash_size:
        poke_byte(outer_input and block_size + i and peek_byte(inner_hash and i))
        set i to i + 1
        
    sodium_sha512(out_ptr and outer_input and block_size + hash_size)
    
    free_bytes(padded_key)
    free_bytes(inner_input)
    free_bytes(outer_input)
    free_bytes(inner_hash)
    return 0

# PBKDF2-HMAC-SHA512 implementation
define pbkdf2_sha512 with pass_ptr as Int and pass_len as Int and salt_ptr as Int and salt_len as Int and iterations as Int and out_ptr as Int returning Int:
    set hash_size to 64
    set u_input_len to salt_len + 4
    set u_input to alloc_bytes(u_input_len)
    
    set i to 0
    repeat while i < salt_len:
        poke_byte(u_input and i and peek_byte(salt_ptr and i))
        set i to i + 1
    poke_byte(u_input and salt_len and 0)
    poke_byte(u_input and salt_len + 1 and 0)
    poke_byte(u_input and salt_len + 2 and 0)
    poke_byte(u_input and salt_len + 3 and 1)
    
    set u to alloc_bytes(hash_size)
    hmac_sha512(pass_ptr and pass_len and u_input and u_input_len and u)
    
    set i to 0
    repeat while i < hash_size:
        poke_byte(out_ptr and i and peek_byte(u and i))
        set i to i + 1
        
    set next_u to alloc_bytes(hash_size)
    set iter to 1
    repeat while iter < iterations:
        hmac_sha512(pass_ptr and pass_len and u and hash_size and next_u)
        
        set i to 0
        repeat while i < hash_size:
            set current_out to peek_byte(out_ptr and i)
            set nu_val to peek_byte(next_u and i)
            poke_byte(out_ptr and i and byte_xor(current_out and nu_val))
            poke_byte(u and i and nu_val)
            set i to i + 1
            
        set iter to iter + 1
        
    free_bytes(u_input)
    free_bytes(u)
    free_bytes(next_u)
    return 0

# SLIP-0010 Ed25519 Master node derivation
define derive_master_node with seed_bytes as Int and seed_len as Int and master_key as Int and master_chain as Int returning Int:
    set key_str to "ed25519 seed"
    set hmac_out to alloc_bytes(64)
    hmac_sha512(str_to_ptr(key_str) and 12 and seed_bytes and seed_len and hmac_out)
    
    set i to 0
    repeat while i < 32:
        poke_byte(master_key and i and peek_byte(hmac_out and i))
        poke_byte(master_chain and i and peek_byte(hmac_out and 32 + i))
        set i to i + 1
        
    free_bytes(hmac_out)
    return 0

# SLIP-0010 Ed25519 Hardened Child node derivation
define derive_slip010_child with parent_key as Int and parent_chain as Int and index as Int and child_key as Int and child_chain as Int returning Int:
    set data_len to 37
    set data to alloc_bytes(data_len)
    
    poke_byte(data and 0 and 0)
    set i to 0
    repeat while i < 32:
        poke_byte(data and 1 + i and peek_byte(parent_key and i))
        set i to i + 1
        
    poke_byte(data and 33 and (index / 16777216) modulo 256)
    poke_byte(data and 34 and (index / 65536) modulo 256)
    poke_byte(data and 35 and (index / 256) modulo 256)
    poke_byte(data and 36 and index modulo 256)
    
    set hmac_out to alloc_bytes(64)
    hmac_sha512(parent_chain and 32 and data and data_len and hmac_out)
    
    set i to 0
    repeat while i < 32:
        poke_byte(child_key and i and peek_byte(hmac_out and i))
        poke_byte(child_chain and i and peek_byte(hmac_out and 32 + i))
        set i to i + 1
        
    free_bytes(data)
    free_bytes(hmac_out)
    return 0

define raw_to_hex with buf_ptr as Int and buf_len as Int returning Str:
    set hex_chars to create_list()
    set i to 0
    repeat while i < buf_len:
        set byte_val to peek_byte(buf_ptr and i)
        set hi to byte_val / 16
        set lo to byte_val modulo 16
        set hi_ch to get_character("0123456789abcdef" and hi)
        set lo_ch to get_character("0123456789abcdef" and lo)
        set ok to append_list(hex_chars and hi_ch)
        set ok to append_list(hex_chars and lo_ch)
        set i to i + 1
    return string_from_list(hex_chars)

define hex_char_to_int with ch as Int returning Int:
    if ch >= 48:
        if ch <= 57:
            return ch - 48
    if ch >= 97:
        if ch <= 102:
            return ch - 87
    if ch >= 65:
        if ch <= 70:
            return ch - 55
    return 0

define hex_to_raw with hex_str as Str and out_ptr as Int and out_max as Int returning Int:
    set hex_len to string_length(hex_str)
    set byte_count to hex_len / 2
    if byte_count > out_max:
        set byte_count to out_max
    set i to 0
    repeat while i < byte_count:
        set hi to hex_char_to_int(get_character(hex_str and i * 2))
        set lo to hex_char_to_int(get_character(hex_str and i * 2 + 1))
        poke_byte(out_ptr and i and hi * 16 + lo)
        set i to i + 1
    return byte_count

# Generate BIP39 mnemonic
define wallet_generate_mnemonic returning Str:
    set err to init_crypto()
    if err != 0:
        return ""
        
    set entropy to alloc_bytes(32)
    sodium_randombytes_buf(entropy and 32)
    
    set hash_out to alloc_bytes(32)
    sodium_sha256(hash_out and entropy and 32)
    set checksum to peek_byte(hash_out and 0)
    
    set indices to create_list()
    set bit_bucket to 0
    set bit_count to 0
    
    set byte_idx to 0
    repeat while byte_idx < 33:
        set byte_val to 0
        if byte_idx < 32:
            set byte_val to peek_byte(entropy and byte_idx)
        else:
            set byte_val to checksum
            
        set bit_bucket to bit_bucket * 256 + byte_val
        set bit_count to bit_count + 8
        
        repeat while bit_count >= 11:
            set shift to bit_count - 11
            set div to 1
            set s_idx to 0
            repeat while s_idx < shift:
                set div to div * 2
                set s_idx to s_idx + 1
            set index to (bit_bucket / div) modulo 2048
            set ok to append_list(indices and index)
            set bit_bucket to bit_bucket modulo div
            set bit_count to bit_count - 11
            
        set byte_idx to byte_idx + 1
        
    set word_list to split(get_bip39_words() and " ")
    
    set mnemonic to ""
    set i to 0
    repeat while i < 24:
        set idx to get_list(indices and i)
        set word to get_list(word_list and idx)
        if i == 0:
            set mnemonic to word
        else:
            set mnemonic to concat(mnemonic and " ")
            set mnemonic to concat(mnemonic and word)
        set i to i + 1
        
    free_bytes(entropy)
    free_bytes(hash_out)
    free_list(indices)
    free_list(word_list)
    return mnemonic

# Derive Seed from mnemonic
define wallet_mnemonic_to_seed with mnemonic as Str and passphrase as Str returning Str:
    set salt to concat("mnemonic" and passphrase)
    set out_buf to alloc_bytes(64)
    
    pbkdf2_sha512(str_to_ptr(mnemonic) and string_length(mnemonic) and str_to_ptr(salt) and string_length(salt) and 2048 and out_buf)
    set seed_hex to raw_to_hex(out_buf and 64)
    free_bytes(out_buf)
    return seed_hex

# Derive keypair using BIP44 path (SLIP-0010)
define wallet_derive_keypair with seed_hex as Str and path as Str returning Map:
    set result to create_map()
    
    set seed_bytes to alloc_bytes(64)
    hex_to_raw(seed_hex and seed_bytes and 64)
    
    set current_key to alloc_bytes(32)
    set current_chain to alloc_bytes(32)
    derive_master_node(seed_bytes and 64 and current_key and current_chain)
    
    set parts to split(path and "/")
    set parts_len to length_list(parts)
    
    set i to 1
    set err to 0
    repeat while i < parts_len:
        set part to get_list(parts and i)
        set part_len to string_length(part)
        if part_len == 0:
            set err to 1
            set i to parts_len
        else:
            set is_hardened to 0
            set index_str to part
            set last_char to get_character(part and part_len - 1)
            if last_char == 39: # '\''
                set is_hardened to 1
                set index_str to substring(part and 0 and part_len - 1)
            else:
                if last_char == 104: # 'h'
                    set is_hardened to 1
                    set index_str to substring(part and 0 and part_len - 1)
            
            set index to string_to_int(index_str)
            if is_hardened == 1:
                set index to index + 2147483648
                
            set child_key to alloc_bytes(32)
            set child_chain to alloc_bytes(32)
            derive_slip010_child(current_key and current_chain and index and child_key and child_chain)
            
            set copy_idx to 0
            repeat while copy_idx < 32:
                poke_byte(current_key and copy_idx and peek_byte(child_key and copy_idx))
                poke_byte(current_chain and copy_idx and peek_byte(child_chain and copy_idx))
                set copy_idx to copy_idx + 1
                
            free_bytes(child_key)
            free_bytes(child_chain)
            set i to i + 1
            
    free_list(parts)
    free_bytes(seed_bytes)
    free_bytes(current_chain)
    
    if err != 0:
        free_bytes(current_key)
        set ok to map_insert(result and "error" and 1)
        return result
        
    set pk_buf to alloc_bytes(32)
    set sk_buf to alloc_bytes(64)
    if pk_buf == 0 or else sk_buf == 0:
        free_bytes(current_key)
        free_bytes(pk_buf)
        free_bytes(sk_buf)
        set ok to map_insert(result and "error" and 2)
        return result
    
    set fn_seed_kp to ep_dlsym(SODIUM_HANDLE and "crypto_sign_seed_keypair")
    if fn_seed_kp == 0:
        free_bytes(current_key)
        free_bytes(pk_buf)
        free_bytes(sk_buf)
        set ok to map_insert(result and "error" and 3)
        return result
    set keypair_err to ep_dlcall3(fn_seed_kp and pk_buf and sk_buf and current_key)
    if keypair_err != 0:
        free_bytes(current_key)
        free_bytes(pk_buf)
        free_bytes(sk_buf)
        set ok to map_insert(result and "error" and 4)
        return result
    
    set pub_hex to raw_to_hex(pk_buf and 32)
    set sec_hex to raw_to_hex(sk_buf and 64)
    
    free_bytes(current_key)
    free_bytes(pk_buf)
    free_bytes(sk_buf)
    
    set ok to map_insert(result and "public_key" and pub_hex)
    set ok to map_insert(result and "secret_key" and sec_hex)
    set ok to map_insert(result and "error" and 0)
    return result

# Encrypt keystore using derived storage key
define wallet_encrypt_keystore with keypair as Map and passphrase as Str returning Str:
    # Generate 16-byte random salt
    set salt_buf to alloc_bytes(16)
    sodium_randombytes_buf(salt_buf and 16)
    set salt_hex to raw_to_hex(salt_buf and 16)
    free_bytes(salt_buf)
    
    # Derive storage key from passphrase via PBKDF2
    set storage_key to keys_pbkdf2_hmac_sha256(passphrase and salt_hex and 10000)
    set verify_hash to ep_sha256(storage_key)
    
    set pub_key to map_get_val(keypair and "public_key")
    set sec_key to map_get_val(keypair and "secret_key")
    
    set enc_res to encrypt_symmetric(sec_key and storage_key)
    set ct to map_get_val(enc_res and "ciphertext")
    set nc to map_get_val(enc_res and "nonce")
    
    set j to "{\n"
    set j to concat(j and "  \"magic\": \"ERNOSDECENT_WALLET_V1\",\n")
    set j to concat(j and f"  \"salt\": \"{salt_hex}\",\n")
    set j to concat(j and f"  \"passphrase_verify\": \"{verify_hash}\",\n")
    set j to concat(j and f"  \"public_key\": \"{pub_key}\",\n")
    set j to concat(j and f"  \"encrypted_sk\": \"{ct}\",\n")
    set j to concat(j and f"  \"nonce\": \"{nc}\"\n")
    set j to concat(j and "}")
    
    free_map(enc_res)
    return j

# Decrypt keystore
define wallet_decrypt_keystore with keystore_str as Str and passphrase as Str returning Map:
    set result to create_map()
    
    set salt_hex to json_get_string(keystore_str and "salt")
    set storage_key to ""
    set verify_expected to json_get_string(keystore_str and "passphrase_verify")
    set verify_actual to ""
    
    if string_length(salt_hex) == 0:
        # Fallback to old KDF (plain SHA256) for backward compatibility
        set storage_key to ep_sha256(passphrase)
        set verify_actual to ep_sha256(storage_key)
    else:
        # PBKDF2 KDF
        set storage_key to keys_pbkdf2_hmac_sha256(passphrase and salt_hex and 10000)
        set verify_actual to ep_sha256(storage_key)
    
    if verify_actual equals verify_expected:
        set pass_ok to 1
    else:
        set ok to map_insert(result and "error" and 10) # ERR_PASSPHRASE_WRONG = 10
        return result
        
    set pub_key to json_get_string(keystore_str and "public_key")
    set ct to json_get_string(keystore_str and "encrypted_sk")
    set nc to json_get_string(keystore_str and "nonce")
    
    set dec_res to decrypt_symmetric(ct and nc and storage_key)
    set dec_err to map_get_val(dec_res and "error")
    
    if dec_err != 0:
        set ok to map_insert(result and "error" and dec_err)
        free_map(dec_res)
        return result
        
    set sec_key to map_get_val(dec_res and "plaintext")
    set ok to map_insert(result and "public_key" and pub_key)
    set ok to map_insert(result and "secret_key" and sec_key)
    set ok to map_insert(result and "error" and 0)
    
    free_map(dec_res)
    return result
