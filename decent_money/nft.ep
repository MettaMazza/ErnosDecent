# ErnosDecent -- Non-Fungible Token Standard
# Component: decent_money/nft.ep
# Implements: ERC-721 equivalent NFT collection registry, minting, transfer, and royalties
# Status: Production -- OperationTrojanClaude Phase 8

import "string"
import "collections"

# ================================================================
# NFT Operations
# ================================================================

define nft_create_collection with name as Str and symbol as Str and owner_did as Str returning Map:
    set col to create_map()
    set ok to map_insert(col and "name" and name)
    set ok to map_insert(col and "symbol" and symbol)
    set ok to map_insert(col and "owner" and owner_did)
    
    set owners to create_map()
    set ok to map_insert(col and "owners" and owners)
    
    set meta to create_map()
    set ok to map_insert(col and "metadata" and meta)
    
    set creators to create_map()
    set ok to map_insert(col and "creators" and creators)
    
    set royalties to create_map()
    set ok to map_insert(col and "royalties" and royalties)
    
    return col

define nft_owner_of with collection as Map and token_id as Int returning Str:
    set owners to map_get_val(collection and "owners")
    set id_str to int_to_string(token_id)
    if map_contains(owners and id_str) == 0:
        return ""
    return map_get_val(owners and id_str)

define nft_mint with collection as Map and to_did as Str and token_id as Int and metadata_uri as Str and royalty_fee_bps as Int returning Int:
    if token_id <= 0:
        return 931 # Error: invalid token ID
    if royalty_fee_bps < 0:
        return 932 # Error: invalid royalty basis points
    if royalty_fee_bps > 10000:
        return 932
        
    set owners to map_get_val(collection and "owners")
    set id_str to int_to_string(token_id)
    if map_contains(owners and id_str) == 1:
        return 933 # Error: token already minted
        
    set ok to map_insert(owners and id_str and to_did)
    
    set meta to map_get_val(collection and "metadata")
    set ok to map_insert(meta and id_str and metadata_uri)
    
    set creators to map_get_val(collection and "creators")
    set ok to map_insert(creators and id_str and to_did)
    
    set royalties to map_get_val(collection and "royalties")
    set ok to map_insert(royalties and id_str and royalty_fee_bps)
    
    return 0

define nft_transfer with collection as Map and from_did as Str and to_did as Str and token_id as Int returning Int:
    set current_owner to nft_owner_of(collection and token_id)
    if current_owner equals "":
        return 934 # Error: token does not exist
    if current_owner equals from_did:
        set ok_owner to 1
    else:
        return 935 # Error: not authorized (not owner)
        
    set owners to map_get_val(collection and "owners")
    set id_str to int_to_string(token_id)
    set ok to map_insert(owners and id_str and to_did)
    return 0

define nft_metadata with collection as Map and token_id as Int returning Str:
    set meta to map_get_val(collection and "metadata")
    set id_str to int_to_string(token_id)
    if map_contains(meta and id_str) == 0:
        return ""
    return map_get_val(meta and id_str)

define nft_royalty_info with collection as Map and token_id as Int and sale_price as Int returning Map:
    set result to create_map()
    set id_str to int_to_string(token_id)
    
    set creators to map_get_val(collection and "creators")
    set royalties to map_get_val(collection and "royalties")
    
    if map_contains(creators and id_str) == 0:
        set ok to map_insert(result and "receiver" and "")
        set ok to map_insert(result and "amount" and 0)
        return result
        
    set receiver to map_get_val(creators and id_str)
    set bps to map_get_val(royalties and id_str)
    set amount to (sale_price * bps) / 10000
    
    set ok to map_insert(result and "receiver" and receiver)
    set ok to map_insert(result and "amount" and amount)
    return result
