# ErnosDecent -- Fungible Token Standard
# Component: decent_money/token.ep
# Implements: ERC-20 equivalent token registry, balances, allowances, and transfers
# Status: Production -- OperationTrojanClaude Phase 8

import "string"
import "collections"

# ================================================================
# Token Operations
# ================================================================

define token_create with name as Str and symbol as Str and decimals as Int and initial_supply as Int and owner_did as Str returning Map:
    set token to create_map()
    set ok to map_insert(token and "name" and name)
    set ok to map_insert(token and "symbol" and symbol)
    set ok to map_insert(token and "decimals" and decimals)
    set ok to map_insert(token and "total_supply" and initial_supply)
    
    set balances to create_map()
    set ok to map_insert(balances and owner_did and initial_supply)
    set ok to map_insert(token and "balances" and balances)
    
    set allowances to create_map()
    set ok to map_insert(token and "allowances" and allowances)
    
    return token

define token_balance_of with token as Map and address_did as Str returning Int:
    set balances to map_get_val(token and "balances")
    if map_contains(balances and address_did) == 0:
        return 0
    return map_get_val(balances and address_did)

define token_transfer with token as Map and from_did as Str and to_did as Str and amount as Int returning Int:
    if amount <= 0:
        return 921 # Error: invalid amount
    
    set balances to map_get_val(token and "balances")
    set from_balance to token_balance_of(token and from_did)
    if from_balance < amount:
        return 922 # Error: insufficient balance
        
    set to_balance to token_balance_of(token and to_did)
    set ok to map_insert(balances and from_did and from_balance - amount)
    set ok to map_insert(balances and to_did and to_balance + amount)
    return 0

define token_approve with token as Map and owner_did as Str and spender_did as Str and amount as Int returning Int:
    if amount < 0:
        return 923 # Error: invalid allowance
        
    set allowances to map_get_val(token and "allowances")
    set allowance_key to concat(owner_did and ":")
    set allowance_key to concat(allowance_key and spender_did)
    set ok to map_insert(allowances and allowance_key and amount)
    return 0

define token_allowance with token as Map and owner_did as Str and spender_did as Str returning Int:
    set allowances to map_get_val(token and "allowances")
    set allowance_key to concat(owner_did and ":")
    set allowance_key to concat(allowance_key and spender_did)
    if map_contains(allowances and allowance_key) == 0:
        return 0
    return map_get_val(allowances and allowance_key)

define token_transfer_from with token as Map and spender_did as Str and from_did as Str and to_did as Str and amount as Int returning Int:
    if amount <= 0:
        return 921
        
    set allowed to token_allowance(token and from_did and spender_did)
    if allowed < amount:
        return 924 # Error: insufficient allowance
        
    set err to token_transfer(token and from_did and to_did and amount)
    if err != 0:
        return err
        
    set allowances to map_get_val(token and "allowances")
    set allowance_key to concat(from_did and ":")
    set allowance_key to concat(allowance_key and spender_did)
    set ok to map_insert(allowances and allowance_key and allowed - amount)
    return 0
