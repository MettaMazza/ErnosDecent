import "collections"
import "string"
import "decent_consensus/raft"
import "decent_consensus/election"
import "decent_consensus/state"

define main returning Int:
    set peers to create_list()
    set ok to append_list(peers and str_to_ptr("node2"))
    set node to raft_create_node("node1" and peers)
    election_init_node(borrow node and 500)

    set reqs to election_start_vote(borrow node)

    set votes_ptr to map_get_val(node and "votes_received")
    display f"map_size: {map_size(votes_ptr)}"

    # The key was 'id' which is map_get_val(node and "node_id")
    # That returns the raw pointer to "node1" string
    set id_ptr to map_get_val(node and "node_id")
    display f"id_ptr raw: {id_ptr}"

    # Try looking up by string literal "node1"
    set v1 to map_get_val(votes_ptr and "node1")
    display f"lookup by string literal node1: {v1}"

    # Try looking up by the same ptr
    set v2 to map_get_val(votes_ptr and id_ptr)
    display f"lookup by id_ptr: {v2}"

    # Try using ptr_to_str on id_ptr
    set id_str to ptr_to_str(id_ptr)
    set v3 to map_get_val(votes_ptr and id_str)
    display f"lookup by ptr_to_str(id_ptr): {v3}"

    # Create a fresh map and test with map_get_val key
    set test to create_map()
    set ok to map_insert(test and id_ptr and 42)
    display f"test map size: {map_size(test)}"
    set v4 to map_get_val(test and id_ptr)
    display f"test lookup by id_ptr: {v4}"
    set v5 to map_get_val(test and "node1")
    display f"test lookup by literal: {v5}"

    return 0
