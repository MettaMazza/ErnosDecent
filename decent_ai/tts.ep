# ── UTF-8 decode: phoneme string (bytes) -> List of Unicode codepoints ──
define tts_utf8_codepoints with s as Str returning List:
    set out to create_list()
    set n to string_length(s)
    set i to 0
    repeat while i < n:
        set b0 to get_character(s and i)
        set cp to b0
        set adv to 1
        if b0 >= 240:
            set cp to b0 modulo 8
            set cp to cp * 64 + (get_character(s and i + 1) modulo 64)
            set cp to cp * 64 + (get_character(s and i + 2) modulo 64)
            set cp to cp * 64 + (get_character(s and i + 3) modulo 64)
            set adv to 4
        else:
            if b0 >= 224:
                set cp to b0 modulo 16
                set cp to cp * 64 + (get_character(s and i + 1) modulo 64)
                set cp to cp * 64 + (get_character(s and i + 2) modulo 64)
                set adv to 3
            else:
                if b0 >= 192:
                    set cp to b0 modulo 32
                    set cp to cp * 64 + (get_character(s and i + 1) modulo 64)
                    set adv to 2
        set ok to append_list(out and cp)
        set i to i + adv
    return out

# ── Tokenize IPA phonemes -> kokoro token ids (padded [0] ... [0]) ──
define tts_tokenize with vocab as Map and phonemes as Str returning List:
    set tokens to create_list()
    set ok to append_list(tokens and 0)
    set cps to tts_utf8_codepoints(phonemes)
    set n to length_list(cps)
    set i to 0
    repeat while i < n:
        set key to int_to_string(get_list(cps and i))
        if map_contains(vocab and key) == 1:
            set ok to append_list(tokens and map_get_val(vocab and key))
        set i to i + 1
    free_list(cps)
    set ok to append_list(tokens and 0)
    return tokens

# ── Text chunker ──
# A whole message is synthesized as ONE chunk; we only split when it would exceed
# kokoro's ~510-phoneme budget. Empirically English IPA runs ~1.05–1.07 phonemes per
# character (stress/length marks, diphthongs), so a 400-char ceiling keeps the token
# count (~430 with padding) comfortably under 510 while leaving typical replies — and
# even most multi-sentence ones — un-split. Only genuinely long output (e.g. a reply
# that would span several chat messages) gets chunked, and then at the last sentence
# boundary, falling back to a word boundary, so chunks stay whole-sentence.
define tts_chunk_max returning Int:
    return 400

define tts_is_sentence_end with c as Int returning Int:
    if c == 46 or else c == 33 or else c == 63:
        return 1
    return 0

# Split text into sentences, keeping each terminator (. ! ?) attached to its sentence.
define tts_split_sentences with s as Str returning List:
    set out to create_list()
    set n to string_length(s)
    set cur to ""
    set i to 0
    repeat while i < n:
        set cur to concat(cur and substring(s and i and 1))
        if tts_is_sentence_end(get_character(s and i)) == 1:
            set ok to append_list(out and string_trim(cur))
            set cur to ""
        set i to i + 1
    if string_length(string_trim(cur)) > 0:
        set ok to append_list(out and string_trim(cur))
    return out

define tts_chunk_text with text as Str returning List:
    set chunks to create_list()
    set t to string_trim(text)
    set n to string_length(t)
    # Common case: the whole message fits — never split it.
    if n <= tts_chunk_max():
        if n > 0:
            set ok to append_list(chunks and t)
        return chunks
    # Long output: pack WHOLE sentences into chunks up to the cap. We only ever break
    # on a sentence terminator — never mid-sentence. A single sentence that alone
    # exceeds the cap is emitted intact (its own chunk) rather than being cut.
    set sentences to tts_split_sentences(t)
    set ns to length_list(sentences)
    set cur to ""
    set i to 0
    repeat while i < ns:
        set s to string_trim(get_list(sentences and i))
        if string_length(s) > 0:
            if string_length(cur) == 0:
                set cur to s
            else:
                if (string_length(cur) + 1 + string_length(s)) <= tts_chunk_max():
                    set cur to concat(cur and concat(" " and s))
                else:
                    set ok to append_list(chunks and cur)
                    set cur to s
        set i to i + 1
    if string_length(cur) > 0:
        set ok to append_list(chunks and cur)
    return chunks
