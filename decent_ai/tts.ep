# ErnosDecent — Kokoro TTS (EP-native).
# Drives the raw kokoro-v1.0.onnx model via FFI: text -> (libespeak-ng) IPA phonemes
# -> kokoro vocab tokens -> (libonnxruntime) Run(tokens, VOICE style [tts_load_style], speed) ->
# 24kHz float audio -> PCM16 WAV. This file implements the full pipeline: chunker +
# vocab + tokenizer, libespeak-ng phonemize FFI, onnxruntime synthesis FFI, and WAV
# output. Delivery is wired to the Web UI (tts_request) and Discord (🔊 button). Audio
# is kept on raw byte buffers, never EP float Lists (which mangle floats).
# Component: decent_ai/tts.ep

import "string"
import "collections"
import "sync"
import "os"
import "../decent_id/keys"

# ── FFI primitives (resolved at runtime; same as codec.ep / inference.ep) ──
external define ep_dlopen with lib as Str returning Int:
external define ep_dlsym with handle as Int and name as Str returning Int:
external define ep_dlcall0 with fn as Int returning Int:
external define ep_dlcall1 with fn as Int and a0 as Int returning Int:
external define ep_dlcall2 with fn as Int and a0 as Int and a1 as Int returning Int:
external define ep_dlcall3 with fn as Int and a0 as Int and a1 as Int and a2 as Int returning Int:
external define ep_dlcall4 with fn as Int and a0 as Int and a1 as Int and a2 as Int and a3 as Int returning Int:
external define ep_dlcall7 with fn as Int and a0 as Int and a1 as Int and a2 as Int and a3 as Int and a4 as Int and a5 as Int and a6 as Int returning Int:
external define ep_dlcall8 with fn as Int and a0 as Int and a1 as Int and a2 as Int and a3 as Int and a4 as Int and a5 as Int and a6 as Int and a7 as Int returning Int:
external define alloc_bytes with n as Int returning Int:
external define free_bytes with ptr as Int returning Int:
external define poke_byte with ptr as Int and offset as Int and value as Int returning Int:
external define peek_byte with ptr as Int and offset as Int returning Int:
external define ep_net_send_raw with fd as Int and buf as Int and count as Int returning Int:

# ── byte/buffer helpers for FFI marshalling ──
define tts_model_path returning Str:
    set configured to keys_getenv("ERNOSDECENT_KOKORO_MODEL")
    if string_length(configured) > 0:
        return configured
    return concat(get_home_dir() and "/.ernosagent/models/kokoro-v1.0.onnx")

define tts_voice_path returning Str:
    set configured to keys_getenv("ERNOSDECENT_KOKORO_VOICES")
    if string_length(configured) > 0:
        return configured
    return concat(get_home_dir() and "/.ernosagent/models/voices-v1.0.bin")

define tts_ort_library returning Int:
    set configured to keys_getenv("ERNOSDECENT_ONNXRUNTIME_LIB")
    set lib to 0
    if string_length(configured) > 0:
        set lib to ep_dlopen(configured)
    if lib == 0:
        set lib to ep_dlopen("libonnxruntime.dylib")
    if lib == 0:
        set lib to ep_dlopen("libonnxruntime.so")
    if lib == 0:
        set fallback to concat(get_home_dir() and "/.ernos/kokoro-venv/lib/python3.12/site-packages/onnxruntime/capi/libonnxruntime.1.24.4.dylib")
        set lib to ep_dlopen(fallback)
    return lib

define tts_peek_ptr_buf with buf as Int and off as Int returning Int:
    set v to 0
    set i to 7
    repeat while i >= 0:
        set v to v * 256 + peek_byte(buf and off + i)
        set i to i - 1
    return v

define tts_poke_i64 with buf as Int and off as Int and val as Int returning Int:
    set p to val
    set j to 0
    repeat while j < 8:
        set ok to poke_byte(buf and off + j and (p modulo 256))
        set p to p / 256
        set j to j + 1
    return 0

define tts_peek_u32 with buf as Int and off as Int returning Int:
    return peek_byte(buf and off) + peek_byte(buf and off + 1) * 256 + peek_byte(buf and off + 2) * 65536 + peek_byte(buf and off + 3) * 16777216

define tts_poke_u32 with buf as Int and off as Int and val as Int returning Int:
    set ok to poke_byte(buf and off and (val modulo 256))
    set ok to poke_byte(buf and off + 1 and ((val / 256) modulo 256))
    set ok to poke_byte(buf and off + 2 and ((val / 65536) modulo 256))
    set ok to poke_byte(buf and off + 3 and ((val / 16777216) modulo 256))
    return 0

define tts_poke_i16 with buf as Int and off as Int and val as Int returning Int:
    set v to val
    if v < 0:
        set v to v + 65536
    set ok to poke_byte(buf and off and (v modulo 256))
    set ok to poke_byte(buf and off + 1 and ((v / 256) modulo 256))
    return 0

# IEEE-754 float32 bits (a u32) -> fixed-point value*1e6 (from inference.ep).
define tts_f32_to_fixed with u as Int returning Int:
    if u == 0:
        return 0
    set sign_bit to (u / 2147483648) modulo 2
    set exp_bits to (u / 8388608) modulo 256
    set mantissa_bits to u modulo 8388608
    if exp_bits == 0:
        return 0
    if exp_bits == 255:
        return 0
    set exponent to exp_bits - 127
    set scale to 1000000
    set val to 0
    if exponent >= 0:
        set temp to 1
        set i to 0
        repeat while i < exponent:
            set temp to temp * 2
            set i to i + 1
        set val to scale * temp + (scale * mantissa_bits * temp) / 8388608
    else:
        set temp to 1
        set i to 0
        repeat while i < (0 - exponent):
            set temp to temp * 2
            set i to i + 1
        set val to scale / temp + (scale * mantissa_bits) / (8388608 * temp)
    if sign_bit == 1:
        return 0 - val
    return val

define tts_ort_fn with api as Int and idx as Int returning Int:
    return tts_peek_ptr_buf(api and idx * 8)

# Release an OrtValue (OrtApi.ReleaseValue, struct index 96 — the Release* block is
# contiguous and ends at ReleaseTensorTypeAndShapeInfo=99, so ReleaseValue=96). Used
# by tts_run_tokens to free the per-call input tensors; the audio output value is kept
# alive until the WAV is written, then released by the caller. No-op on a null value.
define tts_ort_release_value with api as Int and val as Int returning Int:
    if val == 0:
        return 0
    set release_fn to tts_ort_fn(api and 96)
    if release_fn == 0:
        return 1
    set ok to ep_dlcall1(release_fn and val)
    return 0

# Load the VOICE's style vector for a token sequence of length `token_count`:
# 256 float32 (1024 bytes) at absolute offset VOICE_BASE + idx*1024 in voices-v1.0.bin.
# voices-v1.0.bin is a zip (npz): a voice's float data starts at its zip member's data
# offset + 128 (the .npy header). Known bases in Maria's file (member offset + 128):
#   am_michael = 8358940  + 128 = 8359068   (CURRENT — the only 'michael'; Kokoro v1.0
#                                            has NO bm_michael. British males available:
#                                            bm_daniel, bm_fable, bm_george, bm_lewis)
#   bm_fable   = 13060810 + 128 = 13060938  (previous voice — verified vs numpy)
# To swap voices: recompute the member's data offset (python zipfile: header_offset +
# 30 + name_len + extra_len + 128) and change the constant below.
define tts_load_style with token_count as Int returning Int:
    set idx to token_count
    if idx > 509:
        set idx to 509
    set buf to alloc_bytes(1024)
    if buf == 0:
        return 0
    set libc to ep_dlopen("/usr/lib/libSystem.B.dylib")
    if libc == 0:
        set libc to ep_dlopen("libc.so.6")
    if libc == 0:
        set free_err to free_bytes(buf)
        return 0
    set fn_fopen to ep_dlsym(libc and "fopen")
    set fn_fseek to ep_dlsym(libc and "fseek")
    set fn_fread to ep_dlsym(libc and "fread")
    set fn_fclose to ep_dlsym(libc and "fclose")
    if fn_fopen == 0 or else fn_fseek == 0 or else fn_fread == 0 or else fn_fclose == 0:
        set free_err to free_bytes(buf)
        return 0
    set voice_path_buf to tts_str_to_buf(tts_voice_path())
    set mode_buf to tts_str_to_buf("rb")
    set fp to ep_dlcall2(fn_fopen and voice_path_buf and mode_buf)
    set free_err to free_bytes(voice_path_buf)
    set free_err to free_bytes(mode_buf)
    if fp == 0:
        set free_err to free_bytes(buf)
        return 0
    set seek_err to ep_dlcall3(fn_fseek and fp and (8359068 + idx * 1024) and 0)
    set rd to 0
    if seek_err == 0:
        set rd to ep_dlcall4(fn_fread and buf and 1 and 1024 and fp)
    set close_err to ep_dlcall1(fn_fclose and fp)
    if seek_err != 0 or else rd != 1024 or else close_err != 0:
        set free_err to free_bytes(buf)
        return 0
    return buf

# Run the kokoro model on one token sequence; returns {ptr, len, val} for the f32
# audio. The audio OrtValue is returned as "val" (NOT released here) so its buffer
# (ptr) stays valid for the WAV writer; the caller MUST release it via
# tts_ort_release_value once the WAV has been written. All other per-call OrtValues
# (token/style/speed inputs) and scratch buffers are freed before returning — the
# node is long-running, so leaking them per request grows memory unboundedly.
define tts_run_tokens with api as Int and session as Int and mem_info as Int and tokens as List returning Map:
    set out to create_map()
    set ok to map_insert(out and "ptr" and 0)
    set ok to map_insert(out and "len" and 0)
    set ok to map_insert(out and "val" and 0)
    set ok to map_insert(out and "error" and 1)
    set n to length_list(tokens)
    if n < 3:
        return out

    set tok_data to 0
    set tok_shape to 0
    set tok_vout to 0
    set tok_val to 0
    set style_buf to 0
    set style_shape to 0
    set style_vout to 0
    set style_val to 0
    set speed_buf to 0
    set speed_shape to 0
    set speed_vout to 0
    set speed_val to 0
    set nm_tokens to 0
    set nm_style to 0
    set nm_speed to 0
    set nm_audio to 0
    set in_names to 0
    set in_vals to 0
    set out_names to 0
    set out_vals to 0
    set audio_val to 0

    set tok_data to alloc_bytes(n * 8)
    set tok_shape to alloc_bytes(16)
    set tok_vout to alloc_bytes(8)
    if tok_data != 0 and also tok_shape != 0 and also tok_vout != 0:
        set i to 0
        repeat while i < n:
            set ok to tts_poke_i64(tok_data and i * 8 and get_list(tokens and i))
            set i to i + 1
        set ok to tts_poke_i64(tok_shape and 0 and 1)
        set ok to tts_poke_i64(tok_shape and 8 and n)
        set st to ep_dlcall7(tts_ort_fn(api and 49) and mem_info and tok_data and (n * 8) and tok_shape and 2 and 7 and tok_vout)
        if st == 0:
            set tok_val to tts_peek_ptr_buf(tok_vout and 0)
            set style_buf to tts_load_style(n)
            set style_shape to alloc_bytes(16)
            set style_vout to alloc_bytes(8)
            if style_buf != 0 and also style_shape != 0 and also style_vout != 0:
                set ok to tts_poke_i64(style_shape and 0 and 1)
                set ok to tts_poke_i64(style_shape and 8 and 256)
                set st to ep_dlcall7(tts_ort_fn(api and 49) and mem_info and style_buf and 1024 and style_shape and 2 and 1 and style_vout)
                if st == 0:
                    set style_val to tts_peek_ptr_buf(style_vout and 0)
                    set speed_buf to alloc_bytes(4)
                    set speed_shape to alloc_bytes(8)
                    set speed_vout to alloc_bytes(8)
                    if speed_buf != 0 and also speed_shape != 0 and also speed_vout != 0:
                        # speed f32[1] = 1.15 (IEEE 0x3F933333, LE)
                        set ok to poke_byte(speed_buf and 0 and 51)
                        set ok to poke_byte(speed_buf and 1 and 51)
                        set ok to poke_byte(speed_buf and 2 and 147)
                        set ok to poke_byte(speed_buf and 3 and 63)
                        set ok to tts_poke_i64(speed_shape and 0 and 1)
                        set st to ep_dlcall7(tts_ort_fn(api and 49) and mem_info and speed_buf and 4 and speed_shape and 1 and 1 and speed_vout)
                        if st == 0:
                            set speed_val to tts_peek_ptr_buf(speed_vout and 0)
                            set nm_tokens to tts_str_to_buf("tokens")
                            set nm_style to tts_str_to_buf("style")
                            set nm_speed to tts_str_to_buf("speed")
                            set nm_audio to tts_str_to_buf("audio")
                            set in_names to alloc_bytes(24)
                            set in_vals to alloc_bytes(24)
                            set out_names to alloc_bytes(8)
                            set out_vals to alloc_bytes(8)
                            if nm_tokens != 0 and also nm_style != 0 and also nm_speed != 0 and also nm_audio != 0 and also in_names != 0 and also in_vals != 0 and also out_names != 0 and also out_vals != 0:
                                set ok to tts_poke_i64(in_names and 0 and nm_tokens)
                                set ok to tts_poke_i64(in_names and 8 and nm_style)
                                set ok to tts_poke_i64(in_names and 16 and nm_speed)
                                set ok to tts_poke_i64(in_vals and 0 and tok_val)
                                set ok to tts_poke_i64(in_vals and 8 and style_val)
                                set ok to tts_poke_i64(in_vals and 16 and speed_val)
                                set ok to tts_poke_i64(out_names and 0 and nm_audio)
                                set st to ep_dlcall8(tts_ort_fn(api and 9) and session and 0 and in_names and in_vals and 3 and out_names and 1 and out_vals)
                                if st == 0:
                                    set audio_val to tts_peek_ptr_buf(out_vals and 0)
                                    set sinfo_out to alloc_bytes(8)
                                    set count_out to alloc_bytes(8)
                                    set data_out to alloc_bytes(8)
                                    if audio_val != 0 and also sinfo_out != 0 and also count_out != 0 and also data_out != 0:
                                        set shape_err to ep_dlcall2(tts_ort_fn(api and 65) and audio_val and sinfo_out)
                                        set sinfo to tts_peek_ptr_buf(sinfo_out and 0)
                                        if shape_err == 0 and also sinfo != 0:
                                            set count_err to ep_dlcall2(tts_ort_fn(api and 64) and sinfo and count_out)
                                            set data_err to ep_dlcall2(tts_ort_fn(api and 51) and audio_val and data_out)
                                            set audio_len to tts_peek_ptr_buf(count_out and 0)
                                            set audio_ptr to tts_peek_ptr_buf(data_out and 0)
                                            if count_err == 0 and also data_err == 0 and also audio_len > 0 and also audio_ptr != 0:
                                                set ok to map_insert(out and "ptr" and audio_ptr)
                                                set ok to map_insert(out and "len" and audio_len)
                                                set ok to map_insert(out and "val" and audio_val)
                                                set ok to map_insert(out and "error" and 0)
                                            set release_shape_err to ep_dlcall1(tts_ort_fn(api and 99) and sinfo)
                                    set ok to free_bytes(sinfo_out)
                                    set ok to free_bytes(count_out)
                                    set ok to free_bytes(data_out)
    if map_get_val(out and "error") != 0 and also audio_val != 0:
        set ok to tts_ort_release_value(api and audio_val)
    set ok to tts_ort_release_value(api and tok_val)
    set ok to tts_ort_release_value(api and style_val)
    set ok to tts_ort_release_value(api and speed_val)
    set ok to free_bytes(tok_data)
    set ok to free_bytes(tok_shape)
    set ok to free_bytes(tok_vout)
    set ok to free_bytes(style_buf)
    set ok to free_bytes(style_shape)
    set ok to free_bytes(style_vout)
    set ok to free_bytes(speed_buf)
    set ok to free_bytes(speed_shape)
    set ok to free_bytes(speed_vout)
    set ok to free_bytes(nm_tokens)
    set ok to free_bytes(nm_style)
    set ok to free_bytes(nm_speed)
    set ok to free_bytes(nm_audio)
    set ok to free_bytes(in_names)
    set ok to free_bytes(in_vals)
    set ok to free_bytes(out_names)
    set ok to free_bytes(out_vals)
    return out

# Open the kokoro ONNX session once; returns {api, session, mem} (api=0 on failure).
set TTS_ORT_CACHE to 0

define tts_ort_open returning Map:
    if TTS_ORT_CACHE != 0:
        return TTS_ORT_CACHE
    set out to create_map()
    set ok to map_insert(out and "api" and 0)
    set ok to map_insert(out and "error" and 1)
    set lib to tts_ort_library()
    if lib == 0:
        set ok to map_insert(out and "error" and 10)
        return out
    set get_base_fn to ep_dlsym(lib and "OrtGetApiBase")
    if get_base_fn == 0:
        set ok to map_insert(out and "error" and 11)
        return out
    set api_base to ep_dlcall0(get_base_fn)
    if api_base == 0:
        set ok to map_insert(out and "error" and 12)
        return out
    set get_api_fn to tts_peek_ptr_buf(api_base and 0)
    if get_api_fn == 0:
        set ok to map_insert(out and "error" and 13)
        return out
    set api to ep_dlcall1(get_api_fn and 24)
    if api == 0:
        set ok to map_insert(out and "error" and 14)
        return out
    if tts_ort_fn(api and 3) == 0 or else tts_ort_fn(api and 7) == 0 or else tts_ort_fn(api and 9) == 0 or else tts_ort_fn(api and 10) == 0 or else tts_ort_fn(api and 49) == 0 or else tts_ort_fn(api and 51) == 0 or else tts_ort_fn(api and 64) == 0 or else tts_ort_fn(api and 65) == 0 or else tts_ort_fn(api and 69) == 0 or else tts_ort_fn(api and 96) == 0 or else tts_ort_fn(api and 99) == 0:
        set ok to map_insert(out and "error" and 15)
        return out
    set env_out to alloc_bytes(8)
    set env_name_buf to tts_str_to_buf("tts")
    if env_out == 0 or else env_name_buf == 0:
        set free_err to free_bytes(env_out)
        set free_err to free_bytes(env_name_buf)
        set ok to map_insert(out and "error" and 15)
        return out
    set st to ep_dlcall3(tts_ort_fn(api and 3) and 2 and env_name_buf and env_out)
    set free_err to free_bytes(env_name_buf)
    if st != 0:
        set free_err to free_bytes(env_out)
        set ok to map_insert(out and "error" and 16)
        return out
    set env to tts_peek_ptr_buf(env_out and 0)
    set opt_out to alloc_bytes(8)
    if opt_out == 0:
        set free_err to free_bytes(env_out)
        set ok to map_insert(out and "error" and 17)
        return out
    set st to ep_dlcall1(tts_ort_fn(api and 10) and opt_out)
    if st != 0:
        set free_err to free_bytes(env_out)
        set free_err to free_bytes(opt_out)
        set ok to map_insert(out and "error" and 18)
        return out
    set opts to tts_peek_ptr_buf(opt_out and 0)
    set sess_out to alloc_bytes(8)
    set model_path_buf to tts_str_to_buf(tts_model_path())
    if sess_out == 0 or else model_path_buf == 0:
        set free_err to free_bytes(env_out)
        set free_err to free_bytes(opt_out)
        set free_err to free_bytes(sess_out)
        set free_err to free_bytes(model_path_buf)
        set ok to map_insert(out and "error" and 19)
        return out
    set st to ep_dlcall4(tts_ort_fn(api and 7) and env and model_path_buf and opts and sess_out)
    set free_err to free_bytes(model_path_buf)
    if st != 0:
        set free_err to free_bytes(env_out)
        set free_err to free_bytes(opt_out)
        set free_err to free_bytes(sess_out)
        set ok to map_insert(out and "error" and 20)
        return out
    set session to tts_peek_ptr_buf(sess_out and 0)
    set mem_out to alloc_bytes(8)
    if mem_out == 0:
        set free_err to free_bytes(env_out)
        set free_err to free_bytes(opt_out)
        set free_err to free_bytes(sess_out)
        set ok to map_insert(out and "error" and 21)
        return out
    set st to ep_dlcall3(tts_ort_fn(api and 69) and 0 and 0 and mem_out)
    if st != 0:
        set free_err to free_bytes(env_out)
        set free_err to free_bytes(opt_out)
        set free_err to free_bytes(sess_out)
        set free_err to free_bytes(mem_out)
        set ok to map_insert(out and "error" and 22)
        return out
    set ok to map_insert(out and "api" and api)
    set ok to map_insert(out and "session" and session)
    set ok to map_insert(out and "mem" and tts_peek_ptr_buf(mem_out and 0))
    set ok to map_insert(out and "env" and env)
    set ok to map_insert(out and "options" and opts)
    set ok to map_insert(out and "error" and 0)
    set free_err to free_bytes(env_out)
    set free_err to free_bytes(opt_out)
    set free_err to free_bytes(sess_out)
    set free_err to free_bytes(mem_out)
    set TTS_ORT_CACHE to out
    return TTS_ORT_CACHE

# espeak-ng keeps global, NON-thread-safe state (espeak_Initialize / SetVoice /
# TextToPhonemes all touch process-wide phoneme tables). The node drives TTS from
# several threads at once — the Web UI 🔊 handler (a spawned per-client thread) and
# the IPC "TTS SPEAK" handler used by the Discord bridge. Two overlapping syntheses
# race espeak's tables and corrupt the heap, which surfaces as a flood of
# "Invalid instruction NNNN for phoneme '<garbage>'" (espeak walking clobbered phoneme
# programs) followed by a segfault. Serialize the whole pipeline (espeak + the shared
# ORT env/session) behind one mutex so only one synthesis runs at a time. Created
# eagerly at module load, before any worker thread is spawned, so there is no
# lazy-init race on the mutex itself.
set TTS_MUTEX to create_mutex()

# Full TTS: chunk `text`, synthesize each chunk, and write one concatenated 24kHz
# mono PCM16 WAV at wav_path. Returns 0 on success. Thread-safe entry point: holds
# TTS_MUTEX across the entire (single-threaded) synthesis in tts_speak_locked.
define tts_speak with text as Str and wav_path as Str returning Int:
    if TTS_MUTEX == 0:
        return 4
    set lock_ok to lock_mutex(TTS_MUTEX)
    if lock_ok == 0:
        return 4
    set rc to tts_speak_locked(text and wav_path)
    set unlock_ok to unlock_mutex(TTS_MUTEX)
    if unlock_ok == 0:
        return 5
    return rc

define tts_speak_locked with text as Str and wav_path as Str returning Int:
    set ses to tts_ort_open()
    if map_get_val(ses and "api") == 0:
        return 3
    set api to map_get_val(ses and "api")
    set session to map_get_val(ses and "session")
    set mem_info to map_get_val(ses and "mem")
    set vocab to tts_build_vocab()
    # Strip non-speakable symbols/emojis/markdown before anything is voiced.
    set clean to tts_sanitize_text(text)
    if string_length(clean) == 0:
        return 5
    set chunks to tts_chunk_text(clean)
    set nc to length_list(chunks)
    set ptrs to create_list()
    set lens to create_list()
    set vals to create_list()
    set synth_err to 0
    set ci to 0
    repeat while ci < nc and also synth_err == 0:
        set tokens to tts_tokenize(vocab and tts_phonemize_chunk(get_list(chunks and ci)))
        set res to tts_run_tokens(api and session and mem_info and tokens)
        if map_get_val(res and "len") > 0:
            set ok to append_list(ptrs and map_get_val(res and "ptr"))
            set ok to append_list(lens and map_get_val(res and "len"))
            set ok to append_list(vals and map_get_val(res and "val"))
        else:
            set synth_err to map_get_val(res and "error")
            if synth_err == 0:
                set synth_err to 6
        set ok to free_list(tokens)
        set ok to free_map(res)
        set ci to ci + 1
    set wr to synth_err
    if synth_err == 0:
        if length_list(ptrs) == 0:
            set wr to 5
        else:
            set wr to tts_write_wav_multi(wav_path and ptrs and lens and 24000)
    set vi to 0
    repeat while vi < length_list(vals):
        set release_err to tts_ort_release_value(api and get_list(vals and vi))
        if release_err != 0 and also wr == 0:
            set wr to 7
        set vi to vi + 1
    set ok to free_list(ptrs)
    set ok to free_list(lens)
    set ok to free_list(vals)
    set ok to free_list(chunks)
    return wr

# Build a 44-byte canonical WAV header (mono 16-bit PCM) for n_samples at `rate`.
define tts_build_wav_header with n_samples as Int and rate as Int returning Int:
    if n_samples <= 0 or else n_samples > 1073741805 or else rate <= 0:
        return 0
    set data_bytes to n_samples * 2
    set hdr to alloc_bytes(44)
    if hdr == 0:
        return 0
    set ok to poke_byte(hdr and 0 and 82)
    set ok to poke_byte(hdr and 1 and 73)
    set ok to poke_byte(hdr and 2 and 70)
    set ok to poke_byte(hdr and 3 and 70)
    set ok to tts_poke_u32(hdr and 4 and (36 + data_bytes))
    set ok to poke_byte(hdr and 8 and 87)
    set ok to poke_byte(hdr and 9 and 65)
    set ok to poke_byte(hdr and 10 and 86)
    set ok to poke_byte(hdr and 11 and 69)
    set ok to poke_byte(hdr and 12 and 102)
    set ok to poke_byte(hdr and 13 and 109)
    set ok to poke_byte(hdr and 14 and 116)
    set ok to poke_byte(hdr and 15 and 32)
    set ok to tts_poke_u32(hdr and 16 and 16)
    set ok to poke_byte(hdr and 20 and 1)
    set ok to poke_byte(hdr and 21 and 0)
    set ok to poke_byte(hdr and 22 and 1)
    set ok to poke_byte(hdr and 23 and 0)
    set ok to tts_poke_u32(hdr and 24 and rate)
    set ok to tts_poke_u32(hdr and 28 and (rate * 2))
    set ok to poke_byte(hdr and 32 and 2)
    set ok to poke_byte(hdr and 33 and 0)
    set ok to poke_byte(hdr and 34 and 16)
    set ok to poke_byte(hdr and 35 and 0)
    set ok to poke_byte(hdr and 36 and 100)
    set ok to poke_byte(hdr and 37 and 97)
    set ok to poke_byte(hdr and 38 and 116)
    set ok to poke_byte(hdr and 39 and 97)
    set ok to tts_poke_u32(hdr and 40 and data_bytes)
    return hdr

# Convert n_samples float32 (at aptr) to PCM16 and fwrite them to fp.
define tts_fwrite_pcm with libc as Int and fp as Int and aptr as Int and n_samples as Int returning Int:
    if libc == 0 or else fp == 0 or else aptr == 0 or else n_samples <= 0 or else n_samples > 1073741823:
        return 1
    set pcm to alloc_bytes(n_samples * 2)
    if pcm == 0:
        return 2
    set i to 0
    repeat while i < n_samples:
        set fixed to tts_f32_to_fixed(tts_peek_u32(aptr and i * 4))
        set s16 to (fixed * 32767) / 1000000
        if s16 > 32767:
            set s16 to 32767
        if s16 < (0 - 32768):
            set s16 to (0 - 32768)
        set ok to tts_poke_i16(pcm and i * 2 and s16)
        set i to i + 1
    set fwrite_fn to ep_dlsym(libc and "fwrite")
    if fwrite_fn == 0:
        set ok to free_bytes(pcm)
        return 3
    set expected to n_samples * 2
    set wr to ep_dlcall4(fwrite_fn and pcm and 1 and expected and fp)
    set ok to free_bytes(pcm)
    if wr != expected:
        return 4
    return 0

# Write multiple audio chunks (parallel ptrs/lens lists) as one concatenated WAV.
define tts_write_wav_multi with path as Str and ptrs as List and lens as List and rate as Int returning Int:
    if length_list(ptrs) == 0 or else length_list(ptrs) != length_list(lens) or else rate <= 0:
        return 1
    set total to 0
    set k to 0
    repeat while k < length_list(lens):
        set chunk_len to get_list(lens and k)
        if chunk_len <= 0 or else total > 2147483647 - chunk_len:
            return 2
        set total to total + chunk_len
        set k to k + 1
    if total > 1073741805:
        return 2
    set libc to ep_dlopen("/usr/lib/libSystem.B.dylib")
    if libc == 0:
        set libc to ep_dlopen("libc.so.6")
    if libc == 0:
        return 3
    set fopen_fn to ep_dlsym(libc and "fopen")
    set fwrite_fn to ep_dlsym(libc and "fwrite")
    set fclose_fn to ep_dlsym(libc and "fclose")
    if fopen_fn == 0 or else fwrite_fn == 0 or else fclose_fn == 0:
        return 3
    set path_buf to tts_str_to_buf(path)
    set mode_buf to tts_str_to_buf("wb")
    if path_buf == 0 or else mode_buf == 0:
        set ok to free_bytes(path_buf)
        set ok to free_bytes(mode_buf)
        return 4
    set fp to ep_dlcall2(fopen_fn and path_buf and mode_buf)
    set ok to free_bytes(path_buf)
    set ok to free_bytes(mode_buf)
    if fp == 0:
        return 5
    set header to tts_build_wav_header(total and rate)
    if header == 0:
        set close_err to ep_dlcall1(fclose_fn and fp)
        return 6
    set wr to ep_dlcall4(fwrite_fn and header and 1 and 44 and fp)
    set ok to free_bytes(header)
    set write_err to 0
    if wr != 44:
        set write_err to 7
    set ci to 0
    repeat while ci < length_list(ptrs) and also write_err == 0:
        set write_err to tts_fwrite_pcm(libc and fp and get_list(ptrs and ci) and get_list(lens and ci))
        set ci to ci + 1
    set close_err to ep_dlcall1(fclose_fn and fp)
    if write_err != 0:
        return write_err
    if close_err != 0:
        return 8
    return 0

# Send a complete HTTP response whose body is RAW BYTES (e.g. a WAV file).
# The normal send_response()/net_send in http.ep are C-string based and truncate
# at the first NUL — useless for binary. header_str must be the full status line +
# headers + blank line (NUL-free); body_ptr/body_len point at the raw payload.
# Caller owns body_ptr and must close client_fd afterwards.
define tts_http_send_binary with client_fd as Int and header_str as Str and body_ptr as Int and body_len as Int returning Int:
    if client_fd < 0 or else body_ptr == 0 or else body_len < 0:
        return 0
    set hlen to string_length(header_str)
    if hlen > 2147483647 - body_len:
        return 0
    set total to hlen + body_len
    set buf to alloc_bytes(total)
    if buf == 0:
        return 0
    set i to 0
    repeat while i < hlen:
        set ok to poke_byte(buf and i and get_character(header_str and i))
        set i to i + 1
    set j to 0
    repeat while j < body_len:
        set ok to poke_byte(buf and hlen + j and peek_byte(body_ptr and j))
        set j to j + 1
    set sent to ep_net_send_raw(client_fd and buf and total)
    set free_ok to free_bytes(buf)
    if sent != total:
        return 0
    return 1

# The active voice's tag — keep in sync with the offset constant in tts_load_style
# (both must change together on a voice swap). Baked into cached filenames so a voice
# change never replays stale WAVs synthesized with the previous voice.
define tts_voice_tag returning Str:
    return "am_michael"

# Deterministic filename for a TTS request: djb2 hash of the text + the voice tag.
# Identical message text reuses the same cached WAV; distinct text (or a different
# voice) gets a distinct file. Shared by the Web UI server and the node's TTS SPEAK
# verb so both resolve the same path (under decent_web/tts/, inside the web root).
define tts_filename_for with text as Str returning Str:
    set h to 5381
    set i to 0
    set n to string_length(text)
    repeat while i < n:
        set h to ((h * 33) + get_character(text and i)) modulo 1000000007
        set i to i + 1
    return concat("tts_" and concat(tts_voice_tag() and concat("_" and concat(int_to_string(h) and ".wav"))))

# Binary-safe read of a whole file into a fresh byte buffer.
# Returns Map{ptr, len}; ptr==0 on failure. EP's read_file is C-string based
# (truncates at the first NUL), so binary assets like WAVs must come through here.
define tts_read_file_bytes with path as Str returning Map:
    set out to create_map()
    set ok to map_insert(out and "ptr" and 0)
    set ok to map_insert(out and "len" and 0)
    set ok to map_insert(out and "error" and 1)
    set libc to ep_dlopen("/usr/lib/libSystem.B.dylib")
    if libc == 0:
        set libc to ep_dlopen("libc.so.6")
    if libc == 0:
        set ok to map_insert(out and "error" and 2)
        return out
    set fopen_fn to ep_dlsym(libc and "fopen")
    set fseek_fn to ep_dlsym(libc and "fseek")
    set ftell_fn to ep_dlsym(libc and "ftell")
    set fread_fn to ep_dlsym(libc and "fread")
    set fclose_fn to ep_dlsym(libc and "fclose")
    if fopen_fn == 0 or else fseek_fn == 0 or else ftell_fn == 0 or else fread_fn == 0 or else fclose_fn == 0:
        set ok to map_insert(out and "error" and 3)
        return out
    set path_buf to tts_str_to_buf(path)
    set mode_buf to tts_str_to_buf("rb")
    if path_buf == 0 or else mode_buf == 0:
        set ok to free_bytes(path_buf)
        set ok to free_bytes(mode_buf)
        set ok to map_insert(out and "error" and 4)
        return out
    set fp to ep_dlcall2(fopen_fn and path_buf and mode_buf)
    set ok to free_bytes(path_buf)
    set ok to free_bytes(mode_buf)
    if fp == 0:
        set ok to map_insert(out and "error" and 5)
        return out
    # fseek(fp, 0, SEEK_END=2); ftell -> size; fseek(fp, 0, SEEK_SET=0)
    set seek_end_err to ep_dlcall3(fseek_fn and fp and 0 and 2)
    set size to ep_dlcall1(ftell_fn and fp)
    set seek_start_err to ep_dlcall3(fseek_fn and fp and 0 and 0)
    if seek_end_err != 0 or else seek_start_err != 0 or else size <= 0:
        set close_err to ep_dlcall1(fclose_fn and fp)
        set ok to map_insert(out and "error" and 6)
        return out
    set buf to alloc_bytes(size)
    if buf == 0:
        set close_err to ep_dlcall1(fclose_fn and fp)
        set ok to map_insert(out and "error" and 7)
        return out
    set rd to ep_dlcall4(fread_fn and buf and 1 and size and fp)
    set close_err to ep_dlcall1(fclose_fn and fp)
    if rd != size or else close_err != 0:
        set ok to free_bytes(buf)
        set ok to map_insert(out and "error" and 8)
        return out
    set ok to map_insert(out and "ptr" and buf)
    set ok to map_insert(out and "len" and rd)
    set ok to map_insert(out and "error" and 0)
    return out

# Copy an EP string into a fresh NUL-terminated C buffer; returns its address.
define tts_str_to_buf with s as Str returning Int:
    set n to string_length(s)
    set buf to alloc_bytes(n + 1)
    if buf == 0:
        return 0
    set i to 0
    repeat while i < n:
        set ok to poke_byte(buf and i and get_character(s and i))
        set i to i + 1
    set ok to poke_byte(buf and n and 0)
    return buf

# Write a 64-bit little-endian pointer value into buf at off.
define tts_poke_ptr with buf as Int and off as Int and ptr as Int returning Int:
    set p to ptr
    set j to 0
    repeat while j < 8:
        set ok to poke_byte(buf and off + j and (p modulo 256))
        set p to p / 256
        set j to j + 1
    return 0

# Read a NUL-terminated C string at ptr into an EP string.
define tts_cstr_at with ptr as Int returning Str:
    set bytes to create_list()
    set i to 0
    set b to peek_byte(ptr and i)
    repeat while b != 0 and also i < 200000:
        set ok to append_list(bytes and b)
        set i to i + 1
        set b to peek_byte(ptr and i)
    set s to string_from_list(bytes)
    free_list(bytes)
    return s

# espeak-ng must be initialized ONCE per process. The old tts_phonemize re-ran
# espeak_Initialize on every call (and the over-eager chunker made that several calls
# per message), which reloads espeak's phoneme-data tables each time. In the
# long-running, heap-busy node that reload churn corrupts those tables — espeak then
# reports "Wrong version of espeak-ng-data ... got 0x0" or a flood of
# "Invalid instruction NNNN for phoneme '<garbage>'" and finally segfaults. Load the
# library, initialize, and select the voice exactly once; cache the handle and only
# run TextToPhonemes per request thereafter. These globals are mutated only while
# TTS_MUTEX is held — tts_phonemize is reached solely via tts_speak (which holds the
# lock); test harnesses call it single-threaded — so no additional guard is needed.
set ESPEAK_LIB to 0
set ESPEAK_READY to 0

define tts_espeak_ensure returning Int:
    if ESPEAK_READY == 1:
        return ESPEAK_LIB
    set lib to ep_dlopen("/opt/homebrew/lib/libespeak-ng.dylib")
    if lib == 0:
        return 0
    set f_init to ep_dlsym(lib and "espeak_Initialize")
    set path_buf to tts_str_to_buf("/opt/homebrew/share/espeak-ng-data")
    # output=2 (SYNCHRONOUS — no audio device opened), buflength=0, path, options=0
    set sr to ep_dlcall4(f_init and 2 and 0 and path_buf and 0)
    free_bytes(path_buf)
    # British English voice (for Fable). The language code "en-gb" is NOT accepted by
    # SetVoiceByName (returns NOT_FOUND) — the VoiceName form is required, else no voice
    # loads and TextToPhonemes segfaults.
    set f_voice to ep_dlsym(lib and "espeak_SetVoiceByName")
    set voice_buf to tts_str_to_buf("English (Great Britain)")
    set vr to ep_dlcall1(f_voice and voice_buf)
    free_bytes(voice_buf)
    set ESPEAK_LIB to lib
    set ESPEAK_READY to 1
    return lib

# ── Phonemize via libespeak-ng: text -> IPA phonemes (British voice for Fable) ──
# espeak is initialized once (tts_espeak_ensure); this only runs TextToPhonemes.
define tts_phonemize with text as Str returning Str:
    set lib to tts_espeak_ensure()
    if lib == 0:
        return ""
    set text_buf to tts_str_to_buf(text)
    set textptr to alloc_bytes(8)
    set ok to tts_poke_ptr(textptr and 0 and text_buf)
    set f_ph to ep_dlsym(lib and "espeak_TextToPhonemes")
    # TextToPhonemes returns ONE clause and advances *textptr; loop until consumed.
    # textmode=1 (UTF8), phonememode=2 (IPA, no separator).
    set phonemes to ""
    set guard to 0
    set more to 1
    repeat while more == 1 and also guard < 1000:
        set ph_ptr to ep_dlcall3(f_ph and textptr and 1 and 2)
        if ph_ptr != 0:
            set phonemes to concat(phonemes and tts_cstr_at(ph_ptr))
            set phonemes to concat(phonemes and " ")
        # read *textptr (the advanced pointer); 0 => done
        set nextp to 0
        set k to 7
        repeat while k >= 0:
            set nextp to nextp * 256 + peek_byte(textptr and k)
            set k to k - 1
        if nextp == 0:
            set more to 0
        set guard to guard + 1
    free_bytes(text_buf)
    free_bytes(textptr)
    return phonemes

# ── Spoken-text sanitizer ──
# Keep only characters that should be VOICED: letters, digits, whitespace, and the
# punctuation kokoro is trained on. Everything else — markdown (* _ # ` ~ > etc.),
# emoji, stars/arrows/math symbols — is dropped so espeak doesn't read it aloud
# ("asterisk", "star", emoji names, ...). Allowed Unicode punctuation (em-dash,
# ellipsis, curly quotes) is preserved by copying its original UTF-8 bytes.
define tts_keep_codepoint with cp as Int returning Int:
    if cp >= 65 and also cp <= 90:
        return 1
    if cp >= 97 and also cp <= 122:
        return 1
    if cp >= 48 and also cp <= 57:
        return 1
    # . , ! ? ; : ' " ( ) -
    if cp == 46 or else cp == 44 or else cp == 33 or else cp == 63:
        return 1
    if cp == 59 or else cp == 58 or else cp == 39 or else cp == 34:
        return 1
    if cp == 40 or else cp == 41 or else cp == 45:
        return 1
    # em-dash, ellipsis, curly single/double quotes
    if cp == 8212 or else cp == 8230:
        return 1
    if cp == 8216 or else cp == 8217 or else cp == 8220 or else cp == 8221:
        return 1
    return 0

define tts_sanitize_text with s as Str returning Str:
    set out to ""
    set n to string_length(s)
    set i to 0
    repeat while i < n:
        set b0 to get_character(s and i)
        set cp to b0
        set adv to 1
        if b0 >= 240:
            set cp to b0 modulo 8
            set cp to cp * 64 + (get_character(s and i + 1) modulo 64)
            set cp to cp * 64 + (get_character(s and i + 2) modulo 64)
            set cp to cp * 64 + (get_character(s and i + 3) modulo 64)
            set adv to 4
        else:
            if b0 >= 224:
                set cp to b0 modulo 16
                set cp to cp * 64 + (get_character(s and i + 1) modulo 64)
                set cp to cp * 64 + (get_character(s and i + 2) modulo 64)
                set adv to 3
            else:
                if b0 >= 192:
                    set cp to b0 modulo 32
                    set cp to cp * 64 + (get_character(s and i + 1) modulo 64)
                    set adv to 2
        if cp == 32 or else cp == 9 or else cp == 10 or else cp == 13:
            set out to concat(out and " ")
        else:
            if tts_keep_codepoint(cp) == 1:
                set out to concat(out and substring(s and i and adv))
        set i to i + adv
    return string_trim(out)

# Phonemize a chunk sentence-by-sentence, re-attaching each sentence's terminator
# (. ! ?). espeak's IPA output (phonememode 2) drops punctuation, so kokoro never
# sees the sentence-final token it was trained on and the boundary sounds cramped.
# Re-adding the terminator restores its learned pause/intonation; the trailing spaces
# (space = a pause token) widen the gap after the period a touch more.
define tts_phonemize_chunk with chunk as Str returning Str:
    set sentences to tts_split_sentences(chunk)
    set ns to length_list(sentences)
    set out to ""
    set i to 0
    repeat while i < ns:
        set s to string_trim(get_list(sentences and i))
        set sl to string_length(s)
        if sl > 0:
            set out to concat(out and tts_phonemize(s))
            set last to get_character(s and sl - 1)
            if tts_is_sentence_end(last) == 1:
                set out to concat(out and substring(s and sl - 1 and 1))
            set out to concat(out and "  ")
        set i to i + 1
    return out

# ── Kokoro vocab: phoneme codepoint -> token id (from kokoro_onnx config.json) ──
define tts_vocab_put with v as Map and cp as Int and id as Int returning Int:
    set ok to map_insert(v and int_to_string(cp) and id)
    return 0

define tts_build_vocab returning Map:
    set v to create_map()
    set ok to tts_vocab_put(v and 59 and 1)
    set ok to tts_vocab_put(v and 58 and 2)
    set ok to tts_vocab_put(v and 44 and 3)
    set ok to tts_vocab_put(v and 46 and 4)
    set ok to tts_vocab_put(v and 33 and 5)
    set ok to tts_vocab_put(v and 63 and 6)
    set ok to tts_vocab_put(v and 8212 and 9)
    set ok to tts_vocab_put(v and 8230 and 10)
    set ok to tts_vocab_put(v and 34 and 11)
    set ok to tts_vocab_put(v and 40 and 12)
    set ok to tts_vocab_put(v and 41 and 13)
    set ok to tts_vocab_put(v and 8220 and 14)
    set ok to tts_vocab_put(v and 8221 and 15)
    set ok to tts_vocab_put(v and 32 and 16)
    set ok to tts_vocab_put(v and 771 and 17)
    set ok to tts_vocab_put(v and 675 and 18)
    set ok to tts_vocab_put(v and 677 and 19)
    set ok to tts_vocab_put(v and 678 and 20)
    set ok to tts_vocab_put(v and 680 and 21)
    set ok to tts_vocab_put(v and 7517 and 22)
    set ok to tts_vocab_put(v and 43879 and 23)
    set ok to tts_vocab_put(v and 65 and 24)
    set ok to tts_vocab_put(v and 73 and 25)
    set ok to tts_vocab_put(v and 79 and 31)
    set ok to tts_vocab_put(v and 81 and 33)
    set ok to tts_vocab_put(v and 83 and 35)
    set ok to tts_vocab_put(v and 84 and 36)
    set ok to tts_vocab_put(v and 87 and 39)
    set ok to tts_vocab_put(v and 89 and 41)
    set ok to tts_vocab_put(v and 7498 and 42)
    set ok to tts_vocab_put(v and 97 and 43)
    set ok to tts_vocab_put(v and 98 and 44)
    set ok to tts_vocab_put(v and 99 and 45)
    set ok to tts_vocab_put(v and 100 and 46)
    set ok to tts_vocab_put(v and 101 and 47)
    set ok to tts_vocab_put(v and 102 and 48)
    set ok to tts_vocab_put(v and 104 and 50)
    set ok to tts_vocab_put(v and 105 and 51)
    set ok to tts_vocab_put(v and 106 and 52)
    set ok to tts_vocab_put(v and 107 and 53)
    set ok to tts_vocab_put(v and 108 and 54)
    set ok to tts_vocab_put(v and 109 and 55)
    set ok to tts_vocab_put(v and 110 and 56)
    set ok to tts_vocab_put(v and 111 and 57)
    set ok to tts_vocab_put(v and 112 and 58)
    set ok to tts_vocab_put(v and 113 and 59)
    set ok to tts_vocab_put(v and 114 and 60)
    set ok to tts_vocab_put(v and 115 and 61)
    set ok to tts_vocab_put(v and 116 and 62)
    set ok to tts_vocab_put(v and 117 and 63)
    set ok to tts_vocab_put(v and 118 and 64)
    set ok to tts_vocab_put(v and 119 and 65)
    set ok to tts_vocab_put(v and 120 and 66)
    set ok to tts_vocab_put(v and 121 and 67)
    set ok to tts_vocab_put(v and 122 and 68)
    set ok to tts_vocab_put(v and 593 and 69)
    set ok to tts_vocab_put(v and 592 and 70)
    set ok to tts_vocab_put(v and 594 and 71)
    set ok to tts_vocab_put(v and 230 and 72)
    set ok to tts_vocab_put(v and 946 and 75)
    set ok to tts_vocab_put(v and 596 and 76)
    set ok to tts_vocab_put(v and 597 and 77)
    set ok to tts_vocab_put(v and 231 and 78)
    set ok to tts_vocab_put(v and 598 and 80)
    set ok to tts_vocab_put(v and 240 and 81)
    set ok to tts_vocab_put(v and 676 and 82)
    set ok to tts_vocab_put(v and 601 and 83)
    set ok to tts_vocab_put(v and 602 and 85)
    set ok to tts_vocab_put(v and 603 and 86)
    set ok to tts_vocab_put(v and 604 and 87)
    set ok to tts_vocab_put(v and 607 and 90)
    set ok to tts_vocab_put(v and 609 and 92)
    set ok to tts_vocab_put(v and 613 and 99)
    set ok to tts_vocab_put(v and 616 and 101)
    set ok to tts_vocab_put(v and 618 and 102)
    set ok to tts_vocab_put(v and 669 and 103)
    set ok to tts_vocab_put(v and 623 and 110)
    set ok to tts_vocab_put(v and 624 and 111)
    set ok to tts_vocab_put(v and 331 and 112)
    set ok to tts_vocab_put(v and 627 and 113)
    set ok to tts_vocab_put(v and 626 and 114)
    set ok to tts_vocab_put(v and 628 and 115)
    set ok to tts_vocab_put(v and 248 and 116)
    set ok to tts_vocab_put(v and 632 and 118)
    set ok to tts_vocab_put(v and 952 and 119)
    set ok to tts_vocab_put(v and 339 and 120)
    set ok to tts_vocab_put(v and 633 and 123)
    set ok to tts_vocab_put(v and 638 and 125)
    set ok to tts_vocab_put(v and 635 and 126)
    set ok to tts_vocab_put(v and 641 and 128)
    set ok to tts_vocab_put(v and 637 and 129)
    set ok to tts_vocab_put(v and 642 and 130)
    set ok to tts_vocab_put(v and 643 and 131)
    set ok to tts_vocab_put(v and 648 and 132)
    set ok to tts_vocab_put(v and 679 and 133)
    set ok to tts_vocab_put(v and 650 and 135)
    set ok to tts_vocab_put(v and 651 and 136)
    set ok to tts_vocab_put(v and 652 and 138)
    set ok to tts_vocab_put(v and 611 and 139)
    set ok to tts_vocab_put(v and 612 and 140)
    set ok to tts_vocab_put(v and 967 and 142)
    set ok to tts_vocab_put(v and 654 and 143)
    set ok to tts_vocab_put(v and 658 and 147)
    set ok to tts_vocab_put(v and 660 and 148)
    set ok to tts_vocab_put(v and 712 and 156)
    set ok to tts_vocab_put(v and 716 and 157)
    set ok to tts_vocab_put(v and 720 and 158)
    set ok to tts_vocab_put(v and 688 and 162)
    set ok to tts_vocab_put(v and 690 and 164)
    set ok to tts_vocab_put(v and 8595 and 169)
    set ok to tts_vocab_put(v and 8594 and 171)
    set ok to tts_vocab_put(v and 8599 and 172)
    set ok to tts_vocab_put(v and 8600 and 173)
    set ok to tts_vocab_put(v and 7547 and 177)
    return v

# ── UTF-8 decode: phoneme string (bytes) -> List of Unicode codepoints ──
define tts_utf8_codepoints with s as Str returning List:
    set out to create_list()
    set n to string_length(s)
    set i to 0
    repeat while i < n:
        set b0 to get_character(s and i)
        set cp to b0
        set adv to 1
        if b0 >= 240:
            set cp to b0 modulo 8
            set cp to cp * 64 + (get_character(s and i + 1) modulo 64)
            set cp to cp * 64 + (get_character(s and i + 2) modulo 64)
            set cp to cp * 64 + (get_character(s and i + 3) modulo 64)
            set adv to 4
        else:
            if b0 >= 224:
                set cp to b0 modulo 16
                set cp to cp * 64 + (get_character(s and i + 1) modulo 64)
                set cp to cp * 64 + (get_character(s and i + 2) modulo 64)
                set adv to 3
            else:
                if b0 >= 192:
                    set cp to b0 modulo 32
                    set cp to cp * 64 + (get_character(s and i + 1) modulo 64)
                    set adv to 2
        set ok to append_list(out and cp)
        set i to i + adv
    return out

# ── Tokenize IPA phonemes -> kokoro token ids (padded [0] ... [0]) ──
define tts_tokenize with vocab as Map and phonemes as Str returning List:
    set tokens to create_list()
    set ok to append_list(tokens and 0)
    set cps to tts_utf8_codepoints(phonemes)
    set n to length_list(cps)
    set i to 0
    repeat while i < n:
        set key to int_to_string(get_list(cps and i))
        if map_contains(vocab and key) == 1:
            set ok to append_list(tokens and map_get_val(vocab and key))
        set i to i + 1
    free_list(cps)
    set ok to append_list(tokens and 0)
    return tokens

# ── Text chunker ──
# A whole message is synthesized as ONE chunk; we only split when it would exceed
# kokoro's ~510-phoneme budget. Empirically English IPA runs ~1.05–1.07 phonemes per
# character (stress/length marks, diphthongs), so a 400-char ceiling keeps the token
# count (~430 with padding) comfortably under 510 while leaving typical replies — and
# even most multi-sentence ones — un-split. Only genuinely long output (e.g. a reply
# that would span several chat messages) gets chunked, and then at the last sentence
# boundary, falling back to a word boundary, so chunks stay whole-sentence.
define tts_chunk_max returning Int:
    return 400

define tts_is_sentence_end with c as Int returning Int:
    if c == 46 or else c == 33 or else c == 63:
        return 1
    return 0

# Split text into sentences, keeping each terminator (. ! ?) attached to its sentence.
define tts_split_sentences with s as Str returning List:
    set out to create_list()
    set n to string_length(s)
    set cur to ""
    set i to 0
    repeat while i < n:
        set cur to concat(cur and substring(s and i and 1))
        if tts_is_sentence_end(get_character(s and i)) == 1:
            set ok to append_list(out and string_trim(cur))
            set cur to ""
        set i to i + 1
    if string_length(string_trim(cur)) > 0:
        set ok to append_list(out and string_trim(cur))
    return out

define tts_chunk_text with text as Str returning List:
    set chunks to create_list()
    set t to string_trim(text)
    set n to string_length(t)
    # Common case: the whole message fits — never split it.
    if n <= tts_chunk_max():
        if n > 0:
            set ok to append_list(chunks and t)
        return chunks
    # Long output: pack WHOLE sentences into chunks up to the cap. We only ever break
    # on a sentence terminator — never mid-sentence. A single sentence that alone
    # exceeds the cap is emitted intact (its own chunk) rather than being cut.
    set sentences to tts_split_sentences(t)
    set ns to length_list(sentences)
    set cur to ""
    set i to 0
    repeat while i < ns:
        set s to string_trim(get_list(sentences and i))
        if string_length(s) > 0:
            if string_length(cur) == 0:
                set cur to s
            else:
                if (string_length(cur) + 1 + string_length(s)) <= tts_chunk_max():
                    set cur to concat(cur and concat(" " and s))
                else:
                    set ok to append_list(chunks and cur)
                    set cur to s
        set i to i + 1
    if string_length(cur) > 0:
        set ok to append_list(chunks and cur)
    return chunks
