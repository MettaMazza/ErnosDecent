# ErnosDecent — Kokoro TTS (EP-native).
# Drives the raw kokoro-v1.0.onnx model via FFI: text -> (libespeak-ng) IPA phonemes
# -> kokoro vocab tokens -> (libonnxruntime) Run(tokens, bm_fable style, speed) ->
# 24kHz float audio -> PCM16 WAV. This file is STAGE A: the pure, testable foundation
# (chunker + vocab + tokenizer). Audio is kept on raw byte buffers, never EP float
# Lists (which mangle floats). FFI + WAV land in the next stage.
# Component: decent_ai/tts.ep

import "string"
import "collections"

# ── Kokoro vocab: phoneme codepoint -> token id (from kokoro_onnx config.json) ──
define tts_vocab_put with v as Map and cp as Int and id as Int returning Int:
    set ok to map_insert(v and int_to_string(cp) and id)
    return 0

define tts_build_vocab returning Map:
