# ErnosDecent — Kokoro TTS (EP-native).
# Drives the raw kokoro-v1.0.onnx model via FFI: text -> (libespeak-ng) IPA phonemes
# -> kokoro vocab tokens -> (libonnxruntime) Run(tokens, bm_fable style, speed) ->
# 24kHz float audio -> PCM16 WAV. This file implements the full pipeline: chunker +
# vocab + tokenizer, libespeak-ng phonemize FFI, onnxruntime synthesis FFI, and WAV
# output. Delivery is wired to the Web UI (tts_request) and Discord (🔊 button). Audio
# is kept on raw byte buffers, never EP float Lists (which mangle floats).
# Component: decent_ai/tts.ep

import "string"
import "collections"
import "sync"

# ── FFI primitives (resolved at runtime; same as codec.ep / inference.ep) ──
external define ep_dlopen with lib:
external define ep_dlsym with handle and name:
external define ep_dlcall0 with fn:
external define ep_dlcall1 with fn and a0:
external define ep_dlcall2 with fn and a0 and a1:
external define ep_dlcall3 with fn and a0 and a1 and a2:
external define ep_dlcall4 with fn and a0 and a1 and a2 and a3:
external define ep_dlcall7 with fn and a0 and a1 and a2 and a3 and a4 and a5 and a6:
external define ep_dlcall8 with fn and a0 and a1 and a2 and a3 and a4 and a5 and a6 and a7:
external define alloc_bytes with n returning Int:
external define free_bytes with ptr:
external define poke_byte with ptr and offset and value:
external define peek_byte with ptr and offset returning Int:
external define ep_net_send_raw with fd and buf and count:

# ── byte/buffer helpers for FFI marshalling ──
define tts_peek_ptr_buf with buf as Int and off as Int returning Int:
    set v to 0
    set i to 7
    repeat while i >= 0:
        set v to v * 256 + peek_byte(buf and off + i)
        set i to i - 1
    return v

define tts_poke_i64 with buf as Int and off as Int and val as Int returning Int:
    set p to val
    set j to 0
    repeat while j < 8:
        set ok to poke_byte(buf and off + j and (p modulo 256))
        set p to p / 256
        set j to j + 1
    return 0

define tts_peek_u32 with buf as Int and off as Int returning Int:
    return peek_byte(buf and off) + peek_byte(buf and off + 1) * 256 + peek_byte(buf and off + 2) * 65536 + peek_byte(buf and off + 3) * 16777216

define tts_poke_u32 with buf as Int and off as Int and val as Int returning Int:
    set ok to poke_byte(buf and off and (val modulo 256))
    set ok to poke_byte(buf and off + 1 and ((val / 256) modulo 256))
    set ok to poke_byte(buf and off + 2 and ((val / 65536) modulo 256))
    set ok to poke_byte(buf and off + 3 and ((val / 16777216) modulo 256))
    return 0

define tts_poke_i16 with buf as Int and off as Int and val as Int returning Int:
    set v to val
    if v < 0:
        set v to v + 65536
    set ok to poke_byte(buf and off and (v modulo 256))
    set ok to poke_byte(buf and off + 1 and ((v / 256) modulo 256))
    return 0

# IEEE-754 float32 bits (a u32) -> fixed-point value*1e6 (from inference.ep).
define tts_f32_to_fixed with u as Int returning Int:
    if u == 0:
        return 0
    set sign_bit to (u / 2147483648) modulo 2
    set exp_bits to (u / 8388608) modulo 256
    set mantissa_bits to u modulo 8388608
    if exp_bits == 0:
        return 0
    if exp_bits == 255:
        return 0
    set exponent to exp_bits - 127
    set scale to 1000000
    set val to 0
    if exponent >= 0:
        set temp to 1
        set i to 0
        repeat while i < exponent:
            set temp to temp * 2
            set i to i + 1
        set val to scale * temp + (scale * mantissa_bits * temp) / 8388608
    else:
        set temp to 1
        set i to 0
        repeat while i < (0 - exponent):
            set temp to temp * 2
            set i to i + 1
        set val to scale / temp + (scale * mantissa_bits) / (8388608 * temp)
    if sign_bit == 1:
        return 0 - val
    return val

define tts_ort_fn with api as Int and idx as Int returning Int:
    return tts_peek_ptr_buf(api and idx * 8)

# Release an OrtValue (OrtApi.ReleaseValue, struct index 96 — the Release* block is
# contiguous and ends at ReleaseTensorTypeAndShapeInfo=99, so ReleaseValue=96). Used
# by tts_run_tokens to free the per-call input tensors; the audio output value is kept
# alive until the WAV is written, then released by the caller. No-op on a null value.
define tts_ort_release_value with api as Int and val as Int returning Int:
    if val == 0:
        return 0
    set ok to ep_dlcall1(tts_ort_fn(api and 96) and val)
    return 0

# Load bm_fable's style vector for a token sequence of length `token_count`:
# 256 float32 (1024 bytes) at absolute offset 13060938 + idx*1024 in voices-v1.0.bin
# (verified: matches numpy bm_fable[idx]). Uses libc fopen/fseek/fread.
define tts_load_style with token_count as Int returning Int:
    set idx to token_count
    if idx > 509:
        set idx to 509
    set buf to alloc_bytes(1024)
    set libc to ep_dlopen("/usr/lib/libSystem.B.dylib")
    set fp to ep_dlcall2(ep_dlsym(libc and "fopen") and tts_str_to_buf("/Users/mettamazza/.ernosagent/models/voices-v1.0.bin") and tts_str_to_buf("rb"))
    if fp == 0:
        return buf
    set ok to ep_dlcall3(ep_dlsym(libc and "fseek") and fp and (13060938 + idx * 1024) and 0)
    set rd to ep_dlcall4(ep_dlsym(libc and "fread") and buf and 1 and 1024 and fp)
    set ok to ep_dlcall1(ep_dlsym(libc and "fclose") and fp)
    return buf

# Synthesize `text` (single chunk) to a 24kHz mono PCM16 WAV at wav_path via the
# raw kokoro ONNX model. Returns 0 on success, or an error code per stage.
define tts_speak_chunk with text as Str and wav_path as Str returning Int:
    set vocab to tts_build_vocab()
    set phon to tts_phonemize(text)
    set tokens to tts_tokenize(vocab and phon)
    set n to length_list(tokens)
    if n < 3:
        return 1

    set lib to ep_dlopen("/Users/mettamazza/.ernos/kokoro-venv/lib/python3.12/site-packages/onnxruntime/capi/libonnxruntime.1.24.4.dylib")
    if lib == 0:
        return 2
    set api to ep_dlcall1(tts_peek_ptr_buf(ep_dlcall0(ep_dlsym(lib and "OrtGetApiBase")) and 0) and 24)

    # CreateEnv(level=2, "tts", &env)
    set env_out to alloc_bytes(8)
    set st to ep_dlcall3(tts_ort_fn(api and 3) and 2 and tts_str_to_buf("tts") and env_out)
    set env to tts_peek_ptr_buf(env_out and 0)
    # CreateSessionOptions(&opts)
    set opt_out to alloc_bytes(8)
    set st to ep_dlcall1(tts_ort_fn(api and 10) and opt_out)
    set opts to tts_peek_ptr_buf(opt_out and 0)
    # CreateSession(env, model, opts, &session)
    set sess_out to alloc_bytes(8)
    set st to ep_dlcall4(tts_ort_fn(api and 7) and env and tts_str_to_buf("/Users/mettamazza/.ernosagent/models/kokoro-v1.0.onnx") and opts and sess_out)
    if st != 0:
        return 3
    set session to tts_peek_ptr_buf(sess_out and 0)
    # CreateCpuMemoryInfo(OrtDeviceAllocator=0, OrtMemTypeDefault=0, &info)
    set mem_out to alloc_bytes(8)
    set st to ep_dlcall3(tts_ort_fn(api and 69) and 0 and 0 and mem_out)
    set mem_info to tts_peek_ptr_buf(mem_out and 0)

    set res to tts_run_tokens(api and session and mem_info and tokens)
    if map_get_val(res and "len") < 1:
        return 5
    set wr to tts_write_wav_f32(wav_path and map_get_val(res and "ptr") and map_get_val(res and "len") and 24000)
    return 0

# Run the kokoro model on one token sequence; returns {ptr, len, val} for the f32
# audio. The audio OrtValue is returned as "val" (NOT released here) so its buffer
# (ptr) stays valid for the WAV writer; the caller MUST release it via
# tts_ort_release_value once the WAV has been written. All other per-call OrtValues
# (token/style/speed inputs) and scratch buffers are freed before returning — the
# node is long-running, so leaking them per request grows memory unboundedly.
define tts_run_tokens with api as Int and session as Int and mem_info as Int and tokens as List returning Map:
    set out to create_map()
    set ok to map_insert(out and "ptr" and 0)
    set ok to map_insert(out and "len" and 0)
    set ok to map_insert(out and "val" and 0)
    set n to length_list(tokens)
    if n < 3:
        return out
    set tok_data to alloc_bytes(n * 8)
    set i to 0
    repeat while i < n:
        set ok to tts_poke_i64(tok_data and i * 8 and get_list(tokens and i))
        set i to i + 1
    set tok_shape to alloc_bytes(16)
    set ok to tts_poke_i64(tok_shape and 0 and 1)
    set ok to tts_poke_i64(tok_shape and 8 and n)
    set tok_vout to alloc_bytes(8)
    set st to ep_dlcall7(tts_ort_fn(api and 49) and mem_info and tok_data and (n * 8) and tok_shape and 2 and 7 and tok_vout)
    set tok_val to tts_peek_ptr_buf(tok_vout and 0)
    set style_buf to tts_load_style(n)
    set style_shape to alloc_bytes(16)
    set ok to tts_poke_i64(style_shape and 0 and 1)
    set ok to tts_poke_i64(style_shape and 8 and 256)
    set style_vout to alloc_bytes(8)
    set st to ep_dlcall7(tts_ort_fn(api and 49) and mem_info and style_buf and 1024 and style_shape and 2 and 1 and style_vout)
    set style_val to tts_peek_ptr_buf(style_vout and 0)
    # speed f32[1] = 1.15 (IEEE 0x3F933333, LE)
    set speed_buf to alloc_bytes(4)
    set ok to poke_byte(speed_buf and 0 and 51)
    set ok to poke_byte(speed_buf and 1 and 51)
    set ok to poke_byte(speed_buf and 2 and 147)
    set ok to poke_byte(speed_buf and 3 and 63)
    set speed_shape to alloc_bytes(8)
    set ok to tts_poke_i64(speed_shape and 0 and 1)
    set speed_vout to alloc_bytes(8)
    set st to ep_dlcall7(tts_ort_fn(api and 49) and mem_info and speed_buf and 4 and speed_shape and 1 and 1 and speed_vout)
    set speed_val to tts_peek_ptr_buf(speed_vout and 0)
    set nm_tokens to tts_str_to_buf("tokens")
    set nm_style to tts_str_to_buf("style")
    set nm_speed to tts_str_to_buf("speed")
    set nm_audio to tts_str_to_buf("audio")
    set in_names to alloc_bytes(24)
    set ok to tts_poke_i64(in_names and 0 and nm_tokens)
    set ok to tts_poke_i64(in_names and 8 and nm_style)
    set ok to tts_poke_i64(in_names and 16 and nm_speed)
    set in_vals to alloc_bytes(24)
    set ok to tts_poke_i64(in_vals and 0 and tok_val)
    set ok to tts_poke_i64(in_vals and 8 and style_val)
    set ok to tts_poke_i64(in_vals and 16 and speed_val)
    set out_names to alloc_bytes(8)
    set ok to tts_poke_i64(out_names and 0 and nm_audio)
    set out_vals to alloc_bytes(8)
    set st to ep_dlcall8(tts_ort_fn(api and 9) and session and 0 and in_names and in_vals and 3 and out_names and 1 and out_vals)
    # Run is done: inputs were copied/consumed, so the input OrtValues and every
    # scratch buffer can be released now regardless of success/failure. The audio
    # OrtValue (extracted below on success) is the only thing kept alive.
    if st == 0:
        set audio_val to tts_peek_ptr_buf(out_vals and 0)
        set sinfo_out to alloc_bytes(8)
        set st to ep_dlcall2(tts_ort_fn(api and 65) and audio_val and sinfo_out)
        set sinfo to tts_peek_ptr_buf(sinfo_out and 0)
        set count_out to alloc_bytes(8)
        set st to ep_dlcall2(tts_ort_fn(api and 64) and sinfo and count_out)
        set audio_len to tts_peek_ptr_buf(count_out and 0)
        set data_out to alloc_bytes(8)
        set st to ep_dlcall2(tts_ort_fn(api and 51) and audio_val and data_out)
        set ok to map_insert(out and "ptr" and tts_peek_ptr_buf(data_out and 0))
        set ok to map_insert(out and "len" and audio_len)
        set ok to map_insert(out and "val" and audio_val)
        # ReleaseTensorTypeAndShapeInfo(sinfo) — OrtApi index 99.
        set ok to ep_dlcall1(tts_ort_fn(api and 99) and sinfo)
        set ok to free_bytes(sinfo_out)
        set ok to free_bytes(count_out)
        set ok to free_bytes(data_out)
    set ok to tts_ort_release_value(api and tok_val)
    set ok to tts_ort_release_value(api and style_val)
    set ok to tts_ort_release_value(api and speed_val)
    set ok to free_bytes(tok_data)
    set ok to free_bytes(tok_shape)
    set ok to free_bytes(tok_vout)
    set ok to free_bytes(style_buf)
    set ok to free_bytes(style_shape)
    set ok to free_bytes(style_vout)
    set ok to free_bytes(speed_buf)
    set ok to free_bytes(speed_shape)
    set ok to free_bytes(speed_vout)
    set ok to free_bytes(nm_tokens)
    set ok to free_bytes(nm_style)
    set ok to free_bytes(nm_speed)
    set ok to free_bytes(nm_audio)
    set ok to free_bytes(in_names)
    set ok to free_bytes(in_vals)
    set ok to free_bytes(out_names)
    set ok to free_bytes(out_vals)
    return out

# Open the kokoro ONNX session once; returns {api, session, mem} (api=0 on failure).
define tts_ort_open returning Map:
    set out to create_map()
    set ok to map_insert(out and "api" and 0)
    set lib to ep_dlopen("/Users/mettamazza/.ernos/kokoro-venv/lib/python3.12/site-packages/onnxruntime/capi/libonnxruntime.1.24.4.dylib")
    if lib == 0:
        return out
    set api to ep_dlcall1(tts_peek_ptr_buf(ep_dlcall0(ep_dlsym(lib and "OrtGetApiBase")) and 0) and 24)
    set env_out to alloc_bytes(8)
    set st to ep_dlcall3(tts_ort_fn(api and 3) and 2 and tts_str_to_buf("tts") and env_out)
    set opt_out to alloc_bytes(8)
    set st to ep_dlcall1(tts_ort_fn(api and 10) and opt_out)
    set sess_out to alloc_bytes(8)
    set st to ep_dlcall4(tts_ort_fn(api and 7) and tts_peek_ptr_buf(env_out and 0) and tts_str_to_buf("/Users/mettamazza/.ernosagent/models/kokoro-v1.0.onnx") and tts_peek_ptr_buf(opt_out and 0) and sess_out)
    if st != 0:
        return out
    set mem_out to alloc_bytes(8)
    set st to ep_dlcall3(tts_ort_fn(api and 69) and 0 and 0 and mem_out)
    set ok to map_insert(out and "api" and api)
    set ok to map_insert(out and "session" and tts_peek_ptr_buf(sess_out and 0))
    set ok to map_insert(out and "mem" and tts_peek_ptr_buf(mem_out and 0))
    return out

# espeak-ng keeps global, NON-thread-safe state (espeak_Initialize / SetVoice /
# TextToPhonemes all touch process-wide phoneme tables). The node drives TTS from
# several threads at once — the Web UI 🔊 handler (a spawned per-client thread) and
# the IPC "TTS SPEAK" handler used by the Discord bridge. Two overlapping syntheses
# race espeak's tables and corrupt the heap, which surfaces as a flood of
# "Invalid instruction NNNN for phoneme '<garbage>'" (espeak walking clobbered phoneme
# programs) followed by a segfault. Serialize the whole pipeline (espeak + the shared
# ORT env/session) behind one mutex so only one synthesis runs at a time. Created
# eagerly at module load, before any worker thread is spawned, so there is no
# lazy-init race on the mutex itself.
set TTS_MUTEX to create_mutex()

# Full TTS: chunk `text`, synthesize each chunk, and write one concatenated 24kHz
# mono PCM16 WAV at wav_path. Returns 0 on success. Thread-safe entry point: holds
# TTS_MUTEX across the entire (single-threaded) synthesis in tts_speak_locked.
define tts_speak with text as Str and wav_path as Str returning Int:
    lock_mutex(TTS_MUTEX)
    set rc to tts_speak_locked(text and wav_path)
    unlock_mutex(TTS_MUTEX)
    return rc

define tts_speak_locked with text as Str and wav_path as Str returning Int:
    set ses to tts_ort_open()
    if map_get_val(ses and "api") == 0:
        return 3
    set api to map_get_val(ses and "api")
    set session to map_get_val(ses and "session")
    set mem_info to map_get_val(ses and "mem")
    set vocab to tts_build_vocab()
    set chunks to tts_chunk_text(text)
    set nc to length_list(chunks)
    set ptrs to create_list()
    set lens to create_list()
    set ci to 0
    repeat while ci < nc:
        set tokens to tts_tokenize(vocab and tts_phonemize(get_list(chunks and ci)))
        set res to tts_run_tokens(api and session and mem_info and tokens)
        if map_get_val(res and "len") > 0:
            set ok to append_list(ptrs and map_get_val(res and "ptr"))
            set ok to append_list(lens and map_get_val(res and "len"))
        set ci to ci + 1
    if length_list(ptrs) == 0:
        return 5
    set wr to tts_write_wav_multi(wav_path and ptrs and lens and 24000)
    return 0

# Write float32 audio samples (at audio_ptr) as a 24kHz mono PCM16 WAV via libc.
define tts_write_wav_f32 with path as Str and audio_ptr as Int and n_samples as Int and rate as Int returning Int:
    set libc to ep_dlopen("/usr/lib/libSystem.B.dylib")
    set fp to ep_dlcall2(ep_dlsym(libc and "fopen") and tts_str_to_buf(path) and tts_str_to_buf("wb"))
    if fp == 0:
        return 1
    set hdr to tts_build_wav_header(n_samples and rate)
    set wr to ep_dlcall4(ep_dlsym(libc and "fwrite") and hdr and 1 and 44 and fp)
    set ok to tts_fwrite_pcm(libc and fp and audio_ptr and n_samples)
    set ok to ep_dlcall1(ep_dlsym(libc and "fclose") and fp)
    return 0

# Build a 44-byte canonical WAV header (mono 16-bit PCM) for n_samples at `rate`.
define tts_build_wav_header with n_samples as Int and rate as Int returning Int:
    set data_bytes to n_samples * 2
    set hdr to alloc_bytes(44)
    set ok to poke_byte(hdr and 0 and 82)
    set ok to poke_byte(hdr and 1 and 73)
    set ok to poke_byte(hdr and 2 and 70)
    set ok to poke_byte(hdr and 3 and 70)
    set ok to tts_poke_u32(hdr and 4 and (36 + data_bytes))
    set ok to poke_byte(hdr and 8 and 87)
    set ok to poke_byte(hdr and 9 and 65)
    set ok to poke_byte(hdr and 10 and 86)
    set ok to poke_byte(hdr and 11 and 69)
    set ok to poke_byte(hdr and 12 and 102)
    set ok to poke_byte(hdr and 13 and 109)
    set ok to poke_byte(hdr and 14 and 116)
    set ok to poke_byte(hdr and 15 and 32)
    set ok to tts_poke_u32(hdr and 16 and 16)
    set ok to poke_byte(hdr and 20 and 1)
    set ok to poke_byte(hdr and 21 and 0)
    set ok to poke_byte(hdr and 22 and 1)
    set ok to poke_byte(hdr and 23 and 0)
    set ok to tts_poke_u32(hdr and 24 and rate)
    set ok to tts_poke_u32(hdr and 28 and (rate * 2))
    set ok to poke_byte(hdr and 32 and 2)
    set ok to poke_byte(hdr and 33 and 0)
    set ok to poke_byte(hdr and 34 and 16)
    set ok to poke_byte(hdr and 35 and 0)
    set ok to poke_byte(hdr and 36 and 100)
    set ok to poke_byte(hdr and 37 and 97)
    set ok to poke_byte(hdr and 38 and 116)
    set ok to poke_byte(hdr and 39 and 97)
    set ok to tts_poke_u32(hdr and 40 and data_bytes)
    return hdr

# Convert n_samples float32 (at aptr) to PCM16 and fwrite them to fp.
define tts_fwrite_pcm with libc as Int and fp as Int and aptr as Int and n_samples as Int returning Int:
    set pcm to alloc_bytes(n_samples * 2)
    set i to 0
    repeat while i < n_samples:
        set fixed to tts_f32_to_fixed(tts_peek_u32(aptr and i * 4))
        set s16 to (fixed * 32767) / 1000000
        if s16 > 32767:
            set s16 to 32767
        if s16 < (0 - 32768):
            set s16 to (0 - 32768)
        set ok to tts_poke_i16(pcm and i * 2 and s16)
        set i to i + 1
    set wr to ep_dlcall4(ep_dlsym(libc and "fwrite") and pcm and 1 and (n_samples * 2) and fp)
    set ok to free_bytes(pcm)
    return 0

# Write multiple audio chunks (parallel ptrs/lens lists) as one concatenated WAV.
define tts_write_wav_multi with path as Str and ptrs as List and lens as List and rate as Int returning Int:
    set total to 0
    set k to 0
    repeat while k < length_list(lens):
        set total to total + get_list(lens and k)
        set k to k + 1
    set libc to ep_dlopen("/usr/lib/libSystem.B.dylib")
    set fp to ep_dlcall2(ep_dlsym(libc and "fopen") and tts_str_to_buf(path) and tts_str_to_buf("wb"))
    if fp == 0:
        return 1
    set wr to ep_dlcall4(ep_dlsym(libc and "fwrite") and tts_build_wav_header(total and rate) and 1 and 44 and fp)
    set ci to 0
    repeat while ci < length_list(ptrs):
        set ok to tts_fwrite_pcm(libc and fp and get_list(ptrs and ci) and get_list(lens and ci))
        set ci to ci + 1
    set ok to ep_dlcall1(ep_dlsym(libc and "fclose") and fp)
    return 0

# Send a complete HTTP response whose body is RAW BYTES (e.g. a WAV file).
# The normal send_response()/net_send in http.ep are C-string based and truncate
# at the first NUL — useless for binary. header_str must be the full status line +
# headers + blank line (NUL-free); body_ptr/body_len point at the raw payload.
# Caller owns body_ptr and must close client_fd afterwards.
define tts_http_send_binary with client_fd as Int and header_str as Str and body_ptr as Int and body_len as Int returning Int:
    set hlen to string_length(header_str)
    set total to hlen + body_len
    set buf to alloc_bytes(total)
    set i to 0
    repeat while i < hlen:
        set ok to poke_byte(buf and i and get_character(header_str and i))
        set i to i + 1
    set j to 0
    repeat while j < body_len:
        set ok to poke_byte(buf and hlen + j and peek_byte(body_ptr and j))
        set j to j + 1
    set ok to ep_net_send_raw(client_fd and buf and total)
    set ok to free_bytes(buf)
    return 1

# Deterministic filename for a TTS request: djb2 hash of the text.
# Identical message text reuses the same cached WAV; distinct text gets a
# distinct file. Shared by the Web UI server and the node's TTS SPEAK verb so
# both resolve the same path (under decent_web/tts/, inside the web root).
define tts_filename_for with text as Str returning Str:
    set h to 5381
    set i to 0
    set n to string_length(text)
    repeat while i < n:
        set h to ((h * 33) + get_character(text and i)) modulo 1000000007
        set i to i + 1
    return concat("tts_" and concat(int_to_string(h) and ".wav"))

# Binary-safe read of a whole file into a fresh byte buffer.
# Returns Map{ptr, len}; ptr==0 on failure. EP's read_file is C-string based
# (truncates at the first NUL), so binary assets like WAVs must come through here.
define tts_read_file_bytes with path as Str returning Map:
    set out to create_map()
    set ok to map_insert(out and "ptr" and 0)
    set ok to map_insert(out and "len" and 0)
    set libc to ep_dlopen("/usr/lib/libSystem.B.dylib")
    set fp to ep_dlcall2(ep_dlsym(libc and "fopen") and tts_str_to_buf(path) and tts_str_to_buf("rb"))
    if fp == 0:
        return out
    # fseek(fp, 0, SEEK_END=2); ftell -> size; fseek(fp, 0, SEEK_SET=0)
    set ok to ep_dlcall3(ep_dlsym(libc and "fseek") and fp and 0 and 2)
    set size to ep_dlcall1(ep_dlsym(libc and "ftell") and fp)
    set ok to ep_dlcall3(ep_dlsym(libc and "fseek") and fp and 0 and 0)
    if size <= 0:
        set ok to ep_dlcall1(ep_dlsym(libc and "fclose") and fp)
        return out
    set buf to alloc_bytes(size)
    set rd to ep_dlcall4(ep_dlsym(libc and "fread") and buf and 1 and size and fp)
    set ok to ep_dlcall1(ep_dlsym(libc and "fclose") and fp)
    set ok to map_insert(out and "ptr" and buf)
    set ok to map_insert(out and "len" and rd)
    return out

# Copy an EP string into a fresh NUL-terminated C buffer; returns its address.
define tts_str_to_buf with s as Str returning Int:
    set n to string_length(s)
    set buf to alloc_bytes(n + 1)
    set i to 0
    repeat while i < n:
        set ok to poke_byte(buf and i and get_character(s and i))
        set i to i + 1
    set ok to poke_byte(buf and n and 0)
    return buf

# Write a 64-bit little-endian pointer value into buf at off.
define tts_poke_ptr with buf as Int and off as Int and ptr as Int returning Int:
    set p to ptr
    set j to 0
    repeat while j < 8:
        set ok to poke_byte(buf and off + j and (p modulo 256))
        set p to p / 256
        set j to j + 1
    return 0

# Read a NUL-terminated C string at ptr into an EP string.
define tts_cstr_at with ptr as Int returning Str:
    set bytes to create_list()
    set i to 0
    set b to peek_byte(ptr and i)
    repeat while b != 0 and also i < 200000:
        set ok to append_list(bytes and b)
        set i to i + 1
        set b to peek_byte(ptr and i)
    set s to string_from_list(bytes)
    free_list(bytes)
    return s

# espeak-ng must be initialized ONCE per process. The old tts_phonemize re-ran
# espeak_Initialize on every call (and the over-eager chunker made that several calls
# per message), which reloads espeak's phoneme-data tables each time. In the
# long-running, heap-busy node that reload churn corrupts those tables — espeak then
# reports "Wrong version of espeak-ng-data ... got 0x0" or a flood of
# "Invalid instruction NNNN for phoneme '<garbage>'" and finally segfaults. Load the
# library, initialize, and select the voice exactly once; cache the handle and only
# run TextToPhonemes per request thereafter. These globals are mutated only while
# TTS_MUTEX is held — tts_phonemize is reached solely via tts_speak (which holds the
# lock); test harnesses call it single-threaded — so no additional guard is needed.
set ESPEAK_LIB to 0
set ESPEAK_READY to 0

define tts_espeak_ensure returning Int:
    if ESPEAK_READY == 1:
        return ESPEAK_LIB
    set lib to ep_dlopen("/opt/homebrew/lib/libespeak-ng.dylib")
    if lib == 0:
        return 0
    set f_init to ep_dlsym(lib and "espeak_Initialize")
    set path_buf to tts_str_to_buf("/opt/homebrew/share/espeak-ng-data")
    # output=2 (SYNCHRONOUS — no audio device opened), buflength=0, path, options=0
    set sr to ep_dlcall4(f_init and 2 and 0 and path_buf and 0)
    free_bytes(path_buf)
    # British English voice (for Fable). The language code "en-gb" is NOT accepted by
    # SetVoiceByName (returns NOT_FOUND) — the VoiceName form is required, else no voice
    # loads and TextToPhonemes segfaults.
    set f_voice to ep_dlsym(lib and "espeak_SetVoiceByName")
    set voice_buf to tts_str_to_buf("English (Great Britain)")
    set vr to ep_dlcall1(f_voice and voice_buf)
    free_bytes(voice_buf)
    set ESPEAK_LIB to lib
    set ESPEAK_READY to 1
    return lib

# ── Phonemize via libespeak-ng: text -> IPA phonemes (British voice for Fable) ──
# espeak is initialized once (tts_espeak_ensure); this only runs TextToPhonemes.
define tts_phonemize with text as Str returning Str:
    set lib to tts_espeak_ensure()
    if lib == 0:
        return ""
    set text_buf to tts_str_to_buf(text)
    set textptr to alloc_bytes(8)
    set ok to tts_poke_ptr(textptr and 0 and text_buf)
    set f_ph to ep_dlsym(lib and "espeak_TextToPhonemes")
    # TextToPhonemes returns ONE clause and advances *textptr; loop until consumed.
    # textmode=1 (UTF8), phonememode=2 (IPA, no separator).
    set phonemes to ""
    set guard to 0
    set more to 1
    repeat while more == 1 and also guard < 1000:
        set ph_ptr to ep_dlcall3(f_ph and textptr and 1 and 2)
        if ph_ptr != 0:
            set phonemes to concat(phonemes and tts_cstr_at(ph_ptr))
            set phonemes to concat(phonemes and " ")
        # read *textptr (the advanced pointer); 0 => done
        set nextp to 0
        set k to 7
        repeat while k >= 0:
            set nextp to nextp * 256 + peek_byte(textptr and k)
            set k to k - 1
        if nextp == 0:
            set more to 0
        set guard to guard + 1
    free_bytes(text_buf)
    free_bytes(textptr)
    return phonemes

# ── Kokoro vocab: phoneme codepoint -> token id (from kokoro_onnx config.json) ──
define tts_vocab_put with v as Map and cp as Int and id as Int returning Int:
    set ok to map_insert(v and int_to_string(cp) and id)
    return 0

