# ErnosDecent -- Vector Embeddings Generation & Similarity Search
# Component: decent_ai/embeddings.ep
# Status: Production -- OperationTrojanClaude Phase 9

import "collections"
import "inference"

define embeddings_generate with model as Map and text as Str returning List:
    set tokens to inference_tokenize(model and text)
    set tokens_len to length_list(tokens)
    
    set tensors to map_get_val(model and "tensors")
    set w_emb_map to map_get_val(tensors and "token_embeddings.weight")
    set w_emb to map_get_val(w_emb_map and "data")
    
    set hidden_dim to 16
    set emb_sum to create_list()
    
    set h_i to 0
    repeat while h_i < hidden_dim:
        set ok to append_list(emb_sum and 0)
        set h_i to h_i + 1
        
    if tokens_len == 0:
        free_list(tokens)
        return emb_sum
        
    set tok_i to 0
    repeat while tok_i < tokens_len:
        set tok_id to get_list(tokens and tok_i)
        
        set dim_i to 0
        repeat while dim_i < hidden_dim:
            set w_val to get_list(w_emb and tok_id * hidden_dim + dim_i)
            set cur_sum to get_list(emb_sum and dim_i)
            set ok to set_list(emb_sum and dim_i and cur_sum + w_val)
            set dim_i to dim_i + 1
            
        set tok_i to tok_i + 1
        
    set avg_i to 0
    repeat while avg_i < hidden_dim:
        set sum_val to get_list(emb_sum and avg_i)
        set ok to set_list(emb_sum and avg_i and sum_val / tokens_len)
        set avg_i to avg_i + 1
        
    free_list(tokens)
    return emb_sum

define embeddings_cosine_similarity with vec_a as List and vec_b as List returning Int:
    set len to length_list(vec_a)
    set scale to 1000000
    
    set dot_product to 0
    set i to 0
    repeat while i < len:
        set val_a to get_list(vec_a and i)
        set val_b to get_list(vec_b and i)
        set dot_product to dot_product + (val_a * val_b) / scale
        set i to i + 1
        
    set norm_a_val to 0
    set j to 0
    repeat while j < len:
        set val_a to get_list(vec_a and j)
        set norm_a_val to norm_a_val + (val_a * val_a) / scale
        set j to j + 1
    set rms_a to fixed_sqrt(norm_a_val)
    
    set norm_b_val to 0
    set k to 0
    repeat while k < len:
        set val_b to get_list(vec_b and k)
        set norm_b_val to norm_b_val + (val_b * val_b) / scale
        set k to k + 1
    set rms_b to fixed_sqrt(norm_b_val)
    
    if rms_a == 0 or else rms_b == 0:
        return 0
        
    set sim to (dot_product * scale) / rms_a
    set sim to (sim * scale) / rms_b
    return sim
