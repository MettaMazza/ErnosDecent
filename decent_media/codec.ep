# ErnosDecent -- Media Codecs (Opus / VP8 wrappers and ADPCM / Delta-RLE Fallbacks)
# Component: decent_media/codec.ep
# Status: Production -- Phase 10

import "collections"
import "math"

# FFI Externals
external define ep_dlopen with lib as Str returning Int:
external define ep_dlsym with handle as Int and name as Str returning Int:
external define ep_dlcall0 with fn as Int returning Int:
external define ep_dlcall1 with fn as Int and a0 as Int returning Int:
external define ep_dlcall2 with fn as Int and a0 as Int and a1 as Int returning Int:
external define ep_dlcall3 with fn as Int and a0 as Int and a1 as Int and a2 as Int returning Int:
external define ep_dlcall4 with fn as Int and a0 as Int and a1 as Int and a2 as Int and a3 as Int returning Int:
external define ep_dlcall5 with fn as Int and a0 as Int and a1 as Int and a2 as Int and a3 as Int and a4 as Int returning Int:
external define ep_dlcall6 with fn as Int and a0 as Int and a1 as Int and a2 as Int and a3 as Int and a4 as Int and a5 as Int returning Int:
# Raw byte-buffer primitives (build.sh-injected C helpers; used by webrtc.ep too).
external define alloc_bytes with n as Int returning Int:
external define free_bytes with ptr as Int returning Int:
external define poke_byte with ptr as Int and offset as Int and value as Int returning Int:
external define peek_byte with ptr as Int and offset as Int returning Int:

# Global lookup lists for ADPCM
set ADPCM_STEPS to 0
set ADPCM_INDEX_ADJUST to 0

define init_adpcm_tables returning Int:
    if ADPCM_STEPS != 0:
        return 0
        
    # 89 standard step sizes for IMA-ADPCM
    # Populate the global list directly. Assigning a locally-owned list into the
    # global leaves the global pointing at storage the generated runtime releases
    # when this function returns (confirmed by Linux AddressSanitizer).
    set ADPCM_STEPS to create_list()
    set ok to append_list(ADPCM_STEPS and 7)
    set ok to append_list(ADPCM_STEPS and 8)
    set ok to append_list(ADPCM_STEPS and 9)
    set ok to append_list(ADPCM_STEPS and 10)
    set ok to append_list(ADPCM_STEPS and 11)
    set ok to append_list(ADPCM_STEPS and 12)
    set ok to append_list(ADPCM_STEPS and 13)
    set ok to append_list(ADPCM_STEPS and 14)
    set ok to append_list(ADPCM_STEPS and 16)
    set ok to append_list(ADPCM_STEPS and 17)
    set ok to append_list(ADPCM_STEPS and 19)
    set ok to append_list(ADPCM_STEPS and 21)
    set ok to append_list(ADPCM_STEPS and 23)
    set ok to append_list(ADPCM_STEPS and 25)
    set ok to append_list(ADPCM_STEPS and 28)
    set ok to append_list(ADPCM_STEPS and 31)
    set ok to append_list(ADPCM_STEPS and 34)
    set ok to append_list(ADPCM_STEPS and 37)
    set ok to append_list(ADPCM_STEPS and 41)
    set ok to append_list(ADPCM_STEPS and 45)
    set ok to append_list(ADPCM_STEPS and 50)
    set ok to append_list(ADPCM_STEPS and 55)
    set ok to append_list(ADPCM_STEPS and 60)
    set ok to append_list(ADPCM_STEPS and 66)
    set ok to append_list(ADPCM_STEPS and 73)
    set ok to append_list(ADPCM_STEPS and 80)
    set ok to append_list(ADPCM_STEPS and 88)
    set ok to append_list(ADPCM_STEPS and 97)
    set ok to append_list(ADPCM_STEPS and 107)
    set ok to append_list(ADPCM_STEPS and 118)
    set ok to append_list(ADPCM_STEPS and 130)
    set ok to append_list(ADPCM_STEPS and 143)
    set ok to append_list(ADPCM_STEPS and 157)
    set ok to append_list(ADPCM_STEPS and 173)
    set ok to append_list(ADPCM_STEPS and 190)
    set ok to append_list(ADPCM_STEPS and 209)
    set ok to append_list(ADPCM_STEPS and 230)
    set ok to append_list(ADPCM_STEPS and 253)
    set ok to append_list(ADPCM_STEPS and 279)
    set ok to append_list(ADPCM_STEPS and 307)
    set ok to append_list(ADPCM_STEPS and 337)
    set ok to append_list(ADPCM_STEPS and 371)
    set ok to append_list(ADPCM_STEPS and 408)
    set ok to append_list(ADPCM_STEPS and 449)
    set ok to append_list(ADPCM_STEPS and 494)
    set ok to append_list(ADPCM_STEPS and 544)
    set ok to append_list(ADPCM_STEPS and 598)
    set ok to append_list(ADPCM_STEPS and 658)
    set ok to append_list(ADPCM_STEPS and 724)
    set ok to append_list(ADPCM_STEPS and 796)
    set ok to append_list(ADPCM_STEPS and 876)
    set ok to append_list(ADPCM_STEPS and 963)
    set ok to append_list(ADPCM_STEPS and 1060)
    set ok to append_list(ADPCM_STEPS and 1166)
    set ok to append_list(ADPCM_STEPS and 1282)
    set ok to append_list(ADPCM_STEPS and 1411)
    set ok to append_list(ADPCM_STEPS and 1552)
    set ok to append_list(ADPCM_STEPS and 1707)
    set ok to append_list(ADPCM_STEPS and 1878)
    set ok to append_list(ADPCM_STEPS and 2066)
    set ok to append_list(ADPCM_STEPS and 2272)
    set ok to append_list(ADPCM_STEPS and 2499)
    set ok to append_list(ADPCM_STEPS and 2749)
    set ok to append_list(ADPCM_STEPS and 3024)
    set ok to append_list(ADPCM_STEPS and 3327)
    set ok to append_list(ADPCM_STEPS and 3660)
    set ok to append_list(ADPCM_STEPS and 4026)
    set ok to append_list(ADPCM_STEPS and 4428)
    set ok to append_list(ADPCM_STEPS and 4871)
    set ok to append_list(ADPCM_STEPS and 5358)
    set ok to append_list(ADPCM_STEPS and 5894)
    set ok to append_list(ADPCM_STEPS and 6484)
    set ok to append_list(ADPCM_STEPS and 7132)
    set ok to append_list(ADPCM_STEPS and 7845)
    set ok to append_list(ADPCM_STEPS and 8630)
    set ok to append_list(ADPCM_STEPS and 9493)
    set ok to append_list(ADPCM_STEPS and 10442)
    set ok to append_list(ADPCM_STEPS and 11487)
    set ok to append_list(ADPCM_STEPS and 12635)
    set ok to append_list(ADPCM_STEPS and 13899)
    set ok to append_list(ADPCM_STEPS and 15289)
    set ok to append_list(ADPCM_STEPS and 16818)
    set ok to append_list(ADPCM_STEPS and 18500)
    set ok to append_list(ADPCM_STEPS and 20350)
    set ok to append_list(ADPCM_STEPS and 22385)
    set ok to append_list(ADPCM_STEPS and 24623)
    set ok to append_list(ADPCM_STEPS and 27086)
    set ok to append_list(ADPCM_STEPS and 29794)
    set ok to append_list(ADPCM_STEPS and 32767)
    
    set ADPCM_INDEX_ADJUST to create_list()
    # IMA index adjustment for 4-bit codes (0-7 represent positive, 8-15 represent negative diffs)
    # The standard adjust is based on the magnitude of the code (lower 3 bits)
    # Index adjustments for code 0-7:
    set ok to append_list(ADPCM_INDEX_ADJUST and -1)
    set ok to append_list(ADPCM_INDEX_ADJUST and -1)
    set ok to append_list(ADPCM_INDEX_ADJUST and -1)
    set ok to append_list(ADPCM_INDEX_ADJUST and -1)
    set ok to append_list(ADPCM_INDEX_ADJUST and 2)
    set ok to append_list(ADPCM_INDEX_ADJUST and 4)
    set ok to append_list(ADPCM_INDEX_ADJUST and 6)
    set ok to append_list(ADPCM_INDEX_ADJUST and 8)
    
    return 0

define codec_init returning Map:
    set ctx to create_map()
    
    # Attempt loading libopus
    set lib_opus to ep_dlopen("libopus.dylib")
    if lib_opus == 0:
        set lib_opus to ep_dlopen("libopus.so.0")
    if lib_opus == 0:
        set lib_opus to ep_dlopen("/opt/homebrew/lib/libopus.dylib")
        
    set has_opus to 0
    if lib_opus != 0:
        set has_opus to 1
    set ok to map_insert(ctx and "has_opus" and has_opus)
    set ok to map_insert(ctx and "opus_handle" and lib_opus)

    # Real Opus: create a mono 48 kHz VOIP encoder/decoder pair and resolve the
    # encode/decode entry points. 960 samples = one 20 ms frame at 48 kHz.
    # OPUS_APPLICATION_VOIP = 2048. opus_*_create take a trailing int* error arg;
    # passing NULL (0) is allowed (the error is simply not written).
    set ok to map_insert(ctx and "opus_fs" and 48000)
    set ok to map_insert(ctx and "opus_frame" and 960)
    set ok to map_insert(ctx and "opus_enc" and 0)
    set ok to map_insert(ctx and "opus_dec" and 0)
    set ok to map_insert(ctx and "opus_enc_destroy_fn" and 0)
    set ok to map_insert(ctx and "opus_dec_destroy_fn" and 0)
    if has_opus == 1:
        set fn_enc_create to ep_dlsym(lib_opus and "opus_encoder_create")
        set fn_dec_create to ep_dlsym(lib_opus and "opus_decoder_create")
        if fn_enc_create != 0 and also fn_dec_create != 0:
            set enc to ep_dlcall4(fn_enc_create and 48000 and 1 and 2048 and 0)
            set dec to ep_dlcall3(fn_dec_create and 48000 and 1 and 0)
            set encode_fn to ep_dlsym(lib_opus and "opus_encode")
            set decode_fn to ep_dlsym(lib_opus and "opus_decode")
            set enc_destroy_fn to ep_dlsym(lib_opus and "opus_encoder_destroy")
            set dec_destroy_fn to ep_dlsym(lib_opus and "opus_decoder_destroy")
            set ok to map_insert(ctx and "opus_enc" and enc)
            set ok to map_insert(ctx and "opus_dec" and dec)
            set ok to map_insert(ctx and "opus_encode_fn" and encode_fn)
            set ok to map_insert(ctx and "opus_decode_fn" and decode_fn)
            set ok to map_insert(ctx and "opus_enc_destroy_fn" and enc_destroy_fn)
            set ok to map_insert(ctx and "opus_dec_destroy_fn" and dec_destroy_fn)
            if enc == 0 or else dec == 0 or else encode_fn == 0 or else decode_fn == 0 or else enc_destroy_fn == 0 or else dec_destroy_fn == 0:
                if enc != 0 and also enc_destroy_fn != 0:
                    set ignored_void_result to ep_dlcall1(enc_destroy_fn and enc)
                if dec != 0 and also dec_destroy_fn != 0:
                    set ignored_void_result to ep_dlcall1(dec_destroy_fn and dec)
                set ok to map_insert(ctx and "opus_enc" and 0)
                set ok to map_insert(ctx and "opus_dec" and 0)
                set ok to map_insert(ctx and "has_opus" and 0)
        else:
            set ok to map_insert(ctx and "has_opus" and 0)
    
    # Attempt loading libvpx
    set lib_vpx to ep_dlopen("libvpx.dylib")
    if lib_vpx == 0:
        set lib_vpx to ep_dlopen("libvpx.so.7")
    if lib_vpx == 0:
        set lib_vpx to ep_dlopen("/opt/homebrew/lib/libvpx.dylib")
        
    set has_vpx to 0
    if lib_vpx != 0:
        set has_vpx to 1
    set ok to map_insert(ctx and "has_vpx" and has_vpx)
    set ok to map_insert(ctx and "vpx_handle" and lib_vpx)

    # Real VP8 (libvpx): resolve the encoder/decoder ifaces + entry points. Struct
    # offsets and ABI versions below are ground-truthed from /opt/homebrew/include/vpx
    # (VPX_ENCODER_ABI_VERSION=37, VPX_DECODER_ABI_VERSION=12, I420=258).
    set ok to map_insert(ctx and "vpx_cx_iface" and 0)
    set ok to map_insert(ctx and "vpx_dx_iface" and 0)
    if has_vpx == 1:
        set fn_cx to ep_dlsym(lib_vpx and "vpx_codec_vp8_cx")
        set fn_dx to ep_dlsym(lib_vpx and "vpx_codec_vp8_dx")
        if fn_cx != 0 and also fn_dx != 0:
            set cx_iface to ep_dlcall0(fn_cx)
            set dx_iface to ep_dlcall0(fn_dx)
            set enc_cfg_fn to ep_dlsym(lib_vpx and "vpx_codec_enc_config_default")
            set enc_init_fn to ep_dlsym(lib_vpx and "vpx_codec_enc_init_ver")
            set img_alloc_fn to ep_dlsym(lib_vpx and "vpx_img_alloc")
            set img_free_fn to ep_dlsym(lib_vpx and "vpx_img_free")
            set encode_fn to ep_dlsym(lib_vpx and "vpx_codec_encode")
            set get_cx_fn to ep_dlsym(lib_vpx and "vpx_codec_get_cx_data")
            set destroy_fn to ep_dlsym(lib_vpx and "vpx_codec_destroy")
            set dec_init_fn to ep_dlsym(lib_vpx and "vpx_codec_dec_init_ver")
            set decode_fn to ep_dlsym(lib_vpx and "vpx_codec_decode")
            set get_frame_fn to ep_dlsym(lib_vpx and "vpx_codec_get_frame")
            set ok to map_insert(ctx and "vpx_cx_iface" and cx_iface)
            set ok to map_insert(ctx and "vpx_dx_iface" and dx_iface)
            set ok to map_insert(ctx and "vpx_enc_cfg_default_fn" and enc_cfg_fn)
            set ok to map_insert(ctx and "vpx_enc_init_fn" and enc_init_fn)
            set ok to map_insert(ctx and "vpx_img_alloc_fn" and img_alloc_fn)
            set ok to map_insert(ctx and "vpx_img_free_fn" and img_free_fn)
            set ok to map_insert(ctx and "vpx_encode_fn" and encode_fn)
            set ok to map_insert(ctx and "vpx_get_cx_data_fn" and get_cx_fn)
            set ok to map_insert(ctx and "vpx_destroy_fn" and destroy_fn)
            set ok to map_insert(ctx and "vpx_dec_init_fn" and dec_init_fn)
            set ok to map_insert(ctx and "vpx_decode_fn" and decode_fn)
            set ok to map_insert(ctx and "vpx_get_frame_fn" and get_frame_fn)
            if cx_iface == 0 or else dx_iface == 0 or else enc_cfg_fn == 0 or else enc_init_fn == 0 or else img_alloc_fn == 0 or else img_free_fn == 0 or else encode_fn == 0 or else get_cx_fn == 0 or else destroy_fn == 0 or else dec_init_fn == 0 or else decode_fn == 0 or else get_frame_fn == 0:
                set ok to map_insert(ctx and "has_vpx" and 0)
        else:
            set ok to map_insert(ctx and "has_vpx" and 0)
    
    set adpcm_init_err to init_adpcm_tables()
    set ok to map_insert(ctx and "adpcm_init_error" and adpcm_init_err)
    return ctx

# Release every native resource owned by a codec context. Returns 0 on success.
define codec_close with ctx as Map returning Int:
    set close_error to 0
    set enc to map_get_val(ctx and "opus_enc")
    set dec to map_get_val(ctx and "opus_dec")
    set enc_destroy_fn to map_get_val(ctx and "opus_enc_destroy_fn")
    set dec_destroy_fn to map_get_val(ctx and "opus_dec_destroy_fn")
    if enc != 0:
        if enc_destroy_fn == 0:
            display "ERROR: codec_close cannot release the Opus encoder because opus_encoder_destroy is unavailable"
            set close_error to 1
        else:
            set ignored_void_result to ep_dlcall1(enc_destroy_fn and enc)
            set ok to map_insert(ctx and "opus_enc" and 0)
    if dec != 0:
        if dec_destroy_fn == 0:
            display "ERROR: codec_close cannot release the Opus decoder because opus_decoder_destroy is unavailable"
            set close_error to 1
        else:
            set ignored_void_result to ep_dlcall1(dec_destroy_fn and dec)
            set ok to map_insert(ctx and "opus_dec" and 0)
    return close_error

# IMA-ADPCM Audio Encoder
# Write a signed 16-bit PCM sample (two's complement) little-endian into buf[off..off+1].
define codec_poke_i16 with buf as Int and off as Int and sample as Int returning Int:
    set u to sample
    if u < 0:
        set u to u + 65536
    set ok to poke_byte(buf and off and u modulo 256)
    set ok to poke_byte(buf and off + 1 and (u / 256) modulo 256)
    return 0

# Read a signed 16-bit little-endian PCM sample from buf[off..off+1].
define codec_peek_i16 with buf as Int and off as Int returning Int:
    set lo to peek_byte(buf and off)
    set hi to peek_byte(buf and off + 1)
    set u to hi * 256 + lo
    if u >= 32768:
        set u to u - 65536
    return u

# Real libopus encode. Frames the PCM into 20 ms (960-sample) Opus frames and emits
# [nframes, len1, b1.., len2, b2.., ...]. The last frame is zero-padded to 960.
define codec_opus_encode with ctx as Map and raw_samples as List returning List:
    set enc to map_get_val(ctx and "opus_enc")
    set encode_fn to map_get_val(ctx and "opus_encode_fn")
    set frame to map_get_val(ctx and "opus_frame")
    set out to create_list()
    if enc == 0 or else encode_fn == 0 or else frame <= 0:
        display "ERROR: Opus encoder is not initialized"
        return out
    set total to length_list(raw_samples)
    set nframes to 0
    if total > 0:
        set nframes to (total + frame - 1) / frame
    set ok to append_list(out and nframes)
    set pcm_buf to alloc_bytes(frame * 2)
    set data_buf to alloc_bytes(4000)
    if pcm_buf == 0 or else data_buf == 0:
        display "ERROR: Opus encoder buffer allocation failed"
        if pcm_buf != 0:
            set ok to free_bytes(pcm_buf)
        if data_buf != 0:
            set ok to free_bytes(data_buf)
        return out
    set fi to 0
    repeat while fi < nframes:
        set s to 0
        repeat while s < frame:
            set idx to fi * frame + s
            set sample to 0
            if idx < total:
                set sample to get_list(raw_samples and idx)
            set ok to codec_poke_i16(pcm_buf and s * 2 and sample)
            set s to s + 1
        set nbytes to codec_c_int(ep_dlcall5(encode_fn and enc and pcm_buf and frame and data_buf and 4000))
        if nbytes < 0:
            display concat("ERROR: Opus encoding failed with code " and int_to_string(nbytes))
            set ok to free_bytes(pcm_buf)
            set ok to free_bytes(data_buf)
            set ok to free_list(out)
            return create_list()
        set ok to append_list(out and nbytes)
        set b to 0
        repeat while b < nbytes:
            set ok to append_list(out and peek_byte(data_buf and b))
            set b to b + 1
        set fi to fi + 1
    set ok to free_bytes(pcm_buf)
    set ok to free_bytes(data_buf)
    return out

# Real libopus decode of the framed format produced by codec_opus_encode.
define codec_opus_decode with ctx as Map and encoded as List returning List:
    set dec to map_get_val(ctx and "opus_dec")
    set decode_fn to map_get_val(ctx and "opus_decode_fn")
    set frame to map_get_val(ctx and "opus_frame")
    set decoded to create_list()
    if dec == 0 or else decode_fn == 0 or else frame <= 0:
        display "ERROR: Opus decoder is not initialized"
        return decoded
    set n to length_list(encoded)
    if n == 0:
        return decoded
    set nframes to get_list(encoded and 0)
    if nframes < 0 or else nframes > n - 1:
        display "ERROR: malformed Opus frame count"
        return decoded
    set pos to 1
    set pcm_buf to alloc_bytes(frame * 2)
    if pcm_buf == 0:
        display "ERROR: Opus decoder buffer allocation failed"
        return decoded
    set fi to 0
    repeat while fi < nframes:
        if pos >= n:
            display "ERROR: truncated Opus packet length"
            set ok to free_bytes(pcm_buf)
            set ok to free_list(decoded)
            return create_list()
        set len to get_list(encoded and pos)
        set pos to pos + 1
        if len <= 0 or else len > n - pos:
            display "ERROR: malformed or truncated Opus packet"
            set ok to free_bytes(pcm_buf)
            set ok to free_list(decoded)
            return create_list()
        set data_buf to alloc_bytes(len + 1)
        if data_buf == 0:
            display "ERROR: Opus packet buffer allocation failed"
            set ok to free_bytes(pcm_buf)
            set ok to free_list(decoded)
            return create_list()
        set b to 0
        repeat while b < len:
            set ok to poke_byte(data_buf and b and get_list(encoded and pos + b))
            set b to b + 1
        set pos to pos + len
        set nsamp to codec_c_int(ep_dlcall6(decode_fn and dec and data_buf and len and pcm_buf and frame and 0))
        if nsamp < 0:
            display concat("ERROR: Opus decoding failed with code " and int_to_string(nsamp))
            set ok to free_bytes(data_buf)
            set ok to free_bytes(pcm_buf)
            set ok to free_list(decoded)
            return create_list()
        set s to 0
        repeat while s < nsamp:
            set ok to append_list(decoded and codec_peek_i16(pcm_buf and s * 2))
            set s to s + 1
        set ok to free_bytes(data_buf)
        set fi to fi + 1
    set ok to free_bytes(pcm_buf)
    return decoded

define codec_encode_audio with ctx as Map and raw_samples as List returning List:
    set has_opus to map_get_val(ctx and "has_opus")
    set enc to map_get_val(ctx and "opus_enc")
    if has_opus == 1 and also enc != 0:
        # Real libopus path.
        return codec_opus_encode(ctx and raw_samples)

    # IMA-ADPCM encoding fallback (used only when libopus is unavailable)
    set encoded to create_list()
    set num_samples to length_list(raw_samples)
    if num_samples == 0:
        return encoded
        
    # State tracking: predicted sample and step index
    set predicted_sample to get_list(raw_samples and 0)
    set step_index to 0
    
    # Record starting sample in encoded stream (first 2 elements: sample and index)
    set ok to append_list(encoded and predicted_sample)
    set ok to append_list(encoded and step_index)
    
    set i to 1
    repeat while i < num_samples:
        set sample to get_list(raw_samples and i)
        set diff to sample - predicted_sample
        
        # Determine sign bit
        set sign to 0
        if diff < 0:
            set sign to 8
            set diff to 0 - diff
            
        # Quantize difference into 4-bit nibble
        set step to get_list(ADPCM_STEPS and step_index)
        set code to 0
        set temp_diff to step
        
        if diff >= temp_diff:
            set code to code + 4
            set diff to diff - temp_diff
        set temp_diff to temp_diff / 2
        
        if diff >= temp_diff:
            set code to code + 2
            set diff to diff - temp_diff
        set temp_diff to temp_diff / 2
        
        if diff >= temp_diff:
            set code to code + 1
            
        # Final code includes sign bit
        set final_code to sign + code
        set ok to append_list(encoded and final_code)
        
        # Predict next sample using the quantized difference
        set diff_q to step / 8
        if (code / 4) modulo 2 == 1:
            set diff_q to diff_q + step
        if (code / 2) modulo 2 == 1:
            set diff_q to diff_q + step / 2
        if (code / 1) modulo 2 == 1:
            set diff_q to diff_q + step / 4
            
        if sign == 8:
            set predicted_sample to predicted_sample - diff_q
        else:
            set predicted_sample to predicted_sample + diff_q
            
        # Clamp predicted sample to 16-bit signed range (-32768 to 32767)
        if predicted_sample > 32767:
            set predicted_sample to 32767
        if predicted_sample < -32768:
            set predicted_sample to -32768
            
        # Adjust step index
        set adjust to get_list(ADPCM_INDEX_ADJUST and code)
        set step_index to step_index + adjust
        if step_index < 0:
            set step_index to 0
        if step_index > 88:
            set step_index to 88
            
        set i to i + 1
        
    return encoded

# IMA-ADPCM Audio Decoder (fallback) / real Opus when libopus is present.
define codec_decode_audio with ctx as Map and encoded_bytes as List returning List:
    set has_opus to map_get_val(ctx and "has_opus")
    set dec to map_get_val(ctx and "opus_dec")
    if has_opus == 1 and also dec != 0:
        return codec_opus_decode(ctx and encoded_bytes)
    set decoded to create_list()
    set num_elements to length_list(encoded_bytes)
    if num_elements < 2:
        return decoded
        
    set predicted_sample to get_list(encoded_bytes and 0)
    set step_index to get_list(encoded_bytes and 1)
    if step_index < 0 or else step_index > 88:
        display "ERROR: malformed ADPCM step index"
        return decoded
    
    set ok to append_list(decoded and predicted_sample)
    
    set i to 2
    repeat while i < num_elements:
        set final_code to get_list(encoded_bytes and i)
        set sign to final_code / 8
        set code to final_code modulo 8
        
        set step to get_list(ADPCM_STEPS and step_index)
        
        # Reconstruct difference
        set diff_q to step / 8
        if (code / 4) modulo 2 == 1:
            set diff_q to diff_q + step
        if (code / 2) modulo 2 == 1:
            set diff_q to diff_q + step / 2
        if (code / 1) modulo 2 == 1:
            set diff_q to diff_q + step / 4
            
        if sign == 1:
            set predicted_sample to predicted_sample - diff_q
        else:
            set predicted_sample to predicted_sample + diff_q
            
        # Clamp sample
        if predicted_sample > 32767:
            set predicted_sample to 32767
        if predicted_sample < -32768:
            set predicted_sample to -32768
            
        set ok to append_list(decoded and predicted_sample)
        
        # Adjust step index
        set adjust to get_list(ADPCM_INDEX_ADJUST and code)
        set step_index to step_index + adjust
        if step_index < 0:
            set step_index to 0
        if step_index > 88:
            set step_index to 88
            
        set i to i + 1
        
    return decoded

# Video Encoder: Run-Length Encoded (RLE) Delta-Compression
# Write a 32-bit little-endian unsigned value into buf[off..off+3].
define codec_poke_u32 with buf as Int and off as Int and val as Int returning Int:
    set ok to poke_byte(buf and off and val modulo 256)
    set ok to poke_byte(buf and off + 1 and (val / 256) modulo 256)
    set ok to poke_byte(buf and off + 2 and (val / 65536) modulo 256)
    set ok to poke_byte(buf and off + 3 and (val / 16777216) modulo 256)
    return 0

define codec_peek_u32 with buf as Int and off as Int returning Int:
    return peek_byte(buf and off) + peek_byte(buf and off + 1) * 256 + peek_byte(buf and off + 2) * 65536 + peek_byte(buf and off + 3) * 16777216

# Read a 64-bit little-endian value (a pointer or size_t) from buf[off..off+7].
# macOS arm64 heap pointers fit in positive 64-bit (top bytes zero).
define codec_peek_u64 with buf as Int and off as Int returning Int:
    set v to 0
    set i to 7
    repeat while i >= 0:
        set v to v * 256 + peek_byte(buf and off + i)
        set i to i - 1
    return v

# Normalize a C `int` returned through the machine-word ep_dlcall ABI.
define codec_c_int with value as Int returning Int:
    if value >= 2147483648 and also value <= 4294967295:
        return value - 4294967296
    return value

# Real VP8 keyframe encode via libvpx. Input raw_frame is I420 bytes:
# Y (width*height) then U then V (each (width/2)*(height/2)). Each frame is encoded as
# a forced keyframe (no inter-frame prediction). This operational mode trades bandwidth
# for independently decodable frames and deterministic recovery. Output: [width, height, size, byte...].
define codec_encode_video with ctx as Map and raw_frame as List and width as Int and height as Int returning List:
    set has_vpx to map_get_val(ctx and "has_vpx")
    set cx_iface to map_get_val(ctx and "vpx_cx_iface")
    if has_vpx == 1 and also cx_iface != 0:
        return codec_vp8_encode(ctx and raw_frame and width and height)
    # RLE fallback (used only when libvpx is unavailable)
    set encoded to create_list()
    set ok to append_list(encoded and width)
    set ok to append_list(encoded and height)
    set num_pixels to length_list(raw_frame)
    if num_pixels == 0:
        return encoded
    set current_pixel to get_list(raw_frame and 0)
    set run_len to 1
    set i to 1
    repeat while i < num_pixels:
        set pixel to get_list(raw_frame and i)
        if pixel == current_pixel:
            set run_len to run_len + 1
        else:
            set ok to append_list(encoded and run_len)
            set ok to append_list(encoded and current_pixel)
            set current_pixel to pixel
            set run_len to 1
        set i to i + 1
    set ok to append_list(encoded and run_len)
    set ok to append_list(encoded and current_pixel)
    return encoded

define codec_vp8_encode with ctx as Map and raw_frame as List and width as Int and height as Int returning List:
    set cx_iface to map_get_val(ctx and "vpx_cx_iface")
    set out to create_list()
    set ok to append_list(out and width)
    set ok to append_list(out and height)
    if width <= 0 or else height <= 0 or else width modulo 2 != 0 or else height modulo 2 != 0:
        display "ERROR: VP8 I420 dimensions must be positive even values"
        set ok to append_list(out and 0)
        return out
    set required_bytes to width * height + (width / 2) * (height / 2) * 2
    if required_bytes <= 0 or else length_list(raw_frame) != required_bytes:
        display "ERROR: VP8 input does not contain exactly one I420 frame"
        set ok to append_list(out and 0)
        return out
    if cx_iface == 0:
        display "ERROR: VP8 encoder interface is unavailable"
        set ok to append_list(out and 0)
        return out

    # configure: enc_config_default then set resolution + a target bitrate
    set cfg to alloc_bytes(504)
    if cfg == 0:
        display "ERROR: VP8 encoder configuration allocation failed"
        set ok to append_list(out and 0)
        return out
    set rc to ep_dlcall3(map_get_val(ctx and "vpx_enc_cfg_default_fn") and cx_iface and cfg and 0)
    if rc != 0:
        display concat("ERROR: VP8 default encoder configuration failed with code " and int_to_string(rc))
        set ok to free_bytes(cfg)
        set ok to append_list(out and 0)
        return out
    set ok to codec_poke_u32(cfg and 12 and width)
    set ok to codec_poke_u32(cfg and 16 and height)
    set ok to codec_poke_u32(cfg and 112 and 256)

    set vctx to alloc_bytes(56)
    if vctx == 0:
        display "ERROR: VP8 encoder context allocation failed"
        set ok to free_bytes(cfg)
        set ok to append_list(out and 0)
        return out
    set ir to ep_dlcall5(map_get_val(ctx and "vpx_enc_init_fn") and vctx and cx_iface and cfg and 0 and 37)
    if ir != 0:
        display concat("ERROR: VP8 encoder initialization failed with code " and int_to_string(ir))
        set ok to free_bytes(cfg)
        set ok to free_bytes(vctx)
        set ok to append_list(out and 0)
        return out

    set img to alloc_bytes(136)
    if img == 0:
        display "ERROR: VP8 image allocation failed"
        set destroy_err to ep_dlcall1(map_get_val(ctx and "vpx_destroy_fn") and vctx)
        if destroy_err != 0:
            display concat("ERROR: VP8 encoder cleanup failed with code " and int_to_string(destroy_err))
        set ok to free_bytes(cfg)
        set ok to free_bytes(vctx)
        set ok to append_list(out and 0)
        return out
    set imgr to ep_dlcall5(map_get_val(ctx and "vpx_img_alloc_fn") and img and 258 and width and height and 1)
    if imgr == 0:
        display "ERROR: libvpx could not allocate the I420 image"
        set destroy_err to ep_dlcall1(map_get_val(ctx and "vpx_destroy_fn") and vctx)
        if destroy_err != 0:
            display concat("ERROR: VP8 encoder cleanup failed with code " and int_to_string(destroy_err))
        set ok to free_bytes(cfg)
        set ok to free_bytes(vctx)
        set ok to free_bytes(img)
        set ok to append_list(out and 0)
        return out
    set y_ptr to codec_peek_u64(img and 48)
    set u_ptr to codec_peek_u64(img and 56)
    set v_ptr to codec_peek_u64(img and 64)
    set y_st to codec_peek_u32(img and 80)
    set u_st to codec_peek_u32(img and 84)
    set v_st to codec_peek_u32(img and 88)

    set cw to width / 2
    set ch to height / 2
    # Y plane
    set r to 0
    repeat while r < height:
        set c to 0
        repeat while c < width:
            set ok to poke_byte(y_ptr and r * y_st + c and get_list(raw_frame and r * width + c))
            set c to c + 1
        set r to r + 1
    set uoff to width * height
    set voff to uoff + cw * ch
    set r to 0
    repeat while r < ch:
        set c to 0
        repeat while c < cw:
            set ok to poke_byte(u_ptr and r * u_st + c and get_list(raw_frame and uoff + r * cw + c))
            set ok to poke_byte(v_ptr and r * v_st + c and get_list(raw_frame and voff + r * cw + c))
            set c to c + 1
        set r to r + 1

    # encode a forced keyframe (flags=VPX_EFLAG_FORCE_KF=1, deadline=VPX_DL_GOOD_QUALITY)
    set er to ep_dlcall6(map_get_val(ctx and "vpx_encode_fn") and vctx and img and 0 and 1 and 1 and 1000000)
    set total_sz to 0
    set frame_bytes to create_list()
    if er == 0:
        set iter to alloc_bytes(8)
        if iter == 0:
            display "ERROR: VP8 packet iterator allocation failed"
            set er to 1
        else:
            set ok to codec_poke_u32(iter and 0 and 0)
            set ok to codec_poke_u32(iter and 4 and 0)
            set looping to 1
            repeat while looping == 1:
                set pkt to ep_dlcall2(map_get_val(ctx and "vpx_get_cx_data_fn") and vctx and iter)
                if pkt == 0:
                    set looping to 0
                else:
                    set kind to codec_peek_u32(pkt and 0)
                    if kind == 0:
                        set buf to codec_peek_u64(pkt and 8)
                        set sz to codec_peek_u64(pkt and 16)
                        if buf == 0 or else sz <= 0:
                            display "ERROR: libvpx returned an invalid encoded packet"
                            set er to 1
                            set looping to 0
                        else:
                            set b to 0
                            repeat while b < sz:
                                set ok to append_list(frame_bytes and peek_byte(buf and b))
                                set b to b + 1
                            set total_sz to total_sz + sz
            set ok to free_bytes(iter)
    else:
        display concat("ERROR: VP8 encoding failed with code " and int_to_string(er))

    set ignored_void_result to ep_dlcall1(map_get_val(ctx and "vpx_img_free_fn") and img)
    set destroy_err to ep_dlcall1(map_get_val(ctx and "vpx_destroy_fn") and vctx)
    set ok to free_bytes(cfg)
    set ok to free_bytes(vctx)
    set ok to free_bytes(img)

    if destroy_err != 0:
        display concat("ERROR: VP8 encoder cleanup failed with code " and int_to_string(destroy_err))
        set er to destroy_err
    if er != 0:
        set total_sz to 0

    set ok to append_list(out and total_sz)
    set bi to 0
    repeat while bi < total_sz:
        set ok to append_list(out and get_list(frame_bytes and bi))
        set bi to bi + 1
    set ok to free_list(frame_bytes)
    return out

# Real VP8 decode via libvpx. Input is [width, height, size, byte...]; output is the
# decoded I420 byte list (Y then U then V). Falls back to RLE when libvpx is absent.
define codec_decode_video with ctx as Map and encoded_frame as List and width as Int and height as Int returning List:
    set has_vpx to map_get_val(ctx and "has_vpx")
    set dx_iface to map_get_val(ctx and "vpx_dx_iface")
    if has_vpx == 1 and also dx_iface != 0:
        return codec_vp8_decode(ctx and encoded_frame)
    set decoded to create_list()
    set num_elements to length_list(encoded_frame)
    if num_elements < 2:
        return decoded
    set i to 2
    repeat while i + 1 < num_elements:
        set run_len to get_list(encoded_frame and i)
        set pixel to get_list(encoded_frame and i + 1)
        if run_len < 0:
            display "ERROR: malformed negative RLE run length"
            set ok to free_list(decoded)
            return create_list()
        set r to 0
        repeat while r < run_len:
            set ok to append_list(decoded and pixel)
            set r to r + 1
        set i to i + 2
    if i != num_elements:
        display "ERROR: truncated RLE video frame"
        set ok to free_list(decoded)
        return create_list()
    return decoded

define codec_vp8_decode with ctx as Map and encoded_frame as List returning List:
    set dx_iface to map_get_val(ctx and "vpx_dx_iface")
    set decoded to create_list()
    set n to length_list(encoded_frame)
    if n < 3:
        return decoded
    set sz to get_list(encoded_frame and 2)
    if sz <= 0 or else sz != n - 3:
        display "ERROR: malformed or truncated VP8 frame length"
        return decoded
    set data_buf to alloc_bytes(sz)
    if data_buf == 0:
        display "ERROR: VP8 input buffer allocation failed"
        return decoded
    set b to 0
    repeat while b < sz:
        set ok to poke_byte(data_buf and b and get_list(encoded_frame and 3 + b))
        set b to b + 1

    set dctx to alloc_bytes(56)
    if dctx == 0:
        display "ERROR: VP8 decoder context allocation failed"
        set ok to free_bytes(data_buf)
        return decoded
    set ir to ep_dlcall5(map_get_val(ctx and "vpx_dec_init_fn") and dctx and dx_iface and 0 and 0 and 12)
    if ir != 0:
        display concat("ERROR: VP8 decoder initialization failed with code " and int_to_string(ir))
        set ok to free_bytes(data_buf)
        set ok to free_bytes(dctx)
        return decoded
    set dr to ep_dlcall5(map_get_val(ctx and "vpx_decode_fn") and dctx and data_buf and sz and 0 and 0)
    if dr == 0:
        set iter to alloc_bytes(8)
        if iter == 0:
            display "ERROR: VP8 decoder iterator allocation failed"
            set dr to 1
        else:
            set ok to codec_poke_u32(iter and 0 and 0)
            set ok to codec_poke_u32(iter and 4 and 0)
            set img to ep_dlcall2(map_get_val(ctx and "vpx_get_frame_fn") and dctx and iter)
            if img == 0:
                display "ERROR: libvpx returned no decoded frame"
                set dr to 1
            else:
                set dw to codec_peek_u32(img and 24)
                set dh to codec_peek_u32(img and 28)
                set y_ptr to codec_peek_u64(img and 48)
                set u_ptr to codec_peek_u64(img and 56)
                set v_ptr to codec_peek_u64(img and 64)
                set y_st to codec_peek_u32(img and 80)
                set u_st to codec_peek_u32(img and 84)
                set v_st to codec_peek_u32(img and 88)
                if dw <= 0 or else dh <= 0 or else dw modulo 2 != 0 or else dh modulo 2 != 0 or else y_ptr == 0 or else u_ptr == 0 or else v_ptr == 0 or else y_st < dw or else u_st < dw / 2 or else v_st < dw / 2:
                    display "ERROR: libvpx returned an invalid I420 frame"
                    set dr to 1
                else:
                    set r to 0
                    repeat while r < dh:
                        set c to 0
                        repeat while c < dw:
                            set ok to append_list(decoded and peek_byte(y_ptr and r * y_st + c))
                            set c to c + 1
                        set r to r + 1
                    set cw to dw / 2
                    set chh to dh / 2
                    set r to 0
                    repeat while r < chh:
                        set c to 0
                        repeat while c < cw:
                            set ok to append_list(decoded and peek_byte(u_ptr and r * u_st + c))
                            set c to c + 1
                        set r to r + 1
                    set r to 0
                    repeat while r < chh:
                        set c to 0
                        repeat while c < cw:
                            set ok to append_list(decoded and peek_byte(v_ptr and r * v_st + c))
                            set c to c + 1
                        set r to r + 1
            set ok to free_bytes(iter)
    else:
        display concat("ERROR: VP8 decoding failed with code " and int_to_string(dr))
    set destroy_err to ep_dlcall1(map_get_val(ctx and "vpx_destroy_fn") and dctx)
    set ok to free_bytes(data_buf)
    set ok to free_bytes(dctx)
    if destroy_err != 0:
        display concat("ERROR: VP8 decoder cleanup failed with code " and int_to_string(destroy_err))
        set dr to destroy_err
    if dr != 0:
        set ok to free_list(decoded)
        return create_list()
    return decoded
