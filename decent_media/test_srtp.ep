# Isolated real-libsrtp2 SRTP round-trip (AES-CM-128 + HMAC-SHA1-80 via srtp_protect/
# srtp_unprotect). Encrypt a 20-byte payload, decrypt it back, and confirm a tampered
# packet fails authentication (valid:0).

import "collections"
import "crypto"
import "webrtc"

define pass_if with label as Str and cond as Int returning Int:
    if cond == 1:
        display concat("PASS: " and label)
        return 1
    display concat("FAIL: " and label)
    return 0

define main:
    set passes to 0
    set keys to create_map()
    set ok to map_insert(keys and "master_key" and ep_sha256("shared-secret-test"))
    set ok to map_insert(keys and "master_salt" and ep_sha256("shared-secret-test-salt"))

    set p to alloc_bytes(20)
    set i to 0
    repeat while i < 20:
        set ok to poke_byte(p and i and (i * 7) modulo 256)
        set i to i + 1

    set enc to webrtc_encrypt_srtp(p and 20 and keys and 100 and 12345)
    display concat("encrypt error=" and int_to_string(map_get_val(enc and "error")))
    set passes to passes + pass_if("srtp_protect_ok" and (map_get_val(enc and "error") == 0))
    # protected packet = 12 hdr + 20 payload + 10 auth tag = 42
    set passes to passes + pass_if("protected_len_42" and (map_get_val(enc and "packet_len") == 42))

    set dec to webrtc_decrypt_srtp(map_get_val(enc and "packet_ptr") and map_get_val(enc and "packet_len") and keys)
    set passes to passes + pass_if("srtp_unprotect_valid" and (map_get_val(dec and "valid") == 1))
    set passes to passes + pass_if("payload_len_20" and (map_get_val(dec and "payload_len") == 20))
    # byte-exact recovery
    set match to 1
    set dp to map_get_val(dec and "payload_ptr")
    set i to 0
    repeat while i < 20:
        if peek_byte(dp and i) != (i * 7) modulo 256:
            set match to 0
        set i to i + 1
    set passes to passes + pass_if("payload_bytes_exact" and match)

    # tamper: flip a payload byte → HMAC auth must reject
    set pkt to map_get_val(enc and "packet_ptr")
    set ok to poke_byte(pkt and 20 and (peek_byte(pkt and 20) + 1) modulo 256)
    set dec2 to webrtc_decrypt_srtp(pkt and map_get_val(enc and "packet_len") and keys)
    set passes to passes + pass_if("tampered_packet_rejected" and (map_get_val(dec2 and "valid") == 0))

    display concat("RESULT: " and concat(int_to_string(passes) and "/6 passed"))
    return 0
