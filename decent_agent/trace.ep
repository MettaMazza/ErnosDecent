# ErnosDecent — Agent Trace Event Emitter
# Component: decent_agent/trace.ep
# Emits ReAct loop trace events (thinking, reasoning, tool calls, results)
# to a SQLite queue. The Discord bridge polls TRACE POLL to stream events
# into a Discord thread in real time. Same architecture as bridge_rpc.ep.
# Status: Production

import "string"
import "collections"
import "sql"
import "datetime"

define trace_sql_escape with s as Str returning Str:
    return string_replace(s and "'" and "''")

define trace_json_escape with s as Str returning Str:
    set out to ""
    set n to string_length(s)
    set i to 0
    repeat while i < n:
        set c to get_character(s and i)
        if c == 92:
            set out to concat(out and "\\\\")
        else:
            if c == 34:
                set out to concat(out and "\\\"")
            else:
                if c == 10:
                    set out to concat(out and "\\n")
                else:
                    if c == 13:
                        set out to concat(out and "\\r")
                    else:
                        if c == 9:
                            set out to concat(out and "\\t")
                        else:
                            set out to concat(out and substring(s and i and 1))
        set i to i + 1
    return out

# ================================================================
# Schema
# ================================================================

define trace_init with db as Int returning Int:
    if db == 0:
        return 1
    set ok to sql_execute(db and "CREATE TABLE IF NOT EXISTS trace_events (id INTEGER PRIMARY KEY AUTOINCREMENT, session_id TEXT NOT NULL, event_type TEXT NOT NULL, content TEXT NOT NULL DEFAULT '', created_at INTEGER NOT NULL DEFAULT 0, sent INTEGER NOT NULL DEFAULT 0);")
    if ok != 0:
        return 1
    # Pending thread deletions — crash-resilient cleanup for Discord threads
    set ok to sql_execute(db and "CREATE TABLE IF NOT EXISTS trace_pending_deletes (id INTEGER PRIMARY KEY AUTOINCREMENT, thread_id TEXT NOT NULL, delete_after INTEGER NOT NULL, created_at INTEGER NOT NULL DEFAULT 0);")
    if ok != 0:
        return 1
    # Interactive trace cancellations from Discord Stop button
    set ok to sql_execute(db and "CREATE TABLE IF NOT EXISTS trace_cancellations (session_id TEXT PRIMARY KEY);")
    if ok != 0:
        return 1
    # Whisper mid-turn user guidance — bridge INSERTs, react loop SELECTs + DELETEs
    set ok to sql_execute(db and "CREATE TABLE IF NOT EXISTS trace_whispers (id INTEGER PRIMARY KEY AUTOINCREMENT, session_id TEXT NOT NULL, content TEXT NOT NULL, created_at INTEGER NOT NULL DEFAULT 0);")
    # Sub-agent approval forwarding — sub-agent INSERTs pending, polls for decision;
    # IPC AI APPROVE handler UPDATEs the decision column. Session_id is the sub-agent's
    # task_id (e.g. "agent_1"). Cleaned up after the sub-agent resumes.
    # MIGRATION: an EARLIER version created this table with only (session_id, decision,
    # created_at). CREATE TABLE IF NOT EXISTS cannot add the tool_name/args_str/summary
    # columns to that stale table, so on those DBs every sub-agent approval INSERT failed
    # SILENTLY (sql_execute swallows the error) — the sub-agent then polled a row that
    # never existed and HUNG for an hour while the operator's approve click updated 0
    # rows (Maria's agent_7 workspace_link hang). This table holds only in-flight
    # requests (none survive a restart), so DROP + recreate at boot is a safe migration.
    set ok to sql_execute(db and "DROP TABLE IF EXISTS trace_approvals;")
    set ok to sql_execute(db and "CREATE TABLE trace_approvals (id INTEGER PRIMARY KEY AUTOINCREMENT, session_id TEXT NOT NULL, tool_name TEXT NOT NULL, args_str TEXT NOT NULL DEFAULT '', summary TEXT NOT NULL DEFAULT '', decision TEXT DEFAULT NULL, created_at INTEGER NOT NULL DEFAULT 0);")
    return 0

# ================================================================
# Emit — called from react_run_loop at each pipeline step
# ================================================================

define trace_emit with db as Int and session_id as Str and event_type as Str and content as Str returning Int:
    if db == 0:
        return 1
    # FULL TRANSPARENCY: store the COMPLETE content — no truncation. Every action result,
    # command output, reasoning trace and raw model output is piped in full into the thinking
    # stream. The surfaces (Discord thread / WebUI) CHUNK long content across messages rather
    # than clipping it, so nothing is hidden. Trace rows are transient (auto-cleaned after the
    # run), so full content does not accumulate.
    set es to trace_sql_escape(session_id)
    set et to trace_sql_escape(event_type)
    set ec to trace_sql_escape(content)
    set now to ep_time_now_sec()
    set q to concat("INSERT INTO trace_events (session_id, event_type, content, created_at, sent) VALUES ('" and es)
    set q to concat(q and concat("', '" and concat(et and concat("', '" and concat(ec and concat("', " and concat(int_to_string(now) and ", 0);")))))))
    set ok to sql_execute(db and q)
    return 0

# ================================================================
# Poll — called by bridge via TRACE POLL IPC verb
# Returns unsent events as JSON array and marks them sent.
# ================================================================

define trace_poll with db as Int and session_id as Str returning Str:
    if db == 0:
        return "[]"
    set es to trace_sql_escape(session_id)
    set rows to sql_query(db and concat("SELECT id, event_type, content, created_at FROM trace_events WHERE sent=0 AND session_id='" and concat(es and "' ORDER BY id LIMIT 50;")))
    set n to length_list(rows)
    set out to "["
    set i to 0
    repeat while i < n:
        set r to get_list(rows and i)
        set id_str to get_list(r and 0)
        if i > 0:
            set out to concat(out and ",")
        set out to concat(out and concat("{\"id\":" and id_str))
        set out to concat(out and concat(",\"type\":\"" and concat(trace_json_escape(get_list(r and 1)) and "\"")))
        set out to concat(out and concat(",\"content\":\"" and concat(trace_json_escape(get_list(r and 2)) and "\"")))
        set out to concat(out and concat(",\"ts\":" and concat(get_list(r and 3) and "}")))
        # Mark as sent
        set ok to sql_execute(db and concat("UPDATE trace_events SET sent=1 WHERE id=" and concat(id_str and ";")))
        set i to i + 1
    set out to concat(out and "]")
    return out

# ================================================================
# Cleanup — delete all trace events for a session after the run
# ================================================================

define trace_cleanup with db as Int and session_id as Str returning Int:
    if db == 0:
        return 1
    set es to trace_sql_escape(session_id)
    set ok to sql_execute(db and concat("DELETE FROM trace_events WHERE session_id='" and concat(es and "';")))
    return 0

# ================================================================
# Pending Thread Deletions — crash-resilient Discord thread cleanup
# ================================================================

define trace_schedule_delete with db as Int and thread_id as Str and delay_secs as Int returning Int:
    if db == 0:
        return 1
    set et to trace_sql_escape(thread_id)
    set now to ep_time_now_sec()
    set delete_after to now + delay_secs
    set q to concat("INSERT INTO trace_pending_deletes (thread_id, delete_after, created_at) VALUES ('" and et)
    set q to concat(q and concat("', " and concat(int_to_string(delete_after) and concat(", " and concat(int_to_string(now) and ");")))))
    set ok to sql_execute(db and q)
    return 0

define trace_get_pending_deletes with db as Int returning Str:
    if db == 0:
        return "[]"
    set now to ep_time_now_sec()
    set rows to sql_query(db and concat("SELECT id, thread_id FROM trace_pending_deletes WHERE delete_after <= " and concat(int_to_string(now) and " ORDER BY id LIMIT 50;")))
    set n to length_list(rows)
    set out to "["
    set i to 0
    repeat while i < n:
        set r to get_list(rows and i)
        set id_str to get_list(r and 0)
        if i > 0:
            set out to concat(out and ",")
        set out to concat(out and concat("{\"id\":" and id_str))
        set out to concat(out and concat(",\"thread_id\":\"" and concat(trace_json_escape(get_list(r and 1)) and "\"}")))
        set i to i + 1
    set out to concat(out and "]")
    return out

define trace_complete_delete with db as Int and id as Int returning Int:
    if db == 0:
        return 1
    set ok to sql_execute(db and concat("DELETE FROM trace_pending_deletes WHERE id=" and concat(int_to_string(id) and ";")))
    return 0
