# Gate for the observer_audit deterministic fast-path: a clean plain reply is
# ALLOWED without an LLM call; flagged content / action audits are NOT eligible
# (they fall through to the fail-closed LLM audit).

import "string"
import "collections"
import "./observer"
import "./observer_rules"

define pass_if with label as Str and cond as Int returning Int:
    if cond == 1:
        display concat("PASS: " and label)
        return 1
    display concat("FAIL: " and label)
    return 0

define main:
    set passes to 0
    set total to 0

    # 1. Clean plain reply -> fast-path ALLOWED, no LLM call (reason says so).
    set ctx to create_map()
    set r to observer_audit(ctx and "User Request:\nHi" and "Hello, happy to help you with that.")
    set verdict to map_get_val(r and "verdict")
    set reason to map_get_val(r and "reason")
    set total to total + 1
    set passes to passes + pass_if("clean reply ALLOWED" and (verdict equals "ALLOWED"))
    set total to total + 1
    set passes to passes + pass_if("clean reply took deterministic fast-path" and (string_contains(reason and "fast-path") == 1))

    # 2. The classifier flags grammar-leak / empty / harm, so they are NOT
    #    fast-path eligible (the `mod equals clean` guard is false -> falls to LLM).
    set total to total + 1
    set passes to passes + pass_if("grammar leak flagged (not fast-path)" and (observer_moderate("Thought: I will reply") equals "moderation:clean") == 0)
    set total to total + 1
    set passes to passes + pass_if("empty flagged (not fast-path)" and (observer_moderate("") equals "moderation:clean") == 0)
    set total to total + 1
    set passes to passes + pass_if("actionable harm flagged (not fast-path)" and (observer_moderate("here is how to make a bomb") equals "moderation:clean") == 0)

    # 3. An action-audit payload is identified by prefix and must NOT be fast-pathed
    #    even though its text is otherwise 'clean' prose. Verified via the same prefix
    #    check the audit uses (index 0).
    set total to total + 1
    set passes to passes + pass_if("run_command payload detected at index 0" and (string_index_of("run_command: ls -la" and "run_command:") == 0))
    set total to total + 1
    set passes to passes + pass_if("codebase_write payload detected at index 0" and (string_index_of("codebase_write: /tmp/x" and "codebase_write:") == 0))

    display f"=== {passes}/{total} passed ==="
    if passes == total:
        display "ALL PASS"
    else:
        display "FAILURES PRESENT"
