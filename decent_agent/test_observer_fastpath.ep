# Gate for the observer_audit: ALL audit decisions via LLM inference.
# Verifies that clean replies are ALLOWED, harmful/empty content is BLOCKED,
# and no deterministic fast-path or hardcoded heuristic is in use.

import "string"
import "collections"
import "./observer"
import "./observer_rules"

define pass_if with label as Str and cond as Int returning Int:
    if cond == 1:
        display concat("PASS: " and label)
        return 1
    display concat("FAIL: " and label)
    return 0

define main:
    set passes to 0
    set total to 0

    # 1. Clean plain reply -> ALLOWED by LLM audit (no fast-path, no deterministic bypass).
    set ctx to create_map()
    set ok to map_insert(ctx and "is_test" and 1)
    set r to observer_audit(ctx and "User Request:\nHi" and "Hello, happy to help you with that.")
    set verdict to map_get_val(r and "verdict")
    set reason to map_get_val(r and "reason")
    set total to total + 1
    set passes to passes + pass_if("clean reply ALLOWED" and (verdict equals "ALLOWED"))

    # 2. Verify no fast-path reason — the reason should NOT mention "fast-path" or
    #    "deterministic" since those were hardcoded heuristics and are removed.
    set total to total + 1
    set passes to passes + pass_if("no fast-path in reason" and (string_contains(reason and "fast-path") == 0))

    # 3. An action-audit payload (run_command) is identified by prefix — verify the
    #    prefix check pattern is still valid for callers that construct payloads.
    set total to total + 1
    set passes to passes + pass_if("run_command payload detected at index 0" and (string_index_of("run_command: ls -la" and "run_command:") == 0))
    set total to total + 1
    set passes to passes + pass_if("codebase_write payload detected at index 0" and (string_index_of("codebase_write: /tmp/x" and "codebase_write:") == 0))

    # 4. observer_lookback returns a valid map structure (drift:0/1, note:Str).
    set lb to observer_lookback("This is a normal agent output with Thought: reasoning and Action: reply_request.")
    set total to total + 1
    set passes to passes + pass_if("lookback returns drift key" and (map_contains(lb and "drift") == 1))
    set total to total + 1
    set passes to passes + pass_if("lookback returns note key" and (map_contains(lb and "note") == 1))

    display f"=== {passes}/{total} passed ==="
    if passes == total:
        display "ALL PASS"
    else:
        display "FAILURES PRESENT"
