# Regression gate for the read_transcripts segfault: reading a session that has
# compressed transcript files must NOT crash (the old code dereferenced a JSON
# type-tag as a node). Also: a missing session is handled gracefully.

import "string"
import "collections"
import "./tools"

define pass_if with label as Str and cond as Int returning Int:
    if cond == 1:
        display concat("PASS: " and label)
        return 1
    display concat("FAIL: " and label)
    return 0

define main:
    set passes to 0
    set total to 0
    set tmgr to create_map()
    set ctx to create_map()
    set ok to map_insert(ctx and "sender_role" and "admin")

    # 1. A real session with compressed_sessions (default.json references several
    #    *_transcript_*.json arrays) — this is the exact path that segfaulted.
    set a1 to create_list()
    set ok to append_list(a1 and "default")
    set r1 to tools_execute(tmgr and ctx and "read_transcripts" and a1)
    set total to total + 1
    set passes to passes + pass_if("read_transcripts(default) returns without crashing" and (string_length(r1) > 0))

    # 2. Missing session -> graceful error, no crash.
    set a2 to create_list()
    set ok to append_list(a2 and "nonexistent_session_xyz")
    set r2 to tools_execute(tmgr and ctx and "read_transcripts" and a2)
    set total to total + 1
    set passes to passes + pass_if("missing session handled gracefully" and (string_contains(r2 and "does not exist") == 1))

    display f"=== {passes}/{total} passed ==="
    if passes == total:
        display "ALL PASS"
    else:
        display "FAILURES PRESENT"
    return 0
