        set si_did to ptr_to_str(map_get_val(si_identity and "did"))
        set si_issue to gitdec_create_issue(si_repo and si_did and si_title and si_body)
        set si_id to map_get_val(si_issue and "id")
        return concat("issue:created,repo:" and concat(si_repo and concat(",id:" and si_id)))

    if action_name equals "reply_request":
        if length_list(args_list) < 1:
