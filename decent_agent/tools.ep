        return get_list(args_list and 0)

    if action_name equals "workspace_write":
        if length_list(args_list) < 2:
            return "Error: workspace_write requires 2 arguments: filename (Str) and content (Str). Example: Action: workspace_write([\"notes.txt\", \"content\"])"
        set ws_filename to get_list(args_list and 0)
        set ws_content to get_list(args_list and 1)
        set ws_path to workspace_write_file(ws_filename and ws_content)
        # Auto-attach the newly written workspace file to the chat.
        set ws_sess to ""
        if map_contains(ctx and "session_id") == 1:
            set ws_sess to map_get_val(ctx and "session_id")
        set ok to tools_emit_attachment(ws_sess and ws_path)
        return concat(ws_path and " (Attached to the chat.)")

    if action_name equals "attach_file":
        if length_list(args_list) < 1:
            return "Error: attach_file requires 1 argument (path). Example: Action: attach_file([\"config/workspaces/active/report.md\"])"
        set af_raw to get_list(args_list and 0)
        set af_path to tools_resolve_attach_path(af_raw)
        if string_length(af_path) == 0:
            return f"Error: attach_file could not find '{af_raw}'. Give a path that exists (project-relative, absolute, or inside the active linked project)."
        if access_path_secret(af_path) == 1:
            return f"Refused: '{af_path}' is a secret/credential path and can never be sent off this machine."
        if file_size(af_path) > 24000000:
            return f"Refused: '{af_path}' exceeds the 24MB attachment limit."
        set af_sess to ""
        if map_contains(ctx and "session_id") == 1:
            set af_sess to map_get_val(ctx and "session_id")
        set ok to tools_emit_attachment(af_sess and af_path)
        return f"Attached '{af_path}' — it will appear as a file in the chat."

    if action_name equals "workspace_read":
        if length_list(args_list) < 1:
            return "Error: workspace_read requires 1 argument (filename). Example: Action: workspace_read([\"uploads/file.md\"])"
        if length_list(args_list) >= 2:
            set ws_sess_id to get_list(args_list and 0)
            set ws_filename to get_list(args_list and 1)
            return workspace_read_prior(ws_sess_id and ws_filename)
        set ws_filename to get_list(args_list and 0)
        return workspace_read_file(ws_filename)

    if action_name equals "workspace_read_range":
        if length_list(args_list) < 3:
            return "Error: workspace_read_range requires 3 arguments: filename (Str), start_line (Int), and end_line (Int). Example: Action: workspace_read_range([\"uploads/file.md\", 1, 500])"
        set ws_filename to get_list(args_list and 0)
        set ws_start_line to tools_safe_int(get_list(args_list and 1))
        set ws_end_line to tools_safe_int(get_list(args_list and 2))
        return workspace_read_range(ws_filename and ws_start_line and ws_end_line)

    if action_name equals "file_info":
        if length_list(args_list) < 1:
            return "Error: file_info requires 1 argument (path). Example: Action: file_info([\"src/main.ep\"]) or file_info([\"uploads/file.md\"])"
        set fi_path to get_list(args_list and 0)
        # Any-path probe (size + line count). Gate outside-project paths when Full-PC is
        # off, same as codebase_read. Falls back to the workspace variant so bare upload
        # filenames still resolve against the active workspace root.
        set fi_gate to access_gate_path(fi_path)
        if map_get_val(fi_gate and "decision") equals "gate":
            return concat("[GATE] " and map_get_val(fi_gate and "reason"))
        set fi_actual to tools_resolve_read_path(fi_path)
        if string_length(fi_actual) > 0:
            return tools_file_info_path(fi_actual and fi_path)
        return workspace_file_info(fi_path)

    if action_name equals "workspace_list":
        return workspace_list_active()

    # ── Project linking (config/linked_projects.txt) ────────────────────────────
    if action_name equals "workspace_link":
        if length_list(args_list) < 1:
            return "Error: workspace_link requires a path. Example: Action: workspace_link([\"/Users/me/Desktop/MyProject\", \"My Project\"])"
        set wl_p to get_list(args_list and 0)
        set wl_lbl to ""
        if length_list(args_list) >= 2:
            set wl_lbl to get_list(args_list and 1)
        set wl_res to links_add(wl_p and wl_lbl)
        if starts_with(wl_res and "ok:") == 1:
            set wl_id to substring(wl_res and 3 and string_length(wl_res) - 3)
            return concat("Linked project '" and concat(wl_id and concat("' -> " and concat(wl_p and ". It is now in-scope; read it with codebase_read/file_info and target it in run_command via its id. Use workspace_set_active to make relative paths resolve against it."))))
        return concat("Error: could not link — " and substring(wl_res and 6 and string_length(wl_res) - 6))

    if action_name equals "workspace_unlink":
        if length_list(args_list) < 1:
            return "Error: workspace_unlink requires a link id. Example: Action: workspace_unlink([\"my_project\"])"
        set wu_id to get_list(args_list and 0)
        if links_remove(wu_id) == 1:
            return concat("Unlinked project '" and concat(wu_id and "'."))
        return concat("Error: no linked project with id '" and concat(wu_id and "'. Use workspace_list_links to see ids."))

    if action_name equals "workspace_set_active":
        if length_list(args_list) < 1:
            return "Error: workspace_set_active requires a link id. Example: Action: workspace_set_active([\"my_project\"])"
        set wsa_id to get_list(args_list and 0)
        if links_set_active(wsa_id) == 1:
            return concat("Active project is now '" and concat(wsa_id and "'. Bare relative paths in codebase_read/file_info now resolve against it."))
        return concat("Error: no linked project with id '" and concat(wsa_id and "'. Use workspace_list_links to see ids."))

    if action_name equals "workspace_list_links":
        return links_list_human()

    if action_name equals "workspace_current":
        set wc_path to links_active_path()
        if string_length(wc_path) == 0:
            return "No active project set. Use workspace_list_links to see linked projects and workspace_set_active([\"<id>\"]) to pick one."
        return concat("Active project path: " and wc_path)

    if action_name equals "changelog":
        if length_list(args_list) >= 2:
            set cl_filter_type to get_list(args_list and 0)
            set cl_filter_val to get_list(args_list and 1)
            if cl_filter_type equals "session":
                return changelog_get_by_session(cl_filter_val)
            if cl_filter_type equals "path":
                return changelog_get_by_path(cl_filter_val)
        if length_list(args_list) >= 1:
            set cl_count to string_to_int(get_list(args_list and 0))
            if cl_count > 0:
                return changelog_get_recent(cl_count)
        return changelog_get_recent(20)

    if action_name equals "rag_retrieve":
        if length_list(args_list) < 1:
            return "Error: rag_retrieve requires 1 argument (query)."
        set rr_query to get_list(args_list and 0)
        set rr_sess to ""
        if map_contains(ctx and "session_id") == 1:
            set rr_sess to map_get_val(ctx and "session_id")
        # Optional 2nd arg = offset for pagination. Response carries total_matches +
        # has_more so the agent knows whether to page again (offset += 10).
        set rr_offset to 0
        if length_list(args_list) >= 2:
            set rr_offset to tools_safe_int(get_list(args_list and 1))
        return rag_search_paged(storage_get_db() and rr_query and rr_sess and 10 and rr_offset)

    # ---- Orchestration tools ----
    if action_name equals "delegate_task":
        if length_list(args_list) < 2:
            return "Error: delegate_task requires 2 arguments: instruction (Str) and role (Str)."
        set dt_instruction to get_list(args_list and 0)
        set dt_role to get_list(args_list and 1)
        set dt_orch to map_get_val(ctx and "orchestrator")
        if dt_orch == 0:
            return "Error: Orchestrator not initialized."
        set dt_model to map_get_val(ctx and "model")
        set dt_memory to map_get_val(ctx and "memory_mgr")
        set dt_tools to map_get_val(ctx and "tools_mgr")
        # ASYNC dispatch: orchestrator_spawn launches the sub-agent on its OWN thread
        # and returns its task id immediately — we do NOT block. The sub-agent runs in
        # the background; when it finishes it drops its result into this session's
        # whisper queue, so the agent is reprompted with it on a later turn. This lets
        # the agent fan out several sub-agents and keep talking to the user meanwhile.
        display concat("[DELEGATE] delegate_task tool ENTER role=" and concat(dt_role and concat(" instruction=" and dt_instruction)))
        set dt_tid to orchestrator_spawn(dt_orch and dt_instruction and dt_role and dt_model and dt_memory and dt_tools and cast_map_to_int(ctx))
        display concat("[DELEGATE] delegate_task: dispatched (async) tid=" and dt_tid)
        return concat("Dispatched sub-agent '" and concat(dt_role and concat("' as background task '" and concat(dt_tid and "'. It is running now; you do NOT need to wait. Finish your turn — tell the user you've dispatched it. Its result will arrive automatically as a mid-turn update later, and you can report it to the user then. Do NOT call delegate_wait."))))

    if action_name equals "delegate_wait":
        if length_list(args_list) < 1:
            return "Error: delegate_wait requires 1 argument: task_id (Str)."
        set dw_task_id to get_list(args_list and 0)
        set dw_orch to map_get_val(ctx and "orchestrator")
        if dw_orch == 0:
            return "Error: Orchestrator not initialized."
        # NON-BLOCKING by design: blocking here would deadlock the serialized run lock
        # (the worker needs the lock this turn holds). Return current status instead;
        # the result is delivered to the user automatically when the sub-agent finishes.
        return concat("Sub-agents run in the background and report automatically when done — do not wait. Current status of '" and concat(dw_task_id and concat("': " and orchestrator_check(dw_orch and dw_task_id))))

    if action_name equals "delegate_check":
        if length_list(args_list) < 1:
            return "Error: delegate_check requires 1 argument: task_id (Str)."
        set dc_task_id to get_list(args_list and 0)
        set dc_orch to map_get_val(ctx and "orchestrator")
        if dc_orch == 0:
            return "Error: Orchestrator not initialized."
        return orchestrator_check(dc_orch and dc_task_id)

    if action_name equals "delegate_cancel":
        if length_list(args_list) < 1:
            return "Error: delegate_cancel requires 1 argument: task_id (Str)."
        set dcn_task_id to get_list(args_list and 0)
        set dcn_orch to map_get_val(ctx and "orchestrator")
        if dcn_orch == 0:
            return "Error: Orchestrator not initialized."
        return orchestrator_cancel(dcn_orch and dcn_task_id)

    if action_name equals "delegate_list":
        set dl_orch to map_get_val(ctx and "orchestrator")
        if dl_orch == 0:
            return "Error: Orchestrator not initialized."
        return orchestrator_list(dl_orch)

    if action_name equals "delegate_swarm":
        if length_list(args_list) < 3:
            return "Error: delegate_swarm requires 3 arguments: instruction (Str), sub_tasks (Str, pipe-separated), join_strategy (Str: 'concat'|'best'|'vote')."
        set ds_instruction to get_list(args_list and 0)
        set ds_sub_tasks to get_list(args_list and 1)
        set ds_strategy to get_list(args_list and 2)
        set ds_orch to map_get_val(ctx and "orchestrator")
        if ds_orch == 0:
            return "Error: Orchestrator not initialized."
        set ds_model to map_get_val(ctx and "model")
        set ds_memory to map_get_val(ctx and "memory_mgr")
        set ds_tools to map_get_val(ctx and "tools_mgr")
        return orchestrator_swarm(ds_orch and ds_instruction and ds_sub_tasks and ds_strategy and ds_model and ds_memory and ds_tools and cast_map_to_int(ctx))

    return f"Error: Unknown tool '{action_name}'."
