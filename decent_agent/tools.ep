    if action_name equals "changelog":
        if length_list(args_list) >= 2:
            set cl_filter_type to get_list(args_list and 0)
            set cl_filter_val to get_list(args_list and 1)
            if cl_filter_type equals "session":
                return changelog_get_by_session(cl_filter_val)
            if cl_filter_type equals "path":
                return changelog_get_by_path(cl_filter_val)
        if length_list(args_list) >= 1:
            set cl_count to string_to_int(get_list(args_list and 0))
            if cl_count > 0:
                return changelog_get_recent(cl_count)
        return changelog_get_recent(20)

    if action_name equals "rag_retrieve":
        if length_list(args_list) < 1:
