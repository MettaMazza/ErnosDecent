import "fs"
import "string"
import "./workspace"

define workspace_lifecycle_pass with label as Str and condition as Int returning Int:
    if condition == 1:
        display concat("PASS: " and label)
        return 1
    display concat("FAIL: " and label)
    return 0

define main returning Int:
    set passed to 0
    set total to 0

    set total to total + 1
    set passed to passed + workspace_lifecycle_pass("safe lifecycle ids are accepted and path syntax is rejected" and workspace_session_id_is_safe("session_1786465912093") == 1 and also workspace_session_id_is_safe("follow-up_1") == 1 and also workspace_session_id_is_safe("../../escape") == 0 and also workspace_session_id_is_safe("") == 0)

    set root to concat("/tmp/ernos_workspace_lifecycle_" and int_to_string(ep_time_now_ms()))
    set made_root to create_directory(root)
    set base to path_join(root and "session_2026-08-11")
    set first to workspace_unique_archive_path(base)
    set made_first to create_directory(first)
    set second to workspace_unique_archive_path(base)
    set made_second to create_directory(second)
    set third to workspace_unique_archive_path(base)
    set total to total + 1
    set passed to passed + workspace_lifecycle_pass("archive collisions use non-destructive deterministic suffixes" and made_root != 0 and also (first equals base) and also made_first != 0 and also (second equals concat(base and "_1")) and also made_second != 0 and also (third equals concat(base and "_2")))

    set removed_second to remove_directory(second)
    set removed_first to remove_directory(first)
    set removed_root to remove_directory(root)
    set total to total + 1
    set passed to passed + workspace_lifecycle_pass("lifecycle test artifacts are removed" and removed_second != 0 and also removed_first != 0 and also removed_root != 0)

    display concat("workspace lifecycle: " and concat(int_to_string(passed) and concat("/" and int_to_string(total))))
    if passed != total:
        return 1
    return 0
