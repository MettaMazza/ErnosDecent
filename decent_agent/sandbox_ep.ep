# sandbox_ep.ep — safe execution of a learner's ErnosPlain snippet.
#
# The Decentralised Education plan's gating, safety-critical component (§3.3). The
# compile steps (ernos transpile + clang) run trusted — they only transform source,
# never execute the learner's logic. The learner's compiled BINARY runs INSIDE an OS
# sandbox: network denied, writes confined to a throwaway scratch dir, a wall-clock
# timeout (perl SIGALRM) and ulimit CPU/file caps. Verified by running to contain
# infinite loops (killed at the limit), network connects (blocked), and writes outside
# the scratch dir (blocked). This must NOT route through the approval-gated run_command
# TOOL — the OS isolation, not a human gate, is what makes auto-running learner code safe.

import "fs"
import "os"
import "datetime"
import "collections"
import "string"

# Strip ANSI escape sequences (ESC [ … final-byte) and stray control characters from
# tool output. The ErnosPlain compiler emits coloured diagnostics; the raw ESC (0x1b)
# bytes are invalid inside a JSON string, which breaks BOTH the run_ep_result frame
# sent to the browser (it hangs on "Running…") AND the JSON sent to the LLM (it errors
# with "invalid character '\x1b'"). Newlines and tabs are kept; other control chars dropped.
define strip_ansi with s as Str returning Str:
    set n to string_length(s)
    set out to create_list()
    set i to 0
    repeat while i < n:
        set ch to get_character(s and i)
        if ch == 27:
            set i to i + 1
            if i < n and also get_character(s and i) == 91:
                set i to i + 1
                set scanning to 1
                repeat while i < n and also scanning == 1:
                    set c2 to get_character(s and i)
                    set i to i + 1
                    if c2 >= 64 and also c2 <= 126:
                        set scanning to 0
        else:
            if ch >= 32 or else ch == 10 or else ch == 9:
                set ok to append_list(out and ch)
            set i to i + 1
    set res to string_from_list(out)
    free_list(out)
    return res

define sandbox_rm_tree with path as Str and depth as Int returning Int:
    if depth > 4:
        return 1
    if file_exists(path) == 0:
        return 0
    if is_directory(path) == 1:
        set entries to list_directory(path)
        set n to length_list(entries)
        set i to 0
        repeat while i < n:
            set remove_error to sandbox_rm_tree(path_join(path and get_list(entries and i)) and depth + 1)
            if remove_error != 0:
                free_list(entries)
                return 1
            set i to i + 1
        free_list(entries)
        set ok to remove_directory(path)
        if ok == 0:
            return 1
        return 0
    set ok to remove_file(path)
    if ok == 0:
        return 1
    return 0

define run_ep_code with code as Str returning Str:
    set ts to ep_time_now_ms()
    set dir to concat("/tmp/eprun_" and int_to_string(ts))
    set mk to create_directory(dir)
    if mk == 0 or else is_directory(dir) == 0:
        return "Error: could not create sandbox directory."

    set wok to write_file(concat(dir and "/prog.ep") and code)
    if wok == 0:
        set cleanup_error to sandbox_rm_tree(dir and 0)
        if cleanup_error != 0:
            return "Error: could not stage ErnosPlain source and could not remove the partial sandbox."
        return "Error: could not stage ErnosPlain source in the sandbox."

    # Seatbelt profile: permit normally but DENY all network and DENY filesystem writes
    # outside the scratch dir. SCRATCH is passed in via `sandbox-exec -D SCRATCH=...`.
    set prof to "(version 1)\n(allow default)\n(deny network*)\n(deny file-write* (subpath \"/\"))\n(allow file-write* (subpath (param \"SCRATCH\")))\n(allow file-write-data (literal \"/dev/null\")(literal \"/dev/stdout\")(literal \"/dev/stderr\")(literal \"/dev/tty\")(literal \"/dev/dtracehelper\"))\n"
    set pok to write_file(concat(dir and "/sb.sb") and prof)
    if pok == 0:
        set cleanup_error to sandbox_rm_tree(dir and 0)
        if cleanup_error != 0:
            return "Error: could not stage the sandbox policy and could not remove the partial sandbox."
        return "Error: could not stage the sandbox policy."

    # 1) ErnosPlain transpile (trusted — produces C, does not run learner logic)
    set ern to run_command(f"cd {dir} && NO_COLOR=1 TERM=dumb $HOME/.local/bin/ernos prog.ep 2>&1; printf '\n__ERNOS_EXIT__:%s' $?")
    if string_contains(ern and "__ERNOS_EXIT__:0") == 0 or else file_exists(concat(dir and "/prog_compiled.c")) == 0:
        set rm1 to sandbox_rm_tree(dir and 0)
        if rm1 != 0:
            return "Error: ErnosPlain compilation failed and sandbox cleanup also failed."
        return concat("Your ErnosPlain code did not compile:\n\n" and strip_ansi(ern))

    # 2) C compile (trusted)
    set cl to run_command(f"cd {dir} && clang prog_compiled.c -O2 -lpthread -lm -o prog 2>&1; printf '\n__ERNOS_EXIT__:%s' $?")
    if string_contains(cl and "__ERNOS_EXIT__:0") == 0 or else file_exists(concat(dir and "/prog")) == 0:
        set rm2 to sandbox_rm_tree(dir and 0)
        if rm2 != 0:
            return "Error: native compilation failed and sandbox cleanup also failed."
        return concat("Your code transpiled but the native compile failed:\n\n" and strip_ansi(cl))

    # 3) Run the learner binary INSIDE the sandbox: no network, writes confined to the
    #    scratch dir, 5s wall-clock timeout, 6s CPU + 50MB file caps. $? is the run's
    #    exit (142=SIGALRM timeout, 152=CPU, 137=killed).
    set runcmd to f"cd {dir} && ( ulimit -t 6 -f 51200 2>/dev/null; perl -e 'alarm 5; exec @ARGV' -- sandbox-exec -D SCRATCH={dir} -f sb.sb ./prog ) 2>&1; echo __EPRC__$?"
    set raw to run_command(runcmd)
    set rm3 to sandbox_rm_tree(dir and 0)
    if rm3 != 0:
        return "Error: learner program finished, but the sandbox directory could not be removed."

    # Strip ANSI/control chars so the output is valid inside JSON (browser + LLM).
    set raw to strip_ansi(raw)
    # Separate program output from the exit-code marker.
    set body to raw
    set rc to "0"
    set midx to string_index_of(raw and "__EPRC__")
    if midx >= 0:
        set body to substring(raw and 0 and midx)
        set rc to substring(raw and midx + 8 and string_length(raw) - midx - 8)

    if string_length(body) > 6000:
        set body to concat(substring(body and 0 and 6000) and "\n...[output truncated]")

    set suffix to ""
    if string_contains(rc and "142") == 1:
        set suffix to "\n\n[Stopped: hit the 5-second time limit — likely an infinite loop.]"
    else if string_contains(rc and "152") == 1:
        set suffix to "\n\n[Stopped: hit the CPU time limit.]"
    else if string_contains(rc and "137") == 1:
        set suffix to "\n\n[Stopped: killed by a resource limit.]"

    return concat("Program output:\n" and concat(body and suffix))
