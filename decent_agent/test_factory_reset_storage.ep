import "fs"
import "os"
import "sql"
import "string"
import "../decent_id/keys"
import "../storage"

define factory_storage_expect with label as Str and condition as Int returning Int:
    if condition == 1:
        display concat("PASS: " and label)
        return 1
    display concat("FAIL: " and label)
    return 0

define main returning Int:
    set passed to 0
    set total to 0
    set fixture to concat("/tmp/ernos_factory_storage_" and int_to_string(ep_time_now_ms()))
    set db to sql_open(fixture)
    if db == 0:
        display "FAIL: fixture database open"
        return 1

    set ok to sql_execute(db and "CREATE TABLE trace_events (id INTEGER PRIMARY KEY AUTOINCREMENT, content TEXT NOT NULL);")
    set ok to sql_execute(db and "INSERT INTO trace_events (content) VALUES ('must be cleared');")
    set ok to sql_execute(db and "CREATE TABLE continuity_memories (id INTEGER PRIMARY KEY AUTOINCREMENT, content TEXT NOT NULL);")
    set ok to sql_execute(db and "INSERT INTO continuity_memories (content) VALUES ('old continuity');")
    set ok to sql_execute(db and "CREATE TABLE image_jobs (id INTEGER PRIMARY KEY AUTOINCREMENT, status TEXT NOT NULL);")
    set ok to sql_execute(db and "INSERT INTO image_jobs (status) VALUES ('done');")
    set ok to sql_execute(db and "CREATE TABLE visual_assets (asset_id INTEGER PRIMARY KEY AUTOINCREMENT, path TEXT NOT NULL);")
    set ok to sql_execute(db and "INSERT INTO visual_assets (path) VALUES ('old.png');")
    set ok to sql_execute(db and "CREATE TABLE artifact_provenance (artifact_id INTEGER PRIMARY KEY AUTOINCREMENT, path TEXT NOT NULL);")
    set ok to sql_execute(db and "INSERT INTO artifact_provenance (path) VALUES ('created.png');")
    set ok to sql_execute(db and "CREATE TABLE rights_changes (change_id TEXT PRIMARY KEY, status TEXT NOT NULL);")
    set ok to sql_execute(db and "INSERT INTO rights_changes VALUES ('protected','applied');")
    set ok to sql_execute(db and "CREATE TABLE research_manifest_files (id INTEGER PRIMARY KEY, content TEXT NOT NULL);")
    set ok to sql_execute(db and "INSERT INTO research_manifest_files VALUES (1,'immutable evidence');")
    set ok to sql_execute(db and "CREATE TRIGGER research_manifest_files_no_delete BEFORE DELETE ON research_manifest_files BEGIN SELECT RAISE(ABORT, 'research manifest rows are immutable'); END;")
    set ok to sql_execute(db and "CREATE TABLE research_synthesis_pages (id INTEGER PRIMARY KEY, content TEXT NOT NULL);")
    set ok to sql_execute(db and "INSERT INTO research_synthesis_pages VALUES (1,'immutable synthesis');")
    set ok to sql_execute(db and "CREATE TRIGGER research_synthesis_pages_no_delete BEFORE DELETE ON research_synthesis_pages BEGIN SELECT RAISE(ABORT, 'research synthesis pages are immutable'); END;")
    set ok to sql_execute(db and "BEGIN IMMEDIATE;")
    set clear_existing to storage_factory_clear_agent_state(db)
    set commit_result to sql_execute(db and "COMMIT;")
    set remaining to sql_query(db and "SELECT COUNT(*) FROM trace_events;")
    set continuity_remaining to sql_query(db and "SELECT COUNT(*) FROM continuity_memories;")
    set visual_remaining to sql_query(db and "SELECT COUNT(*) FROM visual_assets;")
    set artifact_remaining to sql_query(db and "SELECT COUNT(*) FROM artifact_provenance;")
    set protected_remaining to sql_query(db and "SELECT COUNT(*) FROM rights_changes;")
    set research_remaining to sql_query(db and "SELECT (SELECT COUNT(*) FROM research_manifest_files) + (SELECT COUNT(*) FROM research_synthesis_pages);")
    set guard_count to sql_query(db and "SELECT COUNT(*) FROM sqlite_master WHERE type='trigger' AND name IN ('research_manifest_files_no_delete','research_synthesis_pages_no_delete');")
    set ok to sql_execute(db and "INSERT INTO image_jobs (status) VALUES ('running');")
    set fresh_job to sql_query(db and "SELECT id FROM image_jobs LIMIT 1;")
    set table_rows to sql_query(db and "SELECT name FROM sqlite_master WHERE type='table' AND name='adapters';")

    set total to total + 1
    set passed to passed + factory_storage_expect("complete agent-state manifest is cleared transactionally" and clear_existing == 0 and also commit_result == 0 and also length_list(remaining) == 1 and also ptr_to_str(get_list(get_list(remaining and 0) and 0)) equals "0" and also ptr_to_str(get_list(get_list(continuity_remaining and 0) and 0)) equals "0" and also ptr_to_str(get_list(get_list(visual_remaining and 0) and 0)) equals "0" and also ptr_to_str(get_list(get_list(artifact_remaining and 0) and 0)) equals "0")

    set total to total + 1
    set passed to passed + factory_storage_expect("unused lazy subsystems remain absent" and length_list(table_rows) == 0)

    set total to total + 1
    set passed to passed + factory_storage_expect("protected rights records survive factory reset" and ptr_to_str(get_list(get_list(protected_remaining and 0) and 0)) equals "1")

    set total to total + 1
    set passed to passed + factory_storage_expect("agent AUTOINCREMENT counters restart at one" and ptr_to_str(get_list(get_list(fresh_job and 0) and 0)) equals "1")

    set total to total + 1
    set passed to passed + factory_storage_expect("immutable research state clears and its normal delete guards are restored" and ptr_to_str(get_list(get_list(research_remaining and 0) and 0)) equals "0" and also ptr_to_str(get_list(get_list(guard_count and 0) and 0)) equals "2")

    set total to total + 1
    set passed to passed + factory_storage_expect("non-allowlisted table names are rejected" and storage_factory_clear_table_if_present(db and "rights_changes") != 0)

    set close_result to sql_close(db)
    set removed to remove_file(fixture)
    set total to total + 1
    set passed to passed + factory_storage_expect("factory storage test artifacts are removed" and close_result == 0 and also removed != 0)

    display concat("factory reset storage: " and concat(int_to_string(passed) and concat("/" and int_to_string(total))))
    if passed != total:
        return 1
    return 0
