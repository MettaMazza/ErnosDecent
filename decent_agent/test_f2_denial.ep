# F2 gate: denial/approval clarity. A role-gated tool returns an actionable [GATE]
# message (not a flat "Access Denied"), and the always-on denial-handling rule is
# present in the assembled prompt.

import "string"
import "collections"
import "./tools"
import "./prompt"
import "./memory"

define pass_if with label as Str and cond as Int returning Int:
    if cond == 1:
        display concat("PASS: " and label)
        return 1
    display concat("FAIL: " and label)
    return 0

define main:
    set passes to 0
    set total to 0

    # 1. Guest invoking an admin-gated tool -> [GATE], names the role, says ASK.
    set tmgr to create_map()
    set ctx to create_map()
    set ok to map_insert(ctx and "sender_role" and "guest")
    set args to create_list()
    set ok to append_list(args and "ls")
    set res to tools_execute(tmgr and ctx and "run_command" and args)
    display f"  gate result: {res}"
    set total to total + 1
    set passes to passes + pass_if("denial is a [GATE], not flat Access Denied" and (string_index_of(res and "[GATE]") == 0))
    set total to total + 1
    set passes to passes + pass_if("gate names the caller role" and (string_contains(res and "guest") == 1))
    set total to total + 1
    set passes to passes + pass_if("gate tells agent to ASK / authorize" and (string_contains(res and "authorize") == 1))
    set total to total + 1
    set passes to passes + pass_if("gate forbids claiming inability" and (string_contains(res and "NOT a permanent inability") == 1))

    # 2. The assembled prompt carries the always-on denial-handling rule.
    set mem to memory_create()
    set pctx to create_map()
    set ap to prompt_assemble(mem and pctx and "hello" and "")
    set total to total + 1
    set passes to passes + pass_if("prompt has [DENIAL HANDLING] rule" and (string_contains(ap and "[DENIAL HANDLING]") == 1))
    set total to total + 1
    set passes to passes + pass_if("rule covers [GATE]" and (string_contains(ap and "[GATE]") == 1))
    set total to total + 1
    set passes to passes + pass_if("rule covers [USER DECLINED]" and (string_contains(ap and "[USER DECLINED]") == 1))

    display f"=== {passes}/{total} passed ==="
    if passes == total:
        display "ALL PASS"
    else:
        display "FAILURES PRESENT"
    return 0
