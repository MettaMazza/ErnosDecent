# ErnosPlain Rebuild of ErnOS Agent Task Scheduler Tool
# Component: decent_agent/scheduler_tool.ep

import "collections"
import "string"
import "scheduler"

define cast_int_to_str with val as Int returning Str:
    set s to concat("" and ptr_to_str(val))
    return s

# ── autonomy_history backing ────────────────────────────────────────────────
# Read-only view of the agent's autonomous/scheduled jobs and when each last ran.
# Backs onto the same scheduler_load() the scheduler tool uses.

define scheduler_autonomy_history returning Str:
    set jobs_list to scheduler_load()
    set len to length_list(jobs_list)
    if len == 0:
        free_list(jobs_list)
        return "Autonomy history: no scheduled jobs configured."
    set now to ep_time_now_sec()
    set out to "Autonomy / scheduled jobs:\n"
    set i to 0
    repeat while i < len:
        set job to get_list(jobs_list and i)
        set name to cast_int_to_str(map_get_val(job and "name"))
        set stype to cast_int_to_str(map_get_val(job and "schedule_type"))
        set sval to cast_int_to_str(map_get_val(job and "schedule_value"))
        set last_run_s to cast_int_to_str(map_get_val(job and "last_run"))
        set enabled to cast_int_to_str(map_get_val(job and "enabled"))
        set last_run_i to string_to_int(last_run_s)
        set when to "never"
        if last_run_i > 0:
            set ago to now - last_run_i
            set when to concat(int_to_string(ago) and "s ago")
        set state to "disabled"
        if enabled equals "1":
            set state to "enabled"
        set line to concat("- " and name)
        set line to concat(line and concat(" [" and concat(stype and concat(" " and concat(sval and "] ")))))
        set line to concat(line and concat(state and concat(", last run: " and concat(when and "\n"))))
        set out to concat(out and line)
        set i to i + 1
    free_list(jobs_list)
    return out

define operate_scheduler with action_name as Str and args_list as List returning Str:
    set action to string_lower(string_trim(action_name))
    
    if action equals "create":
        if length_list(args_list) < 4:
            return "Error: create action requires name, instruction, schedule_type, and schedule_value."
        
        set name_val to cast_int_to_str(get_list(args_list and 0))
        set inst_val to cast_int_to_str(get_list(args_list and 1))
        set stype_val to cast_int_to_str(get_list(args_list and 2))
        set sval_val to cast_int_to_str(get_list(args_list and 3))
        
        if stype_val equals "once" == 0 and also stype_val equals "interval" == 0 and also stype_val equals "idle" == 0:
            return f"Error: Invalid schedule_type '{stype_val}'. Valid types: once, interval, idle."
            
        set lock_ok to scheduler_store_lock()
        if lock_ok == 0:
            return "Error: scheduler store lock failed."
        set jobs_list to scheduler_load_unlocked()
        
        # Check if name already exists
        set len to length_list(jobs_list)
        set i to 0
        repeat while i < len:
            set job_map to get_list(jobs_list and i)
            set name_check to cast_int_to_str(map_get_val(job_map and "name"))
            if name_check equals name_val:
                free_list(jobs_list)
                set unlock_ok to scheduler_store_unlock()
                if unlock_ok == 0:
                    return "Error: scheduler store unlock failed after duplicate check."
                return f"Error: A scheduled task named '{name_val}' already exists."
            set i to i + 1
            
        set now_epoch to ep_time_now_sec()
        set new_id to concat("job_" and int_to_string(now_epoch))
        
        set new_job to create_map()
        set ok to map_insert(new_job and "id" and new_id)
        set ok to map_insert(new_job and "name" and name_val)
        set ok to map_insert(new_job and "instruction" and inst_val)
        set ok to map_insert(new_job and "schedule_type" and stype_val)
        set ok to map_insert(new_job and "schedule_value" and sval_val)
        set ok to map_insert(new_job and "last_run" and "0")
        set ok to map_insert(new_job and "enabled" and "1")
        
        set ok to append_list(jobs_list and new_job)
        set ok to scheduler_save_unlocked(jobs_list)
        free_list(jobs_list)
        set unlock_ok to scheduler_store_unlock()
        if unlock_ok == 0:
            return f"Error: job '{name_val}' was processed but the scheduler store unlock failed."
        if ok != 0:
            return f"Error: failed to persist job '{name_val}'."
        
        return f"Successfully created job '{name_val}' with ID '{new_id}'."
        
    if action equals "list":
        set jobs_list to scheduler_load()
        set len to length_list(jobs_list)
        if len == 0:
            free_list(jobs_list)
            return "No scheduled tasks registered."
            
        set res to f"Scheduled Tasks ({int_to_string(len)}):\n"
        set i to 0
        repeat while i < len:
            set job_map to get_list(jobs_list and i)
            set id_val to cast_int_to_str(map_get_val(job_map and "id"))
            set name_val to cast_int_to_str(map_get_val(job_map and "name"))
            set stype_val to cast_int_to_str(map_get_val(job_map and "schedule_type"))
            set sval_val to cast_int_to_str(map_get_val(job_map and "schedule_value"))
            set last_val to cast_int_to_str(map_get_val(job_map and "last_run"))
            set en_val to cast_int_to_str(map_get_val(job_map and "enabled"))
            
            set status_str to "enabled"
            if en_val equals "0":
                set status_str to "disabled"
                
            set last_run_str to "never"
            if last_val equals "0" == 0:
                set last_run_str to last_val
                
            set res to concat(res and f"  * [{id_val}] '{name_val}' ({status_str}) | type: {stype_val} | val: {sval_val} | last run: {last_run_str}\n")
            set i to i + 1
            
        free_list(jobs_list)
        return res
        
    if action equals "delete":
        if length_list(args_list) < 1:
            return "Error: delete action requires job_id."
        set target_id to cast_int_to_str(get_list(args_list and 0))
        
        set lock_ok to scheduler_store_lock()
        if lock_ok == 0:
            return "Error: scheduler store lock failed."
        set jobs_list to scheduler_load_unlocked()
        set len to length_list(jobs_list)
        set new_list to create_list()
        set found to 0
        set i to 0
        repeat while i < len:
            set job_map to get_list(jobs_list and i)
            set id_val to cast_int_to_str(map_get_val(job_map and "id"))
            if id_val equals target_id:
                set found to 1
            else:
                set ok to append_list(new_list and job_map)
            set i to i + 1
            
        if found == 1:
            set ok to scheduler_save_unlocked(new_list)
            free_list(jobs_list)
            free_list(new_list)
            set unlock_ok to scheduler_store_unlock()
            if unlock_ok == 0:
                return f"Error: deletion of job '{target_id}' was processed but the scheduler store unlock failed."
            if ok != 0:
                return f"Error: failed to persist deletion of job '{target_id}'."
            return f"Successfully deleted job '{target_id}'."
        else:
            free_list(jobs_list)
            free_list(new_list)
            set unlock_ok to scheduler_store_unlock()
            if unlock_ok == 0:
                return "Error: scheduler store unlock failed after deletion lookup."
            return f"Error: Job ID '{target_id}' not found."
            
    if action equals "toggle":
        if length_list(args_list) < 1:
            return "Error: toggle action requires job_id."
        set target_id to cast_int_to_str(get_list(args_list and 0))
        
        set lock_ok to scheduler_store_lock()
        if lock_ok == 0:
            return "Error: scheduler store lock failed."
        set jobs_list to scheduler_load_unlocked()
        set len to length_list(jobs_list)
        set found to 0
        set i to 0
        repeat while i < len:
            set job_map to get_list(jobs_list and i)
            set id_val to cast_int_to_str(map_get_val(job_map and "id"))
            if id_val equals target_id:
                set found to 1
                set en_val to cast_int_to_str(map_get_val(job_map and "enabled"))
                if en_val equals "1":
                    set ok to map_insert(job_map and "enabled" and "0")
                else:
                    set ok to map_insert(job_map and "enabled" and "1")
            set i to i + 1
            
        if found == 1:
            set ok to scheduler_save_unlocked(jobs_list)
            free_list(jobs_list)
            set unlock_ok to scheduler_store_unlock()
            if unlock_ok == 0:
                return f"Error: toggle of job '{target_id}' was processed but the scheduler store unlock failed."
            if ok != 0:
                return f"Error: failed to persist toggle of job '{target_id}'."
            return f"Successfully toggled job '{target_id}'."
        else:
            free_list(jobs_list)
            set unlock_ok to scheduler_store_unlock()
            if unlock_ok == 0:
                return "Error: scheduler store unlock failed after toggle lookup."
            return f"Error: Job ID '{target_id}' not found."
            
    if action equals "run_now":
        if length_list(args_list) < 1:
            return "Error: run_now action requires job_id."
        set target_id to cast_int_to_str(get_list(args_list and 0))
        
        set jobs_list to scheduler_load()
        set len to length_list(jobs_list)
        set found to 0
        set inst_val to ""
        set i to 0
        repeat while i < len:
            set job_map to get_list(jobs_list and i)
            set id_val to cast_int_to_str(map_get_val(job_map and "id"))
            if id_val equals target_id:
                set found to 1
                set inst_val to cast_int_to_str(map_get_val(job_map and "instruction"))
            set i to i + 1
            
        free_list(jobs_list)
        if found == 1:
            return f"Job '{target_id}' triggered synchronously: {inst_val}"
        else:
            return f"Error: Job ID '{target_id}' not found."
            
    return f"Error: Unknown action '{action_name}'. Valid actions: create, list, delete, toggle, run_now."
