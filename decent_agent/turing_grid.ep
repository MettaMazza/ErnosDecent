# ErnosPlain Rebuild of ErnOS Agent 3D Turing Grid Computations
# Component: decent_agent/turing_grid.ep

import "collections"
import "string"
import "os"

define grid_create:
    set grid to create_map()
    set cells to create_map()
    set ok to map_insert(grid and "cells" and cells)
    set ok to map_insert(grid and "x" and 0)
    set ok to map_insert(grid and "y" and 0)
    set ok to map_insert(grid and "z" and 0)
    
    set values_list to create_list()
    set ok to map_insert(grid and "values_list" and values_list)
    set ok to append_list(values_list and cells)
    return grid

define grid_get_pos_key with grid as Map returning Str:
    set x to map_get_val(grid and "x")
    set y to map_get_val(grid and "y")
    set z to map_get_val(grid and "z")
    return f"{x}_{y}_{z}"

define grid_move with grid as Map and direction as Str returning Int:
    set x to map_get_val(grid and "x")
    set y to map_get_val(grid and "y")
    set z to map_get_val(grid and "z")
    set d to string_upper(string_trim(direction))
    
    if d equals "LEFT":
        set ok to map_insert(grid and "x" and x - 1)
    else if d equals "RIGHT":
        set ok to map_insert(grid and "x" and x + 1)
    else if d equals "IN":
        set ok to map_insert(grid and "y" and y - 1)
    else if d equals "OUT":
        set ok to map_insert(grid and "y" and y + 1)
    else if d equals "DOWN":
        set ok to map_insert(grid and "z" and z - 1)
    else if d equals "UP":
        set ok to map_insert(grid and "z" and z + 1)
        
    return 0

define grid_write with grid as Map and value as Str returning Int:
    set cells to map_get_val(grid and "cells")
    set key to grid_get_pos_key(grid)
    set ok to map_insert(cells and key and value)
    
    set values_list to map_get_val(grid and "values_list")
    set ok to append_list(values_list and key)
    set ok to append_list(values_list and value)
    return 0

define grid_read with grid as Map returning Str:
    set cells to map_get_val(grid and "cells")
    set key to grid_get_pos_key(grid)
    if map_contains(cells and key) == 1:
        return map_get_val(cells and key)
    return ""

define grid_execute_cell with grid as Map returning Str:
    set cmd to grid_read(grid)
    if string_length(cmd) == 0:
        return "Error: Empty cell"
    return run_command(cmd)
