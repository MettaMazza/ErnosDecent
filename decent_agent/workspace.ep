# ErnosPlain Per-Session Workspace Manager
# Component: decent_agent/workspace.ep
# Manages per-session temporary directories under config/workspaces/

import "fs"
import "os"
import "json"
import "collections"
import "string"

# ---- JSON escaping helper (matches session.ep pattern) ----
define workspace_json_escape with s as Str returning Str:
    set len to string_length(s)
    set result_list to create_list()
    set i to 0
    repeat while i < len:
        set ch to get_character(s and i)
        if ch == 34: # "
            set ok to append_list(result_list and 92)
            set ok to append_list(result_list and 34)
        else:
            if ch == 92: # \
                set ok to append_list(result_list and 92)
                set ok to append_list(result_list and 92)
            else:
                if ch == 10: # \n
                    set ok to append_list(result_list and 92)
                    set ok to append_list(result_list and 110)
                else:
                    if ch == 13: # \r
                        set ok to append_list(result_list and 92)
                        set ok to append_list(result_list and 114)
                    else:
                        if ch == 9: # \t
                            set ok to append_list(result_list and 92)
                            set ok to append_list(result_list and 116)
                        else:
                            set ok to append_list(result_list and ch)
        set i to i + 1
    set escaped to string_from_list(result_list)
    free_list(result_list)
    return escaped

# ---- Trim trailing newline from command output ----
define workspace_trim_newline with s as Str returning Str:
    set slen to string_length(s)
    if slen == 0:
        return s
    set last_char to get_character(s and slen - 1)
    if last_char == 10: # newline
        return substring(s and 0 and slen - 1)
    if last_char == 13: # carriage return
        return substring(s and 0 and slen - 1)
    return s

# ================================================================
# workspace_init — Initialize per-session workspace directory
# Archives any existing active session before creating new one
# ================================================================
define workspace_init with session_id as Str returning Int:
    # Check if active workspace exists with a prior session
    set meta_path to path_join("config/workspaces/active" and ".session_meta.json")
    if file_exists(meta_path) == 1:
        # Read old session metadata to get session_id and created_at for archival name
        set old_meta_content to read_file(meta_path)
        set old_root to json_parse(old_meta_content)
        if old_root != 0:
            set old_id_node to get_json_object_value(old_root and "session_id")
            set old_created_node to get_json_object_value(old_root and "created_at")
            set old_session_id to ""
            set old_epoch to 0
            if old_id_node != 0:
                set old_session_id to get_json_value(old_id_node)
            if old_created_node != 0:
                set old_epoch to get_json_value(old_created_node)

            if string_length(old_session_id) > 0:
                # Get date string from epoch for archive directory name
                set date_cmd to f"date -r {old_epoch} +%Y-%m-%d"
                set date_raw to run_command(date_cmd)
                set date_str to workspace_trim_newline(date_raw)

                # Rename active/ to <old_session_id>_<date>/
                set archive_name to concat(old_session_id and concat("_" and date_str))
                set dest_path to path_join("config/workspaces" and archive_name)
                set mv_cmd to f"mv config/workspaces/active {dest_path}"
                set mv_res to run_command(mv_cmd)

    # Create required directory structure
    set ok to create_directory("config/workspaces")
    set ok to create_directory("config/workspaces/active")
    set ok to create_directory("config/workspaces/archive")

    # Get current epoch time
    set now_epoch to ep_time_now_sec()

    # Build session metadata JSON
    set meta_json to "{"
    set meta_json to concat(meta_json and f"\"session_id\": \"{workspace_json_escape(session_id)}\"")
    set meta_json to concat(meta_json and f", \"created_at\": {now_epoch}")
    set meta_json to concat(meta_json and f", \"label\": \"Session {workspace_json_escape(session_id)}\"")
    set meta_json to concat(meta_json and "}")

    # Write session metadata
    set new_meta_path to path_join("config/workspaces/active" and ".session_meta.json")
    set ok to write_file(new_meta_path and meta_json)
    return 0

# ================================================================
# workspace_get_active_path — Returns the active workspace path
# ================================================================
define workspace_get_active_path returning Str:
    return "config/workspaces/active"

# ================================================================
# workspace_get_session_path — Find a prior session's directory
# Scans config/workspaces/ for a directory starting with session_id
# ================================================================
define workspace_get_session_path with session_id as Str returning Str:
    set entries to list_directory("config/workspaces")
    set len to length_list(entries)
    set i to 0
    repeat while i < len:
        set dirname to get_list(entries and i)
        if string_contains(dirname and session_id) == 1:
            # Verify the dirname starts with session_id (check index 0)
            set idx to string_index_of(dirname and session_id)
            if idx == 0:
                set result to path_join("config/workspaces" and dirname)
                free_list(entries)
                return result
        set i to i + 1
    free_list(entries)
    return ""

# ================================================================
# workspace_write_file — Write a file into the active workspace
# ================================================================
define workspace_write_file with filename as Str and content as Str returning Str:
    set full_path to path_join("config/workspaces/active" and filename)
    set ok to write_file(full_path and content)
    return full_path

# ================================================================
# workspace_read_file — Read a file from the active workspace
# ================================================================
define workspace_read_file with filename as Str returning Str:
    set full_path to path_join("config/workspaces/active" and filename)
    if file_exists(full_path) == 0:
        display f"[workspace] Error: file not found: {full_path}"
        return ""
    set content to read_file(full_path)
    return content

# ================================================================
# workspace_read_prior — Read a file from a prior session workspace
# ================================================================
define workspace_read_prior with session_id as Str and filename as Str returning Str:
    set session_path to workspace_get_session_path(session_id)
    if string_length(session_path) == 0:
        display f"[workspace] Error: prior session not found: {session_id}"
        return ""
    set full_path to path_join(session_path and filename)
    if file_exists(full_path) == 0:
        display f"[workspace] Error: file not found in prior session: {full_path}"
        return ""
    set content to read_file(full_path)
    return content

# ================================================================
# workspace_list_active — List files in the active workspace
# Returns newline-separated list of filenames
# ================================================================
define workspace_list_active returning Str:
    set active_path to "config/workspaces/active"
    if file_exists(active_path) == 0:
        return ""
    set entries to list_directory(active_path)
    set len to length_list(entries)
    set result to ""
    set i to 0
    repeat while i < len:
        set entry to get_list(entries and i)
        if string_length(result) > 0:
            set result to concat(result and concat("\n" and entry))
        else:
            set result to entry
        set i to i + 1
    free_list(entries)
    return result

# ================================================================
# workspace_archive_old — Archive old session workspaces past max age
# Scans config/workspaces/ for expired sessions, tars and removes them
# ================================================================
define workspace_archive_old with max_age_days as Int returning Int:
    set now to ep_time_now_sec()
    set max_age_secs to max_age_days * 86400
    set archived_count to 0

    set entries to list_directory("config/workspaces")
    set len to length_list(entries)
    set i to 0
    repeat while i < len:
        set dirname to get_list(entries and i)

        # Skip active and archive directories
        if dirname equals "active":
            set i to i + 1
        else:
            if dirname equals "archive":
                set i to i + 1
            else:
                # Check if this directory has session metadata
                set dir_path to path_join("config/workspaces" and dirname)
                set meta_file to path_join(dir_path and ".session_meta.json")
                if file_exists(meta_file) == 1:
                    set meta_content to read_file(meta_file)
                    set meta_root to json_parse(meta_content)
                    if meta_root != 0:
                        set created_node to get_json_object_value(meta_root and "created_at")
                        if created_node != 0:
                            set created_at to get_json_value(created_node)
                            set age to now - created_at
                            if age > max_age_secs:
                                # Create tar archive
                                set tar_cmd to f"tar -czf config/workspaces/archive/{dirname}.tar.gz -C config/workspaces {dirname}"
                                set tar_res to run_command(tar_cmd)

                                # Remove original directory
                                set rm_cmd to f"rm -rf config/workspaces/{dirname}"
                                set rm_res to run_command(rm_cmd)

                                set archived_count to archived_count + 1
                set i to i + 1
    free_list(entries)
    return archived_count

# ================================================================
# workspace_list_archive — List archived .tar.gz files
# ================================================================
define workspace_list_archive returning Str:
    set archive_path to "config/workspaces/archive"
    if file_exists(archive_path) == 0:
        return ""
    set entries to list_directory(archive_path)
    set len to length_list(entries)
    set result to ""
    set i to 0
    repeat while i < len:
        set entry to get_list(entries and i)
        if string_contains(entry and ".tar.gz") == 1:
            if string_length(result) > 0:
                set result to concat(result and concat("\n" and entry))
            else:
                set result to entry
        set i to i + 1
    free_list(entries)
    return result
