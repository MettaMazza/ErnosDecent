# ErnosPlain Per-Session Workspace Manager
# Component: decent_agent/workspace.ep
# Manages per-session temporary directories under config/workspaces/

import "fs"
import "os"
import "json"
import "collections"
import "string"

# ---- JSON escaping helper (matches session.ep pattern) ----
define workspace_json_escape with s as Str returning Str:
    set len to string_length(s)
    set result_list to create_list()
    set i to 0
    repeat while i < len:
        set ch to get_character(s and i)
        if ch == 34: # "
            set ok to append_list(result_list and 92)
            set ok to append_list(result_list and 34)
        else:
            if ch == 92: # \\
                set ok to append_list(result_list and 92)
                set ok to append_list(result_list and 92)
            else:
                if ch == 10: # \n
                    set ok to append_list(result_list and 92)
                    set ok to append_list(result_list and 110)
                else:
                    if ch == 13: # \r
                        set ok to append_list(result_list and 92)
                        set ok to append_list(result_list and 114)
                    else:
                        if ch == 9: # \t
                            set ok to append_list(result_list and 92)
                            set ok to append_list(result_list and 116)
                        else:
                            set ok to append_list(result_list and ch)
        set i to i + 1
    set escaped to string_from_list(result_list)
    free_list(result_list)
    return escaped

# ---- Trim trailing newline from command output ----
define workspace_trim_newline with s as Str returning Str:
    set slen to string_length(s)
    if slen == 0:
        return s
    set last_char to get_character(s and slen - 1)
    if last_char == 10: # newline
        return substring(s and 0 and slen - 1)
    if last_char == 13: # carriage return
        return substring(s and 0 and slen - 1)
    return s

# ---- Count newlines in a string (returns line count) ----
define workspace_count_lines with content as Str returning Int:
    # O(n) via string_split. The old char-by-char loop used get_character, which is
    # O(n) per call (internal strlen) → O(n²) overall, hanging on large files.
    if string_length(content) == 0:
        return 0
    set parts to string_split(content and "\n")
    set n to length_list(parts)
    free_list(parts)
    return n

define workspace_component_safe with value as Str returning Int:
    set n to string_length(value)
    if n == 0 or else n > 160:
        return 0
    set allowed to "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_-"
    set i to 0
    repeat while i < n:
        if string_index_of(allowed and substring(value and i and 1)) < 0:
            return 0
        set i to i + 1
    return 1

define workspace_rm_tree with path as Str and depth as Int returning Int:
    if depth > 8:
        return 1
    if file_exists(path) == 0:
        return 0
    if is_directory(path) == 1:
        set entries to list_directory(path)
        set n to length_list(entries)
        set i to 0
        repeat while i < n:
            set remove_error to workspace_rm_tree(path_join(path and get_list(entries and i)) and depth + 1)
            if remove_error != 0:
                free_list(entries)
                return 1
            set i to i + 1
        free_list(entries)
        set ok to remove_directory(path)
        if ok == 0:
            return 1
        return 0
    set ok to remove_file(path)
    if ok == 0:
        return 1
    return 0

# ================================================================
# workspace_init — Initialize per-session workspace directory
# Archives any existing active session before creating new one
# ================================================================
define workspace_init with session_id as Str returning Int:
    if workspace_component_safe(session_id) == 0:
        display concat("[-] Unsafe workspace session identifier rejected: " and session_id)
        return 1
    # Check if active workspace exists with a prior session
    set meta_path to path_join("config/workspaces/active" and ".session_meta.json")
    if file_exists(meta_path) == 1:
        # Read old session metadata to get session_id and created_at for archival name
        set old_meta_content to read_file(meta_path)
        set old_root to json_parse(old_meta_content)
        if old_root != 0:
            set old_id_node to get_json_object_value(old_root and "session_id")
            set old_created_node to get_json_object_value(old_root and "created_at")
            set old_session_id to ""
            set old_epoch to 0
            if old_id_node != 0:
                set old_session_id to get_json_value(old_id_node)
            if old_created_node != 0:
                set old_epoch to get_json_value(old_created_node)

            if string_length(old_session_id) > 0:
                if workspace_component_safe(old_session_id) == 0:
                    display "[-] Existing workspace metadata contains an unsafe session identifier."
                    return 1
                # Get date string from epoch for archive directory name
                set date_cmd to f"date -r {old_epoch} +%Y-%m-%d 2>&1; printf '\n__ERNOS_EXIT__:%s' $?"
                set date_raw to run_command(date_cmd)
                set marker_pos to string_index_of(date_raw and "__ERNOS_EXIT__:0")
                set date_str to ""
                if marker_pos >= 0:
                    set date_str to workspace_trim_newline(substring(date_raw and 0 and marker_pos))
                else:
                    display concat("[-] Workspace archive date conversion failed: " and date_raw)
                if string_length(date_str) == 0:
                    set date_str to int_to_string(old_epoch)

                # Rename active/ to <old_session_id>_<date>/
                set archive_name to concat(old_session_id and concat("_" and date_str))
                set dest_path to path_join("config/workspaces" and archive_name)
                # A daemon restart may rotate the same session more than once on the
                # same date. Never let mv interpret an existing destination as a
                # parent directory; choose an unused archive name and use the checked
                # filesystem primitive directly.
                set collision_suffix to ep_time_now_sec()
                set collision_index to 0
                repeat while file_exists(dest_path) == 1:
                    set collision_index to collision_index + 1
                    set unique_suffix to concat(int_to_string(collision_suffix) and concat("_" and int_to_string(collision_index)))
                    set dest_path to path_join("config/workspaces" and concat(archive_name and concat("_" and unique_suffix)))
                set move_ok to fs_move_file("config/workspaces/active" and dest_path)
                if move_ok == 0:
                    display f"[-] Failed to archive active workspace at {dest_path}."
                    return 1

    # Create required directory structure
    if file_exists("config/workspaces") == 0:
        set ok to create_directory("config/workspaces")
        if ok == 0:
            return 1
    if file_exists("config/workspaces/active") == 0:
        set ok to create_directory("config/workspaces/active")
        if ok == 0:
            return 1
    if file_exists("config/workspaces/archive") == 0:
        set ok to create_directory("config/workspaces/archive")
        if ok == 0:
            return 1

    # Get current epoch time
    set now_epoch to ep_time_now_sec()

    # Build session metadata JSON
    set meta_json to "{"
    set meta_json to concat(meta_json and f"\"session_id\": \"{workspace_json_escape(session_id)}\"")
    set meta_json to concat(meta_json and f", \"created_at\": {now_epoch}")
    set meta_json to concat(meta_json and f", \"label\": \"Session {workspace_json_escape(session_id)}\"")
    set meta_json to concat(meta_json and "}")

    # Write session metadata
    set new_meta_path to path_join("config/workspaces/active" and ".session_meta.json")
    set ok to write_file(new_meta_path and meta_json)
    if ok == 0:
        return 1
    return 0

# ================================================================
# workspace_get_active_path — Returns the active workspace path
# ================================================================
define workspace_get_active_path returning Str:
    return "config/workspaces/active"

# ================================================================
# workspace_get_session_path — Find a prior session's directory
# Scans config/workspaces/ for a directory starting with session_id
# ================================================================
define workspace_get_session_path with session_id as Str returning Str:
    if workspace_component_safe(session_id) == 0:
        display concat("[workspace] Unsafe prior-session identifier rejected: " and session_id)
        return ""
    set entries to list_directory("config/workspaces")
    set len to length_list(entries)
    set i to 0
    repeat while i < len:
        set dirname to get_list(entries and i)
        if string_contains(dirname and session_id) == 1:
            # Verify the dirname starts with session_id (check index 0)
            set idx to string_index_of(dirname and session_id)
            if idx == 0:
                set result to path_join("config/workspaces" and dirname)
                free_list(entries)
                return result
        set i to i + 1
    free_list(entries)
    return ""

# ================================================================
# workspace_write_file — Write a file into the active workspace
# ================================================================
define workspace_write_file with filename as Str and content as Str returning Str:
    set full_path to path_join("config/workspaces/active" and filename)
    set ok to write_file(full_path and content)
    if ok == 0:
        display f"[-] Workspace write failed: {full_path}."
        return ""
    return full_path

# ---- Recursive helper to list all workspace files with metadata ----
# Returns formatted entries: "filename  (N lines, M bytes)" for files,
# "dirname/  (dir, K items)" for directories. Respects max_depth.
define workspace_list_recursive with dir_path as Str and relative_prefix as Str and depth as Int and max_depth as Int returning Str:
    set entries to list_directory(dir_path)
    set len to length_list(entries)
    set result to ""
    set i to 0
    repeat while i < len:
        set entry to get_list(entries and i)
        set first_char to get_character(entry and 0)
        # Skip hidden files/directories starting with '.' (char 46)
        if first_char != 46:
            set full_entry_path to path_join(dir_path and entry)
            set rel_entry_path to entry
            if string_length(relative_prefix) > 0:
                set rel_entry_path to path_join(relative_prefix and entry)

            if is_directory(full_entry_path) == 1:
                # Count items in this directory
                set sub_entries to list_directory(full_entry_path)
                set sub_count to length_list(sub_entries)
                free_list(sub_entries)

                set dir_label to concat(rel_entry_path and concat("/  (dir, " and concat(int_to_string(sub_count) and " items)")))
                if string_length(result) > 0:
                    set result to concat(result and concat("\n" and dir_label))
                else:
                    set result to dir_label

                # Recurse if within depth limit
                if depth < max_depth:
                    set sub_list to workspace_list_recursive(full_entry_path and rel_entry_path and depth + 1 and max_depth)
                    if string_length(sub_list) > 0:
                        set result to concat(result and concat("\n" and sub_list))
            else:
                # File: read it to get size and line count
                set file_content to read_file(full_entry_path)
                set file_size to string_length(file_content)
                set file_lines to workspace_count_lines(file_content)
                set file_label to concat(rel_entry_path and concat("  (" and concat(int_to_string(file_lines) and concat(" lines, " and concat(int_to_string(file_size) and " bytes)")))))
                if string_length(result) > 0:
                    set result to concat(result and concat("\n" and file_label))
                else:
                    set result to file_label

        # Check if output is getting too large (8000 char cap)
        if string_length(result) > 8000:
            set result to concat(result and "\n[Listing truncated — use workspace_list([\"subdir\"]) to explore deeper]")
            free_list(entries)
            return result

        set i to i + 1
    free_list(entries)
    return result

# ================================================================
# workspace_read_file — Read a file from the active workspace
# Prepends metadata header and appends continuation hint for large files
# ================================================================
define workspace_read_file with filename as Str returning Str:
    set rpath to path_join("config/workspaces/active" and filename)
    if file_exists(rpath) == 0:
        # Check fallback inside uploads/ folder
        set fallback_path to path_join("config/workspaces/active/uploads" and filename)
        if file_exists(fallback_path) == 1:
            set rpath to fallback_path
        else:
            display f"[workspace] Error: file not found: {rpath}"
            return ""
    set content to read_file(rpath)
    set total_lines to workspace_count_lines(content)
    set total_size to string_length(content)
    set header to concat("[File: " and concat(filename and concat(" | Lines: " and concat(int_to_string(total_lines) and concat(" | Size: " and concat(int_to_string(total_size) and " bytes]\n"))))))
    set output to concat(header and content)
    if total_lines > 500:
        set hint to concat("\n[File has " and concat(int_to_string(total_lines) and " lines total — if you need more, use workspace_read_range]"))
        set output to concat(output and hint)
    return output

# ================================================================
# workspace_file_info — Get size and line count of a workspace file
# ================================================================
define workspace_file_info with filename as Str returning Str:
    set full_path to path_join("config/workspaces/active" and filename)
    if file_exists(full_path) == 0:
        set fallback_path to path_join("config/workspaces/active/uploads" and filename)
        if file_exists(fallback_path) == 1:
            set full_path to fallback_path
        else:
            return f"Error: file not found: {filename}"
            
    set content to read_file(full_path)
    set size to string_length(content)
    
    set lines to 0
    set len to string_length(content)
    if len > 0:
        set lines to 1
        set i to 0
        repeat while i < len:
            set ch to get_character(content and i)
            if ch == 10: # \n
                set lines to lines + 1
            set i to i + 1
            
    set out_json to "{\"filename\":\""
    set out_json to concat(out_json and filename)
    set out_json to concat(out_json and "\",\"size\":")
    set out_json to concat(out_json and int_to_string(size))
    set out_json to concat(out_json and ",\"lines\":")
    set out_json to concat(out_json and int_to_string(lines))
    set out_json to concat(out_json and "}")
    return out_json

# ================================================================
# workspace_read_range — Read a specific line range from a workspace file
# Prepends range header with total line count and appends continuation hint
# Note: get_character is O(n) per call due to internal strlen. For files under
# 100KB this is tolerable. A C-level patch replaces this with pointer indexing.
# ================================================================
define workspace_read_range with filename as Str and start_line as Int and end_line as Int returning Str:
    set full_path to path_join("config/workspaces/active" and filename)
    if file_exists(full_path) == 0:
        set fallback_path to path_join("config/workspaces/active/uploads" and filename)
        if file_exists(fallback_path) == 1:
            set full_path to fallback_path
        else:
            return f"Error: file not found: {filename}"
            
    set content to read_file(full_path)
    if string_length(content) == 0:
        return ""

    # O(n) line slice via string_split. The previous version scanned char-by-char
    # with get_character (O(n²) — hung large files) AND broke the loop as soon as it
    # reached end_line, so total_lines was wrong (it reported end_line+1, not the real
    # total) — which made the continuation hints and "of N total" lie and the agent
    # stop early. Splitting gives the correct total and a clean range every time.
    set lines to string_split(content and "\n")
    set total_lines to length_list(lines)

    set s to start_line
    if s < 1:
        set s to 1
    set e to end_line
    if e > total_lines:
        set e to total_lines
    if s > total_lines:
        free_list(lines)
        return f"[Lines {start_line}-{end_line} of {total_lines} total | File: {filename}]\n(Requested range is beyond end of file)"

    set body to ""
    set i to s
    repeat while i <= e:
        set body to concat(body and concat(get_list(lines and i - 1) and "\n"))
        set i to i + 1
    free_list(lines)

    set header to f"[Lines {s}-{e} of {total_lines} total | File: {filename}]\n"
    set output to concat(header and body)

    # Append continuation hint if there are more lines (now with the CORRECT total).
    if e < total_lines:
        set next_start to e + 1
        set next_end to next_start + 499
        if next_end > total_lines:
            set next_end to total_lines
        set hint to f"\n[Use workspace_read_range([\"{filename}\", {next_start}, {next_end}]) to continue until line {total_lines}]"
        set output to concat(output and hint)
    return output

# ================================================================
# workspace_read_prior — Read a file from a prior session workspace
# ================================================================
define workspace_read_prior with session_id as Str and filename as Str returning Str:
    set session_path to workspace_get_session_path(session_id)
    if string_length(session_path) == 0:
        display f"[workspace] Error: prior session not found: {session_id}"
        return ""
    set full_path to path_join(session_path and filename)
    if file_exists(full_path) == 0:
        # Check fallback inside uploads/ folder
        set fallback_path to path_join(path_join(session_path and "uploads") and filename)
        if file_exists(fallback_path) == 1:
            set content to read_file(fallback_path)
            return content
        display f"[workspace] Error: file not found in prior session: {full_path}"
        return ""
    set content to read_file(full_path)
    return content

# ================================================================
# workspace_list_active — List files in the active workspace
# Returns formatted list with file metadata, depth-limited to 3 levels
# ================================================================
define workspace_list_active returning Str:
    set active_path to "config/workspaces/active"
    if file_exists(active_path) == 0:
        return ""
    return workspace_list_recursive(active_path and "" and 0 and 3)

# ================================================================
# workspace_archive_old — Archive old session workspaces past max age
# Scans config/workspaces/ for expired sessions, tars and removes them
# ================================================================
define workspace_archive_old with max_age_days as Int returning Int:
    set now to ep_time_now_sec()
    set max_age_secs to max_age_days * 86400
    set archived_count to 0

    set entries to list_directory("config/workspaces")
    set len to length_list(entries)
    set i to 0
    repeat while i < len:
        set dirname to get_list(entries and i)

        # Skip active and archive directories
        if dirname equals "active":
            set i to i + 1
        else:
            if dirname equals "archive":
                set i to i + 1
            else:
                # Check if this directory has session metadata
                set dir_path to path_join("config/workspaces" and dirname)
                set meta_file to path_join(dir_path and ".session_meta.json")
                if file_exists(meta_file) == 1:
                    set meta_content to read_file(meta_file)
                    set meta_root to json_parse(meta_content)
                    if meta_root != 0:
                        set created_node to get_json_object_value(meta_root and "created_at")
                        if created_node != 0:
                            set created_at to get_json_value(created_node)
                            set age to now - created_at
                            if age > max_age_secs:
                                if workspace_component_safe(dirname) == 0:
                                    display concat("[-] Unsafe workspace archive name rejected: " and dirname)
                                    free_list(entries)
                                    return -1
                                # Create tar archive
                                set tar_cmd to f"tar -czf config/workspaces/archive/{dirname}.tar.gz -C config/workspaces {dirname} 2>&1; printf '\n__ERNOS_EXIT__:%s' $?"
                                set tar_res to run_command(tar_cmd)
                                if string_contains(tar_res and "__ERNOS_EXIT__:0") == 0:
                                    display concat("[-] Workspace archive creation failed: " and tar_res)
                                    free_list(entries)
                                    return -1
                                # Remove the original only after the archive exists.
                                set rm_res to workspace_rm_tree(dir_path and 0)
                                if rm_res != 0:
                                    display concat("[-] Archived workspace but could not remove original: " and dirname)
                                    free_list(entries)
                                    return -1
                                set archived_count to archived_count + 1
                set i to i + 1
    free_list(entries)
    return archived_count

# ================================================================
# workspace_list_archive — List archived .tar.gz files
# ================================================================
define workspace_list_archive returning Str:
    set archive_path to "config/workspaces/archive"
    if file_exists(archive_path) == 0:
        return ""
    set entries to list_directory(archive_path)
    set len to length_list(entries)
    set result to ""
    set i to 0
    repeat while i < len:
        set entry to get_list(entries and i)
        if string_contains(entry and ".tar.gz") == 1:
            if string_length(result) > 0:
                set result to concat(result and concat("\n" and entry))
            else:
                set result to entry
        set i to i + 1
    free_list(entries)
    return result
