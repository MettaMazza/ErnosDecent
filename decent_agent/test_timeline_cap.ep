# Gate for the timeline ring-buffer + per-entry cap in memory_store (tier 3).

import "string"
import "collections"
import "./memory"

define pass_if with label as Str and cond as Int returning Int:
    if cond == 1:
        display concat("PASS: " and label)
        return 1
    display concat("FAIL: " and label)
    return 0

define big with n as Int returning Str:
    set s to "X"
    repeat while string_length(s) < n:
        set s to concat(s and s)
    return s

define main returning Int:
    set passes to 0
    set total to 0
    set mem to memory_create()

    # 1. Store 500 entries; timeline must cap at 200.
    set i to 0
    repeat while i < 500:
        set ok to memory_store(mem and 3 and "evt" and concat("entry-" and int_to_string(i)))
        set i to i + 1
    set tl to map_get_val(mem and "timeline")
    set tlen to length_list(tl)
    display f"  timeline length after 500 stores = {tlen}"
    set total to total + 1
    set passes to passes + pass_if("timeline capped at 200" and (tlen <= 200))

    # 2. Oldest trimmed, newest kept (ring buffer).
    set last to get_list(tl and tlen - 1)
    set total to total + 1
    set passes to passes + pass_if("newest entry retained" and (string_contains(last and "entry-499") == 1))

    # 3. Per-entry cap: a 100KB value is truncated.
    set ok to memory_store(mem and 3 and "huge" and big(100000))
    set tl2 to map_get_val(mem and "timeline")
    set newest to get_list(tl2 and (length_list(tl2) - 1))
    display f"  huge entry stored length = {string_length(newest)}"
    set total to total + 1
    set passes to passes + pass_if("huge entry truncated (<= ~8300)" and (string_length(newest) < 8300))
    set total to total + 1
    set passes to passes + pass_if("truncation marker present" and (string_contains(newest and "[truncated]") == 1))

    display f"=== {passes}/{total} passed ==="
    if passes == total:
        display "ALL PASS"
    else:
        display "FAILURES PRESENT"
