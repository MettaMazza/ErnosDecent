# Focused safe workspace archival tests. All paths are isolated under scratch/.

import "fs"
import "os"
import "string"
import "./workspace"

define workspace_archive_pass with label as Str and condition as Int returning Int:
    if condition == 1:
        display concat("PASS: " and label)
        return 1
    display concat("FAIL: " and label)
    return 0

define workspace_test_remove_tree with path as Str returning Int:
    if file_exists(path) == 0:
        return 1
    if is_directory(path) == 0:
        return remove_file(path)
    set entries to list_directory(path)
    set count to length_list(entries)
    set i to 0
    repeat while i < count:
        set child_ok to workspace_test_remove_tree(path_join(path and get_list(entries and i)))
        set i to i + 1
    free_list(entries)
    return remove_directory(path)

define workspace_test_session with root as Str and name as Str and created_at as Int and payload as Str returning Int:
    return workspace_test_session_named(root and name and name and created_at and payload)

define workspace_test_session_named with root as Str and dirname as Str and session_id as Str and created_at as Int and payload as Str returning Int:
    set session_path to path_join(root and dirname)
    if create_directory(session_path) == 0:
        return 0
    set meta_path to path_join(session_path and ".session_meta.json")
    set meta to concat("{\"session_id\":\"" and concat(session_id and concat("\",\"created_at\":" and concat(int_to_string(created_at) and "}"))))
    if write_file(meta_path and meta) == 0:
        return 0
    return write_file(path_join(session_path and "payload.txt") and payload)

define main returning Int:
    set passed to 0
    set total to 0
    set root to concat("/tmp/ernos_workspace_archive_" and concat(int_to_string(ep_time_now_ms()) and concat("_" and int_to_string(ep_random_int(100000 and 999999)))))
    set made_root to create_directory(root)
    set archive_root to path_join(root and "archive")
    set made_archive to create_directory(archive_root)
    set made_active to create_directory(path_join(root and "active"))
    set total to total + 1
    set passed to passed + workspace_archive_pass("isolated workspace archive fixture is created" and made_root != 0 and also made_archive != 0 and also made_active != 0)

    set old_made to workspace_test_session(root and "expired_session" and 100000 and "preserved payload")
    set archived to workspace_archive_old_in_root(root and 1 and 200000)
    set archived_path to path_join(archive_root and "expired_session")
    set total to total + 1
    set passed to passed + workspace_archive_pass("expired workspace is atomically moved" and old_made == 1 and also archived == 1 and also file_exists(path_join(root and "expired_session")) == 0 and also is_directory(archived_path) == 1)
    set total to total + 1
    set passed to passed + workspace_archive_pass("archival preserves workspace bytes" and (read_file(path_join(archived_path and "payload.txt")) equals "preserved payload"))

    set recent_made to workspace_test_session(root and "recent_session" and 199999 and "recent")
    set recent_count to workspace_archive_old_in_root(root and 1 and 200000)
    set total to total + 1
    set passed to passed + workspace_archive_pass("recent workspace remains active" and recent_made == 1 and also recent_count == 0 and also is_directory(path_join(root and "recent_session")) == 1)

    set legacy_name to "legacy\nentry"
    set legacy_made to workspace_test_session_named(root and legacy_name and "legacy" and 100000 and "legacy payload")
    set legacy_count to workspace_archive_old_in_root(root and 1 and 200000)
    set total to total + 1
    set passed to passed + workspace_archive_pass("legacy command-tainted directory names remain confined and are safely migrated" and legacy_made == 1 and also legacy_count == 1 and also file_exists(path_join(root and legacy_name)) == 0 and also is_directory(path_join(archive_root and legacy_name)) == 1)

    set collision_made to workspace_test_session(root and "collision_session" and 100000 and "source remains")
    set collision_dest to path_join(archive_root and "collision_session")
    set collision_dest_made to create_directory(collision_dest)
    set collision_marker to write_file(path_join(collision_dest and "existing.txt") and "existing archive")
    set collision_result to workspace_archive_old_in_root(root and 1 and 200000)
    set total to total + 1
    set passed to passed + workspace_archive_pass("archive collision fails without replacing either copy" and collision_made == 1 and also collision_dest_made == 1 and also collision_result == 0 - 1 and also is_directory(path_join(root and "collision_session")) == 1 and also (read_file(path_join(collision_dest and "existing.txt")) equals "existing archive"))

    set collision_cleanup to workspace_test_remove_tree(path_join(root and "collision_session"))
    set collision_dest_cleanup to workspace_test_remove_tree(collision_dest)
    set malformed_path to path_join(root and "malformed_session")
    set malformed_made to create_directory(malformed_path)
    set malformed_written to write_file(path_join(malformed_path and ".session_meta.json") and "not json")
    set malformed_result to workspace_archive_old_in_root(root and 1 and 200000)
    set total to total + 1
    set passed to passed + workspace_archive_pass("malformed metadata fails closed and preserves source" and malformed_made == 1 and also malformed_written == 1 and also malformed_result == 0 - 1 and also is_directory(malformed_path) == 1)

    set total to total + 1
    set passed to passed + workspace_archive_pass("negative retention age is rejected" and workspace_archive_old_in_root(root and 0 - 1 and 200000) == 0 - 1)
    set total to total + 1
    set passed to passed + workspace_archive_pass("missing workspace root is reported as failure" and workspace_archive_old_in_root(path_join(root and "missing") and 1 and 200000) == 0 - 1)

    set cleanup_after to workspace_test_remove_tree(root)
    set total to total + 1
    set passed to passed + workspace_archive_pass("test artifacts are removed" and cleanup_after == 1 and also file_exists(root) == 0)

    display concat("workspace archive: " and concat(int_to_string(passed) and concat("/" and int_to_string(total))))
    if passed != total:
        return 1
    return 0
