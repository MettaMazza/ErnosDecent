    set pub_key to map_get_val(keys_pair and "public_key")
    set sec_key to map_get_val(keys_pair and "secret_key")
    set did_val to create_did_key_from_ed25519(pub_key)
    
    set repo_id to "repo_test_123"
    set repo to gitdec_create_repo(repo_id and "TestRepo" and did_val)
    if repo != 0:
        display "  Repository created successfully"
    else:
        display "  FAIL: Repository creation failed"
        set t13_ok to 0

    # Generate collab keys to resolve a real DID
