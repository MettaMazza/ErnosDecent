    set ok to memory_store(mem and 2 and "key_lesson" and "val_lesson")
    set ok to memory_store(mem and 3 and "key_time" and "val_time")

    set ser_err to memory_serialize(mem and test_path)
    if ser_err == 0:
        display "  Serialized memory state to JSON successfully"
    else:
