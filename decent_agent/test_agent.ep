# ErnosPlain Rebuild of ErnOS Agent Unit Test Suite
# Component: decent_agent/test_agent.ep
# Tests: Hebbian learning, ReAct parser, 3D Turing grid, Observer audit, E2E simulation
# Status: Development

import "collections"
import "string"
import "fs"
import "os"
import "json"

# Subsystems
import "prompt"
import "tools"
import "memory"
import "turing_grid"
import "react_loop"
import "observer"
import "session"

import "../decent_id/did"
import "../decent_money/ledger"
import "learning"
import "sleep"
import "./sync"
import "synaptic_tool"
import "scheduler"
import "scheduler_tool"
import "../logging"
import "../decent_net/gitdec"

external define ep_run_command_bounded with cmd as Str and timeout_ms as Int and start_epoch as Int returning Str
external define ep_cancel_epoch_get with dummy as Int returning Int
external define ep_cancel_epoch_bump with dummy as Int returning Int
external define ep_time_now_ms returning Int

define bounded_command_cancel_worker with done_ch and start_epoch as Int:
    set result to ep_run_command_bounded("sleep 30" and 30000 and start_epoch)
    send result to done_ch
    return 0

define main:
    display "==================================================="
    display "  ErnOS Agent Rebuild -- Unit Test Suite"
    display "==================================================="
    display ""

    set tests_passed to 0
    set tests_failed to 0

    # ===========================================================
    # TEST 1: Hebbian Memory Tier 4 edge weight logic
    # ===========================================================
    display "TEST 1: Hebbian edge creation and weight consolidation"
    set t1_ok to 1
    
    set mem to memory_create()
    
    # Co-activate "wallet" and "ledger"
    set ok to memory_strengthen_synapse(mem and "wallet" and "ledger")
    set edges to map_get_val(mem and "edges")
    
    if map_contains(edges and "ledger-wallet") == 1 or else map_contains(edges and "wallet-ledger") == 1:
        set key to "ledger-wallet"
        if map_contains(edges and "wallet-ledger") == 1:
            set key to "wallet-ledger"
            
        set w1 to map_get_val(edges and key)
        # First co-activation weight should be 100,000 (0.1 in scale 1,000,000)
        if w1 == 100000:
            display "  Synapse edge created with correct initial weight: 0.100"
        else:
            display f"  FAIL: Expected edge weight 100000, got {w1}"
            set t1_ok to 0
            
        # Co-activate again: w_new = w_old + 0.1 * (1.0 - w_old)
        # w_new = 100,000 + 0.1 * (1,000,000 - 100,000) = 100,000 + 90,000 = 190,000 (0.19)
        set ok to memory_strengthen_synapse(mem and "wallet" and "ledger")
        set w2 to map_get_val(edges and key)
        if w2 == 190000:
            display "  Hebbian Edge reinforcement formula verified correctly: 0.190"
        else:
            display f"  FAIL: Expected reinforced edge weight 190000, got {w2}"
            set t1_ok to 0
            
        # Decay: w_new = w_old * 0.95
        # w_decay = 190,000 * 0.95 = 180,500
        set ok to memory_decay_synapses(mem)
        set edges_decayed to map_get_val(mem and "edges")
        set w_decay to map_get_val(edges_decayed and key)
        if w_decay == 180500:
            display "  Synaptic decay consolidated correctly: 0.180"
        else:
            display f"  FAIL: Expected decayed weight 180500, got {w_decay}"
            set t1_ok to 0
    else:
        display "  FAIL: Synaptic graph edge not found"
        set t1_ok to 0

    if t1_ok == 1:
        display "  PASS"
        set tests_passed to tests_passed + 1
    else:
        set tests_failed to tests_failed + 1

    # ===========================================================
    # TEST 2: ReAct thought and action parser
    # ===========================================================
    display "TEST 2: ReAct tool execution parser"
    set t2_ok to 1
    
    set action_str to "Thought: I need to fetch the DHT value.\nAction: dht_get([\"key123\"])"
    set action_map to react_parse_action(action_str)
    
    set found to map_get_val(action_map and "found")
    if found == 1:
        set t_name to map_get_val(action_map and "tool_name")
        set a_str to map_get_val(action_map and "args_str")
        
        if t_name equals "dht_get":
            display f"  Action parser extracted tool name: {t_name}"
        else:
            display f"  FAIL: Expected tool 'dht_get', got '{t_name}'"
            set t2_ok to 0
            
        if a_str equals "[\"key123\"]":
            display f"  Action parser extracted args string: {a_str}"
        else:
            display f"  FAIL: Expected args '[\"key123\"]', got '{a_str}'"
            set t2_ok to 0
    else:
        display "  FAIL: ReAct parser did not detect action block"
        set t2_ok to 0

    set envelope_map to react_parse_action_envelope("{\"tool_name\":\"codebase_read\",\"arguments\":[\"decent_agent/react_loop.ep\",1,500]}")
    set envelope_extra to react_parse_action_envelope("{\"tool_name\":\"codebase_read\",\"arguments\":[],\"prose\":\"not allowed\"}")
    set envelope_prose to react_parse_action_envelope("I will read it. {\"tool_name\":\"codebase_read\",\"arguments\":[]}")
    set envelope_named to react_parse_action_envelope("{\"tool_name\":\"codebase_read_range\",\"arguments\":[{\"path\":\"decent_agent/tools.ep\",\"start_line\":1,\"end_line\":5}]}")
    set envelope_nested_positional to react_parse_action_envelope("{\"tool_name\":\"codebase_read_range\",\"arguments\":[[\"decent_agent/tools.ep\",501,1000]]}")
    set envelope_deep_nested to react_parse_action_envelope("{\"tool_name\":\"codebase_read_range\",\"arguments\":[[[\"decent_agent/tools.ep\",501,1000]]]}")
    if map_get_val(envelope_map and "found") == 1 and also map_get_val(envelope_map and "tool_name") equals "codebase_read" and also map_get_val(envelope_map and "args_str") equals "[\"decent_agent/react_loop.ep\",1,500]" and also map_get_val(envelope_nested_positional and "found") == 1 and also map_get_val(envelope_nested_positional and "args_str") equals "[\"decent_agent/tools.ep\",501,1000]" and also map_get_val(envelope_extra and "found") == 0 and also map_get_val(envelope_prose and "found") == 0 and also map_get_val(envelope_named and "found") == 0 and also map_get_val(envelope_deep_nested and "found") == 0:
        display "  Typed action envelope canonicalizes one positional wrapper and rejects prose, extra keys, objects, and deeper nesting"
    else:
        display "  FAIL: Typed action envelope boundary is not exact"
        set t2_ok to 0
    if react_schema_declares_zero_args("self_extension_status" and "- self_extension_status([]) -> Str\n- codebase_list([root?: Str]) -> Str") == 1 and also react_schema_declares_zero_args("codebase_list" and "- self_extension_status([]) -> Str\n- codebase_list([root?: Str]) -> Str") == 0:
        display "  Exact zero-argument declarations support bounded empty-placeholder normalization"
    else:
        display "  FAIL: zero-argument normalization was not bound to the exact registered schema"
        set t2_ok to 0
    set action_schema to llm_action_response_schema()
    if string_contains(action_schema and "ernos_action_envelope") == 1 and also string_contains(action_schema and "\"required\":[\"tool_name\",\"arguments\"]") == 1 and also string_contains(action_schema and "\"additionalProperties\":false") == 1:
        display "  Provider grammar requires the exact two-key action envelope"
    else:
        display "  FAIL: Provider action schema is not strict"
        set t2_ok to 0

    # Regression: the old parser matched any `Action:` substring and scanned forward
    # to the next `(`, turning explanatory prose into a fabricated multi-line tool name.
    set contaminated_action to "The phrase `Action: reply_request` is only an example.\n```\nAction: fake_tool([])\n```\nAction: reply_request` call was malformed.\nAction: reply_request([\"real answer\"])"
    set contaminated_map to react_parse_action(contaminated_action)
    if map_get_val(contaminated_map and "found") == 1 and also map_get_val(contaminated_map and "tool_name") equals "reply_request" and also string_contains(map_get_val(contaminated_map and "args_str") and "real answer") == 1:
        display "  Parser skipped prose/malformed markers and selected the real action"
    else:
        display "  FAIL: Parser accepted explanatory text or lost the later valid action"
        set t2_ok to 0

    set inline_map to react_parse_action("Commentary Action: fake_tool([]) is not protocol.")
    if map_get_val(inline_map and "found") == 0:
        display "  Inline Action text cannot execute a tool"
    else:
        display "  FAIL: Inline prose was parsed as a tool"
        set t2_ok to 0

    set reasoning_only_turn to llm_compose_turn(extract_message_from_response("{\"choices\":[{\"message\":{\"content\":\"\",\"reasoning\":\"I still need to call session_terminate after moderation.\"}}]}"))
    set reasoning_only_split to react_extract_reasoning(reasoning_only_turn)
    set private_action_residue to react_extract_reasoning("<think>I still need the scheduler file.\nAction: codebase_read([\"decent_agent/scheduler_tool.ep\"])</think>---")
    if react_is_implicit_reply("This is a complete plain-language answer.") == 1 and also react_is_implicit_reply("Thought: I still need to act") == 0 and also react_is_implicit_reply("Action: reply_request missing parentheses") == 0 and also react_is_implicit_reply("---") == 0 and also react_is_implicit_reply("***") == 0 and also string_length(map_get_val(reasoning_only_split and "clean")) == 0 and also string_contains(map_get_val(reasoning_only_split and "reasoning") and "session_terminate") == 1 and also map_get_val(private_action_residue and "clean") equals "---" and also string_contains(map_get_val(private_action_residue and "reasoning") and "codebase_read") == 1 and also react_is_implicit_reply(map_get_val(private_action_residue and "clean")) == 0:
        display "  Plain final prose recovers as a reply; scaffolding does not leak"
    else:
        display "  FAIL: Implicit-reply classification is incorrect"
        set t2_ok to 0

    set mixed_reply to "This is the complete long user-facing answer.\nAction: reply_request([\"done\"])"
    set mixed_map to react_parse_action(mixed_reply)
    if map_get_val(mixed_map and "found") == 1 and also react_action_prefix_is_valid(mixed_reply and map_get_val(mixed_map and "start_pos")) == 0:
        display "  Mixed final prose plus Action is rejected before execution"
    else:
        display "  FAIL: Mixed final prose plus Action was accepted"
        set t2_ok to 0

    set tool_turn to "Thought: I need the current workspace.\nAction: workspace_current([])"
    set tool_turn_map to react_parse_action(tool_turn)
    if map_get_val(tool_turn_map and "found") == 1 and also react_action_turn_is_valid(tool_turn and map_get_val(tool_turn_map and "start_pos") and map_get_val(tool_turn_map and "end_pos")) == 1:
        display "  One-line Thought plus tool Action remains valid"
    else:
        display "  FAIL: Valid tool turn prefix was rejected"
        set t2_ok to 0

    # Live regression: a long, valid source-write action from the local model ended
    # with the complete JSON array but omitted only the final outer `)`. That should
    # not burn another full inference turn or strand a frozen improvement transaction.
    set missing_terminal_close to "Thought: I will apply the verified source repair.\nAction: codebase_write([\"decent_agent/self_extensions.ep\", \"define probe with input as Str returning Str:\\n    return concat(\\\"e2e_probe:\\\" and input)\\n\"]"
    set recovered_close_map to react_parse_action(missing_terminal_close)
    if map_get_val(recovered_close_map and "found") == 1 and also map_get_val(recovered_close_map and "tool_name") equals "codebase_write" and also react_action_turn_is_valid(missing_terminal_close and map_get_val(recovered_close_map and "start_pos") and map_get_val(recovered_close_map and "end_pos")) == 1 and also map_get_val(recovered_close_map and "end_pos") == string_length(missing_terminal_close):
        display "  Complete JSON-array Action recovers one omitted terminal parenthesis"
    else:
        display "  FAIL: Complete source-write Action with one omitted terminal parenthesis was lost"
        set t2_ok to 0

    set unterminated_write to "Action: codebase_write([\"decent_agent/self_extensions.ep\", \"unterminated]"
    set unterminated_write_map to react_parse_action(unterminated_write)
    set incomplete_array_map to react_parse_action("Action: codebase_write([\"decent_agent/self_extensions.ep\", 1")
    if map_get_val(unterminated_write_map and "found") == 0 and also map_get_val(incomplete_array_map and "found") == 0:
        display "  Terminal-close recovery still rejects malformed JSON and open strings"
    else:
        display "  FAIL: Terminal-close recovery accepted an incomplete action"
        set t2_ok to 0

    set trailing_reply to "Thought: I will create it.\nAction: generate_image([\"a luminous sprout\"])\nYour image is on its way."
    set trailing_map to react_parse_action(trailing_reply)
    if map_get_val(trailing_map and "found") == 1 and also react_action_turn_is_valid(trailing_reply and map_get_val(trailing_map and "start_pos") and map_get_val(trailing_map and "end_pos")) == 0:
        display "  Tool Action plus trailing prose is rejected before dispatch"
    else:
        display "  FAIL: Trailing prose after an Action could trigger a real tool"
        set t2_ok to 0

    set valid_batch to "Thought: I need both facts.\nAction: workspace_current([])\nAction: list_sessions([])"
    set valid_batch_map to react_parse_action(valid_batch)
    if react_action_turn_is_valid(valid_batch and map_get_val(valid_batch_map and "start_pos") and map_get_val(valid_batch_map and "end_pos")) == 1:
        display "  Whitespace-separated Action batch remains valid"
    else:
        display "  FAIL: Valid Action batch was rejected"
        set t2_ok to 0

    # run_command is a shell-command string plus optional execution options, not an
    # argv array. Invalid layouts must be detected before the approval path.
    set valid_run_args to create_list()
    set ok to append_list(valid_run_args and "bash decent_agent/run_test.sh decent_agent/test_e2e_quick.ep")
    if string_length(react_validate_tool_args("run_command" and valid_run_args and "[\"bash decent_agent/run_test.sh decent_agent/test_e2e_quick.ep\"]")) == 0:
        display "  Single-string run_command shape passes pre-approval validation"
    else:
        display "  FAIL: Valid single-string run_command shape was rejected"
        set t2_ok to 0

    set valid_run_opts to create_list()
    set ok to append_list(valid_run_opts and "bash build.sh test")
    set ok to append_list(valid_run_opts and ".")
    set ok to append_list(valid_run_opts and "600")
    if string_length(react_validate_tool_args("run_command" and valid_run_opts and "[\"bash build.sh test\", \".\", 600]")) == 0:
        display "  Working-directory and timeout run_command shape passes validation"
    else:
        display "  FAIL: Valid run_command options were rejected"
        set t2_ok to 0

    set argv_run_args to create_list()
    set ok to append_list(argv_run_args and "bash")
    set ok to append_list(argv_run_args and "decent_agent/run_test.sh")
    set ok to append_list(argv_run_args and "decent_agent/test_e2e_quick.ep")
    set argv_run_error to react_validate_tool_args("run_command" and argv_run_args and "[\"bash\", \"decent_agent/run_test.sh\", \"decent_agent/test_e2e_quick.ep\"]")
    if string_contains(argv_run_error and "rejected before approval") == 1 and also string_contains(argv_run_error and "element 1") == 1:
        display "  Argv-style run_command is rejected with a canonical correction before approval"
    else:
        display f"  FAIL: Argv-style run_command validation was not corrective: {argv_run_error}"
        set t2_ok to 0

    set bad_timeout_args to create_list()
    set ok to append_list(bad_timeout_args and "bash build.sh test")
    set ok to append_list(bad_timeout_args and ".")
    set ok to append_list(bad_timeout_args and "not-a-timeout")
    set bad_timeout_error to react_validate_tool_args("run_command" and bad_timeout_args and "[\"bash build.sh test\", \".\", \"not-a-timeout\"]")
    if string_contains(bad_timeout_error and "argument 3 must be an integer timeout") == 1:
        display "  Non-numeric run_command timeout is rejected before approval"
    else:
        display f"  FAIL: Non-numeric timeout was not rejected correctly: {bad_timeout_error}"
        set t2_ok to 0

    set short_replace_args to create_list()
    set ok to append_list(short_replace_args and "decent_agent/self_extensions.ep")
    set ok to append_list(short_replace_args and "whole candidate bytes")
    set short_replace_error to react_validate_tool_args("codebase_replace" and short_replace_args and "[path,whole]")
    if string_contains(short_replace_error and "code=TOOL_ARGUMENTS_INVALID") == 1 and also string_contains(short_replace_error and "exact_old") == 1:
        display "  Malformed codebase_replace is rejected before approval with its exact envelope"
    else:
        display f"  FAIL: Malformed codebase_replace reached approval: {short_replace_error}"
        set t2_ok to 0
    free_list(short_replace_args)

    set no_change_replace_args to create_list()
    set ok to append_list(no_change_replace_args and "decent_agent/self_extensions.ep")
    set ok to append_list(no_change_replace_args and "same bytes")
    set ok to append_list(no_change_replace_args and "same bytes")
    set ok to append_list(no_change_replace_args and 1)
    set no_change_replace_error to react_validate_tool_args("codebase_replace" and no_change_replace_args and "[path,old,old,1]")
    if string_contains(no_change_replace_error and "code=NO_CHANGE") == 1:
        display "  Byte-identical codebase_replace is rejected before approval"
    else:
        display f"  FAIL: No-op codebase_replace reached approval: {no_change_replace_error}"
        set t2_ok to 0
    free_list(no_change_replace_args)

    set frozen_no_change_prompt to react_frozen_decision_prompt_from_state("{\"state\":\"frozen\",\"implementation_candidates\":{\"decent_agent/self_extensions.ep\":{\"status\":\"rejected\"}}}" and "## Exact Interface Evidence\nworking call site" and "implement feature" and "codebase_replace" and "IMPROVEMENT_GATE_FAILED code=NO_CHANGE_REPEAT")
    if string_contains(frozen_no_change_prompt and "CANDIDATE_REPAIR") == 1 and also string_contains(frozen_no_change_prompt and "NO_CHANGE_REPEAT") == 1:
        display "  Frozen no-change repairs rebuild from durable candidate evidence"
    else:
        display "  FAIL: Frozen no-change repair lost durable structured evidence"
        set t2_ok to 0
    set stalled_reset_action to react_candidate_reset_forced_action_from_state("{\"state\":\"frozen\",\"implementation_candidates\":{\"decent_agent/self_extensions.ep\":{\"status\":\"rejected\"}}}" and "IMPROVEMENT_GATE_FAILED code=NO_CHANGE_REPEAT message=byte-identical repair repeated")
    set archived_reset_action to react_candidate_reset_forced_action_from_state("{\"state\":\"repair_required\",\"implementation_candidate_attempts\":[{\"reason\":\"CANDIDATE_BASELINE_INCOMPLETE\"}]}" and "")
    if string_contains(stalled_reset_action and "Action: improvement_candidate_reset([])") == 1 and also string_length(react_candidate_reset_forced_action_from_state("{\"state\":\"frozen\"}" and "")) == 0 and also string_length(archived_reset_action) == 0:
        display "  Repeated no-change repair becomes one deterministic candidate reset"
    else:
        display "  FAIL: repeated no-change repair could re-enter unrestricted inference"
        set t2_ok to 0

    set frozen_write_prompt to react_frozen_decision_prompt_from_state("{\"state\":\"frozen\"}" and "## Exact Interface Evidence\nworking call site" and "implement feature" and "codebase_read_range" and "[source bytes]\nIMPROVEMENT_REREAD_OK path=decent_agent/self_extensions.ep")
    if string_contains(frozen_write_prompt and "PLANNED_IMPLEMENTATION_WRITE_ONLY") == 1 and also string_contains(frozen_write_prompt and "codebase_write") == 1:
        display "  A successful frozen production read advances to write-only state"
    else:
        display "  FAIL: Frozen production read did not advance to write-only state"
        set t2_ok to 0
    if react_initial_frozen_read_required("{\"state\":\"frozen\"}" and "improvement_test_freeze" and "FREEZE_OK") == 1 and also react_initial_frozen_read_required("{\"state\":\"frozen\"}" and "codebase_read" and "IMPROVEMENT_REREAD_OK path=decent_agent/self_extensions.ep") == 0 and also react_initial_frozen_read_required("{\"state\":\"frozen\",\"implementation_candidates\":{\"x\":{\"status\":\"rejected\"}}}" and "codebase_write" and "compile failed") == 0:
        display "  First frozen candidate requires exact current production bytes"
    else:
        display "  FAIL: Frozen candidate could bypass the deterministic current-source read"
        set t2_ok to 0

    set normalize_ctx to create_map()
    set ok to map_insert(normalize_ctx and "improvement_test_frozen" and 1)
    # The filesystem-backed selector is covered by the Python gate suite; this native
    # assertion protects the registered controller envelope itself.
    if string_contains(tools_get_schema_string(tools_create("admin")) and "improvement_candidate_normalize([])") == 1 and also string_contains(tools_get_schema_string(tools_create("admin")) and "improvement_candidate_reset([])") == 1:
        display "  Candidate dialect normalization is a registered typed transition"
    else:
        display "  FAIL: Candidate dialect normalization tool is not registered"
        set t2_ok to 0
    free_map(normalize_ctx)

    # Local-model compatibility: tolerate the stable split-positional expression
    # while keeping the registered one-array contract authoritative.
    set split_search_args to "[\"discord\"], \"decent_agent\", 25"
    set normalized_search_args to react_normalize_split_default_expression(split_search_args)
    set canonical_search_args to "[\"discord\", \"decent_agent\", 25]"
    if react_split_default_expression_close(split_search_args) >= 0 and also normalized_search_args equals canonical_search_args and also react_split_default_expression_close(canonical_search_args) < 0:
        display "  Split-positional model syntax normalizes to the registered JSON-array contract"
    else:
        display f"  FAIL: Split-positional normalization was incorrect: {normalized_search_args}"
        set t2_ok to 0

    set ambiguous_search_args to create_list()
    set ok to append_list(ambiguous_search_args and "define discord_read_channel")
    set ok to append_list(ambiguous_search_args and "define discord_list_channels")
    set ok to append_list(ambiguous_search_args and "decent_agent")
    set ok to append_list(ambiguous_search_args and "25")
    set ambiguous_search_error to react_validate_tool_args("codebase_search" and ambiguous_search_args and "[\"define discord_read_channel\", \"define discord_list_channels\", \"decent_agent\", 25]")
    if string_contains(ambiguous_search_error and "separate batched Action") == 1:
        display "  Ambiguous multi-query search is rejected with exact batched-call guidance"
    else:
        display f"  FAIL: Ambiguous multi-query search was not rejected: {ambiguous_search_error}"
        set t2_ok to 0

    set reversed_scaffold_args to create_list()
    set ok to append_list(reversed_scaffold_args and "decent_agent/react_loop.ep")
    set ok to append_list(reversed_scaffold_args and "Implement a session summary generator")
    set reversed_scaffold_error to react_validate_tool_args("improvement_plan_scaffold" and reversed_scaffold_args and "[]")
    set valid_scaffold_args to create_list()
    set ok to append_list(valid_scaffold_args and "session_summary_generator")
    set ok to append_list(valid_scaffold_args and "decent_agent/self_extensions.ep")
    set valid_scaffold_error to react_validate_tool_args("improvement_plan_scaffold" and valid_scaffold_args and "[]")
    if string_contains(reversed_scaffold_error and "code=TOOL_ARGUMENTS_INVALID") == 1 and also string_contains(reversed_scaffold_error and "Argument 1") == 1 and also string_length(valid_scaffold_error) == 0:
        display "  Reversed scaffold arguments are rejected before approval with canonical ordering"
    else:
        display f"  FAIL: Scaffold argument validation did not preserve exact surface-first ordering: {reversed_scaffold_error}"
        set t2_ok to 0
    free_list(reversed_scaffold_args)
    free_list(valid_scaffold_args)

    set generic_request_contract to "Choose one useful feature, implement it completely, test it, recompile, restart, and verify it live."
    set concrete_feature_contract to "Implement a registered tool named `session_summary_generator` that returns and durably persists a structured session summary."
    set bound_feature_contract to tools_improvement_bind_objective(generic_request_contract and concrete_feature_contract)
    if string_contains(bound_feature_contract and "[IMMUTABLE USER REQUEST]") == 1 and also string_contains(bound_feature_contract and generic_request_contract) == 1 and also string_contains(bound_feature_contract and "[CONCRETE FEATURE SELECTED BY ECHO]") == 1 and also string_contains(bound_feature_contract and concrete_feature_contract) == 1:
        display "  Generic user contract and Echo's concrete feature selection remain jointly immutable"
    else:
        display "  FAIL: Concrete autonomous feature selection was discarded from the immutable contract"
        set t2_ok to 0

    set self_repair_schema to tools_get_schema_string(tools_create("admin"))
    set empty_verify_args to create_list()
    if string_contains(self_repair_schema and "REQUIRED FIRST STEP for any self-repair") == 1 and also string_contains(self_repair_schema and "never trusts precompiled test binaries") == 1 and also string_contains(self_repair_schema and "codebase_list") == 1 and also string_contains(self_repair_schema and "before guessing a filename") == 1 and also string_contains(self_repair_schema and "improvement_investigation_begin") == 1 and also string_contains(self_repair_schema and "improvement_plan_write") == 1 and also string_contains(self_repair_schema and "controller owns and checks") == 1 and also string_contains(self_repair_schema and "improvement_test_begin") == 1 and also string_contains(self_repair_schema and "improvement_test_write") == 1 and also string_contains(self_repair_schema and "improvement_test_scaffold") == 1 and also string_contains(self_repair_schema and "improvement_test_validate") == 1 and also string_contains(self_repair_schema and "Failed validation NEVER deletes") == 1 and also tools_requires_approval("system_verify" and empty_verify_args) == 1 and also tools_requires_approval("improvement_test_freeze" and empty_verify_args) == 1:
        display "  Self-repair routes through verification, durable investigation/plan, and retained staged tests"
    else:
        display "  FAIL: system_verify is not the authoritative self-repair route"
