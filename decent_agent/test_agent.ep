    if string_length(tools_improvement_incomplete_content_error(t24_feature_ctx and "def run_simulation_test():\n    return 'success'\n")) == 0 or else string_length(tools_improvement_incomplete_content_error(t24_feature_ctx and "define durable_synthesis with transcript as Str returning Str:\n    set lesson to synthesis_extract_lesson(transcript)\n    set ok to lessons_store_durable(lesson)\n    return lesson\n")) != 0:
        display "  FAIL: incomplete improvement bodies were not rejected without blocking substantive production code"
        set t24_ok to 0
    if string_length(tools_repair_action_error(t24_feature_ctx and "codebase_write")) != 0 or else string_length(tools_repair_action_error(t24_feature_ctx and "system_recompile")) == 0:
        display "  FAIL: frozen evaluator did not unlock implementation while keeping deployment locked"
        set t24_ok to 0
    set ok to tools_repair_record_write(t24_feature_ctx)
    if string_length(tools_repair_action_error(t24_feature_ctx and "codebase_read")) != 0 or else string_length(tools_repair_action_error(t24_feature_ctx and "codebase_write")) != 0 or else string_length(tools_repair_action_error(t24_feature_ctx and "system_verify")) != 0 or else string_length(tools_repair_action_error(t24_feature_ctx and "system_recompile")) == 0:
        display "  FAIL: multi-file feature transaction did not preserve reads/writes and verification while keeping deployment locked"
        set t24_ok to 0
    free_map(t24_feature_ctx)
    set t24_verify_log to "Undefined symbols for architecture arm64: expected preliminary bootstrap noise\nTEST 22: Multi-user session speaker provenance\n  FAIL: serialized speaker provenance used authorization_level=guest\nTEST 24: Self-upgrade test-integrity lock\n  PASS\n23/24 cognitive agent tests passed.\n1 FAILED!"
    set t24_failure_summary to compiler_failure_summary(t24_verify_log)
    set t24_test_pos to string_index_of(t24_failure_summary and "TEST 22:")
    set t24_noise_pos to string_index_of(t24_failure_summary and "Undefined symbols")
    if string_index_of(t24_failure_summary and "AUTHORITATIVE FAILURE SUMMARY") < 0 or else t24_test_pos < 0 or else t24_noise_pos < 0 or else t24_test_pos >= t24_noise_pos or else string_index_of(t24_failure_summary and "TEST 24: Self-upgrade test-integrity lock\nOverall suite result") >= 0 or else string_index_of(t24_failure_summary and "Overall suite result: 1 FAILED!") < 0:
        display concat("  FAIL: verifier did not prioritize the actionable test over bootstrap noise: " and t24_failure_summary)
        set t24_ok to 0
    set t24_python_summary to compiler_failure_summary("[mandatory-gate] python3 tests/test_example.py\nERROR: test_runtime_path (__main__.Example)\nFAILED (errors=1)")
    if string_index_of(t24_python_summary and "ERROR: test_runtime_path") < 0 or else string_index_of(t24_python_summary and "Overall suite result: FAILED (errors=1)") < 0:
        display concat("  FAIL: uppercase Python errors were omitted from the authoritative summary: " and t24_python_summary)
        set t24_ok to 0
    set t24_search to tools_codebase_search("define session_message_speaker_label" and "decent_agent" and 25)
    if string_index_of(t24_search and "decent_agent/session.ep:") < 0 or else string_index_of(t24_search and "exact paths") < 0:
        display concat("  FAIL: native codebase search did not return exact implementation provenance: " and t24_search)
        set t24_ok to 0
    set t24_list to tools_codebase_list("decent_agent" and 200)
    if string_index_of(t24_list and "decent_agent/session.ep") < 0 or else string_index_of(t24_list and "decent_agent/tools.ep") < 0 or else string_contains(t24_list and "exact existing paths") == 0 or else string_contains(t24_list and "Do not reconstruct or guess filenames") == 0:
        display concat("  FAIL: native codebase listing did not return exact current-source paths and recovery guidance: " and t24_list)
        set t24_ok to 0
    if tools_exact_occurrences("alpha beta alpha" and "alpha") != 2 or else tools_exact_occurrences("alpha" and "missing") != 0 or else string_contains(self_repair_schema and "retained failed candidate") == 0 or else string_contains(self_repair_schema and "codebase_replace") == 0 or else tools_requires_approval("codebase_replace" and empty_verify_args) != 1:
        display "  FAIL: exact localized source replacement is not fail-closed and approval-gated"
        set t24_ok to 0
    set t24_ctx to create_map()
    set ok to map_insert(t24_ctx and "sender_role" and "owner")
    set ok to map_insert(t24_ctx and "upgrade_restart_requested" and 1)
    set t24_args to create_list()
    set ok to append_list(t24_args and "decent_agent/session.ep")
    set t24_blocked to tools_execute(tools_mgr and t24_ctx and "codebase_read" and t24_args)
    if string_contains(t24_blocked and "no further tool or mutation") == 0:
        display concat("  FAIL: post-staging tool execution remained possible: " and t24_blocked)
        set t24_ok to 0
    set t24_wake_ctx to create_map()
    set ok to map_insert(t24_wake_ctx and "sender_role" and "owner")
    set ok to map_insert(t24_wake_ctx and "upgrade_wake" and 1)
    set ok to map_insert(t24_wake_ctx and "upgrade_wake_canonical_reply" and "authenticated exact receipt")
    set ok to tools_repair_begin(t24_wake_ctx and "The committed improvement transaction completed after system_recompile.")
    if map_get_val(t24_wake_ctx and "repair_workflow_active") != 0 or else string_length(tools_repair_action_error(t24_wake_ctx and "reply_request")) != 0:
        display "  FAIL: authenticated upgrade wake was misclassified as a new repair request"
        set t24_ok to 0
    set t24_wake_args to create_list()
    set ok to append_list(t24_wake_args and "hallucinated truncated hashes")
    set t24_wake_reply to tools_execute(tools_mgr and t24_wake_ctx and "reply_request" and t24_wake_args)
    if t24_wake_reply equals "authenticated exact receipt" == 0:
        display concat("  FAIL: wake reply did not preserve the authenticated receipt: " and t24_wake_reply)
        set t24_ok to 0
    if t24_ok == 1:
        display "  Test/gate paths are operator-only; repair ordering and post-staging tools are locked"
        display "  PASS"
        set tests_passed to tests_passed + 1
    else:
        set tests_failed to tests_failed + 1

    # ===========================================================
    # TEST 25: Bounded self-authored extension registration
    # ===========================================================
    display "TEST 25: Bounded self-authored extension registration"
    set t25_ok to 1
    set t25_schema to tools_get_schema_string(tools_mgr)
    if string_contains(t25_schema and "- self_extension_status([]) -> Str") == 0 or else string_contains(t25_schema and "core-gated dispatch") == 0 or else string_contains(t25_schema and "- aes_distill([transcript]) -> Str") == 0 or else string_contains(t25_schema and "[LESSON: key | value]") == 0 or else string_contains(t25_schema and "[CORRECTION: key | value]") == 0:
        display "  FAIL: extension schema was not registered through the core tool manager"
        set t25_ok to 0
    set t25_ctx to create_map()
    set ok to map_insert(t25_ctx and "sender_role" and "owner")
    set ok to map_insert(t25_ctx and "memory_mgr" and mem)
    set t25_db_path to concat("/tmp/ernos_extension_context_" and concat(int_to_string(ep_time_now_ms()) and ".db"))
    set t25_db to sql_open(t25_db_path)
    set ok to map_insert(t25_ctx and "storage_db" and t25_db)
    set t25_args to create_list()
    set t25_result to tools_execute(tools_mgr and t25_ctx and "self_extension_status" and t25_args)
    if string_contains(t25_result and "self_extensions:ok") == 0 or else string_contains(t25_result and "mandatory_plus_live_e2e") == 0:
        display concat("  FAIL: extension dispatch did not reach the real registered implementation: " and t25_result)
        set t25_ok to 0
    if map_contains(t25_ctx and "storage_db") == 0 or else map_get_val(t25_ctx and "storage_db") == 0:
        display "  FAIL: extension dispatch did not receive the core-owned database handle"
        set t25_ok to 0
    set t25_distill_args to create_list()
    set ok to append_list(t25_distill_args and "[LESSON: t25_preserved_key | t25_preserved_value]")
    set t25_distill_result to tools_execute(tools_mgr and t25_ctx and "aes_distill" and t25_distill_args)
    set t25_lessons to map_get_val(mem and "lessons")
    if t25_distill_result equals "processed" == 0 or else map_contains(t25_lessons and "t25_preserved_key") == 0 or else map_get_val(t25_lessons and "t25_preserved_key") equals "t25_preserved_value" == 0:
        display concat("  FAIL: existing aes_distill schema or behavior regressed during extension work: " and t25_distill_result)
        set t25_ok to 0
    set t25_direct_count to self_extensions_distill_kind(mem and "[LESSON: t25_count_key | t25_count_value]" and "[LESSON:")
    if t25_direct_count != 1:
        display concat("  FAIL: extension helper persisted a lesson but reported the wrong successful-write count: " and int_to_string(t25_direct_count))
        set t25_ok to 0
    if tools_path_is_upgrade_trust_root("decent_agent/tools.ep") != 1 or else tools_path_is_upgrade_trust_root("decent_agent/self_extensions.ep") != 0:
        display "  FAIL: extension boundary does not preserve the sealed core controller"
        set t25_ok to 0
    set t25_gate_status to tools_improvement_gate_command("status" and 30000)
    if string_index_of(t25_gate_status and "IMPROVEMENT_STATUS") != 0:
        display concat("  FAIL: yielding improvement-controller worker did not return its durable status receipt: " and t25_gate_status)
        set t25_ok to 0
    free_list(t25_args)
    free_list(t25_distill_args)
    free_map(t25_ctx)
    set ok to sql_close(t25_db)
    if file_exists(t25_db_path) == 1:
        set ok to remove_file(t25_db_path)
    if t25_ok == 1:
        display "  Extensions register and dispatch; the yielding controller worker returns without blocking"
        display "  PASS"
        set tests_passed to tests_passed + 1
    else:
        set tests_failed to tests_failed + 1

    # ===========================================================
    # Summary
    # ===========================================================
    display ""
    display "==================================================="
    set total to tests_passed + tests_failed
    display f"  {tests_passed}/{total} cognitive agent tests passed."
    if tests_failed > 0:
        display f"  {tests_failed} FAILED!"
        exit_program(1)
    else:
        display "  ALL COGNITIVE AGENT TESTS PASSED!"
    display "==================================================="
    return 0
