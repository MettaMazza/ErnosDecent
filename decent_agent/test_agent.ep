    set escaped_triple_payload to "def test_encoded():\n    \\\"\\\"\\\"encoded docstring\\\"\\\"\\\"\n    value = \\\"ok\\\"\n    assert value == \\\"ok\\\""
    set normalized_triple_payload to react_unescape_triple_payload(escaped_triple_payload)
    if string_contains(normalized_triple_payload and "\\\"") == 0 and also string_contains(normalized_triple_payload and "\"\"\"encoded docstring\"\"\"") == 1 and also string_contains(normalized_triple_payload and "value = \"ok\"") == 1:
