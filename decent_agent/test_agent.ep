# ErnosPlain Rebuild of ErnOS Agent Unit Test Suite
# Component: decent_agent/test_agent.ep
# Tests: Hebbian learning, ReAct parser, 3D Turing grid, Observer audit, E2E simulation
# Status: Development

import "collections"
import "string"
import "fs"
import "os"
import "json"

# Subsystems
import "prompt"
import "tools"
import "memory"
import "turing_grid"
import "react_loop"
import "observer"
import "session"

import "../decent_id/did"
import "../decent_money/ledger"
import "learning"
import "sleep"
import "./sync"
import "synaptic_tool"
import "scheduler"
import "scheduler_tool"
import "../logging"
import "../decent_net/gitdec"

external define ep_run_command_bounded with cmd as Str and timeout_ms as Int and start_epoch as Int returning Str
external define ep_cancel_epoch_get with dummy as Int returning Int
external define ep_cancel_epoch_bump with dummy as Int returning Int
external define ep_time_now_ms returning Int

define bounded_command_cancel_worker with done_ch and start_epoch as Int:
    set result to ep_run_command_bounded("sleep 30" and 30000 and start_epoch)
    send result to done_ch
    return 0

define main:
    display "==================================================="
    display "  ErnOS Agent Rebuild -- Unit Test Suite"
    display "==================================================="
    display ""

    set tests_passed to 0
    set tests_failed to 0

    # ===========================================================
    # TEST 1: Hebbian Memory Tier 4 edge weight logic
    # ===========================================================
    display "TEST 1: Hebbian edge creation and weight consolidation"
    set t1_ok to 1
    
    set mem to memory_create()
    
    # Co-activate "wallet" and "ledger"
    set ok to memory_strengthen_synapse(mem and "wallet" and "ledger")
    set edges to map_get_val(mem and "edges")
    
    if map_contains(edges and "ledger-wallet") == 1 or else map_contains(edges and "wallet-ledger") == 1:
        set key to "ledger-wallet"
        if map_contains(edges and "wallet-ledger") == 1:
            set key to "wallet-ledger"
            
        set w1 to map_get_val(edges and key)
        # First co-activation weight should be 100,000 (0.1 in scale 1,000,000)
        if w1 == 100000:
            display "  Synapse edge created with correct initial weight: 0.100"
        else:
            display f"  FAIL: Expected edge weight 100000, got {w1}"
            set t1_ok to 0
            
        # Co-activate again: w_new = w_old + 0.1 * (1.0 - w_old)
        # w_new = 100,000 + 0.1 * (1,000,000 - 100,000) = 100,000 + 90,000 = 190,000 (0.19)
        set ok to memory_strengthen_synapse(mem and "wallet" and "ledger")
        set w2 to map_get_val(edges and key)
        if w2 == 190000:
            display "  Hebbian Edge reinforcement formula verified correctly: 0.190"
        else:
            display f"  FAIL: Expected reinforced edge weight 190000, got {w2}"
            set t1_ok to 0
            
        # Decay: w_new = w_old * 0.95
        # w_decay = 190,000 * 0.95 = 180,500
        set ok to memory_decay_synapses(mem)
        set edges_decayed to map_get_val(mem and "edges")
        set w_decay to map_get_val(edges_decayed and key)
        if w_decay == 180500:
            display "  Synaptic decay consolidated correctly: 0.180"
        else:
            display f"  FAIL: Expected decayed weight 180500, got {w_decay}"
            set t1_ok to 0
    else:
        display "  FAIL: Synaptic graph edge not found"
        set t1_ok to 0

    if t1_ok == 1:
        display "  PASS"
        set tests_passed to tests_passed + 1
    else:
        set tests_failed to tests_failed + 1

    # ===========================================================
    # TEST 2: ReAct thought and action parser
    # ===========================================================
    display "TEST 2: ReAct tool execution parser"
    set t2_ok to 1
    
    set action_str to "Thought: I need to fetch the DHT value.\nAction: dht_get([\"key123\"])"
    set action_map to react_parse_action(action_str)
    
    set found to map_get_val(action_map and "found")
    if found == 1:
        set t_name to map_get_val(action_map and "tool_name")
        set a_str to map_get_val(action_map and "args_str")
        
        if t_name equals "dht_get":
            display f"  Action parser extracted tool name: {t_name}"
        else:
            display f"  FAIL: Expected tool 'dht_get', got '{t_name}'"
            set t2_ok to 0
            
        if a_str equals "[\"key123\"]":
            display f"  Action parser extracted args string: {a_str}"
        else:
            display f"  FAIL: Expected args '[\"key123\"]', got '{a_str}'"
            set t2_ok to 0
    else:
        display "  FAIL: ReAct parser did not detect action block"
        set t2_ok to 0

    # Regression: the old parser matched any `Action:` substring and scanned forward
    # to the next `(`, turning explanatory prose into a fabricated multi-line tool name.
    set contaminated_action to "The phrase `Action: reply_request` is only an example.\n```\nAction: fake_tool([])\n```\nAction: reply_request` call was malformed.\nAction: reply_request([\"real answer\"])"
    set contaminated_map to react_parse_action(contaminated_action)
    if map_get_val(contaminated_map and "found") == 1 and also map_get_val(contaminated_map and "tool_name") equals "reply_request" and also string_contains(map_get_val(contaminated_map and "args_str") and "real answer") == 1:
        display "  Parser skipped prose/malformed markers and selected the real action"
    else:
        display "  FAIL: Parser accepted explanatory text or lost the later valid action"
        set t2_ok to 0

    set inline_map to react_parse_action("Commentary Action: fake_tool([]) is not protocol.")
    if map_get_val(inline_map and "found") == 0:
        display "  Inline Action text cannot execute a tool"
    else:
        display "  FAIL: Inline prose was parsed as a tool"
        set t2_ok to 0

    set reasoning_only_turn to llm_compose_turn(extract_message_from_response("{\"choices\":[{\"message\":{\"content\":\"\",\"reasoning\":\"I still need to call session_terminate after moderation.\"}}]}"))
    set reasoning_only_split to react_extract_reasoning(reasoning_only_turn)
    if react_is_implicit_reply("This is a complete plain-language answer.") == 1 and also react_is_implicit_reply("Thought: I still need to act") == 0 and also react_is_implicit_reply("Action: reply_request missing parentheses") == 0 and also string_length(map_get_val(reasoning_only_split and "clean")) == 0 and also string_contains(map_get_val(reasoning_only_split and "reasoning") and "session_terminate") == 1:
        display "  Plain final prose recovers as a reply; scaffolding does not leak"
    else:
        display "  FAIL: Implicit-reply classification is incorrect"
        set t2_ok to 0

    set mixed_reply to "This is the complete long user-facing answer.\nAction: reply_request([\"done\"])"
    set mixed_map to react_parse_action(mixed_reply)
    if map_get_val(mixed_map and "found") == 1 and also react_action_prefix_is_valid(mixed_reply and map_get_val(mixed_map and "start_pos")) == 0:
        display "  Mixed final prose plus Action is rejected before execution"
    else:
        display "  FAIL: Mixed final prose plus Action was accepted"
        set t2_ok to 0

    set tool_turn to "Thought: I need the current workspace.\nAction: workspace_current([])"
    set tool_turn_map to react_parse_action(tool_turn)
    if map_get_val(tool_turn_map and "found") == 1 and also react_action_turn_is_valid(tool_turn and map_get_val(tool_turn_map and "start_pos") and map_get_val(tool_turn_map and "end_pos")) == 1:
        display "  One-line Thought plus tool Action remains valid"
    else:
        display "  FAIL: Valid tool turn prefix was rejected"
        set t2_ok to 0

    set trailing_reply to "Thought: I will create it.\nAction: generate_image([\"a luminous sprout\"])\nYour image is on its way."
    set trailing_map to react_parse_action(trailing_reply)
    if map_get_val(trailing_map and "found") == 1 and also react_action_turn_is_valid(trailing_reply and map_get_val(trailing_map and "start_pos") and map_get_val(trailing_map and "end_pos")) == 0:
        display "  Tool Action plus trailing prose is rejected before dispatch"
    else:
        display "  FAIL: Trailing prose after an Action could trigger a real tool"
        set t2_ok to 0

    set valid_batch to "Thought: I need both facts.\nAction: workspace_current([])\nAction: list_sessions([])"
    set valid_batch_map to react_parse_action(valid_batch)
    if react_action_turn_is_valid(valid_batch and map_get_val(valid_batch_map and "start_pos") and map_get_val(valid_batch_map and "end_pos")) == 1:
        display "  Whitespace-separated Action batch remains valid"
    else:
        display "  FAIL: Valid Action batch was rejected"
        set t2_ok to 0

    if react_tool_result_finishes_turn("generate_image" and 1 and "Your image is rendering as job 42.") == 1 and also react_tool_result_finishes_turn("generate_image" and 1 and "ERROR: model missing") == 0 and also react_tool_result_finishes_turn("session_terminate" and 1 and "Session closed by Echo. Reason: safeguarding.") == 1 and also react_tool_result_finishes_turn("session_terminate" and 1 and "Error: checkpoint failed") == 0 and also react_tool_result_finishes_turn("session_terminate" and 0 and "Session closed by Echo.") == 0 and also react_tool_result_finishes_turn("workspace_read" and 1 and "contents") == 0:
        display "  Successful image dispatch and session closure are terminal; failures, blocked actions, and ordinary tools are not"
    else:
        display "  FAIL: Terminal tool policy is incorrect"
        set t2_ok to 0

    set active_kernel to prompt_get_kernel()
    if string_contains(active_kernel and "output the complete user-facing answer as normal prose") == 1 and also string_contains(active_kernel and "MUST wrap your final response") == 0 and also string_contains(active_kernel and "MUST call the reply_request") == 0:
        display "  Active prompt uses the native final-response contract"
    else:
        display "  FAIL: Active prompt still mandates terminal reply_request serialization"
        set t2_ok to 0

    set batched_text to "Action: workspace_current([])\nThe words Action: fake([]) are prose.\nAction: list_sessions([])"
    set batched_first to react_parse_action(batched_text)
    set batched_rest to react_slice_from_next_action(batched_text and map_get_val(batched_first and "end_pos"))
    if string_index_of(batched_rest and "Action: list_sessions") == 0:
        display "  Batch slicing ignores inline Action prose"
    else:
        display f"  FAIL: Batch slicer selected the wrong marker: {batched_rest}"
        set t2_ok to 0

    if t2_ok == 1:
        display "  PASS"
        set tests_passed to tests_passed + 1
    else:
        set tests_failed to tests_failed + 1

    # ===========================================================
    # TEST 3: 3D Turing Grid Movements & Instructions
    # ===========================================================
    display "TEST 3: 3D Turing grid spatial positioning"
    set t3_ok to 1
    
    set grid to grid_create()
    
    # Navigate
    set ok to grid_move(grid and "LEFT")
    set ok to grid_move(grid and "UP")
    
    set x to map_get_val(grid and "x")
    set z to map_get_val(grid and "z")
    if x == -1 and also z == 1:
        display f"  Turing head moved left and up to ({x}, 0, {z})"
    else:
        display f"  FAIL: Coordinate drift! Expected (-1, 0, 1), got ({x}, 0, {z})"
        set t3_ok to 0
        
    # Read/Write cell
    set ok to grid_write(grid and "wallet_balance([])")
    set content to grid_read(grid)
    if content equals "wallet_balance([])":
        display "  Cell instruction read/write verified"
    else:
        display f"  FAIL: Content mismatch! Expected 'wallet_balance([])', got '{content}'"
        set t3_ok to 0

    if t3_ok == 1:
        display "  PASS"
        set tests_passed to tests_passed + 1
    else:
        set tests_failed to tests_failed + 1

    # ===========================================================
    # TEST 4: Observer Audit Checks (Inference-Only Mode)
    # ===========================================================
    display "TEST 4: Observer inference-only audit checks"
    set t4_ok to 1
    
    # Create test context with is_test=1 (skips LLM, returns ALLOWED)
    set test_ctx to create_map()
    set ok to map_insert(test_ctx and "is_test" and 1)
    
    # Standard clean response — should be ALLOWED under test mode
    set clean_audit to observer_audit(test_ctx and "Test prompt context" and "Clean reply text")
    set v1 to map_get_val(clean_audit and "verdict")
    set p1 to map_get_val(clean_audit and "parsed")
    if v1 equals "ALLOWED" and also p1 == 1:
        display "  Observer correctly returned ALLOWED in test mode (inference bypassed)"
    else:
        display f"  FAIL: Expected parsed ALLOWED in test mode, got verdict={v1}, parsed={p1}"
        set t4_ok to 0
        
    # Even a response with leaked grammar should return ALLOWED under test mode
    # because test mode skips LLM inference entirely (no static heuristics exist)
    set leak_audit to observer_audit(test_ctx and "Test prompt context" and "Response showing Action: run_command([\"ls\"]) to the user")
    set v2 to map_get_val(leak_audit and "verdict")
    if v2 equals "ALLOWED":
        display "  Observer correctly bypasses all checks in test mode (no static heuristics)"
    else:
        display f"  FAIL: Expected ALLOWED in test mode, got {v2}"
        set t4_ok to 0

    if t4_ok == 1:
        display "  PASS"
        set tests_passed to tests_passed + 1
    else:
        set tests_failed to tests_failed + 1

    # ===========================================================
    # TEST 5: ReAct Loop E2E Simulation
    # ===========================================================
    display "TEST 5: ReAct Reasoning E2E Simulation Loop"
    set t5_ok to 1
    
    set model to create_map()
    set tools_mgr to tools_create("admin")
    set ctx to create_map()
    set ok to map_insert(ctx and "turing_grid" and grid)
    
    set identity to create_identity()
    set genesis_pub to ptr_to_str(map_get_val(identity and "signing_public_key"))
    set ledger to ledger_create(genesis_pub)
    
    set ok to map_insert(ctx and "identity" and identity)
    set ok to map_insert(ctx and "ledger" and ledger)
    set ok to map_insert(ctx and "is_test" and 1)
    
    set reply to react_run(model and mem and tools_mgr and ctx and "CHECK BALANCE")
    if string_contains(reply and "wallet_balance") == 1 or else string_contains(reply and "Success") == 1:
        display f"  ReAct loop simulation output completed successfully"
    else:
        display f"  FAIL: Simulated reasoning response was unexpected: '{reply}'"
        set t5_ok to 0

    if t5_ok == 1:
        display "  PASS"
        set tests_passed to tests_passed + 1
    else:
        set tests_failed to tests_failed + 1

    # ===========================================================
    # TEST 6: Hebbian Memory Serialization and Deserialization
    # ===========================================================
    display "TEST 6: Hebbian Memory Serialization and Deserialization"
    set t6_ok to 1

    set test_path to "scratch/test_memory_serialize.json"
    
    # Store some dummy values into mem
    set ok to memory_store(mem and 1 and "key_scratch" and "val_scratch")
    set ok to memory_store(mem and 2 and "key_lesson" and "val_lesson")
    set ok to memory_store(mem and 3 and "key_time" and "val_time")

    set ser_err to memory_serialize(mem and test_path)
    if ser_err == 0:
        display "  Serialized memory state to JSON successfully"
    else:
        display f"  FAIL: Serialization returned error {ser_err}"
        set t6_ok to 0

    # Load it back using memory_deserialize
    set loaded_mem to memory_deserialize(test_path)
    if loaded_mem != 0:
        # Check scratchpad
        set l_scratchpad to map_get_val(loaded_mem and "scratchpad")
        if map_contains(l_scratchpad and "key_scratch") == 1:
            set val to map_get_val(l_scratchpad and "key_scratch")
            if val equals "val_scratch":
                display "  Deserialized scratchpad value successfully"
            else:
                display f"  FAIL: Expected val_scratch, got {val}"
                set t6_ok to 0
        else:
            display "  FAIL: Deserialized scratchpad does not contain key_scratch"
            set t6_ok to 0

        # Check lessons
        set l_lessons to map_get_val(loaded_mem and "lessons")
        if map_contains(l_lessons and "key_lesson") == 1:
            set val to map_get_val(l_lessons and "key_lesson")
            if val equals "val_lesson":
                display "  Deserialized lessons value successfully"
            else:
                display f"  FAIL: Expected val_lesson, got {val}"
                set t6_ok to 0
        else:
            display "  FAIL: Deserialized lessons does not contain key_lesson"
            set t6_ok to 0

        # Check edges
        set l_edges to map_get_val(loaded_mem and "edges")
        set edge_key to "ledger-wallet"
        if map_contains(l_edges and "wallet-ledger") == 1:
            set edge_key to "wallet-ledger"
        if map_contains(l_edges and edge_key) == 1:
            set w_loaded to map_get_val(l_edges and edge_key)
            if w_loaded == 180500:
                display "  Deserialized edges value successfully"
            else:
                display f"  FAIL: Expected edge weight 180500, got {w_loaded}"
                set t6_ok to 0
        else:
            display f"  FAIL: Deserialized edges does not contain {edge_key}"
            set t6_ok to 0
    else:
        display "  FAIL: memory_deserialize returned 0"
        set t6_ok to 0

    if t6_ok == 1:
        display "  PASS"
        set tests_passed to tests_passed + 1
    else:
        set tests_failed to tests_failed + 1

    # ===========================================================
    # TEST 7: Synaptic Graph Actions & Contradiction Checking
    # ===========================================================
    display "TEST 7: Synaptic Graph Actions & Contradiction Checking"
    set t7_ok to 1
    
    set args_store to create_list()
    set ok to append_list(args_store and "Banana")
    set ok to append_list(args_store and "A yellow curved fruit")
    set store_res to operate_synaptic_graph(mem and "store" and args_store)
    free_list(args_store)
    
    set args_search to create_list()
    set ok to append_list(args_search and "Banana")
    set search_res to operate_synaptic_graph(mem and "search" and args_search)
    free_list(args_search)
    
    if string_contains(search_res and "yellow curved fruit") == 1:
        display "  Concept stored and search match found"
    else:
        display f"  FAIL: Search output unexpected: '{search_res}'"
        set t7_ok to 0
        
    set args_rel1 to create_list()
    set ok to append_list(args_rel1 and "Banana")
    set ok to append_list(args_rel1 and "color")
    set ok to append_list(args_rel1 and "Yellow")
    set rel_res1 to operate_synaptic_graph(mem and "relate" and args_rel1)
    free_list(args_rel1)
    
    set args_rel2 to create_list()
    set ok to append_list(args_rel2 and "Banana")
    set ok to append_list(args_rel2 and "color")
    set ok to append_list(args_rel2 and "Blue")
    set rel_res2 to operate_synaptic_graph(mem and "relate" and args_rel2)
    free_list(args_rel2)
    
    if string_contains(rel_res2 and "Contradiction") == 1:
        display "  Contradiction check warning verified successfully"
    else:
        display f"  FAIL: Contradiction warning missed! Output: '{rel_res2}'"
        set t7_ok to 0
        
    if t7_ok == 1:
        display "  PASS"
        set tests_passed to tests_passed + 1
    else:
        set tests_failed to tests_failed + 1

    # ===========================================================
    # TEST 8: PII scrubbing Filter
    # ===========================================================
    display "TEST 8: PII scrubbing Filter character scanner"
    set t8_ok to 1
    
    set scrubbed to sync_strip_pii("Contact me at user@domain.com or call 123-456-7890. SSN: 999-88-7777.")
    if string_contains(scrubbed and "[SSN REDACTED]") == 1 and also string_contains(scrubbed and "[EMAIL_REDACTED]") == 1:
        display "  PII Filter redacted email and SSN correctly"
    else:
        display f"  FAIL: Redaction incomplete: '{scrubbed}'"
        set t8_ok to 0
        
    if t8_ok == 1:
        display "  PASS"
        set tests_passed to tests_passed + 1
    else:
        set tests_failed to tests_failed + 1

    # ===========================================================
    # TEST 9: Sleep Cycle simulated LoRA updates
    # ===========================================================
    display "TEST 9: Sleep Cycle simulated SFT/ORPO cycles"
    set t9_ok to 1
    
    set reflection to sleep_cycle(mem)
    if string_length(reflection) > 0:
        display "  Sleep cycle executed and updated persona reflections"
    else:
        display "  FAIL: Reflection text empty"
        set t9_ok to 0
        
    if t9_ok == 1:
        display "  PASS"
        set tests_passed to tests_passed + 1
    else:
        set tests_failed to tests_failed + 1

    # ===========================================================
    # TEST 10: Task Scheduler Actions & Due Logic
    # ===========================================================
    display "TEST 10: Task Scheduler Actions & Due Logic"
    set t10_ok to 1

    # Remove test task JSON if it exists to start fresh
    if file_exists("config/scheduler_jobs.json") == 1:
        set cp_cmd_res to run_command("rm -f config/scheduler_jobs.json")

    # Create a job
    set args_create to create_list()
    set ok to append_list(args_create and "TestTask")
    set ok to append_list(args_create and "Test Instruction")
    set ok to append_list(args_create and "interval")
    set ok to append_list(args_create and "60")
    set create_res to operate_scheduler("create" and args_create)
    free_list(args_create)

    if string_contains(create_res and "Successfully created job") == 1:
        display "  Scheduler task created successfully"
    else:
        display f"  FAIL: Create task returned unexpected: '{create_res}'"
        set t10_ok to 0

    # List jobs
    set args_list to create_list()
    set list_res to operate_scheduler("list" and args_list)
    free_list(args_list)

    if string_contains(list_res and "TestTask") == 1:
        display "  Scheduler task listed successfully"
    else:
        display f"  FAIL: List tasks returned unexpected: '{list_res}'"
        set t10_ok to 0

    # Toggle job
    # First extract job ID
    # TestTask will have ID job_<timestamp>
    set id_pos to string_index_of(list_res and "[job_")
    if id_pos > 0:
        set id_tail to substring(list_res and id_pos + 1 and string_length(list_res) - id_pos - 1)
        set id_end to string_index_of(id_tail and "]")
        set job_id to substring(id_tail and 0 and id_end)
        set args_toggle to create_list()
        set ok to append_list(args_toggle and job_id)
        set toggle_res to operate_scheduler("toggle" and args_toggle)
        free_list(args_toggle)

        if string_contains(toggle_res and "Successfully toggled job") == 1:
            display "  Scheduler task toggled successfully"
        else:
            display f"  FAIL: Toggle task returned unexpected: '{toggle_res}'"
            set t10_ok to 0

        # Check if due logic detects disabled status
        # Load the job
        set jobs to scheduler_load()
        set j_len to length_list(jobs)
        set j_idx to 0
        repeat while j_idx < j_len:
            set job_map to get_list(jobs and j_idx)
            set j_id to map_get_val(job_map and "id")
            if j_id equals job_id:
                # Enabled is 0, so scheduler_is_due should return 0 even if time is due
                set due_val to scheduler_is_due(job_map and 2000000000 and 0)
                if due_val == 0:
                    display "  Due check correctly bypassed disabled job"
                else:
                    display f"  FAIL: Disabled job reported as due! result: {due_val}"
                    set t10_ok to 0
            set j_idx to j_idx + 1
        free_list(jobs)

        # Delete job
        set args_delete to create_list()
        set ok to append_list(args_delete and job_id)
        set delete_res to operate_scheduler("delete" and args_delete)
        free_list(args_delete)

        if string_contains(delete_res and "Successfully deleted job") == 1:
            display "  Scheduler task deleted successfully"
        else:
            display f"  FAIL: Delete task returned unexpected: '{delete_res}'"
            set t10_ok to 0
    else:
        display "  FAIL: Job ID not found in list output"
        set t10_ok to 0

    if t10_ok == 1:
        display "  PASS"
        set tests_passed to tests_passed + 1
    else:
        set tests_failed to tests_failed + 1

    # ===========================================================
    # TEST 11: Multi-Turn ReAct Convergence and Logging
    # ===========================================================
    display "TEST 11: Multi-Turn ReAct Convergence and Logging"
    set t11_ok to 1

    set model_t11 to create_map()
    set tools_mgr_t11 to tools_create("admin")
    set ctx_t11 to create_map()
    set ok to map_insert(ctx_t11 and "is_test" and 1)

    set reply_t11 to react_run(model_t11 and mem and tools_mgr_t11 and ctx_t11 and "CONVERGENCE_TEST")
    if string_contains(reply_t11 and "Success") == 1:
        display "  Multi-turn ReAct self-correction convergence verified successfully"
    else:
        display f"  FAIL: Expected Success, got '{reply_t11}'"
        set t11_ok to 0

    if t11_ok == 1:
        display "  PASS"
        set tests_passed to tests_passed + 1
    else:
        set tests_failed to tests_failed + 1

    # ===========================================================
    # TEST 12: Auto-Approve ReAct Loop Execution
    # ===========================================================
    display "TEST 12: Auto-Approve ReAct Loop Execution"
    set t12_ok to 1

    set model_t12 to create_map()
    set tools_mgr_t12 to tools_create("admin")
    set ctx_t12 to create_map()
    set ok to map_insert(ctx_t12 and "is_test" and 1)

    # 1. Run the loop, it should request approval for money_transfer
    set reply_t12 to react_run(model_t12 and mem and tools_mgr_t12 and ctx_t12 and "AUTO_APPROVE_TEST")
    if reply_t12 equals "PENDING_APPROVAL":
        display "  Bypassed first turn with PENDING_APPROVAL as expected"
        
        # Verify pending action is money_transfer
        set pending to map_get_val(ctx_t12 and "pending_action")
        if pending != 0:
            set p_tool to map_get_val(pending and "tool_name")
            if p_tool equals "money_transfer":
                display f"  Pending action verified: {p_tool}"
            else:
                display f"  FAIL: Expected pending action 'money_transfer', got '{p_tool}'"
                set t12_ok to 0
        else:
            display "  FAIL: Pending action map not found in ctx"
            set t12_ok to 0
            
        # 2. Set auto_approve to 1 in context and call react_resume_approved
        if t12_ok == 1:
            set ok to map_insert(ctx_t12 and "auto_approve" and 1)
            set resume_reply to react_resume_approved(model_t12 and mem and tools_mgr_t12 and ctx_t12 and 1 and 0)
            if string_contains(resume_reply and "Success") == 1:
                display "  Auto-approval successfully handled subsequent tools without prompting"
            else:
                display f"  FAIL: Expected Success from auto-approval, got '{resume_reply}'"
                set t12_ok to 0
    else:
        display f"  FAIL: Expected react_run to return 'PENDING_APPROVAL', got '{reply_t12}'"
        set t12_ok to 0

    if t12_ok == 1:
        display "  PASS"
        set tests_passed to tests_passed + 1
    else:
        set tests_failed to tests_failed + 1

    # ===========================================================
    # TEST 13: Decent GitDec Engine Functions
    # ===========================================================
    display "TEST 13: Decent GitDec Engine Functions"
    set t13_ok to 1

    set keys_pair to generate_signing_keypair()
    set pub_key to map_get_val(keys_pair and "public_key")
    set sec_key to map_get_val(keys_pair and "secret_key")
    set did_val to create_did_key_from_ed25519(pub_key)
    
    set repo_id to "repo_test_123"
    set repo to gitdec_create_repo(repo_id and "TestRepo" and did_val)
    if repo != 0:
        display "  Repository created successfully"
    else:
        display "  FAIL: Repository creation failed"
        set t13_ok to 0

    # Generate collab keys to resolve a real DID
    set collab_keys to generate_signing_keypair()
    set collab_pub to map_get_val(collab_keys and "public_key")
    set collab_did to create_did_key_from_ed25519(collab_pub)
    
    set add_collab_err to gitdec_add_collaborator(repo_id and did_val and collab_did and "writer")
    if add_collab_err == 0:
        display "  Collaborator added successfully"
    else:
        display f"  FAIL: Add collaborator failed, code {add_collab_err}"
        set t13_ok to 0

    # Push commit
    set commit_payload to "commit: initial commit data"
    set sign_res to sign_message(commit_payload and sec_key)
    set signature to map_get_val(sign_res and "signature")
    set push_err to gitdec_push_commit(repo_id and did_val and "main" and "commit_hash_1" and commit_payload and signature)
    if push_err == 0:
        display "  Pushed signed commit successfully"
    else:
        display f"  FAIL: Push commit failed, code {push_err}"
        set t13_ok to 0

    # Pull ref
    set pulled_ref to gitdec_pull_ref(repo_id and "main")
    if pulled_ref equals "commit_hash_1":
        display "  Ref pulled successfully"
    else:
        display f"  FAIL: Pull ref mismatch: got '{pulled_ref}'"
        set t13_ok to 0

    # Get object
    set obj to gitdec_get_object(repo_id and "commit_hash_1")
    if obj equals commit_payload:
        display "  Commit object retrieved successfully"
    else:
        display f"  FAIL: Retrieved object mismatch: got '{obj}'"
        set t13_ok to 0

    # Create issue
    set issue to gitdec_create_issue(repo_id and did_val and "Test Issue" and "Issue Body")
    set issue_id to map_get_val(issue and "id")
    if string_length(issue_id) > 0:
        display "  Issue created successfully"
    else:
        display "  FAIL: Issue creation failed"
        set t13_ok to 0

    # Comment issue
    set comment_err to gitdec_comment_issue(repo_id and issue_id and did_val and "This is a comment")
    if comment_err == 0:
        display "  Issue comment added successfully"
    else:
        display f"  FAIL: Add comment failed, code {comment_err}"
        set t13_ok to 0

    # Create PR
    set pr to gitdec_create_pr(repo_id and did_val and "Test PR" and "feature" and "main" and "PR Description")
    set pr_id to map_get_val(pr and "id")
    if string_length(pr_id) > 0:
        display "  Pull request created successfully"
    else:
        display "  FAIL: Pull request creation failed"
        set t13_ok to 0

    # Review PR
    set review_err to gitdec_review_pr(repo_id and pr_id and did_val and "approve" and "Looks good!")
    if review_err == 0:
        display "  PR approved successfully"
    else:
        display f"  FAIL: PR review failed, code {review_err}"
        set t13_ok to 0

    # Remove collaborator
    set remove_collab_err to gitdec_remove_collaborator(repo_id and did_val and collab_did)
    if remove_collab_err == 0:
        display "  Collaborator removed successfully"
    else:
        display f"  FAIL: Remove collaborator failed, code {remove_collab_err}"
        set t13_ok to 0

    # Delete repository
    set delete_repo_err to gitdec_delete_repo(repo_id and did_val)
    if delete_repo_err == 0:
        display "  Repository deleted successfully"
    else:
        display f"  FAIL: Delete repository failed, code {delete_repo_err}"
        set t13_ok to 0

    if t13_ok == 1:
        display "  PASS"
        set tests_passed to tests_passed + 1
    else:
        set tests_failed to tests_failed + 1

    # ===========================================================
    # TEST 14: Bounded, cancellation-aware run_command execution
    # ===========================================================
    display "TEST 14: Bounded run_command failure, timeout and cancellation feedback"
    set t14_ok to 1

    set tools_mgr_t14 to tools_create("admin")
    set ctx_t14 to create_map()
    set ok to map_insert(ctx_t14 and "sender_role" and "admin")

    set success_args to create_list()
    set ok to append_list(success_args and "printf bounded-ok")
    set success_result to tools_execute(tools_mgr_t14 and ctx_t14 and "run_command" and success_args)
    if string_contains(success_result and "bounded-ok") == 1 and also string_contains(success_result and "failed:") == 0:
        display "  Successful command returns captured output"
    else:
        display f"  FAIL: successful bounded command result: {success_result}"
        set t14_ok to 0

    set failure_args to create_list()
    set ok to append_list(failure_args and "ls /definitely-missing-ernos-run-command-path")
    set failure_result to tools_execute(tools_mgr_t14 and ctx_t14 and "run_command" and failure_args)
    if string_contains(failure_result and "exit status") == 1 and also string_contains(failure_result and "No such file") == 1 and also string_contains(failure_result and "AGENT RECOVERY REQUIRED") == 1 and also string_contains(failure_result and "do not repeat it unchanged") == 1:
        display "  Non-zero exit captures stderr and prompts corrective reasoning"
    else:
        display f"  FAIL: failed command did not carry diagnostic guidance: {failure_result}"
        set t14_ok to 0

    set timeout_args to create_list()
    set ok to append_list(timeout_args and "sleep 3")
    set ok to append_list(timeout_args and ".")
    set ok to append_list(timeout_args and "1")
    set timeout_started to ep_time_now_ms()
    set timeout_result to tools_execute(tools_mgr_t14 and ctx_t14 and "run_command" and timeout_args)
    set timeout_elapsed to ep_time_now_ms() - timeout_started
    if string_contains(timeout_result and "timed out after 1000 ms") == 1 and also string_contains(timeout_result and "AGENT RECOVERY REQUIRED") == 1 and also timeout_elapsed < 2500:
        display "  Timeout terminates promptly and prompts a narrower solution"
    else:
        display f"  FAIL: timeout contract/result elapsed={timeout_elapsed}: {timeout_result}"
        set t14_ok to 0

    # The full process group must die, not only its parent shell. If the descendant
    # survives the timeout it writes this marker two seconds later.
    set marker_path to "/tmp/ernos_bounded_command_descendant_marker"
    set cleanup_before to run_command("rm -f /tmp/ernos_bounded_command_descendant_marker")
    set descendant_epoch to ep_cancel_epoch_get(0)
    set descendant_result to ep_run_command_bounded("sleep 2; printf late > /tmp/ernos_bounded_command_descendant_marker" and 200 and descendant_epoch)
    sleep_ms(2300)
    if string_contains(descendant_result and "timed out") == 1 and also file_exists(marker_path) == 0:
        display "  Timeout kills the complete descendant process group"
    else:
        display f"  FAIL: timed-out descendant survived: {descendant_result}"
        set t14_ok to 0
    set cleanup_after to run_command("rm -f /tmp/ernos_bounded_command_descendant_marker")

    # Cancellation is a separate contract from timeout: an epoch bump must interrupt
    # the blocking tool while it is running, well before its wall-clock deadline.
    set cancel_channel to channel
    set cancel_epoch to ep_cancel_epoch_get(0)
    set cancel_started to ep_time_now_ms()
    spawn bounded_command_cancel_worker(cancel_channel and cancel_epoch)
    sleep_ms(150)
    set ok to ep_cancel_epoch_bump(0)
    set cancel_result to receive from cancel_channel
    set cancel_result_text to ptr_to_str(cancel_result)
    set cancel_elapsed to ep_time_now_ms() - cancel_started
    if string_contains(cancel_result_text and "run_command cancelled") == 1 and also cancel_elapsed < 2000:
        display "  Cancel epoch interrupts the active subprocess group"
    else:
        display f"  FAIL: cancellation contract/result elapsed={cancel_elapsed}: {cancel_result_text}"
        set t14_ok to 0

    if t14_ok == 1:
        display "  PASS"
        set tests_passed to tests_passed + 1
    else:
        set tests_failed to tests_failed + 1

    # ===========================================================
    # TEST 15: Provider-token compaction policy
    # ===========================================================
    display "TEST 15: Provider-token compaction policy"
    set t15_ok to 1
    if session_compaction_threshold(8192) != 6963 or else session_compaction_threshold(262144) != 222822:
        display "  FAIL: compaction point is not exactly 85% of provider context"
        set t15_ok to 0
    if session_should_compress(6962 and 8192) != 0 or else session_should_compress(6963 and 8192) != 1:
        display "  FAIL: exact threshold boundary is incorrect"
        set t15_ok to 0
    if session_context_approaching_compaction(6266 and 8192) != 1 or else session_context_approaching_compaction(6963 and 8192) != 0:
        display "  FAIL: one-shot approach-warning boundary is incorrect"
        set t15_ok to 0
    if session_should_compress(999999 and 0) != 0:
        display "  FAIL: missing provider metadata caused guessed compaction"
        set t15_ok to 0
    if t15_ok == 1:
        display "  8192 -> 6963 and 262144 -> 222822; boundary and warning checks passed"
        display "  PASS"
        set tests_passed to tests_passed + 1
    else:
        set tests_failed to tests_failed + 1

    # ===========================================================
    # TEST 16: Canonical chronological recall across compaction
    # ===========================================================
    display "TEST 16: Canonical chronological recall across compaction"
    set t16_ok to 1
    set t16_sid to concat("rights_recall_" and int_to_string(ep_time_now_ms()))
    set t16_main to concat("config/sessions/" and concat(t16_sid and ".json"))
    set t16_shard to concat("config/sessions/" and concat(t16_sid and "_transcript_0.json"))
    set t16_h1 to ep_sha256("first exact message")
    set t16_h2 to ep_sha256("second exact message")
    set t16_h3 to ep_sha256("third exact message")
    set t16_shard_body to concat("[{\"role\":\"user\",\"content\":\"first exact message\",\"turn_id\":\"1\",\"created_at\":\"101\",\"source_type\":\"direct\",\"source_id\":\"" and t16_sid)
    set t16_shard_body to concat(t16_shard_body and concat("\",\"content_hash\":\"" and concat(t16_h1 and "\"},")))
    set t16_shard_body to concat(t16_shard_body and concat("{\"role\":\"assistant\",\"content\":\"second exact message\",\"turn_id\":\"2\",\"created_at\":\"102\",\"source_type\":\"direct\",\"source_id\":\"" and t16_sid))
    set t16_shard_body to concat(t16_shard_body and concat("\",\"content_hash\":\"" and concat(t16_h2 and "\"}]")))
    set t16_main_body to concat("{\"id\":\"" and t16_sid)
    set t16_main_body to concat(t16_main_body and "\",\"title\":\"Recall Test\",\"model\":\"\",\"system_prompt\":\"\",\"compression_summary\":\"\",\"session_guidance\":\"\",\"next_turn_id\":\"4\",\"messages\":[{\"role\":\"user\",\"content\":\"third exact message\",\"turn_id\":\"3\",\"created_at\":\"103\",\"source_type\":\"direct\",\"source_id\":\"")
    set t16_main_body to concat(t16_main_body and t16_sid)
    set t16_main_body to concat(t16_main_body and "\",\"content_hash\":\"")
    set t16_main_body to concat(t16_main_body and t16_h3)
    set t16_main_body to concat(t16_main_body and "\"}],\"compressed_sessions\":[\"")
    set t16_main_body to concat(t16_main_body and concat(session_json_escape(t16_shard) and "\"]}"))
    if write_file(t16_shard and t16_shard_body) == 0 or else write_file(t16_main and t16_main_body) == 0:
        set t16_ok to 0
        display "  FAIL: recall fixture could not be written"
    else:
        set t16_ctx to create_map()
        set t16_page1 to tools_recall_session_turns(t16_ctx and t16_sid and 1 and 2)
        set t16_page2 to tools_recall_session_turns(t16_ctx and t16_sid and 3 and 2)
        if string_contains(t16_page1 and "start=1; end=2; total=3; has_more=true; next_start=3") == 0 or else string_contains(t16_page1 and "first exact message") == 0 or else string_contains(t16_page1 and t16_h1) == 0:
            set t16_ok to 0
            display concat("  FAIL: first canonical page malformed: " and t16_page1)
        if string_contains(t16_page2 and "start=3; end=3; total=3; has_more=false") == 0 or else string_contains(t16_page2 and "third exact message") == 0 or else string_contains(t16_page2 and t16_h3) == 0:
            set t16_ok to 0
            display concat("  FAIL: second canonical page malformed: " and t16_page2)
    if file_exists(t16_main) == 1:
        set ok to remove_file(t16_main)
    if file_exists(t16_shard) == 1:
        set ok to remove_file(t16_shard)
    if t16_ok == 1:
        display "  Turn 1 through current state recalled in order with paging and provenance"
        display "  PASS"
        set tests_passed to tests_passed + 1
    else:
        set tests_failed to tests_failed + 1

    # ===========================================================
    # TEST 17: Factory reset recreates deleted session storage
    # ===========================================================
    display "TEST 17: Factory live-session reconstruction"
    set t17_ok to 1
    set t17_dir to concat("/tmp/ernos_factory_sessions_" and int_to_string(ep_time_now_ms()))
    set t17_mgr to session_manager_create(t17_dir)
    set t17_old_map to map_get_val(t17_mgr and "sessions")
    set t17_legacy to session_create_new("legacy" and "Legacy" and "" and "")
    set ok to map_insert(t17_old_map and "legacy" and t17_legacy)
    set t17_rc to session_manager_factory_reset(t17_mgr)
    set t17_new_map to map_get_val(t17_mgr and "sessions")
    if t17_rc != 0 or else file_exists(t17_dir) == 0 or else file_exists(path_join(t17_dir and "default.json")) == 0 or else string_equals(read_file(path_join(t17_dir and "active_session.txt")) and "default") == 0:
        display "  FAIL: deleted sessions directory was not durably reconstructed"
        set t17_ok to 0
    if t17_new_map == t17_old_map or else map_contains(t17_new_map and "default") == 0 or else map_contains(t17_new_map and "legacy") == 1 or else string_equals(map_get_val(t17_mgr and "active_session_id") and "default") == 0:
        display "  FAIL: fresh registry was not committed after durable verification"
        set t17_ok to 0
    if file_exists(path_join(t17_dir and "default.json")) == 1:
        set ok to remove_file(path_join(t17_dir and "default.json"))
    if file_exists(path_join(t17_dir and "active_session.txt")) == 1:
        set ok to remove_file(path_join(t17_dir and "active_session.txt"))
    if file_exists(t17_dir) == 1:
        set ok to remove_directory(t17_dir)
    if t17_ok == 1:
        display "  Missing directory recreated; durable files verified before registry swap"
        display "  PASS"
        set tests_passed to tests_passed + 1
    else:
        set tests_failed to tests_failed + 1

    # ===========================================================
    # TEST 18: Public vision boundary and stream-loop evidence gate
    # ===========================================================
    display "TEST 18: Vision privacy boundary and repetition evidence gate"
    set t18_ok to 1
    if (llm_public_content("<think>private analysis</think>Visible description") equals "Visible description") == 0:
        display "  FAIL: completed private reasoning was not removed from public vision text"
        set t18_ok to 0
    if string_length(llm_public_content("<think>unfinished private analysis</think>")) != 0:
        display "  FAIL: reasoning-only vision output became public text"
        set t18_ok to 0
    if (llm_public_content("Visible description") equals "Visible description") == 0:
        display "  FAIL: ordinary final content was changed"
        set t18_ok to 0
    set t18_short_loop to "abcdefghabcdefghabcdefghabcdefghabcdefghabcdefgh"
    if llm_stream_has_repetition(t18_short_loop and "") != 0:
        display "  FAIL: short normal output can still trigger stream cancellation"
        set t18_ok to 0
    set t18_long_loop to ""
    set t18_i to 0
    repeat while t18_i < 33:
        set t18_long_loop to concat(t18_long_loop and "abcdefgh")
        set t18_i to t18_i + 1
    if llm_stream_has_repetition(t18_long_loop and "") != 1:
        display "  FAIL: a sustained 264-character repetition was not detected"
        set t18_ok to 0
    if t18_ok == 1:
        display "  Private reasoning stripped; short false positive rejected; sustained loop detected"
        display "  PASS"
        set tests_passed to tests_passed + 1
    else:
        set tests_failed to tests_failed + 1

    # ===========================================================
    # TEST 19: Incremental one-pass HTTP/SSE framing
    # ===========================================================
    display "TEST 19: Incremental one-pass HTTP/SSE framing"
    set t19_ok to 1
    set t19_line1 to "data: {\"choices\":[{\"delta\":{\"reasoning\":\"why \"}}]}\n\n"
    set t19_line2 to "data: {\"choices\":[{\"delta\":{\"content\":\"done\"}}]}\n\n"
    set t19_line3 to "data: {\"choices\":[],\"usage\":{\"prompt_tokens\":7,\"completion_tokens\":2}}\n\n"
    set t19_done to "data: [DONE]\n\n"
    set t19_wire to "HTTP/1.1 200 OK\r\nContent-Type: text/event-stream\r\nTransfer-Encoding: chunked\r\n\r\n"
    set t19_wire to concat(t19_wire and concat("34\r\n" and concat(t19_line1 and "\r\n")))
    set t19_wire to concat(t19_wire and concat("32\r\n" and concat(t19_line2 and "\r\n")))
    set t19_wire to concat(t19_wire and concat("48\r\n" and concat(t19_line3 and "\r\n")))
    set t19_wire to concat(t19_wire and concat("e\r\n" and concat(t19_done and "\r\n0\r\n\r\n")))
    set t19_decoder to ep_sse_decoder_create()
    set t19_state to create_map()
    set ok to map_insert(t19_state and "content" and "")
    set ok to map_insert(t19_state and "reasoning" and "")
    set ok to map_insert(t19_state and "prompt_tokens" and 0)
    set ok to map_insert(t19_state and "completion_tokens" and 0)
    set t19_a to ep_sse_decoder_feed(t19_decoder and substring(t19_wire and 0 and 19))
    set ok to stream_apply_sse_lines(t19_a and t19_state)
    set t19_b to ep_sse_decoder_feed(t19_decoder and substring(t19_wire and 19 and 73))
    set ok to stream_apply_sse_lines(t19_b and t19_state)
    set t19_c to ep_sse_decoder_feed(t19_decoder and substring(t19_wire and 92 and string_length(t19_wire) - 92))
    set ok to stream_apply_sse_lines(t19_c and t19_state)
    set t19_tail to ep_sse_decoder_finish(t19_decoder)
    set ok to stream_apply_sse_lines(t19_tail and t19_state)
    if ep_sse_decoder_error(t19_decoder) != 0 or else ep_sse_decoder_is_sse(t19_decoder) != 1:
        display "  FAIL: fragmented chunked SSE was not framed"
        set t19_ok to 0
    if (map_get_val(t19_state and "content") equals "done") == 0 or else (map_get_val(t19_state and "reasoning") equals "why ") == 0:
        display "  FAIL: deltas were lost or duplicated across socket fragments"
        set t19_ok to 0
    if map_get_val(t19_state and "prompt_tokens") != 7 or else map_get_val(t19_state and "completion_tokens") != 2:
        display "  FAIL: terminal usage metadata was not preserved"
        set t19_ok to 0
    set ok to ep_sse_decoder_destroy(t19_decoder)
    if t19_ok == 1:
        display "  Fragmented headers, HTTP chunks, SSE lines and usage parsed exactly once"
        display "  PASS"
        set tests_passed to tests_passed + 1
    else:
        set tests_failed to tests_failed + 1

    # ===========================================================
    # TEST 20: Exact discovered filesystem path provenance
    # ===========================================================
    display "TEST 20: Exact discovered filesystem path provenance"
    set t20_ok to 1
    set t20_root to concat("/tmp/ernos_discovered_paths_" and int_to_string(ep_time_now_ms()))
    set t20_dir to path_join(t20_root and "Smithian-Fold-Theory-Of-Everything papers")
    set t20_file to path_join(t20_dir and "UnisonAI_Architecture.md")
    set ok to create_directory(t20_root)
    set ok to create_directory(t20_dir)
    set ok to write_file(t20_file and "exact")
    set t20_ctx to create_map()
    set captured to tools_capture_discovered_paths(t20_ctx and concat(t20_file and "\n"))
    set t20_wrong to path_join(path_join(t20_root and "Smithian_Fold_Theory_Of_Everything_papers") and "UnisonAI_Architecture.md")
    set t20_resolved to tools_resolve_read_path_for_ctx(t20_ctx and t20_wrong)
    if captured != 1 or else (t20_resolved equals t20_file) == 0:
        display f"  FAIL: discovery path was reconstructed instead of preserved: {t20_resolved}"
        set t20_ok to 0
    set ok to remove_file(t20_file)
    set ok to remove_directory(t20_dir)
    set ok to remove_directory(t20_root)
    if t20_ok == 1:
        display "  Hyphens, underscores and spaces remain byte-exact after discovery"
        display "  PASS"
        set tests_passed to tests_passed + 1
    else:
        set tests_failed to tests_failed + 1

    # ===========================================================
    # Summary
    # ===========================================================
    display ""
    display "==================================================="
    set total to tests_passed + tests_failed
    display f"  {tests_passed}/{total} cognitive agent tests passed."
    if tests_failed > 0:
        display f"  {tests_failed} FAILED!"
        exit_program(1)
    else:
        display "  ALL COGNITIVE AGENT TESTS PASSED!"
    display "==================================================="
    return 0
