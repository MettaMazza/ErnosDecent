    set sign_res to sign_message(commit_payload and sec_key)
    set signature to map_get_val(sign_res and "signature")
    set push_err to gitdec_push_commit(repo_id and did_val and "main" and "commit_hash_1" and commit_payload and signature)
    if push_err == 0:
        display "  Pushed signed commit successfully"
    else:
        display f"  FAIL: Push commit failed, code {push_err}"
        set t13_ok to 0

    # Pull ref
    set pulled_ref to gitdec_pull_ref(repo_id and "main")
    if pulled_ref equals "commit_hash_1":
        display "  Ref pulled successfully"
    else:
        display f"  FAIL: Pull ref mismatch: got '{pulled_ref}'"
        set t13_ok to 0

    # Get object
    set obj to gitdec_get_object(repo_id and "commit_hash_1")
    if obj equals commit_payload:
        display "  Commit object retrieved successfully"
    else:
        display f"  FAIL: Retrieved object mismatch: got '{obj}'"
        set t13_ok to 0

    # Create issue
    set issue to gitdec_create_issue(repo_id and did_val and "Test Issue" and "Issue Body")
    set issue_id to map_get_val(issue and "id")
    if string_length(issue_id) > 0:
        display "  Issue created successfully"
    else:
        display "  FAIL: Issue creation failed"
        set t13_ok to 0

    # Comment issue
    set comment_err to gitdec_comment_issue(repo_id and issue_id and did_val and "This is a comment")
    if comment_err == 0:
        display "  Issue comment added successfully"
    else:
        display f"  FAIL: Add comment failed, code {comment_err}"
        set t13_ok to 0

    # Create PR
    set pr to gitdec_create_pr(repo_id and did_val and "Test PR" and "feature" and "main" and "PR Description")
    set pr_id to map_get_val(pr and "id")
    if string_length(pr_id) > 0:
        display "  Pull request created successfully"
    else:
        display "  FAIL: Pull request creation failed"
        set t13_ok to 0

    # Review PR
    set review_err to gitdec_review_pr(repo_id and pr_id and did_val and "approve" and "Looks good!")
    if review_err == 0:
        display "  PR approved successfully"
    else:
        display f"  FAIL: PR review failed, code {review_err}"
        set t13_ok to 0

    # Remove collaborator
    set remove_collab_err to gitdec_remove_collaborator(repo_id and did_val and collab_did)
    if remove_collab_err == 0:
        display "  Collaborator removed successfully"
    else:
        display f"  FAIL: Remove collaborator failed, code {remove_collab_err}"
        set t13_ok to 0

    # Delete repository
    set delete_repo_err to gitdec_delete_repo(repo_id and did_val)
    if delete_repo_err == 0:
        display "  Repository deleted successfully"
    else:
        display f"  FAIL: Delete repository failed, code {delete_repo_err}"
        set t13_ok to 0

    if t13_ok == 1:
        display "  PASS"
        set tests_passed to tests_passed + 1
    else:
        set tests_failed to tests_failed + 1

    # ===========================================================
    # TEST 14: Bounded, cancellation-aware run_command execution
    # ===========================================================
    display "TEST 14: Bounded run_command failure, timeout and cancellation feedback"
    set t14_ok to 1

    set tools_mgr_t14 to tools_create("admin")
    set ctx_t14 to create_map()
    set ok to map_insert(ctx_t14 and "sender_role" and "admin")

    set success_args to create_list()
    set ok to append_list(success_args and "printf bounded-ok")
    set success_result to tools_execute(tools_mgr_t14 and ctx_t14 and "run_command" and success_args)
    if string_contains(success_result and "bounded-ok") == 1 and also string_contains(success_result and "failed:") == 0:
        display "  Successful command returns captured output"
    else:
        display f"  FAIL: successful bounded command result: {success_result}"
        set t14_ok to 0

    set failure_args to create_list()
    set ok to append_list(failure_args and "ls /definitely-missing-ernos-run-command-path")
    set failure_result to tools_execute(tools_mgr_t14 and ctx_t14 and "run_command" and failure_args)
    if string_contains(failure_result and "exit status") == 1 and also string_contains(failure_result and "No such file") == 1 and also string_contains(failure_result and "AGENT RECOVERY REQUIRED") == 1 and also string_contains(failure_result and "do not repeat it unchanged") == 1:
        display "  Non-zero exit captures stderr and prompts corrective reasoning"
    else:
        display f"  FAIL: failed command did not carry diagnostic guidance: {failure_result}"
        set t14_ok to 0

    set timeout_args to create_list()
    set ok to append_list(timeout_args and "sleep 3")
    set ok to append_list(timeout_args and ".")
    set ok to append_list(timeout_args and "1")
    set timeout_started to ep_time_now_ms()
    set timeout_result to tools_execute(tools_mgr_t14 and ctx_t14 and "run_command" and timeout_args)
    set timeout_elapsed to ep_time_now_ms() - timeout_started
    if string_contains(timeout_result and "timed out after 1000 ms") == 1 and also string_contains(timeout_result and "AGENT RECOVERY REQUIRED") == 1 and also timeout_elapsed < 2500:
        display "  Timeout terminates promptly and prompts a narrower solution"
    else:
        display f"  FAIL: timeout contract/result elapsed={timeout_elapsed}: {timeout_result}"
        set t14_ok to 0

    # The full process group must die, not only its parent shell. If the descendant
    # survives the timeout it writes this marker two seconds later.
    set marker_path to "/tmp/ernos_bounded_command_descendant_marker"
    set cleanup_before to run_command("rm -f /tmp/ernos_bounded_command_descendant_marker")
    set descendant_epoch to ep_cancel_epoch_get(0)
    set descendant_result to ep_run_command_bounded("sleep 2; printf late > /tmp/ernos_bounded_command_descendant_marker" and 200 and descendant_epoch)
    sleep_ms(2300)
    if string_contains(descendant_result and "timed out") == 1 and also file_exists(marker_path) == 0:
        display "  Timeout kills the complete descendant process group"
    else:
        display f"  FAIL: timed-out descendant survived: {descendant_result}"
        set t14_ok to 0
    set cleanup_after to run_command("rm -f /tmp/ernos_bounded_command_descendant_marker")

    # Cancellation is a separate contract from timeout: an epoch bump must interrupt
    # the blocking tool while it is running, well before its wall-clock deadline.
    set cancel_channel to channel
    set cancel_epoch to ep_cancel_epoch_get(0)
    set cancel_started to ep_time_now_ms()
    spawn bounded_command_cancel_worker(cancel_channel and cancel_epoch)
    sleep_ms(150)
    set ok to ep_cancel_epoch_bump(0)
    set cancel_result to receive from cancel_channel
    set cancel_result_text to ptr_to_str(cancel_result)
    set cancel_elapsed to ep_time_now_ms() - cancel_started
    if string_contains(cancel_result_text and "run_command cancelled") == 1 and also cancel_elapsed < 2000:
        display "  Cancel epoch interrupts the active subprocess group"
    else:
        display f"  FAIL: cancellation contract/result elapsed={cancel_elapsed}: {cancel_result_text}"
        set t14_ok to 0

    if t14_ok == 1:
        display "  PASS"
        set tests_passed to tests_passed + 1
    else:
        set tests_failed to tests_failed + 1

    # ===========================================================
    # TEST 15: Provider-token compaction policy
    # ===========================================================
    display "TEST 15: Provider-token compaction policy"
    set t15_ok to 1
    if session_compaction_threshold(8192) != 6963 or else session_compaction_threshold(262144) != 222822:
        display "  FAIL: compaction point is not exactly 85% of provider context"
        set t15_ok to 0
    if session_should_compress(6962 and 8192) != 0 or else session_should_compress(6963 and 8192) != 1:
        display "  FAIL: exact threshold boundary is incorrect"
        set t15_ok to 0
    if session_context_approaching_compaction(6266 and 8192) != 1 or else session_context_approaching_compaction(6963 and 8192) != 0:
        display "  FAIL: one-shot approach-warning boundary is incorrect"
        set t15_ok to 0
    if session_should_compress(999999 and 0) != 0:
        display "  FAIL: missing provider metadata caused guessed compaction"
        set t15_ok to 0
    if t15_ok == 1:
        display "  8192 -> 6963 and 262144 -> 222822; boundary and warning checks passed"
        display "  PASS"
        set tests_passed to tests_passed + 1
    else:
        set tests_failed to tests_failed + 1

    # ===========================================================
    # TEST 16: Canonical chronological recall across compaction
    # ===========================================================
    display "TEST 16: Canonical chronological recall across compaction"
    set t16_ok to 1
    set t16_sid to concat("rights_recall_" and int_to_string(ep_time_now_ms()))
    set t16_main to concat("config/sessions/" and concat(t16_sid and ".json"))
    set t16_shard to concat("config/sessions/" and concat(t16_sid and "_transcript_0.json"))
    set t16_h1 to ep_sha256("first exact message")
    set t16_h2 to ep_sha256("second exact message")
    set t16_h3 to ep_sha256("third exact message")
    set t16_shard_body to concat("[{\"role\":\"user\",\"content\":\"first exact message\",\"turn_id\":\"1\",\"created_at\":\"101\",\"source_type\":\"direct\",\"source_id\":\"" and t16_sid)
    set t16_shard_body to concat(t16_shard_body and concat("\",\"content_hash\":\"" and concat(t16_h1 and "\"},")))
    set t16_shard_body to concat(t16_shard_body and concat("{\"role\":\"assistant\",\"content\":\"second exact message\",\"turn_id\":\"2\",\"created_at\":\"102\",\"source_type\":\"direct\",\"source_id\":\"" and t16_sid))
    set t16_shard_body to concat(t16_shard_body and concat("\",\"content_hash\":\"" and concat(t16_h2 and "\"}]")))
    set t16_main_body to concat("{\"id\":\"" and t16_sid)
    set t16_main_body to concat(t16_main_body and "\",\"title\":\"Recall Test\",\"model\":\"\",\"system_prompt\":\"\",\"compression_summary\":\"\",\"session_guidance\":\"\",\"next_turn_id\":\"4\",\"messages\":[{\"role\":\"user\",\"content\":\"third exact message\",\"turn_id\":\"3\",\"created_at\":\"103\",\"source_type\":\"direct\",\"source_id\":\"")
    set t16_main_body to concat(t16_main_body and t16_sid)
    set t16_main_body to concat(t16_main_body and "\",\"content_hash\":\"")
    set t16_main_body to concat(t16_main_body and t16_h3)
    set t16_main_body to concat(t16_main_body and "\"}],\"compressed_sessions\":[\"")
    set t16_main_body to concat(t16_main_body and concat(session_json_escape(t16_shard) and "\"]}"))
    if write_file(t16_shard and t16_shard_body) == 0 or else write_file(t16_main and t16_main_body) == 0:
        set t16_ok to 0
        display "  FAIL: recall fixture could not be written"
    else:
        set t16_ctx to create_map()
        set t16_page1 to tools_recall_session_turns(t16_ctx and t16_sid and 1 and 2)
        set t16_page2 to tools_recall_session_turns(t16_ctx and t16_sid and 3 and 2)
        if string_contains(t16_page1 and "start=1; end=2; total=3; has_more=true; next_start=3") == 0 or else string_contains(t16_page1 and "first exact message") == 0 or else string_contains(t16_page1 and t16_h1) == 0:
            set t16_ok to 0
            display concat("  FAIL: first canonical page malformed: " and t16_page1)
        if string_contains(t16_page2 and "start=3; end=3; total=3; has_more=false") == 0 or else string_contains(t16_page2 and "third exact message") == 0 or else string_contains(t16_page2 and t16_h3) == 0:
            set t16_ok to 0
            display concat("  FAIL: second canonical page malformed: " and t16_page2)
    if file_exists(t16_main) == 1:
        set ok to remove_file(t16_main)
    if file_exists(t16_shard) == 1:
        set ok to remove_file(t16_shard)
    if t16_ok == 1:
        display "  Turn 1 through current state recalled in order with paging and provenance"
        display "  PASS"
        set tests_passed to tests_passed + 1
    else:
        set tests_failed to tests_failed + 1

    # ===========================================================
    # TEST 17: Factory reset recreates deleted session storage
    # ===========================================================
    display "TEST 17: Factory live-session reconstruction"
    set t17_ok to 1
    set t17_dir to concat("/tmp/ernos_factory_sessions_" and int_to_string(ep_time_now_ms()))
    set t17_mgr to session_manager_create(t17_dir)
    set t17_old_map to map_get_val(t17_mgr and "sessions")
    set t17_legacy to session_create_new("legacy" and "Legacy" and "" and "")
    set ok to map_insert(t17_old_map and "legacy" and t17_legacy)
    set t17_rc to session_manager_factory_reset(t17_mgr)
    set t17_new_map to map_get_val(t17_mgr and "sessions")
    if t17_rc != 0 or else file_exists(t17_dir) == 0 or else file_exists(path_join(t17_dir and "default.json")) == 0 or else string_equals(read_file(path_join(t17_dir and "active_session.txt")) and "default") == 0:
        display "  FAIL: deleted sessions directory was not durably reconstructed"
        set t17_ok to 0
    if t17_new_map == t17_old_map or else map_contains(t17_new_map and "default") == 0 or else map_contains(t17_new_map and "legacy") == 1 or else string_equals(map_get_val(t17_mgr and "active_session_id") and "default") == 0:
        display "  FAIL: fresh registry was not committed after durable verification"
        set t17_ok to 0
    if file_exists(path_join(t17_dir and "default.json")) == 1:
        set ok to remove_file(path_join(t17_dir and "default.json"))
    if file_exists(path_join(t17_dir and "active_session.txt")) == 1:
        set ok to remove_file(path_join(t17_dir and "active_session.txt"))
    if file_exists(t17_dir) == 1:
        set ok to remove_directory(t17_dir)
    if t17_ok == 1:
        display "  Missing directory recreated; durable files verified before registry swap"
        display "  PASS"
        set tests_passed to tests_passed + 1
    else:
        set tests_failed to tests_failed + 1

    # ===========================================================
    # TEST 18: Public vision boundary and stream-loop evidence gate
    # ===========================================================
    display "TEST 18: Vision privacy boundary and repetition evidence gate"
    set t18_ok to 1
    if (llm_public_content("<think>private analysis</think>Visible description") equals "Visible description") == 0:
        display "  FAIL: completed private reasoning was not removed from public vision text"
        set t18_ok to 0
    if string_length(llm_public_content("<think>unfinished private analysis</think>")) != 0:
        display "  FAIL: reasoning-only vision output became public text"
        set t18_ok to 0
    if (llm_public_content("Visible description") equals "Visible description") == 0:
        display "  FAIL: ordinary final content was changed"
        set t18_ok to 0
    set t18_short_loop to "abcdefghabcdefghabcdefghabcdefghabcdefghabcdefgh"
    if llm_stream_has_repetition(t18_short_loop and "") != 0:
        display "  FAIL: short normal output can still trigger stream cancellation"
        set t18_ok to 0
    set t18_long_loop to ""
    set t18_i to 0
    repeat while t18_i < 33:
        set t18_long_loop to concat(t18_long_loop and "abcdefgh")
        set t18_i to t18_i + 1
    if llm_stream_has_repetition(t18_long_loop and "") != 1:
        display "  FAIL: a sustained 264-character repetition was not detected"
        set t18_ok to 0
    set t18_hive_unit to "This reasoning segment keeps returning to the same obsolete diagnosis instead of using the authoritative current failure. "
    set t18_hive_spiral to concat(t18_hive_unit and concat("brief separator " and concat(t18_hive_unit and concat("another separator " and t18_hive_unit))))
    if detect_hive_thought_spiral(t18_hive_spiral) != 1:
        display "  FAIL: HIVE-compatible non-consecutive thought spiral was not detected"
        set t18_ok to 0
    if t18_ok == 1:
        display "  Private reasoning stripped; short false positive rejected; sustained loop detected"
        display "  PASS"
        set tests_passed to tests_passed + 1
    else:
        set tests_failed to tests_failed + 1

    # ===========================================================
    # TEST 19: Incremental one-pass HTTP/SSE framing
    # ===========================================================
    display "TEST 19: Incremental one-pass HTTP/SSE framing"
    set t19_ok to 1
    set t19_line1 to "data: {\"choices\":[{\"delta\":{\"reasoning\":\"why \"}}]}\n\n"
    set t19_line2 to "data: {\"choices\":[{\"delta\":{\"content\":\"done\"}}]}\n\n"
    set t19_line3 to "data: {\"choices\":[],\"usage\":{\"prompt_tokens\":7,\"completion_tokens\":2}}\n\n"
    set t19_done to "data: [DONE]\n\n"
    set t19_wire to "HTTP/1.1 200 OK\r\nContent-Type: text/event-stream\r\nTransfer-Encoding: chunked\r\n\r\n"
    set t19_wire to concat(t19_wire and concat("34\r\n" and concat(t19_line1 and "\r\n")))
    set t19_wire to concat(t19_wire and concat("32\r\n" and concat(t19_line2 and "\r\n")))
    set t19_wire to concat(t19_wire and concat("48\r\n" and concat(t19_line3 and "\r\n")))
    set t19_wire to concat(t19_wire and concat("e\r\n" and concat(t19_done and "\r\n0\r\n\r\n")))
    set t19_decoder to ep_sse_decoder_create()
    set t19_state to create_map()
    set ok to map_insert(t19_state and "content" and "")
    set ok to map_insert(t19_state and "reasoning" and "")
    set ok to map_insert(t19_state and "prompt_tokens" and 0)
    set ok to map_insert(t19_state and "completion_tokens" and 0)
    set t19_a to ep_sse_decoder_feed(t19_decoder and substring(t19_wire and 0 and 19))
    set ok to stream_apply_sse_lines(t19_a and t19_state)
    set t19_b to ep_sse_decoder_feed(t19_decoder and substring(t19_wire and 19 and 73))
    set ok to stream_apply_sse_lines(t19_b and t19_state)
    set t19_c to ep_sse_decoder_feed(t19_decoder and substring(t19_wire and 92 and string_length(t19_wire) - 92))
    set ok to stream_apply_sse_lines(t19_c and t19_state)
    set t19_tail to ep_sse_decoder_finish(t19_decoder)
    set ok to stream_apply_sse_lines(t19_tail and t19_state)
    if ep_sse_decoder_error(t19_decoder) != 0 or else ep_sse_decoder_is_sse(t19_decoder) != 1:
        display "  FAIL: fragmented chunked SSE was not framed"
        set t19_ok to 0
    if (map_get_val(t19_state and "content") equals "done") == 0 or else (map_get_val(t19_state and "reasoning") equals "why ") == 0:
        display "  FAIL: deltas were lost or duplicated across socket fragments"
        set t19_ok to 0
    if map_get_val(t19_state and "prompt_tokens") != 7 or else map_get_val(t19_state and "completion_tokens") != 2:
        display "  FAIL: terminal usage metadata was not preserved"
        set t19_ok to 0
    set ok to ep_sse_decoder_destroy(t19_decoder)
    if t19_ok == 1:
        display "  Fragmented headers, HTTP chunks, SSE lines and usage parsed exactly once"
        display "  PASS"
        set tests_passed to tests_passed + 1
    else:
        set tests_failed to tests_failed + 1

    # ===========================================================
    # TEST 20: Exact discovered filesystem path provenance
    # ===========================================================
    display "TEST 20: Exact discovered filesystem path provenance"
    set t20_ok to 1
    set t20_root to concat("/tmp/ernos_discovered_paths_" and int_to_string(ep_time_now_ms()))
    set t20_dir to path_join(t20_root and "Smithian-Fold-Theory-Of-Everything papers")
    set t20_file to path_join(t20_dir and "UnisonAI_Architecture.md")
    set ok to create_directory(t20_root)
    set ok to create_directory(t20_dir)
    set ok to write_file(t20_file and "exact")
    set t20_ctx to create_map()
    set captured to tools_capture_discovered_paths(t20_ctx and concat(t20_file and "\n"))
    set t20_wrong to path_join(path_join(t20_root and "Smithian_Fold_Theory_Of_Everything_papers") and "UnisonAI_Architecture.md")
    set t20_resolved to tools_resolve_read_path_for_ctx(t20_ctx and t20_wrong)
    if captured != 1 or else (t20_resolved equals t20_file) == 0:
        display f"  FAIL: discovery path was reconstructed instead of preserved: {t20_resolved}"
        set t20_ok to 0
    set ok to remove_file(t20_file)
    set ok to remove_directory(t20_dir)
    set ok to remove_directory(t20_root)
    if t20_ok == 1:
        display "  Hyphens, underscores and spaces remain byte-exact after discovery"
        display "  PASS"
        set tests_passed to tests_passed + 1
    else:
        set tests_failed to tests_failed + 1

    # ===========================================================
    # TEST 21: Trusted current-interlocutor identity + account memory isolation
    # ===========================================================
    display "TEST 21: Current interaction identity and account-scoped relationship memory"
    set t21_ok to 1
    set t21_identity to create_map()
    set ok to map_insert(t21_identity and "did" and "did:key:echo-test")
    set t21_alice to create_map()
    set ok to map_insert(t21_alice and "identity" and t21_identity)
    set ok to map_insert(t21_alice and "platform" and "discord")
    set ok to map_insert(t21_alice and "session_id" and "identity-test")
    set ok to map_insert(t21_alice and "selected_model" and "gemma4-test")
    set ok to map_insert(t21_alice and "actor_id" and "111")
    set ok to map_insert(t21_alice and "actor_username" and "alice_account")
    set ok to map_insert(t21_alice and "actor_display_name" and "Alice")
    set ok to map_insert(t21_alice and "actor_type" and "human")
    set ok to map_insert(t21_alice and "actor_is_host" and "no")
    set ok to map_insert(t21_alice and "sender_role" and "admin")
    set t21_bob to create_map()
    set ok to map_insert(t21_bob and "platform" and "discord")
    set ok to map_insert(t21_bob and "actor_id" and "222")
    set t21_block to prompt_interaction_identity_block(t21_alice)
    if string_contains(t21_block and "display=Alice") == 0 or else string_contains(t21_block and "stable_id=111") == 0:
        display "  FAIL: the trusted account identity was absent from the prompt block"
        set t21_ok to 0
    if string_contains(t21_block and "authorization_role=admin") == 0 or else string_contains(t21_block and "does NOT match the configured host account") == 0:
        display "  FAIL: authorization was collapsed into personal/host identity"
        set t21_ok to 0
    if prompt_user_knowledge_scope(t21_alice) equals prompt_user_knowledge_scope(t21_bob):
        display "  FAIL: distinct Discord accounts resolved to the same relationship memory scope"
        set t21_ok to 0
    if t21_ok == 1:
        display "  Self, surface, account and host relation are explicit; account memories are isolated"
        display "  PASS"
        set tests_passed to tests_passed + 1
    else:
        set tests_failed to tests_failed + 1

    # ===========================================================
    # TEST 22: Historical turns retain authenticated speaker provenance
    # ===========================================================
    display "TEST 22: Multi-user session speaker provenance"
    set t22_ok to 1
    set t22_sid to concat("speaker_provenance_" and int_to_string(ep_time_now_ms()))
    set t22_path to concat("config/sessions/" and concat(t22_sid and ".json"))
    set t22_sess to session_create_new(t22_sid and "Speaker Provenance" and "gemma4-test" and "")
    set t22_ctx to create_map()
    set ok to map_insert(t22_ctx and "platform" and "discord")
    set ok to map_insert(t22_ctx and "actor_id" and "214561307385397250")
    set ok to map_insert(t22_ctx and "actor_username" and "sunglancing")
    set ok to map_insert(t22_ctx and "actor_display_name" and "ultraviolet")
    set ok to map_insert(t22_ctx and "actor_type" and "human")
    set ok to map_insert(t22_ctx and "actor_is_host" and "no")
    set ok to map_insert(t22_ctx and "sender_role" and "guest")
    set ok to map_insert(t22_ctx and "guild_name" and "ErnosLabs")
    set ok to session_add_message_with_context(t22_sess and "user" and "hello echo" and t22_ctx)
    set ok to session_add_message(t22_sess and "assistant" and "hello ultraviolet")
    set t22_messages to map_get_val(t22_sess and "messages")
    set t22_first to get_list(t22_messages and 0)
    set t22_label to session_message_speaker_label(t22_first)
    if string_contains(t22_label and "display=ultraviolet") == 0 or else string_contains(t22_label and "username=sunglancing") == 0 or else string_contains(t22_label and "stable_id=214561307385397250") == 0 or else string_contains(t22_label and "host_match=no") == 0:
        display concat("  FAIL: live message speaker label is incomplete: " and t22_label)
        set t22_ok to 0
