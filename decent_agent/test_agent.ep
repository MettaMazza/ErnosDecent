    # Load it back using memory_deserialize
    set loaded_mem to memory_deserialize(test_path)
    if loaded_mem != 0:
        # Check scratchpad
        set l_scratchpad to map_get_val(loaded_mem and "scratchpad")
        if map_contains(l_scratchpad and "key_scratch") == 1:
            set val to map_get_val(l_scratchpad and "key_scratch")
            if val equals "val_scratch":
                display "  Deserialized scratchpad value successfully"
            else:
                display f"  FAIL: Expected val_scratch, got {val}"
