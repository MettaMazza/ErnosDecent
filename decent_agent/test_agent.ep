    set collab_pub to map_get_val(collab_keys and "public_key")
    set collab_did to create_did_key_from_ed25519(collab_pub)
    
    set add_collab_err to gitdec_add_collaborator(repo_id and did_val and collab_did and "writer")
    if add_collab_err == 0:
        display "  Collaborator added successfully"
    else:
        display f"  FAIL: Add collaborator failed, code {add_collab_err}"
        set t13_ok to 0

