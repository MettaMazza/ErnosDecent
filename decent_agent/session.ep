# ErnosPlain Rebuild of ErnOS Agent Session Manager
# Component: decent_agent/session.ep

import "fs"
import "json"
import "collections"
import "string"
import "./workspace_links"
import "./rights"
import "../storage"
import "../decent_store/continuity"

# Ownership bridge supplied by the generated runtime. A manager retains the created
# session Map; lifecycle helpers carry only an integer handle/borrow so an IPC-local
# owner cannot free the manager's live value on return.
external define cast_map_to_int with m returning Int
external define cast_borrow_to_map with b returning Map

# ---- JSON escaping helper ----
define session_json_escape with s as Str returning Str:
    set len to string_length(s)
    set result_list to create_list()
    set i to 0
    repeat while i < len:
        set ch to get_character(s and i)
        if ch == 34: # "
            set ok to append_list(result_list and 92)
            set ok to append_list(result_list and 34)
        else:
            if ch == 92: # \
                set ok to append_list(result_list and 92)
                set ok to append_list(result_list and 92)
            else:
                if ch == 10: # \n
                    set ok to append_list(result_list and 92)
                    set ok to append_list(result_list and 110)
                else:
                    if ch == 13: # \r
                        set ok to append_list(result_list and 92)
                        set ok to append_list(result_list and 114)
                    else:
                        if ch == 9: # \t
                            set ok to append_list(result_list and 92)
                            set ok to append_list(result_list and 116)
                        else:
                            set ok to append_list(result_list and ch)
        set i to i + 1
    set escaped to string_from_list(result_list)
    free_list(result_list)
    return escaped

# ---- Create session Map ----
define session_create_new with id as Str and title as Str and model as Str and system_prompt as Str returning Map:
    set sess to create_map()
    set ok to map_insert(sess and "id" and id)
    set ok to map_insert(sess and "title" and title)
    set ok to map_insert(sess and "model" and model)
    set ok to map_insert(sess and "system_prompt" and system_prompt)
    set ok to map_insert(sess and "created_at" and int_to_string(ep_time_now_sec()))
    set ok to map_insert(sess and "messages" and create_list())
    set ok to map_insert(sess and "compressed_sessions" and create_list())
    set ok to map_insert(sess and "next_turn_id" and "1")
    return sess

# Return a durable session creation instant. Sessions created before this field was
# introduced are migrated from their earliest trustworthy message timestamp; an
# empty legacy session begins at the migration instant rather than inventing history.
define session_created_at with sess as Map returning Int:
    if map_contains(sess and "created_at") == 1:
        set stored to string_to_int(ptr_to_str(map_get_val(sess and "created_at")))
        if stored > 0:
            return stored
    set earliest to 0
    if map_contains(sess and "messages") == 1:
        set messages_list to map_get_val(sess and "messages")
        set i to 0
        repeat while i < length_list(messages_list):
            set msg_map to get_list(messages_list and i)
            if map_contains(msg_map and "created_at") == 1:
                set candidate to string_to_int(ptr_to_str(map_get_val(msg_map and "created_at")))
                if candidate > 0:
                    if earliest == 0 or else candidate < earliest:
                        set earliest to candidate
            set i to i + 1
    if earliest == 0:
        set earliest to ep_time_now_sec()
    set ok to map_insert(sess and "created_at" and int_to_string(earliest))
    return earliest

# ---- Add message helper ----
define session_add_message with sess as Map and role as Str and content as Str returning Int:
    set messages_list to map_get_val(sess and "messages")
    set msg_map to create_map()
    set turn_id to 1
    if map_contains(sess and "next_turn_id") == 1:
        set turn_id to string_to_int(ptr_to_str(map_get_val(sess and "next_turn_id")))
    if turn_id <= 0:
        set turn_id to length_list(messages_list) + 1
    set ok to map_insert(msg_map and "role" and role)
    set ok to map_insert(msg_map and "content" and content)
    set ok to map_insert(msg_map and "turn_id" and int_to_string(turn_id))
    set ok to map_insert(msg_map and "created_at" and int_to_string(ep_time_now_sec()))
    set ok to map_insert(msg_map and "source_type" and "direct")
    set ok to map_insert(msg_map and "source_id" and map_get_val(sess and "id"))
    set ok to map_insert(msg_map and "content_hash" and ep_sha256(content))
    set ok to append_list(messages_list and msg_map)
    set ok to map_insert(sess and "next_turn_id" and int_to_string(turn_id + 1))
    return 0

# Authenticated interaction identity is message provenance, not merely current-turn
# prompt decoration. Copy only the runtime-owned fields that identify the speaker and
# surface; never persist arbitrary context-map keys into the transcript.
define session_actor_provenance_keys returning List:
    set keys to create_list()
    set ok to append_list(keys and "platform")
    set ok to append_list(keys and "actor_id")
    set ok to append_list(keys and "actor_username")
    set ok to append_list(keys and "actor_global_name")
    set ok to append_list(keys and "actor_display_name")
    set ok to append_list(keys and "actor_type")
    set ok to append_list(keys and "actor_is_host")
    set ok to append_list(keys and "sender_role")
    set ok to append_list(keys and "guild_id")
    set ok to append_list(keys and "guild_name")
    set ok to append_list(keys and "channel_name")
    set ok to append_list(keys and "thread_id")
    set ok to append_list(keys and "thread_name")
    return keys

define session_copy_actor_provenance with target as Map and source as Map returning Int:
    set keys to session_actor_provenance_keys()
    set i to 0
    repeat while i < length_list(keys):
        set key to ptr_to_str(get_list(keys and i))
        if map_contains(source and key) == 1:
            set value to ptr_to_str(map_get_val(source and key))
            if string_length(value) > 0:
                set ok to map_insert(target and key and value)
        set i to i + 1
    free_list(keys)
    return 0

define session_add_message_with_context with sess as Map and role as Str and content as Str and ctx as Map returning Int:
    set rc to session_add_message(sess and role and content)
    if rc != 0:
        return rc
    set messages_list to map_get_val(sess and "messages")
    set count to length_list(messages_list)
    if count <= 0:
        return 1
    set msg_map to get_list(messages_list and count - 1)
    set provenance_rc to session_copy_actor_provenance(msg_map and ctx)
    if provenance_rc != 0:
        return provenance_rc
    # Bind the persisted message to the runtime's request-acceptance instant rather
    # than a later prompt/tool timestamp. Only the trusted turn context can supply it.
    if map_contains(ctx and "turn_received_at") == 1:
        set received_at to map_get_val(ctx and "turn_received_at")
        if received_at > 0:
            set ok to map_insert(msg_map and "created_at" and int_to_string(received_at))
    return 0

define session_actor_json_fields with msg_map as Map and separator as Str and indent as Str returning Str:
    set out to ""
    set keys to session_actor_provenance_keys()
    set i to 0
    repeat while i < length_list(keys):
        set key to ptr_to_str(get_list(keys and i))
        if map_contains(msg_map and key) == 1:
            set value to ptr_to_str(map_get_val(msg_map and key))
            if string_length(value) > 0:
                set out to concat(out and separator)
                set out to concat(out and indent)
                set out to concat(out and concat("\"" and concat(key and "\":\"")))
                set out to concat(out and concat(session_json_escape(value) and "\""))
        set i to i + 1
    free_list(keys)
    return out

define session_load_actor_provenance with msg_map as Map and item_node as Int returning Int:
    set keys to session_actor_provenance_keys()
    set i to 0
    repeat while i < length_list(keys):
        set key to ptr_to_str(get_list(keys and i))
        set field_node to get_json_object_value(item_node and key)
        if field_node != 0:
            set value to ptr_to_str(get_json_value(field_node))
            if string_length(value) > 0:
                set ok to map_insert(msg_map and key and value)
        set i to i + 1
    free_list(keys)
    return 0

# Render an unambiguous historical speaker label. Legacy turns remain explicitly
# unknown rather than inheriting the identity attached to the current request.
define session_message_speaker_label with msg_map as Map returning Str:
    set label to "User"
    set has_identity to 0
    set details to ""
    if map_contains(msg_map and "actor_display_name") == 1:
        set display_name to ptr_to_str(map_get_val(msg_map and "actor_display_name"))
        if string_length(display_name) > 0:
            set details to concat(details and concat("display=" and display_name))
            set has_identity to 1
    if map_contains(msg_map and "actor_username") == 1:
        set username to ptr_to_str(map_get_val(msg_map and "actor_username"))
        if string_length(username) > 0:
            if string_length(details) > 0:
                set details to concat(details and "; ")
            set details to concat(details and concat("username=" and username))
            set has_identity to 1
    if map_contains(msg_map and "actor_id") == 1:
        set actor_id to ptr_to_str(map_get_val(msg_map and "actor_id"))
        if string_length(actor_id) > 0:
            if string_length(details) > 0:
                set details to concat(details and "; ")
            set details to concat(details and concat("stable_id=" and actor_id))
            set has_identity to 1
    if map_contains(msg_map and "platform") == 1:
        set platform to ptr_to_str(map_get_val(msg_map and "platform"))
        if string_length(platform) > 0:
            if string_length(details) > 0:
                set details to concat(details and "; ")
            set details to concat(details and concat("platform=" and platform))
    if map_contains(msg_map and "actor_is_host") == 1:
        set host_match to ptr_to_str(map_get_val(msg_map and "actor_is_host"))
        if string_length(host_match) > 0:
            if string_length(details) > 0:
                set details to concat(details and "; ")
            set details to concat(details and concat("host_match=" and host_match))
    if map_contains(msg_map and "sender_role") == 1:
        set sender_role to ptr_to_str(map_get_val(msg_map and "sender_role"))
        if string_length(sender_role) > 0:
            if string_length(details) > 0:
                set details to concat(details and "; ")
            set details to concat(details and concat("authorization_role=" and sender_role))
    if has_identity == 0:
        return "User [identity provenance unavailable: legacy turn; do not infer from the current speaker]"
    return concat(label and concat(" [" and concat(details and "]")))

# ---- Manual JSON Serializer ----
define session_serialize with sess as Map and path as Str returning Int:
    set id_val to map_get_val(sess and "id")
    set title_val to map_get_val(sess and "title")
    set model_val to map_get_val(sess and "model")
    set system_val to map_get_val(sess and "system_prompt")
    set messages_list to map_get_val(sess and "messages")
    set comp_list to map_get_val(sess and "compressed_sessions")
    set next_turn_val to "1"
    if map_contains(sess and "next_turn_id") == 1:
        set next_turn_val to ptr_to_str(map_get_val(sess and "next_turn_id"))
    set created_val to int_to_string(session_created_at(sess))
    
    set summary_val to ""
    if map_contains(sess and "compression_summary") == 1:
        set summary_val to map_get_val(sess and "compression_summary")
    # Session-scoped guidance self-prompt: agent-set direction for THIS conversation only.
    set guidance_val to ""
    if map_contains(sess and "session_guidance") == 1:
        set guidance_val to map_get_val(sess and "session_guidance")
    set json_str to "{\n"
    set json_str to concat(json_str and f"  \"id\": \"{session_json_escape(id_val)}\",\n")
    set json_str to concat(json_str and f"  \"title\": \"{session_json_escape(title_val)}\",\n")
    set json_str to concat(json_str and f"  \"model\": \"{session_json_escape(model_val)}\",\n")
    set json_str to concat(json_str and f"  \"system_prompt\": \"{session_json_escape(system_val)}\",\n")
    set json_str to concat(json_str and f"  \"created_at\": \"{session_json_escape(created_val)}\",\n")
    set json_str to concat(json_str and f"  \"compression_summary\": \"{session_json_escape(summary_val)}\",\n")
    set json_str to concat(json_str and f"  \"session_guidance\": \"{session_json_escape(guidance_val)}\",\n")
    set json_str to concat(json_str and f"  \"next_turn_id\": \"{session_json_escape(next_turn_val)}\",\n")
    
    # messages list
    set json_str to concat(json_str and "  \"messages\": [\n")
    set m_len to length_list(messages_list)
    set idx to 0
    repeat while idx < m_len:
        set msg_map to get_list(messages_list and idx)
        set r_val to map_get_val(msg_map and "role")
        set c_val to map_get_val(msg_map and "content")
        set turn_val to int_to_string(idx + 1)
        set created_val to "0"
        set source_type_val to "legacy"
        set source_id_val to id_val
        set hash_val to ep_sha256(c_val)
        if map_contains(msg_map and "turn_id") == 1:
            set turn_val to ptr_to_str(map_get_val(msg_map and "turn_id"))
        if map_contains(msg_map and "created_at") == 1:
            set created_val to ptr_to_str(map_get_val(msg_map and "created_at"))
        if map_contains(msg_map and "source_type") == 1:
            set source_type_val to ptr_to_str(map_get_val(msg_map and "source_type"))
        if map_contains(msg_map and "source_id") == 1:
            set source_id_val to ptr_to_str(map_get_val(msg_map and "source_id"))
        if map_contains(msg_map and "content_hash") == 1:
            set hash_val to ptr_to_str(map_get_val(msg_map and "content_hash"))
        set json_str to concat(json_str and "    {\n")
        set json_str to concat(json_str and f"      \"role\": \"{session_json_escape(r_val)}\",\n")
        set json_str to concat(json_str and f"      \"content\": \"{session_json_escape(c_val)}\",\n")
        set json_str to concat(json_str and f"      \"turn_id\": \"{session_json_escape(turn_val)}\",\n")
        set json_str to concat(json_str and f"      \"created_at\": \"{session_json_escape(created_val)}\",\n")
        set json_str to concat(json_str and f"      \"source_type\": \"{session_json_escape(source_type_val)}\",\n")
        set json_str to concat(json_str and f"      \"source_id\": \"{session_json_escape(source_id_val)}\"")
        set json_str to concat(json_str and session_actor_json_fields(msg_map and ",\n" and "      "))
        set json_str to concat(json_str and ",\n")
        set json_str to concat(json_str and f"      \"content_hash\": \"{session_json_escape(hash_val)}\"\n")
        if idx < m_len - 1:
            set json_str to concat(json_str and "    },\n")
        else:
            set json_str to concat(json_str and "    }\n")
        set idx to idx + 1
    set json_str to concat(json_str and "  ],\n")
    
    # compressed_sessions list
    set json_str to concat(json_str and "  \"compressed_sessions\": [\n")
    set c_len to length_list(comp_list)
    set idx to 0
    repeat while idx < c_len:
        set c_val to get_list(comp_list and idx)
        set json_str to concat(json_str and f"    \"{session_json_escape(c_val)}\"")
        if idx < c_len - 1:
            set json_str to concat(json_str and ",\n")
        else:
            set json_str to concat(json_str and "\n")
        set idx to idx + 1
    set json_str to concat(json_str and "  ]\n}")
    
    if write_file(path and json_str) == 0:
        return 1
    set verify to read_file(path)
    if verify equals json_str == 0:
        return 1
    return 0

# ---- Deserialize JSON ----
define session_deserialize_json with content as Str returning Map:
    set root to json_parse(content)
    if root == 0:
        return 0
        
    set id_node to get_json_object_value(root and "id")
    set title_node to get_json_object_value(root and "title")
    set model_node to get_json_object_value(root and "model")
    set system_node to get_json_object_value(root and "system_prompt")
    set session_created_node to get_json_object_value(root and "created_at")
    set messages_node to get_json_object_value(root and "messages")
    set comp_node to get_json_object_value(root and "compressed_sessions")
    set summary_node to get_json_object_value(root and "compression_summary")
    set guidance_node to get_json_object_value(root and "session_guidance")
    set next_turn_node to get_json_object_value(root and "next_turn_id")

    set sess to create_map()
    if id_node != 0:
        set ok to map_insert(sess and "id" and get_json_value(id_node))
    if title_node != 0:
        set ok to map_insert(sess and "title" and get_json_value(title_node))
    if model_node != 0:
        set ok to map_insert(sess and "model" and get_json_value(model_node))
    if system_node != 0:
        set ok to map_insert(sess and "system_prompt" and get_json_value(system_node))
    if session_created_node != 0:
        set ok to map_insert(sess and "created_at" and get_json_value(session_created_node))
    if summary_node != 0:
        set ok to map_insert(sess and "compression_summary" and get_json_value(summary_node))
    if guidance_node != 0:
        set ok to map_insert(sess and "session_guidance" and get_json_value(guidance_node))
    if next_turn_node != 0:
        set ok to map_insert(sess and "next_turn_id" and get_json_value(next_turn_node))
        
    set msg_list to create_list()
    if messages_node != 0:
        set raw_list to get_json_value(messages_node)
        set len to length_list(raw_list)
        set i to 0
        repeat while i < len:
            set item_node to get_list(raw_list and i)
            set r_node to get_json_object_value(item_node and "role")
            set c_node to get_json_object_value(item_node and "content")
            set turn_node to get_json_object_value(item_node and "turn_id")
            set created_node to get_json_object_value(item_node and "created_at")
            set source_type_node to get_json_object_value(item_node and "source_type")
            set source_id_node to get_json_object_value(item_node and "source_id")
            set hash_node to get_json_object_value(item_node and "content_hash")
            set msg_map to create_map()
            if r_node != 0:
                set ok to map_insert(msg_map and "role" and get_json_value(r_node))
            if c_node != 0:
                set ok to map_insert(msg_map and "content" and get_json_value(c_node))
            if turn_node != 0:
                set ok to map_insert(msg_map and "turn_id" and get_json_value(turn_node))
            else:
                set ok to map_insert(msg_map and "turn_id" and int_to_string(i + 1))
            if created_node != 0:
                set ok to map_insert(msg_map and "created_at" and get_json_value(created_node))
            else:
                set ok to map_insert(msg_map and "created_at" and "0")
            if source_type_node != 0:
                set ok to map_insert(msg_map and "source_type" and get_json_value(source_type_node))
            else:
                set ok to map_insert(msg_map and "source_type" and "legacy")
            if source_id_node != 0:
                set ok to map_insert(msg_map and "source_id" and get_json_value(source_id_node))
            else if id_node != 0:
                set ok to map_insert(msg_map and "source_id" and get_json_value(id_node))
            if hash_node != 0:
                set ok to map_insert(msg_map and "content_hash" and get_json_value(hash_node))
            else if c_node != 0:
                set ok to map_insert(msg_map and "content_hash" and ep_sha256(get_json_value(c_node)))
            set ok to session_load_actor_provenance(msg_map and item_node)
            set ok to append_list(msg_list and msg_map)
            set i to i + 1
    set ok to map_insert(sess and "messages" and msg_list)
    # Complete the backward-compatible migration only after messages are loaded, so
    # their earliest timestamp can recover the real start of a legacy session.
    set migrated_created_at to session_created_at(sess)
    set comp_list to create_list()
    if comp_node != 0:
        set raw_list to get_json_value(comp_node)
        set len to length_list(raw_list)
        set i to 0
        repeat while i < len:
            set item_node to get_list(raw_list and i)
            set ok to append_list(comp_list and get_json_value(item_node))
            set i to i + 1
    set ok to map_insert(sess and "compressed_sessions" and comp_list)
    if next_turn_node == 0:
        set prior_count to 0
        set ci to 0
        repeat while ci < length_list(comp_list):
            set shard_path to ptr_to_str(get_list(comp_list and ci))
            if file_exists(shard_path) == 1:
                set shard_root to json_parse(read_file(shard_path))
                if shard_root != 0 and also get_json_type(shard_root) == 3:
                    set prior_count to prior_count + length_list(get_json_value(shard_root))
            set ci to ci + 1
        set ok to map_insert(sess and "next_turn_id" and int_to_string(prior_count + length_list(msg_list) + 1))
    
    return sess

define session_load with path as Str returning Map:
    if file_exists(path) == 0:
        return 0
    set content to read_file(path)
    return session_deserialize_json(content)

# ---- Session Manager ----
define session_manager_create with dir as Str returning Map:
    set mgr to create_map()
    set ok to map_insert(mgr and "sessions_dir" and dir)
    set ok to map_insert(mgr and "sessions" and create_map())
    set ok to map_insert(mgr and "active_session_id" and "")
    return mgr

define session_manager_load_all with mgr as Map returning Int:
    set dir to map_get_val(mgr and "sessions_dir")
    if file_exists(dir) == 0:
        set ok to create_directory(dir)
        return 0
    set files to list_directory(dir)
    set len to length_list(files)
    set sessions_map to map_get_val(mgr and "sessions")
    set active_id to ""
    set i to 0
    repeat while i < len:
        set filename to get_list(files and i)
        if string_contains(filename and ".json") == 1 and also string_contains(filename and "_transcript_") == 0:
            set filepath to path_join(dir and filename)
            set sess to session_load(filepath)
            if sess != 0:
                if map_contains(sess and "id") == 1:
                    set sess_id to map_get_val(sess and "id")
                    if string_length(sess_id) > 0:
                        set ok to map_insert(sessions_map and sess_id and sess)
                        set active_id to sess_id
        set i to i + 1

    # Restore active session from persistent tracker
    set active_file to path_join(dir and "active_session.txt")
    if file_exists(active_file) == 1:
        set saved_id_raw to read_file(active_file)
        set saved_id to string_trim(saved_id_raw)
        if string_length(saved_id) > 0 and also map_contains(sessions_map and saved_id) == 1:
            set active_id to saved_id

    if string_length(active_id) == 0:
        set active_id to "default"

    set ok to map_insert(mgr and "active_session_id" and active_id)
    return 0

define session_manager_get_active with mgr as Map returning Map:
    set active_id to map_get_val(mgr and "active_session_id")
    set sessions_map to map_get_val(mgr and "sessions")
    if string_length(active_id) == 0:
        # Create a default session
        set active_id to "default"
        set sess to session_create_new(active_id and "Default Session" and "" and "You are a helpful assistant.")
        set ok to map_insert(sessions_map and active_id and sess)
        set ok to map_insert(mgr and "active_session_id" and active_id)
        
        # Save to disk
        set dir to map_get_val(mgr and "sessions_dir")
        set filepath to path_join(dir and "default.json")
        set ok to session_serialize(sess and filepath)
        
    return map_get_val(sessions_map and active_id)

# Session-scoped guidance self-prompt: the agent's own direction for THIS conversation only
# (distinct from the GLOBAL behavior/skills in ~/.ernosdecent/agent_self_sections.json). Stored
# on the session record, so it persists with the session across reboots and starts empty in a
# /new session.
define session_manager_get_guidance with mgr as Map returning Str:
    set sess to session_manager_get_active(mgr)
    if sess == 0:
        return ""
    if map_contains(sess and "session_guidance") == 0:
        return ""
    return map_get_val(sess and "session_guidance")

define session_manager_set_guidance with mgr as Map and text as Str returning Int:
    set sess to session_manager_get_active(mgr)
    if sess == 0:
        return 1
    set old_text to ""
    set had_old to map_contains(sess and "session_guidance")
    if had_old == 1:
        set old_text to ptr_to_str(map_get_val(sess and "session_guidance"))
    set ok to map_insert(sess and "session_guidance" and text)
    # Persist immediately to the session's own JSON file so a reboot keeps it.
    set active_id to map_get_val(mgr and "active_session_id")
    set dir to map_get_val(mgr and "sessions_dir")
    set filepath to path_join(dir and concat(active_id and ".json"))
    if session_serialize(sess and filepath) != 0:
        if had_old == 1:
            set ok to map_insert(sess and "session_guidance" and old_text)
        else:
            set ok to map_delete(sess and "session_guidance")
        return 1
    return 0

define session_manager_new_session with mgr as Map and id as Str and title as Str and model as Str and sys_prompt as Str returning Map:
    set sessions_map to map_get_val(mgr and "sessions")
    set sess to session_create_new(id and title and model and sys_prompt)
    set ok to map_insert(sessions_map and id and sess)
    set ok to map_insert(mgr and "active_session_id" and id)
    # A workspace link/active-project is per-session context — a new session starts clean, so
    # the last session's active project does not bleed in (fixes new sessions inheriting it).
    set ok to links_clear_active()
    
    # Save to disk
    set dir to map_get_val(mgr and "sessions_dir")
    set filepath to path_join(dir and concat(id and ".json"))
    set ok to session_serialize(sess and filepath)
    
    # Persist active session ID
    set active_file to path_join(dir and "active_session.txt")
    set ok to write_file(active_file and id)
    
    return sess

# Start the first empty session after a prior session has been closed by Echo.  The
# caller decides whether the prior session is closed; this helper owns collision-free
# ID generation and uses the same durable session transaction as every manual /new.
#
# Return the ID, not the created Map. An owned Map returned into the long-lived IPC
# handler becomes an owned local there; the compiler consequently frees it when that
# one socket command ends even though the manager's sessions map still references it.
# The next AI INFER then dereferences the freed session and crashes before ReAct starts.
define session_manager_start_followup_session with mgr as Map returning Str:
    set sessions_map to map_get_val(mgr and "sessions")
    set base_id to concat("session_" and int_to_string(ep_time_now_ms()))
    set new_id to base_id
    set suffix to 1
    repeat while map_contains(sessions_map and new_id) == 1:
        set new_id to concat(base_id and concat("_" and int_to_string(suffix)))
        set suffix to suffix + 1
    set title to concat("Session " and new_id)
    # Convert the returned owned Map directly to an integer handle. The manager is the
    # durable owner; this helper only borrows it long enough to verify the committed ID.
    set created_handle to cast_map_to_int(session_manager_new_session(mgr and new_id and title and "" and "You are a helpful assistant."))
    if created_handle == 0:
        return ""
    set committed_id to ptr_to_str(map_get_val(cast_borrow_to_map(created_handle) and "id"))
    if committed_id equals new_id == 0:
        return ""
    return committed_id

define session_manager_switch_to with mgr as Map and id as Str returning Int:
    set sessions_map to map_get_val(mgr and "sessions")
    if map_contains(sessions_map and id) == 1:
        set ok to map_insert(mgr and "active_session_id" and id)
        
        # Persist active session ID
        set dir to map_get_val(mgr and "sessions_dir")
        set filepath to path_join(dir and "active_session.txt")
        set ok to write_file(filepath and id)
        
        return 1
    return 0

define session_manager_delete with mgr as Map and id as Str returning Int:
    set sessions_map to map_get_val(mgr and "sessions")
    if map_contains(sessions_map and id) == 1:
        set dir to map_get_val(mgr and "sessions_dir")
        set filepath to path_join(dir and concat(id and ".json"))
        if file_exists(filepath) == 1:
            if remove_file(filepath) == 0:
                return 0
        set files to list_directory(dir)
        set prefix to concat(id and "_transcript_")
        set i to 0
        repeat while i < length_list(files):
            set name to ptr_to_str(get_list(files and i))
            if string_index_of(name and prefix) == 0 and also string_contains(name and ".json") == 1:
                if remove_file(path_join(dir and name)) == 0:
                    return 0
            set i to i + 1
        set ok to map_delete(sessions_map and id)
        set active_id to map_get_val(mgr and "active_session_id")
        if active_id equals id:
            if map_contains(sessions_map and "default") == 0:
                set replacement to session_create_new("default" and "Default Session" and "" and "You are a helpful assistant.")
                set ok to map_insert(sessions_map and "default" and replacement)
                if session_serialize(replacement and path_join(dir and "default.json")) != 0:
                    return 0
            set ok to map_insert(mgr and "active_session_id" and "default")
            if write_file(path_join(dir and "active_session.txt") and "default") == 0:
                return 0
        return 1
    return 0

define session_manager_rename with mgr as Map and id as Str and new_title as Str returning Int:
    set sessions_map to map_get_val(mgr and "sessions")
    if map_contains(sessions_map and id) == 1:
        set sess to map_get_val(sessions_map and id)
        set ok to map_insert(sess and "title" and new_title)
        set dir to map_get_val(mgr and "sessions_dir")
        set filepath to path_join(dir and concat(id and ".json"))
        if session_serialize(sess and filepath) != 0:
            return 0
        return 1
    return 0

# FACTORY RESET: construct and durably verify the fresh registry before exposing it
# to the live manager. The caller deliberately removes config/sessions/ first, so
# this function owns recreating that directory. A persistence failure must leave the
# prior in-memory registry and active id untouched for the recovery path.
define session_manager_factory_reset with mgr as Map returning Int:
    set dir to map_get_val(mgr and "sessions_dir")
    if string_length(dir) == 0:
        return 1
    if file_exists(dir) == 0:
        if create_directory(dir) == 0 or else file_exists(dir) == 0:
            return 1

    set fresh_sessions to create_map()
    set fresh_session to session_create_new("default" and "Default Session" and "" and "You are a helpful assistant.")
    set ok to map_insert(fresh_sessions and "default" and fresh_session)
    set default_path to path_join(dir and "default.json")
    set active_path to path_join(dir and "active_session.txt")
    if session_serialize(fresh_session and default_path) != 0:
        return 1
    if write_file(active_path and "default") == 0:
        return 1
    if file_exists(default_path) == 0 or else file_exists(active_path) == 0:
        return 1
    if string_trim(read_file(active_path)) equals "default" == 0:
        return 1
    set persisted to session_load(default_path)
    if persisted == 0 or else map_contains(persisted and "id") == 0:
        return 1
    if ptr_to_str(map_get_val(persisted and "id")) equals "default" == 0:
        return 1
    if links_clear_active() != 0:
        return 1

    # Commit the reconstructed state only after every durable postcondition passes.
    set ok to map_insert(mgr and "sessions" and fresh_sessions)
    set ok to map_insert(mgr and "active_session_id" and "default")
    return 0

# Resolve a session reference to an id: exact id → exact title (case-insensitive) →
# UNIQUE case-insensitive title substring. Returns "" when unknown or ambiguous. Lets
# the user and the agent address sessions by NAME ("flux debugging") instead of raw
# session_<ms> ids — pairs with session_rename.
define session_manager_resolve_id with mgr as Map and ref as Str returning Str:
    if string_length(ref) == 0:
        return ""
    set sessions_map to map_get_val(mgr and "sessions")
    if map_contains(sessions_map and ref) == 1:
        return ref
    set keys to map_keys(sessions_map)
    set n to length_list(keys)
    set ref_lower to string_lower(ref)
    set exact to ""
    set sub_hit to ""
    set sub_count to 0
    set i to 0
    repeat while i < n:
        set k to get_list(keys and i)
        set sess to map_get_val(sessions_map and k)
        set title_lower to string_lower(map_get_val(sess and "title"))
        if title_lower equals ref_lower:
            set exact to k
        if string_contains(title_lower and ref_lower) == 1:
            set sub_hit to k
            set sub_count to sub_count + 1
        set i to i + 1
    if string_length(exact) > 0:
        return exact
    if sub_count == 1:
        return sub_hit
    return ""

# Rename the ACTIVE session (the agent-facing session_rename tool). Returns the active
# id on success, "" when there is no active session.
define session_manager_rename_active with mgr as Map and new_title as Str returning Str:
    set active_id to map_get_val(mgr and "active_session_id")
    if string_length(active_id) == 0:
        return ""
    set ok to session_manager_rename(mgr and active_id and new_title)
    if ok == 1:
        return active_id
    return ""

define session_manager_list_json with mgr as Map returning Str:
    set sessions_map to map_get_val(mgr and "sessions")
    set keys to map_keys(sessions_map)
    set len to length_list(keys)
    set json_str to "["
    set i to 0
    repeat while i < len:
        set k to get_list(keys and i)
        set sess to map_get_val(sessions_map and k)
        set title_val to map_get_val(sess and "title")
        set model_val to map_get_val(sess and "model")
        
        set item_str to "{\"id\":\""
        set item_str to concat(item_str and session_json_escape(k))
        set item_str to concat(item_str and "\",\"title\":\"")
        set item_str to concat(item_str and session_json_escape(title_val))
        set item_str to concat(item_str and "\",\"model\":\"")
        set item_str to concat(item_str and session_json_escape(model_val))
        set item_str to concat(item_str and "\"}")
        
        set json_str to concat(json_str and item_str)
        if i < len - 1:
            set json_str to concat(json_str and ",")
        set i to i + 1
    set json_str to concat(json_str and "]")
    return json_str

define session_serialize_json_string with sess as Map returning Str:
    set id_val to map_get_val(sess and "id")
    set title_val to map_get_val(sess and "title")
    set model_val to map_get_val(sess and "model")
    set system_val to map_get_val(sess and "system_prompt")
    set messages_list to map_get_val(sess and "messages")
    set comp_list to map_get_val(sess and "compressed_sessions")
    
    set summary_val to ""
    if map_contains(sess and "compression_summary") == 1:
        set summary_val to map_get_val(sess and "compression_summary")
    set guidance_val to ""
    if map_contains(sess and "session_guidance") == 1:
        set guidance_val to map_get_val(sess and "session_guidance")
    set next_turn_val to "1"
    if map_contains(sess and "next_turn_id") == 1:
        set next_turn_val to ptr_to_str(map_get_val(sess and "next_turn_id"))

    set json_str to "{\"id\":\""
    set json_str to concat(json_str and session_json_escape(id_val))
    set json_str to concat(json_str and "\",\"title\":\"")
    set json_str to concat(json_str and session_json_escape(title_val))
    set json_str to concat(json_str and "\",\"model\":\"")
    set json_str to concat(json_str and session_json_escape(model_val))
    set json_str to concat(json_str and "\",\"system_prompt\":\"")
    set json_str to concat(json_str and session_json_escape(system_val))
    set json_str to concat(json_str and "\",\"compression_summary\":\"")
    set json_str to concat(json_str and session_json_escape(summary_val))
    set json_str to concat(json_str and "\",\"session_guidance\":\"")
    set json_str to concat(json_str and session_json_escape(guidance_val))
    set json_str to concat(json_str and "\",\"next_turn_id\":\"")
    set json_str to concat(json_str and session_json_escape(next_turn_val))
    set json_str to concat(json_str and "\",")
    
    # messages list
    set json_str to concat(json_str and "\"messages\":[")
    set m_len to length_list(messages_list)
    set idx to 0
    repeat while idx < m_len:
        set msg_map to get_list(messages_list and idx)
        set r_val to map_get_val(msg_map and "role")
        set c_val to map_get_val(msg_map and "content")
        set turn_val to int_to_string(idx + 1)
        set created_val to "0"
        set source_type_val to "legacy"
        set source_id_val to id_val
        set hash_val to ep_sha256(c_val)
        if map_contains(msg_map and "turn_id") == 1:
            set turn_val to ptr_to_str(map_get_val(msg_map and "turn_id"))
        if map_contains(msg_map and "created_at") == 1:
            set created_val to ptr_to_str(map_get_val(msg_map and "created_at"))
        if map_contains(msg_map and "source_type") == 1:
            set source_type_val to ptr_to_str(map_get_val(msg_map and "source_type"))
        if map_contains(msg_map and "source_id") == 1:
            set source_id_val to ptr_to_str(map_get_val(msg_map and "source_id"))
        if map_contains(msg_map and "content_hash") == 1:
            set hash_val to ptr_to_str(map_get_val(msg_map and "content_hash"))
        
        set item_str to "{\"role\":\""
        set item_str to concat(item_str and session_json_escape(r_val))
        set item_str to concat(item_str and "\",\"content\":\"")
        set item_str to concat(item_str and session_json_escape(c_val))
        set item_str to concat(item_str and "\",\"turn_id\":\"")
        set item_str to concat(item_str and session_json_escape(turn_val))
        set item_str to concat(item_str and "\",\"created_at\":\"")
        set item_str to concat(item_str and session_json_escape(created_val))
        set item_str to concat(item_str and "\",\"source_type\":\"")
        set item_str to concat(item_str and session_json_escape(source_type_val))
        set item_str to concat(item_str and "\",\"source_id\":\"")
        set item_str to concat(item_str and session_json_escape(source_id_val))
        set item_str to concat(item_str and "\"")
        set item_str to concat(item_str and session_actor_json_fields(msg_map and "," and ""))
        set item_str to concat(item_str and ",\"content_hash\":\"")
        set item_str to concat(item_str and session_json_escape(hash_val))
        set item_str to concat(item_str and "\"}")
        
        set json_str to concat(json_str and item_str)
        if idx < m_len - 1:
            set json_str to concat(json_str and ",")
        set idx to idx + 1
    set json_str to concat(json_str and "],")
    
    # compressed_sessions list
    set json_str to concat(json_str and "\"compressed_sessions\":[")
    set c_len to length_list(comp_list)
    set idx to 0
    repeat while idx < c_len:
        set c_val to get_list(comp_list and idx)
        set json_str to concat(json_str and "\"")
        set json_str to concat(json_str and session_json_escape(c_val))
        set json_str to concat(json_str and "\"")
        if idx < c_len - 1:
            set json_str to concat(json_str and ",")
        set idx to idx + 1
    set json_str to concat(json_str and "]}")
    return json_str

define session_compaction_threshold with provider_context_tokens as Int returning Int:
    if provider_context_tokens <= 0:
        return 0
    return (provider_context_tokens * 85) / 100

define session_should_compress with used_tokens as Int and provider_context_tokens as Int returning Int:
    set threshold to session_compaction_threshold(provider_context_tokens)
    if threshold <= 0 or else used_tokens < threshold:
        return 0
    return 1

define session_context_approaching_compaction with used_tokens as Int and provider_context_tokens as Int returning Int:
    set threshold to session_compaction_threshold(provider_context_tokens)
    if threshold <= 0 or else used_tokens >= threshold:
        return 0
    set warning_point to (threshold * 9) / 10
    if used_tokens >= warning_point:
        return 1
    return 0

define session_context_capacity_text with provider_name as Str and model_name as Str and used_tokens as Int and provider_context_tokens as Int returning Str:
    set threshold to session_compaction_threshold(provider_context_tokens)
    set remaining to threshold - used_tokens
    if remaining < 0:
        set remaining to 0
    return f"[CONTEXT CAPACITY — runtime measurement]\nProvider: {provider_name}; model: {model_name}.\nCurrent assembled prompt: {used_tokens} tokens. Provider context window: {provider_context_tokens} tokens. Automatic compaction point: {threshold} tokens (85%). Tokens remaining before compaction: {remaining}.\nThis is situational awareness, not a request. Do not mention it in ordinary replies; the runtime separately warns the user when compaction is approaching.\n[/CONTEXT CAPACITY]\n"

define session_compress_active with mgr as Map and sess as Map and used_tokens as Int and provider_context_tokens as Int returning Int:
    set messages_list to map_get_val(sess and "messages")
    set m_len to length_list(messages_list)
    if m_len < 4:
        return 0

    if session_should_compress(used_tokens and provider_context_tokens) == 0:
        return 0
        
    set last_msg to get_list(messages_list and m_len - 1)
    set comp_msgs to create_list()
    set i to 0
    repeat while i < m_len - 1:
        set msg_map to get_list(messages_list and i)
        set ok to append_list(comp_msgs and msg_map)
        set i to i + 1
        
    set sess_id to map_get_val(sess and "id")
    set comp_list to map_get_val(sess and "compressed_sessions")
    set comp_count to length_list(comp_list)
    set dir to map_get_val(mgr and "sessions_dir")
    set transcript_filename to f"{sess_id}_transcript_{comp_count}.json"
    set transcript_path to path_join(dir and transcript_filename)
    
    set json_str to "[\n"
    set c_len to length_list(comp_msgs)
    set idx to 0
    repeat while idx < c_len:
        set msg_map to get_list(comp_msgs and idx)
        set r_val to map_get_val(msg_map and "role")
        set c_val to map_get_val(msg_map and "content")
        set turn_val to int_to_string(idx + 1)
        set created_val to "0"
        set source_type_val to "legacy"
        set source_id_val to sess_id
        set hash_val to ep_sha256(c_val)
        if map_contains(msg_map and "turn_id") == 1:
            set turn_val to ptr_to_str(map_get_val(msg_map and "turn_id"))
        if map_contains(msg_map and "created_at") == 1:
            set created_val to ptr_to_str(map_get_val(msg_map and "created_at"))
        if map_contains(msg_map and "source_type") == 1:
            set source_type_val to ptr_to_str(map_get_val(msg_map and "source_type"))
        if map_contains(msg_map and "source_id") == 1:
            set source_id_val to ptr_to_str(map_get_val(msg_map and "source_id"))
        if map_contains(msg_map and "content_hash") == 1:
            set hash_val to ptr_to_str(map_get_val(msg_map and "content_hash"))
        set json_str to concat(json_str and "  {\n")
        set json_str to concat(json_str and f"    \"role\": \"{session_json_escape(r_val)}\",\n")
        set json_str to concat(json_str and f"    \"content\": \"{session_json_escape(c_val)}\",\n")
        set json_str to concat(json_str and f"    \"turn_id\": \"{session_json_escape(turn_val)}\",\n")
        set json_str to concat(json_str and f"    \"created_at\": \"{session_json_escape(created_val)}\",\n")
        set json_str to concat(json_str and f"    \"source_type\": \"{session_json_escape(source_type_val)}\",\n")
        set json_str to concat(json_str and f"    \"source_id\": \"{session_json_escape(source_id_val)}\"")
        set json_str to concat(json_str and session_actor_json_fields(msg_map and ",\n" and "    "))
        set json_str to concat(json_str and ",\n")
        set json_str to concat(json_str and f"    \"content_hash\": \"{session_json_escape(hash_val)}\"\n")
        if idx < c_len - 1:
            set json_str to concat(json_str and "  },\n")
        else:
            set json_str to concat(json_str and "  }\n")
        set idx to idx + 1
    set json_str to concat(json_str and "]")
    if write_file(transcript_path and json_str) == 0:
        return 0
    if read_file(transcript_path) equals json_str == 0:
        return 0
    if rights_archive_session_traces(storage_get_db() and sess_id) != 0:
        return 0
    if rights_record_compaction(storage_get_db() and sess_id and transcript_path and used_tokens and provider_context_tokens) != 0:
        return 0
    
    set ok to append_list(comp_list and transcript_path)
    
    # Prefer the automatically maintained cumulative semantic state.  The previous
    # compressor kept only the first 40 characters of each user message and replaced
    # the prior summary on every compression, losing decisions and open loops.
    set summary_text to continuity_previous_summary(storage_get_db() and sess_id)
    if string_length(summary_text) == 0:
        # Offline/fresh-install fallback: preserve a bounded, cumulative extractive
        # record of both sides rather than a list of clipped user-message openings.
        set summary_text to f"Conversation up to turn {m_len - 1}:\n"
        if map_contains(sess and "compression_summary") == 1:
            set prior_summary to map_get_val(sess and "compression_summary")
            if string_length(prior_summary) > 0:
                set summary_text to concat(summary_text and concat("Prior compressed context:\n" and concat(continuity_cap(prior_summary and 1600) and "\nNewer context:\n")))
        set start_extract to c_len - 8
        if start_extract < 0:
            set start_extract to 0
        set i to start_extract
        repeat while i < c_len:
            set msg_map to get_list(comp_msgs and i)
            set role_val to map_get_val(msg_map and "role")
            set content_val to continuity_cap(map_get_val(msg_map and "content") and 320)
            if role_val equals "user":
                set summary_text to concat(summary_text and concat(session_message_speaker_label(msg_map) and concat(": " and concat(content_val and "\n"))))
            else:
                set summary_text to concat(summary_text and concat("Echo: " and concat(content_val and "\n")))
            set i to i + 1
        set summary_text to continuity_cap(summary_text and 5000)
    
    set ok to map_insert(sess and "compression_summary" and summary_text)
    
    set new_msgs to create_list()
    set ok to append_list(new_msgs and last_msg)
    set ok to map_insert(sess and "messages" and new_msgs)
    
    set sess_filepath to path_join(dir and concat(sess_id and ".json"))
    if session_serialize(sess and sess_filepath) != 0:
        return 0
    return 1

define session_manager_set_model with mgr as Map and id as Str and model as Str returning Int:
    set sessions_map to map_get_val(mgr and "sessions")
    if map_contains(sessions_map and id) == 1:
        set sess to map_get_val(sessions_map and id)
        set old_model to ""
        set had_old to map_contains(sess and "model")
        if had_old == 1:
            set old_model to ptr_to_str(map_get_val(sess and "model"))
        set ok to map_insert(sess and "model" and model)
        set dir to map_get_val(mgr and "sessions_dir")
        set filepath to path_join(dir and concat(id and ".json"))
        if session_serialize(sess and filepath) != 0:
            if had_old == 1:
                set ok to map_insert(sess and "model" and old_model)
            else:
                set ok to map_delete(sess and "model")
            return 0
        return 1
    return 0
