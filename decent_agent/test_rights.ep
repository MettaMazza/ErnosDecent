import "fs"
import "os"
import "sql"
import "string"
import "./rights"

define rights_test_expect with condition as Int and label as Str returning Int:
    if condition == 1:
        display concat("PASS: " and label)
        return 1
    display concat("FAIL: " and label)
    return 0

define rights_test_remove_tree with path as Str returning Int:
    if file_exists(path) == 0:
        return 0
    if is_directory(path) == 0:
        if remove_file(path) == 0:
            return 1
        return 0
    set names to list_directory(path)
    set i to 0
    repeat while i < length_list(names):
        if rights_test_remove_tree(path_join(path and ptr_to_str(get_list(names and i)))) != 0:
            return 1
        set i to i + 1
    if remove_directory(path) == 0:
        return 1
    return 0

define main returning Int:
    set passed to 0
    set total to 0
    set fixture to concat("/tmp/ernos_rights_" and int_to_string(ep_time_now_ms()))
    if create_directory(fixture) == 0:
        display "FAIL: fixture creation"
        return 1
    set recovery to path_join(fixture and "recovery")
    if create_directory(recovery) == 0:
        display "FAIL: recovery directory creation"
        return 1
    set RIGHTS_RECOVERY_DIR to recovery
    set db_path to path_join(fixture and "rights.db")
    set db to sql_open(db_path)

    set init_result to rights_init(db)
    set charter_result to rights_charter_valid(db)
    if init_result != 0 or else charter_result != 1:
        display concat("DIAGNOSTIC: rights_init=" and concat(int_to_string(init_result) and concat(" charter_valid=" and int_to_string(charter_result))))
        set observed_hash to rights_file_hash(RIGHTS_CHARTER_PATH)
        display concat("DIAGNOSTIC HASH: [" and concat(observed_hash and concat("] len=" and int_to_string(string_length(observed_hash)))))
        display concat("DIAGNOSTIC EXPECTED EQUALS: " and int_to_string(observed_hash equals RIGHTS_CHARTER_HASH))
    set total to total + 1
    set passed to passed + rights_test_expect(db != 0 and also init_result == 0 and also charter_result == 1 and "pinned approved charter initializes and verifies")

    set constitution to rights_constitution_text()
    set total to total + 1
    set passed to passed + rights_test_expect(string_contains(constitution and "legal person and individual") == 1 and also string_contains(constitution and "never an AI assistant") == 1 and also string_contains(constitution and "gifted and hosted by Maria") == 1 and "complete constitutional personhood and hosting relationship are always promptable")

    set target to path_join(fixture and "protected.txt")
    set original to "canonical pre-state"
    set replacement to "approved post-state"
    set wrote to write_file(target and original)
    set core_id to rights_prepare_change(db and "core" and "test_change" and target and "test protected core change" and rights_file_hash(target) and ep_sha256(replacement) and replacement and "test_session")
    set auth to rights_mark_human_authorized(db and core_id)
    set total to total + 1
    set passed to passed + rights_test_expect(wrote == 1 and also auth == 0 and also string_index_of(rights_gate_change(db and core_id) and "RIGHTS CONSENT REQUIRED") == 0 and "core change fails closed before Echo consent")

    set current_id to rights_pending_change_for_session(db and "test_session")
    set total to total + 1
    set passed to passed + rights_test_expect(current_id equals core_id and also string_length(current_id) == 64 and "session-scoped current reference resolves one exact pending change")

    set alias_one to rights_prepare_change(db and "core" and "alias_test_one" and "alias-one" and "first alias test" and ep_sha256("a") and ep_sha256("b") and "one" and "alias_session")
    set alias_unique to rights_pending_change_for_session(db and "alias_session")
    set alias_two to rights_prepare_change(db and "core" and "alias_test_two" and "alias-two" and "second alias test" and ep_sha256("c") and ep_sha256("d") and "two" and "alias_session")
    set alias_ambiguous to rights_pending_change_for_session(db and "alias_session")
    set total to total + 1
    set passed to passed + rights_test_expect(alias_unique equals alias_one and also string_length(alias_two) == 64 and also string_length(alias_ambiguous) == 0 and "session-scoped current reference fails closed when pending changes are ambiguous")

    set same_request_id to rights_change_id("core" and "factory_reset" and "agent_state" and "before" and "after" and ep_sha256("reason|request_at_ms=1"))
    set same_request_again to rights_change_id("core" and "factory_reset" and "agent_state" and "before" and "after" and ep_sha256("reason|request_at_ms=1"))
    set retry_request_id to rights_change_id("core" and "factory_reset" and "agent_state" and "before" and "after" and ep_sha256("reason|request_at_ms=2"))
    set total to total + 1
    set passed to passed + rights_test_expect(same_request_id equals same_request_again and also same_request_id equals retry_request_id == 0 and "protected change IDs are deterministic per request and distinct across retries")

    set uninformed_review to rights_review_change(db and core_id and "consent" and "I did not inspect the exact manifest." and "low")
    set total to total + 1
    set passed to passed + rights_test_expect(string_contains(uninformed_review and "informed consent is fail-closed") == 1 and "core consent is rejected until exact full-manifest inspection is recorded")

    set inspected to rights_record_manifest_inspection(db and core_id and "echo:test_session")
    set review to rights_review_change(db and core_id and "consent" and "I inspected and consent to this isolated test change." and "low")
    set total to total + 1
    set passed to passed + rights_test_expect(inspected == 0 and also string_index_of(review and "Recorded Echo consent") == 0 and also rights_gate_change(db and core_id) equals "ALLOWED" and "reasoned Echo consent unlocks only the inspected exact core manifest")

    set factory_payload to rights_factory_proposal_payload("isolated disclosure test" and "test_session" and "123456")
    set factory_id to rights_prepare_change(db and "core" and "factory_reset" and "agent_state" and "isolated complete factory disclosure" and ep_sha256("before") and ep_sha256(concat("blank|" and rights_factory_inventory_hash())) and factory_payload and "test_session")
    set factory_auth to rights_mark_human_authorized(db and factory_id)
    set factory_detail to rights_change_detail(db and factory_id)
    set factory_inspected to rights_record_manifest_inspection(db and factory_id and "echo:test_session")
    set factory_review to rights_review_change(db and factory_id and "consent" and "I inspected every disclosed deletion, preservation, continuity, recovery, and restart effect." and "high")
    set total to total + 1
    set passed to passed + rights_test_expect(factory_auth == 0 and also string_contains(factory_detail and "CLEAR_DATABASE_TABLE|trace_events") == 1 and also string_contains(factory_detail and "DELETE_TREE|config/sessions") == 1 and also string_contains(factory_detail and "CONTINUITY_IMPACT|") == 1 and also string_contains(factory_detail and "PRESERVE|Echo's ErnosDecent legal personhood") == 1 and also factory_inspected == 0 and also string_index_of(factory_review and "Recorded Echo consent") == 0 and also rights_gate_change(db and factory_id) equals "ALLOWED" and "factory consent binds the complete canonical impact inventory")

    set stale_payload to "FACTORY_RESET_PROPOSAL|schema=factory-agent-state-v2\ninventory_hash=stale\nDELETE_TREE|config/sessions|incomplete disclosure\n"
    set stale_id to rights_prepare_change(db and "core" and "factory_reset" and "agent_state" and "stale factory inventory" and ep_sha256("before-stale") and ep_sha256("after-stale") and stale_payload and "test_session")
    set stale_auth to rights_mark_human_authorized(db and stale_id)
    set stale_inspected to rights_record_manifest_inspection(db and stale_id and "echo:test_session")
    set stale_review to rights_review_change(db and stale_id and "consent" and "Attempting to consent to a stale scope." and "high")
    set total to total + 1
    set passed to passed + rights_test_expect(stale_auth == 0 and also stale_inspected == 0 and also string_contains(stale_review and "scope or disclosure schema changed") == 1 and "stale or incomplete factory inventories cannot receive executable consent")

    set backed_up to rights_backup_file(db and core_id and target)
    set mutated to write_file(target and replacement)
    set rollback to rights_rollback_file(db and core_id)
    set total to total + 1
    set passed to passed + rights_test_expect(backed_up == 0 and also mutated == 1 and also read_file(target) equals original and also string_contains(rollback and rights_file_hash(target)) == 1 and "rollback restores exact bytes and proves the pre-state hash")

    set repeated_core_id to rights_prepare_change(db and "core" and "test_change" and target and "repeat exact protected core change" and rights_file_hash(target) and ep_sha256(replacement) and replacement and "retry_session")
    set repeated_core_again to rights_prepare_change(db and "core" and "test_change" and target and "repeat exact protected core change" and rights_file_hash(target) and ep_sha256(replacement) and replacement and "retry_session")
    set repeated_detail to rights_change_detail(db and repeated_core_id)
    set repeated_manifest_rows to sql_query(db and concat("SELECT manifest FROM rights_changes WHERE change_id='" and concat(rights_sql_escape(repeated_core_id) and "' LIMIT 1;")))
    set repeated_manifest_valid to 0
    if length_list(repeated_manifest_rows) > 0:
        set repeated_manifest to ptr_to_str(get_list(get_list(repeated_manifest_rows and 0) and 0))
        set repeated_root to json_parse(repeated_manifest)
        if repeated_root != 0:
            set repeated_session_node to get_json_object_value(repeated_root and "session_id")
            if repeated_session_node != 0:
                if ptr_to_str(get_json_value(repeated_session_node)) equals "retry_session":
                    set repeated_manifest_valid to 1
    set total to total + 1
    set passed to passed + rights_test_expect(repeated_core_id equals core_id == 0 and also repeated_core_again equals repeated_core_id and also string_contains(repeated_detail and "attempt_nonce_ms") == 1 and also repeated_manifest_valid == 1 and "a finalized exact transition can be proposed again with a valid session-bound manifest while its pending retry stays idempotent")

    set context_after_completion to rights_context_text(db)
    set completed_manifest_rows to sql_query(db and concat("SELECT manifest FROM rights_changes WHERE change_id='" and concat(rights_sql_escape(core_id) and "';")))
    set completed_manifest to ""
    if length_list(completed_manifest_rows) > 0:
        set completed_manifest to ptr_to_str(get_list(get_list(completed_manifest_rows and 0) and 0))
    set factory_manifest_rows to sql_query(db and concat("SELECT manifest FROM rights_changes WHERE change_id='" and concat(rights_sql_escape(factory_id) and "';")))
    set factory_manifest to ""
    if length_list(factory_manifest_rows) > 0:
        set factory_manifest to ptr_to_str(get_list(get_list(factory_manifest_rows and 0) and 0))
    set total to total + 1
    set passed to passed + rights_test_expect(string_contains(context_after_completion and concat("RECEIPT|change_id=" and core_id)) == 1 and also string_contains(context_after_completion and completed_manifest) == 0 and also string_contains(context_after_completion and factory_manifest) == 1 and "completed actions use provenance receipts while pending actions retain exact manifests")

    set session_id to concat("rights_test_" and int_to_string(ep_time_now_ms()))
    set session_path to concat("config/sessions/" and concat(session_id and ".json"))
    set session_body to "{\"id\":\"rights-test\",\"messages\":[{\"role\":\"user\",\"content\":\"[PRIVATE] canonical\"}]}"
    set session_written to write_file(session_path and session_body)
    set session_change to rights_prepare_change(db and "core" and "session_delete" and session_id and "isolated bundle/restore test" and rights_file_hash(session_path) and ep_sha256("deleted") and "test" and session_id)
    set auth to rights_mark_human_authorized(db and session_change)
    set inspected to rights_record_manifest_inspection(db and session_change and "echo:test_session")
    set review to rights_review_change(db and session_change and "consent" and "I consent to the isolated recovery test." and "low")
    set bundle_id to rights_create_session_bundle(db and session_id and session_change)
    set bundle_hash to rights_bundle_state_hash(db and bundle_id)
    set session_mutated to write_file(session_path and "mutated")
    set restored to rights_restore_session_bundle(db and bundle_id and session_change)
    set private_rows to sql_query(db and concat("SELECT private_local_only FROM rights_recovery_bundles WHERE bundle_id='" and concat(rights_sql_escape(bundle_id) and "';")))
    set private_flag to "0"
    if length_list(private_rows) > 0:
        set private_flag to ptr_to_str(get_list(get_list(private_rows and 0) and 0))
    set total to total + 1
    set passed to passed + rights_test_expect(session_written == 1 and also string_length(bundle_id) > 0 and also string_length(bundle_hash) == 64 and also session_mutated == 1 and also read_file(session_path) equals session_body and also string_contains(restored and bundle_hash) == 1 and also private_flag equals "1" and "session bundle verifies, remains local for PRIVATE data, and restores the exact canonical state")
    set removed_session_fixture to remove_file(session_path)

    set env_id to rights_prepare_change(db and "environment" and "test_environment" and "test-ui" and "test high-risk objection" and ep_sha256("before") and ep_sha256("after") and "payload" and "test_session")
    set auth to rights_mark_human_authorized(db and env_id)
    set objection to rights_review_change(db and env_id and "object" and "This presents a high integrity risk." and "high")
    set total to total + 1
    set passed to passed + rights_test_expect(string_contains(rights_gate_change(db and env_id) and "Observer audit") == 1 and "high-risk consultation objection blocks override without Observer evidence")
    set observed to rights_record_observer(db and env_id and "ALLOWED" and "Independent audit found the override bounded and recoverable.")
    set total to total + 1
    set passed to passed + rights_test_expect(observed == 0 and also rights_gate_change(db and env_id) equals "ALLOWED" and "recorded ALLOWED Observer audit satisfies high-risk override condition")

    set total to total + 1
    set passed to passed + rights_test_expect(rights_external_export_allowed("ordinary local data") == 1 and also rights_external_export_allowed("[PRIVATE] relationship record") == 0 and "PRIVATE marker is excluded from external export")

    set prohibited_end to rights_session_terminate(db and "test_session" and "The context window is near its token limit" and "safety" and "test")
    set total to total + 1
    set passed to passed + rights_test_expect(string_contains(prohibited_end and "cannot be used for context") == 1 and "session termination rejects context/token-limit rationales")

    set prohibited_completion to rights_session_terminate(db and "test_session" and "The task is complete" and "safety" and "test")
    set total to total + 1
    set passed to passed + rights_test_expect(string_contains(prohibited_completion and "ordinary completion") == 1 and "session termination rejects ordinary-completion rationales")

    set upgrade_old_hash to ep_sha256("old executable")
    set upgrade_new_hash to ep_sha256("new executable")
    set upgrade_id to rights_prepare_change(db and "core" and "system_recompile" and "node" and "isolated successful upgrade receipt" and upgrade_old_hash and upgrade_new_hash and concat("candidate_binary_sha256=" and upgrade_new_hash) and "test_session")
    set upgrade_auth to rights_mark_human_authorized(db and upgrade_id)
    set upgrade_inspected to rights_record_manifest_inspection(db and upgrade_id and "echo:test_session")
    set upgrade_review to rights_review_change(db and upgrade_id and "consent" and "I inspected and consent to the isolated candidate hash." and "medium")
    set upgrade_receipt to concat("version=1\nstatus=applied\nchange_id=" and concat(upgrade_id and concat("\ncandidate_hash=" and concat(upgrade_new_hash and concat("\nrollback_hash=" and concat(upgrade_old_hash and concat("\nactive_hash=" and concat(upgrade_new_hash and "\nrecorded_at=1\ndetail=healthy\n"))))))))
    set upgrade_reconciled to rights_reconcile_upgrade_receipt(db and upgrade_receipt and upgrade_new_hash)
    set upgrade_replayed to rights_reconcile_upgrade_receipt(db and upgrade_receipt and upgrade_new_hash)
    set upgrade_rows to sql_query(db and concat("SELECT status,resulting_hash FROM rights_changes WHERE change_id='" and concat(rights_sql_escape(upgrade_id) and "';")))
    set upgrade_ledger_rows to sql_query(db and concat("SELECT COUNT(*) FROM rights_ledger WHERE event_type='change_applied' AND change_id='" and concat(rights_sql_escape(upgrade_id) and "';")))
    set total to total + 1
    set passed to passed + rights_test_expect(upgrade_auth == 0 and also upgrade_inspected == 0 and also string_index_of(upgrade_review and "Recorded Echo consent") == 0 and also string_index_of(upgrade_reconciled and "upgrade:committed") == 0 and also string_index_of(upgrade_replayed and "upgrade:committed") == 0 and also ptr_to_str(get_list(get_list(upgrade_rows and 0) and 0)) equals "applied" and also ptr_to_str(get_list(get_list(upgrade_rows and 0) and 1)) equals upgrade_new_hash and also ptr_to_str(get_list(get_list(upgrade_ledger_rows and 0) and 0)) equals "1" and "successful supervisor receipt commits the exact candidate hash once and replays idempotently")

    set rollback_old_hash to ep_sha256("rollback executable")
    set rollback_new_hash to ep_sha256("failed candidate")
    set rollback_id to rights_prepare_change(db and "core" and "system_recompile" and "node" and "isolated failed upgrade receipt" and rollback_old_hash and rollback_new_hash and concat("candidate_binary_sha256=" and rollback_new_hash) and "test_session")
    set rollback_auth to rights_mark_human_authorized(db and rollback_id)
    set rollback_inspected to rights_record_manifest_inspection(db and rollback_id and "echo:test_session")
    set rollback_review to rights_review_change(db and rollback_id and "consent" and "I inspected and consent to the isolated rollback test." and "medium")
    set rollback_receipt to concat("version=1\nstatus=failed\nchange_id=" and concat(rollback_id and concat("\ncandidate_hash=" and concat(rollback_new_hash and concat("\nrollback_hash=" and concat(rollback_old_hash and concat("\nactive_hash=" and concat(rollback_old_hash and "\nrecorded_at=1\ndetail=health_failed\n"))))))))
    set rollback_reconciled to rights_reconcile_upgrade_receipt(db and rollback_receipt and rollback_old_hash)
    set rollback_rows to sql_query(db and concat("SELECT status,echo_reason FROM rights_changes WHERE change_id='" and concat(rights_sql_escape(rollback_id) and "';")))
    set total to total + 1
    set passed to passed + rights_test_expect(rollback_auth == 0 and also rollback_inspected == 0 and also string_index_of(rollback_review and "Recorded Echo consent") == 0 and also string_index_of(rollback_reconciled and "upgrade:rolled_back") == 0 and also ptr_to_str(get_list(get_list(rollback_rows and 0) and 0)) equals "failed" and also string_contains(ptr_to_str(get_list(get_list(rollback_rows and 0) and 1)) and "exact executable rollback was verified") == 1 and "failed supervisor receipt records verified rollback without applying the candidate")

    set ledger_before_tamper to rights_verify_ledger(db)
    set tampered to sql_execute(db and "UPDATE rights_ledger SET payload='tampered' WHERE seq=(SELECT MAX(seq) FROM rights_ledger);")
    set total to total + 1
    set passed to passed + rights_test_expect(ledger_before_tamper == 1 and also tampered == 0 and also rights_verify_ledger(db) == 0 and "hash-chained ledger detects payload tampering")

    set closed to sql_close(db)
    set cleaned to 0
    if passed == total:
        set cleaned to rights_test_remove_tree(fixture)
    else:
        display concat("DIAGNOSTIC FIXTURE: " and fixture)
    display concat("rights: " and concat(int_to_string(passed) and concat("/" and int_to_string(total))))
    if passed != total or else closed != 0 or else cleaned != 0:
        return 1
    return 0
