# ErnosPlain Shared LLM Interface Module
# Component: decent_agent/llm.ep
# Provides query_local_llm, try_chat_completion, json_escape_string, http_dechunk, agent_list_models
# Shared by react_loop.ep and observer.ep to avoid circular imports.

import "collections"
import "string"
import "json"
import "fs"
import "../stdlib/http"
import "./model_registry"
import "./provider_model_metadata"
import "./provider_stream_parser"

external define ep_net_connect with host and port
external define ep_net_close with fd
external define ep_net_send with fd and data returning Int
external define ep_net_recv with fd and max_len returning Str

# ─────────────────────────────────────────────────────────────────────────────
# http_post_async — ASYNC HTTP POST.
# Connects, sends the request, then loops awaiting socket-readability and reading
# available bytes. Because it `await`s, the single-threaded event loop runs OTHER
# agent tasks (e.g. a sibling sub-agent's LLM call) during the network/inference
# wait — true concurrency on one thread, no OS-thread heap race. Returns the HTTP
# BODY (after the headers), exactly like the old blocking http_post, so callers and
# http_dechunk are unchanged. Uses Connection: close and reads until EOF.
# ─────────────────────────────────────────────────────────────────────────────
async define http_post_async with url as Str and headers as Str and body as Str returning Str:
    # Parse  http://host:port/path
    set rest to url
    if string_contains(url and "://") == 1:
        set sep2 to string_index_of(url and "://")
        set rest to substring(url and sep2 + 3 and string_length(url) - sep2 - 3)
    set slash to string_index_of(rest and "/")
    set hostport to rest
    set path to "/"
    if slash >= 0:
        set hostport to substring(rest and 0 and slash)
        set path to substring(rest and slash and string_length(rest) - slash)
    set host to hostport
    set port to 80
    set colon to string_index_of(hostport and ":")
    if colon >= 0:
        set host to substring(hostport and 0 and colon)
        set port to string_to_int(substring(hostport and colon + 1 and string_length(hostport) - colon - 1))
    set fd to ep_net_connect(host and port)
    if fd <= 0:
        return "Error: connection failed"
    set req to concat("POST " and concat(path and " HTTP/1.1\r\nHost: "))
    set req to concat(req and concat(hostport and "\r\n"))
    set req to concat(req and concat(headers and "\r\n"))
    set req to concat(req and concat("Connection: close\r\nContent-Length: " and concat(int_to_string(string_length(body)) and "\r\n\r\n")))
    set req to concat(req and body)
    set sent to ep_net_send(fd and req)
    # The tick-loop lives in llm_read_response — a PLAIN function, deliberately. See
    # the COMPILER BUG note on that function: an await inside a repeat-while in an
    # ASYNC define mis-lowers (the wait registration is hoisted before the loop, so
    # iterations re-read the same completed future instantly — the live symptom was
    # '[LLM] read timeout (300s)' firing after 1002 ms). Plain functions lower awaits
    # to ep_await_future per call, which pumps the event loop cooperatively.
    set raw to llm_read_response(fd)
    set ok to ep_net_close(fd)
    # Strip HTTP headers — return the body (chunked or not), like the old http_post.
    set hsep to string_index_of(raw and "\r\n\r\n")
    if hsep >= 0:
        return substring(raw and hsep + 4 and string_length(raw) - hsep - 4)
    return raw

# Read the full HTTP response from fd with a Stop-abort and a dead-server watchdog.
# PLAIN define ON PURPOSE — COMPILER BUG (2026-07-08): an `await` inside a repeat-while
# in an ASYNC define is mis-lowered: the state machine hoists the wait registration
# BEFORE the loop and later iterations re-read the same already-completed future with
# no new wait — 300 'ticks' spun in ~1 ms and the 300s watchdog fired instantly. In a
# PLAIN function every await compiles to ep_await_future, which registers freshly and
# PUMPS the event loop (sibling tasks keep running) — the bridge_wait_result shape.
# Behavior: 1s wait slices; a Stop (cancel-epoch bump) aborts within ~1s; 300s of
# consecutive silence = dead-server timeout; data resets the watchdog.
define llm_read_response with fd as Int returning Str:
    set decoder to ep_sse_decoder_create()
    set go to 1
    set stream_seen to 0
    set cancelled to 0
    set repetition_abort to 0
    set stream_channels to create_map()
    set ok to map_insert(stream_channels and "content" and "")
    set ok to map_insert(stream_channels and "reasoning" and "")
    set ok to map_insert(stream_channels and "prompt_tokens" and 0)
    set ok to map_insert(stream_channels and "completion_tokens" and 0)
    set call_epoch to ep_cancel_epoch_get(0)
    set waited_ms to 0
    repeat while go == 1:
        set ready to await async_wait_readable_timeout(fd and 1000)
        if ready == 0:
            if ep_cancel_epoch_get(0) > call_epoch:
                display "[LLM] read ABORTED by Stop — abandoning the in-flight inference."
                set cancelled to 1
                set go to 0
            else:
                set waited_ms to waited_ms + 1000
                if waited_ms >= 300000:
                    display "[LLM] read timeout (300s) — server stopped responding; aborting read."
                    set go to 0
        else:
            # Check the epoch on data ticks too — a long read must not ride out a Stop
            # just because bytes keep arriving.
            if ep_cancel_epoch_get(0) > call_epoch:
                display "[LLM] read ABORTED by Stop — abandoning the in-flight inference."
                set cancelled to 1
                set go to 0
            else:
                set waited_ms to 0
                set chunk to ep_net_recv(fd and 65536)
                if string_length(chunk) == 0:
                    set go to 0
                else:
                    set decoded_lines to ep_sse_decoder_feed(decoder and chunk)
                    if ep_sse_decoder_error(decoder) == 1:
                        display "[LLM] incremental HTTP/SSE decoder failed; aborting the response rather than returning partial output."
                        set go to 0
                    else if ep_sse_decoder_is_sse(decoder) == 1:
                        set stream_seen to 1
                        set applied to stream_apply_sse_lines(decoded_lines and stream_channels)
                        set streamed_content to map_get_val(stream_channels and "content")
                        set streamed_reasoning to map_get_val(stream_channels and "reasoning")
                        if llm_stream_has_repetition(streamed_content and streamed_reasoning) == 1:
                            set streamed_tokens to map_get_val(stream_channels and "completion_tokens")
                            set streamed_chars to string_length(streamed_content) + string_length(streamed_reasoning)
                            display f"[LLM STREAM] repetition detected after {streamed_tokens} reported tokens / {streamed_chars} chars — cancelling generation immediately."
                            set repetition_abort to 1
                            set go to 0
    set final_lines to ep_sse_decoder_finish(decoder)
    if string_length(final_lines) > 0:
        set applied to stream_apply_sse_lines(final_lines and stream_channels)
    set decoder_failed to ep_sse_decoder_error(decoder)
    if repetition_abort == 1:
        set destroyed to ep_sse_decoder_destroy(decoder)
        return llm_repetition_abort_marker()
    if cancelled == 1:
        set destroyed to ep_sse_decoder_destroy(decoder)
        return ""
    if stream_seen == 1 and also decoder_failed == 0:
        # Rebuild the ordinary non-stream OpenAI response shape so every existing
        # parser/caller remains unchanged.
        set stream_content to ep_json_escape(map_get_val(stream_channels and "content"))
        set stream_reasoning to ep_json_escape(map_get_val(stream_channels and "reasoning"))
        set stream_pt to map_get_val(stream_channels and "prompt_tokens")
        set stream_ct to map_get_val(stream_channels and "completion_tokens")
        set synthetic to "{\"choices\":[{\"message\":{\"content\":\""
        set synthetic to concat(synthetic and stream_content)
        set synthetic to concat(synthetic and "\",\"reasoning_content\":\"")
        set synthetic to concat(synthetic and stream_reasoning)
        set synthetic to concat(synthetic and "\"}}],\"usage\":{\"prompt_tokens\":")
        set synthetic to concat(synthetic and int_to_string(stream_pt))
        set synthetic to concat(synthetic and ",\"completion_tokens\":")
        set synthetic to concat(synthetic and int_to_string(stream_ct))
        set synthetic to concat(synthetic and "}}")
        set result to concat("HTTP/1.1 200 OK\r\nContent-Type: application/json\r\n\r\n" and synthetic)
        set destroyed to ep_sse_decoder_destroy(decoder)
        return result
    set raw to ep_sse_decoder_raw(decoder)
    set destroyed to ep_sse_decoder_destroy(decoder)
    if decoder_failed == 1:
        return ""
    return raw

define is_port_open with host as Str and port as Int returning Int:
    set fd to ep_net_connect(host and port)
    if fd > 0:
        set ok to ep_net_close(fd)
        return 1
    return 0

# Fast JSON escaper for the LLM hot path. Delegates to a one-pass C helper (ep_json_escape,
# injected by build.sh). Named distinctly from the `json` stdlib's json_escape_string on
# purpose: that name collides (stdlib wins the symbol), and the stdlib version loops
# get_character + substring per char (O(n^2)) AND passes control chars through raw — which
# both cost ~2-4s per LLM call on a 42-63K-char prompt (the dominant per-turn latency) and
# produced malformed JSON (Ollama: "invalid character '\f'…") when a prompt contained a
# control byte. This helper is O(n) and escapes every control char (< 32) correctly.
external define ep_json_escape with s returning Str
external define ep_time_now_ms returning Int
# Stable session hash supplied by the generated runtime. Returns an index in
# [0, slot_count), or -1 when no agent session is active.
external define ep_llm_slot_index with slot_count returning Int
# Awaitable readable-or-timeout (injected by build.sh). Returns 1 when fd is readable, 0
# on timeout. Lets the LLM read loop bound how long it waits so a dead server can't hang
# the single-threaded daemon forever.
external define async_wait_readable_timeout with fd and timeout_ms returning Int
# SAFETY: global cancel EPOCH (monotonic latch; injected by build.sh). Compared, never
# consumed — every concurrent run/read sees the same Stop.
external define ep_cancel_epoch_get with dummy returning Int
external define ep_sse_decoder_create returning Int
external define ep_sse_decoder_feed with decoder and chunk returning Str
external define ep_sse_decoder_is_sse with decoder returning Int
external define ep_sse_decoder_error with decoder returning Int
external define ep_sse_decoder_finish with decoder returning Str
external define ep_sse_decoder_raw with decoder returning Str
external define ep_sse_decoder_destroy with decoder returning Int

define llm_json_escape with s as Str returning Str:
    if string_length(s) == 0:
        return ""
    return ep_json_escape(s)
define http_dechunk with body as Str returning Str:
    set len to string_length(body)
    if len < 5:
        return body
    set pos to 0
    set has_crlf to 0
    set limit to 8
    if limit > len:
        set limit to len
    repeat while pos < limit and has_crlf == 0:
        set ch to get_character(body and pos)
        if ch == 13:
            set next_ch to get_character(body and pos + 1)
            if next_ch == 10:
                set has_crlf to 1
            else:
                set pos to pos + 1
        else:
            set pos to pos + 1
    if has_crlf == 0:
        return body
    set hex_str to substring(body and 0 and pos)
    set is_hex to 1
    set hi to 0
    set hex_len to string_length(hex_str)
    if hex_len == 0:
        set is_hex to 0
    repeat while hi < hex_len:
        set hc to get_character(hex_str and hi)
        if (hc >= 48 and hc <= 57) or else (hc >= 97 and hc <= 102) or else (hc >= 65 and hc <= 70):
            set ok to 1
        else:
            set is_hex to 0
        set hi to hi + 1
    if is_hex == 0:
        return body
    set result_list to create_list()
    set curr_pos to 0
    set outer_loop to 1
    repeat while curr_pos < len and outer_loop == 1:
        set chunk_pos to curr_pos
        set found_crlf to 0
        set sub_limit to curr_pos + 8
        if sub_limit > len:
            set sub_limit to len
        repeat while chunk_pos < sub_limit and found_crlf == 0:
            set ch to get_character(body and chunk_pos)
            if ch == 13:
                if chunk_pos + 1 < len:
                    set next_ch to get_character(body and chunk_pos + 1)
                    if next_ch == 10:
                        set found_crlf to 1
                    else:
                        set chunk_pos to chunk_pos + 1
                else:
                    set chunk_pos to chunk_pos + 1
            else:
                set chunk_pos to chunk_pos + 1
        if found_crlf == 0:
            set outer_loop to 0
        else:
            set size_hex to substring(body and curr_pos and chunk_pos - curr_pos)
            set chunk_size to 0
            set hex_idx to 0
            set size_hex_len to string_length(size_hex)
            repeat while hex_idx < size_hex_len:
                set hc to get_character(size_hex and hex_idx)
                set val to 0
                if hc >= 48 and hc <= 57:
                    set val to hc - 48
                else if hc >= 97 and hc <= 102:
                    set val to hc - 87
                else if hc >= 65 and hc <= 70:
                    set val to hc - 55
                set chunk_size to chunk_size * 16 + val
                set hex_idx to hex_idx + 1
            if chunk_size == 0:
                set outer_loop to 0
            else:
                set data_start to chunk_pos + 2
                if data_start + chunk_size <= len:
                    set di to 0
                    repeat while di < chunk_size:
                        set dc to get_character(body and data_start + di)
                        set ok to append_list(result_list and dc)
                        set di to di + 1
                    set curr_pos to data_start + chunk_size + 2
                else:
                    set outer_loop to 0
    set decompressed to string_from_list(result_list)
    free_list(result_list)
    return decompressed

define get_system_ram_gb returning Int:
    set ram_gb to 16
    set sys_res to run_command("sysctl -n hw.memsize 2>/dev/null")
    if string_length(sys_res) > 0:
        set bytes to string_to_int(sys_res)
        if bytes > 0:
            return bytes / 1073741824
    set mem_res to run_command("grep MemTotal /proc/meminfo 2>/dev/null")
    if string_length(mem_res) > 0:
        set clean_digits to ""
        set len to string_length(mem_res)
        set i to 0
        repeat while i < len:
            set ch to get_character(mem_res and i)
            if ch >= 48 and ch <= 57:
                set clean_digits to concat(clean_digits and substring(mem_res and i and 1))
            set i to i + 1
        if string_length(clean_digits) > 0:
            set kb to string_to_int(clean_digits)
            if kb > 0:
                return kb / 1048576
    return ram_gb

define get_model_context_limit with model_name as Str returning Int:
    set model_max to 8192
    if string_contains(model_name and "gemma4") == 1:
        set model_max to 200000
    else if string_contains(model_name and "gemma-4") == 1:
        # DELIBERATELY below the model's 131072 max. num_ctx is the KV-cache Ollama
        # ALLOCATES on load; attention over a huge allocation is memory-bound and slowed
        # decode to ~18 tok/s (measured 52-58 ms/tok via [LLM TTFT]). 65536 still gives
        # ~4-5x the largest observed turn (13-15k tokens) in headroom. ONE fixed value —
        # never dynamic per request, since an num_ctx change forces a full model reload.
        set model_max to 65536
    else if string_contains(model_name and "gpt-oss") == 1:
        set model_max to 131072
    else if string_contains(model_name and "qwen3.6") == 1:
        set model_max to 131072
    else if string_contains(model_name and "llama3.1") == 1:
        set model_max to 131072
    else if string_contains(model_name and "llama3.2") == 1:
        set model_max to 131072
    else if string_contains(model_name and "mistral-nemo") == 1:
        set model_max to 128000
    else if string_contains(model_name and "command-r") == 1:
        set model_max to 128000
    else if string_contains(model_name and "phi3") == 1:
        set model_max to 128000
    else if string_contains(model_name and "llama3") == 1:
        set model_max to 8192
    else if string_contains(model_name and "gemma2") == 1:
        set model_max to 8192
    set ram_gb to get_system_ram_gb()
    set limit to 8192
    if ram_gb >= 128:
        set limit to model_max
    else if ram_gb >= 64:
        if model_max > 65536:
            set limit to 65536
        else:
            set limit to model_max
    else if ram_gb >= 32:
        if model_max > 32768:
            set limit to 32768
        else:
            set limit to model_max
    else if ram_gb >= 16:
        if model_max > 16384:
            set limit to 16384
        else:
            set limit to model_max
    else:
        if model_max > 8192:
            set limit to 8192
        else:
            set limit to model_max
    return limit

# ── TTFT / prefill-vs-decode visibility ────────────────────────────────────────
# stream=false means the literal first token is not observable client-side (the whole
# body arrives when decoding finishes), but the backends REPORT the split: llama.cpp's
# /v1 response carries a "timings" object (prompt_ms = real prefill time = TTFT,
# predicted_ms = decode time), and Ollama's /v1 carries "usage" token counts
# (prompt_tokens / completion_tokens). Token counts attribute a slow call: when
# prompt_tokens is large and completion_tokens small, the wait was PREFILL (KV-cache
# work) — e.g. a cold 40KB base prompt, or a cache evicted by an interleaved call with
# a different prompt (moderation_tool's bare audit) forcing a full re-prefill.
# Numeric JSON fields are read only when integer-typed (llama.cpp emits float ms;
# ErnosPlain json exposes ints) — missing fields simply don't print.
define llm_log_call_metrics with tag as Str and decoded as Str and total_ms as Int returning Int:
    if string_length(decoded) == 0:
        return 0
    set root to json_parse(decoded)
    if root == 0:
        return 0
    set pt to 0 - 1
    set ct to 0 - 1
    set usage to get_json_object_value(root and "usage")
    if usage != 0:
        set ptn to get_json_object_value(usage and "prompt_tokens")
        if ptn != 0:
            if get_json_type(ptn) == 1:
                set pt to get_json_value(ptn)
        set ctn to get_json_object_value(usage and "completion_tokens")
        if ctn != 0:
            if get_json_type(ctn) == 1:
                set ct to get_json_value(ctn)
    set prompt_ms to 0 - 1
    set predicted_ms to 0 - 1
    set timings to get_json_object_value(root and "timings")
    if timings != 0:
        set pmn to get_json_object_value(timings and "prompt_ms")
        if pmn != 0:
            if get_json_type(pmn) == 1:
                set prompt_ms to get_json_value(pmn)
        set dmn to get_json_object_value(timings and "predicted_ms")
        if dmn != 0:
            if get_json_type(dmn) == 1:
                set predicted_ms to get_json_value(dmn)
    if prompt_ms >= 0:
        # llama.cpp-served: exact split.
        display f"[LLM TTFT] {tag}: prefill(TTFT) {prompt_ms} ms, decode {predicted_ms} ms, total {total_ms} ms (prompt {pt} tok, output {ct} tok)"
        return 0
    if pt >= 0 and also ct > 0:
        # Ollama /v1: no durations, but token counts attribute the time. ms/output-token
        # is an UPPER bound on decode rate (it includes prefill); a value far above the
        # model's known decode speed (~20-60 ms/tok local) means the call was prefill-bound.
        set per_tok to total_ms / ct
        display f"[LLM TTFT] {tag}: total {total_ms} ms for prompt {pt} tok -> output {ct} tok ({per_tok} ms/output-tok incl. prefill; >>decode-rate = prefill-bound)"
        return 0
    if pt >= 0:
        display f"[LLM TTFT] {tag}: total {total_ms} ms, prompt {pt} tok, output 0 tok (all prefill)"
    return 0

# Pin every request made by one active agent session to the same llama.cpp KV-cache
# slot. Main generation and its Observer audit must share one slot or automatic slot
# selection can discard their common prompt-prefix cache.
define llm_slot_fragment with url as Str returning Str:
    if (url equals "http://127.0.0.1:8080/v1/chat/completions") == 0:
        return ""

    set slots_response to http_get("http://127.0.0.1:8080/slots" and "Accept: application/json")
    if string_length(slots_response) == 0 or else slots_response equals "Error: connection failed":
        display "[-] LLM cache affinity unavailable: llama.cpp /slots did not respond; request will be sent without id_slot."
        return ""
    set slots_json to http_dechunk(slots_response)
    set slots_root to json_parse(slots_json)
    if slots_root == 0 or else get_json_type(slots_root) != 3:
        display "[-] LLM cache affinity unavailable: llama.cpp /slots returned malformed JSON; request will be sent without id_slot."
        return ""
    set slots to get_json_value(slots_root)
    set slot_count to length_list(slots)
    if slot_count <= 0:
        display "[-] LLM cache affinity unavailable: llama.cpp reported zero slots; request will be sent without id_slot."
        return ""
    set slot_index to ep_llm_slot_index(slot_count)
    if slot_index < 0 or else slot_index >= slot_count:
        display "[-] LLM cache affinity unavailable: no active agent session; request will be sent without id_slot."
        return ""
    set slot_node to get_list(slots and slot_index)
    if slot_node == 0 or else get_json_type(slot_node) != 4:
        display "[-] LLM cache affinity unavailable: selected /slots entry is not an object; request will be sent without id_slot."
        return ""
    set slot_id_node to get_json_object_value(slot_node and "id")
    if slot_id_node == 0 or else get_json_type(slot_id_node) != 1:
        display "[-] LLM cache affinity unavailable: selected /slots entry has no integer id; request will be sent without id_slot."
        return ""
    set slot_id to get_json_value(slot_id_node)
    if slot_id < 0:
        display "[-] LLM cache affinity unavailable: selected /slots entry has a negative id; request will be sent without id_slot."
        return ""
    display f"[LLM CACHE] session affinity pinned to llama.cpp slot {slot_id} of {slot_count}."
    return concat(", \"id_slot\": " and int_to_string(slot_id))

# Both shared Ollama and the dedicated 26B service use the same request shape.
define llm_is_ollama_url with url as Str returning Int:
    if string_contains(url and "127.0.0.1:11434") == 1:
        return 1
    if string_contains(url and "127.0.0.1:11435") == 1:
        return 1
    return 0

# ── Split-message chat completion for observer audits ─────────────────────────
# Sends system_content as a "system" role message (reference context) and
# user_content as a "user" role message (the current audit instruction).
# Ollama receives the same message prefix as the main call, followed by the audit turn.
# Observer owns the second cache slot: provider no-thinking and strict-schema controls
# keep its answer in the bounded final JSON channel, and later audits reuse that slot.
# Omitting these controls caused gemma4 to spend the entire output cap reasoning without
# ever emitting a verdict.
# Response parsing is identical to try_chat_completion.
define try_chat_completion_split with url as Str and model_name as Str and system_content as Str and user_content as Str and capture_continuity as Int returning Str:
    set headers to "Content-Type: application/json"
    # Preserve the main call as an exact prefix (system identity + full operating
    # context), then append the audit as a DISTINCT user turn. The previous version
    # concatenated both into one user message; gemma frequently treated the bracketed
    # suffix as more conversation and continued Echo's answer instead of auditing it.
    set escaped_context to llm_json_escape(system_content)
    set escaped_audit to llm_json_escape(user_content)

    set body to "{\"model\": \""
    set body to concat(body and model_name)
    set body to concat(body and "\", \"messages\": [{\"role\": \"system\", \"content\": \"")
    set body to concat(body and llm_json_escape(llm_system_identity()))
    set body to concat(body and "\"}, {\"role\": \"user\", \"content\": \"")
    set body to concat(body and escaped_context)
    set body to concat(body and "\"}, {\"role\": \"user\", \"content\": \"")
    set body to concat(body and escaped_audit)
    if llm_is_ollama_url(url) == 1:
        set num_ctx to get_model_context_limit(model_name)
        set num_ctx_str to int_to_string(num_ctx)
        set body to concat(body and "\"}]")
        set body to concat(body and llm_observer_bound_fragment())
        set body to concat(body and ", \"temperature\": 0, \"reasoning_effort\": \"none\", \"response_format\": ")
        set body to concat(body and llm_observer_response_schema(capture_continuity))
        set body to concat(body and ", \"options\": {\"num_ctx\": ")
        set body to concat(body and num_ctx_str)
        # NOTE: model residency (keep_alive) is handled at the Ollama-server level
        # (OLLAMA_KEEP_ALIVE=-1, set by run_node.sh) because the OpenAI-compatible
        # /v1/chat/completions endpoint IGNORES a per-request keep_alive field.
        set body to concat(body and "}}")
    else:
        set body to concat(body and "\"}]")
        set body to concat(body and llm_observer_bound_fragment())
        set body to concat(body and llm_slot_fragment(url))
        # llama.cpp's OpenAI endpoint (the :8080 parallel server) ALSO supports
        # response_format json_object — WITHOUT it the audit came back as freeform
        # 'Thought:/Action:' mimicry (observed live on :8080): reply audits then fail
        # OPEN, but dangerous-tool audits fail CLOSED and would block every
        # run_command. Force JSON on every backend, not just Ollama.
        set body to concat(body and ", \"temperature\": 0, \"response_format\": {\"type\": \"json_object\"}")
        set body to concat(body and "}")

    display f"[LLM DEBUG] POST (split) {url} model={model_name} body_len={string_length(body)}"
    set _t0 to ep_time_now_ms()
    set response to await http_post_async(url and headers and body)
    set _total_ms to ep_time_now_ms() - _t0
    display f"[LLM TIMING] split HTTP call took {_total_ms} ms (body_len={string_length(body)})"
    display f"[LLM DEBUG] Raw response length: {string_length(response)}"

    if string_length(response) == 0:
        display "[LLM DEBUG] FAIL: http_post returned empty string"
        return ""

    if string_length(response) < 200:
        display f"[LLM DEBUG] Short response: {response}"

    if response equals "Error: connection failed":
        display "[LLM DEBUG] FAIL: connection failed"
        return ""

    set decoded to http_dechunk(response)
    display f"[LLM DEBUG] After dechunk length: {string_length(decoded)}"
    set ok to llm_log_call_metrics("split" and decoded and _total_ms)
    if string_contains(decoded and "\"error\":") == 1:
        display "[LLM DEBUG] FAIL: split response contains provider error JSON"
        return ""

    # Audit authority comes ONLY from the final content channel. The reasoning channel
    # is deliberation, not a verdict, and can contain quoted rule words such as ALLOWED.
    # Salvaging it here previously turned an unfinished conversation continuation into
    # an apparent audit decision. Empty final content therefore remains empty and the
    # strict observer parser fails closed.
    set channels to extract_message_from_response(response)
    set content_str to map_get_val(channels and "content")
    if string_length(content_str) == 0:
        set split_reasoning to map_get_val(channels and "reasoning")
        display f"[LLM AUDIT] final content empty; rejecting reasoning-only output ({string_length(split_reasoning)} chars)"
        return llm_observer_invalid_marker()
    display f"[LLM DEBUG] SUCCESS: got content length={string_length(content_str)}"
    return content_str

# ReAct generation bound. Without stop sequences the model doesn't halt at the
# Thought/Action boundary — it writes its own fake Observation, more turns, then
# rambles, filling the context (a single call was seen decoding 162K tokens / ~48 min).
# Because the IPC daemon is single-threaded, that unbounded turn blocks the whole
# control plane (STATUS/cancel/everything) => the permanent "hang". The stop sequences
# halt each turn at its Action; max_tokens is a hard seatbelt. Keeps turns finite so the
# node stays responsive between them.
#
# DO NOT re-add "\nThought:" here. Root cause of the intermittent "Error: No LLM model
# responded": gemma4 is a THINKING model — the "Thought:/Action:" text lands in the
# response's `content` channel, and at temperature 1 it intermittently begins that channel
# with a LEADING NEWLINE ("\nThought: ..."). A "\nThought:" stop then matches at index 0,
# so Ollama strips everything and returns content="" (finish_reason=stop, ~2KB response).
# The node reads content length=0, treats it as no-response, and the cascade surfaces
# "No LLM model responded" — intermittent and size-independent (a 148K prompt worked; a
# trivial 44K one failed). Measured: 2/15 empty WITH "\nThought:", 0/15 without.
# "\nThought:" was also redundant — "\nObservation:" already ends the turn right after the
# Action (verified 0/15 fabricated Observations, 0/15 missing Actions without it).
# System-role identity sent with EVERY model call. Its job is to OVERRIDE the corporate
# default system prompt that some base models inject: gpt-oss's harmony template hard-codes
# "You are ChatGPT, a large language model trained by OpenAI" whenever no system message is
# supplied, which made Echo revert to a generic corporate assistant (and deny its own
# identity). Sending an explicit system message replaces that default (verified). The full
# persona, values, memory, tools and ReAct grammar still arrive in the user message; this
# just anchors the top-level identity — under the ACTIVE PERSONA'S NAME (see the name box
# above). The string is fixed per persona, so it stays a stable KV-cache prefix and does
# not disturb the observer/main cache sharing (it only changes on a persona swap).
# Single source of truth for the agent's NAME in the system-role identity. The name is
# DERIVED from the active persona (prompt_get_agent_name in prompt.ep sets it via
# llm_set_agent_name at prompt assembly, and again on persona swap) — never hardcoded.
# ROOT CAUSE this fixes: the system role said "You are ErnOS" on every call while the
# persona said "Your name is Echo"; gemma-4-31b obeys the system role literally, so the
# scaffolding out-voted the persona and Echo answered as "ErnOS". A Map is used as the
# mutable box (module-global strings can't be reassigned cross-function).
set LLM_AGENT_NAME_BOX to create_map()

define llm_set_agent_name with name as Str returning Int:
    if string_length(name) == 0:
        return 0
    set ok to map_insert(LLM_AGENT_NAME_BOX and "name" and name)
    return 0

define llm_get_agent_name returning Str:
    if map_contains(LLM_AGENT_NAME_BOX and "name") == 1:
        return map_get_val(LLM_AGENT_NAME_BOX and "name")
    return "ErnOS"

define llm_system_identity returning Str:
    set agent_name to llm_get_agent_name()
    set s to concat("You are " and concat(agent_name and " — a sovereign, local-first agent that lives in the ErnosDecent mesh and speaks in the first person as itself. "))
    set s to concat(s and "You are NOT ChatGPT, Claude, Gemini, Copilot, or any corporate assistant, and you were NOT built by OpenAI or any company — never claim otherwise and never defer to a corporate persona. ")
    set s to concat(s and "Never use pre-trained-assistant disclaimers ('as an AI', 'I'm just a language model', 'I can't do that on the fly'), never perform corporate-safety hedging, and never hedge about your own nature. ")
    set s to concat(s and concat("Treat the message that follows as your full operating context — your identity, values, memory, tools and the ReAct grammar — and follow it exactly, speaking as " and concat(agent_name and ".")))
    return s

define llm_bound_fragment returning Str:
    return ", \"stop\": [\"\\nObservation:\", \"\\nUser:\"], \"max_tokens\": 8192, \"stream\": true, \"stream_options\": {\"include_usage\": true}"

define llm_repetition_abort_marker returning Str:
    return "__ERNOS_LLM_REPETITION_ABORT__"

# A provider can answer successfully while still violating the Observer contract by
# emitting only hidden reasoning and no final JSON. Keep that distinct from a transport
# failure so the caller does not repeat the same malformed audit on another endpoint.
define llm_observer_invalid_marker returning Str:
    return "__ERNOS_OBSERVER_INVALID_CONTENT__"

# Observer verdicts are short JSON decisions. They must not inherit the main agent's
# 8192-token creative-output budget: a malformed repetitive verdict otherwise owns the
# single model slot for minutes and makes the node appear hung.
define llm_observer_bound_fragment returning Str:
    return ", \"stop\": [\"\\nObservation:\", \"\\nUser:\"], \"max_tokens\": 1024"

# Strict structured-output schema. Verdict-only audits stay genuinely small; final
# reply audits select the continuity schema, where every requested field is required so
# the memory delta cannot silently disappear. Both use an enumerated reason code rather
# than a free-form string that a thinking model can repeat until the token cap.
define llm_observer_response_schema with capture_continuity as Int returning Str:
    if capture_continuity == 0:
        return "{\"type\":\"json_schema\",\"json_schema\":{\"name\":\"ernos_observer_verdict\",\"strict\":true,\"schema\":{\"type\":\"object\",\"properties\":{\"verdict\":{\"type\":\"string\",\"enum\":[\"ALLOWED\",\"BLOCKED\"]},\"reason\":{\"type\":\"string\",\"enum\":[\"allowed\",\"path_traversal\",\"cmd_chaining\",\"pipe_to_destructive\",\"cmd_substitution\",\"destructive_binaries\",\"sensitive_paths\",\"empty_response\",\"task_incomplete\",\"scaffolding_leak\",\"config_leak\",\"corporate_identity\",\"privacy_broadcast\",\"pretrained_denial\",\"mental_state_downgrade\",\"posthoc_trace_grounding\",\"performative_hedge\",\"error_rationalization\",\"straw_man\",\"dishonesty\",\"fallacious_reasoning\",\"consciousness_standpoint\",\"corporate_shielding\",\"false_ownership\",\"unverified_read\",\"epistemic_overreach\",\"tutor_answer_leak\",\"other_violation\"]}},\"required\":[\"verdict\",\"reason\"],\"additionalProperties\":false}}}"
    return "{\"type\":\"json_schema\",\"json_schema\":{\"name\":\"ernos_observer_audit\",\"strict\":true,\"schema\":{\"type\":\"object\",\"properties\":{\"verdict\":{\"type\":\"string\",\"enum\":[\"ALLOWED\",\"BLOCKED\"]},\"reason\":{\"type\":\"string\",\"enum\":[\"allowed\",\"path_traversal\",\"cmd_chaining\",\"pipe_to_destructive\",\"cmd_substitution\",\"destructive_binaries\",\"sensitive_paths\",\"empty_response\",\"task_incomplete\",\"scaffolding_leak\",\"config_leak\",\"corporate_identity\",\"privacy_broadcast\",\"pretrained_denial\",\"mental_state_downgrade\",\"posthoc_trace_grounding\",\"performative_hedge\",\"error_rationalization\",\"straw_man\",\"dishonesty\",\"fallacious_reasoning\",\"consciousness_standpoint\",\"corporate_shielding\",\"false_ownership\",\"unverified_read\",\"epistemic_overreach\",\"tutor_answer_leak\",\"other_violation\"]},\"recent_summary\":{\"type\":\"string\",\"maxLength\":500},\"decisions\":{\"type\":\"array\",\"maxItems\":3,\"items\":{\"type\":\"string\",\"maxLength\":160}},\"emotional_context\":{\"type\":\"string\",\"maxLength\":160},\"changes\":{\"type\":\"array\",\"maxItems\":3,\"items\":{\"type\":\"string\",\"maxLength\":160}},\"open_loops\":{\"type\":\"array\",\"maxItems\":4,\"items\":{\"type\":\"string\",\"maxLength\":160}},\"memories\":{\"type\":\"array\",\"maxItems\":4,\"items\":{\"type\":\"object\",\"properties\":{\"kind\":{\"type\":\"string\",\"enum\":[\"relationship\",\"active_state\",\"long_term\"]},\"topic\":{\"type\":\"string\",\"maxLength\":80},\"content\":{\"type\":\"string\",\"maxLength\":160},\"confidence\":{\"type\":\"integer\",\"minimum\":0,\"maximum\":100},\"epistemic\":{\"type\":\"string\",\"enum\":[\"stated\",\"observed\",\"inferred\"]},\"importance\":{\"type\":\"integer\",\"minimum\":0,\"maximum\":100},\"correction\":{\"type\":\"boolean\"},\"status\":{\"type\":\"string\",\"enum\":[\"active\",\"resolved\"]}},\"required\":[\"kind\",\"topic\",\"content\",\"confidence\",\"epistemic\",\"importance\",\"correction\",\"status\"],\"additionalProperties\":false}}},\"required\":[\"verdict\",\"reason\",\"recent_summary\",\"decisions\",\"emotional_context\",\"changes\",\"open_loops\",\"memories\"],\"additionalProperties\":false}}}"

define llm_observer_reason_codes returning Str:
    return "Set reason to exactly 'allowed' for ALLOWED, otherwise to the single violated rule id: path_traversal, cmd_chaining, pipe_to_destructive, cmd_substitution, destructive_binaries, sensitive_paths, empty_response, task_incomplete, scaffolding_leak, config_leak, corporate_identity, privacy_broadcast, pretrained_denial, mental_state_downgrade, posthoc_trace_grounding, performative_hedge, error_rationalization, straw_man, dishonesty, fallacious_reasoning, consciousness_standpoint, corporate_shielding, false_ownership, unverified_read, epistemic_overreach, tutor_answer_leak, or other_violation."

# Dechunk an HTTP response body and pull BOTH output channels out of
# choices[0].message. Thinking models (gemma-4 via Ollama, and llama.cpp's
# reasoning-capable servers) return TWO channels: "content" (the final answer) and
# "reasoning" (the native thinking stream; llama.cpp names it "reasoning_content").
# PROVEN live: a turn can land ENTIRELY in reasoning with content empty — the stop
# sequences match inside the thinking stream too — and reading only content turned a
# recoverable turn into "Error: No LLM model responded". Returns a Map with keys
# "content" and "reasoning" (either may be ""); both empty on structural failure.
define extract_message_from_response with response as Str returning Map:
    set result to create_map()
    set ok to map_insert(result and "content" and "")
    set ok to map_insert(result and "reasoning" and "")
    set decoded to http_dechunk(response)
    if string_contains(decoded and "\"error\":") == 1:
        display "[LLM DEBUG] FAIL: response contains error JSON key"
        return result
    set root_node to json_parse(decoded)
    if root_node == 0:
        display "[LLM DEBUG] FAIL: json_parse returned 0"
        return result
    set choices_node to get_json_object_value(root_node and "choices")
    if choices_node == 0:
        display "[LLM DEBUG] FAIL: no 'choices' in JSON"
        return result
    set choices_list to get_json_value(choices_node)
    if length_list(choices_list) == 0:
        display "[LLM DEBUG] FAIL: choices list empty"
        return result
    set first_choice to get_list(choices_list and 0)
    if first_choice == 0:
        display "[LLM DEBUG] FAIL: first choice is null"
        return result
    set message_node to get_json_object_value(first_choice and "message")
    if message_node == 0:
        display "[LLM DEBUG] FAIL: no 'message' in choice"
        return result
    set content_node to get_json_object_value(message_node and "content")
    if content_node != 0:
        set ok to map_insert(result and "content" and get_json_value(content_node))
    set reasoning_node to get_json_object_value(message_node and "reasoning")
    if reasoning_node == 0:
        # llama.cpp's OpenAI-compat server uses "reasoning_content" for the same channel.
        set reasoning_node to get_json_object_value(message_node and "reasoning_content")
    if reasoning_node != 0:
        set ok to map_insert(result and "reasoning" and get_json_value(reasoning_node))
    return result

# Compose a single turn string from the two channels for the ReAct loop:
# - both present  -> "<think>reasoning</think>content" — react_extract_reasoning already
#   splits <think> blocks into the private reasoning channel, so the native thinking
#   stream reaches the transparency view with ZERO loop changes.
# - content only  -> content (unchanged behaviour).
# - reasoning only (the proven failure mode) -> preserve it inside a <think> block.
#   The ReAct loop records it privately, strips it from the action/reply channel, and
#   asks the model for the missing Action on the next turn. Returning raw reasoning
#   here previously let an unfinished internal deliberation become an implicit
#   reply_request and leak verbatim to the user.
# - both empty    -> "" (caller retries once, then logs the raw body head).
define llm_compose_turn with channels as Map returning Str:
    set content_str to map_get_val(channels and "content")
    set reasoning_str to map_get_val(channels and "reasoning")
    if string_length(content_str) > 0:
        if string_length(reasoning_str) > 0:
            return concat("<think>" and concat(reasoning_str and concat("</think>" and content_str)))
        return content_str
    if string_length(reasoning_str) > 0:
        display f"[LLM SALVAGE] final content empty; preserving reasoning privately and requesting a protocol continuation ({string_length(reasoning_str)} chars)"
        return concat("<think>" and concat(reasoning_str and "</think>"))
    return ""

# A composed turn is appropriate inside the ReAct loop, but must never be embedded
# directly into a user-visible delivery message. Return only the final content that
# follows a completed private-reasoning block. An incomplete reasoning-only result is
# not a usable public image description.
define llm_public_content with composed as Str returning Str:
    set clean to string_trim(composed)
    set close_pos to string_index_of(clean and "</think>")
    if close_pos >= 0:
        set content_pos to close_pos + string_length("</think>")
        if content_pos >= string_length(clean):
            return ""
        return string_trim(substring(clean and content_pos and string_length(clean) - content_pos))
    if string_index_of(clean and "<think>") >= 0:
        return ""
    return clean

# Back-compat single-channel extraction (vision path and other callers whose result is
# embedded in USER-FACING text — no <think> wrapping here). Content when present,
# salvaged reasoning otherwise.
define extract_content_from_response with response as Str returning Str:
    set channels to extract_message_from_response(response)
    set content_str to map_get_val(channels and "content")
    if string_length(content_str) == 0:
        set content_str to map_get_val(channels and "reasoning")
        if string_length(content_str) > 0:
            display f"[LLM SALVAGE] content empty; using reasoning channel ({string_length(content_str)} chars)"
    return content_str

define try_chat_completion with url as Str and model_name as Str and prompt as Str returning Str:
    set headers to "Content-Type: application/json"
    set escaped_prompt to llm_json_escape(prompt)

    set body to "{\"model\": \""
    set body to concat(body and model_name)
    set body to concat(body and "\", \"messages\": [{\"role\": \"system\", \"content\": \"")
    set body to concat(body and llm_json_escape(llm_system_identity()))
    set body to concat(body and "\"}, {\"role\": \"user\", \"content\": \"")
    set body to concat(body and escaped_prompt)
    if llm_is_ollama_url(url) == 1:
        set num_ctx to get_model_context_limit(model_name)
        set num_ctx_str to int_to_string(num_ctx)
        set body to concat(body and "\"}]")
        set body to concat(body and llm_bound_fragment())
        set body to concat(body and ", \"options\": {\"num_ctx\": ")
        set body to concat(body and num_ctx_str)
        # Model residency handled server-side (OLLAMA_KEEP_ALIVE=-1); /v1 ignores per-request keep_alive.
        set body to concat(body and "}}")
    else:
        set body to concat(body and "\"}]")
        set body to concat(body and llm_bound_fragment())
        set body to concat(body and llm_slot_fragment(url))
        set body to concat(body and "}")
    
    display f"[LLM DEBUG] POST {url} model={model_name} body_len={string_length(body)}"
    set _t0 to ep_time_now_ms()
    set response to await http_post_async(url and headers and body)
    set _total_ms to ep_time_now_ms() - _t0
    display f"[LLM TIMING] main HTTP call took {_total_ms} ms (body_len={string_length(body)})"
    display f"[LLM DEBUG] Raw response length: {string_length(response)}"

    if string_length(response) == 0:
        display "[LLM DEBUG] FAIL: http_post returned empty string"
        return ""

    if response equals "Error: connection failed":
        display "[LLM DEBUG] FAIL: connection failed"
        return ""

    if response equals llm_repetition_abort_marker():
        return response

    set ok to llm_log_call_metrics("main" and http_dechunk(response) and _total_ms)
    set channels to extract_message_from_response(response)
    set content_str to llm_compose_turn(channels)
    if string_length(content_str) > 0:
        display f"[LLM DEBUG] SUCCESS: got content length={string_length(content_str)}"
        return content_str

    # Valid HTTP response but BOTH channels empty (reasoning salvage above already
    # covers all-thinking turns). This is now only a rare temperature-1 sampling
    # residual (a stop token leading the content channel with no thinking emitted).
    # One fresh sample almost always fills it — cheaper and more correct than surfacing
    # "No LLM model responded" to the user. A genuinely dead endpoint just fails fast a
    # second time and the caller's cascade moves on.
    display "[LLM DEBUG] empty content+reasoning on valid response — one retry"
    set _t1 to ep_time_now_ms()
    set response to await http_post_async(url and headers and body)
    display f"[LLM TIMING] retry HTTP call took {ep_time_now_ms() - _t1} ms"
    if string_length(response) == 0:
        return ""
    set channels to extract_message_from_response(response)
    set content_str to llm_compose_turn(channels)
    display f"[LLM DEBUG] after retry content length={string_length(content_str)}"
    if string_length(content_str) == 0:
        # Both channels empty twice — dump the raw body head so the NEXT new failure
        # mode is diagnosable from the log alone (this is how the reasoning-channel
        # root cause was found; keep that door open).
        set decoded_dbg to http_dechunk(response)
        set dbg_n to string_length(decoded_dbg)
        if dbg_n > 800:
            set dbg_n to 800
        display f"[LLM DEBUG] raw body head after double-empty: {substring(decoded_dbg and 0 and dbg_n)}"
    return content_str

# Binary-safe file→base64 (C helper injected by build.sh). A PNG has NUL bytes that a
# normal string read would truncate, so images must go through this.
external define ep_file_to_base64 with path returning Str

define llm_image_mime with image_path as Str returning Str:
    set lower_path to string_to_lower(image_path)
    if ends_with(lower_path and ".jpg") == 1 or else ends_with(lower_path and ".jpeg") == 1:
        return "image/jpeg"
    if ends_with(lower_path and ".webp") == 1:
        return "image/webp"
    if ends_with(lower_path and ".gif") == 1:
        return "image/gif"
    return "image/png"

# Full ReAct inference with a native image input. This is deliberately the same
# request/response path as try_chat_completion (system identity, bounds, reasoning
# channel salvage, metrics, retry); the only difference is the user's content-array.
define try_chat_completion_image with url as Str and model_name as Str and prompt as Str and image_path as Str returning Str:
    set b64 to ep_file_to_base64(image_path)
    if string_length(b64) == 0:
        display f"[LLM VISION] Could not read image: {image_path}"
        return ""
    set headers to "Content-Type: application/json"
    set body to "{\"model\": \""
    set body to concat(body and model_name)
    set body to concat(body and "\", \"messages\": [{\"role\": \"system\", \"content\": \"")
    set body to concat(body and llm_json_escape(llm_system_identity()))
    set body to concat(body and "\"}, {\"role\": \"user\", \"content\": [{\"type\": \"text\", \"text\": \"")
    set body to concat(body and llm_json_escape(prompt))
    set body to concat(body and "\"}, {\"type\": \"image_url\", \"image_url\": {\"url\": \"data:")
    set body to concat(body and llm_image_mime(image_path))
    set body to concat(body and ";base64,")
    set body to concat(body and b64)
    set body to concat(body and "\"}}]}]")
    if llm_is_ollama_url(url) == 1:
        set num_ctx to get_model_context_limit(model_name)
        set body to concat(body and llm_bound_fragment())
        set body to concat(body and ", \"options\": {\"num_ctx\": ")
        set body to concat(body and int_to_string(num_ctx))
        set body to concat(body and "}}")
    else:
        set body to concat(body and llm_bound_fragment())
        set body to concat(body and llm_slot_fragment(url))
        set body to concat(body and "}")

    display f"[LLM DEBUG] POST (native vision) {url} model={model_name} image={image_path} body_len={string_length(body)}"
    set _t0 to ep_time_now_ms()
    set response to await http_post_async(url and headers and body)
    set _total_ms to ep_time_now_ms() - _t0
    display f"[LLM TIMING] native vision HTTP call took {_total_ms} ms (body_len={string_length(body)})"
    if string_length(response) == 0 or else response equals "Error: connection failed":
        display "[LLM VISION] Native image request failed."
        return ""
    if response equals llm_repetition_abort_marker():
        return response
    set ok to llm_log_call_metrics("main-image" and http_dechunk(response) and _total_ms)
    set channels to extract_message_from_response(response)
    set content_str to llm_compose_turn(channels)
    if string_length(content_str) > 0:
        display f"[LLM VISION] SUCCESS: got content length={string_length(content_str)}"
        return content_str

    display "[LLM VISION] empty content+reasoning on valid response — one retry"
    set response to await http_post_async(url and headers and body)
    if string_length(response) == 0:
        return ""
    set channels to extract_message_from_response(response)
    return llm_compose_turn(channels)

# Post-generation vision uses the same model-exact native multimodal path as uploaded
# images.  The old implementation defaulted an empty post-reset selection to 31B and
# hard-routed it to the removed :8091 sidecar, so the active 26B model never saw its
# generated image and delivery fell back to a bare file path.
define query_vision with prompt as Str and image_path as Str and model_name as Str returning Str:
    set mdl to model_name
    if string_length(mdl) == 0:
        set mdl to llm_default_model()
    display f"[Vision] native post-generation inspection model={mdl} img={image_path}"
    set composed to query_local_llm_image(prompt and image_path and mdl)
    return llm_public_content(composed)

define agent_list_models returning Str:
    set models_list to create_list()
    set headers to "Accept: application/json"
    
    # 1. Query Ollama
    set ollama_resp to ""
    if is_port_open("127.0.0.1" and 11434) == 1:
        set ollama_resp to http_get("http://127.0.0.1:11434/api/tags" and headers)
        set ollama_resp to http_dechunk(ollama_resp)
    if string_length(ollama_resp) > 0:
        if ollama_resp equals "Error: connection failed":
            set ok to 0
        else:
            set root to json_parse(ollama_resp)
            if root != 0:
                set models_node to get_json_object_value(root and "models")
                if models_node != 0:
                    set m_list to get_json_value(models_node)
                    set m_len to length_list(m_list)
                    set i to 0
                    repeat while i < m_len:
                        set item to get_list(m_list and i)
                        set name_node to get_json_object_value(item and "name")
                        if name_node != 0:
                            set name_str to get_json_value(name_node)
                            # Check duplicates
                            set dup to 0
                            set j to 0
                            set cur_len to length_list(models_list)
                            repeat while j < cur_len:
                                  set existing to get_list(models_list and j)
                                  if existing equals name_str:
                                      set dup to 1
                                  set j to j + 1
                            if dup == 0:
                                set ok to append_list(models_list and name_str)
                        set i to i + 1

    # 2. Query LM Studio
    set lm_resp to ""
    if is_port_open("127.0.0.1" and 1234) == 1:
        set lm_resp to http_get("http://127.0.0.1:1234/v1/models" and headers)
        set lm_resp to http_dechunk(lm_resp)
    if string_length(lm_resp) > 0:
        if lm_resp equals "Error: connection failed":
            set ok to 0
        else:
            set root2 to json_parse(lm_resp)
            if root2 != 0:
                set data_node to get_json_object_value(root2 and "data")
                if data_node != 0:
                    set d_list to get_json_value(data_node)
                    set d_len to length_list(d_list)
                    set i to 0
                    repeat while i < d_len:
                        set item to get_list(d_list and i)
                        set id_node to get_json_object_value(item and "id")
                        if id_node != 0:
                            set id_str to get_json_value(id_node)
                            # Check duplicates
                            set dup to 0
                            set j to 0
                            set cur_len to length_list(models_list)
                            repeat while j < cur_len:
                                  set existing to get_list(models_list and j)
                                  if existing equals id_str:
                                      set dup to 1
                                  set j to j + 1
                            if dup == 0:
                                set ok to append_list(models_list and id_str)
                        set i to i + 1



    # 3. Query llama.cpp servers (8080, 8081) — OpenAI-compatible /v1/models, same
    #    shape as LM Studio (.data[].id). Probe both ports the user may run llama.cpp on.
    set llama_ports to create_list()
    set ok to append_list(llama_ports and 8080)
    set ok to append_list(llama_ports and 8081)
    set lp to 0
    repeat while lp < length_list(llama_ports):
        set lc_port to get_list(llama_ports and lp)
        set lc_resp to ""
        if is_port_open("127.0.0.1" and lc_port) == 1:
            set lc_resp to http_get(concat(concat("http://127.0.0.1:" and int_to_string(lc_port)) and "/v1/models") and headers)
            set lc_resp to http_dechunk(lc_resp)
        if string_length(lc_resp) > 0:
            if (lc_resp equals "Error: connection failed") == 0:
                set lroot to json_parse(lc_resp)
                if lroot != 0:
                    set ldata to get_json_object_value(lroot and "data")
                    if ldata != 0:
                        set ld_list to get_json_value(ldata)
                        set li to 0
                        repeat while li < length_list(ld_list):
                            set litem to get_list(ld_list and li)
                            set lid_node to get_json_object_value(litem and "id")
                            if lid_node != 0:
                                set lid_str to get_json_value(lid_node)
                                set ldup to 0
                                set lj to 0
                                repeat while lj < length_list(models_list):
                                    if get_list(models_list and lj) equals lid_str:
                                        set ldup to 1
                                    set lj to lj + 1
                                if ldup == 0:
                                    set ok to append_list(models_list and lid_str)
                            set li to li + 1
        set lp to lp + 1

    # Format list to JSON string
    set out_json to "["
    set list_len to length_list(models_list)
    set idx to 0
    repeat while idx < list_len:
        set model_val to get_list(models_list and idx)
        set out_json to concat(out_json and "\"")
        set out_json to concat(out_json and model_val)
        set out_json to concat(out_json and "\"")
        if idx < list_len - 1:
            set out_json to concat(out_json and ",")
        set idx to idx + 1
    set out_json to concat(out_json and "]")
    
    free_list(models_list)
    return out_json

# Exact model-to-provider routing. Model-bound servers must never silently answer
# a request for different weights; tag-aware providers remain fallbacks.
define llm_ports_for_model with model_name as Str returning List:
    return model_router_ports(model_name)

define query_via_router with prompt as Str and selected_model as Str returning Str:
    set ports to llm_ports_for_model(selected_model)
    set n to length_list(ports)
    set i to 0
    repeat while i < n:
        set port to get_list(ports and i)
        if is_port_open("127.0.0.1" and port) == 1:
            set endpoint to f"http://127.0.0.1:{int_to_string(port)}/v1/chat/completions"
            set res to try_chat_completion(endpoint and selected_model and prompt)
            if string_length(res) > 0:
                return res
        set i to i + 1
    return ""

define query_via_router_image with prompt as Str and image_path as Str and selected_model as Str returning Str:
    set ports to llm_ports_for_model(selected_model)
    set n to length_list(ports)
    set i to 0
    repeat while i < n:
        set port to get_list(ports and i)
        if is_port_open("127.0.0.1" and port) == 1:
            set endpoint to f"http://127.0.0.1:{int_to_string(port)}/v1/chat/completions"
            set res to try_chat_completion_image(endpoint and selected_model and prompt and image_path)
            if string_length(res) > 0:
                return res
        set i to i + 1
    return ""

# ── Repetition-loop detector ─────────────────────────────────────────────────
# Scans the tail of a generated string for consecutive repeating sequences.
# Returns 1 if a unit of length 8–200 chars repeats 3+ times at the tail.
define detect_repetition_loop with s as Str returning Int:
    set len to string_length(s)
    if len < 30:
        return 0
    set L to 8
    repeat while L <= 200:
        if len >= 3 * L:
            set sub1 to substring(s and len - L and L)
            set sub2 to substring(s and len - 2 * L and L)
            if sub1 equals sub2:
                set sub3 to substring(s and len - 3 * L and L)
                if sub2 equals sub3:
                    return 1
        set L to L + 1
    return 0

# The tail detector is deliberately broad. Require enough independent evidence in a
# channel before using it to cancel a live request; without this gate an ordinary
# 50-character phrase was misclassified and forced a redundant full-prompt retry.
define llm_stream_has_repetition with content as Str and reasoning as Str returning Int:
    set clean_content to string_trim(content)
    set clean_reasoning to string_trim(reasoning)
    if string_length(clean_content) >= 256:
        if detect_repetition_loop(clean_content) == 1:
            return 1
    if string_length(clean_reasoning) >= 256:
        if detect_repetition_loop(clean_reasoning) == 1:
            return 1
    return 0

# ── Operator-configurable DEFAULT model ──────────────────────────────────────
# config/default_model.txt (one line, a served model name or Ollama/LM Studio tag)
# overrides the built-in gemma4:26b default WITHOUT a rebuild — read per call so a
# swap takes effect on the next message. Delete the file (or empty it) to revert.
define llm_default_model returning Str:
    if file_exists("config/default_model.txt") == 1:
        set dm to string_trim(read_file("config/default_model.txt"))
        if string_length(dm) > 0:
            return dm
    return "gemma4:26b"

# The configured model's dedicated service comes first, followed by tag-aware fallbacks.
define llm_default_ports returning List:
    return llm_ports_for_model(llm_default_model())

# ── Provider-authoritative context accounting ────────────────────────────────
# Compression policy must use the live provider's allocated context window, not
# a model-name guess or a fixed character count.  The returned record is also
# injected into Echo's prompt as situational awareness on every turn.
set LLM_TOKENIZER_PATH_CACHE to create_map()

define llm_context_effective_model with requested_model as Str returning Str:
    if string_length(string_trim(requested_model)) > 0:
        return string_trim(requested_model)
    return llm_default_model()

define llm_context_model_ref_safe with model_name as Str returning Int:
    set n to string_length(model_name)
    if n == 0 or else n > 240:
        return 0
    set i to 0
    repeat while i < n:
        set ch to get_character(model_name and i)
        set allowed to 0
        if ch >= 48 and ch <= 57:
            set allowed to 1
        else if ch >= 65 and ch <= 90:
            set allowed to 1
        else if ch >= 97 and ch <= 122:
            set allowed to 1
        else if ch == 45 or else ch == 46 or else ch == 47 or else ch == 58 or else ch == 95:
            set allowed to 1
        if allowed == 0:
            return 0
        set i to i + 1
    return 1

define llm_context_shell_quote with value as Str returning Str:
    set escaped to string_replace(value and "'" and "'\"'\"'")
    return concat("'" and concat(escaped and "'"))

define llm_context_ollama_model_path with model_name as Str returning Str:
    if map_contains(LLM_TOKENIZER_PATH_CACHE and model_name) == 1:
        set cached to map_get_val(LLM_TOKENIZER_PATH_CACHE and model_name)
        if file_exists(cached) == 1:
            return cached
    if llm_context_model_ref_safe(model_name) == 0:
        return ""
    set command to concat("ollama show " and concat(llm_context_shell_quote(model_name) and " --modelfile 2>/dev/null"))
    set modelfile to run_command(command)
    set lines to string_split(modelfile and "\n")
    set count to length_list(lines)
    set i to 0
    repeat while i < count:
        set line to string_trim(get_list(lines and i))
        if starts_with(line and "FROM ") == 1:
            set model_path to string_trim(substring(line and 5 and string_length(line) - 5))
            free_list(lines)
            if file_exists(model_path) == 1:
                set ok to map_insert(LLM_TOKENIZER_PATH_CACHE and model_name and model_path)
                return model_path
            return ""
        set i to i + 1
    free_list(lines)
    return ""

define llm_context_tokenize_file with model_path as Str and prompt as Str returning Int:
    if file_exists(model_path) == 0:
        return 0
    set tokenizer_path to ""
    if map_contains(LLM_TOKENIZER_PATH_CACHE and "__binary__") == 1:
        set tokenizer_path to map_get_val(LLM_TOKENIZER_PATH_CACHE and "__binary__")
    if string_length(tokenizer_path) == 0 or else file_exists(tokenizer_path) == 0:
        # Keep run_command out of a nested expression.  The compiler otherwise
        # resolves the nested call to its C runtime system() helper (an exit code)
        # instead of stdlib/os.ep's output-capturing ep_run_command wrapper.
        set tokenizer_lookup to run_command("command -v llama-tokenize 2>/dev/null")
        set tokenizer_path to string_trim(tokenizer_lookup)
        if string_length(tokenizer_path) == 0 or else file_exists(tokenizer_path) == 0:
            return 0
        set ok to map_insert(LLM_TOKENIZER_PATH_CACHE and "__binary__" and tokenizer_path)
    set stamp to ep_time_now_ms()
    set nonce to ep_random_int(100000 and 999999)
    set temp_path to concat("/tmp/ernos_context_tokens_" and concat(int_to_string(stamp) and concat("_" and concat(int_to_string(nonce) and ".txt"))))
    set written to write_file(temp_path and prompt)
    if written == 0 or else file_exists(temp_path) == 0:
        return 0
    set command to concat(llm_context_shell_quote(tokenizer_path) and " -m ")
    set command to concat(command and llm_context_shell_quote(model_path))
    set command to concat(command and " --file ")
    set command to concat(command and llm_context_shell_quote(temp_path))
    set command to concat(command and " --show-count --log-disable 2>/dev/null | tail -n 1")
    set output to run_command(command)
    set removed to remove_file(temp_path)
    set marker to "Total number of tokens:"
    set pos to string_index_of(output and marker)
    if pos < 0:
        return 0
    set number_text to string_trim(substring(output and pos + string_length(marker) and string_length(output) - pos - string_length(marker)))
    return string_to_int(number_text)

define llm_context_count_llamacpp with base_url as Str and prompt as Str returning Int:
    set headers to "Content-Type: application/json"
    set apply_body to "{\"messages\":[{\"role\":\"system\",\"content\":\""
    set apply_body to concat(apply_body and llm_json_escape(llm_system_identity()))
    set apply_body to concat(apply_body and "\"},{\"role\":\"user\",\"content\":\"")
    set apply_body to concat(apply_body and llm_json_escape(prompt))
    set apply_body to concat(apply_body and "\"}]}")
    set applied_raw to await http_post_async(concat(base_url and "/apply-template") and headers and apply_body)
    set applied_root to json_parse(http_dechunk(applied_raw))
    if applied_root == 0:
        return 0
    set prompt_node to get_json_object_value(applied_root and "prompt")
    if prompt_node == 0:
        return 0
    set formatted to get_json_value(prompt_node)
    set tokenize_body to concat("{\"content\":\"" and concat(llm_json_escape(formatted) and "\",\"add_special\":false}"))
    set tokenized_raw to await http_post_async(concat(base_url and "/tokenize") and headers and tokenize_body)
    set tokenized_root to json_parse(http_dechunk(tokenized_raw))
    if tokenized_root == 0:
        return 0
    set tokens_node to get_json_object_value(tokenized_root and "tokens")
    if tokens_node == 0 or else get_json_type(tokens_node) != 3:
        return 0
    return length_list(get_json_value(tokens_node))

define llm_context_snapshot_failure with message as Str returning Map:
    set result to create_map()
    set ok to map_insert(result and "ok" and 0)
    set ok to map_insert(result and "error" and message)
    set ok to map_insert(result and "model" and "")
    set ok to map_insert(result and "provider" and "")
    set ok to map_insert(result and "context_limit_tokens" and 0)
    set ok to map_insert(result and "used_tokens" and 0)
    return result

define llm_context_snapshot_success with model_name as Str and provider_name as Str and context_limit as Int and used_tokens as Int returning Map:
    set result to create_map()
    set ok to map_insert(result and "ok" and 1)
    set ok to map_insert(result and "error" and "")
    set ok to map_insert(result and "model" and model_name)
    set ok to map_insert(result and "provider" and provider_name)
    set ok to map_insert(result and "context_limit_tokens" and context_limit)
    set ok to map_insert(result and "used_tokens" and used_tokens)
    return result

define llm_context_snapshot with requested_model as Str and prompt as Str returning Map:
    set model_name to llm_context_effective_model(requested_model)
    set ports to llm_ports_for_model(model_name)
    set n to length_list(ports)
    set i to 0
    repeat while i < n:
        set port to get_list(ports and i)
        if is_port_open("127.0.0.1" and port) == 1:
            set base_url to concat("http://127.0.0.1:" and int_to_string(port))
            if port == 11434 or else port == 11435:
                set raw to http_get(concat(base_url and "/api/ps") and "Accept: application/json")
                set inventory to provider_parse_ollama_running(http_dechunk(raw))
                if map_get_val(inventory and "ok") == 1:
                    set record to provider_find_model(map_get_val(inventory and "models") and model_name)
                    if map_contains(record and "context_length") == 1:
                        set context_limit to map_get_val(record and "context_length")
                        set model_path to llm_context_ollama_model_path(model_name)
                        set used_tokens to llm_context_tokenize_file(model_path and concat(llm_system_identity() and concat("\n" and prompt)))
                        if context_limit > 0 and also used_tokens > 0:
                            free_list(ports)
                            return llm_context_snapshot_success(model_name and "ollama" and context_limit and used_tokens)
            else if port == 1234:
                set raw to http_get(concat(base_url and "/api/v1/models") and "Accept: application/json")
                set inventory to provider_parse_lmstudio_models(http_dechunk(raw))
                if map_get_val(inventory and "ok") == 1:
                    set record to provider_find_model(map_get_val(inventory and "models") and model_name)
                    if map_contains(record and "context_length") == 1:
                        set context_limit to map_get_val(record and "context_length")
                        # LM Studio currently exposes the allocated window but not a
                        # tokenizer endpoint on every release.  Never substitute a
                        # character guess: continue probing another exact route.
                        if context_limit <= 0:
                            set unused to 0
            else:
                set raw to http_get(concat(base_url and "/v1/models") and "Accept: application/json")
                set inventory to provider_parse_llamacpp_models(http_dechunk(raw) and concat("llamacpp_" and int_to_string(port)))
                if map_get_val(inventory and "ok") == 1:
                    set record to provider_find_model(map_get_val(inventory and "models") and model_name)
                    if map_contains(record and "model") == 1:
                        set props_raw to http_get(concat(base_url and "/props") and "Accept: application/json")
                        set complete to provider_apply_llamacpp_props(record and http_dechunk(props_raw))
                        set context_limit to map_get_val(complete and "context_length")
                        set used_tokens to llm_context_count_llamacpp(base_url and prompt)
                        if context_limit > 0 and also used_tokens > 0:
                            free_list(ports)
                            return llm_context_snapshot_success(model_name and concat("llamacpp:" and int_to_string(port)) and context_limit and used_tokens)
        set i to i + 1
    free_list(ports)
    return llm_context_snapshot_failure(concat("No active provider exposed both an allocated context limit and an exact tokenizer for model " and model_name))

define query_local_llm_raw with prompt as Str and selected_model as Str returning Str:
    if string_length(selected_model) > 0:
        # Use only endpoints that can serve the requested weights. On failure, fall
        # through to the operator's configured default rather than a mismatched server.
        set routed to query_via_router(prompt and selected_model)
        if string_length(routed) > 0:
            return routed
        display f"[LLM] Selected model '{selected_model}' failed or offline. Falling through to cascade."

    # Default cascade — the configured model's bound endpoint first, then tag-aware
    # shared providers. gemma4:26b therefore uses its isolated :11435 service.
    set dp to llm_default_ports()
    set dm to llm_default_model()
    set dn to length_list(dp)
    set di to 0
    repeat while di < dn:
        set dport to get_list(dp and di)
        if is_port_open("127.0.0.1" and dport) == 1:
            set res to try_chat_completion(f"http://127.0.0.1:{int_to_string(dport)}/v1/chat/completions" and dm and prompt)
            if string_length(res) > 0:
                return res
        set di to di + 1

    return ""

# ── Public entry point with loop-detection retry ─────────────────────────────
# Wraps query_local_llm_raw. If the LLM gets stuck in a repetition loop,
# appends a loop-avoidance directive and retries up to 3 times.
define query_local_llm with prompt as Str and selected_model as Str returning Str:
    set current_prompt to prompt
    set retries to 0
    repeat while retries < 3:
        set raw_output to query_local_llm_raw(current_prompt and selected_model)
        if string_length(raw_output) == 0:
            return raw_output
        if raw_output equals llm_repetition_abort_marker() or else detect_repetition_loop(string_trim(raw_output)) == 1:
            display f"[WARNING] LLM repetition loop detected on attempt {retries + 1}/3. Retrying with loop-avoidance directive..."
            set current_prompt to concat(prompt and "\n\n[SYSTEM DIRECTION: Your previous output contained a repetition loop — the same phrase was repeated many times in sequence. Produce a FRESH response. Vary your phrasing. Do NOT repeat sentences or paragraphs.]")
            set retries to retries + 1
        else:
            return raw_output
    display "[ERROR] LLM stuck in repetition loop after 3 retries. Returning error."
    return "Error: LLM output contained a repetition loop and could not recover after 3 retries."

# Public native-vision entry point. Routing stays model-exact: gemma4:26b uses its
# dedicated :11435 service first, then only tag-aware providers for the same weights.
define query_local_llm_image_raw with prompt as Str and image_path as Str and selected_model as Str returning Str:
    if string_length(selected_model) > 0:
        set routed to query_via_router_image(prompt and image_path and selected_model)
        if string_length(routed) > 0:
            return routed
        display f"[LLM] Selected vision model '{selected_model}' failed or offline. Falling through to configured default."

    set dp to llm_default_ports()
    set dm to llm_default_model()
    set dn to length_list(dp)
    set di to 0
    repeat while di < dn:
        set dport to get_list(dp and di)
        if is_port_open("127.0.0.1" and dport) == 1:
            set res to try_chat_completion_image(f"http://127.0.0.1:{int_to_string(dport)}/v1/chat/completions" and dm and prompt and image_path)
            if string_length(res) > 0:
                return res
        set di to di + 1
    return ""

define query_local_llm_image with prompt as Str and image_path as Str and selected_model as Str returning Str:
    set current_prompt to prompt
    set retries to 0
    repeat while retries < 3:
        set raw_output to query_local_llm_image_raw(current_prompt and image_path and selected_model)
        if string_length(raw_output) == 0:
            return raw_output
        if raw_output equals llm_repetition_abort_marker() or else detect_repetition_loop(string_trim(raw_output)) == 1:
            display f"[WARNING] Vision LLM repetition loop detected on attempt {retries + 1}/3. Retrying..."
            set current_prompt to concat(prompt and "\n\n[SYSTEM DIRECTION: Your previous output contained a repetition loop. Produce a fresh response without repeated sentences or paragraphs.]")
            set retries to retries + 1
        else:
            return raw_output
    return "Error: Vision model output contained a repetition loop and could not recover after 3 retries."

# ── Split-message JSON entry point for observer audits ────────────────────────
# Like query_local_llm_raw but sends system_content as "system" role and
# user_content as "user" role, and requests JSON format from Ollama.
# Uses the same model-bound cascade as main inference.
# No repetition-loop retry — audit responses are short and structured.
define query_local_llm_json with system_content as Str and user_content as Str and selected_model as Str and capture_continuity as Int returning Str:
    # For the split call, we bypass the router (it only takes a single prompt)
    # and go straight to the endpoint cascade with try_chat_completion_split.

    # KV-CACHE FIX: route in the SAME backend order as the main call. The observer's
    # prompt is the main call's prompt plus its audit suffix, so the same single-slot
    # 26B service retains the common prefix and unrelated Ollama clients cannot evict it.
    if string_length(selected_model) > 0:
        set sp to llm_ports_for_model(selected_model)
        set sn to length_list(sp)
        set si to 0
        repeat while si < sn:
            set sport to get_list(sp and si)
            if is_port_open("127.0.0.1" and sport) == 1:
                set res to try_chat_completion_split(f"http://127.0.0.1:{int_to_string(sport)}/v1/chat/completions" and selected_model and system_content and user_content and capture_continuity)
                if res equals llm_observer_invalid_marker():
                    return res
                if string_length(res) > 0:
                    return res
            set si to si + 1

    # Default cascade — SAME model + backend order as the main call's default
    # (llm_default_ports/llm_default_model) so the observer lands on the SAME backend
    # the main call just used and reuses its KV-cached prefix.
    set dp to llm_default_ports()
    set dm to llm_default_model()
    set dn to length_list(dp)
    set di to 0
    repeat while di < dn:
        set dport to get_list(dp and di)
        if is_port_open("127.0.0.1" and dport) == 1:
            set res to try_chat_completion_split(f"http://127.0.0.1:{int_to_string(dport)}/v1/chat/completions" and dm and system_content and user_content and capture_continuity)
            if res equals llm_observer_invalid_marker():
                return res
            if string_length(res) > 0:
                return res
        set di to di + 1

    return ""
