# ErnosDecent safety-gated self-recompilation transaction.
# Component: decent_agent/compiler_tool.ep

import "fs"
import "os"
import "string"
import "collections"
import "../logging"

external define ep_run_command_bounded with cmd as Str and timeout_ms as Int and start_epoch as Int returning Str
external define ep_cancel_epoch_get with dummy returning Int
external define ep_sha256_file with path as Str returning Str

define compiler_gate_integrity returning Str:
    set seal_path to concat(get_home_dir() and "/.ernosdecent/mandatory-regressions.seal")
    set manifest_path to "config/upgrades/mandatory-regressions.sha256"
    if file_exists(seal_path) == 0:
        return "Error: operator regression seal is missing; self-upgrade is fail-closed."
    if file_exists(manifest_path) == 0:
        return "Error: mandatory regression manifest is missing; self-upgrade is fail-closed."
    set expected_manifest_hash to string_trim(read_file(seal_path))
    if string_length(expected_manifest_hash) != 64:
        return "Error: operator regression seal is malformed; self-upgrade is fail-closed."
    set actual_manifest_hash to ep_sha256_file(manifest_path)
    if actual_manifest_hash equals expected_manifest_hash == 0:
        return concat("Error: mandatory regression manifest differs from the operator seal; self-upgrade is blocked. expected=" and concat(expected_manifest_hash and concat(" actual=" and actual_manifest_hash)))
    set epoch to ep_cancel_epoch_get(0)
    set verified to ep_run_command_bounded("env -u ERNOS_PRESERVE_DISCORD_BRIDGE bash scripts/run_mandatory_regressions.sh --verify-only" and 30000 and epoch)
    if compiler_command_failed(verified) == 1 or else string_contains(verified and "integrity verified") == 0:
        return concat("Error: mandatory regression trust root failed verification; self-upgrade is blocked.\n" and verified)
    return actual_manifest_hash

define compiler_marker_value with content as Str and key as Str returning Str:
    set prefix to concat(key and "=")
    set lines to string_split(content and "\n")
    set i to 0
    repeat while i < length_list(lines):
        set line to get_list(lines and i)
        if string_index_of(line and prefix) == 0:
            set value to substring(line and string_length(prefix) and string_length(line) - string_length(prefix))
            free_list(lines)
            return value
        set i to i + 1
    free_list(lines)
    return ""

define compiler_command_failed with result as Str returning Int:
    if string_index_of(result and "[run_command failed:") == 0:
        return 1
    if string_index_of(result and "[run_command timed out") == 0:
        return 1
    if string_index_of(result and "[run_command cancelled") == 0:
        return 1
    return 0

define compiler_result_tail with result as Str and max_chars as Int returning Str:
    set n to string_length(result)
    if n <= max_chars:
        return result
    set start to n - max_chars
    return concat("[Earlier verification output omitted; showing the failure-bearing tail.]\n" and substring(result and start and max_chars))

# HIVE/Apis-style failure contract: put the actionable failing stage/test first.
# Raw command logs may contain setup chatter or a compiler's recoverable bootstrap
# diagnostics; those are useful only after the authoritative failure summary.
define compiler_failure_summary with result as Str returning Str:
    set lines to string_split(result and "\n")
    set summary to ""
    set current_scope to ""
    set last_scope to ""
    set failures to 0
    set i to 0
    repeat while i < length_list(lines):
        set line to ptr_to_str(get_list(lines and i))
        if string_index_of(line and "TEST ") == 0 or else string_index_of(line and "[mandatory-gate] python3 ") == 0 or else string_index_of(line and "[mandatory-gate] node ") == 0 or else string_index_of(line and "[mandatory-gate] bash ") == 0:
            set current_scope to line
        set is_failure to 0
        set is_global_failure to 0
        if string_contains(line and " FAILED!") == 1 or else string_contains(line and "FAILED (failures=") == 1 or else string_contains(line and "FAILED (errors=") == 1:
            set is_global_failure to 1
        else if string_index_of(line and "  FAIL") == 0 or else string_index_of(line and "FAIL:") == 0 or else string_index_of(line and "ERROR:") == 0 or else string_index_of(line and "Error:") == 0 or else string_index_of(line and "error:") == 0 or else string_index_of(line and "IMPROVEMENT_GATE_FAILED") == 0 or else string_index_of(line and "not ok ") == 0:
            set is_failure to 1
        if is_failure == 1:
            if string_length(current_scope) > 0 and also current_scope equals last_scope == 0:
                set summary to concat(summary and concat(current_scope and "\n"))
                set last_scope to current_scope
            set summary to concat(summary and concat(line and "\n"))
            set failures to failures + 1
        if is_global_failure == 1:
            set summary to concat(summary and concat("Overall suite result: " and concat(line and "\n")))
            set failures to failures + 1
        set i to i + 1
    free_list(lines)
    if failures == 0:
        return compiler_result_tail(result and 6000)
    set out to "[AUTHORITATIVE FAILURE SUMMARY — diagnose these current-source failures, not historical receipts or successful bootstrap stages]\n"
    set out to concat(out and summary)
    set out to concat(out and "[END AUTHORITATIVE FAILURE SUMMARY]\n[REPAIR NEXT STEP] Extract a distinctive literal from the scoped failure and call codebase_search([\"literal\", \"source-root\", 25]). Read the exact returned implementation path. For a localized change use codebase_replace([\"path\", \"exact old text\", \"exact new text\", 1]); use codebase_write only for a genuine whole-file rewrite. Then immediately call system_verify([]). Do not browse sessions, uploads, or unrelated workspaces.\n\n[DIAGNOSTIC TAIL]\n")
    set out to concat(out and compiler_result_tail(result and 6000))
    return out

# Canonical source verification for recursive repair. This always rebuilds from the
# current source through the operator-sealed mandatory gate; it never executes a stale
# precompiled test binary and never asks the model to guess an individual test target.
# Failure output is tail-selected because suite summaries and causal failures occur at
# the end, while the full build log can exceed the next-turn observation budget.
define system_verify_source returning Str:
    set gate_hash to compiler_gate_integrity()
    if string_length(gate_hash) != 64:
        return gate_hash
    log_info("compiler" and "Verifying current source through the complete operator-sealed mandatory gate.")
    set epoch to ep_cancel_epoch_get(0)
    set result to ep_run_command_bounded("env -u ERNOS_PRESERVE_DISCORD_BRIDGE bash scripts/run_mandatory_regressions.sh" and 1800000 and epoch)
    set result_tail to compiler_result_tail(result and 16000)
    if compiler_command_failed(result) == 1:
        set failure_summary to compiler_failure_summary(result)
        return concat("SOURCE VERIFICATION FAILED. The structured failure block below is authoritative. Diagnose it before reading the diagnostic tail; historical rights receipts are provenance, not evidence of the current failure. Modify implementation only. gate_manifest_sha256=" and concat(gate_hash and concat("\n" and failure_summary)))
    if string_contains(result and "[mandatory-gate] all mandatory regressions passed.") == 0:
        return concat("Error: source verification returned no authenticated completion receipt. Do not treat it as green. gate_manifest_sha256=" and concat(gate_hash and concat("\n" and result_tail)))
    return concat("SOURCE VERIFICATION PASSED. All mandatory current-source regressions are green. gate_manifest_sha256=" and concat(gate_hash and concat("\n" and result_tail)))

define system_recompile_prepare returning Str:
    set gate_hash to compiler_gate_integrity()
    if string_length(gate_hash) != 64:
        return gate_hash
    log_info("compiler" and "Preparing isolated self-upgrade candidate and running complete gates.")
    set epoch to ep_cancel_epoch_get(0)
    set result to ep_run_command_bounded("env -u ERNOS_PRESERVE_DISCORD_BRIDGE bash upgrade.sh prepare" and 1800000 and epoch)
    if compiler_command_failed(result) == 1:
        return concat("Error: candidate preparation failed without changing the live executable.\n" and result)
    if string_contains(result and "PREPARE_OK") == 0:
        return concat("Error: candidate preparation returned no verified completion receipt.\n" and result)
    if file_exists("config/upgrades/prepared.env") == 0:
        return "Error: candidate preparation receipt is missing; deployment is fail-closed."
    set marker to read_file("config/upgrades/prepared.env")
    if compiler_marker_value(marker and "version") equals "1" == 0:
        return "Error: unsupported candidate preparation receipt version."
    if compiler_marker_value(marker and "state") equals "prepared" == 0:
        return "Error: candidate preparation receipt is not in the prepared state."
    set candidate_hash to compiler_marker_value(marker and "candidate_hash")
    set rollback_hash to compiler_marker_value(marker and "rollback_hash")
    if string_length(candidate_hash) != 64 or else string_length(rollback_hash) != 64:
        return "Error: candidate preparation hashes are malformed."
    return candidate_hash

define system_recompile_stage with change_id as Str returning Str:
    if string_length(change_id) != 64:
        return "Error: protected change id is malformed; candidate was not staged."
    set epoch to ep_cancel_epoch_get(0)
    set result to ep_run_command_bounded(concat("bash upgrade.sh stage " and change_id) and 30000 and epoch)
    if compiler_command_failed(result) == 1:
        return concat("Error: candidate staging failed; the live executable remains unchanged.\n" and result)
    if string_contains(result and "STAGE_OK") == 0:
        return concat("Error: candidate staging returned no verified completion receipt.\n" and result)
    if file_exists("config/upgrades/pending.env") == 0:
        return "Error: pending deployment receipt is missing; restart is not authorized."
    set pending to read_file("config/upgrades/pending.env")
    if compiler_marker_value(pending and "change_id") equals change_id == 0:
        return "Error: pending deployment is not bound to the protected change id."
    return concat("RECOMPILE STAGED: candidate " and concat(compiler_marker_value(pending and "candidate_hash") and " passed the complete test/build gate. The current reply will be persisted before the supervisor performs authenticated health validation and either commits or rolls back."))

define system_recompile_discard returning Str:
    set epoch to ep_cancel_epoch_get(0)
    set result to ep_run_command_bounded("bash upgrade.sh discard" and 30000 and epoch)
    if compiler_command_failed(result) == 1:
        return concat("Error: prepared candidate cleanup failed.\n" and result)
    return result
