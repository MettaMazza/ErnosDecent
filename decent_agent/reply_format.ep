# Shared user-visible reply formatting normalisation.
# This module is deliberately platform-neutral: WebUI, Discord and IPC must receive
# the same corrected text before their own presentation/rendering layers run.

import "string"

define reply_format_normalize with text as Str returning Str:
    if string_length(text) == 0:
        return text
    set result to text
    set result to string_replace(result and concat("$" and concat("\r" and "ightarrow$")) and "→")
    set result to string_replace(result and concat("\r" and "ightarrow") and "→")
    set result to string_replace(result and "$\\rightarrow$" and "→")
    set result to string_replace(result and "\\rightarrow" and "→")
    set result to string_replace(result and "$\\Rightarrow$" and "⇒")
    set result to string_replace(result and "\\Rightarrow" and "⇒")
    set result to string_replace(result and "$\\leftarrow$" and "←")
    set result to string_replace(result and "\\leftarrow" and "←")
    set result to string_replace(result and "$\\leftrightarrow$" and "↔")
    set result to string_replace(result and "\\leftrightarrow" and "↔")
    set result to string_replace(result and "$→$" and "→")
    set result to string_replace(result and "$⇒$" and "⇒")
    set result to string_replace(result and "$←$" and "←")
    set result to string_replace(result and "$↔$" and "↔")
    # Carriage returns can overwrite already-rendered text on terminal/IPC clients.
    set result to string_replace(result and "\r" and "\n")
    return result
