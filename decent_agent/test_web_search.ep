# ErnosPlain Web Search Unit Test Suite
# Component: decent_agent/test_web_search.ep

import "collections"
import "string"
import "fs"
import "os"
import "json"
import "./web_search"

define main:
    display "==================================================="
    display "  ErnosDecent -- Web Search Unit Test Suite"
    display "==================================================="
    display ""

    set tests_passed to 0
    set tests_failed to 0

    # ===========================================================
    # TEST 1: URL Encoding
    # ===========================================================
    display "TEST 1: URL Encoding"
    set t1_ok to 1
    
    set enc1 to web_search_urlencode("hello world")
    if enc1 equals "hello%20world":
        display "  'hello world' -> 'hello%20world' (PASS)"
    else:
        display f"  FAIL: 'hello world' -> '{enc1}'"
        set t1_ok to 0
        
    set enc2 to web_search_urlencode("ai&consensus")
    if enc2 equals "ai%26consensus":
        display "  'ai&consensus' -> 'ai%26consensus' (PASS)"
    else:
        display f"  FAIL: 'ai&consensus' -> '{enc2}'"
        set t1_ok to 0

    if t1_ok == 1:
        display "  TEST 1 PASS"
        set tests_passed to tests_passed + 1
    else:
        set tests_failed to tests_failed + 1

    # ===========================================================
    # TEST 2: HTML Stripping
    # ===========================================================
    display "TEST 2: HTML Stripping"
    set t2_ok to 1
    
    set raw_html to "<html><head><style>body { color: red; }</style><script>console.log('test');</script></head><body><h1>Hello World</h1><p>Test paragraph.</p></body></html>"
    set stripped to web_search_strip_html(raw_html)
    
    if string_contains(stripped and "Hello World") == 1 and also string_contains(stripped and "Test paragraph.") == 1:
        display "  Body text successfully extracted (PASS)"
    else:
        display f"  FAIL: body text not found in '{stripped}'"
        set t2_ok to 0
        
    if string_contains(stripped and "color: red") == 0 and also string_contains(stripped and "console.log") == 0:
        display "  Script/Style tags successfully stripped (PASS)"
    else:
        display f"  FAIL: script/style blocks not stripped from '{stripped}'"
        set t2_ok to 0

    if t2_ok == 1:
        display "  TEST 2 PASS"
        set tests_passed to tests_passed + 1
    else:
        set tests_failed to tests_failed + 1

    # ===========================================================
    # TEST 3: Wikipedia Search API Fetch & JSON Parse
    # ===========================================================
    display "TEST 3: Wikipedia Search"
    set t3_ok to 1
    
    # Run a real Wikipedia query for "Leicester City F.C."
    set wiki_res to web_search_wikipedia("Leicester City F.C.")
    if string_length(wiki_res) > 0 and also string_contains(wiki_res and "Wikipedia Summary:") == 1:
        display "  Wikipedia query returned search and summary correctly (PASS)"
    else:
        display f"  FAIL: Wikipedia search returned: {wiki_res}"
        set t3_ok to 0

    if t3_ok == 1:
        display "  TEST 3 PASS"
        set tests_passed to tests_passed + 1
    else:
        set tests_failed to tests_failed + 1

    # ===========================================================
    # TEST 4: Google News RSS Fetch & XML Parse
    # ===========================================================
    display "TEST 4: Google News RSS"
    set t4_ok to 1
    
    # Run a real Google News RSS query for "artificial intelligence"
    set news_res to web_search_google_news("artificial intelligence")
    if string_length(news_res) > 0 and also string_contains(news_res and "GOOGLE NEWS RSS") == 1:
        display "  Google News RSS items fetched and parsed successfully (PASS)"
    else:
        display f"  FAIL: Google News RSS returned: {news_res}"
        set t4_ok to 0

    if t4_ok == 1:
        display "  TEST 4 PASS"
        set tests_passed to tests_passed + 1
    else:
        set tests_failed to tests_failed + 1

    # ===========================================================
    # TEST 5: Waterfall Search
    # ===========================================================
    display "TEST 5: Waterfall Search"
    set waterfall_res to web_search_waterfall("Anthropic announcing training Claude to sabotage development of other AI systems")
    display f"  Waterfall search executed successfully (length={string_length(waterfall_res)})"
    set tests_passed to tests_passed + 1

    # ===========================================================
    # Summary
    # ===========================================================
    display ""
    display "==================================================="
    set total to tests_passed + tests_failed
    display f"  {tests_passed}/{total} web search tests passed."
    if tests_failed > 0:
        display f"  {tests_failed} FAILED!"
    else:
        display "  ALL WEB SEARCH UNIT TESTS PASSED!"
    display "==================================================="
    return 0
