# image_gen.ep — ErnosPlain image generation over the libstable-diffusion FFI.
#
# The heavy diffusion runtime is a linked C library (libstable-diffusion, ggml/Metal) —
# the same FFI pattern the node already uses for libsodium/libsqlite. ALL orchestration
# lives here in ErnosPlain: choosing the model, sizing, the output path, and returning
# the result for the tool layer to auto-attach. No Python; nothing shells out to a binary.
#
# The C shim (decent_agent/vendor/sd/sd_ep_shim.c) exposes one flat entry point that
# builds sd.cpp's param structs, runs the pipeline, and PNG-encodes the first image.

import "string"
import "fs"
import "collections"
import "sql"
import "../storage"

# FFI declaration — resolved from the shim object linked into the node by build.sh.
# Two modes: single-file (model_path set; SD1.5/SDXL — CLIP+VAE built in) OR Flux
# (diffusion_model + clip_l + t5xxl + vae set; model_path ""). Empty "" means unused.
external define sd_ep_generate with model_path and diffusion_model and clip_l and t5xxl and vae and prompt and negative and width and height and steps and cfg and seed and out_png_path returning Int

# Read a string field from config/image.json (empty if absent).
define image_gen_config_str with key as Str returning Str:
    set cfg_path to "config/image.json"
    if file_exists(cfg_path) == 0:
        return ""
    set content to read_file(cfg_path)
    set root to json_parse(content)
    if root == 0:
        return ""
    set node to get_json_object_value(root and key)
    if node == 0:
        return ""
    return get_json_value(node)

# Default single-file model (SD1.5) if config has no explicit model / Flux paths.
define image_gen_default_model returning Str:
    set m to image_gen_config_str("model_path")
    if string_length(m) > 0:
        return m
    return "/Volumes/One Touch/models library/Creative_Models/v1-5-pruned-emaonly.safetensors"

# Where generated images land: the active workspace, so the tool layer auto-attaches them.
define image_gen_out_path with name as Str returning Str:
    set ok to create_directory("config/workspaces/active")
    return concat("config/workspaces/active/" and name)

# Millisecond clock for stage timing (same injected helper llm.ep uses).
external define ep_time_now_ms returning Int

# ── ASYNC generation: OS-thread worker + SQLite job row ───────────────────────
# sd_ep_generate is a PARKED C call that takes minutes at 1024/28 — run inline it froze
# the whole single agent thread (no Stop, no whispers, no sibling agents until done).
# The render now runs on its own EP thread (`spawn`), and completion travels through a
# SQLite row — the same thread-safe pattern as bridge_commands (SQLite is serialized by
# the global mutex; cross-thread EP map mutation is the documented hazard, so no maps
# cross the thread boundary). The agent-side tool polls the row with an async-yielding
# sleep, so the event loop keeps serving everything while the GPU works.

define image_gen_jobs_ensure with db as Int returning Int:
    if db == 0:
        return 1
    set ok to sql_execute(db and "CREATE TABLE IF NOT EXISTS image_jobs (id INTEGER PRIMARY KEY AUTOINCREMENT, status TEXT NOT NULL DEFAULT 'running', result TEXT NOT NULL DEFAULT '');")
    return 0

# Create a job row; returns its id (0 when no DB — caller falls back to synchronous).
define image_gen_job_create with db as Int returning Int:
    if db == 0:
        return 0
    set ok to image_gen_jobs_ensure(db)
    set ok to sql_execute(db and "INSERT INTO image_jobs (status, result) VALUES ('running', '');")
    set rows to sql_query(db and "SELECT id FROM image_jobs ORDER BY id DESC LIMIT 1;")
    if length_list(rows) > 0:
        return string_to_int(get_list(get_list(rows and 0) and 0))
    return 0

# The job's result when done ("<png path>" or "ERROR: ..."), else "pending:running".
define image_gen_job_result with db as Int and job_id as Int returning Str:
    set rows to sql_query(db and f"SELECT status, result FROM image_jobs WHERE id={job_id};")
    if length_list(rows) == 0:
        return "ERROR: image job row vanished"
    set r to get_list(rows and 0)
    if get_list(r and 0) equals "done":
        return get_list(r and 1)
    return "pending:running"

# OS-thread worker — the ONLY place the minutes-long FFI call runs. Only plain
# Str/Int params cross the thread boundary; the result goes back via SQLite.
define image_gen_thread_worker with job_id as Int and prompt as Str and out_name as Str and width as Int and height as Int and steps as Int and cfg as Int and seed as Int:
    set res to image_gen_run(prompt and out_name and width and height and steps and cfg and seed)
    set db to storage_get_db()
    if db != 0:
        set es to string_replace(res and "'" and "''")
        set ok to sql_execute(db and f"UPDATE image_jobs SET status='done', result='{es}' WHERE id={job_id};")
    return 0

# Pre-flight one configured weight file. Returns "" when present (or not configured),
# else a NAMED error — the real reason reaches the user verbatim instead of a bare
# "shim code N". These files live on an external drive that sleeps/unmounts, so the
# error says so.
define image_gen_preflight with label as Str and path as Str returning Str:
    if string_length(path) == 0:
        return ""
    if file_exists(path) == 1:
        return ""
    return concat("ERROR: " and concat(label and concat(" file not found: " and concat(path and " — is the external drive mounted?"))))

# Map a shim return code to its meaning (codes defined in vendor/sd/sd_ep_shim.cpp).
define image_gen_rc_reason with rc as Int returning Str:
    if rc == 2:
        return "bad arguments reached the shim (empty model/prompt/output path)"
    if rc == 3:
        return "model context failed to LOAD — check the [ImageGen] path lines above (external drive asleep/unmounted, or a wrong path in config/image.json)"
    if rc == 4:
        return "the pipeline ran but produced no image (see [ImageGen shim] stderr lines)"
    if rc == 5:
        return "generation succeeded but the PNG could not be written (output path/disk)"
    if rc == 99:
        return "image runtime not built on this machine (~/.ernosdecent/lib/libstable-diffusion missing at build time)"
    return "unknown shim code"

# Generate an image from a prompt. Returns the PNG path on success, or "ERROR: <reason>".
# FLUX mode when config/image.json has a "diffusion_model" (+ clip_l/t5xxl/vae); else single-file.
# OBSERVABILITY: every run logs mode, all configured paths + their pre-flight, the
# parameters, the shim rc, and wall time — a silent 'Image generation failed' with no
# trace anywhere (2026-07-08 17:13) is what this prevents.
define image_gen_run with prompt as Str and out_name as Str and width as Int and height as Int and steps as Int and cfg as Int and seed as Int returning Str:
    if string_length(prompt) == 0:
        return "ERROR: empty prompt"
    set out_path to image_gen_out_path(out_name)
    set diffusion to image_gen_config_str("diffusion_model")
    if string_length(diffusion) > 0:
        # Flux: transformer gguf + separate CLIP/T5/VAE (Maria's diffusers CLIP+VAE load directly).
        set clip_l to image_gen_config_str("clip_l")
        set t5xxl to image_gen_config_str("t5xxl")
        set vae to image_gen_config_str("vae")
        display f"[ImageGen] mode=flux {width}x{height} steps={steps} cfg=1 seed={seed}"
        display f"[ImageGen] diffusion={diffusion}"
        display f"[ImageGen] clip_l={clip_l}"
        display f"[ImageGen] t5xxl={t5xxl}"
        display f"[ImageGen] vae={vae}"
        # Pre-flight ALL configured files, not just the transformer — a missing encoder
        # used to surface only as an opaque ctx-load failure.
        set pf to image_gen_preflight("flux diffusion model" and diffusion)
        if string_length(pf) > 0:
            display f"[ImageGen] {pf}"
            return pf
        set pf to image_gen_preflight("flux clip_l" and clip_l)
        if string_length(pf) > 0:
            display f"[ImageGen] {pf}"
            return pf
        set pf to image_gen_preflight("flux t5xxl" and t5xxl)
        if string_length(pf) > 0:
            display f"[ImageGen] {pf}"
            return pf
        set pf to image_gen_preflight("flux vae" and vae)
        if string_length(pf) > 0:
            display f"[ImageGen] {pf}"
            return pf
        # Flux is a guidance-distilled model: it uses CFG ~1 (NOT the SD-style 7 the tool passes)
        # with its own distilled guidance. High CFG wrecks Flux output, so force 1 here.
        set _t0 to ep_time_now_ms()
        set rc to sd_ep_generate("" and diffusion and clip_l and t5xxl and vae and prompt and "" and width and height and steps and 1 and seed and out_path)
        set _ms to ep_time_now_ms() - _t0
        display f"[ImageGen] shim rc={rc} in {_ms} ms -> {out_path}"
        if rc == 0:
            return out_path
        return concat("ERROR: flux generation failed (shim code " and concat(int_to_string(rc) and concat("): " and image_gen_rc_reason(rc))))
    # Single-file (SD1.5/SDXL): CLIP+VAE baked into the checkpoint.
    set model to image_gen_default_model()
    display f"[ImageGen] mode=single-file {width}x{height} steps={steps} cfg={cfg} seed={seed}"
    display f"[ImageGen] model={model}"
    set pf to image_gen_preflight("image model" and model)
    if string_length(pf) > 0:
        display f"[ImageGen] {pf}"
        return pf
    set _t0 to ep_time_now_ms()
    set rc to sd_ep_generate(model and "" and "" and "" and "" and prompt and "" and width and height and steps and cfg and seed and out_path)
    set _ms to ep_time_now_ms() - _t0
    display f"[ImageGen] shim rc={rc} in {_ms} ms -> {out_path}"
    if rc == 0:
        return out_path
    return concat("ERROR: image generation failed (shim code " and concat(int_to_string(rc) and concat("): " and image_gen_rc_reason(rc))))
