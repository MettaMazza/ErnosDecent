# F1 gate: react_extract_reasoning separates native <think> reasoning from the
# ReAct content, leaving the content clean for action parsing.

import "string"
import "collections"
import "./react_loop"

define pass_if with label as Str and cond as Int returning Int:
    if cond == 1:
        display concat("PASS: " and label)
        return 1
    display concat("FAIL: " and label)
    return 0

define reasoning_of with t as Str returning Str:
    set m to react_extract_reasoning(t)
    return map_get_val(m and "reasoning")

define clean_of with t as Str returning Str:
    set m to react_extract_reasoning(t)
    return map_get_val(m and "clean")

define main:
    set passes to 0
    set total to 0

    # 1. <think> block at the start is captured and stripped.
    set t1 to "<think>the user wants JSON, plan: call export</think>Thought: do it. Action: reply_request([\"done\"])"
    set total to total + 1
    set passes to passes + pass_if("reasoning captured" and (string_contains(reasoning_of(t1) and "plan: call export") == 1))
    set total to total + 1
    set passes to passes + pass_if("clean has no <think>" and (string_contains(clean_of(t1) and "<think>") == 0))
    set total to total + 1
    set passes to passes + pass_if("clean keeps the ReAct content" and (string_contains(clean_of(t1) and "Action: reply_request") == 1))

    # 2. No reasoning -> reasoning empty, content unchanged.
    set t2 to "Thought: straightforward. Action: reply_request([\"hi\"])"
    set total to total + 1
    set passes to passes + pass_if("no think -> empty reasoning" and (string_length(reasoning_of(t2)) == 0))
    set total to total + 1
    set passes to passes + pass_if("no think -> content preserved" and (string_contains(clean_of(t2) and "Action: reply_request") == 1))

    # 3. Unterminated <think> -> everything after is reasoning, prefix kept clean.
    set t3 to "prefix <think>still thinking with no close"
    set total to total + 1
    set passes to passes + pass_if("unterminated: reasoning captured" and (string_contains(reasoning_of(t3) and "still thinking") == 1))
    set total to total + 1
    set passes to passes + pass_if("unterminated: clean is the prefix" and (clean_of(t3) equals "prefix"))

    display f"=== {passes}/{total} passed ==="
    if passes == total:
        display "ALL PASS"
    else:
        display "FAILURES PRESENT"
    return 0
