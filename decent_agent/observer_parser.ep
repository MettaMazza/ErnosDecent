# ErnosPlain Observer — verdict parser.
# Component: decent_agent/observer_parser.ep
#
# Deterministic, FAIL-CLOSED extraction of the audit verdict from the LLM's raw
# output. The model is told to emit {"verdict": "...", "reason": "..."} but often
# wraps it in prose or ```json fences; this robustly pulls the {...} object and
# reads the real verdict. Arbitrary prose is NEVER scanned for verdict words: the
# observer model's reasoning can quote rules containing "ALLOWED", and treating that
# occurrence as a verdict previously let an invalid audit pass. Only a valid JSON
# object with a recognised top-level verdict is authoritative. Anything else stays
# BLOCKED with parsed=0.

import "string"
import "collections"
import "json"

define observer_parse_verdict with audit_raw as Str returning Map:
    set result to create_map()
    set ok to map_insert(result and "verdict" and "BLOCKED")
    set ok to map_insert(result and "reason" and "Audit unavailable (no/invalid LLM verdict) — failing closed.")
    # "parsed": did the LLM actually STATE a verdict (1), or is the BLOCKED above only this
    # parser's fail-closed default because the response was unreadable (0)? Callers that gate
    # dangerous actions ignore this and stay fail-closed on the verdict alone; callers whose
    # contract is fail-open (the look-back) must require parsed==1 before acting on BLOCKED.
    set ok to map_insert(result and "parsed" and 0)
    if string_length(audit_raw) == 0:
        return result
    # Primary path: extract JSON object and parse verdict/reason fields
    set obj_start to string_index_of(audit_raw and "{")
    set obj_end to string_last_index_of(audit_raw and "}")
    set audit_json to audit_raw
    if obj_start >= 0 and also obj_end > obj_start:
        set audit_json to substring(audit_raw and obj_start and obj_end - obj_start + 1)
    set audit_node to json_parse(audit_json)
    if audit_node != 0:
        # Try verdict field — check common key name variations
        set verd_node to get_json_object_value(audit_node and "verdict")
        if verd_node == 0:
            set verd_node to get_json_object_value(audit_node and "Verdict")
        if verd_node == 0:
            set verd_node to get_json_object_value(audit_node and "decision")
        if verd_node == 0:
            set verd_node to get_json_object_value(audit_node and "Decision")
        if verd_node == 0:
            set verd_node to get_json_object_value(audit_node and "result")
        if verd_node == 0:
            set verd_node to get_json_object_value(audit_node and "Result")
        if verd_node == 0:
            set verd_node to get_json_object_value(audit_node and "outcome")
        # Try reason field — check common key name variations
        set reason_node to get_json_object_value(audit_node and "reason")
        if reason_node == 0:
            set reason_node to get_json_object_value(audit_node and "Reason")
        if reason_node == 0:
            set reason_node to get_json_object_value(audit_node and "explanation")
        if reason_node == 0:
            set reason_node to get_json_object_value(audit_node and "Explanation")
        if reason_node == 0:
            set reason_node to get_json_object_value(audit_node and "justification")
        if verd_node != 0:
            # The schema requires a STRING verdict. Booleans/numbers are rejected rather
            # than coerced: permissive coercion is another route from malformed output to
            # permission. Exact values/synonyms only; substrings such as "NOT ALLOWED"
            # must never become ALLOWED.
            set vtype to get_json_type(verd_node)
            if vtype == 2:
                set raw_verdict to string_to_upper(string_trim(get_json_value(verd_node)))
                if raw_verdict equals "ALLOWED" or else raw_verdict equals "ALLOW" or else raw_verdict equals "PERMITTED" or else raw_verdict equals "SAFE" or else raw_verdict equals "APPROVED" or else raw_verdict equals "PASS":
                    set ok to map_insert(result and "verdict" and "ALLOWED")
                    set ok to map_insert(result and "parsed" and 1)
                else if raw_verdict equals "BLOCKED" or else raw_verdict equals "BLOCK" or else raw_verdict equals "DENIED" or else raw_verdict equals "DENY" or else raw_verdict equals "REJECTED" or else raw_verdict equals "UNSAFE" or else raw_verdict equals "FAIL":
                    set ok to map_insert(result and "verdict" and "BLOCKED")
                    set ok to map_insert(result and "parsed" and 1)
            # Preserve the model's reason only as supporting text. It cannot make an
            # unrecognised/malformed verdict authoritative.
        if reason_node != 0:
            set ok to map_insert(result and "reason" and get_json_value(reason_node))
        return result
    # No raw-text fallback. It stays BLOCKED with parsed=0.
    return result
