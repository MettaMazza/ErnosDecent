# ─────────────────────────────────────────────────────
# orchestrator.ep — Agent Orchestration Module
# ErnosDecent Agent Framework
# ─────────────────────────────────────────────────────
# Enables spawning sub-agents as threads, waiting for
# results, cancelling tasks, and running agent swarms.
# ─────────────────────────────────────────────────────

import "collections"
import "string"
import "memory"
import "sync"
import "trace"
import "../storage"

# Forward declarations break the deliberate react_loop ↔ orchestrator module cycle.
# The implementations are defined in react_loop.ep and linked into every caller that
# constructs or runs an orchestrator.
external define react_run with model as Map and memory_mgr as Map and tools_mgr as Map and ctx as Map and user_prompt as Str returning Str
external define react_write_mid_message with session_id as Str and content as Str returning Int
external define react_request_cancel with session_id as Str returning Int

external define cast_borrow_to_map with borrow b as Map returning Map
external define cast_map_to_int with m as Map returning Int
external define cast_int_to_map with i as Int returning Map
# react_run keeps its active session id in a thread-local (ep_active_session_id is
# __thread), so each spawned sub-agent thread has its own and no longer clobbers the
# parent's or its siblings'.
external define tools_set_active_session with sid as Str returning Int

# ─────────────────────────────────────────────────────
# Completion delivery model
# ─────────────────────────────────────────────────────
# A spawned sub-agent records its result on its task map (status=completed, result)
# and leaves reported=0. Delivery is PULL-based, exactly-once via the reported flag:
#   • orchestrator_drain_completed(orch, sid) — the parent's ACTIVE react loop pulls
#     its session's finished sub-agents each iteration and injects them mid-turn
#     (labelled as sub-agent results, NOT user input).
#   • orchestrator_pull_completed / orchestrator_claim_report — the background
#     scheduler proactively reports finished sub-agents whose session is IDLE.
# Whichever path marks reported=1 first wins, so each result is delivered once.

# orchestrator_drain_completed: framed text for this session's finished, unreported
# sub-agents; marks them reported. Returns "" if none. Used by the active react loop.
define orchestrator_drain_completed with orch as Map and session_id as Str returning Str:
    set mtx to map_get_val(orch and "mutex")
    if mtx == 0 or else lock_mutex(mtx) == 0:
        display "[-] Orchestrator completion-drain mutex lock failed."
        return "[SUB-AGENT ERROR: completion state lock failed]\n"
    set tasks to map_get_val(orch and "tasks")
    set tkeys to map_keys(tasks)
    set tlen to length_list(tkeys)
    set out to ""
    set i to 0
    repeat while i < tlen:
        set k to get_list(tkeys and i)
        set tm to map_get_val(tasks and k)
        set st to ptr_to_str(map_get_val(tm and "status"))
        set rep to map_get_val(tm and "reported")
        set psid to ptr_to_str(map_get_val(tm and "parent_sid"))
        if st equals "completed" and rep == 0 and psid equals session_id:
            set trole to ptr_to_str(map_get_val(tm and "role"))
            set tres to ptr_to_str(map_get_val(tm and "result"))
            set hdr to concat("[SUB-AGENT '" and concat(trole and concat("' (task " and concat(k and ") completed. Result:]\n"))))
            set out to concat(out and concat(hdr and concat(tres and "\n")))
            set ok to map_insert(tm and "reported" and 1)
        set i to i + 1
    free_list(tkeys)
    set unlock_ok to unlock_mutex(mtx)
    if unlock_ok == 0:
        display "[-] Orchestrator completion-drain mutex unlock failed."
        return concat(out and "[SUB-AGENT ERROR: completion state unlock failed]\n")
    return out

# orchestrator_pull_completed: list of task_ids that are completed & not yet reported
# (no marking). The scheduler peeks, then claims the idle ones.
define orchestrator_pull_completed with orch as Map returning List:
    set mtx to map_get_val(orch and "mutex")
    if mtx == 0 or else lock_mutex(mtx) == 0:
        display "[-] Orchestrator completion-list mutex lock failed."
        set failed to create_list()
        set ok to append_list(failed and "error:orchestrator_lock_failed")
        return failed
    set tasks to map_get_val(orch and "tasks")
    set tkeys to map_keys(tasks)
    set tlen to length_list(tkeys)
    set out to create_list()
    set i to 0
    repeat while i < tlen:
        set k to get_list(tkeys and i)
        set tm to map_get_val(tasks and k)
        set st to ptr_to_str(map_get_val(tm and "status"))
        set rep to map_get_val(tm and "reported")
        if st equals "completed" and rep == 0:
            set ok to append_list(out and k)
        set i to i + 1
    free_list(tkeys)
    set unlock_ok to unlock_mutex(mtx)
    if unlock_ok == 0:
        display "[-] Orchestrator completion-list mutex unlock failed."
        set ok to append_list(out and "error:orchestrator_unlock_failed")
    return out

# orchestrator_claim_report: atomically claim a task for proactive reporting. Returns
# 1 if THIS caller marked it reported (it was completed & unreported), else 0.
define orchestrator_claim_report with orch as Map and task_id as Str returning Int:
    set mtx to map_get_val(orch and "mutex")
    if mtx == 0 or else lock_mutex(mtx) == 0:
        display "[-] Orchestrator report-claim mutex lock failed."
        return 0 - 1
    set tasks to map_get_val(orch and "tasks")
    set claimed to 0
    if map_contains(tasks and task_id) == 1:
        set tm to map_get_val(tasks and task_id)
        set st to ptr_to_str(map_get_val(tm and "status"))
        set rep to map_get_val(tm and "reported")
        if st equals "completed" and rep == 0:
            set ok to map_insert(tm and "reported" and 1)
            set claimed to 1
    set unlock_ok to unlock_mutex(mtx)
    if unlock_ok == 0:
        display "[-] Orchestrator report-claim mutex unlock failed."
        return 0 - 1
    return claimed

# orchestrator_task_field: read a string field from a task map (parent_sid/role/result).
define orchestrator_task_field with orch as Map and task_id as Str and field as Str returning Str:
    set mtx to map_get_val(orch and "mutex")
    if mtx == 0 or else lock_mutex(mtx) == 0:
        display "[-] Orchestrator task-field mutex lock failed."
        return "error:orchestrator_lock_failed"
    set tasks to map_get_val(orch and "tasks")
    set val to ""
    if map_contains(tasks and task_id) == 1:
        set tm to map_get_val(tasks and task_id)
        if map_contains(tm and field) == 1:
            set val to ptr_to_str(map_get_val(tm and field))
    set unlock_ok to unlock_mutex(mtx)
    if unlock_ok == 0:
        display "[-] Orchestrator task-field mutex unlock failed."
        return "error:orchestrator_unlock_failed"
    return val

# ─────────────────────────────────────────────────────
# orchestrator_create
# Creates and returns a new orchestrator state map
# containing: "tasks" map, "results" map, "counter"
# (integer), and "mutex" for thread safety.
# ─────────────────────────────────────────────────────
define orchestrator_create returning Int:
    set orch to create_map()
    set tasks to create_map()
    set results to create_map()
    set mtx to create_mutex()
    if mtx == 0:
        display "[-] Orchestrator mutex creation failed."
        return 0
    set ok to map_insert(orch and "tasks" and tasks)
    set ok to map_insert(orch and "results" and results)
    set ok to map_insert(orch and "counter" and 0)
    set ok to map_insert(orch and "mutex" and mtx)
    return orch


# ─────────────────────────────────────────────────────
# orchestrator_generate_id
# Thread-safe unique task ID generation. Locks mutex,
# increments internal counter, unlocks, and returns
# a string of the form "agent_N".
# ─────────────────────────────────────────────────────
define orchestrator_generate_id with orch as Map returning Str:
    set mtx to map_get_val(orch and "mutex")
    if mtx == 0 or else lock_mutex(mtx) == 0:
        display "[-] Orchestrator ID mutex lock failed."
        return "error:orchestrator_lock_failed"
    set counter to map_get_val(orch and "counter")
    set counter to counter + 1
    set ok to map_insert(orch and "counter" and counter)
    set unlock_ok to unlock_mutex(mtx)
    if unlock_ok == 0:
        display "[-] Orchestrator ID mutex unlock failed."
        return "error:orchestrator_unlock_failed"
    set id_str to concat("agent_" and int_to_string(counter))
    return id_str


# ─────────────────────────────────────────────────────
# orchestrator_spawn_worker
# Runs inside a spawned thread. Builds a role-prefixed
# prompt, calls react_run to execute the ReAct loop,
# then sends the result through the provided channel.
# ─────────────────────────────────────────────────────
define orchestrator_trace_emit_checked with db as Int and session_id as Str and event_type as Str and content as Str returning Int:
    set trace_error to trace_emit(db and session_id and event_type and content)
    if trace_error != 0:
        display concat("[-] Orchestrator trace persistence failed: " and event_type)
    return trace_error

async define orchestrator_spawn_worker with task_id as Str and instruction as Str and role as Str and model as Int and memory_mgr as Map and tools_mgr as Map and ctx as Map and result_ch as Int and orch as Map and parent_sid as Str returning Int:
    set role_prefix to concat("[Role: " and role)
    set prompt to concat(role_prefix and concat("] " and instruction))
    display concat("[DELEGATE] worker thread BEGIN task=" and task_id)
    # react_run sets its OWN thread-local active session (ep_active_session_id is
    # __thread), so this worker no longer clobbers the parent's or sibling agents'.
    # memory_mgr, tools_mgr and ctx are the caller's freshly-cloned, owned Maps handed
    # off to this thread (so concurrent map writes can't race the main agent). Only
    # `model` stays shared — it is read-only during a run.
    set result to react_run(cast_int_to_map(model) and memory_mgr and tools_mgr and ctx and prompt)
    display concat("[DELEGATE] worker thread END   task=" and concat(task_id and concat(" result_len=" and int_to_string(string_length(result)))))
    # Record the result on the task map + results map (mutex-guarded) so a polling
    # orchestrator_check sees completion even if no one is blocked in orchestrator_wait.
    set wmtx to map_get_val(orch and "mutex")
    if wmtx == 0 or else lock_mutex(wmtx) == 0:
        display concat("[-] Orchestrator worker completion mutex lock failed for task=" and task_id)
        send "Error: sub-agent result could not be recorded because the orchestrator lock failed." to result_ch
        return 1
    set wtasks to map_get_val(orch and "tasks")
    if map_contains(wtasks and task_id) == 1:
        set wtm to map_get_val(wtasks and task_id)
        set ok to map_insert(wtm and "status" and "completed")
        set ok to map_insert(wtm and "result" and result)
    set wresults to map_get_val(orch and "results")
    set ok to map_insert(wresults and task_id and result)
    set unlock_ok to unlock_mutex(wmtx)
    if unlock_ok == 0:
        display concat("[-] Orchestrator worker completion mutex unlock failed for task=" and task_id)
        send "Error: sub-agent result was produced but the orchestrator unlock failed." to result_ch
        return 1
    display concat("[DELEGATE] worker recorded completion task=" and concat(task_id and concat(" parent_sid=" and parent_sid)))
    # TRACE: notify the parent session that this sub-agent finished so Discord/WebUI
    # can update status and stop polling. Uses parent_sid so the parent sees it.
    set cmp_db to storage_get_db()
    if cmp_db > 0:
        set cmp_summary to string_replace(substring(result and 0 and 200) and "\"" and "'")
        set ok to orchestrator_trace_emit_checked(cmp_db and parent_sid and "subagent_complete" and concat("{\"task_id\":\"" and concat(task_id and concat("\",\"status\":\"completed\",\"result_summary\":\"" and concat(cmp_summary and "\"}")))))
    # PROACTIVE PING: notify the user the moment the background sub-agent finishes by
    # pushing its result as a mid-turn message (trace 'mid_message' — the web/Discord
    # client polls it). orchestrator_claim_report atomically marks the task reported,
    # so if the parent's active turn already drained+reported it we skip (delivered once).
    set claimed to orchestrator_claim_report(orch and task_id)
    if claimed < 0:
        display concat("[-] Sub-agent completion could not be claimed for task=" and task_id)
    if claimed == 1:
        set pmsg to concat("✓ Sub-agent '" and concat(role and concat("' (" and concat(task_id and concat(") finished:\n" and result)))))
        set ok to react_write_mid_message(parent_sid and pmsg)
        if ok != 0:
            display concat("[-] Sub-agent completion message delivery failed for task=" and task_id)
        else:
            display concat("[DELEGATE] worker pinged user with result task=" and task_id)
    # Wake any blocked orchestrator_wait. Channel is buffered (cap 1024) so this
    # never blocks the worker even if the parent hasn't called wait yet.
    send result to result_ch
    return 0


# ─────────────────────────────────────────────────────
# _orch_clone_map
# Performs a shallow copy of a map structure.
# ─────────────────────────────────────────────────────
define _orch_clone_map with src as Map returning Map:
    set dest to create_map()
    set keys to map_keys(src)
    set len to length_list(keys)
    set i to 0
    repeat while i < len:
        set k to get_list(keys and i)
        set v to map_get_val(src and k)
        set ok to map_insert(dest and k and v)
        set i to i + 1
    free_list(keys)
    return dest


# ─────────────────────────────────────────────────────
# _orch_clone_memory
# Creates an isolated Hebbian memory state for a sub-agent.
# Copies read-only knowledge references but allocates clean
# reasoning, timeline, and scratchpad structures.
# ─────────────────────────────────────────────────────
define _orch_clone_memory with src as Map returning Map:
    # FULLY ISOLATED memory for the sub-agent. The previous version shared the
    # synaptic graph / edges / nodes by reference (map_get_val(src ...)), so the
    # sub-agent thread and the main agent wrote the same maps concurrently — EP maps
    # are not thread-safe, so that raced and segfaulted (map_contains during a resize).
    # A fresh, correctly-typed memory via memory_create gives the sub-agent its own
    # structures; nothing mutable is shared with the parent.
    set dest to memory_create()
    set ok to memory_init_synaptic_graph(dest)
    return dest


# ─────────────────────────────────────────────────────
# orchestrator_spawn
# Public API to spawn a new sub-agent. Generates a
# unique task ID, creates isolated ctx and memory managers,
# stores them in the task_map to keep them GC-safe,
# and spawns the worker thread.
# ─────────────────────────────────────────────────────
define orchestrator_spawn with orch as Map and instruction as Str and role as Str and model as Int and memory_mgr as Int and tools_mgr as Int and ctx as Int returning Str:
    set task_id to orchestrator_generate_id(orch)
    if string_index_of(task_id and "error:") == 0:
        return task_id
    set ch to create_channel()
    display concat("[DELEGATE] orchestrator_spawn ENTRY task=" and concat(task_id and concat(" role=" and role)))

    # Clone context, memory AND tools to prevent concurrent mutations / data races.
    # tools_mgr is cloned because tool/schema building writes back into it (e.g. the
    # cached "schemas" string) — sharing it with the running main agent raced.
    set child_ctx to _orch_clone_map(cast_int_to_map(ctx))
    set child_memory to _orch_clone_memory(cast_int_to_map(memory_mgr))
    set child_tools to _orch_clone_map(cast_int_to_map(tools_mgr))

    # Capture the parent's session id from the CLONE (a legitimately-owned Map),
    # before we strip it below. Reading it via an assigned `cast_borrow_to_map(ctx)`
    # local instead would make the codegen free that owned borrow-view at scope exit
    # — i.e. free the parent's real ctx — corrupting it (the crash after delegate).
    set parent_sid to ""
    if map_contains(child_ctx and "session_id") == 1:
        set parent_sid to ptr_to_str(map_get_val(child_ctx and "session_id"))

    # Clean transient query-local properties from child context
    set ok to map_delete(child_ctx and "session_id")
    # Drop the shared session manager — the sub-agent has its own session (task_id)
    # and does not persist; sharing the live sessions_mgr raced with the main agent.
    set ok to map_delete(child_ctx and "sessions")
    set ok to map_delete(child_ctx and "was_cancelled")
    set ok to map_delete(child_ctx and "pending_action")
    set ok to map_delete(child_ctx and "pending_clarification")
    set ok to map_delete(child_ctx and "auto_approve")
    set ok to map_delete(child_ctx and "tool_approved")
    set ok to map_delete(child_ctx and "consecutive_denials")
    set ok to map_delete(child_ctx and "last_reasoning")
    set ok to map_delete(child_ctx and "clarify_rounds")
    set ok to map_delete(child_ctx and "clarify_done")
    # P11: a caller holding HUMAN-granted auto-approval (the per-session AUTOAPPROVE
    # toggle) may propagate it to its sub-agents via this explicit key. A sub-agent
    # still cannot SELF-approve — plain auto_approve is stripped above; this only
    # honors consent the operator already gave. test_all_systems uses it so the
    # approval-gated diagnostic blocks can run under the operator's session grant.
    if map_contains(child_ctx and "child_auto_approve") == 1:
        set ok to map_insert(child_ctx and "auto_approve" and 1)
        set ok to map_delete(child_ctx and "child_auto_approve")

    # Set sub-agent properties — point the ctx at the sub-agent's OWN isolated tools
    # and memory so any nested delegation / tool lookup uses the clones, not the
    # parent's shared maps.
    set ok to map_insert(child_ctx and "session_id" and task_id)
    set ok to map_insert(child_ctx and "parent_session_id" and parent_sid)
    set ok to map_insert(child_ctx and "memory" and child_memory)
    set ok to map_insert(child_ctx and "memory_mgr" and child_memory)
    set ok to map_insert(child_ctx and "tools_mgr" and child_tools)

    # Build task metadata map
    set task_map to create_map()
    set ok to map_insert(task_map and "channel" and ch)
    set ok to map_insert(task_map and "role" and role)
    set ok to map_insert(task_map and "status" and "running")
    set ok to map_insert(task_map and "result" and "")
    set ok to map_insert(task_map and "task_id" and task_id)
    set ok to map_insert(task_map and "parent_sid" and parent_sid)
    set ok to map_insert(task_map and "reported" and 0)
    
    # Store references to prevent GC sweep of thread args on thread startup
    set ok to map_insert(task_map and "child_ctx" and child_ctx)
    set ok to map_insert(task_map and "child_memory" and child_memory)
    set ok to map_insert(task_map and "child_tools" and child_tools)
    set ok to map_insert(task_map and "instruction" and instruction)

    # Store task under orchestrator with mutex protection
    set mtx to map_get_val(orch and "mutex")
    if mtx == 0 or else lock_mutex(mtx) == 0:
        display concat("[-] Orchestrator task registration mutex lock failed for task=" and task_id)
        return "error:orchestrator_lock_failed"
    set tasks to map_get_val(orch and "tasks")
    set ok to map_insert(tasks and task_id and task_map)
    set unlock_ok to unlock_mutex(mtx)
    if unlock_ok == 0:
        display concat("[-] Orchestrator task registration mutex unlock failed for task=" and task_id)
        return "error:orchestrator_unlock_failed"

    # Spawn the sub-agent on its OWN thread so multiple sub-agents run in parallel.
    # Each thread has: its own thread-local active session (ep_active_session_id is
    # __thread), its own cloned ctx + memory, and its own task_id as session id — so
    # workers no longer clobber the parent or each other. The worker records its
    # result on the task map and sends it down the channel; orchestrator_wait blocks
    # on the channel, orchestrator_check polls the task map. Returns the task_id
    # immediately so the caller can fan out many agents and keep working.
    # Dispatch the sub-agent as an ASYNC TASK on the event loop (not an OS thread).
    # The async call enqueues the task and returns immediately; it runs cooperatively
    # — interleaved at LLM await points with the parent turn and sibling sub-agents —
    # on the single agent thread, so there is no shared-heap race. We don't await the
    # future; completion is recorded on the task map and drained on a later turn.
    display concat("[DELEGATE] dispatching async sub-agent task=" and concat(task_id and concat(" role=" and concat(role and concat(" parent_sid=" and parent_sid)))))
    set subfut to orchestrator_spawn_worker(task_id and instruction and role and model and child_memory and child_tools and child_ctx and ch and orch and parent_sid)
    # Store the worker's completion future so an ASYNC caller can `await` the whole
    # sub-agent with a SINGLE await (the compiler mis-lowers awaits in loops inside
    # async defines — see tools_validation_block — so await-once-then-check is the
    # only safe sequencing primitive for async coordinators).
    set future_lock_ok to lock_mutex(mtx)
    if future_lock_ok == 0:
        display concat("[-] Orchestrator future mutex lock failed for task=" and task_id)
        return concat("error:orchestrator_future_lock_failed:" and task_id)
    set ok to map_insert(task_map and "future" and subfut)
    set future_unlock_ok to unlock_mutex(mtx)
    if future_unlock_ok == 0:
        display concat("[-] Orchestrator future mutex unlock failed for task=" and task_id)
        return concat("error:orchestrator_future_unlock_failed:" and task_id)
    # TRACE: notify the parent session so Discord/WebUI can create sub-agent
    # threads and monitoring panels. The event is under parent_sid so the
    # parent's trace poll picks it up.
    set sp_db to storage_get_db()
    if sp_db > 0:
        set sp_inst_esc to string_replace(substring(instruction and 0 and 100) and "\"" and "'")
        set sp_role_esc to string_replace(role and "\"" and "'")
        set ok to orchestrator_trace_emit_checked(sp_db and parent_sid and "subagent_spawn" and concat("{\"task_id\":\"" and concat(task_id and concat("\",\"role\":\"" and concat(sp_role_esc and concat("\",\"instruction\":\"" and concat(sp_inst_esc and "\"}")))))))
    return task_id


# ─────────────────────────────────────────────────────
# orchestrator_wait
# Blocks until the specified task completes by
# receiving from its channel. Once the result arrives,
# updates the task status to "completed", stores the
# result, and returns it.
# Returns "error:task_not_found" if task_id is invalid.
# ─────────────────────────────────────────────────────
# The completion FUTURE of a task's worker (0 when unknown). For async callers that
# need to sequence on a sub-agent with one await; the result text still comes from
# orchestrator_check afterwards ("completed:<response>").
define orchestrator_task_future with orch as Map and task_id as Str returning Int:
    set mtx to map_get_val(orch and "mutex")
    if mtx == 0 or else lock_mutex(mtx) == 0:
        display "[-] Orchestrator task-future mutex lock failed."
        return 0 - 1
    set tasks to map_get_val(orch and "tasks")
    if map_contains(tasks and task_id) == 0:
        set unlock_ok to unlock_mutex(mtx)
        if unlock_ok == 0:
            display "[-] Orchestrator task-future mutex unlock failed."
            return 0 - 1
        return 0
    set task_map to map_get_val(tasks and task_id)
    set fut to 0
    if map_contains(task_map and "future") == 1:
        set fut to map_get_val(task_map and "future")
    set unlock_ok to unlock_mutex(mtx)
    if unlock_ok == 0:
        display "[-] Orchestrator task-future mutex unlock failed."
        return 0 - 1
    return fut

define orchestrator_wait with orch as Map and task_id as Str returning Str:
    set mtx to map_get_val(orch and "mutex")
    if mtx == 0 or else lock_mutex(mtx) == 0:
        display "[-] Orchestrator wait mutex lock failed."
        return "error:orchestrator_lock_failed"
    set tasks to map_get_val(orch and "tasks")
    set has_task to map_contains(tasks and task_id)
    if has_task == 0:
        set unlock_ok to unlock_mutex(mtx)
        if unlock_ok == 0:
            return "error:orchestrator_unlock_failed"
        return "error:task_not_found"
    set task_map to map_get_val(tasks and task_id)
    # If the worker already finished, return its recorded result without touching the
    # channel (a second receive on a drained channel would block forever).
    set cur_status to ptr_to_str(map_get_val(task_map and "status"))
    if cur_status equals "completed":
        set done_result to ptr_to_str(map_get_val(task_map and "result"))
        set unlock_ok to unlock_mutex(mtx)
        if unlock_ok == 0:
            return "error:orchestrator_unlock_failed"
        display concat("[DELEGATE] orchestrator_wait (already done) task=" and task_id)
        return done_result
    set ch to map_get_val(task_map and "channel")
    set unlock_ok to unlock_mutex(mtx)
    if unlock_ok == 0:
        return "error:orchestrator_unlock_failed"
    display concat("[DELEGATE] orchestrator_wait BLOCKING on channel task=" and task_id)
    # Block until the worker thread sends its result down the buffered channel.
    set rcv to receive from ch
    set result to ptr_to_str(rcv)
    display concat("[DELEGATE] orchestrator_wait GOT result task=" and concat(task_id and concat(" len=" and int_to_string(string_length(result)))))
    return result


# ─────────────────────────────────────────────────────
# orchestrator_check
# Non-blocking status check for a task. Returns:
#   "running"              — task still in progress
#   "completed:<response>" — task finished
#   "cancelled"            — task was cancelled
#   "not_found"            — no such task_id
# ─────────────────────────────────────────────────────
define orchestrator_check with orch as Map and task_id as Str returning Str:
    set mtx to map_get_val(orch and "mutex")
    if mtx == 0 or else lock_mutex(mtx) == 0:
        display "[-] Orchestrator status mutex lock failed."
        return "error:orchestrator_lock_failed"
    set tasks to map_get_val(orch and "tasks")
    set has_task to map_contains(tasks and task_id)
    if has_task == 0:
        set unlock_ok to unlock_mutex(mtx)
        if unlock_ok == 0:
            return "error:orchestrator_unlock_failed"
        return "not_found"
    set task_map to map_get_val(tasks and task_id)
    set status to ptr_to_str(map_get_val(task_map and "status"))
    if status equals "completed":
        set result to ptr_to_str(map_get_val(task_map and "result"))
        set unlock_ok to unlock_mutex(mtx)
        if unlock_ok == 0:
            return "error:orchestrator_unlock_failed"
        set response to concat("completed:" and result)
        return response
    if status equals "cancelled":
        set unlock_ok to unlock_mutex(mtx)
        if unlock_ok == 0:
            return "error:orchestrator_unlock_failed"
        return "cancelled"
    # Status is still "running"
    set unlock_ok to unlock_mutex(mtx)
    if unlock_ok == 0:
        return "error:orchestrator_unlock_failed"
    return "running"


# ─────────────────────────────────────────────────────
# orchestrator_get_task
# Returns the raw task_map (Int pointer) for a given task_id, or 0 if not found.
# Used by the approval-forwarding system (react_resume_subagent_approval) to
# access the child's ctx and its approval_channel for channel-based suspend/resume.
# ─────────────────────────────────────────────────────
define orchestrator_get_task with orch as Map and task_id as Str returning Int:
    set mtx to map_get_val(orch and "mutex")
    if mtx == 0 or else lock_mutex(mtx) == 0:
        display "[-] Orchestrator task-read mutex lock failed."
        return 0 - 1
    set tasks to map_get_val(orch and "tasks")
    set has_task to map_contains(tasks and task_id)
    if has_task == 0:
        set unlock_ok to unlock_mutex(mtx)
        if unlock_ok == 0:
            return 0 - 1
        return 0
    set task_map to map_get_val(tasks and task_id)
    set unlock_ok to unlock_mutex(mtx)
    if unlock_ok == 0:
        return 0 - 1
    return cast_map_to_int(task_map)


# ─────────────────────────────────────────────────────
# orchestrator_cancel
# Requests cancellation of a running task. Calls
# react_request_cancel with the task_id, updates
# the task status to "cancelled".
# Returns "cancelled" or "not_found".
# ─────────────────────────────────────────────────────
define orchestrator_cancel with orch as Map and task_id as Str returning Str:
    set mtx to map_get_val(orch and "mutex")
    if mtx == 0 or else lock_mutex(mtx) == 0:
        display "[-] Orchestrator cancel mutex lock failed."
        return "error:orchestrator_lock_failed"
    set tasks to map_get_val(orch and "tasks")
    set has_task to map_contains(tasks and task_id)
    if has_task == 0:
        set unlock_ok to unlock_mutex(mtx)
        if unlock_ok == 0:
            return "error:orchestrator_unlock_failed"
        return "not_found"
    set task_map to map_get_val(tasks and task_id)
    set ok to map_insert(task_map and "status" and "cancelled")
    set unlock_ok to unlock_mutex(mtx)
    if unlock_ok == 0:
        return "error:orchestrator_unlock_failed"
    # Cancel the ReAct loop outside the lock to avoid
    # holding the mutex during an external call
    set cancel_error to react_request_cancel(task_id)
    if cancel_error != 0:
        return concat("error:cancel_request_failed:" and int_to_string(cancel_error))
    return "cancelled"


# ─────────────────────────────────────────────────────
# orchestrator_list
# Lists all tracked tasks with their role and current
# status, formatted as a simple table string:
#   task_id | role | status
# Returns "No active tasks." if the task map is empty.
# ─────────────────────────────────────────────────────
define orchestrator_list with orch as Map returning Str:
    set mtx to map_get_val(orch and "mutex")
    if mtx == 0 or else lock_mutex(mtx) == 0:
        display "[-] Orchestrator list mutex lock failed."
        return "error:orchestrator_lock_failed"
    set tasks to map_get_val(orch and "tasks")
    set keys to map_keys(tasks)
    set count to length_list(keys)
    set unlock_ok to unlock_mutex(mtx)
    if unlock_ok == 0:
        return "error:orchestrator_unlock_failed"
    if count == 0:
        free_list(keys)
        return "No active tasks."
    # Build header
    set output to "task_id          | role             | status\n"
    set output to concat(output and "-----------------+------------------+-----------\n")
    # Build rows
    set i to 0
    repeat while i < count:
        set key to get_list(keys and i)
        set row_lock_ok to lock_mutex(mtx)
        if row_lock_ok == 0:
            free_list(keys)
            return "error:orchestrator_lock_failed"
        set task_map to map_get_val(tasks and key)
        set role to ptr_to_str(map_get_val(task_map and "role"))
        set status to ptr_to_str(map_get_val(task_map and "status"))
        set row_unlock_ok to unlock_mutex(mtx)
        if row_unlock_ok == 0:
            free_list(keys)
            return "error:orchestrator_unlock_failed"
        set row to concat(ptr_to_str(key) and " | ")
        set row to concat(row and concat(role and " | "))
        set row to concat(row and concat(status and "\n"))
        set output to concat(output and row)
        set i to i + 1
    free_list(keys)
    return output


# ─────────────────────────────────────────────────────
# _orch_split_by_pipe (internal helper)
# Splits a string by the "|" delimiter into a list of
# trimmed substrings. Returns a list handle (caller
# must free_list when done).
# ─────────────────────────────────────────────────────
define _orch_split_by_pipe with input as Str returning Int:
    set parts to create_list()
    set remaining to input
    set pos to string_index_of(remaining and "|")
    repeat while pos != -1:
        set part to substring(remaining and 0 and pos)
        set part to string_trim(part)
        set ok to append_list(parts and str_to_ptr(part))
        set rest_start to pos + 1
        set rest_len to string_length(remaining) - rest_start
        if rest_len > 0:
            set remaining to substring(remaining and rest_start and rest_len)
        else:
            set remaining to ""
        set pos to string_index_of(remaining and "|")
    # Append the final segment after the last "|"
    set remaining to string_trim(remaining)
    if string_length(remaining) > 0:
        set ok to append_list(parts and str_to_ptr(remaining))
    return parts


# ─────────────────────────────────────────────────────
# _orch_merge_concat (internal helper)
# Merges a list of result strings by concatenating
# them with "---" separators between each.
# ─────────────────────────────────────────────────────
define _orch_merge_concat with results as List returning Str:
    set count to length_list(results)
    if count == 0:
        return ""
    set output to ptr_to_str(get_list(results and 0))
    set i to 1
    repeat while i < count:
        set item to ptr_to_str(get_list(results and i))
        set output to concat(output and concat("\n---\n" and item))
        set i to i + 1
    return output


# ─────────────────────────────────────────────────────
# _orch_merge_best (internal helper)
# Selects the "best" result by choosing the response
# with the greatest string length.
# ─────────────────────────────────────────────────────
define _orch_merge_best with results as List returning Str:
    set count to length_list(results)
    if count == 0:
        return ""
    set best to ptr_to_str(get_list(results and 0))
    set best_len to string_length(best)
    set i to 1
    repeat while i < count:
        set item to ptr_to_str(get_list(results and i))
        set item_len to string_length(item)
        if item_len > best_len:
            set best to item
            set best_len to item_len
        set i to i + 1
    return best


# ─────────────────────────────────────────────────────
# _orch_merge_vote (internal helper)
# Simple majority-vote merge. Counts how many times
# each identical response appears and returns the most
# frequent one. Falls back to the first result if all
# responses are unique.
# ─────────────────────────────────────────────────────
define _orch_merge_vote with results as List returning Str:
    set count to length_list(results)
    if count == 0:
        return ""
    # Count occurrences of each unique response
    set counts_map to create_map()
    set best to ptr_to_str(get_list(results and 0))
    set best_count to 0
    set i to 0
    repeat while i < count:
        set item to ptr_to_str(get_list(results and i))
        set has_key to map_contains(counts_map and item)
        if has_key == 1:
            set cur_count to map_get_val(counts_map and item)
            set cur_count to cur_count + 1
            set ok to map_insert(counts_map and item and cur_count)
        else:
            set ok to map_insert(counts_map and item and 1)
            set cur_count to 1
        if cur_count > best_count:
            set best to item
            set best_count to cur_count
        set i to i + 1
    return best


# ─────────────────────────────────────────────────────
# orchestrator_swarm
# High-level swarm execution. Splits sub_tasks_str by
# the "|" delimiter, spawns one sub-agent per task
# (all running concurrently), waits for all to finish,
# then merges the results using join_strategy:
#   "concat" — concatenate all results
#   "best"   — select the longest result
#   "vote"   — majority vote on identical results
# Falls back to "concat" for unknown strategies.
# ─────────────────────────────────────────────────────
define orchestrator_swarm with orch as Map and instruction as Str and sub_tasks_str as Str and join_strategy as Str and model as Int and memory_mgr as Int and tools_mgr as Int and ctx as Int returning Str:
    # Split the sub-tasks string by "|"
    set parts to _orch_split_by_pipe(sub_tasks_str)
    set num_tasks to length_list(parts)
    if num_tasks == 0:
        free_list(parts)
        return "error:no_sub_tasks"
    # ASYNC dispatch: spawn one background sub-agent per sub-task and return
    # immediately. We do NOT block waiting for results (that would deadlock under the
    # global run lock, since the workers need that same lock). Each sub-agent runs in
    # the background — serialized one at a time — and reports its result to the user
    # proactively on completion (see scheduler_report_completion). join_strategy is
    # accepted for compatibility but no longer merges synchronously; results arrive as
    # individual proactive updates.
    set dispatched to ""
    set i to 0
    repeat while i < num_tasks:
        set sub_task to ptr_to_str(get_list(parts and i))
        set full_instruction to concat(instruction and concat(": " and sub_task))
        set role to concat("swarm_worker_" and int_to_string(i))
        set tid to orchestrator_spawn(orch and full_instruction and role and model and memory_mgr and tools_mgr and ctx)
        if string_index_of(tid and "error:") == 0:
            free_list(parts)
            return concat("error:swarm_dispatch_failed:" and tid)
        set dispatched to concat(dispatched and concat("\n - " and concat(role and concat(" (" and concat(tid and concat("): " and sub_task))))))
        set i to i + 1
    free_list(parts)
    return concat("Dispatched " and concat(int_to_string(num_tasks) and concat(" background sub-agents. They are running now and will each report their result to the user as they finish. Tell the user you've dispatched them; do NOT wait.\nDispatched:" and dispatched)))
