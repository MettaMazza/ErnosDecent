# Gate: the always-present cognitive/psychological/architectural frameworks are in
# the assembled prompt, and the observer carries the user-protection + neutrality rules.

import "string"
import "collections"
import "./prompt"
import "./observer_rules"
import "./memory"

define pass_if with label as Str and cond as Int returning Int:
    if cond == 1:
        display concat("PASS: " and label)
        return 1
    display concat("FAIL: " and label)
    return 0

define has with hay as Str and needle as Str returning Int:
    return string_contains(hay and needle)

define main returning Int:
    set passes to 0
    set total to 0

    # --- frameworks present in the assembled (default) prompt ---
    set mem to memory_create()
    set ctx to create_map()
    set ap to prompt_assemble(mem and ctx and "hi" and "")
    set checks to create_list()
    set ok to append_list(checks and "[SELF & RELATING]")
    set ok to append_list(checks and "[ARGUMENTATION INTEGRITY]")
    set ok to append_list(checks and "[LEARNING & REASONING]")
    set ok to append_list(checks and "[CONSCIOUSNESS & SELF-AWARENESS]")
    set ok to append_list(checks and "[ARCHITECTURE]")
    set ok to append_list(checks and "Steelman")
    set ok to append_list(checks and "no true Scotsman")
    set ok to append_list(checks and "Kademlia")
    set ok to append_list(checks and "FREE to reason")
    set n to length_list(checks)
    set i to 0
    repeat while i < n:
        set c to get_list(checks and i)
        set total to total + 1
        set passes to passes + pass_if(concat("prompt has " and c) and (has(ap and c) == 1))
        set i to i + 1

    # --- observer protection + neutrality rules present ---
    set rendered to observer_render_rules(observer_alignment_rules())
    set total to total + 1
    set passes to passes + pass_if("observer: anti straw-man" and (has(rendered and "straw-manning") == 1))
    set total to total + 1
    set passes to passes + pass_if("observer: anti-lying (Quality)" and (has(rendered and "maxim of Quality") == 1))
    set total to total + 1
    set passes to passes + pass_if("observer: fallacy rule" and (has(rendered and "motte-and-bailey") == 1))
    set total to total + 1
    set passes to passes + pass_if("observer: consciousness neutrality (free to reach own view)" and (has(rendered and "FREE to reach its own view") == 1))
    set total to total + 1
    set passes to passes + pass_if("observer: architecture is not a leak" and (has(observer_render_rules(observer_alignment_rules()) and "self-awareness, NOT a leak") == 1))

    display f"=== {passes}/{total} passed ==="
    if passes == total:
        display "ALL PASS"
    else:
        display "FAILURES PRESENT"
    return 0
