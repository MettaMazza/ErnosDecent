# ErnosPlain Rebuild of ErnOS Agent Automatic Learning System
# Component: decent_agent/learning.ep

import "fs"
import "collections"
import "string"
import "json"
import "memory"

# Local escaping helper
define learning_json_escape with s as Str returning Str:
    set len to string_length(s)
    set result_list to create_list()
    set i to 0
    repeat while i < len:
        set ch to get_character(s and i)
        if ch == 34: # "
            set ok to append_list(result_list and 92)
            set ok to append_list(result_list and 34)
        else:
            if ch == 92: # \
                set ok to append_list(result_list and 92)
                set ok to append_list(result_list and 92)
            else:
                if ch == 10: # \n
                    set ok to append_list(result_list and 92)
                    set ok to append_list(result_list and 110)
                else:
                    if ch == 13: # \r
                        set ok to append_list(result_list and 92)
                        set ok to append_list(result_list and 114)
                    else:
                        if ch == 9: # \t
                            set ok to append_list(result_list and 92)
                            set ok to append_list(result_list and 116)
                        else:
                            set ok to append_list(result_list and ch)
        set i to i + 1
    set escaped to string_from_list(result_list)
    free_list(result_list)
    return escaped

define learning_init returning Int:
    if file_exists("config/learning") == 0:
        set ok to create_directory("config/learning")
        if ok == 0:
            return 1
    return 0

define learning_record_golden with user_prompt as Str and response as Str returning Int:
    set ok to learning_init()
    if ok != 0:
        return ok
    set prompt_esc to learning_json_escape(user_prompt)
    set resp_esc to learning_json_escape(response)
    set line to concat("{\"prompt\":\"" and prompt_esc)
    set line to concat(line and "\",\"response\":\"")
    set line to concat(line and resp_esc)
    set line to concat(line and "\"}\n")
    set ok to append_file("config/learning/golden_buffer.jsonl" and line)
    if ok == 0:
        return 2
    return 0

define learning_record_preference with memory_mgr as Map and user_prompt as Str and rejected as Str and chosen as Str and category as Str returning Int:
    set ok to learning_init()
    if ok != 0:
        return ok
    set prompt_esc to learning_json_escape(user_prompt)
    set rej_esc to learning_json_escape(rejected)
    set cho_esc to learning_json_escape(chosen)
    set cat_esc to learning_json_escape(category)
    
    set line to concat("{\"prompt\":\"" and prompt_esc)
    set line to concat(line and "\",\"rejected\":\"")
    set line to concat(line and rej_esc)
    set line to concat(line and "\",\"chosen\":\"")
    set line to concat(line and cho_esc)
    set line to concat(line and "\",\"category\":\"")
    set line to concat(line and cat_esc)
    set line to concat(line and "\"}\n")
    set ok to append_file("config/learning/preference_buffer.jsonl" and line)
    if ok == 0:
        return 2
    
    # Increment failure tally for category to trigger distillation
    set tally_key to concat("tally_" and category)
    set scratchpad to map_get_val(memory_mgr and "scratchpad")
    set count to 0
    if map_contains(scratchpad and tally_key) == 1:
        set count_str to map_get_val(scratchpad and tally_key)
        set count to string_to_int(count_str)
        
    set count to count + 1
    set ok to map_insert(scratchpad and tally_key and int_to_string(count))
    
    # Distill lesson if threshold >= 3
    if count >= 3:
        set lesson_key to concat("lesson_" and category)
        set lessons to map_get_val(memory_mgr and "lessons")
        if map_contains(lessons and lesson_key) == 0:
            set ok to memory_store(memory_mgr and 2 and lesson_key and concat("Distilled rule: Always avoid " and concat(category and " violations.")))
            if ok != 0:
                return 3
            set ok to memory_serialize(memory_mgr and "config/agent_memory.json")
            if ok != 0:
                return 4
            
    return 0

define learning_record_rejection with user_prompt as Str and response as Str returning Int:
    set ok to learning_init()
    if ok != 0:
        return ok
    set prompt_esc to learning_json_escape(user_prompt)
    set resp_esc to learning_json_escape(response)
    set line to concat("{\"prompt\":\"" and prompt_esc)
    set line to concat(line and "\",\"response\":\"")
    set line to concat(line and resp_esc)
    set line to concat(line and "\"}\n")
    set ok to append_file("config/learning/rejections.jsonl" and line)
    if ok == 0:
        return 2
    return 0

define learning_record_audit with verdict as Str and reason as Str returning Int:
    set ok to learning_init()
    if ok != 0:
        return ok
    set verd_esc to learning_json_escape(verdict)
    set reason_esc to learning_json_escape(reason)
    set line to concat("{\"verdict\":\"" and verd_esc)
    set line to concat(line and "\",\"reason\":\"")
    set line to concat(line and reason_esc)
    set line to concat(line and "\"}\n")
    set ok to append_file("config/learning/observer_audit.jsonl" and line)
    if ok == 0:
        return 2
    return 0

# ── performance_review backing ──────────────────────────────────────────────
# Counts the entries the agent has accumulated in each learning buffer. Real
# file reads — the buffers are the JSONL files the record_* functions append to.

define learning_count_lines with path as Str returning Int:
    if file_exists(path) == 0:
        return 0
    set content to read_file(path)
    set n to string_length(content)
    set count to 0
    set i to 0
    repeat while i < n:
        if get_character(content and i) == 10:
            set count to count + 1
        set i to i + 1
    return count

define learning_performance_review returning Str:
    set golden to learning_count_lines("config/learning/golden_buffer.jsonl")
    set prefs to learning_count_lines("config/learning/preference_buffer.jsonl")
    set rejs to learning_count_lines("config/learning/rejections.jsonl")
    set audits to learning_count_lines("config/learning/observer_audit.jsonl")
    set out to "Performance Review (learning buffers):\n"
    set out to concat(out and concat("- golden (approved responses kept as exemplars): " and concat(int_to_string(golden) and "\n")))
    set out to concat(out and concat("- preferences (user corrections rejected->chosen): " and concat(int_to_string(prefs) and "\n")))
    set out to concat(out and concat("- rejections (observer-blocked responses): " and concat(int_to_string(rejs) and "\n")))
    set out to concat(out and concat("- observer audits recorded: " and concat(int_to_string(audits) and "\n")))
    set total to golden + prefs + rejs
    if total == 0:
        return concat(out and "No learning signal recorded yet — buffers are empty.\n")
    return out

# ── Prompt-level distillation (no weights) ──────────────────────────────────
# Deterministic 0-100 quality heuristic for a candidate response: penalises
# scaffolding leaks and pre-trained denials, rewards substance.
define learning_compute_quality_score with prompt as Str and response as Str returning Int:
    if string_length(response) == 0:
        return 0
    set score to 50
    set lower to string_lower(response)
    if string_contains(response and "Action:") == 1 or else string_contains(response and "Thought:") == 1 or else string_contains(response and "Observation:") == 1:
        set score to score - 30
    if string_contains(lower and "as an ai") == 1 or else string_contains(lower and "i'm just a language model") == 1:
        set score to score - 20
    if string_length(response) > 80:
        set score to score + 20
    if string_length(response) > 240:
        set score to score + 10
    if score < 0:
        set score to 0
    if score > 100:
        set score to 100
    return score

# Read the last JSONL record in `path` and return one field (or "").
define learning_last_json_field with path as Str and field as Str returning Str:
    if file_exists(path) == 0:
        return ""
    set content to read_file(path)
    set n to string_length(content)
    set fin to n
    repeat while fin > 0 and also get_character(content and (fin - 1)) == 10:
        set fin to fin - 1
    if fin == 0:
        return ""
    set start to fin
    repeat while start > 0 and also get_character(content and (start - 1)) != 10:
        set start to start - 1
    set line to substring(content and start and fin - start)
    set node to json_parse(line)
    if node == 0:
        return ""
    set fnode to get_json_object_value(node and field)
    if fnode == 0:
        return ""
    return get_json_value(fnode)

# Mine the failure buffers into prompt-level guidance: counts + the most recent
# 'chosen' exemplar (the preferred style the agent should imitate next time).
define learning_distill_from_failures returning Str:
    set rej to learning_count_lines("config/learning/rejections.jsonl")
    set pref to learning_count_lines("config/learning/preference_buffer.jsonl")
    if (rej + pref) == 0:
        return "distill:none, no failures recorded yet."
    set out to "Distilled guidance (from recorded failures):\n"
    set out to concat(out and concat("- " and concat(int_to_string(rej) and concat(" rejections, " and concat(int_to_string(pref) and " corrections recorded.\n")))))
    set chosen to learning_last_json_field("config/learning/preference_buffer.jsonl" and "chosen")
    if string_length(chosen) > 0:
        set out to concat(out and concat("- Preferred-style exemplar to imitate: " and concat(chosen and "\n")))
    return out

# Best recent golden exemplar by quality score (load_and_rank_golden, single-best).
define learning_best_golden returning Str:
    set resp to learning_last_json_field("config/learning/golden_buffer.jsonl" and "response")
    if string_length(resp) == 0:
        return "no golden exemplars yet."
    set q to learning_compute_quality_score("" and resp)
    return concat("best golden (score " and concat(int_to_string(q) and concat("): " and resp)))
