# Failure-path regression gate for agent-facing mutations. Every assertion exercises
# a path that formerly returned a success string after the underlying write failed.

import "string"
import "collections"
import "sql"
import "fs"
import "./tools"
import "./memory"
import "./orchestrator"
import "./trace"
import "./changelog"
import "./turing_grid"
import "../storage"
import "../decent_net/dht"
import "../decent_net/bridge_rpc"

external define ep_cancel_epoch_get with dummy as Int returning Int

define tmf_pass with label as Str and condition as Int returning Int:
    if condition == 1:
        display concat("PASS: " and label)
        return 1
    display concat("FAIL: " and label)
    return 0

define tmf_args0 returning List:
    return create_list()

define tmf_args1 with a as Str returning List:
    set values to create_list()
    set ok to append_list(values and a)
    return values

define tmf_args2 with a as Str and b as Str returning List:
    set values to create_list()
    set ok to append_list(values and a)
    set ok to append_list(values and b)
    return values

define tmf_args3 with a as Str and b as Str and c as Any returning List:
    set values to create_list()
    set ok to append_list(values and a)
    set ok to append_list(values and b)
    set ok to append_list(values and c)
    return values

define tmf_args4 with a as Str and b as Str and c as Str and d as Str returning List:
    set values to create_list()
    set ok to append_list(values and a)
    set ok to append_list(values and b)
    set ok to append_list(values and c)
    set ok to append_list(values and d)
    return values

define main returning Int:
    set passed to 0
    set total to 0

    set init_rc to storage_init("/tmp/ernos_tools_mutation_storage")
    set total to total + 1
    set passed to passed + tmf_pass("storage initialized" and (init_rc == 0))
    set db to storage_get_db()
    set broken_tools_query to tools_sql_query_checked(db and "SELECT definitely_missing_column FROM reading_progress;")
    set total to total + 1
    set passed to passed + tmf_pass("checked tools query distinguishes SQL failure from no rows" and (map_get_val(broken_tools_query and "ok") == 0 and also map_get_val(broken_tools_query and "rc") != 0))

    # Normalize only the exact test-owned tables so reruns recover after interruption.
    set ok to sql_execute(db and "DROP TABLE IF EXISTS kg_entities;")
    set ok to sql_execute(db and "DROP TABLE IF EXISTS kg_relations;")
    set ok to sql_execute(db and "DROP TABLE IF EXISTS procedures;")
    set ok to sql_execute(db and "DROP TABLE IF EXISTS consolidations;")
    set ok to kg_ensure_schema(db)
    set ok to sql_execute(db and "DROP TABLE IF EXISTS reading_progress;")
    set ok to sql_execute(db and "CREATE TABLE reading_progress (document_name TEXT PRIMARY KEY, current_chunk INTEGER NOT NULL, notes TEXT NOT NULL, updated_at INTEGER NOT NULL);")
    set ok to sql_execute(db and "DROP TABLE IF EXISTS bridge_commands;")
    set ok to bridge_ensure_schema(db)
    set ok to sql_execute(db and "DROP TABLE IF EXISTS trace_whispers;")
    set ok to trace_init(db)

    set tools_mgr to tools_create("owner")
    set memory_mgr to memory_create()
    set ctx to create_map()
    set ok to map_insert(ctx and "memory" and memory_mgr)
    set ok to map_insert(ctx and "sender_role" and "owner")

    # Knowledge graph: both valid persistence and a deliberately malformed schema.
    set result to tools_execute(tools_mgr and ctx and "kg_tool" and tmf_args4("add_entity" and "maria" and "person" and "author"))
    set total to total + 1
    set passed to passed + tmf_pass("knowledge entity reports success only after insert" and (string_index_of(result and "kg:entity_added") == 0))
    set ok to sql_execute(db and "DROP TABLE kg_entities;")
    set ok to sql_execute(db and "CREATE TABLE kg_entities (bad TEXT);")
    set result to tools_execute(tools_mgr and ctx and "kg_tool" and tmf_args2("add_entity" and "must_fail"))
    set total to total + 1
    set passed to passed + tmf_pass("knowledge entity surfaces malformed-schema failure" and (string_index_of(result and "Error:") == 0))
    set total to total + 1
    set passed to passed + tmf_pass("knowledge schema validator rejects incompatible table" and (kg_ensure_schema(db) != 0))
    set ok to sql_execute(db and "DROP TABLE kg_entities;")
    set ok to kg_ensure_schema(db)

    # Procedure flags must affect exactly one existing row.
    set result to tools_execute(tools_mgr and ctx and "procedure_tool" and tmf_args3("store" and "release" and "build then test"))
    set total to total + 1
    set passed to passed + tmf_pass("procedure store persists" and (string_index_of(result and "procedure:stored") == 0))
    set result to tools_execute(tools_mgr and ctx and "procedure_tool" and tmf_args2("pin" and "missing"))
    set total to total + 1
    set passed to passed + tmf_pass("pinning a missing procedure is an error" and (string_index_of(result and "Error:") == 0))
    set total to total + 1
    set passed to passed + tmf_pass("procedure helper rejects injected flag column" and (procedure_set_flag(db and "release" and "pinned=1; DROP TABLE procedures; --" and 1) != 0))
    set ok to sql_execute(db and "DROP TABLE procedures;")
    set ok to sql_execute(db and "CREATE TABLE procedures (bad TEXT);")
    set result to tools_execute(tools_mgr and ctx and "procedure_tool" and tmf_args3("store" and "must_fail" and "steps"))
    set total to total + 1
    set passed to passed + tmf_pass("procedure store surfaces SQL failure" and (string_index_of(result and "Error:") == 0))
    set ok to sql_execute(db and "DROP TABLE procedures;")
    set ok to kg_ensure_schema(db)

    # Consolidation rollback is exact when durable history cannot be written.
    set lessons to map_get_val(memory_mgr and "lessons")
    set values_list to map_get_val(memory_mgr and "values_list")
    set old_values_len to length_list(values_list)
    set ok to sql_execute(db and "DROP TABLE consolidations;")
    set ok to sql_execute(db and "CREATE TABLE consolidations (bad TEXT);")
    set commit_error to tools_commit_consolidation(memory_mgr and db and "durable lesson" and 4)
    set total to total + 1
    set passed to passed + tmf_pass("consolidation reports durable failure" and (string_contains(commit_error and "durable_persistence_failed") == 1))
    set total to total + 1
    set passed to passed + tmf_pass("failed consolidation removes new lesson" and (map_contains(lessons and "consolidated") == 0))
    set total to total + 1
    set passed to passed + tmf_pass("failed consolidation restores GC list length" and (length_list(values_list) == old_values_len))
    set ok to sql_execute(db and "DROP TABLE consolidations;")
    set ok to kg_ensure_schema(db)
    set commit_error to tools_commit_consolidation(memory_mgr and db and "durable lesson" and 4)
    set consolidation_rows to sql_query(db and "SELECT summary FROM consolidations WHERE summary='durable lesson';")
    set total to total + 1
    set passed to passed + tmf_pass("successful consolidation reaches memory and SQLite" and (string_length(commit_error) == 0 and also map_contains(lessons and "consolidated") == 1 and also length_list(consolidation_rows) == 1))

    # Reading progress never claims a bookmark/note was saved after SQL failure.
    set ok to sql_execute(db and "DROP TABLE reading_progress;")
    set ok to sql_execute(db and "CREATE TABLE reading_progress (document_name TEXT PRIMARY KEY);")
    set result to tools_execute(tools_mgr and ctx and "manage_reading_progress" and tmf_args3("bookmark" and "book.md" and 7))
    set total to total + 1
    set passed to passed + tmf_pass("bookmark surfaces SQL failure" and (string_index_of(result and "Error:") == 0))
    set ok to sql_execute(db and "DROP TABLE reading_progress;")
    set ok to sql_execute(db and "CREATE TABLE reading_progress (document_name TEXT PRIMARY KEY, current_chunk INTEGER NOT NULL, notes TEXT NOT NULL, updated_at INTEGER NOT NULL);")
    set result to tools_execute(tools_mgr and ctx and "manage_reading_progress" and tmf_args3("bookmark" and "book.md" and 7))
    set bookmark_rows to sql_query(db and "SELECT current_chunk, updated_at FROM reading_progress WHERE document_name='book.md';")
    set bookmark_row to get_list(bookmark_rows and 0)
    set total to total + 1
    set passed to passed + tmf_pass("bookmark success has persisted value and timestamp" and (string_contains(result and "Bookmark set") == 1 and also get_list(bookmark_row and 0) equals "7" and also string_to_int(get_list(bookmark_row and 1)) > 0))
    set result to tools_execute(tools_mgr and ctx and "manage_reading_progress" and tmf_args3("take_note" and "book.md" and "checked"))
    set note_rows to sql_query(db and "SELECT notes FROM reading_progress WHERE document_name='book.md';")
    set total to total + 1
    set passed to passed + tmf_pass("note success has persisted text" and (string_contains(result and "Note appended") == 1 and also get_list(get_list(note_rows and 0) and 0) equals "checked"))
    set result to tools_execute(tools_mgr and ctx and "manage_reading_progress" and tmf_args3("bookmark" and "book.md" and -1))
    set total to total + 1
    set passed to passed + tmf_pass("negative bookmark rejected" and (string_index_of(result and "Error:") == 0))
    set result to tools_execute(tools_mgr and ctx and "manage_reading_progress" and tmf_args3("auto_read" and "book.md" and 0))
    set total to total + 1
    set passed to passed + tmf_pass("unbounded auto-read count rejected" and (string_index_of(result and "Error:") == 0))

    # Direct surface cancellation rows are consumed by one atomic DELETE RETURNING;
    # a second run with the same key cannot inherit a stale duplicate signal.
    set cancel_epoch to ep_cancel_epoch_get(0)
    set ok to sql_execute(db and "INSERT OR REPLACE INTO trace_cancellations(session_id) VALUES ('external_cancel_contract');")
    set first_cancel to react_check_cancel("external_cancel_contract" and cancel_epoch)
    set second_cancel to react_check_cancel("external_cancel_contract" and cancel_epoch)
    set total to total + 1
    set passed to passed + tmf_pass("durable targeted cancel is consumed exactly once" and (first_cancel == 1 and also second_cancel == 0))

    # Grid mutation must reject unknown movement rather than saying "moved".
    set grid to grid_create()
    set ok to map_insert(ctx and "turing_grid" and grid)
    set result to tools_execute(tools_mgr and ctx and "turing_grid_op" and tmf_args2("move" and "sideways"))
    set total to total + 1
    set passed to passed + tmf_pass("invalid grid direction is visible" and (string_index_of(result and "Error:") == 0 and also map_get_val(grid and "x") == 0 and also map_get_val(grid and "y") == 0 and also map_get_val(grid and "z") == 0))

    # DHT ownership rejection happens before SQLite, so a rejected overwrite cannot
    # poison the durable value while the in-memory store keeps the original.
    set dht_key to "repo:mutation_contract"
    set ok to sql_execute(db and "DELETE FROM dht_values WHERE key='repo:mutation_contract';")
    set dht to create_dht_node("1111111111111111111111111111111111111111111111111111111111111111" and "127.0.0.1" and 19001)
    set ok to map_insert(ctx and "dht_node" and dht)
    set result to tools_execute(tools_mgr and ctx and "dht_store" and tmf_args2(dht_key and "did:key:first"))
    set total to total + 1
    set passed to passed + tmf_pass("DHT first ownership value persists" and (string_index_of(result and "dht:stored") == 0))
    set result to tools_execute(tools_mgr and ctx and "dht_store" and tmf_args2(dht_key and "did:key:attacker"))
    set durable_owner to storage_dht_get(dht_key)
    set total to total + 1
    set passed to passed + tmf_pass("DHT rejected overwrite is reported" and (string_index_of(result and "dht:error") == 0 and also string_contains(result and "507") == 1))
    set total to total + 1
    set passed to passed + tmf_pass("DHT rejected overwrite leaves SQLite original intact" and (durable_owner equals "did:key:first"))
    # A freshly-created node has an empty in-memory store. Durable ownership must
    # still remain first-writer-wins across that restart boundary.
    set restarted_dht to create_dht_node("2222222222222222222222222222222222222222222222222222222222222222" and "127.0.0.1" and 19002)
    set restart_overwrite to dht_node_store_value(restarted_dht and dht_key and "did:key:restart-attacker")
    set total to total + 1
    set passed to passed + tmf_pass("DHT durable ownership survives an in-memory restart" and (restart_overwrite == DHT_ERR_STORE_REJECTED and also storage_dht_get(dht_key) equals "did:key:first"))

    # Bridge callers reject enqueue failures and invalid waits; done-with-empty is
    # also an explicit protocol failure rather than an empty apparent success.
    set total to total + 1
    set passed to passed + tmf_pass("bridge wait rejects invalid command id" and (bridge_wait_result(db and 0 and 1) equals "error:invalid_command_id"))
    set total to total + 1
    set passed to passed + tmf_pass("bridge wait rejects invalid limit" and (bridge_wait_result(db and 1 and 0) equals "error:invalid_wait_limit"))
    set ok to sql_execute(db and "DROP TABLE bridge_commands;")
    set ok to sql_execute(db and "CREATE TABLE bridge_commands (bad TEXT);")
    set result to tools_execute(tools_mgr and ctx and "discord_list_channels" and tmf_args0())
    set total to total + 1
    set passed to passed + tmf_pass("Discord tool surfaces bridge enqueue failure" and (string_contains(result and "bridge_enqueue_failed") == 1))
    set ok to sql_execute(db and "DROP TABLE bridge_commands;")
    set ok to bridge_ensure_schema(db)
    set command_id to bridge_enqueue(db and "discord" and "list_channels" and "")
    set claim to bridge_claim_one(db and "discord" and "test-owner" and "1234567890abcdef" and 30)
    set ok to bridge_submit_result(db and command_id and "1234567890abcdef" and "")
    set total to total + 1
    set passed to passed + tmf_pass("empty completed bridge result is explicit error" and (bridge_get_result(db and command_id) equals "error:empty_result"))

    # Whisper persistence failure is reported, and successful enqueue is called
    # queued—not sent or received—until the running task consumes it.
    set orch to orchestrator_create()
    set fake_task to create_map()
    set ok to map_insert(fake_task and "status" and "running")
    set ok to map_insert(fake_task and "result" and "")
    set orch_tasks to map_get_val(orch and "tasks")
    set ok to map_insert(orch_tasks and "agent_contract" and fake_task)
    set ok to map_insert(ctx and "orchestrator" and orch)
    set ok to sql_execute(db and "DROP TABLE trace_whispers;")
    set ok to sql_execute(db and "CREATE TABLE trace_whispers (bad TEXT);")
    set result to tools_execute(tools_mgr and ctx and "delegate_whisper" and tmf_args2("agent_contract" and "check errors"))
    set total to total + 1
    set passed to passed + tmf_pass("whisper surfaces persistence failure" and (string_index_of(result and "Error:") == 0))
    set ok to sql_execute(db and "DROP TABLE trace_whispers;")
    set ok to trace_init(db)
    set result to tools_execute(tools_mgr and ctx and "delegate_whisper" and tmf_args2("agent_contract" and "check errors"))
    set whisper_rows to sql_query(db and "SELECT content FROM trace_whispers WHERE session_id='agent_contract';")
    set total to total + 1
    set passed to passed + tmf_pass("whisper is truthfully queued for running task" and (string_index_of(result and "Whisper queued") == 0 and also string_contains(result and "sent") == 0 and also length_list(whisper_rows) == 1))
    set ok to map_insert(fake_task and "status" and "completed")
    set ok to map_insert(fake_task and "result" and "done")
    set result to tools_execute(tools_mgr and ctx and "delegate_whisper" and tmf_args2("agent_contract" and "too late"))
    set whisper_rows_after to sql_query(db and "SELECT content FROM trace_whispers WHERE session_id='agent_contract';")
    set total to total + 1
    set passed to passed + tmf_pass("completed task rejects whisper without another row" and (string_index_of(result and "Error:") == 0 and also length_list(whisper_rows_after) == 1))

    # A completed sub-agent report is only marked consumed after its trace event is
    # durably queued. Reserving it uses the intermediate state 2; a failed INSERT
    # must release it to state 0 so the active loop or a later worker can retry.
    set report_task to create_map()
    set ok to map_insert(report_task and "status" and "completed")
    set ok to map_insert(report_task and "result" and "contract result")
    set ok to map_insert(report_task and "role" and "contract")
    set ok to map_insert(report_task and "parent_sid" and "report_contract")
    set ok to map_insert(report_task and "reported" and 0)
    set ok to map_insert(orch_tasks and "agent_report_contract" and report_task)
    set report_claim to orchestrator_claim_report(orch and "agent_report_contract")
    set total to total + 1
    set passed to passed + tmf_pass("report claim reserves without marking consumed" and (report_claim == 1 and also map_get_val(report_task and "reported") == 2 and also orchestrator_claim_report(orch and "agent_report_contract") == 0))

    set ok to sql_execute(db and "DROP TABLE trace_events;")
    set ok to sql_execute(db and "CREATE TABLE trace_events (bad TEXT);")
    set failed_queue to react_write_mid_message("report_contract" and "must remain retryable")
    set failed_release to orchestrator_release_report(orch and "agent_report_contract")
    set total to total + 1
    set passed to passed + tmf_pass("failed durable report queue releases reservation" and (failed_queue != 0 and also failed_release == 1 and also map_get_val(report_task and "reported") == 0))

    set ok to sql_execute(db and "DROP TABLE trace_events;")
    set ok to trace_init(db)
    set report_claim to orchestrator_claim_report(orch and "agent_report_contract")
    set successful_queue to react_write_mid_message("report_contract" and "durably queued result")
    set successful_commit to 0
    if successful_queue == 0:
        set successful_commit to orchestrator_commit_report(orch and "agent_report_contract")
    set report_rows to sql_query(db and "SELECT content, sent FROM trace_events WHERE session_id='report_contract' AND event_type='mid_message';")
    set total to total + 1
    set passed to passed + tmf_pass("durable report queue commits internal state without claiming receipt" and (report_claim == 1 and also successful_queue == 0 and also successful_commit == 1 and also map_get_val(report_task and "reported") == 1 and also length_list(report_rows) == 1 and also get_list(get_list(report_rows and 0) and 1) equals "0"))
    set total to total + 1
    set passed to passed + tmf_pass("committed report cannot be claimed or released twice" and (orchestrator_claim_report(orch and "agent_report_contract") == 0 and also orchestrator_release_report(orch and "agent_report_contract") == 0))

    # Changelog persistence itself fails closed and preserves verified writes.
    set changelog_test_path to "/tmp/ernos_changelog_atomic_contract.json"
    if file_exists(changelog_test_path) == 1:
        set removed to remove_file(changelog_test_path)
    set total to total + 1
    set passed to passed + tmf_pass("atomic changelog write succeeds with exact read-back" and (changelog_atomic_write(changelog_test_path and "[]") == 0 and also read_file(changelog_test_path) equals "[]"))
    set total to total + 1
    set passed to passed + tmf_pass("atomic changelog write reports invalid destination" and (changelog_atomic_write("/dev/null/blocked.json" and "[]") != 0))
    if file_exists(changelog_test_path) == 1:
        set removed to remove_file(changelog_test_path)

    # These maps were transferred into longer-lived containers above. Clear the
    # creating locals before main cleanup so the container-held values stay valid.
    set report_task to 0
    set fake_task to 0
    set orch to 0
    set dht to 0
    set grid to 0
    set memory_mgr to 0

    set close_rc to storage_close()
    set total to total + 1
    set passed to passed + tmf_pass("storage closed cleanly" and (close_rc == 0))
    display concat("tools-mutation-failures: " and concat(int_to_string(passed) and concat("/" and int_to_string(total))))
    if passed != total:
        return 1
    return 0
