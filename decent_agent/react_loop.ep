# ErnosPlain Rebuild of ErnOS Agent ReAct Loop Coordinator
# Component: decent_agent/react_loop.ep

import "collections"
import "string"
import "json"
import "llm"
import "fs"

import "prompt"
import "tools"
import "./access"
import "./orchestrator"
import "./workspace_links"
import "memory"
import "observer"
import "reply_format"
import "session"
import "sync"
import "trace"
import "../storage"
import "sql"

# Global cancel-all flag (C-level; injected by build.sh). A plain process word set by the
# web thread's /api/cancel and read here at each turn boundary. Used instead of a SQLite
# row (which contends on the global SQLite mutex and, under DB-heavy turns, delayed the
# cancel by seconds) and instead of a cross-thread ErnosPlain map (which would mutate a
# GC-managed object from another thread). ep_cancel_get takes a dummy arg for ABI parity.
external define ep_cancel_set with v returning Int
external define ep_cancel_get with dummy returning Int
# SAFETY: cancel EPOCH (monotonic latch) — the consume-once flag above could only halt
# ONE of N concurrent runs (main agent + sub-agents + background coordinators): whoever
# read it first cleared it. Every run now captures the epoch at its start and halts when
# the current value is GREATER; nothing consumes, so a single Stop halts EVERYTHING at
# once, and runs started after the Stop are unaffected. Any targeted cancel (per-session
# map/row) also BUMPS the epoch so a Stop from any surface is a global stop.
external define ep_cancel_epoch_get with dummy returning Int
external define ep_cancel_epoch_bump with dummy returning Int

# F4: cooperative cancellation registry. A Stop button / `AI CANCEL` IPC sets a
# per-session flag on a SEPARATE connection while react_run_loop is blocked on the
# first; the loop checks (and consumes) it at each turn boundary and halts cleanly.
# Mutex-guarded because requester and runner are different threads. An empty
# session id normalises to "default" so both sides agree on a key.
set RUN_CANCEL_MAP to create_map()
set RUN_CANCEL_LOCK to create_mutex()

# Concurrency model: agents run as cooperative ASYNC TASKS on a single thread (the
# LLM call yields at `await http_post_async`). The main user turn and every background
# sub-agent interleave at those await points on ONE thread, so there is no concurrent
# heap access and no GC race — and therefore no global run lock is needed. (An earlier
# thread-based design used a process-wide lock here; it's gone with the move to async.)

define react_cancel_key with session_id as Str returning Str:
    if string_length(session_id) == 0:
        return "default"
    return session_id

# Request cancellation of the active run for a session (called from the IPC handler).
define react_request_cancel with session_id as Str returning Int:
    set key to react_cancel_key(session_id)
    set ok to lock_mutex(RUN_CANCEL_LOCK)
    set ok to map_insert(RUN_CANCEL_MAP and key and 1)
    set ok to unlock_mutex(RUN_CANCEL_LOCK)
    
    # Also write to SQLite DB
    set db to storage_get_db()
    if db != 0:
        set es to string_replace(key and "'" and "''")
        set ok to sql_execute(db and f"INSERT OR REPLACE INTO trace_cancellations (session_id) VALUES ('{es}');")
    return 0

# Check a pending cancellation (called by every run at its turn boundaries).
# run_epoch is the cancel epoch the RUN captured at its start: any bump since then
# halts this run — compared, never consumed, so all concurrent runs see one Stop.
# Targeted cancels (per-session map/SQLite rows) are consumed as before, but ALSO bump
# the epoch: a Stop from any surface halts the whole system and every sub-agent.
define react_check_cancel with session_id as Str and run_epoch as Int returning Int:
    # 1. Epoch latch — cheapest check first; catches a Stop from ANY surface.
    if ep_cancel_epoch_get(0) > run_epoch:
        return 1

    set key to react_cancel_key(session_id)
    set ok to lock_mutex(RUN_CANCEL_LOCK)
    set hit to map_contains(RUN_CANCEL_MAP and key)
    if hit == 1:
        set ok to map_delete(RUN_CANCEL_MAP and key)
    set ok to unlock_mutex(RUN_CANCEL_LOCK)
    if hit == 1:
        set ok to ep_cancel_epoch_bump(0)
        return 1

    # Legacy consume-once flag (older callers of ep_cancel_set) — translate to a bump.
    if ep_cancel_get(0) == 1:
        set ok to ep_cancel_set(0)
        set ok to ep_cancel_epoch_bump(0)
        return 1

    # SQLite rows: the per-session 'AI CANCEL' path and the '__CANCEL_ALL__' sentinel
    # the bridge writes directly when the (single-threaded, busy) IPC daemon cannot be
    # reached mid-run. Consumed here, then broadcast via the epoch.
    set db to storage_get_db()
    if db != 0:
        set es to string_replace(key and "'" and "''")
        set rows to sql_query(db and f"SELECT COUNT(*) FROM trace_cancellations WHERE session_id='{es}' OR session_id='__CANCEL_ALL__';")
        if length_list(rows) > 0:
            set first_row to get_list(rows and 0)
            set count_str to get_list(first_row and 0)
            if string_to_int(count_str) > 0:
                set ok to sql_execute(db and f"DELETE FROM trace_cancellations WHERE session_id='{es}' OR session_id='__CANCEL_ALL__';")
                set ok to ep_cancel_epoch_bump(0)
                return 1
    return 0

# Drain guidance addressed to this exact active turn. Empty target ids remain valid for
# sub-agent steering, whose task id already uniquely identifies its running turn.
define react_drain_whispers with session_id as Str and turn_id as Str returning Str:
    set db to storage_get_db()
    if db == 0:
        return ""
    set key to session_id
    if string_length(key) == 0:
        set key to "default"
    set es to string_replace(key and "'" and "''")
    set et to string_replace(turn_id and "'" and "''")
    set rows to sql_query(db and f"SELECT id, content FROM trace_whispers WHERE session_id='{es}' AND (target_turn_id='' OR target_turn_id='{et}') ORDER BY id;")
    set count to length_list(rows)
    if count == 0:
        return ""
    set out to ""
    set idx to 0
    repeat while idx < count:
        set row to get_list(rows and idx)
        set w_id to get_list(row and 0)
        set w_content to get_list(row and 1)
        set out to concat(out and f"- {w_content}\n")
        set ok to sql_execute(db and f"DELETE FROM trace_whispers WHERE id={w_id};")
        set idx to idx + 1
    return out

# Remove only guidance explicitly bound to a different, already-ended turn. This
# prevents bleed-through without discarding guidance that arrived in the accept/start
# race for the current turn.
define react_discard_stale_whispers with session_id as Str and turn_id as Str returning Int:
    set db to storage_get_db()
    if db == 0:
        return 1
    set key to session_id
    if string_length(key) == 0:
        set key to "default"
    set es to string_replace(key and "'" and "''")
    set et to string_replace(turn_id and "'" and "''")
    return sql_execute(db and f"DELETE FROM trace_whispers WHERE session_id='{es}' AND target_turn_id != '' AND target_turn_id != '{et}';")

# Write a mid-turn message from the agent to the user via trace_events.
# The Discord bridge picks up events with type 'mid_message' and posts them
# in the main channel, NOT in the trace thread. Does NOT end the react loop.
define react_write_mid_message with session_id as Str and content as Str returning Int:
    set db to storage_get_db()
    if db == 0:
        return 1
    set key to session_id
    if string_length(key) == 0:
        set key to "default"
    set es to string_replace(key and "'" and "''")
    set ec to string_replace(content and "'" and "''")
    set ok to sql_execute(db and f"INSERT INTO trace_events (session_id, event_type, content, created_at, sent) VALUES ('{es}', 'mid_message', '{ec}', strftime('%s','now'), 0);")
    return ok

# Remove stray harmony/gemma channel-marker tokens from a string. Longer variants
# are stripped before their unterminated forms so nothing is left behind.
define react_strip_markers with s as Str returning Str:
    set out to s
    set out to string_replace(out and "<|thought|>" and "")
    set out to string_replace(out and "<|thought|" and "")
    set out to string_replace(out and "<|channel|>" and "")
    set out to string_replace(out and "<channel|>" and "")
    set out to string_replace(out and "<channel|" and "")
    set out to string_replace(out and "<|message|>" and "")
    set out to string_replace(out and "<|message|" and "")
    set out to string_replace(out and "<|start|>" and "")
    set out to string_replace(out and "<|end|>" and "")
    set out to string_replace(out and "<|assistant|>" and "")
    return out

# F1 (generalized): separate a turn's native reasoning from its ReAct content.
# Different local models emit reasoning differently: <think>...</think> (deepseek/
# qwen), or harmony/gemma channel markers like <|thought|> ... <channel|>Action:...
# (gemma4:26b). We capture the reasoning as its own channel and strip ALL of these
# markers so they never confuse action parsing or leak to the user. Returns
# {reasoning, clean}.
define react_extract_reasoning with text as Str returning Map:
    set result to create_map()
    set reasoning to ""
    set work to text

    # 1. <think>...</think>
    set open_pos to string_index_of(work and "<think>")
    if open_pos >= 0:
        set close_pos to string_index_of(work and "</think>")
        if close_pos < 0:
            set reasoning to concat(reasoning and substring(work and open_pos + 7 and string_length(work) - open_pos - 7))
            set work to substring(work and 0 and open_pos)
        else:
            set reasoning to concat(reasoning and substring(work and open_pos + 7 and close_pos - open_pos - 7))
            set before to substring(work and 0 and open_pos)
            set after_start to close_pos + 8
            set work to concat(before and substring(work and after_start and string_length(work) - after_start))

    # 2. Harmony/gemma: the final channel output follows the LAST <channel|> marker;
    #    everything before it is reasoning.
    set ch_pos to string_last_index_of(work and "<channel|>")
    if ch_pos >= 0:
        set reasoning to concat(reasoning and concat("\n" and substring(work and 0 and ch_pos)))
        set after_ch to ch_pos + 10
        set work to substring(work and after_ch and string_length(work) - after_ch)

    # 3. Strip any remaining stray marker tokens from both channels.
    set work to react_strip_markers(work)
    set reasoning to react_strip_markers(reasoning)

    set ok to map_insert(result and "reasoning" and string_trim(reasoning))
    set ok to map_insert(result and "clean" and string_trim(work))
    return result

# Characters of tool output we can fold into the prompt this turn, derived from
# the model's OWN context window (get_model_context_limit, which already scales by
# model + system RAM) minus what the prompt already holds. This is NOT a fixed
# cap: a 200k-token model (gemma4) gets ~hundreds of KB of headroom, an 8k model
# proportionally less. We convert tokens→chars at ~3.5 chars/token (BPE average
# for mixed prose + paths/code; deliberately low so we under-estimate the window
# and never overflow it) and reserve 25% of the window for the model's reply and
# the loop's remaining turns. Returns the remaining char budget (can be negative
# when the prompt has already filled the window).
define react_observation_budget with model_name as Str and prompt_len as Int returning Int:
    set ctx_tokens to get_model_context_limit(model_name)
    set window_chars to (ctx_tokens * 7) / 2
    set usable to (window_chars * 3) / 4
    return usable - prompt_len

# Fit a tool result into the per-turn budget. If it fits, it passes through whole.
# If not, keep the head that fits and tell the model it was clipped (with the real
# total) so it narrows its next query instead of silently losing the tail or
# blowing up the inference call. A small floor guarantees the model always sees
# some of the output even when the window is nearly full.
define react_fit_observation with text as Str and budget as Int returning Str:
    set room to budget
    set min_room to 2048
    if room < min_room:
        set room to min_room
    set n to string_length(text)
    if n <= room:
        return text
    set notice to f"\n\n[OUTPUT TRUNCATED to fit the model context window: {n} chars total, {room} kept. Narrow your request — target a specific directory, add a depth/count limit, or filter — and do not recurse into build/cache dirs (target/, node_modules/, .git/, deps/).]"
    set keep to room - string_length(notice)
    if keep < 0:
        set keep to 0
    set head to substring(text and 0 and keep)
    return concat(head and notice)

# Extract the raw string content from a JSON-like args_str (e.g. '["some text"]')
# by stripping the outer [" and "] wrappers. Used as a fallback when json_parse
# is confused by unescaped inner quotes from the LLM.
define react_extract_raw_arg with args_str as Str returning Str:
    set slen to string_length(args_str)
    if slen < 4:
        return args_str
    # Find the opening quote after '[' (skip whitespace)
    set start to 0
    set found_start to 0
    repeat while start < slen and found_start == 0:
        set ch to get_character(args_str and start)
        if ch == 34: # '"'
            set found_start to 1
        else:
            set start to start + 1
    if found_start == 0:
        return args_str
    # Find the closing quote before ']' (scan from end)
    set end_pos to slen - 1
    set found_end to 0
    repeat while end_pos > start and found_end == 0:
        set ch to get_character(args_str and end_pos)
        if ch == 34: # '"'
            set found_end to 1
        else:
            set end_pos to end_pos - 1
    if found_end == 0:
        return args_str
    # Extract content between the outermost quotes
    set content_start to start + 1
    set content_len to end_pos - content_start
    if content_len <= 0:
        return args_str
    return substring(args_str and content_start and content_len)

# Local models sometimes express a registered call as Python-style positional
# parameters after putting only the first parameter inside the required JSON list:
#
#   codebase_search(["literal"], "decent_agent", 25)
#
# Every Ernos tool contract instead uses one JSON array containing every argument.
# The runtime must tolerate that stable model dialect until training converges, but
# it must not let json_parse accept only the first array and silently ignore the
# trailing expressions. Detect that exact shape here and fold the trailing values
# into the one canonical array before JSON decoding and schema validation.
define react_split_default_expression_close with args_str as Str returning Int:
    set clean to string_trim(args_str)
    set n to string_length(clean)
    if n < 4 or else get_character(clean and 0) != 91: # '['
        return -1
    set depth to 0
    set in_string to 0
    set escaped to 0
    set i to 0
    repeat while i < n:
        set ch to get_character(clean and i)
        if escaped == 1:
            set escaped to 0
        else if ch == 92: # '\\'
            set escaped to 1
        else if ch == 34: # '"'
            if in_string == 0:
                set in_string to 1
            else:
                set in_string to 0
        else if in_string == 0:
            if ch == 91:
                set depth to depth + 1
            else if ch == 93:
                set depth to depth - 1
                if depth == 0:
                    set next_pos to i + 1
                    repeat while next_pos < n and also (get_character(clean and next_pos) == 9 or else get_character(clean and next_pos) == 10 or else get_character(clean and next_pos) == 13 or else get_character(clean and next_pos) == 32):
                        set next_pos to next_pos + 1
                    if next_pos < n and also get_character(clean and next_pos) == 44: # ','
                        return i
                    return -1
        set i to i + 1
    return -1

define react_normalize_split_default_expression with args_str as Str returning Str:
    set clean to string_trim(args_str)
    set close_pos to react_split_default_expression_close(clean)
    if close_pos < 0:
        return clean
    # Remove the first array's closing bracket, retain the model's comma-separated
    # trailing expressions, and close the resulting canonical argument array once.
    set prefix to substring(clean and 0 and close_pos)
    set suffix_start to close_pos + 1
    set suffix to substring(clean and suffix_start and string_length(clean) - suffix_start)
    set candidate to concat(prefix and concat(suffix and "]"))
    set candidate_node to json_parse(candidate)
    if candidate_node == 0 or else get_json_type(candidate_node) != 3:
        return ""
    return candidate

# Recover the second argument when a model emits Python-style triple quotes around
# a multiline payload, for example ["regression", """...source..."""]. That is
# not valid JSON, but it is an unambiguous and common serialization of source code.
# The JSON parser can otherwise return a two-item list whose second value is NULL;
# downstream tools then see an empty payload and misleadingly report an encoding
# failure. Use the first and last triple-quote delimiters so Python docstrings inside
# the payload remain intact. Valid JSON strings are unaffected because their quotes
# are backslash-separated rather than three adjacent quote bytes.
define react_unescape_triple_payload with payload as Str returning Str:
    set n to string_length(payload)
    set escaped_quotes to 0
    set probe to 0
    repeat while probe + 1 < n:
        if get_character(payload and probe) == 92 and also get_character(payload and probe + 1) == 34:
            set escaped_quotes to escaped_quotes + 1
            set probe to probe + 2
        else:
            set probe to probe + 1
    # Only remove one JSON-escape layer when the payload itself clearly has
    # escaped source quotes. Plain triple-quoted Python remains byte-exact.
    if escaped_quotes < 2:
        return payload
    set out to ""
    set i to 0
    repeat while i < n:
        set c to get_character(payload and i)
        if c == 92 and also i + 1 < n:
            set next_c to get_character(payload and i + 1)
            if next_c == 34 or else next_c == 92:
                set out to concat(out and substring(payload and i + 1 and 1))
                set i to i + 2
            else:
                set out to concat(out and substring(payload and i and 1))
                set i to i + 1
        else:
            set out to concat(out and substring(payload and i and 1))
            set i to i + 1
    return out

define react_extract_triple_quoted_second_arg with args_str as Str returning Str:
    set n to string_length(args_str)
    if n < 9:
        return ""
    set first_end to -1
    set last_start to -1
    set i to 0
    repeat while i + 2 < n:
        set c0 to get_character(args_str and i)
        set c1 to get_character(args_str and i + 1)
        set c2 to get_character(args_str and i + 2)
        if c0 == 34 and also c1 == 34 and also c2 == 34:
            if first_end < 0:
                set first_end to i + 3
            else:
                set last_start to i
            set i to i + 3
        else:
            set i to i + 1
    if first_end < 0 or else last_start < first_end:
        return ""
    set payload to substring(args_str and first_end and last_start - first_end)
    return react_unescape_triple_payload(payload)

# Tool-call shape validation happens before approval, Observer audit, execution,
# persistence, or platform delivery. In particular, run_command's optional working
# directory and timeout are NOT an argv array: all executable arguments belong in the
# first command string. Rejecting malformed calls here prevents a bad call from asking
# the user for approval and then failing only after they approve it.
define react_is_decimal_integer with text as Str returning Int:
    set clean to string_trim(text)
    set n to string_length(clean)
    if n == 0:
        return 0
    set i to 0
    repeat while i < n:
        set ch to get_character(clean and i)
        if ch < 48 or else ch > 57:
            return 0
        set i to i + 1
    return 1

define react_validate_tool_args with tool_name as Str and args_list as List and raw_args as Str returning Str:
    if tool_name equals "codebase_search":
        set search_argc to length_list(args_list)
        if search_argc < 1 or else search_argc > 3:
            return concat("Invalid codebase_search call rejected before execution: expected one query string plus optional root and max_results, received " and concat(int_to_string(search_argc) and ". Canonical form: Action: codebase_search([\"one literal\", \"source-root\", 25]). For multiple literals emit separate batched Action: codebase_search(...) lines; do not put multiple queries in the first argument list."))
        set search_query to string_trim(ptr_to_str(get_list(args_list and 0)))
        if string_length(search_query) == 0:
            return "Invalid codebase_search call rejected before execution: the query is empty. Canonical form: Action: codebase_search([\"one literal\", \"source-root\", 25])."
        return ""

    if tool_name equals "codebase_replace":
        set replace_argc to length_list(args_list)
        if replace_argc == 2:
            set whole_candidate to ptr_to_str(get_list(args_list and 1))
            if string_length(whole_candidate) >= 200 and also string_contains(whole_candidate and "define ") == 1:
                return ""
        if replace_argc < 3 or else replace_argc > 4:
            return concat("IMPROVEMENT_GATE_FAILED code=TOOL_ARGUMENTS_INVALID message=codebase_replace requires either path plus a complete retained-candidate body, or path, exact_old, exact_new, and optional expected_count; received " and concat(int_to_string(replace_argc) and ". Canonical envelopes: {\"tool_name\":\"codebase_replace\",\"arguments\":[\"decent_agent/file.ep\",\"complete candidate source\"]} or {\"tool_name\":\"codebase_replace\",\"arguments\":[\"decent_agent/file.ep\",\"exact defective fragment\",\"exact corrected fragment\",1]}."))
        if string_length(string_trim(ptr_to_str(get_list(args_list and 0)))) == 0 or else string_length(ptr_to_str(get_list(args_list and 1))) == 0:
            return "IMPROVEMENT_GATE_FAILED code=TOOL_ARGUMENTS_INVALID message=codebase_replace path and replacement body must be non-empty. Use the original production path with either the complete corrected retained candidate or the smallest exact defective/corrected fragments."
        if ptr_to_str(get_list(args_list and 1)) equals ptr_to_str(get_list(args_list and 2)):
            return "IMPROVEMENT_GATE_FAILED code=NO_CHANGE message=codebase_replace exact_old and exact_new are byte-identical. Nothing would change. Use the compiler diagnostic and retained candidate bytes to provide a causal replacement."
        if replace_argc == 4:
            set replace_count_text to string_trim(ptr_to_str(get_list(args_list and 3)))
            if react_is_decimal_integer(replace_count_text) == 0 or else string_to_int(replace_count_text) < 1:
                return "IMPROVEMENT_GATE_FAILED code=TOOL_ARGUMENTS_INVALID message=codebase_replace expected_count must be a positive integer. Canonical envelope: {\"tool_name\":\"codebase_replace\",\"arguments\":[\"production/path\",\"exact_old\",\"exact_new\",1]}."
        return ""

    if tool_name equals "improvement_plan_scaffold":
        set scaffold_argc to length_list(args_list)
        if scaffold_argc < 2:
            return "IMPROVEMENT_GATE_FAILED code=TOOL_ARGUMENTS_INVALID message=improvement_plan_scaffold requires the exact public snake_case surface first and one or more exact discovered production paths after it. Canonical envelope: {\"tool_name\":\"improvement_plan_scaffold\",\"arguments\":[\"surface_name\",\"decent_agent/production_file.ep\"]}."
        set scaffold_surface to string_trim(ptr_to_str(get_list(args_list and 0)))
        set scaffold_len to string_length(scaffold_surface)
        if scaffold_len < 3 or else scaffold_len > 64 or else string_contains(scaffold_surface and "/") == 1 or else string_contains(scaffold_surface and ".") == 1 or else string_contains(scaffold_surface and " ") == 1 or else string_contains(scaffold_surface and "\n") == 1:
            return "IMPROVEMENT_GATE_FAILED code=TOOL_ARGUMENTS_INVALID message=improvement_plan_scaffold arguments are ordered incorrectly. Argument 1 must be the exact public snake_case identifier from required_surface, never a file path or objective sentence. Arguments 2+ must be exact paths already returned by source discovery. Canonical envelope: {\"tool_name\":\"improvement_plan_scaffold\",\"arguments\":[\"surface_name\",\"decent_agent/production_file.ep\"]}."
        return ""

    if tool_name equals "run_command" == 0:
        return ""

    set argc to length_list(args_list)
    if argc < 1 or else argc > 3:
        return concat("Invalid run_command call: expected 1-3 elements, received " and concat(int_to_string(argc) and ". The first element must contain the ENTIRE shell command and all of its command-line arguments. Canonical form: Action: run_command([\"bash path/to/script argument\", \"optional-working-directory\", 600]). Do not repeat the rejected call unchanged."))

    set command_text to string_trim(ptr_to_str(get_list(args_list and 0)))
    if string_length(command_text) == 0:
        return "Invalid run_command call: the first element is empty. Put the ENTIRE shell command and all command-line arguments in that first string. Example: Action: run_command([\"bash build.sh test\"])."

    if argc >= 2:
        set dir_arg to string_trim(ptr_to_str(get_list(args_list and 1)))
        set resolved_dir to links_path_for(dir_arg)
        if string_length(resolved_dir) == 0:
            if file_exists(dir_arg) == 1 and also is_directory(dir_arg) == 1:
                set resolved_dir to dir_arg
        if string_length(resolved_dir) == 0:
            return concat("Invalid run_command call rejected before approval: argument 2 is a working-directory path or linked-project id, not a command argument, and it did not resolve to a directory. Your rejected arguments were " and concat(raw_args and ". Put the executable and every command-line argument together in element 1. Example: Action: run_command([\"bash decent_agent/run_test.sh decent_agent/test_e2e_quick.ep\"]). Do not repeat the rejected call unchanged."))

    if argc >= 3:
        set timeout_text to string_trim(ptr_to_str(get_list(args_list and 2)))
        if react_is_decimal_integer(timeout_text) == 0:
            return concat("Invalid run_command call rejected before approval: argument 3 must be an integer timeout from 1 to 1800 seconds, not another command argument. Your rejected arguments were " and concat(raw_args and ". Put the executable and every command-line argument together in element 1. Example: Action: run_command([\"bash decent_agent/run_test.sh decent_agent/test_e2e_quick.ep\", \".\", 600]). Do not repeat the rejected call unchanged."))
        set timeout_value to string_to_int(timeout_text)
        if timeout_value < 1 or else timeout_value > 1800:
            return concat("Invalid run_command call rejected before approval: timeout_seconds must be between 1 and 1800, received " and concat(timeout_text and ". Use a bounded value and do not repeat the rejected call unchanged."))

    return ""

# Find a protocol marker only when it begins a real line (allowing indentation) and is
# outside a fenced code/example block. Inline/backticked/quoted examples cannot execute.
define react_find_line_marker_from with raw as Str and marker as Str and from_pos as Int returning Int:
    set raw_len to string_length(raw)
    set marker_len to string_length(marker)
    set raw_lower to string_lower(raw)
    set marker_lower to string_lower(marker)
    set minimum_pos to from_pos
    if minimum_pos < 0:
        set minimum_pos to 0
    # Always scan from the beginning so fenced-block state is correct even when a
    # batched-action search begins in the middle of the response.
    set line_start to 0
    set in_fence to 0

    repeat while line_start < raw_len:
        set candidate to line_start
        set skipping_indent to 1
        repeat while candidate < raw_len and skipping_indent == 1:
            set indent_ch to get_character(raw and candidate)
            if indent_ch == 32 or else indent_ch == 9:
                set candidate to candidate + 1
            else:
                set skipping_indent to 0
        set fence_line to 0
        if candidate + 3 <= raw_len:
            if substring(raw and candidate and 3) equals "```":
                set fence_line to 1
                if in_fence == 0:
                    set in_fence to 1
                else:
                    set in_fence to 0
        if fence_line == 0 and also in_fence == 0 and also candidate >= minimum_pos:
            if candidate + marker_len <= raw_len:
                set marker_candidate to substring(raw_lower and candidate and marker_len)
                if marker_candidate equals marker_lower:
                    return candidate

        set finding_end to 1
        repeat while line_start < raw_len and finding_end == 1:
            set line_ch to get_character(raw and line_start)
            set line_start to line_start + 1
            if line_ch == 10 or else line_ch == 13:
                set finding_end to 0
    return -1

define react_find_protocol_marker_from with raw as Str and from_pos as Int returning Int:
    set action_pos to react_find_line_marker_from(raw and "action:" and from_pos)
    set call_pos to react_find_line_marker_from(raw and "call:" and from_pos)
    if action_pos < 0:
        return call_pos
    if call_pos >= 0 and also call_pos < action_pos:
        return call_pos
    return action_pos

# Plain final prose is already a valid user response even when a model omits the ReAct
# wrapper. Recover it deterministically instead of paying for another inference and
# feeding a format error back into the conversation. Thought/Observation continuations
# and attempted action lines still go through the explicit correction path. Markdown
# dividers left behind after private reasoning extraction are transport residue, not a
# user-facing answer; accepting them would terminate unfinished tool work.
define react_is_separator_residue with raw as Str returning Int:
    set clean to string_trim(raw)
    set n to string_length(clean)
    if n == 0:
        return 1
    set i to 0
    repeat while i < n:
        set ch to get_character(clean and i)
        if ch != 9 and also ch != 10 and also ch != 13 and also ch != 32 and also ch != 35 and also ch != 42 and also ch != 45 and also ch != 61 and also ch != 62 and also ch != 95 and also ch != 124:
            return 0
        set i to i + 1
    return 1

define react_is_implicit_reply with raw as Str returning Int:
    set clean to string_trim(raw)
    if string_length(clean) == 0:
        return 0
    if react_is_separator_residue(clean) == 1:
        return 0
    set clean_lower to string_lower(clean)
    if string_index_of(clean_lower and "thought:") == 0:
        return 0
    if string_index_of(clean_lower and "observation:") == 0:
        return 0
    if react_find_line_marker_from(clean and "action:" and 0) >= 0:
        return 0
    if react_find_line_marker_from(clean and "call:" and 0) >= 0:
        return 0
    return 1

# A model response is one protocol variant, never a mixture. Tool turns may have a
# single explicit Thought prefix followed by Action lines; final prose has no Action
# marker and is handled by react_is_implicit_reply. Any other prose before an action
# is an invalid mixed response and must be regenerated, not silently discarded.
define react_action_prefix_is_valid with raw as Str and action_start as Int returning Int:
    if action_start <= 0:
        return 1
    set prefix to string_trim(substring(raw and 0 and action_start))
    if string_length(prefix) == 0:
        return 1
    set lower to string_lower(prefix)
    if string_index_of(lower and "thought:") != 0:
        return 0
    # A tool turn permits exactly one Thought line before the first Action. This
    # prevents "Thought: ...\n<final prose>\nAction: ..." from executing the tool
    # while silently discarding the prose.
    set first_nl to string_index_of(prefix and "\n")
    if first_nl >= 0:
        set after_thought to string_trim(substring(prefix and first_nl + 1 and string_length(prefix) - first_nl - 1))
        if string_length(after_thought) > 0:
            return 0
    return 1

# Validate the WHOLE tool response before executing its first Action. The previous
# guard checked only the prefix, so user-facing prose after the final Action was
# discarded by the batch slicer. For asynchronous/non-idempotent tools that turned a
# single request into repeated real dispatches. Only whitespace may occur between or
# after Action calls.
define react_action_turn_is_valid with raw as Str and first_start as Int and first_end as Int returning Int:
    if react_action_prefix_is_valid(raw and first_start) == 0:
        return 0
    set raw_len to string_length(raw)
    set current_end to first_end
    repeat while current_end < raw_len:
        set next_pos to react_find_protocol_marker_from(raw and current_end)
        if next_pos < 0:
            set tail to string_trim(substring(raw and current_end and raw_len - current_end))
            if string_length(tail) > 0:
                return 0
            return 1
        set gap to string_trim(substring(raw and current_end and next_pos - current_end))
        if string_length(gap) > 0:
            return 0
        set remainder to substring(raw and next_pos and raw_len - next_pos)
        set next_action to react_parse_action(remainder)
        if map_get_val(next_action and "found") == 0:
            free_map(next_action)
            return 0
        if map_get_val(next_action and "start_pos") != 0:
            free_map(next_action)
            return 0
        set current_end to next_pos + map_get_val(next_action and "end_pos")
        free_map(next_action)
    return 1

# Typed controller policy for tools whose successful execution IS the completion of
# the foreground request. Kept as a pure helper so terminal lifecycle and asynchronous
# dispatch invariants are regression-testable without invoking either real tool.
define react_tool_result_finishes_turn with tool_name as Str and action_allowed as Int and tool_result as Str returning Int:
    if action_allowed == 0:
        return 0
    if tool_name equals "generate_image":
        if string_index_of(tool_result and "ERROR:") != 0:
            return 1
    if tool_name equals "session_terminate":
        if string_index_of(tool_result and "Session closed by Echo.") == 0:
            return 1
    if tool_name equals "system_recompile":
        if string_index_of(tool_result and "RECOMPILE STAGED:") == 0:
            return 1
    # Evaluator failures are always recoverable authoring feedback. They return to
    # durable transaction state and never become terminal merely because evidence
    # repeated a fixed number of times.
    return 0

# Parse the provider-constrained decision envelope. This parser intentionally accepts
# no prose fallback: fresh model output is either exactly the two-key object or it is
# not executable. Controller-authored recovery transitions still use the legacy
# Action parser below because they are trusted local data, not model text.
define react_parse_action_envelope with raw as Str returning Map:
    set result to create_map()
    set ok to map_insert(result and "found" and 0)
    set clean to string_trim(raw)
    set root to json_parse(clean)
    if root == 0 or else get_json_type(root) != 4:
        return result
    set keys to get_list(root and 1)
    if length_list(keys) != 2:
        return result
    set tool_node to get_json_object_value(root and "tool_name")
    set args_node to get_json_object_value(root and "arguments")
    if tool_node == 0 or else args_node == 0:
        return result
    if get_json_type(tool_node) != 2 or else get_json_type(args_node) != 3:
        return result
    # Some local providers preserve the required `arguments` array but wrap the
    # complete positional list in one additional array:
    #   {"tool_name":"codebase_read_range","arguments":[["path",501,1000]]}
    # Registered tools do not accept list-valued positional parameters. Flatten
    # exactly this one unambiguous wrapper at the typed boundary, then apply the
    # normal object rejection and per-tool schema validation to the canonical list.
    # Deeper nesting and mixed nested/scalar arguments remain invalid.
    set outer_values to get_json_value(args_node)
    if length_list(outer_values) == 1:
        set only_outer_arg to get_list(outer_values and 0)
        if get_json_type(only_outer_arg) == 3:
            set nested_values to get_json_value(only_outer_arg)
            set nested_invalid to 0
            set nested_idx to 0
            repeat while nested_idx < length_list(nested_values):
                set nested_node to get_list(nested_values and nested_idx)
                if get_json_type(nested_node) == 3 or else get_json_type(nested_node) == 4:
                    set nested_invalid to 1
                set nested_idx to nested_idx + 1
            if nested_invalid == 1:
                return result
            set args_node to only_outer_arg
    set arg_values to get_json_value(args_node)
    set arg_idx to 0
    repeat while arg_idx < length_list(arg_values):
        set arg_node to get_list(arg_values and arg_idx)
        # Registered tools use positional values. A named object inside `arguments`
        # is a different protocol and must not reach dispatch even if a provider
        # ignored the response grammar.
        if get_json_type(arg_node) == 4:
            return result
        set arg_idx to arg_idx + 1
    set tool_name to string_trim(ptr_to_str(get_json_value(tool_node)))
    if string_length(tool_name) == 0:
        return result
    set args_str to json_stringify(args_node)
    set ok to map_insert(result and "found" and 1)
    set ok to map_insert(result and "tool_name" and tool_name)
    set ok to map_insert(result and "args_str" and args_str)
    set ok to map_insert(result and "start_pos" and 0)
    set ok to map_insert(result and "end_pos" and string_length(clean))
    set values_list to create_list()
    set ok to map_insert(result and "values_list" and values_list)
    set ok to append_list(values_list and tool_name)
    set ok to append_list(values_list and args_str)
    return result

# Gemma occasionally represents an explicitly empty positional list as one empty
# string. Normalize only when the authoritative registered schema declares the exact
# tool as `name([])`; no non-empty argument or optional-argument tool is affected.
define react_schema_declares_zero_args with tool_name as Str and schemas as Str returning Int:
    if string_length(tool_name) == 0:
        return 0
    set declaration to concat("- " and concat(tool_name and "([])"))
    if string_contains(schemas and declaration) == 1:
        return 1
    return 0

define react_parse_action with raw as Str returning Map:
    set result to create_map()
    set ok to map_insert(result and "found" and 0)

    set raw_len to string_length(raw)
    set raw_lower to string_lower(raw)
    set search_from to 0
    set pos to react_find_protocol_marker_from(raw and search_from)
    set marker_len to 0
    set tool_name_start to 0
    set tool_name_end to 0
    set start_args to -1
    set valid_header to 0

    # Skip malformed or illustrative marker lines and keep looking for the first
    # syntactically valid protocol action. This handles a quoted/example `Action:` line
    # before the real action without executing prose or discarding the valid call.
    repeat while pos >= 0 and valid_header == 0:
        set marker_len to 7
        if pos + 5 <= raw_len:
            if substring(raw_lower and pos and 5) equals "call:":
                set marker_len to 5
        set tool_name_start to pos + marker_len
        set skip_done to 0
        repeat while tool_name_start < raw_len and skip_done == 0:
            set ch to get_character(raw and tool_name_start)
            if ch == 32 or else ch == 9:
                set tool_name_start to tool_name_start + 1
            else:
                set skip_done to 1

        set first_name_ok to 0
        if tool_name_start < raw_len:
            set first_name_ch to get_character(raw and tool_name_start)
            if first_name_ch >= 65 and also first_name_ch <= 90:
                set first_name_ok to 1
            if first_name_ch >= 97 and also first_name_ch <= 122:
                set first_name_ok to 1
            if first_name_ch == 95:
                set first_name_ok to 1

        if first_name_ok == 1:
            set tool_name_end to tool_name_start
            set reading_name to 1
            repeat while tool_name_end < raw_len and reading_name == 1:
                set name_ch to get_character(raw and tool_name_end)
                set valid_name_ch to 0
                if name_ch >= 65 and also name_ch <= 90:
                    set valid_name_ch to 1
                if name_ch >= 97 and also name_ch <= 122:
                    set valid_name_ch to 1
                if name_ch >= 48 and also name_ch <= 57:
                    set valid_name_ch to 1
                if name_ch == 95:
                    set valid_name_ch to 1
                if valid_name_ch == 1:
                    set tool_name_end to tool_name_end + 1
                else:
                    set reading_name to 0

            set start_args to tool_name_end
            set skipping_gap to 1
            repeat while start_args < raw_len and skipping_gap == 1:
                set gap_ch to get_character(raw and start_args)
                if gap_ch == 32 or else gap_ch == 9:
                    set start_args to start_args + 1
                else:
                    set skipping_gap to 0
            if start_args < raw_len:
                if get_character(raw and start_args) == 40:
                    set valid_header to 1

        if valid_header == 0:
            set search_from to pos + marker_len
            set pos to react_find_protocol_marker_from(raw and search_from)

    if valid_header == 0:
        return result

    set tool_name to substring(raw and tool_name_start and tool_name_end - tool_name_start)
    set tool_name_trimmed to string_trim(tool_name)
    
    set end_args to -1
    set in_string to 0
    set escaped to 0
    set depth to 1
    set scan_idx to start_args + 1
    set scan_done to 0
    repeat while scan_idx < raw_len and scan_done == 0:
        set ch to get_character(raw and scan_idx)
        if escaped == 1:
            set escaped to 0
        else if ch == 92: # backslash '\'
            set escaped to 1
        else if ch == 34: # double quote '"'
            if in_string == 0:
                set in_string to 1
            else:
                set in_string to 0
        else if in_string == 0:
            if ch == 40: # '('
                set depth to depth + 1
            else if ch == 41: # ')'
                set depth to depth - 1
                if depth == 0:
                    set end_args to scan_idx
                    set scan_done to 1
        set scan_idx to scan_idx + 1

    # Some local models finish an otherwise complete JSON-array tool call at EOF with
    # the outer Action parenthesis omitted: `Action: tool([..]`. Recover exactly that
    # one-byte transport truncation only when the string state is closed, parenthesis
    # depth is otherwise balanced, and the complete argument bytes parse as a JSON
    # list. Any unterminated string, nested expression, prose tail, or malformed JSON
    # still fails closed and is re-prompted without executing a tool.
    set recovered_terminal_close to 0
    if end_args < start_args and also depth == 1 and also in_string == 0 and also escaped == 0:
        set trimmed_end to raw_len
        set trimming_tail to 1
        repeat while trimmed_end > start_args + 1 and trimming_tail == 1:
            set tail_ch to get_character(raw and trimmed_end - 1)
            if tail_ch == 9 or else tail_ch == 10 or else tail_ch == 13 or else tail_ch == 32:
                set trimmed_end to trimmed_end - 1
            else:
                set trimming_tail to 0
        if trimmed_end > start_args + 1:
            if get_character(raw and trimmed_end - 1) == 93: # ']'
                set candidate_args to substring(raw and start_args + 1 and trimmed_end - start_args - 1)
                set candidate_json to json_parse(candidate_args)
                if candidate_json != 0:
                    if get_json_type(candidate_json) == 3: # List
                        set end_args to trimmed_end
                        set recovered_terminal_close to 1

    if end_args < start_args:
        return result
        
    set args_str to substring(raw and start_args + 1 and end_args - start_args - 1)
    
    set ok to map_insert(result and "found" and 1)
    set ok to map_insert(result and "tool_name" and tool_name_trimmed)
    set ok to map_insert(result and "args_str" and args_str)
    # Span of THIS action within `raw` (marker start .. just past the closing paren). Used by
    # the batching queue to slice off any FURTHER actions in the same response without
    # re-matching inside this action's own arguments.
    set ok to map_insert(result and "start_pos" and pos)
    set action_end_pos to end_args + 1
    if recovered_terminal_close == 1:
        set action_end_pos to end_args
    set ok to map_insert(result and "end_pos" and action_end_pos)

    set values_list to create_list()
    set ok to map_insert(result and "values_list" and values_list)
    set ok to append_list(values_list and tool_name_trimmed)
    set ok to append_list(values_list and args_str)
    return result


# Return the substring of `raw` starting at the NEXT line-anchored "Action:" (or "call:") marker at or
# after `from_pos`, or "" if there is none. `from_pos` is the position just past the FIRST
# action's closing paren, so a spurious "action:" inside the first action's arguments is
# never matched. This is what lets the model batch many tools into ONE response: the loop
# runs the first, then feeds this slice back as the next turn's raw_output with NO new
# inference call, and so on until the batch is drained.
define react_slice_from_next_action with raw as Str and from_pos as Int returning Str:
    set raw_len to string_length(raw)
    if from_pos < 0 or else from_pos >= raw_len:
        return ""
    set next_pos to react_find_protocol_marker_from(raw and from_pos)
    if next_pos < 0:
        return ""
    return substring(raw and next_pos and raw_len - next_pos)


# Scan a DROPPED text segment for orphaned tool calls — `name([...])` continuations the
# model emitted WITHOUT an 'Action:' marker (e.g. "Action: a([...]) → b([...]) → c([...])").
# The batching slicer only recognizes Action:/call: markers, so such calls were silently
# skipped (observed live: operate_scheduler list/delete reported "no observation
# returned" — they were never executed). Names are validated against the registered
# schema text ("- <name>(") so prose words never trigger a nudge; the caller injects a
# format note NAMING the dropped calls so the model re-emits them properly. Bare names
# are deliberately NOT auto-executed — tools only run from the auditable Action grammar.
# Segment is capped at 2000 chars (get_character is O(n); dropped segments are small).
define react_find_orphan_calls with segment as Str and schemas as Str returning Str:
    set found to ""
    set n to string_length(segment)
    if n > 2000:
        set n to 2000
    set i to 0
    repeat while i < n - 1:
        set ch to get_character(segment and i)
        if ch == 40:
            if get_character(segment and i + 1) == 91:
                # "([": walk back over [a-z0-9_] to recover the candidate tool name.
                set s to i
                set walking to 1
                repeat while walking == 1 and also s > 0:
                    set pc to get_character(segment and s - 1)
                    set is_ident to 0
                    if pc >= 97 and also pc <= 122:
                        set is_ident to 1
                    if pc >= 48 and also pc <= 57:
                        set is_ident to 1
                    if pc == 95:
                        set is_ident to 1
                    if is_ident == 1:
                        set s to s - 1
                    else:
                        set walking to 0
                if i - s >= 3:
                    set cand to substring(segment and s and i - s)
                    if string_contains(schemas and concat("- " and concat(cand and "("))) == 1:
                        if string_contains(found and cand) == 0:
                            if string_length(found) > 0:
                                set found to concat(found and ", ")
                            set found to concat(found and cand)
        set i to i + 1
    return found


define react_hebbian_trigger with memory_mgr as Map and text as Str returning Int:
    set concepts to create_list()
    set ok to append_list(concepts and "wallet")
    set ok to append_list(concepts and "ledger")
    set ok to append_list(concepts and "dht")
    set ok to append_list(concepts and "consensus")
    set ok to append_list(concepts and "identity")
    set ok to append_list(concepts and "speech")
    set ok to append_list(concepts and "turing")
    set ok to append_list(concepts and "name")
    
    set text_upper to string_upper(text)
    set len to length_list(concepts)
    
    set i to 0
    repeat while i < len:
        set c1 to get_list(concepts and i)
        set c1_upper to string_upper(c1)
        if string_contains(text_upper and c1_upper) == 1:
            set j to i + 1
            repeat while j < len:
                set c2 to get_list(concepts and j)
                set c2_upper to string_upper(c2)
                if string_contains(text_upper and c2_upper) == 1:
                    set ok to memory_strengthen_synapse(memory_mgr and c1 and c2)
                set j to j + 1
        set i to i + 1
        
    free_list(concepts)
    return 0


define react_simulate_inference with prompt as Str and loop_idx as Int returning Str:
    set prompt_upper to string_upper(prompt)
    
    if string_contains(prompt_upper and "AUTO_APPROVE_TEST") == 1:
        if loop_idx == 0:
            return "Thought: I will call money_transfer.\nAction: money_transfer([50, \"did:key:recipient\"])"
        else if loop_idx == 1:
            return "Thought: I will call dht_store.\nAction: dht_store([\"test_key\", \"test_val\"])"
        else:
            return "Thought: I will now reply correctly.\nAction: reply_request([\"ai:agent_rebuild,response:Success\"])"

    if string_contains(prompt_upper and "CONVERGENCE_TEST") == 1:
        if loop_idx == 0:
            return "Thought: I will output a message without a properly formatted Action statement to test loop convergence recovery."
        else:
            return "Thought: I will now reply correctly.\nAction: reply_request([\"ai:agent_rebuild,response:Success\"])"

    set req_pos to string_last_index_of(prompt_upper and "USER REQUEST:")
    set obs_pos to string_last_index_of(prompt_upper and "\nOBSERVATION:")
    if obs_pos > req_pos:
        set observation_text to substring(prompt and obs_pos + 13 and string_length(prompt) - obs_pos - 13)
        return f"Thought: I have received the observation. I will now reply to the user.\nAction: reply_request([\"ai:agent_rebuild,response:Success. Result is: {string_trim(observation_text)}\"])"
        
    if string_contains(prompt_upper and "TURING_GRID_OP") == 1:
        set op_start to string_index_of(prompt and "turing_grid_op(")
        if op_start > 0:
            set op_end to string_index_of(prompt and ")")
            if op_end > op_start:
                set op_args to substring(prompt and op_start + 15 and op_end - op_start - 15)
                return f"Thought: Running Turing Grid operation.\nAction: turing_grid_op({op_args})"
        
    if string_contains(prompt_upper and "RESOLVE NAME ") == 1:
        set name_pos to string_index_of(prompt_upper and "RESOLVE NAME ")
        set name_arg to substring(prompt and name_pos + 13 and string_length(prompt) - name_pos - 13)
        set name_trimmed to string_trim(name_arg)
        return f"Thought: The user wants me to resolve a name. I will call name_resolve.\nAction: name_resolve([\"{name_trimmed}\"])"
        
    if string_contains(prompt_upper and "CHECK BALANCE") == 1 or else string_contains(prompt_upper and "WALLET BALANCE") == 1:
        return "Thought: I need to check the wallet balance. I will call wallet_balance.\nAction: wallet_balance([])"
        
    if string_contains(prompt_upper and "TRANSFER ") == 1:
        return "Thought: I will call money_transfer.\nAction: money_transfer([50, \"did:key:recipient\"])"
        
    return "Thought: I will answer the user request directly.\nAction: reply_request([\"ai:agent_rebuild,response:Hello! I am the ErnOS Agent rebuilt in ErnosPlain. How can I help you today?\"])"

# When the repair controller has only one legal next transition, do not spend another
# model call asking it to choose—or let a stale repeated action loop against the same
# gate. The generated action still passes normal parsing, audit, execution and trace.
define react_repair_gate_forced_action with gate_error as Str returning Str:
    # Controller decisions consume stable machine codes only. Human diagnostics may
    # change for clarity without silently changing state-machine behavior.
    if string_contains(gate_error and "code=BASELINE_NO_CHANGE") == 1:
        return "Thought: The sealed current-source baseline proves that no implementation regression is present.\nAction: reply_request([\"No current implementation regression was found. The complete mandatory current-source suite is green, so I did not modify, recompile, or restart the system.\"])"
    if string_contains(gate_error and "code=VERIFY_REQUIRED") == 1:
        return "Thought: The repair controller requires the authoritative current-source gate now.\nAction: system_verify([])"
    if string_contains(gate_error and "code=DEPLOY_REQUIRED") == 1:
        return "Thought: The verified repair request requires transactional deployment now.\nAction: system_recompile([])"
    if string_contains(gate_error and "code=EXACT_PATH_DISCOVERY_REQUIRED") == 1:
        return "Thought: The investigation controller requires exact existing source paths before any filename can be selected.\nAction: codebase_list([\"decent_agent\", 200])"
    if string_contains(gate_error and "code=EVALUATOR_AUTHORING_REQUIRED") == 1:
        if file_exists("config/improvements/staging/validation.json") == 1:
            set evaluator_validation to read_file("config/improvements/staging/validation.json")
            if string_contains(evaluator_validation and "\"status\": \"passed\"") == 1:
                return "Thought: The retained evaluators have a current successful validation receipt, so the controller requires their immutable freeze.\nAction: improvement_test_freeze([])"
        if file_exists("config/improvements/staging/regression.py") == 1 and also file_exists("config/improvements/staging/e2e.py") == 1:
            set staged_regression to string_trim(read_file("config/improvements/staging/regression.py"))
            set staged_e2e to string_trim(read_file("config/improvements/staging/e2e.py"))
            if string_length(staged_regression) > 0 and also string_length(staged_e2e) > 0:
                if file_exists("config/improvements/staging/validation.json") == 1:
                    set failed_validation to read_file("config/improvements/staging/validation.json")
                    if string_contains(failed_validation and "\"status\": \"failed\"") == 1 or else string_contains(failed_validation and "\"status\":\"failed\"") == 1:
                        return ""
                return "Thought: Both retained controller-checked evaluators exist, so I will validate their causal unchanged-source behavior now.\nAction: improvement_test_validate([])"
        return "Thought: Evaluator authoring is incomplete, so I will use the deterministic plan-bound evaluator scaffold instead of generating transport or test boilerplate in prose.\nAction: improvement_test_scaffold([])"
    return ""

# A frozen pre-write contract is intentionally closed to new discovery. If a real
# controller result proves that the selected plan omitted a required production path,
# continuing to reread or rewrite the same insufficient file cannot make progress.
# Use the existing approval- and rights-ledgered abandonment transition immediately;
# its immutable archive preserves the failed plan and the same turn can reinvestigate
# the missing dependency. This is narrower than reacting to an ordinary compiler
# error: only an explicit frozen-plan scope rejection triggers it.
define react_result_has_gate_code with tool_result as Str and error_code as Str returning Int:
    if string_length(error_code) == 0:
        return 0
    # Match the controller-owned structured envelope, not incidental prose such as
    # "only code=PLAN_SCOPE_MISSING may abandon" in a successful tool result.
    set marker to concat("IMPROVEMENT_GATE_FAILED code=" and concat(error_code and " "))
    if string_contains(tool_result and marker) == 1:
        return 1
    return 0

define react_frozen_scope_replan_action with ctx as Map and tool_result as Str returning Str:
    set frozen to 0
    set write_seen to 0
    if map_contains(ctx and "improvement_test_frozen") == 1:
        set frozen to map_get_val(ctx and "improvement_test_frozen")
    if map_contains(ctx and "repair_write_seen") == 1:
        set write_seen to map_get_val(ctx and "repair_write_seen")
    if frozen != 1 or else write_seen != 0:
        return ""
    # Human-readable compiler/path text is diagnostic only. Abandonment authority is
    # granted solely by the gate's explicit structured code.
    if react_result_has_gate_code(tool_result and "PLAN_SCOPE_MISSING") == 0:
        return ""
    set ok to map_insert(ctx and "improvement_plan_scope_missing_authorized" and 1)
    return "Thought: The controller has proven that this frozen plan omitted a required production dependency, and no implementation write was accepted. I will preserve the failed contract and restart investigation with the missing path included.\nAction: improvement_test_abandon([\"The frozen implementation plan omitted a production dependency proven necessary by the controller's rejected pre-write operation. No implementation write was accepted, so I am preserving this evidence and restarting investigation with the missing path explicitly included.\"])"

define react_candidate_repair_action with ctx as Map and tool_result as Str returning Str:
    if react_result_has_gate_code(tool_result and "CANDIDATE_REPAIR_REQUIRED") == 0:
        return ""
    # If the retained candidate can be resolved internally, the next durable prompt
    # includes its exact current bytes directly. Do not burn another tool turn rereading
    # the same production alias after every failed localized repair.
    set retained_path to ""
    if map_contains(ctx and "last_codebase_path") == 1:
        set retained_path to tools_improvement_candidate_for_read(ctx and ptr_to_str(map_get_val(ctx and "last_codebase_path")))
    if string_length(retained_path) > 0 and also file_exists(retained_path) == 1 and also is_directory(retained_path) == 0:
        return ""
    return react_frozen_planned_reread_action(ctx)

# Persist the controller's exact structured candidate failure for the next fresh
# state decision. Without this handoff, post-execution addressing failures existed
# only in the discarded observation text, so the already-implemented deterministic
# candidate-reset transition could never see reason=EXACT_MATCH_COUNT and the model
# repeatedly requested approval for the same impossible replacement.
define react_record_candidate_gate_correction with ctx as Map and tool_result as Str returning Int:
    if react_result_has_gate_code(tool_result and "CANDIDATE_REPAIR_REQUIRED") == 0:
        return 0
    set ok to map_insert(ctx and "durable_protocol_correction" and tool_result)
    return 1

# A legacy frozen plan that retained only path names/hashes but not exact callable
# evidence cannot be implemented safely after compaction. Preserve it through the
# existing rights-ledgered abandonment path and immediately reinvestigate; do not ask
# the model to guess APIs from filenames.
define react_missing_plan_evidence_forced_action with ctx as Map returning Str:
    set missing to 0
    set frozen to 0
    set write_seen to 0
    if map_contains(ctx and "frozen_plan_evidence_missing") == 1:
        set missing to map_get_val(ctx and "frozen_plan_evidence_missing")
    if map_contains(ctx and "improvement_test_frozen") == 1:
        set frozen to map_get_val(ctx and "improvement_test_frozen")
    if map_contains(ctx and "repair_write_seen") == 1:
        set write_seen to map_get_val(ctx and "repair_write_seen")
    if missing == 1 and also frozen == 1 and also write_seen == 0:
        return "Thought: The controller proved this legacy frozen plan lost its exact callable evidence across compaction. I will preserve it and restart investigation before any implementation write.\nAction: improvement_test_abandon([\"The frozen plan predates mandatory hash-bound callable, import, and working-call-site evidence. Compaction removed facts required for a safe implementation, and no implementation write was accepted, so I am preserving the failed contract and restarting exact investigation.\"])"
    return ""

define react_candidate_reset_forced_action_from_state with active_bytes as Str and correction as Str returning Str:
    # Historical attempt diagnostics remain in active.json after a successful reset.
    # Force another reset only while a *current* retained candidate is rejected;
    # otherwise the controller loops forever on an already archived attempt.
    set has_rejected_candidate to 0
    if string_contains(active_bytes and "\"status\": \"rejected\"") == 1 or else string_contains(active_bytes and "\"status\":\"rejected\"") == 1:
        set has_rejected_candidate to 1
    if has_rejected_candidate == 1 and also string_contains(active_bytes and "CANDIDATE_BASELINE_INCOMPLETE") == 1:
        return "Thought: The additive candidate removed existing production definitions. The controller will archive the rejected attempt and reopen the same frozen contract at an exact live-source reread.\nAction: improvement_candidate_reset([])"
    # A repeated byte-identical replacement is a controller state transition, not a
    # reason to call the model again with the same evidence. Archive the never-live
    # candidate and reopen whole-candidate authoring from the exact production bytes;
    # the immutable plan/evaluators and compiler diagnostic remain in active.json.
    if has_rejected_candidate == 1 and also string_contains(correction and "code=NO_CHANGE_REPEAT") == 1:
        return "Thought: Localized repair has stalled on a repeated byte-no-op. The controller will preserve the rejected attempt and diagnostic, then reopen this same frozen contract from an exact production reread for one genuinely new complete candidate.\nAction: improvement_candidate_reset([])"
    # An exact-addressing miss means the model is no longer operating on the bytes
    # actually registered by the candidate controller. Retrying another guessed
    # fragment only grows the transcript and can never repair those hidden bytes.
    # Archive the never-live candidate immediately and reopen whole-candidate
    # authoring from an exact production reread; this preserves the frozen contract.
    if has_rejected_candidate == 1 and also string_contains(correction and "reason=EXACT_MATCH_COUNT") == 1:
        return "Thought: The localized replacement did not address the registered candidate bytes. The controller will preserve that never-live attempt and reopen this same frozen contract from an exact production reread for one complete corrected candidate.\nAction: improvement_candidate_reset([])"
    return ""


# Repetition recovery must respect candidate addressing state. Once a retained
# candidate is rejected, a production reread is not a legal repair transition: the
# path alias resolves to candidate state, while the frozen guard correctly refuses
# redundant production discovery. Reset the isolated candidate instead. This is a
# transaction-preserving repair transition, not abandonment or rollback.
define react_repetition_checkpoint_action_from_state with active_bytes as Str and reread_action as Str returning Str:
    if string_contains(active_bytes and "\"status\": \"rejected\"") == 1 or else string_contains(active_bytes and "\"status\":\"rejected\"") == 1:
        return "Thought: Repeated generation cannot safely address the rejected retained candidate. The controller will preserve that never-live attempt and reopen the same frozen contract from exact production bytes.\nAction: improvement_candidate_reset([])"
    return reread_action


define react_repetition_checkpoint_action with ctx as Map returning Str:
    set active_bytes to ""
    if file_exists("config/improvements/active.json") == 1:
        set active_bytes to read_file("config/improvements/active.json")
    return react_repetition_checkpoint_action_from_state(active_bytes and react_frozen_planned_reread_action(ctx))

define react_incomplete_candidate_reset_forced_action with ctx as Map returning Str:
    if map_contains(ctx and "improvement_test_frozen") == 0 or else map_get_val(ctx and "improvement_test_frozen") != 1:
        return ""
    if file_exists("config/improvements/active.json") == 0:
        return ""
    set correction to ""
    if map_contains(ctx and "durable_protocol_correction") == 1:
        set correction to ptr_to_str(map_get_val(ctx and "durable_protocol_correction"))
    return react_candidate_reset_forced_action_from_state(read_file("config/improvements/active.json") and correction)

# Record a structured candidate failure and select its mechanically required
# recovery atomically at the same post-tool boundary. Approval resume and durable
# prompt rebuilding must never separate reason=EXACT_MATCH_COUNT from the mandatory
# provenance-preserving candidate reset.
define react_candidate_post_result_forced_action_from_state with ctx as Map and tool_result as Str and active_bytes as Str returning Str:
    set recorded to react_record_candidate_gate_correction(ctx and tool_result)
    if recorded == 0:
        return ""
    set correction to ptr_to_str(map_get_val(ctx and "durable_protocol_correction"))
    return react_candidate_reset_forced_action_from_state(active_bytes and correction)

define react_candidate_post_result_forced_action with ctx as Map and tool_result as Str returning Str:
    if file_exists("config/improvements/active.json") == 0:
        return ""
    return react_candidate_post_result_forced_action_from_state(ctx and tool_result and read_file("config/improvements/active.json"))

# The first frozen implementation decision must see the complete current bytes of
# the exact planned production file. Interface snippets in the durable plan are not
# a substitute for preserving every existing import, schema and dispatch branch in a
# whole-file write. Select that read mechanically before any model-authored candidate.
define react_initial_frozen_read_required with active_bytes as Str and latest_tool as Str and latest_observation as Str returning Int:
    if string_contains(active_bytes and "\"state\": \"frozen\"") == 0 and also string_contains(active_bytes and "\"state\":\"frozen\"") == 0:
        return 0
    if string_contains(active_bytes and "\"status\": \"rejected\"") == 1 or else string_contains(active_bytes and "\"status\":\"rejected\"") == 1:
        return 0
    if (latest_tool equals "codebase_read" or else latest_tool equals "codebase_read_range") and also react_observation_has_reread_receipt(latest_observation) == 1:
        return 0
    return 1

define react_initial_frozen_read_forced_action with ctx as Map returning Str:
    if map_contains(ctx and "improvement_test_frozen") == 0 or else map_get_val(ctx and "improvement_test_frozen") != 1:
        return ""
    if file_exists("config/improvements/active.json") == 0:
        return ""
    set active_bytes to read_file("config/improvements/active.json")
    set latest_tool to ""
    set latest_observation to ""
    if map_contains(ctx and "frozen_latest_tool") == 1 and also map_contains(ctx and "frozen_latest_observation") == 1:
        set latest_tool to ptr_to_str(map_get_val(ctx and "frozen_latest_tool"))
        set latest_observation to ptr_to_str(map_get_val(ctx and "frozen_latest_observation"))
    if react_initial_frozen_read_required(active_bytes and latest_tool and latest_observation) == 0:
        return ""
    return react_frozen_planned_reread_action(ctx)

# Once a requested deployment has a post-write green verification, there is exactly
# one legal next transition. Select it in the controller before inference so stale
# model reasoning cannot spend dozens of turns proposing blocked reads or rewrites.
define react_verified_deploy_forced_action with ctx as Map returning Str:
    set workflow_active to 0
    set deploy_required to 0
    set verify_required to 0
    set verify_green to 0
    set write_seen to 0
    if map_contains(ctx and "repair_workflow_active") == 1:
        set workflow_active to map_get_val(ctx and "repair_workflow_active")
    if map_contains(ctx and "repair_deploy_required") == 1:
        set deploy_required to map_get_val(ctx and "repair_deploy_required")
    if map_contains(ctx and "repair_verify_required") == 1:
        set verify_required to map_get_val(ctx and "repair_verify_required")
    if map_contains(ctx and "repair_verify_green") == 1:
        set verify_green to map_get_val(ctx and "repair_verify_green")
    if map_contains(ctx and "repair_write_seen") == 1:
        set write_seen to map_get_val(ctx and "repair_write_seen")
    if workflow_active == 1 and also deploy_required == 1 and also verify_required == 0 and also verify_green == 1 and also write_seen == 1 and also map_contains(ctx and "upgrade_restart_requested") == 0:
        return "Thought: The verified implementation now requires its transactional deployment.\nAction: system_recompile([])"
    return ""

# The first source verification in repair/feature work is a controller transition,
# not a planning choice. Selecting it here also prevents an explicitly recognized
# request from spending a model turn trying a later phase before the baseline exists.
define react_improvement_confirmation_forced_action with ctx as Map returning Str:
    if map_contains(ctx and "improvement_confirmation_required") == 0 or else map_get_val(ctx and "improvement_confirmation_required") != 1:
        return ""
    return "Thought: The current message may be requesting a protected self-improvement transaction, but a mention is not authorization. I will ask one explicit follow-up before any verification or implementation.\nAction: request_clarification([\"Are you trying to trigger the protected self-improvement workflow now?||Yes, trigger self-improvement||No, continue the conversation\"])"

define react_initial_repair_baseline_forced_action with ctx as Map returning Str:
    if map_contains(ctx and "repair_workflow_active") == 0 or else map_get_val(ctx and "repair_workflow_active") != 1:
        return ""
    set verify_required to 0
    set baseline_seen to 0
    set write_seen to 0
    if map_contains(ctx and "repair_verify_required") == 1:
        set verify_required to map_get_val(ctx and "repair_verify_required")
    if map_contains(ctx and "repair_baseline_seen") == 1:
        set baseline_seen to map_get_val(ctx and "repair_baseline_seen")
    if map_contains(ctx and "repair_write_seen") == 1:
        set write_seen to map_get_val(ctx and "repair_write_seen")
    if verify_required == 1 and also baseline_seen == 0 and also write_seen == 0:
        return "Thought: The protected controller requires an authoritative unchanged-source baseline before any investigation or implementation decision.\nAction: system_verify([])"
    return ""

# A typed investigation request that arrived before the baseline retains its exact
# objective in the request context. Once system_verify is green, replay that exact
# two-key envelope mechanically instead of asking the model to restate or remember it.
define react_pending_investigation_forced_action with ctx as Map returning Str:
    if map_contains(ctx and "pending_improvement_objective") == 0:
        return ""
    if map_contains(ctx and "repair_workflow_active") == 0 or else map_get_val(ctx and "repair_workflow_active") != 1:
        return ""
    if map_contains(ctx and "repair_baseline_seen") == 0 or else map_get_val(ctx and "repair_baseline_seen") != 1:
        return ""
    if map_contains(ctx and "repair_verify_green") == 0 or else map_get_val(ctx and "repair_verify_green") != 1:
        return ""
    if map_contains(ctx and "repair_write_seen") == 1 and also map_get_val(ctx and "repair_write_seen") != 0:
        return ""
    if map_contains(ctx and "improvement_investigation_started") == 1 and also map_get_val(ctx and "improvement_investigation_started") == 1:
        return ""
    set objective to ptr_to_str(map_get_val(ctx and "pending_improvement_objective"))
    if string_length(objective) == 0:
        return ""
    return concat("{\"tool_name\":\"improvement_investigation_begin\",\"arguments\":[\"" and concat(llm_json_escape(objective) and "\"]}"))

# Completion of the planned implementation set is a controller fact, not a model
# judgment. Force the sealed verifier immediately so a compile-valid candidate cannot
# drift into rereads or byte-identical replacements before its behavioral gate runs.
define react_post_write_verify_forced_action_from_state with ctx as Map and active_bytes as Str returning Str:
    if map_contains(ctx and "repair_workflow_active") == 0 or else map_get_val(ctx and "repair_workflow_active") != 1:
        return ""
    if map_contains(ctx and "repair_write_seen") == 0 or else map_get_val(ctx and "repair_write_seen") != 1:
        return ""
    if map_contains(ctx and "repair_verify_required") == 0 or else map_get_val(ctx and "repair_verify_required") != 1:
        return ""
    if tools_improvement_all_planned_paths_implemented_json(active_bytes) == 0:
        return ""
    return "Thought: Every production path in the immutable plan now has a promoted implementation receipt. The controller requires authoritative verification before any further source action.\nAction: system_verify([])"

define react_post_write_verify_forced_action with ctx as Map returning Str:
    if map_contains(ctx and "improvement_active_bound") == 0 or else map_get_val(ctx and "improvement_active_bound") != 1:
        return ""
    if file_exists("config/improvements/active.json") == 0:
        return ""
    return react_post_write_verify_forced_action_from_state(ctx and read_file("config/improvements/active.json"))

# Once evaluators are frozen, explanation-only turns cannot advance the transaction.
# Give the model one terse, phase-specific recovery instruction instead of letting it
# spend repeated full token budgets re-deriving an immutable plan until the action is
# truncated. This changes no authority: the resulting write still traverses preflight,
# approval, Observer audit, compile verification, exact rollback, and the frozen gate.
define react_frozen_implementation_action_nudge with ctx as Map and streak as Int returning Str:
    set frozen to 0
    if map_contains(ctx and "improvement_test_frozen") == 1:
        set frozen to map_get_val(ctx and "improvement_test_frozen")
    if frozen != 1 or else streak < 1:
        return ""
    return "[FROZEN IMPLEMENTATION ACTION RECOVERY — INVISIBLE TO USER]\nThe plan and evaluator are already immutable. New discovery remains closed: never search, list, inspect an unplanned path, or use Git. Do not restate the request, plan, workflow, source, or compiler diagnostic. Do not emit a long <think> block. If exact planned source bytes are not fully active, or an exact replacement matched zero times, emit exactly one line-anchored Action: codebase_read([planned_path]) now; the controller will allow only the frozen-plan path and verify its pre-write hash. Otherwise use no more than 200 words of private reasoning, then emit exactly one complete line-anchored Action: codebase_write([...]) or Action: codebase_replace([...]) for that path. If a controller Observation proves that an unplanned production path is required and no write was accepted, use improvement_test_abandon with the exact architectural reason and immediately reinvestigate instead of guessing functions inside the insufficient file. JSON does not escape '[' or ']'. Preserve every investigated existing interface exactly. The protected writer will compile-check and roll back automatically if correction is still needed.\n"

# Repetition recovery must respect the current transaction phase. The generic repair
# instruction used to tell a frozen improvement to search/read, even though the
# controller correctly rejects all discovery after evaluator freeze. That contradiction
# converted a recoverable exact-replacement typo into a terminal reasoning spiral.
define react_thought_spiral_recovery_guidance with ctx as Map returning Str:
    set frozen to 0
    if map_contains(ctx and "improvement_test_frozen") == 1:
        set frozen to map_get_val(ctx and "improvement_test_frozen")
    if frozen == 1:
        return "[THOUGHT SPIRAL RECOVERY — INVISIBLE TO USER] Your last reasoning stream repeated without a new action. The improvement contract is frozen, so new discovery remains closed: do not search, list, inspect an unplanned path, or use Git. If an authoritative Observation proved an omitted production dependency before any accepted write, call improvement_test_abandon with that exact reason and reinvestigate. Otherwise, if exact planned bytes are missing or exact_old matched zero times, emit exactly one codebase_read Action for the frozen-plan production path; its hash will be verified. Otherwise emit exactly one codebase_write or codebase_replace Action for that path. JSON does not escape '[' or ']'. Do not restart the diagnosis.\n"
    return "[THOUGHT SPIRAL RECOVERY — INVISIBLE TO USER] Your last reasoning stream was stopped because it repeated without producing a new action. Do not restart the diagnosis. Use the most recent authoritative Observation and emit exactly one concrete next Action now. During self-repair before evaluator freeze: search the failing literal, read the exact implementation path, use codebase_replace for a localized fix, verify, then recompile.\n"

# Resolve a deterministic frozen-plan reread after repeated reasoning could not emit
# an action. Prefer the exact last source path involved in this turn; when a plan has
# only one implementation path, that path is unambiguous even after a process wake.
# Multiple-path plans without a recorded last path remain model-directed rather than
# guessing. The eventual read still passes the normal frozen-plan/hash gate.
define react_frozen_planned_reread_action_from_json with workflow_bytes as Str and last_path as Str returning Str:
    if string_length(workflow_bytes) == 0:
        return ""
    set root to json_parse(workflow_bytes)
    if root == 0:
        return ""
    set state_node to get_json_object_value(root and "state")
    if state_node == 0:
        return ""
    set state to ptr_to_str(get_json_value(state_node))
    if state equals "frozen" == 0 and also state equals "implementing" == 0 and also state equals "verified" == 0 and also state equals "repair_required" == 0:
        return ""
    set paths_node to get_json_object_value(root and "planned_files")
    if paths_node == 0:
        return ""
    if get_json_type(paths_node) != 3:
        return ""
    set paths to get_json_value(paths_node)
    set count to length_list(paths)
    if count == 0:
        return ""
    set selected to ""
    if string_length(last_path) > 0:
        set idx to 0
        repeat while idx < count and string_length(selected) == 0:
            set candidate_node to get_list(paths and idx)
            set candidate to ptr_to_str(get_json_value(candidate_node))
            if candidate equals last_path:
                set selected to candidate
            set idx to idx + 1
    if string_length(selected) == 0 and also count == 1:
        set only_node to get_list(paths and 0)
        set selected to ptr_to_str(get_json_value(only_node))
    if string_length(selected) == 0 or else string_contains(selected and "\"") == 1 or else string_contains(selected and "\\") == 1:
        return ""
    return f"Thought: I will refresh the exact approved source bytes after the interrupted repair decision.\nAction: codebase_read([\"{selected}\"])"

define react_frozen_planned_reread_action with ctx as Map returning Str:
    if file_exists("config/improvements/active.json") == 0:
        return ""
    set last_path to ""
    if map_contains(ctx and "last_codebase_path") == 1:
        set last_path to ptr_to_str(map_get_val(ctx and "last_codebase_path"))
    return react_frozen_planned_reread_action_from_json(read_file("config/improvements/active.json") and last_path)

# Repetition recovery is consecutive, not a lifetime quota. A valid action proves
# forward progress and starts a fresh bounded recovery window for the next decision.
define react_note_valid_action with ctx as Map returning Int:
    set ok to map_insert(ctx and "consecutive_no_action" and 0)
    set ok to map_insert(ctx and "thought_spiral_recoveries" and 0)
    return 0

# Tool payloads for plans, evaluators and source candidates are already durable. Do
# not append those large escaped bytes to every later model turn; retain only the
# action identity and let the next read retrieve authoritative bytes when needed.
define react_observation_action_text with tool_name as Str and assistant_text as Str returning Str:
    if tool_name equals "improvement_investigation_begin" or else tool_name equals "improvement_plan_write" or else tool_name equals "improvement_plan_read" or else tool_name equals "improvement_status" or else tool_name equals "improvement_test_begin" or else tool_name equals "improvement_test_write" or else tool_name equals "improvement_test_scaffold" or else tool_name equals "improvement_test_read" or else tool_name equals "improvement_test_validate" or else tool_name equals "improvement_test_freeze":
        return concat("Thought: I completed one staged improvement-test transition.\nAction: " and concat(tool_name and "([staged artifact bytes omitted from active context])"))
    if tool_name equals "codebase_write" or else tool_name equals "codebase_replace":
        return concat("Thought: I submitted one protected source candidate.\nAction: " and concat(tool_name and "([target path retained; candidate bytes omitted from active context])"))
    return assistant_text

# Frozen implementation decisions are rebuilt from the durable transaction and only
# the latest authoritative observation. They never inherit the ever-growing exploratory
# transcript. This preserves the complete long-horizon workflow while keeping every
# individual decision grounded in the current objective, immutable plan and receipt.
define react_frozen_action_class with active_bytes as Str returning Str:
    set root to json_parse(active_bytes)
    if root == 0:
        return ""
    set state_node to get_json_object_value(root and "state")
    if state_node == 0:
        return ""
    set state to ptr_to_str(get_json_value(state_node))
    if state equals "frozen":
        if string_contains(active_bytes and "\"status\": \"rejected\"") == 1 or else string_contains(active_bytes and "\"status\":\"rejected\"") == 1:
            return "CANDIDATE_REPAIR: use codebase_read on the original planned production path, then codebase_replace on that same production path."
        if string_contains(active_bytes and "CANDIDATE_REPAIR_STALLED") == 1:
            return "PLANNED_IMPLEMENTATION_RETRY: the prior rejected candidate and compiler diagnostic are archived in implementation_candidate_attempts. Read the exact planned production path, then submit a genuinely new complete additive candidate that fixes that diagnostic and satisfies the immutable evaluator contract. Do not reproduce the archived candidate hash or repeat its failed design."
        return "PLANNED_IMPLEMENTATION: use codebase_read/codebase_read_range only on a planned production path, then codebase_write for the first complete candidate."
    if state equals "implementing" or else state equals "repair_required":
        return "IMPLEMENTATION_REPAIR_OR_VERIFY: use planned-path codebase_read/codebase_replace when repair evidence exists; otherwise call system_verify."
    if state equals "verified":
        return "VERIFIED_DEPLOYMENT: system_recompile is the only legal transition."
    return ""

define react_frozen_action_class_for_decision with active_bytes as Str and last_tool as Str and last_observation as Str returning Str:
    set action_class to react_frozen_action_class(active_bytes)
    if string_index_of(action_class and "CANDIDATE_REPAIR") == 0:
        if react_observation_has_candidate_receipt(last_observation) == 1:
            return "CANDIDATE_REPLACEMENT_ONLY: the rejected candidate bytes and compiler diagnostic are active. codebase_replace on the original planned production path is the only legal next action. Use exactly {\"tool_name\":\"codebase_replace\",\"arguments\":[\"production/path\",\"smallest exact defective fragment\",\"exact corrected fragment\",1]}. Never pass the whole candidate as one argument. Do not read again, regenerate the whole file, verify, or abandon."
    if string_index_of(action_class and "PLANNED_IMPLEMENTATION") == 0:
        if (last_tool equals "codebase_read" or else last_tool equals "codebase_read_range") and also react_observation_has_reread_receipt(last_observation) == 1:
            return "PLANNED_IMPLEMENTATION_WRITE_ONLY: the exact planned production bytes, frozen interface evidence, evaluator contract, and any archived compiler diagnostic are active. codebase_write on the original planned production path is the only legal next action. Return one complete additive candidate using exactly {\"tool_name\":\"codebase_write\",\"arguments\":[\"production/path\",\"complete source bytes\"]}. Fix the archived cause; do not reproduce an archived candidate or its failed design. Do not read again, reorder read arguments, search, verify unchanged source, or reply."
    return action_class

# Frozen source reads append a controller-owned receipt as its own line. Never treat
# an arbitrary occurrence inside the source bytes as state: tools.ep legitimately
# contains these protocol literals, and a loose substring check turned reading that
# source page into a false candidate/write transition and an unbounded retry loop.
define react_observation_has_reread_receipt with observation as Str returning Int:
    if string_index_of(observation and "IMPROVEMENT_REREAD_OK path=") == 0:
        return 1
    if string_contains(observation and "\nIMPROVEMENT_REREAD_OK path=") == 1:
        return 1
    return 0

define react_observation_has_candidate_receipt with observation as Str returning Int:
    if string_index_of(observation and "[RETAINED IMPLEMENTATION CANDIDATE") == 0:
        return 1
    if string_contains(observation and "\n[RETAINED IMPLEMENTATION CANDIDATE") == 1:
        return 1
    return 0

define react_frozen_decision_prompt_from_state with active_bytes as Str and plan_bytes as Str and original_request as Str and last_tool as Str and last_observation_input as Str returning Str:
    set action_class to react_frozen_action_class_for_decision(active_bytes and last_tool and last_observation_input)
    if string_length(action_class) == 0:
        return ""
    set last_observation to last_observation_input
    if string_length(last_observation) > 80000:
        set last_observation to concat(substring(last_observation and 0 and 79000) and "\n[Latest observation truncated at a source-page boundary; use codebase_read_range on the same planned production path for omitted bytes.]")
    set prompt to "[FROZEN TRANSACTION ACTION DECISION]\nThis is a fresh decision view rebuilt from durable state. Do not reconstruct or restate earlier exploratory reasoning.\n"
    set prompt to concat(prompt and concat("Original user objective:\n" and concat(original_request and "\n\n")))
    set prompt to concat(prompt and concat("Controller-selected legal action class:\n" and concat(action_class and "\n\n")))
    set prompt to concat(prompt and concat("Durable active transaction JSON:\n" and concat(active_bytes and "\n\n")))
    set prompt to concat(prompt and concat("Immutable implementation plan and progress:\n" and concat(plan_bytes and "\n\n")))
    set prompt to concat(prompt and concat("Latest authoritative tool: " and concat(last_tool and "\nLatest authoritative observation:\n")))
    set prompt to concat(prompt and concat(last_observation and "\n\n"))
    set prompt to concat(prompt and "Return exactly one provider-constrained object: {\"tool_name\":\"name\",\"arguments\":[...]}. No prose or extra keys. Candidate storage is private: always address reads and replacements through the original production path shown in planned_files. Compiler failure is repair evidence, never permission to abandon. Only an observation carrying code=PLAN_SCOPE_MISSING permits improvement_test_abandon. Natural-language output is legal only as the single string argument of reply_request after the workflow is genuinely complete.\n")
    return prompt

define react_repeated_candidate_read_error with ctx as Map and tool_name as Str returning Str:
    if tool_name equals "codebase_read" == 0 and also tool_name equals "codebase_read_range" == 0:
        return ""
    # This guard is legal only inside a controller-bound frozen transaction. Mutable
    # investigation pages can contain the receipt literals as ordinary source text;
    # they must never inherit a frozen candidate action class from those bytes.
    if map_contains(ctx and "improvement_test_frozen") == 0 or else map_get_val(ctx and "improvement_test_frozen") != 1:
        return ""
    if map_contains(ctx and "improvement_active_bound") == 0 or else map_get_val(ctx and "improvement_active_bound") != 1:
        return ""
    if map_contains(ctx and "frozen_latest_tool") == 0 or else map_contains(ctx and "frozen_latest_observation") == 0:
        return ""
    set previous_tool to ptr_to_str(map_get_val(ctx and "frozen_latest_tool"))
    set previous_observation to ptr_to_str(map_get_val(ctx and "frozen_latest_observation"))
    if (previous_tool equals "codebase_read" or else previous_tool equals "codebase_read_range") and also react_observation_has_candidate_receipt(previous_observation) == 1:
        return "IMPROVEMENT_GATE_FAILED code=CANDIDATE_REPLACE_REQUIRED message=The rejected candidate bytes are already active. The next legal action is a localized codebase_replace on the original planned production path using the exact compiler diagnostic; another read would make no progress."
    if (previous_tool equals "codebase_read" or else previous_tool equals "codebase_read_range") and also react_observation_has_reread_receipt(previous_observation) == 1:
        return "IMPROVEMENT_GATE_FAILED code=IMPLEMENTATION_WRITE_REQUIRED message=The exact planned production bytes are already active. codebase_write with the complete candidate is now the only legal transition; another read or reordered read arguments cannot make progress."
    return ""

define react_frozen_decision_prompt with ctx as Map returning Str:
    set frozen to 0
    if map_contains(ctx and "improvement_test_frozen") == 1:
        set frozen to map_get_val(ctx and "improvement_test_frozen")
    if frozen != 1:
        return ""
    if file_exists("config/improvements/active.json") == 0:
        return ""
    set original_request to ""
    if map_contains(ctx and "repair_original_request") == 1:
        set original_request to ptr_to_str(map_get_val(ctx and "repair_original_request"))
    set plan_bytes to ""
    if file_exists("config/improvements/staging/implementation_plan.md") == 1:
        set plan_bytes to read_file("config/improvements/staging/implementation_plan.md")
    set last_tool to "none"
    if map_contains(ctx and "frozen_latest_tool") == 1:
        set last_tool to ptr_to_str(map_get_val(ctx and "frozen_latest_tool"))
    set last_observation to "none"
    if map_contains(ctx and "frozen_latest_observation") == 1:
        set last_observation to ptr_to_str(map_get_val(ctx and "frozen_latest_observation"))
    # Candidate storage remains private. Resolve it from the registered production
    # path and place the exact current bytes in this one fresh decision view. This
    # preserves repair evidence without adding another read turn or extending history.
    set active_bytes to read_file("config/improvements/active.json")
    if string_contains(active_bytes and "\"status\": \"rejected\"") == 1 or else string_contains(active_bytes and "\"status\":\"rejected\"") == 1:
        set candidate_production_path to ""
        if map_contains(ctx and "last_codebase_path") == 1:
            set candidate_production_path to ptr_to_str(map_get_val(ctx and "last_codebase_path"))
        set candidate_storage_path to ""
        if string_length(candidate_production_path) > 0:
            set candidate_storage_path to tools_improvement_candidate_for_read(ctx and candidate_production_path)
        if string_length(candidate_storage_path) > 0 and also file_exists(candidate_storage_path) == 1 and also is_directory(candidate_storage_path) == 0:
            set retained_bytes to read_file(candidate_storage_path)
            if string_length(retained_bytes) > 80000:
                set retained_bytes to concat(substring(retained_bytes and 0 and 79000) and "\n[Retained candidate display truncated; use a same-production-path range read only if the diagnosed fragment is omitted.]\n")
            set last_observation to concat(last_observation and concat("\n\n[RETAINED IMPLEMENTATION CANDIDATE — internally resolved from the registered production path]\n" and retained_bytes))
    return react_frozen_decision_prompt_from_state(active_bytes and plan_bytes and original_request and last_tool and last_observation)


# Mutable improvement phases are just as stateful as frozen implementation. Rebuild
# every decision from the durable workflow instead of extending the exploratory ReAct
# transcript forever. This keeps the exact objective, plan, phase and latest
# authoritative observation while discarding stale rejected actions and old prose.
define react_staging_action_class with workflow_bytes as Str returning Str:
    set root to json_parse(workflow_bytes)
    if root == 0:
        return ""
    set state_node to get_json_object_value(root and "state")
    if state_node == 0:
        return ""
    set state to ptr_to_str(get_json_value(state_node))
    if state equals "investigating":
        set investigation_surface to ""
        set surface_node to get_json_object_value(root and "required_surface")
        if surface_node != 0:
            set investigation_surface to ptr_to_str(get_json_value(surface_node))
        if string_length(investigation_surface) > 0:
            return concat("INVESTIGATION: use only codebase_list, codebase_search, codebase_read, codebase_read_range, lookup_ernos, improvement_plan_write, or improvement_plan_scaffold. Select exact paths returned by discovery; do not guess or reconstruct filenames. Before planning, read at least two distinct non-test production files. When ready, improvement_plan_scaffold argument 1 MUST be exact required_surface `" and concat(investigation_surface and "`; arguments 2+ MUST be exact discovered production paths."))
        return "INVESTIGATION: use only codebase_list, codebase_search, codebase_read, codebase_read_range, lookup_ernos, improvement_plan_write, or improvement_plan_scaffold. Select exact paths returned by discovery; do not guess or reconstruct filenames. Before planning, read at least two distinct non-test production files."
    if state equals "planned":
        return "ACCEPTANCE_CONTRACT: improvement_test_begin is the only phase transition. Supply the exact planned surface name and 2-16 observable [criterion_id] outcome lines retaining every literal marker from the objective."
    if state equals "tests_authoring":
        set last_validation_node to get_json_object_value(root and "last_validation")
        if last_validation_node != 0 and also get_json_type(last_validation_node) == 4:
            set validation_status_node to get_json_object_value(last_validation_node and "status")
            if validation_status_node != 0 and also ptr_to_str(get_json_value(validation_status_node)) equals "failed":
                return "EVALUATOR_ARTIFACT_REWRITE: legal tool names are improvement_test_read, improvement_test_transport_template, improvement_test_write, improvement_test_scaffold, and improvement_test_validate. First inspect improvement_test_read([\"validation\"]). Then change the diagnosed evaluator bytes with improvement_test_write, or rerun improvement_test_scaffold([]) when the retained artifacts were controller-scaffolded. Never emit EVALUATOR_REPAIR as a tool name and never validate unchanged failed bytes."
        return "EVALUATOR_AUTHORING: use the controller-owned evaluator scaffold when artifacts are absent; otherwise validate the retained exact artifacts. Do not call improvement_test_begin again."
    if state equals "tests_validated":
        return "EVALUATOR_REVIEW: If the retained criteria and evaluators match the immutable objective, call improvement_test_freeze. If the user rejected freeze because the evidence is semantically wrong, repair the exact acceptance/regression/E2E artifacts with improvement_test_write and validate again; never repeat the rejected freeze unchanged."
    return ""


define react_staging_decision_prompt_from_state with workflow_bytes as Str and plan_bytes_input as Str and original_request as Str and last_tool as Str and last_observation_input as Str returning Str:
    set action_class to react_staging_action_class(workflow_bytes)
    if string_length(action_class) == 0:
        return ""
    set plan_bytes to plan_bytes_input
    if string_length(plan_bytes) > 24000:
        set plan_bytes to concat(substring(plan_bytes and 0 and 23000) and "\n[Plan display truncated; durable plan bytes remain authoritative.]\n")
    set last_observation to last_observation_input
    if string_length(last_observation) > 64000:
        set last_observation to concat(substring(last_observation and 0 and 63000) and "\n[Latest observation truncated at a source-page boundary; request the next exact range if required.]\n")
    set prompt to "[DURABLE IMPROVEMENT ACTION DECISION]\nThis is a fresh decision view rebuilt from durable transaction state. Do not repeat or reconstruct earlier exploratory reasoning.\n"
    set prompt to concat(prompt and concat("Original user request:\n" and concat(original_request and "\n\n")))
    set prompt to concat(prompt and concat("Controller-selected legal action class:\n" and concat(action_class and "\n\n")))
    set prompt to concat(prompt and concat("Durable workflow JSON:\n" and concat(workflow_bytes and "\n\n")))
    if string_length(plan_bytes) > 0:
        set prompt to concat(prompt and concat("Durable implementation plan and controller progress:\n" and concat(plan_bytes and "\n\n")))
    set prompt to concat(prompt and concat("Latest authoritative tool: " and concat(last_tool and "\nLatest authoritative observation:\n")))
    set prompt to concat(prompt and concat(last_observation and "\n\n"))
    set prompt to concat(prompt and "Return exactly one provider-constrained object: {\"tool_name\":\"name\",\"arguments\":[...]}. No prose or extra keys. Follow only the controller-selected action class. A rejected action is diagnostic evidence, never permission to restart, abandon, weaken tests, or repeat the same call. Natural-language output is legal only as the single string argument of reply_request after the durable workflow is genuinely complete.\n")
    return prompt


define react_ctx_has_elevated_role with ctx as Map returning Int:
    if map_contains(ctx and "sender_role") == 0:
        return 0
    set role to ptr_to_str(map_get_val(ctx and "sender_role"))
    if role equals "admin" or else role equals "owner":
        return 1
    return 0


define react_improvement_decision_prompt with ctx as Map returning Str:
    if map_contains(ctx and "repair_workflow_active") == 0 or else map_get_val(ctx and "repair_workflow_active") != 1:
        return ""
    if react_ctx_has_elevated_role(ctx) == 0:
        return ""
    if file_exists("config/improvements/active.json") == 1:
        return react_frozen_decision_prompt(ctx)
    if file_exists("config/improvements/staging/workflow.json") == 0:
        return ""
    set workflow_bytes to read_file("config/improvements/staging/workflow.json")
    set action_class to react_staging_action_class(workflow_bytes)
    if string_length(action_class) == 0:
        return ""
    set original_request to ""
    if map_contains(ctx and "repair_original_request") == 1:
        set original_request to ptr_to_str(map_get_val(ctx and "repair_original_request"))
    set plan_bytes to ""
    if file_exists("config/improvements/staging/implementation_plan.md") == 1:
        set plan_bytes to read_file("config/improvements/staging/implementation_plan.md")
    set last_tool to "none"
    if map_contains(ctx and "frozen_latest_tool") == 1:
        set last_tool to ptr_to_str(map_get_val(ctx and "frozen_latest_tool"))
    set last_observation to "none"
    if map_contains(ctx and "frozen_latest_observation") == 1:
        set last_observation to ptr_to_str(map_get_val(ctx and "frozen_latest_observation"))
    return react_staging_decision_prompt_from_state(workflow_bytes and plan_bytes and original_request and last_tool and last_observation)

# Dangerous-action and reply audits must see the same fresh durable decision view as
# the main model. Feeding the accumulated ReAct transcript here defeats compaction,
# evicts the useful KV prefix and turns a small action into a very large second call.
define react_audit_prompt_from_state with durable_input as Str and accumulated_prompt as Str and correction as Str returning Str:
    set durable to durable_input
    if string_length(durable) == 0:
        return accumulated_prompt
    if string_length(correction) > 0:
        set durable to concat(durable and concat("\n[LAST CONTROLLER REJECTION]\n" and concat(correction and "\n[/LAST CONTROLLER REJECTION]\n")))
    return durable

define react_audit_prompt_for_state with ctx as Map and accumulated_prompt as Str returning Str:
    set correction to ""
    if map_contains(ctx and "durable_protocol_correction") == 1:
        set correction to ptr_to_str(map_get_val(ctx and "durable_protocol_correction"))
    return react_audit_prompt_from_state(react_improvement_decision_prompt(ctx) and accumulated_prompt and correction)


define react_staging_forced_action_from_state with state as Str and regression_ready as Int and e2e_ready as Int and validation_status as Str returning Str:
    if state equals "tests_validated":
        return "Thought: The retained evaluators have a successful durable validation receipt and now require immutable freeze.\nAction: improvement_test_freeze([])"
    if state equals "tests_authoring":
        if regression_ready == 0 or else e2e_ready == 0:
            return "Thought: Evaluator artifacts are absent, so the controller will generate the exact plan-bound production evaluators.\nAction: improvement_test_scaffold([])"
        if string_length(validation_status) == 0:
            return "Thought: Both retained evaluator artifacts exist and have no validation receipt, so the controller will validate them against unchanged production now.\nAction: improvement_test_validate([])"
    return ""

define react_staging_force_rejected with last_tool as Str and last_observation as Str returning Int:
    if string_contains(last_observation and "IMPROVEMENT_GATE_FAILED") == 0 and also string_index_of(last_observation and "Error:") != 0:
        return 0
    if last_tool equals "improvement_plan_scaffold" or else last_tool equals "improvement_test_begin" or else last_tool equals "improvement_test_scaffold" or else last_tool equals "improvement_test_validate" or else last_tool equals "improvement_test_freeze":
        return 1
    return 0


# improvement_test_begin is fully derived from already-validated durable controller
# state. If that exact mechanical transition is rejected, another model generation
# cannot repair it and must never be allowed to alternate malformed variants forever.
define react_controller_transition_invariant_error with tool_name as Str and tool_result as Str returning Str:
    if tool_name equals "improvement_test_begin" == 0:
        return ""
    if string_contains(tool_result and "IMPROVEMENT_GATE_FAILED") == 0 and also string_index_of(tool_result and "Error:") != 0:
        return ""
    return concat("Error: Protected improvement controller invariant failed while beginning evaluator authoring. The validated planned transaction has been preserved unchanged for diagnosis. No retry or additional inference was run. Diagnostic: " and tool_result)

# Cross-component objectives have controller-known trust boundaries. Read each exact
# required source once, then generate the plan from those hash-recorded facts. Relevance
# selection is deterministic here; the model never spends turns guessing filenames or
# searching for a new surface that cannot exist before implementation.
define react_required_investigation_action_from_state with workflow_bytes as Str returning Str:
    set root to json_parse(workflow_bytes)
    if root == 0:
        return ""
    set state_node to get_json_object_value(root and "state")
    if state_node == 0 or else ptr_to_str(get_json_value(state_node)) equals "investigating" == 0:
        return ""
    set required_node to get_json_object_value(root and "required_discovery_paths")
    if required_node == 0 or else get_json_type(required_node) != 3:
        return ""
    set required_paths to get_json_value(required_node)
    set discovery_node to get_json_object_value(root and "discovery")
    set discovery_entries to create_list()
    if discovery_node != 0 and also get_json_type(discovery_node) == 3:
        set discovery_entries to get_json_value(discovery_node)
    set req_i to 0
    repeat while req_i < length_list(required_paths):
        set req_item to get_list(required_paths and req_i)
        set req_path to ptr_to_str(get_json_value(req_item))
        set found_read to 0
        set disc_i to 0
        repeat while disc_i < length_list(discovery_entries) and also found_read == 0:
            set disc_item to get_list(discovery_entries and disc_i)
            set disc_path_node to get_json_object_value(disc_item and "path")
            set disc_mode_node to get_json_object_value(disc_item and "mode")
            if disc_path_node != 0 and also disc_mode_node != 0:
                set disc_path to ptr_to_str(get_json_value(disc_path_node))
                set disc_mode to ptr_to_str(get_json_value(disc_mode_node))
                if disc_path equals req_path and also (disc_mode equals "read" or else disc_mode equals "read_range"):
                    set found_read to 1
            set disc_i to disc_i + 1
        if found_read == 0:
            if string_length(req_path) == 0 or else string_contains(req_path and "\"") == 1 or else string_contains(req_path and "\\") == 1:
                return ""
            return f"Thought: The controller selected the next unread production dependency from the immutable objective.\nAction: codebase_read([\"{req_path}\"])"
        set req_i to req_i + 1
    set surface_node to get_json_object_value(root and "required_surface")
    set production_node to get_json_object_value(root and "required_production_paths")
    if surface_node == 0 or else production_node == 0 or else get_json_type(production_node) != 3:
        return ""
    set surface to ptr_to_str(get_json_value(surface_node))
    set production_paths to get_json_value(production_node)
    if string_length(surface) == 0 or else length_list(production_paths) != 1:
        return ""
    set production_item to get_list(production_paths and 0)
    set production_path to ptr_to_str(get_json_value(production_item))
    if string_contains(surface and "\"") == 1 or else string_contains(production_path and "\"") == 1 or else string_contains(production_path and "\\") == 1:
        return ""
    return f"Thought: Every controller-required production dependency now has a current hash-recorded read, so the exact interface-evidence plan can be generated deterministically.\nAction: improvement_plan_scaffold([\"{surface}\",\"{production_path}\"])"

define react_required_acceptance_action_from_state with workflow_bytes as Str returning Str:
    set root to json_parse(workflow_bytes)
    if root == 0:
        return ""
    set state_node to get_json_object_value(root and "state")
    if state_node == 0 or else ptr_to_str(get_json_value(state_node)) equals "planned" == 0:
        return ""
    set surface_node to get_json_object_value(root and "required_surface")
    set acceptance_node to get_json_object_value(root and "required_acceptance")
    if surface_node == 0 or else acceptance_node == 0:
        return ""
    set surface to ptr_to_str(get_json_value(surface_node))
    set acceptance to ptr_to_str(get_json_value(acceptance_node))
    if string_length(surface) == 0 or else string_length(acceptance) == 0:
        return ""
    set surface_json to llm_json_escape(surface)
    set acceptance_json to llm_json_escape(acceptance)
    return concat("{\"tool_name\":\"improvement_test_begin\",\"arguments\":[\"" and concat(surface_json and concat("\",\"" and concat(acceptance_json and "\"]}") )))


# When durable staging state makes the next transition mechanical, execute that exact
# transition without spending another model decision. Semantic repair after a failed
# validation remains model-directed from the compact durable prompt.
define react_staging_forced_action with ctx as Map returning Str:
    # Forced actions are phase selection, not an authorization bypass. Only a run
    # already admitted to the protected repair workflow may receive one.
    if map_contains(ctx and "repair_workflow_active") == 0 or else map_get_val(ctx and "repair_workflow_active") != 1:
        return ""
    if react_ctx_has_elevated_role(ctx) == 0:
        return ""
    if file_exists("config/improvements/active.json") == 1 or else file_exists("config/improvements/staging/workflow.json") == 0:
        return ""
    if map_contains(ctx and "was_cancelled") == 1 and also map_get_val(ctx and "was_cancelled") == 1:
        return ""
    # A denied mechanical transition is a user decision, not a transient parser
    # failure. Yield exactly one fresh typed decision from durable state so Echo can
    # acknowledge a semantic objection and repair retained artifacts instead of
    # immediately presenting the identical approval card again.
    if map_contains(ctx and "last_denied_tool") == 1:
        set denied_transition to ptr_to_str(map_get_val(ctx and "last_denied_tool"))
        set ok to map_delete(ctx and "last_denied_tool")
        if denied_transition equals "improvement_test_freeze" or else denied_transition equals "system_verify" or else denied_transition equals "system_recompile":
            return ""
    # A mechanical transition that the gate just rejected must never be selected
    # again from unchanged state. Hand the structured diagnostic to one fresh typed
    # model decision so it can perform the requested source read/repair instead of
    # creating a zero-inference retry loop.
    if map_contains(ctx and "frozen_latest_tool") == 1 and also map_contains(ctx and "frozen_latest_observation") == 1:
        set staging_last_tool to ptr_to_str(map_get_val(ctx and "frozen_latest_tool"))
        set staging_last_observation to ptr_to_str(map_get_val(ctx and "frozen_latest_observation"))
        if react_staging_force_rejected(staging_last_tool and staging_last_observation) == 1:
            return ""
    if map_contains(ctx and "durable_protocol_correction") == 1:
        set durable_corr to ptr_to_str(map_get_val(ctx and "durable_protocol_correction"))
        if string_contains(durable_corr and "IMPROVEMENT_GATE_FAILED") == 1 or else string_index_of(durable_corr and "Error:") == 0:
            return ""
    set workflow_bytes to read_file("config/improvements/staging/workflow.json")
    set required_investigation_action to react_required_investigation_action_from_state(workflow_bytes)
    if string_length(required_investigation_action) > 0:
        return required_investigation_action
    set required_acceptance_action to react_required_acceptance_action_from_state(workflow_bytes)
    if string_length(required_acceptance_action) > 0:
        return required_acceptance_action
    set root to json_parse(workflow_bytes)
    if root == 0:
        return ""
    set state_node to get_json_object_value(root and "state")
    if state_node == 0:
        return ""
    set state to ptr_to_str(get_json_value(state_node))
    set regression_ready to 0
    set e2e_ready to 0
    set validation_status to ""
    if state equals "tests_authoring":
        if file_exists("config/improvements/staging/regression.py") == 1:
            if string_length(string_trim(read_file("config/improvements/staging/regression.py"))) > 0:
                set regression_ready to 1
        if file_exists("config/improvements/staging/e2e.py") == 1:
            if string_length(string_trim(read_file("config/improvements/staging/e2e.py"))) > 0:
                set e2e_ready to 1
        if file_exists("config/improvements/staging/validation.json") == 1:
            set validation_bytes to read_file("config/improvements/staging/validation.json")
            if string_contains(validation_bytes and "\"status\": \"passed\"") == 1 or else string_contains(validation_bytes and "\"status\":\"passed\"") == 1:
                set validation_status to "passed"
            else if string_contains(validation_bytes and "\"status\": \"failed\"") == 1 or else string_contains(validation_bytes and "\"status\":\"failed\"") == 1:
                set validation_status to "failed"
            else:
                set validation_status to "unknown"
    return react_staging_forced_action_from_state(state and regression_ready and e2e_ready and validation_status)


define react_run_loop with model as Map and memory_mgr as Map and tools_mgr as Map and ctx as Map and current_prompt as Str and start_loop_idx as Int and values_list as List and auto_approve_flag as Int returning Str:
    set loop_idx to start_loop_idx
    set final_answer to ""
    set finished to 0
    set reply_blocks to 0
    set override_output to ""
    # SAFETY: capture the cancel epoch at RUN start. Any Stop after this point (from any
    # surface, for any session) makes ep_cancel_epoch_get exceed this and halts the run
    # at its next boundary — while in-flight LLM reads abort within ~1s on their own.
    set run_epoch to ep_cancel_epoch_get(0)
    
    # Check if we are running under automated test suite
    set is_test to 0
    if map_contains(ctx and "is_test") == 1:
        set is_test to map_get_val(ctx and "is_test")
    
    # Check if a model is loaded. If model has no vocab (empty map), run simulation mode.
    set use_simulation to 1
    if map_contains(model and "vocab") == 1:
        set vocab_node to map_get_val(model and "vocab")
        if length_list(vocab_node) > 0:
            set use_simulation to 0

    # Long-running work must not be converted into a false terminal failure merely
    # because it crosses an arbitrary number of model decisions. Keep the historical
    # ctx key for compatibility, but use it only as a checkpoint interval. At each
    # boundary the same prompt, observations and durable transaction continue.
    set max_iters to 50
    if map_contains(ctx and "max_iterations") == 1:
        set ov to map_get_val(ctx and "max_iterations")
        if ov > 0:
            set max_iters to ov
    repeat while finished == 0:
        # F4: cancellation checkpoint — halt cleanly between turns (before spending
        # another inference). An in-flight LLM call cannot be interrupted here; that
        # is phase 2 (abortable socket). 'continue' re-checks the while condition,
        # which is now false, so the loop exits.
        set f4_sess to ""
        if map_contains(ctx and "session_id") == 1:
            set f4_sess to map_get_val(ctx and "session_id")
        set ok to tools_set_active_session(f4_sess)
        if react_check_cancel(f4_sess and run_epoch) == 1:
            display "[ReAct] Run halted by user (cancel)."
            set ok to map_insert(ctx and "was_cancelled" and 1)
            set final_answer to "Run halted at your request."
            set finished to 1
            continue
        display f"--- ReAct Loop Turn {loop_idx + 1} ---"
        display f"Prompt character length: {string_length(current_prompt)}"
        set trace_db to storage_get_db()
        set trace_sid to ""
        if map_contains(ctx and "session_id") == 1:
            set trace_sid to map_get_val(ctx and "session_id")
        
        set query_prompt to current_prompt
        set durable_prompt to react_improvement_decision_prompt(ctx)
        if string_length(durable_prompt) > 0:
            set query_prompt to durable_prompt
            if map_contains(ctx and "durable_protocol_correction") == 1:
                set query_prompt to concat(query_prompt and concat("\n[LAST CONTROLLER REJECTION]\n" and concat(ptr_to_str(map_get_val(ctx and "durable_protocol_correction")) and "\n[/LAST CONTROLLER REJECTION]\n")))
            set ok to trace_emit(trace_db and trace_sid and "durable_prompt_rebuild" and f"durable_chars={string_length(durable_prompt)} accumulated_chars_bypassed={string_length(current_prompt)}")
        # Whisper checkpoint — drain any mid-turn user guidance before the LLM call.
        set trace_turn_id to ""
        if map_contains(ctx and "turn_id") == 1:
            set trace_turn_id to map_get_val(ctx and "turn_id")
        set whispers to react_drain_whispers(trace_sid and trace_turn_id)
        if string_length(whispers) > 0:
            display f"[ReAct] Received mid-turn whisper(s) from user."
            set ok to trace_emit(trace_db and trace_sid and "whisper_received" and whispers)
            set query_prompt to concat(query_prompt and f"\n[MID-TURN USER GUIDANCE — the user has sent additional direction while you are processing. This is NOT a new request — it is live guidance for your CURRENT task. Read it carefully and adjust your approach. You may acknowledge it with mid_message but do NOT end your turn with reply_request unless the user explicitly tells you to stop.]\n{whispers}[/MID-TURN USER GUIDANCE]\n")

        # Sub-agent completion checkpoint — pull any of THIS session's finished
        # background sub-agents and inject their results, labelled distinctly from
        # the user whispers above (these are agent outputs, not user input).
        set sub_orch to 0
        if map_contains(ctx and "orchestrator") == 1:
            set sub_orch to map_get_val(ctx and "orchestrator")
        if sub_orch != 0:
            set sub_done to orchestrator_drain_completed(sub_orch and trace_sid)
            if string_length(sub_done) > 0:
                display f"[ReAct] Incorporating completed sub-agent result(s) mid-turn."
                set ok to trace_emit(trace_db and trace_sid and "subagent_result" and sub_done)
                set query_prompt to concat(query_prompt and concat("\n[SUB-AGENT RESULTS — background agents you dispatched have finished. The following are THEIR outputs (not user input). Use them and report to the user as appropriate.]\n" and concat(sub_done and "[/SUB-AGENT RESULTS]\n")))

        # Controller-owned deployment transition. This is inserted before inference
        # and still traverses normal parsing, approval, Observer audit and execution.
        if string_length(override_output) == 0:
            set forced_improvement_confirmation to react_improvement_confirmation_forced_action(ctx)
            if string_length(forced_improvement_confirmation) > 0:
                set override_output to forced_improvement_confirmation
                display "[ReAct] Explicit self-improvement confirmation selected by controller; no inference call."
        if string_length(override_output) == 0:
            set forced_pending_investigation to react_pending_investigation_forced_action(ctx)
            if string_length(forced_pending_investigation) > 0:
                set override_output to forced_pending_investigation
                display "[ReAct] Retained typed improvement objective selected after green baseline; no inference call."
        if string_length(override_output) == 0:
            set forced_initial_baseline to react_initial_repair_baseline_forced_action(ctx)
            if string_length(forced_initial_baseline) > 0:
                set override_output to forced_initial_baseline
                display "[ReAct] Protected initial source baseline selected by controller; no inference call."
        if string_length(override_output) == 0:
            set forced_plan_reinvestigation to react_missing_plan_evidence_forced_action(ctx)
            if string_length(forced_plan_reinvestigation) > 0:
                set override_output to forced_plan_reinvestigation
                display "[ReAct] Legacy frozen plan lacks exact interface evidence; preserved re-investigation selected by controller."
        if string_length(override_output) == 0:
            set forced_candidate_reset to react_incomplete_candidate_reset_forced_action(ctx)
            if string_length(forced_candidate_reset) > 0:
                set override_output to forced_candidate_reset
                display "[ReAct] Structurally incomplete candidate selected for provenance-preserving reset; no inference call."
        if string_length(override_output) == 0:
            set forced_initial_frozen_read to react_initial_frozen_read_forced_action(ctx)
            if string_length(forced_initial_frozen_read) > 0:
                set override_output to forced_initial_frozen_read
                display "[ReAct] Exact planned production bytes selected before first candidate; no inference call."
        if string_length(override_output) == 0:
            set forced_post_write_verify to react_post_write_verify_forced_action(ctx)
            if string_length(forced_post_write_verify) > 0:
                set override_output to forced_post_write_verify
                display "[ReAct] Complete planned implementation selected for mandatory verification; no inference call."
        if string_length(override_output) == 0:
            set forced_verified_deploy to react_verified_deploy_forced_action(ctx)
            if string_length(forced_verified_deploy) > 0:
                set override_output to forced_verified_deploy
                display "[ReAct] Verified deployment transition selected by controller; no inference call."
        if string_length(override_output) == 0:
            set forced_staging_action to react_staging_forced_action(ctx)
            if string_length(forced_staging_action) > 0:
                set override_output to forced_staging_action
                display "[ReAct] Durable staging transition selected by controller; no inference call."

        set raw_output to ""
        set typed_model_output to 0
        # A batched turn re-uses a queued action from THIS response (override_output) with no
        # new inference. It must NOT count against max_iters, which guards LLM ROUND-TRIPS, not
        # tool executions — otherwise a legitimate 20-tool batch could trip the runaway cap.
        set is_batched_turn to 0
        if string_length(override_output) > 0:
            set raw_output to override_output
            set override_output to ""
            set is_batched_turn to 1
            display f"[ReAct] Batched action — running queued tool from the same response, no new inference call."
        else:
            set ok to map_delete(ctx and "subagent_turn_auto_approve")
            if is_test == 0:
                set typed_model_output to 1
                set selected_model to ""
                if map_contains(ctx and "selected_model") == 1:
                    set selected_model to map_get_val(ctx and "selected_model")
                set ok to trace_emit(trace_db and trace_sid and "thinking" and f"Querying {selected_model}...")
                set turn_image_path to ""
                if map_contains(ctx and "image_path") == 1:
                    set turn_image_path to map_get_val(ctx and "image_path")
                if string_length(turn_image_path) > 0:
                    display f"[ReAct] Native vision input: {turn_image_path}"
                    set raw_output to query_local_llm_image(query_prompt and turn_image_path and selected_model)
                else:
                    set raw_output to query_local_llm(query_prompt and selected_model)

                # HIVE-compatible recovery lives at the action controller, where the
                # authoritative Observation and repair phase are visible. Each recovery
                # is a fresh ReAct decision, never a hidden retry of the same request.
                if raw_output equals llm_repetition_abort_marker():
                    set spiral_recoveries to 0
                    if map_contains(ctx and "thought_spiral_recoveries") == 1:
                        set spiral_recoveries to map_get_val(ctx and "thought_spiral_recoveries")
                    set spiral_recoveries to spiral_recoveries + 1
                    set ok to map_insert(ctx and "thought_spiral_recoveries" and spiral_recoveries)
                    set ok to trace_emit(trace_db and trace_sid and "thought_spiral_recovery" and int_to_string(spiral_recoveries))
                    if spiral_recoveries <= 2:
                        set current_prompt to concat(current_prompt and concat("\n" and react_thought_spiral_recovery_guidance(ctx)))
                        set loop_idx to loop_idx + 1
                        continue
                    # A retry count is a checkpoint, never a reason to abandon an
                    # unfinished improvement. Frozen work has a deterministic safe
                    # transition: refresh the exact planned path (hash-gated by the
                    # controller), then let the next decision author the correction.
                    set checkpoint_action to react_repetition_checkpoint_action(ctx)
                    set ok to map_insert(ctx and "thought_spiral_recoveries" and 0)
                    if string_length(checkpoint_action) > 0:
                        if string_contains(checkpoint_action and "Action: improvement_candidate_reset([])") == 1:
                            display "[ReAct] Repeated reasoning checkpoint reached; preserving and resetting rejected candidate."
                            set ok to trace_emit(trace_db and trace_sid and "thought_spiral_checkpoint" and "Preserved rejected candidate and reopened frozen implementation; transaction remains active")
                        else:
                            display "[ReAct] Repeated reasoning checkpoint reached; forcing exact frozen-plan reread and continuing."
                            set ok to trace_emit(trace_db and trace_sid and "thought_spiral_checkpoint" and "Forced exact frozen-plan reread; transaction remains active")
                        set override_output to checkpoint_action
                    else:
                        display "[ReAct] Repeated reasoning checkpoint reached; continuing with stricter action guidance."
                        set ok to trace_emit(trace_db and trace_sid and "thought_spiral_checkpoint" and "No deterministic planned path; transaction remains active")
                        set current_prompt to concat(current_prompt and "\n[REPEATED-REASONING CHECKPOINT — INVISIBLE TO USER] This is not a terminal condition and the unfinished task remains active. Emit one concrete next Action only. Do not restate prior reasoning.\n")
                    set loop_idx to loop_idx + 1
                    continue
                
            if string_length(raw_output) == 0:
                if is_test == 1:
                    set raw_output to react_simulate_inference(query_prompt and loop_idx)
                else if use_simulation == 0:
                    set raw_output to inference_run(model and query_prompt and 0 and 200)
                else if ep_cancel_epoch_get(0) > run_epoch:
                    # The empty response came from a Stop-aborted read, not a dead
                    # server — report the halt, not a fake model failure.
                    display "[ReAct] Run halted by user (Stop aborted the in-flight inference)."
                    set ok to map_insert(ctx and "was_cancelled" and 1)
                    set final_answer to "Run halted at your request."
                    set finished to 1
                else:
                    # No LLM available — tell user instead of faking it with hardcoded heuristics
                    display "[ReAct] No LLM response and no local model loaded. Returning error."
                    set final_answer to "Error: No LLM model responded. Please check that your selected model is running in Ollama or LM Studio."
                    set finished to 1
            
        display f"LLM raw response:\n{raw_output}\n----------------"
        set ok to trace_emit(trace_db and trace_sid and "raw_output" and raw_output)
        set ok to append_list(values_list and raw_output)

        # F1: capture this turn's native reasoning (<think>...</think>) as its own
        # channel and strip it from raw_output so it never confuses action parsing or
        # leaks. Preserve it (timeline + ctx) for transparency and the look-back.
        set reason_split to react_extract_reasoning(raw_output)
        set turn_reasoning to map_get_val(reason_split and "reasoning")
        if string_length(turn_reasoning) > 0:
            set raw_output to map_get_val(reason_split and "clean")
            set ok to map_insert(ctx and "last_reasoning" and turn_reasoning)
            set ok to memory_store(memory_mgr and 3 and "REASONING" and turn_reasoning)
            display f"[reasoning] {turn_reasoning}"
            set ok to trace_emit(trace_db and trace_sid and "reasoning" and turn_reasoning)
        # reason_split is NOT freed here: turn_reasoning was extracted from it and
        # inserted into ctx["last_reasoning"]. Freeing the map would invalidate the
        # aliased string — use-after-free → SIGSEGV. Tracked in values_list for GC.
        set ok to append_list(values_list and reason_split)

        # Strengthen synapses based on generated thought
        set ok to react_hebbian_trigger(memory_mgr and raw_output)

        # F5: self-accountability look-back. Review this turn's own output against
        # ErnOS's values via LLM inference; on drift, log it to the timeline and
        # inject a private nudge. Fail-open: clean output does nothing.
        # LATENCY + VALUE: run the look-back ONLY on mid_message turns. reply_request text is
        # already judged by the reply audit (below) against a SUPERSET of these checks, and a
        # pure tool-call turn (search/read/store/run_command) has NO user-facing text to drift
        # on — its reasoning surfaces in a later reply, which IS audited. Firing a full LLM
        # look-back on every intermediate tool step cost ~11–31s each for zero added coverage
        # (measured: one multi-step request spent ~97s in look-back calls, ALL failing
        # "Audit unavailable"). mid_message is the single user-facing output that gets NO reply
        # audit, so it is the only turn where the look-back adds real coverage.
        if string_contains(raw_output and "mid_message") == 1:
            set lookback to observer_lookback(current_prompt and raw_output)
            if map_get_val(lookback and "drift") == 1:
                set lb_note to map_get_val(lookback and "note")
                display f"[Observer look-back] self-correction: {lb_note}"
                set ok to trace_emit(trace_db and trace_sid and "lookback" and lb_note)
                set ok to memory_store(memory_mgr and 3 and "SELF-CHECK" and lb_note)
                set current_prompt to concat(current_prompt and f"\n[SELF-CHECK — INVISIBLE TO USER] Your previous output drifted from your operating values ({lb_note}). Correct course now: speak as ErnOS in the first person, never use pre-trained-assistant disclaimers or claim to be another company's model, and state things plainly. Do not mention this note to the user.\n")
            free_map(lookback)

        set action_map to 0
        # Controller-owned deterministic transitions may also use the exact typed
        # envelope. Route those through the same one-pass parser as provider output;
        # otherwise valid controller JSON is misclassified as final prose and the
        # model is asked to reconstruct arguments the controller already owns.
        set raw_clean_for_protocol to string_trim(raw_output)
        if typed_model_output == 1 or else string_index_of(raw_clean_for_protocol and "{\"tool_name\"") == 0:
            set action_map to react_parse_action_envelope(raw_output)
        else:
            set action_map to react_parse_action(raw_output)
        set found_action to map_get_val(action_map and "found")
        set implicit_reply to 0
        if typed_model_output == 0 and also found_action == 0 and also react_is_implicit_reply(raw_output) == 1:
            # The model already wrote the answer; only its transport wrapper is missing.
            # Route the text through the normal reply tool, formatter, Observer and
            # continuity capture without another model call.
            set implicit_reply to 1
            set found_action to 1
            set ok to map_insert(action_map and "found" and 1)
            set ok to map_insert(action_map and "tool_name" and "reply_request")
            set ok to map_insert(action_map and "args_str" and raw_output)
            set ok to map_insert(action_map and "start_pos" and 0)
            set ok to map_insert(action_map and "end_pos" and string_length(raw_output))
            display "[ReAct] Recovered complete plain-text output as an implicit reply_request."
            set ok to trace_emit(trace_db and trace_sid and "implicit_reply" and "Recovered plain-text final answer without an inference retry")
        
        if found_action == 1:
            # Root terminal-contract invariant: never discard native final prose merely
            # because a later Action marker exists. Mixed output is rejected before any
            # tool executes; the model must choose a tool turn OR a final-prose turn.
            if typed_model_output == 0 and also implicit_reply == 0 and also react_action_turn_is_valid(raw_output and map_get_val(action_map and "start_pos") and map_get_val(action_map and "end_pos")) == 0:
                display "[ReAct] Mixed final prose and Action output rejected; no content or tool was executed."
                set ok to trace_emit(trace_db and trace_sid and "no_action" and "Mixed final prose and Action output rejected")
                set current_prompt to concat(current_prompt and "\n[PROTOCOL CORRECTION — INVISIBLE TO USER]\nYour previous response mixed user-facing prose with an Action call. Nothing from it was delivered or executed. Choose exactly one response type: if the task is complete, output the complete answer again as plain final prose with no Thought, Action, JSON, or reply_request wrapper; if a tool is still needed, output only one short Thought line followed by Action lines.\n")
                free_map(action_map)
                if is_batched_turn == 0:
                    set loop_idx to loop_idx + 1
                continue
            set ok to react_note_valid_action(ctx)
            set tool_name to map_get_val(action_map and "tool_name")
            set args_str to map_get_val(action_map and "args_str")
            # BATCHING: if the model emitted MORE than one Action: in this single response,
            # queue everything from the 2nd action onward to run on the next loop iterations
            # with NO new inference call. This collapses N independent tool calls from N LLM
            # round-trips (each 20–80s) into ONE. Every queued action still passes through the
            # full approval/audit/observation path below. Pause/finish paths (approval,
            # clarification, reply_request) drop the queue; the model re-emits any remaining
            # steps after the pause, which is self-healing. `assistant_text` records ONLY this
            # action in the transcript when more follow, so chained iterations don't restate the
            # whole remainder each time.
            set batch_rest to ""
            if typed_model_output == 0:
                set batch_rest to react_slice_from_next_action(raw_output and map_get_val(action_map and "end_pos"))
            set assistant_text to raw_output
            # P10: detect orphaned `tool([...])` continuations in the segment the slicer
            # DROPS — between this action's end and the next Action: marker (or the end of
            # the response). If any registered tool appears there without its Action:
            # prefix, a format note (appended after this action's Observation) names it so
            # the model re-emits it properly instead of believing it ran.
            set orphan_nudge to ""
            set a_end to map_get_val(action_map and "end_pos")
            set tail_len to string_length(raw_output) - a_end
            if tail_len > 0:
                set dropped_len to tail_len - string_length(batch_rest)
                if dropped_len > 0:
                    set dropped_seg to substring(raw_output and a_end and dropped_len)
                    set orphan_names to react_find_orphan_calls(dropped_seg and map_get_val(tools_mgr and "schemas"))
                    if string_length(orphan_names) > 0:
                        display f"[ReAct] Orphaned tool calls dropped by the batch slicer: {orphan_names}"
                        set ok to trace_emit(trace_db and trace_sid and "no_action" and f"Orphaned calls not executed: {orphan_names}")
                        set orphan_nudge to f"[FORMAT NOTE — INVISIBLE TO USER] Your response ALSO contained tool call(s) WITHOUT the 'Action:' prefix, which were NOT executed: {orphan_names}. A bare name([...]) in prose does not run. Re-emit each as its own 'Action: <name>([...])' line.\n"
            if string_length(batch_rest) > 0:
                set override_output to batch_rest
                # Record the transcript from the start (keeps any Thought:) THROUGH this action,
                # dropping only the trailing actions that haven't run yet — they get recorded as
                # each one executes on its own chained iteration.
                set assistant_text to substring(raw_output and 0 and a_end)
            display f"Parsed action: '{tool_name}' with args: '{args_str}'"
            set ok to trace_emit(trace_db and trace_sid and "action" and f"{tool_name}({args_str})")
            set ok to append_list(values_list and action_map)

            # Accept the local model's stable split-positional dialect, but normalize
            # it into the registered one-array contract before json_parse can accept a
            # valid prefix and discard the trailing expressions. Ambiguous/invalid
            # split syntax fails closed and is re-prompted with the canonical shape.
            set normalization_error to ""
            set split_default_close to react_split_default_expression_close(args_str)
            if split_default_close >= 0:
                set raw_split_args to args_str
                set normalized_split_args to react_normalize_split_default_expression(args_str)
                if string_length(normalized_split_args) == 0:
                    set normalization_error to concat("Invalid split-argument tool expression rejected before execution: " and concat(raw_split_args and ". Put every argument inside one JSON array, following the registered tool example."))
                else:
                    set args_str to normalized_split_args
                    set ok to trace_emit(trace_db and trace_sid and "tool_normalization" and concat(tool_name and concat(" raw=" and concat(raw_split_args and concat(" canonical=" and normalized_split_args)))))
            
            # Parse arguments as JSON array or fallback to raw string
            set args_list to create_list()
            set json_node to 0
            if implicit_reply == 1:
                set ok to append_list(args_list and raw_output)
            else:
                set json_node to json_parse(args_str)
            if implicit_reply == 0 and also json_node != 0:
                set j_type to get_json_type(json_node)
                if j_type == 3: # List
                    set parsed_items to get_json_value(json_node)
                    set items_len to length_list(parsed_items)
                    set item_i to 0
                    repeat while item_i < items_len:
                        set json_item to get_list(parsed_items and item_i)
                        # JSON type 1 is an Integer — get_json_value returns a raw int,
                        # not a string. Tool handlers (and the truncation guard below,
                        # which calls string_length on args[0]) expect STRINGS, so coerce
                        # numeric args to their string form. Without this, any tool called
                        # with a single numeric arg (e.g. get_lesson([1])) crashes.
                        if get_json_type(json_item) == 1:
                            set val to int_to_string(get_json_value(json_item))
                        else:
                            set val to get_json_value(json_item)
                        set ok to append_list(args_list and val)
                        set item_i to item_i + 1
                    # Truncation guard: if JSON parsed a single string that is
                    # drastically shorter than the raw args, the LLM likely
                    # emitted unescaped inner quotes. Fall back to raw extraction.
                    if items_len == 1:
                        set parsed_len to string_length(get_list(args_list and 0))
                        set raw_len to string_length(args_str)
                        if parsed_len < raw_len / 2:
                            display f"[react] JSON truncation detected ({parsed_len} vs {raw_len} chars). Using raw extraction."
                            set ok to set_list(args_list and 0 and react_extract_raw_arg(args_str))
                    # Models frequently wrap a long Python source argument in
                    # triple quotes. Although invalid JSON, the boundaries are
                    # deterministic. Recover it here before the tool sees a NULL
                    # second value; its normal artifact linter remains authoritative.
                    if items_len == 2:
                        set triple_payload to react_extract_triple_quoted_second_arg(args_str)
                        if string_length(triple_payload) > 0:
                            display f"[react] Recovered triple-quoted multiline argument ({string_length(triple_payload)} chars)."
                            set ok to set_list(args_list and 1 and triple_payload)
                else:
                    if get_json_type(json_node) == 1:
                        set ok to append_list(args_list and int_to_string(get_json_value(json_node)))
                    else:
                        set ok to append_list(args_list and get_json_value(json_node))
            else if implicit_reply == 0:
                set ok to append_list(args_list and args_str)

            if length_list(args_list) == 1 and also string_length(string_trim(ptr_to_str(get_list(args_list and 0)))) == 0:
                set registered_schemas to map_get_val(tools_mgr and "schemas")
                if react_schema_declares_zero_args(tool_name and registered_schemas) == 1:
                    set ok to remove_list(args_list and 0)
                    set args_str to "[]"
                    set ok to trace_emit(trace_db and trace_sid and "tool_normalization" and concat(tool_name and " raw=[empty-string] canonical=[]"))

            # Gemma's stable recovery form sometimes emits codebase_replace with
            # [production_path, complete_candidate] instead of repeating two large,
            # nearly identical old/new strings. Canonicalize that provider expression
            # internally to the registered exact-replacement contract by resolving the
            # hidden retained candidate from the production path. Authorization,
            # approval, Observer audit, compile checks and promotion are unchanged.
            if tool_name equals "codebase_replace" and also length_list(args_list) == 2:
                set complete_candidate to ptr_to_str(get_list(args_list and 1))
                if string_length(complete_candidate) >= 200 and also string_contains(complete_candidate and "define ") == 1:
                    set complete_path to tools_improvement_canonical_production_path(ptr_to_str(get_list(args_list and 0)))
                    set complete_actual to tools_resolve_read_path_for_ctx(ctx and complete_path)
                    set complete_source to complete_actual
                    if string_length(complete_actual) > 0:
                        set complete_retained to tools_improvement_candidate_for_read(ctx and complete_actual)
                        if string_length(complete_retained) > 0:
                            set complete_source to complete_retained
                    if string_length(complete_source) == 0 or else file_exists(complete_source) == 0:
                        set normalization_error to "IMPROVEMENT_GATE_FAILED code=CANDIDATE_REPAIR_REQUIRED message=complete-candidate replacement could not resolve the transaction-bound retained source from the production path."
                    else:
                        set complete_old to read_file(complete_source)
                        # Lists own only their pointer slots; clone every borrowed
                        # decoded/path value before replacing the sole reference to
                        # the provider-decoded list.
                        set complete_path_copy to concat("" and complete_path)
                        set complete_old_copy to concat("" and complete_old)
                        set complete_candidate_copy to concat("" and complete_candidate)
                        # Mutate the decoded list in place so its allocation remains
                        # the owner through validation, approval and execution.
                        set ok to set_list(args_list and 0 and complete_path_copy)
                        set ok to set_list(args_list and 1 and complete_old_copy)
                        set ok to append_list(args_list and complete_candidate_copy)
                        # Parsed JSON numbers are represented as strings in args_list;
                        # preserve that invariant for controller-synthesized arguments.
                        # Supplying the raw integer here made ptr_to_str(1) dereference
                        # address 0x1 in react_validate_tool_args.
                        set ok to append_list(args_list and "1")
                        set args_str to "[production_path,transaction_bound_retained_bytes,complete_candidate,1]"
                        set ok to trace_emit(trace_db and trace_sid and "tool_normalization" and "codebase_replace complete-candidate envelope canonicalized to exact transaction-bound replacement")

            # Retain the exact path from source operations so a frozen improvement can
            # recover deterministically from a later repeated-reasoning checkpoint.
            # This records no new authority and never bypasses the planned-path gate.
            if (tool_name equals "codebase_read" or else tool_name equals "codebase_read_range" or else tool_name equals "codebase_write" or else tool_name equals "codebase_replace") and also length_list(args_list) > 0:
                set ok to map_insert(ctx and "last_codebase_path" and ptr_to_str(get_list(args_list and 0)))

            # Do this after JSON decoding (where the corruption is introduced) and
            # before observer, memory, tool execution, persistence or platform delivery.
            if tool_name equals "reply_request" and also length_list(args_list) > 0:
                set reply_arg to get_list(args_list and 0)
                set ok to set_list(args_list and 0 and reply_format_normalize(reply_arg))

            # Reject malformed calls before approval. Feed the exact rejected layout and
            # canonical shape back as an Observation, then re-infer; nothing is audited,
            # approved, persisted, or executed on this path.
            set tool_arg_error to normalization_error
            if string_length(tool_arg_error) == 0:
                set tool_arg_error to react_validate_tool_args(tool_name and args_list and args_str)
            if string_length(tool_arg_error) > 0:
                display f"[ReAct] Tool call rejected before approval: {tool_arg_error}"
                set ok to trace_emit(trace_db and trace_sid and "tool_validation" and tool_arg_error)
                set invalid_fingerprint to concat(tool_name and concat(":" and args_str))
                set invalid_repeats to 1
                if map_contains(ctx and "last_invalid_tool_call") == 1:
                    if ptr_to_str(map_get_val(ctx and "last_invalid_tool_call")) equals invalid_fingerprint:
                        if map_contains(ctx and "invalid_tool_call_repeats") == 1:
                            set invalid_repeats to map_get_val(ctx and "invalid_tool_call_repeats") + 1
                set ok to map_insert(ctx and "last_invalid_tool_call" and invalid_fingerprint)
                set ok to map_insert(ctx and "invalid_tool_call_repeats" and invalid_repeats)
                set ok to map_insert(ctx and "durable_protocol_correction" and tool_arg_error)
                set ok to map_insert(ctx and "frozen_latest_tool" and tool_name)
                set ok to map_insert(ctx and "frozen_latest_observation" and tool_arg_error)
                if string_contains(tool_arg_error and "code=NO_CHANGE") == 1 and also invalid_repeats > 1:
                    set no_change_correction to "IMPROVEMENT_GATE_FAILED code=NO_CHANGE_REPEAT message=The identical byte-no-op replacement has repeated. Do not reuse either fragment. Repair the earliest compiler diagnostic with a genuinely different exact_new. ErnosPlain uses 'or else' for boolean disjunction, binary concat(left and right) nesting, and int_to_string for integers; source code must not contain a trailing JSON transport bracket. Rebuild this decision only from the retained candidate, exact diagnostic, and frozen working-call-site evidence."
                    set ok to map_insert(ctx and "durable_protocol_correction" and no_change_correction)
                set durable_error_prompt to react_improvement_decision_prompt(ctx)
                if string_length(durable_error_prompt) == 0:
                    set current_prompt to concat(current_prompt and "\n")
                    set current_prompt to concat(current_prompt and assistant_text)
                    set current_prompt to concat(current_prompt and "\nObservation: [TOOL CALL REJECTED BEFORE APPROVAL — nothing was executed] ")
                    set current_prompt to concat(current_prompt and tool_arg_error)
                    if invalid_repeats > 1:
                        set current_prompt to concat(current_prompt and concat(" This identical malformed call has now been rejected " and concat(int_to_string(invalid_repeats) and " times. Copy the canonical Action shape from this Observation; do not improvise another positional layout.")))
                    set current_prompt to concat(current_prompt and "\n")
                else:
                    set ok to trace_emit(trace_db and trace_sid and "durable_prompt_bounded" and "Malformed-call correction retained in durable state without extending accumulated prompt")
                # Do not execute later actions composed under the malformed call's
                # assumption; regenerate the batch from the corrective Observation.
                set override_output to ""
                free_list(args_list)
                if is_batched_turn == 0:
                    set loop_idx to loop_idx + 1
                continue

            set ok to map_delete(ctx and "durable_protocol_correction")

            # Repair sequencing is a controller invariant, not model guidance. Reject
            # divergent calls before approval/audit/execution and regenerate from the
            # precise corrective Observation.
            set repair_action_error to react_repeated_candidate_read_error(ctx and tool_name)
            if string_length(repair_action_error) == 0:
                set repair_action_error to tools_repair_action_error(ctx and tool_name)
            if string_length(repair_action_error) > 0:
                display f"[ReAct] Repair workflow call rejected before approval: {repair_action_error}"
                set ok to trace_emit(trace_db and trace_sid and "repair_gate" and repair_action_error)
                # Retain repeated-gate provenance, but never convert it into a terminal
                # reply. A deterministic controller transition below must continue any
                # state whose next action is mechanically knowable.
                set repair_gate_fingerprint to concat(tool_name and concat(":" and repair_action_error))
                set repair_gate_repeats to 1
                if map_contains(ctx and "last_repair_gate_call") == 1:
                    if ptr_to_str(map_get_val(ctx and "last_repair_gate_call")) equals repair_gate_fingerprint:
                        if map_contains(ctx and "repair_gate_call_repeats") == 1:
                            set repair_gate_repeats to map_get_val(ctx and "repair_gate_call_repeats") + 1
                set ok to map_insert(ctx and "last_repair_gate_call" and repair_gate_fingerprint)
                set ok to map_insert(ctx and "repair_gate_call_repeats" and repair_gate_repeats)
                set ok to map_insert(ctx and "durable_protocol_correction" and repair_action_error)
                set ok to map_insert(ctx and "frozen_latest_tool" and tool_name)
                set ok to map_insert(ctx and "frozen_latest_observation" and repair_action_error)
                set durable_repair_prompt to react_improvement_decision_prompt(ctx)
                if string_length(durable_repair_prompt) == 0:
                    set current_prompt to concat(current_prompt and "\n")
                    set current_prompt to concat(current_prompt and assistant_text)
                    set current_prompt to concat(current_prompt and "\nObservation: [REPAIR WORKFLOW GATE — nothing was executed] ")
                    set current_prompt to concat(current_prompt and repair_action_error)
                    set current_prompt to concat(current_prompt and "\n")
                else:
                    set ok to trace_emit(trace_db and trace_sid and "durable_prompt_bounded" and "Repair-gate correction retained in durable state without extending accumulated prompt")
                set override_output to react_repair_gate_forced_action(repair_action_error)
                free_list(args_list)
                if is_batched_turn == 0:
                    set loop_idx to loop_idx + 1
                continue
                
            set action_allowed to 1
            set action_reason to ""

            # --- F3: Clarification request (pause + ask the user) ---
            # Mirrors the approval pause/resume rail. Bounded to 3 rounds; once the
            # budget is spent (or the user said "work with what we have"), further
            # requests are refused with a nudge to proceed instead of pausing.
            if tool_name equals "request_clarification":
                set clarify_rounds to 0
                if map_contains(ctx and "clarify_rounds") == 1:
                    set clarify_rounds to map_get_val(ctx and "clarify_rounds")
                set clarify_done to 0
                if map_contains(ctx and "clarify_done") == 1:
                    set clarify_done to map_get_val(ctx and "clarify_done")
                if clarify_rounds >= 3 or else clarify_done == 1:
                    set current_prompt to concat(current_prompt and "\n")
                    set current_prompt to concat(current_prompt and raw_output)
                    set current_prompt to concat(current_prompt and "\nObservation: You have used your clarification budget. Proceed now with your best understanding; do not ask the user again.\n")
                    free_list(args_list)
                    if is_batched_turn == 0:
                        set loop_idx to loop_idx + 1
                    continue
                set ok to map_insert(ctx and "clarify_rounds" and clarify_rounds + 1)
                set pendingc to create_map()
                set ok to map_insert(pendingc and "questions" and args_str)
                set ok to map_insert(pendingc and "prompt_state" and current_prompt)
                set ok to map_insert(pendingc and "raw_output" and raw_output)
                set ok to map_insert(pendingc and "loop_idx" and loop_idx)
                set pendc_role to ""
                if map_contains(ctx and "sender_role") == 1:
                    set pendc_role to map_get_val(ctx and "sender_role")
                set ok to map_insert(pendingc and "sender_role" and pendc_role)
                set ok to map_insert(ctx and "pending_clarification" and pendingc)
                free_list(args_list)
                free_list(values_list)
                set ok to tools_set_active_session("")
                return "PENDING_CLARIFICATION"

            # --- Mid-message response (does NOT end the turn) ---
            # Allows the agent to send a visible message to the user while continuing
            # its current task. Used to acknowledge whispers, give progress updates,
            # or respond to mid-turn guidance without stopping work.
            if tool_name equals "mid_message":
                set mid_content to react_extract_raw_arg(args_str)
                set mid_sess to ""
                if map_contains(ctx and "session_id") == 1:
                    set mid_sess to map_get_val(ctx and "session_id")
                set ok to react_write_mid_message(mid_sess and mid_content)
                display f"[ReAct] Mid-message sent to user: {substring(mid_content and 0 and 100)}"
                # Note: react_write_mid_message already writes to trace_events; do NOT also
                # trace_emit here (duplicate row). A SECOND action batched in the same response
                # is handled by the general batching queue (override_output set above) — no
                # mid_message-specific detection needed. If more actions follow, the next
                # iteration runs them with no new inference call.
                set current_prompt to concat(current_prompt and "\n")
                set current_prompt to concat(current_prompt and assistant_text)
                set current_prompt to concat(current_prompt and "\nObservation: Mid-message delivered to the user. Continue your current task.\n")
                if string_length(orphan_nudge) > 0:
                    set current_prompt to concat(current_prompt and orphan_nudge)
                free_list(args_list)
                if is_batched_turn == 0:
                    set loop_idx to loop_idx + 1
                continue

            # --- Tool Approval Gate ---
            set needs_approval to tools_requires_approval(tool_name and args_list)
            if needs_approval == 1:
                set has_approval to 0
                if map_contains(ctx and "tool_approved") == 1:
                    set has_approval to map_get_val(ctx and "tool_approved")
                
                # Check request-scoped auto_approve. The threaded auto_approve_flag is the
                # reliable source (it survives across tool executions); the ctx read is kept
                # as a secondary path but is unreliable when ctx is a borrow view — that was
                # the "Approve all approves the first then denies the rest" bug.
                set auto_approve_val to 0
                if map_contains(ctx and "auto_approve") == 1:
                    set auto_approve_val to map_get_val(ctx and "auto_approve")
                if auto_approve_flag == 1:
                    set auto_approve_val to 1
                if auto_approve_val == 0:
                    if map_contains(ctx and "subagent_turn_auto_approve") == 1:
                        if map_get_val(ctx and "subagent_turn_auto_approve") == 1:
                            set auto_approve_val to 1
                # P4: persistent per-session auto-approve toggle (AI AUTOAPPROVE ON via
                # Discord button//autoapprove/WebUI). Session-scoped and in-memory only —
                # a node restart resets to OFF. Checked alongside the request-scoped
                # flag; observer audits still run on every gated tool.
                if auto_approve_val == 0:
                    if map_contains(ctx and "session_auto_approve") == 1:
                        set sess_aa_map to map_get_val(ctx and "session_auto_approve")
                        if map_contains(sess_aa_map and f4_sess) == 1:
                            set auto_approve_val to 1
                if auto_approve_val == 1:
                    set has_approval to 1
                
                if has_approval == 0:
                    # If the user hit Stop while this turn was running, do NOT surface an
                    # approval prompt for a run they are killing — halt now. The top-of-loop
                    # cancel check cannot catch a Stop that arrives mid-turn (after that check
                    # but before we pause here); this closes that window so Stop always wins
                    # over a pending approval dialog.
                    set cxl_sess to ""
                    if map_contains(ctx and "session_id") == 1:
                        set cxl_sess to map_get_val(ctx and "session_id")
                    if react_check_cancel(cxl_sess and run_epoch) == 1:
                        display "[ReAct] Run halted by user (cancel) instead of pausing for approval."
                        set ok to map_insert(ctx and "was_cancelled" and 1)
                        free_list(args_list)
                        free_list(values_list)
                        set ok to tools_set_active_session("")
                        return "Run halted at your request."
                    set denials to 0
                    if map_contains(ctx and "consecutive_denials") == 1:
                        set denials to map_get_val(ctx and "consecutive_denials")
                    
                    if denials >= 2:
                        display f"Auto-denying tool '{tool_name}' because consecutive denials >= 2"
                        set action_allowed to 0
                        set action_reason to "Tool execution blocked because user has denied tool execution twice in a row."
                    else:
                        # Build a summary of what the tool wants to do
                        set approval_summary to concat(tool_name and "(")
                        set approval_summary to concat(approval_summary and args_str)
                        set approval_summary to concat(approval_summary and ")")
                        # Access-gate warning on the card (sensitive path / destructive cmd).
                        set acc_warn to access_warning(tool_name and args_str)
                        if string_length(acc_warn) > 0:
                            set approval_summary to concat(approval_summary and concat("  ⚠️ WARNING: " and acc_warn))

                        display f"Tool '{tool_name}' requires user approval. Pausing for confirmation."
                        set ok to trace_emit(trace_db and trace_sid and "approval" and f"Waiting for approval: {tool_name}({args_str})")
                        
                        # Store pending action state in context for the IPC layer to pick up
                        set pending to create_map()
                        set ok to map_insert(pending and "tool_name" and tool_name)
                        set ok to map_insert(pending and "args_str" and args_str)
                        set ok to map_insert(pending and "summary" and approval_summary)
                        set ok to map_insert(pending and "prompt_state" and current_prompt)
                        set ok to map_insert(pending and "raw_output" and raw_output)
                        set ok to map_insert(pending and "loop_idx" and loop_idx)
                        # Bind the caller's role to this pending action. The IPC layer
                        # deletes sender_role from ctx after the initiating turn, so the
                        # approval (a separate IPC round) would otherwise execute the tool
                        # with no role and fail the admin gate -> "restricted to
                        # administrators" on every approved tool since approve-all landed.
                        set pend_role to ""
                        if map_contains(ctx and "sender_role") == 1:
                            set pend_role to map_get_val(ctx and "sender_role")
                        set ok to map_insert(pending and "sender_role" and pend_role)
                        set ok to map_insert(ctx and "pending_action" and pending)
                        
                        # Store the parsed args list for later execution
                        set pending_args to create_list()
                        set pa_idx to 0
                        set a_len to length_list(args_list)
                        repeat while pa_idx < a_len:
                            set pa_val to get_list(args_list and pa_idx)
                            set ok to append_list(pending_args and pa_val)
                            set pa_idx to pa_idx + 1
                        set ok to map_insert(pending and "args_list" and pending_args)
                        
                        # SUB-AGENT APPROVAL FORWARDING: if this is a sub-agent (has
                        # parent_session_id), we cannot return PENDING_APPROVAL because
                        # nobody polls sub-agent ctx. Instead: insert a pending approval
                        # row into trace_approvals, emit a trace event to the parent
                        # session (so Discord/WebUI show the approval card), then poll
                        # with tools_sleep_yield until the IPC handler writes a decision.
                        # tools_sleep_yield yields the cooperative event loop so other
                        # async tasks (parent agent, sibling sub-agents) keep running.
                        if map_contains(ctx and "parent_session_id") == 1:
                            set sa_parent_sid to map_get_val(ctx and "parent_session_id")
                            set sa_task_id to trace_sid
                            set sa_db to storage_get_db()
                            # Insert pending approval row
                            set sa_tn_esc to string_replace(tool_name and "'" and "''")
                            set sa_as_esc to string_replace(args_str and "'" and "''")
                            set sa_sm_esc to string_replace(approval_summary and "'" and "''")
                            set sa_sid_esc to string_replace(sa_task_id and "'" and "''")
                            set sa_now to ep_time_now_sec()
                            set ok to sql_execute(sa_db and f"INSERT INTO trace_approvals (session_id, tool_name, args_str, summary, decision, created_at) VALUES ('{sa_sid_esc}', '{sa_tn_esc}', '{sa_as_esc}', '{sa_sm_esc}', NULL, {sa_now});")
                            # Notify parent session via trace event
                            set sa_desc to concat("Sub-agent " and concat(sa_task_id and concat(" requests permission to call " and concat(tool_name and concat("(" and concat(args_str and ")"))))))
                            set sa_desc_esc to string_replace(sa_desc and "\"" and "'")
                            set sa_tn_esc2 to string_replace(tool_name and "\"" and "'")
                            set sa_as_esc2 to string_replace(args_str and "\"" and "'")
                            set ok to trace_emit(sa_db and sa_parent_sid and "subagent_approval" and concat("{\"task_id\":\"" and concat(sa_task_id and concat("\",\"tool\":\"" and concat(sa_tn_esc2 and concat("\",\"args\":\"" and concat(sa_as_esc2 and concat("\",\"description\":\"" and concat(sa_desc_esc and "\"}")))))))))
                            display f"[APPROVAL] Sub-agent {sa_task_id} waiting for approval of {tool_name} — polling trace_approvals"
                            # Poll for decision — yield the event loop each second
                            set sa_decision to ""
                            set sa_poll_count to 0
                            repeat while string_length(sa_decision) == 0 and also sa_poll_count < 3600:
                                # Check for cancellation
                                if react_check_cancel(trace_sid and run_epoch) == 1:
                                    set ok to sql_execute(sa_db and f"DELETE FROM trace_approvals WHERE session_id='{sa_sid_esc}' AND decision IS NULL;")
                                    free_list(args_list)
                                    free_list(values_list)
                                    set ok to tools_set_active_session("")
                                    return "Run halted at your request."
                                set ok to tools_sleep_yield(1000)
                                set sa_poll_count to sa_poll_count + 1
                                # Query for a decision
                                set sa_rows to sql_query(sa_db and f"SELECT decision FROM trace_approvals WHERE session_id='{sa_sid_esc}' AND decision IS NOT NULL ORDER BY id DESC LIMIT 1;")
                                if length_list(sa_rows) > 0:
                                    set sa_row to get_list(sa_rows and 0)
                                    set sa_decision to get_list(sa_row and 0)
                            # Clean up the approval row
                            set ok to sql_execute(sa_db and f"DELETE FROM trace_approvals WHERE session_id='{sa_sid_esc}';")
                            if sa_decision equals "yes":
                                display f"[APPROVAL] Sub-agent {sa_task_id} APPROVED for {tool_name} — executing"
                                set action_allowed to 1
                                set ok to map_insert(ctx and "consecutive_denials" and 0)
                                set ok to map_insert(ctx and "subagent_turn_auto_approve" and 1)
                                # Fall through to tool execution below (action_allowed=1)
                            else:
                                display f"[APPROVAL] Sub-agent {sa_task_id} DENIED for {tool_name}"
                                set action_allowed to 0
                                set ok to map_insert(ctx and "consecutive_denials" and 0)
                                if sa_decision equals "no":
                                    set action_reason to f"Permission denied by operator for {tool_name}."
                                else:
                                    set action_reason to f"Approval timed out for {tool_name} after 1 hour."
                                free_list(args_list)
                                free_list(values_list)
                                # Continue the ReAct loop with the denial as observation
                                set observation to action_reason
                                # Skip tool execution, go to next iteration
                                set ok to tools_set_active_session("")
                                set current_prompt to concat(current_prompt and concat("\nObservation: " and observation))
                                set loop_idx to loop_idx + 1
                                if loop_idx >= max_iters:
                                    set ok to trace_emit(trace_db and trace_sid and "iteration_checkpoint" and f"Continuing unfinished work after {max_iters} model decisions")
                                    set current_prompt to concat(current_prompt and "\n[LONG-RUN CHECKPOINT — INVISIBLE TO USER]\nThe current task is unfinished. Continue from the exact accumulated prompt and tool observations. Do not report completion, stop, roll back, or ask the user to retry merely because this checkpoint was reached. Continue investigating, implementing, repairing and verifying until the requested outcome is genuinely complete or a real cancellation, permission decision, moderation boundary, or unrecoverable error requires a truthful terminal response.\n[/LONG-RUN CHECKPOINT]\n")
                                    set loop_idx to 0
                                continue
                        else:
                            free_list(args_list)
                            free_list(values_list)
                            set ok to tools_set_active_session("")
                            return "PENDING_APPROVAL"
                else:
                    # Approval was granted — clear the flag and proceed
                    set ok to map_insert(ctx and "tool_approved" and 0)
            
            # --- Observer Security Audit (for dangerous commands) ---
            # E4: turing_grid_op(execute) runs a grid cell as a shell command — treat it
            # as a shell-exec sink and audit it like run_command (it's also admin-only
            # via tools_is_action_allowed).
            set is_grid_exec to 0
            if tool_name equals "turing_grid_op":
                if length_list(args_list) >= 1:
                    if get_list(args_list and 0) equals "execute":
                        set is_grid_exec to 1
            if tool_name equals "run_command" or else tool_name equals "codebase_write" or else tool_name equals "codebase_replace" or else tool_name equals "improvement_test_freeze" or else tool_name equals "improvement_test_abandon" or else tool_name equals "system_recompile" or else tool_name equals "self_prompt_set" or else tool_name equals "persona_set" or else tool_name equals "persona_register" or else is_grid_exec == 1:
                set audit_payload to ""
                if tool_name equals "run_command":
                    if length_list(args_list) >= 1:
                        set cmd_arg to get_list(args_list and 0)
                        set audit_payload to concat("run_command: " and cmd_arg)
                else if is_grid_exec == 1:
                    set audit_payload to "turing_grid_op execute: runs a Turing-grid cell as a shell command"
                else if tool_name equals "self_prompt_set":
                    # F6: the agent rewriting its own behavior/skills is a powerful act — audit it.
                    if length_list(args_list) >= 1:
                        set sec_arg to get_list(args_list and 0)
                        set audit_payload to concat("self_prompt_set: agent is rewriting its own prompt section " and sec_arg)
                else if tool_name equals "system_recompile":
                    set audit_payload to "system_recompile: build, test, and transactionally replace Echo's running cognitive executable with authenticated health validation and exact rollback"
                else if tool_name equals "improvement_test_freeze":
                    set audit_payload to "improvement_test_freeze: hash-lock the retained, prevalidated causal regression and live E2E artifacts before implementation"
                else if tool_name equals "improvement_test_abandon":
                    if length_list(args_list) >= 1:
                        set audit_payload to concat("improvement_test_abandon before implementation: " and get_list(args_list and 0))
                else if tool_name equals "persona_set" or else tool_name equals "persona_register":
                    # P9: swapping/registering the agent's IDENTITY is as powerful as a
                    # self-prompt rewrite — audited by the same rule.
                    if length_list(args_list) >= 1:
                        set pa_arg to get_list(args_list and 0)
                        set audit_payload to concat(tool_name and concat(": agent persona operation on '" and concat(pa_arg and "'")))
                else:
                    if length_list(args_list) >= 1:
                        set path_arg to get_list(args_list and 0)
                        set audit_payload to concat(tool_name and concat(": " and path_arg))
                
                if string_length(audit_payload) > 0:
                    set audit_map to observer_audit(ctx and query_prompt and audit_payload)
                    set verdict to map_get_val(audit_map and "verdict")
                    set audit_record_reason to map_get_val(audit_map and "reason")
                    set ok to map_insert(ctx and "last_observer_verdict" and verdict)
                    set ok to map_insert(ctx and "last_observer_reason" and audit_record_reason)
                    if verdict equals "BLOCKED":
                        # If the human already approved this action (via the approval gate
                        # or auto_approve), the observer's BLOCKED verdict is advisory only.
                        # The human is the authority — the observer cannot overrule explicit
                        # human approval. The concern is still logged for transparency.
                        if needs_approval == 1:
                            set block_reason to map_get_val(audit_map and "reason")
                            display f"Observer audit: BLOCKED (overridden by human approval). Reason: {block_reason}"
                            set ok to trace_emit(trace_db and trace_sid and "audit" and f"Observer: BLOCKED (human-approved, advisory only) — {block_reason}")
                        else:
                            set action_allowed to 0
                            set action_reason to map_get_val(audit_map and "reason")
                    free_map(audit_map)
                    
            set tool_result to ""
            if action_allowed == 0:
                display f"Observer action audit: BLOCKED. Reason: {action_reason}"
                set ok to trace_emit(trace_db and trace_sid and "audit" and f"Observer: BLOCKED — {action_reason}")
                set tool_result to concat("BLOCKED by Observer: " and action_reason)
            else:
                set ok to trace_emit(trace_db and trace_sid and "audit" and "Observer: ALLOWED")
                display f"Executing tool: {tool_name}..."
                set ok to trace_emit(trace_db and trace_sid and "tool_exec" and f"Executing: {tool_name}")
                # KV-CACHE: expose this turn's prompt to tools that run their own LLM audit
                # (moderation_tool). An audit sent with a bare/stub context is a DIFFERENT
                # prefix on the same model slot — it evicts the main prompt's KV cache and
                # the next main call re-prefills the whole prompt from zero (~turn-1 TTFT).
                # With the real prompt as system context the audit shares the prefix.
                set ok to map_insert(ctx and "current_prompt" and query_prompt)
                # Artifact provenance records the actual tool that created/shared the
                # bytes. This is per-turn context, so concurrent sessions cannot race.
                set ok to map_insert(ctx and "current_action_name" and tool_name)
                set tool_result to tools_execute(tools_mgr and ctx and tool_name and args_list)
                display f"Tool result: {tool_result}"
                set ok to trace_emit(trace_db and trace_sid and "tool_result" and tool_result)
                set ok to map_insert(ctx and "frozen_latest_tool" and tool_name)
                set ok to map_insert(ctx and "frozen_latest_observation" and tool_result)
                set controller_invariant_error to react_controller_transition_invariant_error(tool_name and tool_result)
                if string_length(controller_invariant_error) > 0:
                    set ok to trace_emit(trace_db and trace_sid and "controller_invariant_failure" and controller_invariant_error)
                    set final_answer to controller_invariant_error
                    set finished to 1
                    set override_output to ""
                set candidate_post_result_action to react_candidate_post_result_forced_action(ctx and tool_result)
                if string_length(candidate_post_result_action) > 0:
                    display "[ReAct] Structured candidate failure selected an immediate provenance-preserving reset."
                    set ok to trace_emit(trace_db and trace_sid and "candidate_reset" and "Structured post-tool failure selected deterministic candidate reset")
                    set override_output to candidate_post_result_action

            # Candidate syntax/addressing failures are repair transitions, never scope
            # failures. Refresh the retained bytes through their production alias before
            # any further inference so the exact compiler evidence cannot be lost.
            set candidate_repair_action to react_candidate_repair_action(ctx and tool_result)
            if string_length(candidate_repair_action) > 0:
                display "[ReAct] Candidate repair required; forcing canonical production-path reread."
                set ok to trace_emit(trace_db and trace_sid and "candidate_repair" and "Canonical production-path reread selected")
                set override_output to candidate_repair_action

            # A rejected pre-write operation can prove that the frozen plan omitted
            # a required architectural dependency. Supersede any stale batched action
            # with the one legal recovery transition instead of asking the model to
            # rediscover that conclusion until its context repeats.
            set scope_replan_action to react_frozen_scope_replan_action(ctx and tool_result)
            if string_length(scope_replan_action) > 0:
                display "[ReAct] Frozen plan omitted a required production path; forcing preserved abandonment and re-investigation."
                set ok to trace_emit(trace_db and trace_sid and "frozen_scope_replan" and "Controller-proven missing production dependency before first accepted write")
                set override_output to scope_replan_action
                
            set ok to append_list(values_list and tool_result)
            
            # Store event in Tier 3 Timeline
            set ok to memory_store(memory_mgr and 3 and f"Action: {tool_name}" and f"Result: {tool_result}")
            
            # Some successful tools are terminal by contract. Image generation already
            # schedules attachment delivery; session termination has closed the current
            # lifecycle. Neither may be fed back as an Observation or followed by another
            # inference, audit, action, or reply from the terminated foreground turn.
            if react_tool_result_finishes_turn(tool_name and action_allowed and tool_result) == 1:
                display f"[ReAct] Terminal tool '{tool_name}' completed; ending request without another inference."
                set ok to trace_emit(trace_db and trace_sid and "done" and concat("Terminal tool completed: " and tool_name))
                set final_answer to tool_result
                set finished to 1
                set override_output to ""
            else if tool_name equals "reply_request":
                # Single inference-only audit — all LLM, no hardcoded checks
                set ok to map_insert(ctx and "observer_capture_continuity" and 1)
                set audit_map to observer_audit(ctx and query_prompt and tool_result)
                set ok to map_delete(ctx and "observer_capture_continuity")
                set verdict to map_get_val(audit_map and "verdict")
                set audit_reason to map_get_val(audit_map and "reason")
                set audit_parsed to map_get_val(audit_map and "parsed")
                set audit_continuity to map_get_val(audit_map and "continuity_json")
                free_map(audit_map)
                
                # Reply audits fail closed too. Invalid/empty observer output is useful
                # corrective feedback, not permission to publish an unaudited response.
                # This also prevents the exact bug where reasoning prose containing the
                # word ALLOWED was mistaken for a valid audit verdict.
                if audit_parsed == 0:
                    # Regenerating Echo's candidate cannot repair an unavailable or
                    # malformed Observer. The old loop regenerated three candidates
                    # and retried two endpoints for each, turning one failed audit into
                    # an apparent hang before publishing unaudited text.
                    display "Observer reply audit unavailable. Withholding unaudited reply without regenerating it."
                    set ok to trace_emit(trace_db and trace_sid and "reply_audit" and "Reply audit unavailable; reply withheld without regeneration")
                    set final_answer to "Observer audit failed, so Echo's reply was withheld rather than published unaudited. Please retry this message; the failure has been logged."
                    set finished to 1
                else if verdict equals "ALLOWED":
                    if string_length(audit_continuity) > 0:
                        set ok to map_insert(ctx and "continuity_json" and audit_continuity)
                    display "Observer reply audit: ALLOWED. Final response ready."
                    set ok to trace_emit(trace_db and trace_sid and "reply_audit" and "Reply audit: ALLOWED")
                    set reply_blocks to 0
                    set final_answer to tool_result
                    set finished to 1
                else:
                    set reply_blocks to reply_blocks + 1
                    set ok to trace_emit(trace_db and trace_sid and "reply_audit" and f"Reply audit: BLOCKED — {audit_reason} ({reply_blocks}/3)")
                    if reply_blocks >= 3:
                        display f"Observer reply audit: BLOCKED {reply_blocks} consecutive times. Withholding the rejected draft."
                        set final_answer to "Echo's reply was withheld after three Observer rejections. The reasons were logged; please restate or narrow the request."
                        set finished to 1
                    else:
                        display f"Observer reply audit: BLOCKED. Reason: {audit_reason}. Re-prompting ({reply_blocks}/3)..."
                        # Concise correction — do NOT append the full raw_output (which
                        # added ~700+ chars per blocked turn, inflating the prompt from
                        # 16KB to 43KB over 28 turns and causing the SIGSEGV).
                        set current_prompt to concat(current_prompt and "\n[SELF-CHECK FAIL: INVISIBLE TO USER] Your previous reply was blocked (")
                        set current_prompt to concat(current_prompt and audit_reason)
                        set current_prompt to concat(current_prompt and "). Produce a corrected reply now.\n")
            else:
                # Standard tool observation back to prompt — fit it to the model's
                # remaining context window (derived, never a fixed cap).
                set durable_observation_prompt to react_improvement_decision_prompt(ctx)
                if string_length(durable_observation_prompt) == 0:
                    set obs_model to ""
                    if map_contains(ctx and "selected_model") == 1:
                        set obs_model to map_get_val(ctx and "selected_model")
                    # Align the budget with the model the LLM call ACTUALLY uses. When no
                    # model is selected, query_local_llm falls back to gemma4:26b — so the
                    # budget must use that too, otherwise it'd size for the unknown-model
                    # default (8192) and clamp tool output to 2048 chars, truncating file
                    # reads even though the real model window is large.
                    if string_length(obs_model) == 0:
                        set obs_model to "gemma4:26b"
                    set obs_budget to react_observation_budget(obs_model and string_length(current_prompt))
                    set current_prompt to concat(current_prompt and "\n")
                    set observation_action_text to react_observation_action_text(tool_name and assistant_text)
                    set current_prompt to concat(current_prompt and observation_action_text)
                    # Guard: empty tool results cause the LLM to continuation-complete the
                    # Observation line instead of starting a new Thought/Action block.
                    set obs_text to tool_result
                    if string_length(string_trim(tool_result)) == 0:
                        set obs_text to "[empty result — the tool returned no output]"
                    set current_prompt to concat(current_prompt and "\nObservation: ")
                    set current_prompt to concat(current_prompt and react_fit_observation(obs_text and obs_budget))
                    set current_prompt to concat(current_prompt and "\n")
                    if string_contains(tool_result and "code=CANDIDATE_REPAIR_REQUIRED") == 1:
                        set current_prompt to concat(current_prompt and "[CANDIDATE REPAIR — INVISIBLE TO USER] The live source is unchanged and the failed candidate remains available through codebase_read on the original production path. Do not regenerate the file or repeat codebase_write. Read the retained candidate, apply a localized codebase_replace for the exact compiler diagnostic, and continue until the candidate compiles.\n")
                    if string_length(orphan_nudge) > 0:
                        set current_prompt to concat(current_prompt and orphan_nudge)
                else:
                    set ok to trace_emit(trace_db and trace_sid and "durable_prompt_bounded" and "Latest tool and observation retained in durable decision state without extending accumulated prompt")

                set denials to 0
                if map_contains(ctx and "consecutive_denials") == 1:
                    set denials to map_get_val(ctx and "consecutive_denials")
                if denials >= 2:
                    set current_prompt to concat(current_prompt and "\n[SYSTEM: The user has denied tool execution twice in a row. Return your final answer now as plain user-facing prose based on the information you have. Do not use any tool or protocol wrapper.]\n")
            # Free args_list AFTER all tool_result consumers (memory_store, observer_audit,
            # observation injection) are done. tool_result may alias args_list elements
            # via get_list — freeing earlier is use-after-free.
            free_list(args_list)
        else:
            display "No valid action parsed. Re-prompting for correct Action grammar..."
            set ok to trace_emit(trace_db and trace_sid and "no_action" and "No valid action parsed, re-prompting")
            set no_action_streak to 1
            if map_contains(ctx and "consecutive_no_action") == 1:
                set no_action_streak to map_get_val(ctx and "consecutive_no_action") + 1
            set ok to map_insert(ctx and "consecutive_no_action" and no_action_streak)
            # Enforce Turn Boundary Rejection — tell the model EXACTLY what it did wrong
            # and what it must do. Common cause: the LLM continuation-completed an empty
            # Observation instead of starting a new Thought/Action block.
            set ok to map_insert(ctx and "durable_protocol_correction" and "IMPROVEMENT_GATE_FAILED code=TOOL_ENVELOPE_INVALID message=Return exactly one two-key object with tool_name and arguments. Do not emit reasoning or prose in an unfinished durable transaction.")
            set durable_no_action_prompt to react_improvement_decision_prompt(ctx)
            if string_length(durable_no_action_prompt) == 0:
                set current_prompt to concat(current_prompt and "\n")
                set current_prompt to concat(current_prompt and "[FORMAT CORRECTION — INVISIBLE TO USER]\nThe provider response did not decode as the required two-key action envelope. Do not revisit or summarize it. Return exactly {\"tool_name\":\"registered_tool\",\"arguments\":[...]}; use reply_request with one natural-language string argument only when the task is complete.\n")
            else:
                set ok to trace_emit(trace_db and trace_sid and "durable_prompt_bounded" and "Envelope correction retained in durable state without extending accumulated prompt")
            set frozen_action_nudge to react_frozen_implementation_action_nudge(ctx and no_action_streak)
            if string_length(frozen_action_nudge) > 0:
                if string_length(durable_no_action_prompt) == 0:
                    set current_prompt to concat(current_prompt and frozen_action_nudge)
                set forced_frozen_reread to react_frozen_planned_reread_action(ctx)
                if string_length(forced_frozen_reread) > 0:
                    set override_output to forced_frozen_reread
                    set ok to trace_emit(trace_db and trace_sid and "typed_action_recovery" and "Malformed/reasoning-only decision replaced by canonical frozen-plan reread")

        # Batched actions (queued from a single response) do NOT count against the
        # fresh-decision checkpoint interval;
        # only a turn that made a fresh inference call advances loop_idx.
        if is_batched_turn == 0:
            set loop_idx to loop_idx + 1
            if loop_idx >= max_iters:
                set ok to trace_emit(trace_db and trace_sid and "iteration_checkpoint" and f"Continuing unfinished work after {max_iters} model decisions")
                set durable_checkpoint_prompt to react_improvement_decision_prompt(ctx)
                if string_length(durable_checkpoint_prompt) == 0:
                    set current_prompt to concat(current_prompt and "\n[LONG-RUN CHECKPOINT — INVISIBLE TO USER]\nThe current task is unfinished. Continue from the exact accumulated prompt and tool observations. Do not report completion, stop, roll back, or ask the user to retry merely because this checkpoint was reached. Continue investigating, implementing, repairing and verifying until the requested outcome is genuinely complete or a real cancellation, permission decision, moderation boundary, or unrecoverable error requires a truthful terminal response.\n[/LONG-RUN CHECKPOINT]\n")
                set loop_idx to 0
    free_list(values_list)
    set ok to tools_set_active_session("")
    return reply_format_normalize(final_answer)


define react_resume_approved with model as Map and memory_mgr as Map and tools_mgr as Map and ctx as Map and approved as Int and auto_approve_flag as Int returning Str:
    # Resume execution after a tool approval/denial decision
    set pending to map_get_val(ctx and "pending_action")
    if pending == 0:
        return "Error: No pending action to resume."
    
    set tool_name to map_get_val(pending and "tool_name")
    set args_list to map_get_val(pending and "args_list")
    set current_prompt to map_get_val(pending and "prompt_state")
    set raw_output to map_get_val(pending and "raw_output")
    set trace_db to storage_get_db()
    set trace_sid to ""
    if map_contains(ctx and "session_id") == 1:
        set trace_sid to map_get_val(ctx and "session_id")
    
    set loop_idx to 0
    if map_contains(pending and "loop_idx") == 1:
        set loop_idx to map_get_val(pending and "loop_idx")

    # Restore the role captured when this action was queued, so the approved tool
    # runs with the original caller's authority (admin/owner) instead of the empty
    # role the IPC layer left behind. Without this, every approved admin tool is
    # denied. Must happen before pending is cleared below.
    set saved_role to ""
    if map_contains(pending and "sender_role") == 1:
        set saved_role to map_get_val(pending and "sender_role")
    set ok to map_insert(ctx and "sender_role" and saved_role)

    # Clear the pending action
    set ok to map_delete(ctx and "pending_action")
    
    set denials to 0
    if map_contains(ctx and "consecutive_denials") == 1:
        set denials to map_get_val(ctx and "consecutive_denials")

    if approved == 1:
        set denials to 0
        set ok to map_delete(ctx and "last_denied_tool")
    else:
        set denials to denials + 1
        set ok to map_insert(ctx and "last_denied_tool" and tool_name)
    set ok to map_insert(ctx and "consecutive_denials" and denials)

    set tool_result to ""
    if approved == 1:
        display f"User APPROVED tool: {tool_name}. Executing..."
        
        # Run observer security audit for dangerous commands before executing
        set action_allowed to 1
        if tool_name equals "run_command" or else tool_name equals "codebase_write" or else tool_name equals "codebase_replace" or else tool_name equals "improvement_test_freeze" or else tool_name equals "improvement_test_abandon" or else tool_name equals "system_recompile" or else tool_name equals "self_prompt_set":
            set audit_payload to ""
            if tool_name equals "run_command":
                if length_list(args_list) >= 1:
                    set cmd_arg to get_list(args_list and 0)
                    set audit_payload to concat("run_command: " and cmd_arg)
            else if tool_name equals "self_prompt_set":
                if length_list(args_list) >= 1:
                    set sec_arg to get_list(args_list and 0)
                    set audit_payload to concat("self_prompt_set: agent is rewriting its own prompt section " and sec_arg)
            else if tool_name equals "system_recompile":
                set audit_payload to "system_recompile: build, test, and transactionally replace Echo's running cognitive executable with authenticated health validation and exact rollback"
            else if tool_name equals "improvement_test_freeze":
                set audit_payload to "improvement_test_freeze: hash-lock the retained, prevalidated causal regression and live E2E artifacts before implementation"
            else if tool_name equals "improvement_test_abandon":
                if length_list(args_list) >= 1:
                    set audit_payload to concat("improvement_test_abandon before implementation: " and get_list(args_list and 0))
            else:
                if length_list(args_list) >= 1:
                    set path_arg to get_list(args_list and 0)
                    set audit_payload to concat(tool_name and concat(": " and path_arg))

            if string_length(audit_payload) > 0:
                set resume_audit_prompt to react_audit_prompt_for_state(ctx and current_prompt)
                set audit_map to observer_audit(ctx and resume_audit_prompt and audit_payload)
                set verdict to map_get_val(audit_map and "verdict")
                set audit_record_reason to map_get_val(audit_map and "reason")
                set ok to map_insert(ctx and "last_observer_verdict" and verdict)
                set ok to map_insert(ctx and "last_observer_reason" and audit_record_reason)
                if verdict equals "BLOCKED":
                    # Since this is react_resume_approved, the action has been explicitly
                    # approved by the human user. The observer's BLOCKED verdict is advisory
                    # only and does not prevent execution.
                    set block_reason to map_get_val(audit_map and "reason")
                    display f"Observer audit: BLOCKED (overridden by human approval). Reason: {block_reason}"
                    set ok to trace_emit(trace_db and trace_sid and "audit" and f"Observer: BLOCKED (human-approved, advisory only) — {block_reason}")
                free_map(audit_map)
        
        if action_allowed == 1:
            # KV-CACHE: same as the main loop — let tool-run audits share the prompt prefix.
            set ok to map_insert(ctx and "current_prompt" and react_audit_prompt_for_state(ctx and current_prompt))
            set tool_result to tools_execute(tools_mgr and ctx and tool_name and args_list)
            display f"Tool result: {tool_result}"
            # Approved actions execute through this resume path rather than the main
            # loop's immediate-execution branch. Preserve the same authoritative
            # result and structured candidate transition here so approval cannot
            # bypass deterministic repair routing.
            set ok to map_insert(ctx and "frozen_latest_tool" and tool_name)
            set ok to map_insert(ctx and "frozen_latest_observation" and tool_result)
            set resume_candidate_action to react_candidate_post_result_forced_action(ctx and tool_result)
            if string_length(resume_candidate_action) > 0:
                display "[ReAct] Approved structured candidate failure selected deterministic reset for the resumed loop."
                set ok to trace_emit(trace_db and trace_sid and "candidate_reset" and "Approved post-tool failure selected deterministic candidate reset")
    else:
        display f"User DENIED tool: {tool_name}. Skipping."
        # F2: distinguish a USER decision from a policy gate. The user actively chose
        # not to run this — acknowledge it, do not retry, and ask what they want instead.
        set tool_result to f"[USER DECLINED] The user chose not to run '{tool_name}'. This was the user's decision, not a system error or your own limitation. Acknowledge their choice, do NOT retry the same action, and ask what they would like to do instead."
        # A denial revokes this turn's inferred/confirmed improvement authority. Keep
        # any already-durable transaction evidence on disk, but release every local
        # forced-action flag so the same system_verify/recompile card cannot recur.
        if map_contains(ctx and "repair_workflow_active") == 1:
            if map_get_val(ctx and "repair_workflow_active") == 1:
                set ok to tools_improvement_clear_turn_state(ctx)
                set tool_result to concat(tool_result and " The protected self-improvement rail for this turn is cleared; continue as ordinary conversation.")
    
    # Store event in Tier 3 Timeline
    set ok to memory_store(memory_mgr and 3 and f"Action: {tool_name}" and f"Result: {tool_result}")

    # Approval resume is the same foreground lifecycle as immediate execution.
    # A successful terminal tool must be returned to node_resume_turn now so it can
    # persist the correlated reply and hand a staged upgrade to the supervisor once.
    # Re-entering react_run_loop here made the durable state keep selecting
    # system_recompile after it was already staged, producing an unbounded retry.
    if approved == 1 and also react_tool_result_finishes_turn(tool_name and 1 and tool_result) == 1:
        set ok to trace_emit(trace_db and trace_sid and "done" and concat("Approved terminal tool completed: " and tool_name))
        return reply_format_normalize(tool_result)
    
    if tool_name equals "reply_request" and approved == 1:
        # reply_request was approved — run observer audit on the reply content
        set ok to map_insert(ctx and "observer_capture_continuity" and 1)
        set audit_map to observer_audit(ctx and react_audit_prompt_for_state(ctx and current_prompt) and tool_result)
        set ok to map_delete(ctx and "observer_capture_continuity")
        set verdict to map_get_val(audit_map and "verdict")
        set audit_reason to map_get_val(audit_map and "reason")
        set audit_parsed to map_get_val(audit_map and "parsed")
        set audit_continuity to map_get_val(audit_map and "continuity_json")
        free_map(audit_map)
        if audit_parsed == 0:
            set ok to trace_emit(trace_db and trace_sid and "reply_audit" and "Approved reply audit unavailable; reply withheld without regeneration")
            return "Observer audit failed, so Echo's reply was withheld rather than published unaudited. Please retry this message; the failure has been logged."
        if verdict equals "ALLOWED":
            if string_length(audit_continuity) > 0:
                set ok to map_insert(ctx and "continuity_json" and audit_continuity)
            return reply_format_normalize(tool_result)
    
    # Inject the result as an Observation and re-enter the main loop — fit it to
    # the model's remaining context window (derived, never a fixed cap).
    set obs_model to ""
    if map_contains(ctx and "selected_model") == 1:
        set obs_model to map_get_val(ctx and "selected_model")
    set obs_budget to react_observation_budget(obs_model and string_length(current_prompt))
    set current_prompt to concat(current_prompt and "\n")
    set current_prompt to concat(current_prompt and raw_output)
    set current_prompt to concat(current_prompt and "\nObservation: ")
    set current_prompt to concat(current_prompt and react_fit_observation(tool_result and obs_budget))
    set current_prompt to concat(current_prompt and "\n")
    
    if denials >= 2:
        set current_prompt to concat(current_prompt and "\n[SYSTEM: The user has denied tool execution twice in a row. Return your final answer now as plain user-facing prose based on the information you have. Do not use any tool or protocol wrapper.]\n")

    # Set approval flag so the loop can continue without re-gating
    set ok to map_insert(ctx and "tool_approved" and 0)
    
    set values_list to create_list()
    set ok to append_list(values_list and current_prompt)

    return react_run_loop(model and memory_mgr and tools_mgr and ctx and current_prompt and loop_idx + 1 and values_list and auto_approve_flag)


# F3: resume after the user answers a clarification (or chooses to proceed). Injects
# the answers as an Observation and re-enters the loop. The "__USE_CURRENT__"
# sentinel means "work with what we have" — stop asking and finish.
define react_resume_clarify with model as Map and memory_mgr as Map and tools_mgr as Map and ctx as Map and answers as Str and auto_approve_flag as Int returning Str:
    set pending to map_get_val(ctx and "pending_clarification")
    if pending == 0:
        return "Error: No pending clarification to resume."
    set current_prompt to map_get_val(pending and "prompt_state")
    set raw_output to map_get_val(pending and "raw_output")
    set loop_idx to 0
    if map_contains(pending and "loop_idx") == 1:
        set loop_idx to map_get_val(pending and "loop_idx")
    set saved_role to ""
    if map_contains(pending and "sender_role") == 1:
        set saved_role to map_get_val(pending and "sender_role")
    set ok to map_insert(ctx and "sender_role" and saved_role)
    set ok to map_delete(ctx and "pending_clarification")

    set obs to ""
    set improvement_confirmation to 0
    if map_contains(ctx and "improvement_confirmation_required") == 1:
        if map_get_val(ctx and "improvement_confirmation_required") == 1:
            set improvement_confirmation to 1
    if improvement_confirmation == 1:
        if tools_improvement_confirmation_answer_is_yes(answers) == 1:
            set confirmed to tools_improvement_confirm_pending(ctx)
            if confirmed == 1:
                set obs to "The user explicitly confirmed that this exact pending request should trigger the protected self-improvement workflow. Begin with the controller-required unchanged-source verification."
            else:
                set obs to "The self-improvement confirmation could not be bound to a pending request. Continue the conversation without verification, implementation, or source changes."
                set ok to tools_improvement_clear_turn_state(ctx)
        else:
            set ok to tools_improvement_clear_turn_state(ctx)
            set obs to "The user did not authorize self-improvement. Treat their original message and this answer as ordinary conversation. Do not verify, edit, recompile, deploy, or ask the same trigger question again in this turn."
    else if answers equals "__USE_CURRENT__":
        set ok to map_insert(ctx and "clarify_done" and 1)
        set obs to "The user chose to proceed with the information already available. Do NOT ask for more clarification; complete the task now with your best understanding."
    else:
        set obs to concat("The user answered your clarifying question(s): " and answers)

    set ok to memory_store(memory_mgr and 3 and "Clarification" and obs)

    set obs_model to ""
    if map_contains(ctx and "selected_model") == 1:
        set obs_model to map_get_val(ctx and "selected_model")
    set obs_budget to react_observation_budget(obs_model and string_length(current_prompt))
    set current_prompt to concat(current_prompt and "\n")
    set current_prompt to concat(current_prompt and raw_output)
    set current_prompt to concat(current_prompt and "\nObservation: ")
    set current_prompt to concat(current_prompt and react_fit_observation(obs and obs_budget))
    set current_prompt to concat(current_prompt and "\n")

    set values_list to create_list()
    set ok to append_list(values_list and current_prompt)
    return react_run_loop(model and memory_mgr and tools_mgr and ctx and current_prompt and loop_idx + 1 and values_list and auto_approve_flag)


define react_run with model as Map and memory_mgr as Map and tools_mgr as Map and ctx as Map and user_prompt as Str returning Str:
    set active_runs to 0
    if map_contains(ctx and "active_runs") == 1:
        set active_runs to map_get_val(ctx and "active_runs")
    
    set max_runs to 4
    if map_contains(ctx and "resource_profile") == 1:
        set profile to map_get_val(ctx and "resource_profile")
        if profile equals "low":
            set max_runs to 1
        else if profile equals "standard":
            set max_runs to 2
        else if profile equals "extreme":
            set max_runs to 16
        else if profile equals "high":
            set max_runs to 8
    # Per-request override for operators who know their hardware.
    if map_contains(ctx and "max_concurrent_runs") == 1:
        set mc to map_get_val(ctx and "max_concurrent_runs")
        if mc > 0:
            set max_runs to mc

    if active_runs >= max_runs:
        return "Error: System is at capacity (concurrency limit reached). Please try again later."

    set ok to map_insert(ctx and "active_runs" and active_runs + 1)

    set ok to map_insert(ctx and "auto_approve" and 0)
    # Discard whispers targeted to older turns while retaining any guidance that
    # arrived for THIS turn in the narrow accept/start race.
    set stale_sid to ""
    if map_contains(ctx and "session_id") == 1:
        set stale_sid to map_get_val(ctx and "session_id")
    set current_turn_id to ""
    if map_contains(ctx and "turn_id") == 1:
        set current_turn_id to map_get_val(ctx and "turn_id")
    set stale_rc to react_discard_stale_whispers(stale_sid and current_turn_id)
    if map_contains(ctx and "parent_session_id") == 0:
        set stale_db to storage_get_db()
        if stale_db != 0:
            set stale_main_es to string_replace(react_cancel_key(stale_sid) and "'" and "''")
            set ok to sql_execute(stale_db and f"DELETE FROM trace_whispers WHERE session_id='{stale_main_es}' AND target_turn_id='';")
    # Clear any stale global cancel sentinel left by a PREVIOUS run. /api/cancel writes a
    # '__CANCEL_ALL__' row; if a prior run exited (e.g. via a reply_request) without
    # crossing a turn boundary to consume it, that row would otherwise halt THIS fresh run
    # on turn 1. A Stop click issued DURING this run is written after this point and is
    # still honored at the next turn boundary.
    set cancel_db to storage_get_db()
    if cancel_db != 0:
        set ok to sql_execute(cancel_db and "DELETE FROM trace_cancellations WHERE session_id='__CANCEL_ALL__';")
        # Also clear a stale PER-SESSION row for this session: react_check_cancel now
        # BROADCASTS consumed cancels via the epoch, so a leftover row from a prior run
        # would otherwise halt not just this fresh run but every concurrent one.
        set stale_es to string_replace(react_cancel_key(stale_sid) and "'" and "''")
        set ok to sql_execute(cancel_db and f"DELETE FROM trace_cancellations WHERE session_id='{stale_es}';")
    # Clear the C-level legacy cancel-all flag too, so a Stop meant for a prior run
    # cannot halt this fresh one on turn 1 (the EPOCH needs no clearing — runs capture
    # the current value at start, so old bumps are already behind them).
    set ok to ep_cancel_set(0)
    set literal_user_prompt to tools_literal_current_user_message(ctx and user_prompt)
    set sanitized_user_prompt to prompt_sanitize_input(literal_user_prompt)
    set ok to map_insert(ctx and "repair_original_request" and sanitized_user_prompt)
    set ok to tools_repair_begin(ctx and sanitized_user_prompt)
    # Trigger Hebbian learning on prompt concepts
    set ok to react_hebbian_trigger(memory_mgr and sanitized_user_prompt)
    
    # Resolve THIS turn's session (never merely "the active one"): with parallel
    # per-session turns another dispatch may have moved the global active pointer.
    set sessions_mgr to map_get_val(ctx and "sessions")
    set sess to 0
    if sessions_mgr != 0:
        set comp_sid to ""
        if map_contains(ctx and "session_id") == 1:
            set comp_sid to map_get_val(ctx and "session_id")
        if string_length(comp_sid) > 0:
            set comp_map to map_get_val(sessions_mgr and "sessions")
            if map_contains(comp_map and comp_sid) == 1:
                set sess to map_get_val(comp_map and comp_sid)
        if sess == 0:
            set sess to session_manager_get_active(sessions_mgr)

    set history to create_list()
    set values_list to create_list()
    set ok to append_list(values_list and history)
    
    set sender_role to ""
    if map_contains(ctx and "sender_role") == 1:
        set sender_role to map_get_val(ctx and "sender_role")
    
    set local_tools_mgr to tools_create(sender_role)
    set tools_schema to map_get_val(local_tools_mgr and "schemas")
    set ok to map_insert(ctx and "tools_schema" and tools_schema)
    set assembled_prompt to prompt_assemble(memory_mgr and ctx and sanitized_user_prompt and tools_schema)

    # Provider-authoritative context accounting. Measure the fully assembled prompt,
    # expose capacity to Echo, warn the user once near the boundary, and compact only
    # at exactly 85% of the live provider's stated token window.
    set selected_model to ""
    if map_contains(ctx and "selected_model") == 1:
        set selected_model to map_get_val(ctx and "selected_model")
    set context_snapshot to llm_context_snapshot(selected_model and assembled_prompt)
    if map_get_val(context_snapshot and "ok") == 1:
        set context_provider to map_get_val(context_snapshot and "provider")
        set context_model to map_get_val(context_snapshot and "model")
        set context_limit to map_get_val(context_snapshot and "context_limit_tokens")
        set context_used to map_get_val(context_snapshot and "used_tokens")
        set capacity_text to session_context_capacity_text(context_provider and context_model and context_used and context_limit)
        set ok to map_insert(ctx and "context_capacity" and capacity_text)
        set assembled_prompt to prompt_assemble(memory_mgr and ctx and sanitized_user_prompt and tools_schema)
        # Count again with the capacity record included so the 85% comparison applies
        # to the actual prompt Echo receives, not a smaller preliminary prompt.
        set final_snapshot to llm_context_snapshot(selected_model and assembled_prompt)
        if map_get_val(final_snapshot and "ok") == 1:
            set context_used to map_get_val(final_snapshot and "used_tokens")
            set context_limit to map_get_val(final_snapshot and "context_limit_tokens")
            set context_provider to map_get_val(final_snapshot and "provider")
            set context_model to map_get_val(final_snapshot and "model")
            set capacity_text to session_context_capacity_text(context_provider and context_model and context_used and context_limit)
            set ok to map_insert(ctx and "context_capacity" and capacity_text)
            set assembled_prompt to prompt_assemble(memory_mgr and ctx and sanitized_user_prompt and tools_schema)
            if sess != 0:
                if session_context_approaching_compaction(context_used and context_limit) == 1:
                    set warning_sent to 0
                    if map_contains(sess and "compression_warning_emitted") == 1:
                        set warning_sent to map_get_val(sess and "compression_warning_emitted")
                    if warning_sent == 0:
                        set compaction_at to session_compaction_threshold(context_limit)
                        set remaining_tokens to compaction_at - context_used
                        set warning_message to f"⚠️ Context is approaching compaction: {context_used} of {context_limit} provider tokens are in use. Automatic compaction begins at {compaction_at} tokens (85%); {remaining_tokens} tokens remain before that point."
                        set ok to react_write_mid_message(comp_sid and warning_message)
                        set ok to map_insert(sess and "compression_warning_emitted" and 1)
                if session_should_compress(context_used and context_limit) == 1:
                    set compaction_at to session_compaction_threshold(context_limit)
                    set compaction_message to f"⚠️ Context reached the {compaction_at}-token compaction point (85% of the provider's {context_limit}-token window). Earlier turns are being archived and the active context compacted now."
                    set ok to react_write_mid_message(comp_sid and compaction_message)
                    set compressed to session_compress_active(sessions_mgr and sess and context_used and context_limit)
                    if compressed == 1:
                        set ok to map_insert(sess and "compression_warning_emitted" and 0)
                        set assembled_prompt to prompt_assemble(memory_mgr and ctx and sanitized_user_prompt and tools_schema)
                        set compacted_snapshot to llm_context_snapshot(selected_model and assembled_prompt)
                        if map_get_val(compacted_snapshot and "ok") == 1:
                            set capacity_text to session_context_capacity_text(map_get_val(compacted_snapshot and "provider") and map_get_val(compacted_snapshot and "model") and map_get_val(compacted_snapshot and "used_tokens") and map_get_val(compacted_snapshot and "context_limit_tokens"))
                            set ok to map_insert(ctx and "context_capacity" and capacity_text)
                            set assembled_prompt to prompt_assemble(memory_mgr and ctx and sanitized_user_prompt and tools_schema)
    else:
        set context_error to map_get_val(context_snapshot and "error")
        display concat("[CONTEXT CAPACITY] Measurement unavailable; compaction not performed without provider token evidence: " and context_error)
    set ok to append_list(values_list and assembled_prompt)
    
    set res to react_run_loop(model and memory_mgr and local_tools_mgr and ctx and assembled_prompt and 0 and values_list and 0)
    
    set ok to map_delete(ctx and "tools_schema")
    set active_runs to map_get_val(ctx and "active_runs")
    if active_runs > 0:
        set ok to map_insert(ctx and "active_runs" and active_runs - 1)

    # Emit final trace event and schedule cleanup
    set trace_db to storage_get_db()
    set trace_sid to ""
    if map_contains(ctx and "session_id") == 1:
        set trace_sid to map_get_val(ctx and "session_id")
    set ok to trace_emit(trace_db and trace_sid and "done" and "Final answer ready")

    return res
