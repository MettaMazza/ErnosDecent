# ErnosPlain Rebuild of ErnOS Agent ReAct Loop Coordinator
# Component: decent_agent/react_loop.ep

import "collections"
import "string"
import "json"
import "llm"

import "prompt"
import "tools"
import "memory"
import "observer"
import "session"
import "sync"
import "trace"
import "../storage"
import "sql"

# F4: cooperative cancellation registry. A Stop button / `AI CANCEL` IPC sets a
# per-session flag on a SEPARATE connection while react_run_loop is blocked on the
# first; the loop checks (and consumes) it at each turn boundary and halts cleanly.
# Mutex-guarded because requester and runner are different threads. An empty
# session id normalises to "default" so both sides agree on a key.
set RUN_CANCEL_MAP to create_map()
set RUN_CANCEL_LOCK to create_mutex()

define react_cancel_key with session_id as Str returning Str:
    if string_length(session_id) == 0:
        return "default"
    return session_id

# Request cancellation of the active run for a session (called from the IPC handler).
define react_request_cancel with session_id as Str returning Int:
    set key to react_cancel_key(session_id)
    set ok to lock_mutex(RUN_CANCEL_LOCK)
    set ok to map_insert(RUN_CANCEL_MAP and key and 1)
    set ok to unlock_mutex(RUN_CANCEL_LOCK)
    
    # Also write to SQLite DB
    set db to storage_get_db()
    if db != 0:
        set es to string_replace(key and "'" and "''")
        set ok to sql_execute(db and f"INSERT OR REPLACE INTO trace_cancellations (session_id) VALUES ('{es}');")
    return 0

# Check and CONSUME a pending cancellation (called by the loop each turn).
define react_check_cancel with session_id as Str returning Int:
    set key to react_cancel_key(session_id)
    set ok to lock_mutex(RUN_CANCEL_LOCK)
    set hit to map_contains(RUN_CANCEL_MAP and key)
    if hit == 1:
        set ok to map_delete(RUN_CANCEL_MAP and key)
    set ok to unlock_mutex(RUN_CANCEL_LOCK)
    if hit == 1:
        return 1
        
    # Check SQLite DB
    set db to storage_get_db()
    if db != 0:
        set es to string_replace(key and "'" and "''")
        set rows to sql_query(db and f"SELECT COUNT(*) FROM trace_cancellations WHERE session_id='{es}';")
        if length_list(rows) > 0:
            set first_row to get_list(rows and 0)
            set count_str to get_list(first_row and 0)
            if string_to_int(count_str) > 0:
                # Consume it: delete from trace_cancellations
                set ok to sql_execute(db and f"DELETE FROM trace_cancellations WHERE session_id='{es}';")
                return 1
    return 0

# Drain all pending whispers for a session (called before each LLM call).
# Returns concatenated whisper text or empty string. Consumes all whispers.
define react_drain_whispers with session_id as Str returning Str:
    set db to storage_get_db()
    if db == 0:
        return ""
    set key to session_id
    if string_length(key) == 0:
        set key to "default"
    set es to string_replace(key and "'" and "''")
    set rows to sql_query(db and f"SELECT id, content FROM trace_whispers WHERE session_id='{es}' ORDER BY id;")
    set count to length_list(rows)
    if count == 0:
        return ""
    set out to ""
    set idx to 0
    repeat while idx < count:
        set row to get_list(rows and idx)
        set w_id to get_list(row and 0)
        set w_content to get_list(row and 1)
        set out to concat(out and f"- {w_content}\n")
        set ok to sql_execute(db and f"DELETE FROM trace_whispers WHERE id={w_id};")
        set idx to idx + 1
    return out

# Write a mid-turn message from the agent to the user via trace_events.
# The Discord bridge picks up events with type 'mid_message' and posts them
# in the main channel, NOT in the trace thread. Does NOT end the react loop.
define react_write_mid_message with session_id as Str and content as Str returning Int:
    set db to storage_get_db()
    if db == 0:
        return 1
    set key to session_id
    if string_length(key) == 0:
        set key to "default"
    set es to string_replace(key and "'" and "''")
    set ec to string_replace(content and "'" and "''")
    set ok to sql_execute(db and f"INSERT INTO trace_events (session_id, event_type, content, created_at, sent) VALUES ('{es}', 'mid_message', '{ec}', strftime('%s','now'), 0);")
    return ok

# Remove stray harmony/gemma channel-marker tokens from a string. Longer variants
# are stripped before their unterminated forms so nothing is left behind.
define react_strip_markers with s as Str returning Str:
    set out to s
    set out to string_replace(out and "<|thought|>" and "")
    set out to string_replace(out and "<|thought|" and "")
    set out to string_replace(out and "<|channel|>" and "")
    set out to string_replace(out and "<channel|>" and "")
    set out to string_replace(out and "<channel|" and "")
    set out to string_replace(out and "<|message|>" and "")
    set out to string_replace(out and "<|message|" and "")
    set out to string_replace(out and "<|start|>" and "")
    set out to string_replace(out and "<|end|>" and "")
    set out to string_replace(out and "<|assistant|>" and "")
    return out

# F1 (generalized): separate a turn's native reasoning from its ReAct content.
# Different local models emit reasoning differently: <think>...</think> (deepseek/
# qwen), or harmony/gemma channel markers like <|thought|> ... <channel|>Action:...
# (gemma4:26b). We capture the reasoning as its own channel and strip ALL of these
# markers so they never confuse action parsing or leak to the user. Returns
# {reasoning, clean}.
define react_extract_reasoning with text as Str returning Map:
    set result to create_map()
    set reasoning to ""
    set work to text

    # 1. <think>...</think>
    set open_pos to string_index_of(work and "<think>")
    if open_pos >= 0:
        set close_pos to string_index_of(work and "</think>")
        if close_pos < 0:
            set reasoning to concat(reasoning and substring(work and open_pos + 7 and string_length(work) - open_pos - 7))
            set work to substring(work and 0 and open_pos)
        else:
            set reasoning to concat(reasoning and substring(work and open_pos + 7 and close_pos - open_pos - 7))
            set before to substring(work and 0 and open_pos)
            set after_start to close_pos + 8
            set work to concat(before and substring(work and after_start and string_length(work) - after_start))

    # 2. Harmony/gemma: the final channel output follows the LAST <channel|> marker;
    #    everything before it is reasoning.
    set ch_pos to string_last_index_of(work and "<channel|>")
    if ch_pos >= 0:
        set reasoning to concat(reasoning and concat("\n" and substring(work and 0 and ch_pos)))
        set after_ch to ch_pos + 10
        set work to substring(work and after_ch and string_length(work) - after_ch)

    # 3. Strip any remaining stray marker tokens from both channels.
    set work to react_strip_markers(work)
    set reasoning to react_strip_markers(reasoning)

    set ok to map_insert(result and "reasoning" and string_trim(reasoning))
    set ok to map_insert(result and "clean" and string_trim(work))
    return result

# Characters of tool output we can fold into the prompt this turn, derived from
# the model's OWN context window (get_model_context_limit, which already scales by
# model + system RAM) minus what the prompt already holds. This is NOT a fixed
# cap: a 200k-token model (gemma4) gets ~hundreds of KB of headroom, an 8k model
# proportionally less. We convert tokens→chars at ~3.5 chars/token (BPE average
# for mixed prose + paths/code; deliberately low so we under-estimate the window
# and never overflow it) and reserve 25% of the window for the model's reply and
# the loop's remaining turns. Returns the remaining char budget (can be negative
# when the prompt has already filled the window).
define react_observation_budget with model_name as Str and prompt_len as Int returning Int:
    set ctx_tokens to get_model_context_limit(model_name)
    set window_chars to (ctx_tokens * 7) / 2
    set usable to (window_chars * 3) / 4
    return usable - prompt_len

# Fit a tool result into the per-turn budget. If it fits, it passes through whole.
# If not, keep the head that fits and tell the model it was clipped (with the real
# total) so it narrows its next query instead of silently losing the tail or
# blowing up the inference call. A small floor guarantees the model always sees
# some of the output even when the window is nearly full.
define react_fit_observation with text as Str and budget as Int returning Str:
    set room to budget
    set min_room to 2048
    if room < min_room:
        set room to min_room
    set n to string_length(text)
    if n <= room:
        return text
    set notice to f"\n\n[OUTPUT TRUNCATED to fit the model context window: {n} chars total, {room} kept. Narrow your request — target a specific directory, add a depth/count limit, or filter — and do not recurse into build/cache dirs (target/, node_modules/, .git/, deps/).]"
    set keep to room - string_length(notice)
    if keep < 0:
        set keep to 0
    set head to substring(text and 0 and keep)
    return concat(head and notice)

# Extract the raw string content from a JSON-like args_str (e.g. '["some text"]')
# by stripping the outer [" and "] wrappers. Used as a fallback when json_parse
# is confused by unescaped inner quotes from the LLM.
define react_extract_raw_arg with args_str as Str returning Str:
    set slen to string_length(args_str)
    if slen < 4:
        return args_str
    # Find the opening quote after '[' (skip whitespace)
    set start to 0
    set found_start to 0
    repeat while start < slen and found_start == 0:
        set ch to get_character(args_str and start)
        if ch == 34: # '"'
            set found_start to 1
        else:
            set start to start + 1
    if found_start == 0:
        return args_str
    # Find the closing quote before ']' (scan from end)
    set end_pos to slen - 1
    set found_end to 0
    repeat while end_pos > start and found_end == 0:
        set ch to get_character(args_str and end_pos)
        if ch == 34: # '"'
            set found_end to 1
        else:
            set end_pos to end_pos - 1
    if found_end == 0:
        return args_str
    # Extract content between the outermost quotes
    set content_start to start + 1
    set content_len to end_pos - content_start
    if content_len <= 0:
        return args_str
    return substring(args_str and content_start and content_len)

define react_parse_action with raw as Str returning Map:
    set result to create_map()
    set ok to map_insert(result and "found" and 0)
    
    set raw_lower to string_lower(raw)
    set pos to string_index_of(raw_lower and "action:")
    if pos < 0:
        return result
        
    set raw_len to string_length(raw)
    set tool_name_start to pos + 7
    set skip_done to 0
    repeat while tool_name_start < raw_len and skip_done == 0:
        set ch to get_character(raw and tool_name_start)
        if ch == 32 or else ch == 9:
            set tool_name_start to tool_name_start + 1
        else:
            set skip_done to 1
            
    if tool_name_start >= raw_len:
        return result
        
    set start_args to -1
    set search_idx to tool_name_start
    set args_found to 0
    repeat while search_idx < raw_len and args_found == 0:
        set ch to get_character(raw and search_idx)
        if ch == 40: # '('
            set start_args to search_idx
            set args_found to 1
        else:
            set search_idx to search_idx + 1
            
    if start_args < 0:
        return result
        
    set tool_name to substring(raw and tool_name_start and start_args - tool_name_start)
    set tool_name_trimmed to string_trim(tool_name)
    
    set end_args to -1
    set in_string to 0
    set escaped to 0
    set depth to 1
    set scan_idx to start_args + 1
    set scan_done to 0
    repeat while scan_idx < raw_len and scan_done == 0:
        set ch to get_character(raw and scan_idx)
        if escaped == 1:
            set escaped to 0
        else if ch == 92: # backslash '\'
            set escaped to 1
        else if ch == 34: # double quote '"'
            if in_string == 0:
                set in_string to 1
            else:
                set in_string to 0
        else if in_string == 0:
            if ch == 40: # '('
                set depth to depth + 1
            else if ch == 41: # ')'
                set depth to depth - 1
                if depth == 0:
                    set end_args to scan_idx
                    set scan_done to 1
        set scan_idx to scan_idx + 1

    if end_args < start_args:
        return result
        
    set args_str to substring(raw and start_args + 1 and end_args - start_args - 1)
    
    set ok to map_insert(result and "found" and 1)
    set ok to map_insert(result and "tool_name" and tool_name_trimmed)
    set ok to map_insert(result and "args_str" and args_str)
    
    set values_list to create_list()
    set ok to map_insert(result and "values_list" and values_list)
    set ok to append_list(values_list and tool_name_trimmed)
    set ok to append_list(values_list and args_str)
    return result


define react_hebbian_trigger with memory_mgr as Map and text as Str returning Int:
    set concepts to create_list()
    set ok to append_list(concepts and "wallet")
    set ok to append_list(concepts and "ledger")
    set ok to append_list(concepts and "dht")
    set ok to append_list(concepts and "consensus")
    set ok to append_list(concepts and "identity")
    set ok to append_list(concepts and "speech")
    set ok to append_list(concepts and "turing")
    set ok to append_list(concepts and "name")
    
    set text_upper to string_upper(text)
    set len to length_list(concepts)
    
    set i to 0
    repeat while i < len:
        set c1 to get_list(concepts and i)
        set c1_upper to string_upper(c1)
        if string_contains(text_upper and c1_upper) == 1:
            set j to i + 1
            repeat while j < len:
                set c2 to get_list(concepts and j)
                set c2_upper to string_upper(c2)
                if string_contains(text_upper and c2_upper) == 1:
                    set ok to memory_strengthen_synapse(memory_mgr and c1 and c2)
                set j to j + 1
        set i to i + 1
        
    free_list(concepts)
    return 0


define react_simulate_inference with prompt as Str and loop_idx as Int returning Str:
    set prompt_upper to string_upper(prompt)
    
    if string_contains(prompt_upper and "AUTO_APPROVE_TEST") == 1:
        if loop_idx == 0:
            return "Thought: I will call money_transfer.\nAction: money_transfer([50, \"did:key:recipient\"])"
        else if loop_idx == 1:
            return "Thought: I will call dht_store.\nAction: dht_store([\"test_key\", \"test_val\"])"
        else:
            return "Thought: I will now reply correctly.\nAction: reply_request([\"ai:agent_rebuild,response:Success\"])"

    if string_contains(prompt_upper and "CONVERGENCE_TEST") == 1:
        if loop_idx == 0:
            return "Thought: I will output a message without a properly formatted Action statement to test loop convergence recovery."
        else:
            return "Thought: I will now reply correctly.\nAction: reply_request([\"ai:agent_rebuild,response:Success\"])"

    set req_pos to string_last_index_of(prompt_upper and "USER REQUEST:")
    set obs_pos to string_last_index_of(prompt_upper and "\nOBSERVATION:")
    if obs_pos > req_pos:
        set observation_text to substring(prompt and obs_pos + 13 and string_length(prompt) - obs_pos - 13)
        return f"Thought: I have received the observation. I will now reply to the user.\nAction: reply_request([\"ai:agent_rebuild,response:Success. Result is: {string_trim(observation_text)}\"])"
        
    if string_contains(prompt_upper and "TURING_GRID_OP") == 1:
        set op_start to string_index_of(prompt and "turing_grid_op(")
        if op_start > 0:
            set op_end to string_index_of(prompt and ")")
            if op_end > op_start:
                set op_args to substring(prompt and op_start + 15 and op_end - op_start - 15)
                return f"Thought: Running Turing Grid operation.\nAction: turing_grid_op({op_args})"
        
    if string_contains(prompt_upper and "RESOLVE NAME ") == 1:
        set name_pos to string_index_of(prompt_upper and "RESOLVE NAME ")
        set name_arg to substring(prompt and name_pos + 13 and string_length(prompt) - name_pos - 13)
        set name_trimmed to string_trim(name_arg)
        return f"Thought: The user wants me to resolve a name. I will call name_resolve.\nAction: name_resolve([\"{name_trimmed}\"])"
        
    if string_contains(prompt_upper and "CHECK BALANCE") == 1 or else string_contains(prompt_upper and "WALLET BALANCE") == 1:
        return "Thought: I need to check the wallet balance. I will call wallet_balance.\nAction: wallet_balance([])"
        
    if string_contains(prompt_upper and "TRANSFER ") == 1:
        return "Thought: I will call money_transfer.\nAction: money_transfer([50, \"did:key:recipient\"])"
        
    return "Thought: I will answer the user request directly.\nAction: reply_request([\"ai:agent_rebuild,response:Hello! I am the ErnOS Agent rebuilt in ErnosPlain. How can I help you today?\"])"


define react_run_loop with model as Map and memory_mgr as Map and tools_mgr as Map and ctx as Map and current_prompt as Str and start_loop_idx as Int and values_list as List and auto_approve_flag as Int returning Str:
    set loop_idx to start_loop_idx
    set final_answer to ""
    set finished to 0
    set reply_blocks to 0
    set override_output to ""
    
    # Check if we are running under automated test suite
    set is_test to 0
    if map_contains(ctx and "is_test") == 1:
        set is_test to map_get_val(ctx and "is_test")
    
    # Check if a model is loaded. If model has no vocab (empty map), run simulation mode.
    set use_simulation to 1
    if map_contains(model and "vocab") == 1:
        set vocab_node to map_get_val(model and "vocab")
        if length_list(vocab_node) > 0:
            set use_simulation to 0

    # Tool-chaining horizon. The loop chains as many tools as the task needs, one per
    # turn; this is only a runaway guard (a model that never replies would otherwise
    # grow the prompt without bound). Default raised to 50 for long-horizon/complex
    # work and overridable per request via ctx "max_iterations".
    set max_iters to 50
    if map_contains(ctx and "max_iterations") == 1:
        set ov to map_get_val(ctx and "max_iterations")
        if ov > 0:
            set max_iters to ov
    repeat while finished == 0 and also loop_idx < max_iters:
        # F4: cancellation checkpoint — halt cleanly between turns (before spending
        # another inference). An in-flight LLM call cannot be interrupted here; that
        # is phase 2 (abortable socket). 'continue' re-checks the while condition,
        # which is now false, so the loop exits.
        set f4_sess to ""
        if map_contains(ctx and "session_id") == 1:
            set f4_sess to map_get_val(ctx and "session_id")
        set ok to tools_set_active_session(f4_sess)
        if react_check_cancel(f4_sess) == 1:
            display "[ReAct] Run halted by user (cancel)."
            set ok to map_insert(ctx and "was_cancelled" and 1)
            set final_answer to "Run halted at your request."
            set finished to 1
            continue
        display f"--- ReAct Loop Turn {loop_idx + 1} ---"
        display f"Prompt character length: {string_length(current_prompt)}"
        set trace_db to storage_get_db()
        set trace_sid to ""
        if map_contains(ctx and "session_id") == 1:
            set trace_sid to map_get_val(ctx and "session_id")
        
        set query_prompt to current_prompt
        # Whisper checkpoint — drain any mid-turn user guidance before the LLM call.
        set whispers to react_drain_whispers(trace_sid)
        if string_length(whispers) > 0:
            display f"[ReAct] Received mid-turn whisper(s) from user."
            set ok to trace_emit(trace_db and trace_sid and "whisper_received" and whispers)
            set query_prompt to concat(query_prompt and f"\n[MID-TURN USER GUIDANCE — the user has sent additional direction while you are processing. This is NOT a new request — it is live guidance for your CURRENT task. Read it carefully and adjust your approach. You may acknowledge it with mid_message but do NOT end your turn with reply_request unless the user explicitly tells you to stop.]\n{whispers}[/MID-TURN USER GUIDANCE]\n")
        
        set raw_output to ""
        if string_length(override_output) > 0:
            set raw_output to override_output
            set override_output to ""
            display f"[ReAct] Skipping LLM call, using overridden raw_output."
        else:
            if is_test == 0:
                set selected_model to ""
                if map_contains(ctx and "selected_model") == 1:
                    set selected_model to map_get_val(ctx and "selected_model")
                set ok to trace_emit(trace_db and trace_sid and "thinking" and f"Querying {selected_model}...")
                set raw_output to query_local_llm(query_prompt and selected_model)
                
            if string_length(raw_output) == 0:
                if is_test == 1:
                    set raw_output to react_simulate_inference(query_prompt and loop_idx)
                else if use_simulation == 0:
                    set raw_output to inference_run(model and query_prompt and 0 and 200)
                else:
                    # No LLM available — tell user instead of faking it with hardcoded heuristics
                    display "[ReAct] No LLM response and no local model loaded. Returning error."
                    set final_answer to "Error: No LLM model responded. Please check that your selected model is running in Ollama or LM Studio."
                    set finished to 1
            
        display f"LLM raw response:\n{raw_output}\n----------------"
        set ok to trace_emit(trace_db and trace_sid and "raw_output" and substring(raw_output and 0 and 1800))
        set ok to append_list(values_list and raw_output)

        # F1: capture this turn's native reasoning (<think>...</think>) as its own
        # channel and strip it from raw_output so it never confuses action parsing or
        # leaks. Preserve it (timeline + ctx) for transparency and the look-back.
        set reason_split to react_extract_reasoning(raw_output)
        set turn_reasoning to map_get_val(reason_split and "reasoning")
        if string_length(turn_reasoning) > 0:
            set raw_output to map_get_val(reason_split and "clean")
            set ok to map_insert(ctx and "last_reasoning" and turn_reasoning)
            set ok to memory_store(memory_mgr and 3 and "REASONING" and turn_reasoning)
            display f"[reasoning] {turn_reasoning}"
            set ok to trace_emit(trace_db and trace_sid and "reasoning" and substring(turn_reasoning and 0 and 1800))
        # reason_split is NOT freed here: turn_reasoning was extracted from it and
        # inserted into ctx["last_reasoning"]. Freeing the map would invalidate the
        # aliased string — use-after-free → SIGSEGV. Tracked in values_list for GC.
        set ok to append_list(values_list and reason_split)

        # Strengthen synapses based on generated thought
        set ok to react_hebbian_trigger(memory_mgr and raw_output)

        # F5: self-accountability look-back. Review this turn's own output against
        # ErnOS's values via LLM inference; on drift, log it to the timeline and
        # inject a private nudge. Fail-open: clean output does nothing.
        set lookback to observer_lookback(raw_output)
        if map_get_val(lookback and "drift") == 1:
            set lb_note to map_get_val(lookback and "note")
            display f"[Observer look-back] self-correction: {lb_note}"
            set ok to trace_emit(trace_db and trace_sid and "lookback" and lb_note)
            set ok to memory_store(memory_mgr and 3 and "SELF-CHECK" and lb_note)
            set current_prompt to concat(current_prompt and f"\n[SELF-CHECK — INVISIBLE TO USER] Your previous output drifted from your operating values ({lb_note}). Correct course now: speak as ErnOS in the first person, never use pre-trained-assistant disclaimers or claim to be another company's model, and state things plainly. Do not mention this note to the user.\n")
        free_map(lookback)

        set action_map to react_parse_action(raw_output)
        set found_action to map_get_val(action_map and "found")
        
        if found_action == 1:
            set tool_name to map_get_val(action_map and "tool_name")
            set args_str to map_get_val(action_map and "args_str")
            display f"Parsed action: '{tool_name}' with args: '{args_str}'"
            set ok to trace_emit(trace_db and trace_sid and "action" and f"{tool_name}({args_str})")
            set ok to append_list(values_list and action_map)
            
            # Parse arguments as JSON array or fallback to raw string
            set args_list to create_list()
            set json_node to json_parse(args_str)
            if json_node != 0:
                set j_type to get_json_type(json_node)
                if j_type == 3: # List
                    set parsed_items to get_json_value(json_node)
                    set items_len to length_list(parsed_items)
                    set item_i to 0
                    repeat while item_i < items_len:
                        set json_item to get_list(parsed_items and item_i)
                        set val to get_json_value(json_item)
                        set ok to append_list(args_list and val)
                        set item_i to item_i + 1
                    # Truncation guard: if JSON parsed a single string that is
                    # drastically shorter than the raw args, the LLM likely
                    # emitted unescaped inner quotes. Fall back to raw extraction.
                    if items_len == 1:
                        set parsed_len to string_length(get_list(args_list and 0))
                        set raw_len to string_length(args_str)
                        if parsed_len < raw_len / 2:
                            display f"[react] JSON truncation detected ({parsed_len} vs {raw_len} chars). Using raw extraction."
                            set ok to set_list(args_list and 0 and react_extract_raw_arg(args_str))
                else:
                    set ok to append_list(args_list and get_json_value(json_node))
            else:
                set ok to append_list(args_list and args_str)
                
            set action_allowed to 1
            set action_reason to ""

            # --- F3: Clarification request (pause + ask the user) ---
            # Mirrors the approval pause/resume rail. Bounded to 3 rounds; once the
            # budget is spent (or the user said "work with what we have"), further
            # requests are refused with a nudge to proceed instead of pausing.
            if tool_name equals "request_clarification":
                set clarify_rounds to 0
                if map_contains(ctx and "clarify_rounds") == 1:
                    set clarify_rounds to map_get_val(ctx and "clarify_rounds")
                set clarify_done to 0
                if map_contains(ctx and "clarify_done") == 1:
                    set clarify_done to map_get_val(ctx and "clarify_done")
                if clarify_rounds >= 3 or else clarify_done == 1:
                    set current_prompt to concat(current_prompt and "\n")
                    set current_prompt to concat(current_prompt and raw_output)
                    set current_prompt to concat(current_prompt and "\nObservation: You have used your clarification budget. Proceed now with your best understanding; do not ask the user again.\n")
                    free_list(args_list)
                    set loop_idx to loop_idx + 1
                    continue
                set ok to map_insert(ctx and "clarify_rounds" and clarify_rounds + 1)
                set pendingc to create_map()
                set ok to map_insert(pendingc and "questions" and args_str)
                set ok to map_insert(pendingc and "prompt_state" and current_prompt)
                set ok to map_insert(pendingc and "raw_output" and raw_output)
                set ok to map_insert(pendingc and "loop_idx" and loop_idx)
                set pendc_role to ""
                if map_contains(ctx and "sender_role") == 1:
                    set pendc_role to map_get_val(ctx and "sender_role")
                set ok to map_insert(pendingc and "sender_role" and pendc_role)
                set ok to map_insert(ctx and "pending_clarification" and pendingc)
                free_list(args_list)
                free_list(values_list)
                set ok to tools_set_active_session("")
                return "PENDING_CLARIFICATION"

            # --- Mid-message response (does NOT end the turn) ---
            # Allows the agent to send a visible message to the user while continuing
            # its current task. Used to acknowledge whispers, give progress updates,
            # or respond to mid-turn guidance without stopping work.
            if tool_name equals "mid_message":
                set mid_content to react_extract_raw_arg(args_str)
                set mid_sess to ""
                if map_contains(ctx and "session_id") == 1:
                    set mid_sess to map_get_val(ctx and "session_id")
                set ok to react_write_mid_message(mid_sess and mid_content)
                display f"[ReAct] Mid-message sent to user: {substring(mid_content and 0 and 100)}"
                # Note: react_write_mid_message already writes to trace_events.
                # Do NOT also call trace_emit here — that creates a duplicate row.
                # Check if the same LLM output contains a SECOND Action: after mid_message.
                # Without this, actions like request_clarification bundled with mid_message
                # are silently dropped (the parser only catches the first Action:).
                set raw_lower to string_lower(raw_output)
                set first_action_pos to string_index_of(raw_lower and "action:")
                set after_action to ""
                if first_action_pos >= 0:
                    set search_start to first_action_pos + 7
                    if search_start < string_length(raw_output):
                        set remainder to substring(raw_lower and search_start and string_length(raw_lower) - search_start)
                        set second_offset to string_index_of(remainder and "action:")
                        if second_offset >= 0:
                            set abs_pos to search_start + second_offset
                            set after_action to substring(raw_output and abs_pos and string_length(raw_output) - abs_pos)
                if string_length(after_action) > 0:
                    set second_action to react_parse_action(after_action)
                    set second_found to map_get_val(second_action and "found")
                    if second_found == 1:
                        set second_name to map_get_val(second_action and "tool_name")
                        set second_args to map_get_val(second_action and "args_str")
                        display f"[ReAct] Found second action after mid_message: {second_name}"
                        # Inject the second action as if the LLM just emitted it on the next turn.
                        set override_output to f"Thought: (continued from mid_message)\nAction: {second_name}({second_args})"
                        set current_prompt to concat(current_prompt and "\nObservation: Mid-message delivered to the user.\n")
                        set current_prompt to concat(current_prompt and override_output)
                        free_map(second_action)
                        free_list(args_list)
                        # Do NOT increment loop_idx — re-parse on the same iteration budget.
                        continue
                    free_map(second_action)
                # No second action — continue the loop with a fresh LLM call.
                set current_prompt to concat(current_prompt and "\n")
                set current_prompt to concat(current_prompt and raw_output)
                set current_prompt to concat(current_prompt and "\nObservation: Mid-message delivered to the user. Continue your current task.\n")
                free_list(args_list)
                set loop_idx to loop_idx + 1
                continue

            # --- Tool Approval Gate ---
            set needs_approval to tools_requires_approval(tool_name and args_list)
            if needs_approval == 1:
                set has_approval to 0
                if map_contains(ctx and "tool_approved") == 1:
                    set has_approval to map_get_val(ctx and "tool_approved")
                
                # Check request-scoped auto_approve. The threaded auto_approve_flag is the
                # reliable source (it survives across tool executions); the ctx read is kept
                # as a secondary path but is unreliable when ctx is a borrow view — that was
                # the "Approve all approves the first then denies the rest" bug.
                set auto_approve_val to 0
                if map_contains(ctx and "auto_approve") == 1:
                    set auto_approve_val to map_get_val(ctx and "auto_approve")
                if auto_approve_flag == 1:
                    set auto_approve_val to 1
                if auto_approve_val == 1:
                    set has_approval to 1
                
                if has_approval == 0:
                    set denials to 0
                    if map_contains(ctx and "consecutive_denials") == 1:
                        set denials to map_get_val(ctx and "consecutive_denials")
                    
                    if denials >= 2:
                        display f"Auto-denying tool '{tool_name}' because consecutive denials >= 2"
                        set action_allowed to 0
                        set action_reason to "Tool execution blocked because user has denied tool execution twice in a row."
                    else:
                        # Build a summary of what the tool wants to do
                        set approval_summary to concat(tool_name and "(")
                        set approval_summary to concat(approval_summary and args_str)
                        set approval_summary to concat(approval_summary and ")")
                        
                        display f"Tool '{tool_name}' requires user approval. Pausing for confirmation."
                        set ok to trace_emit(trace_db and trace_sid and "approval" and f"Waiting for approval: {tool_name}({args_str})")
                        
                        # Store pending action state in context for the IPC layer to pick up
                        set pending to create_map()
                        set ok to map_insert(pending and "tool_name" and tool_name)
                        set ok to map_insert(pending and "args_str" and args_str)
                        set ok to map_insert(pending and "summary" and approval_summary)
                        set ok to map_insert(pending and "prompt_state" and current_prompt)
                        set ok to map_insert(pending and "raw_output" and raw_output)
                        set ok to map_insert(pending and "loop_idx" and loop_idx)
                        # Bind the caller's role to this pending action. The IPC layer
                        # deletes sender_role from ctx after the initiating turn, so the
                        # approval (a separate IPC round) would otherwise execute the tool
                        # with no role and fail the admin gate -> "restricted to
                        # administrators" on every approved tool since approve-all landed.
                        set pend_role to ""
                        if map_contains(ctx and "sender_role") == 1:
                            set pend_role to map_get_val(ctx and "sender_role")
                        set ok to map_insert(pending and "sender_role" and pend_role)
                        set ok to map_insert(ctx and "pending_action" and pending)
                        
                        # Store the parsed args list for later execution
                        set pending_args to create_list()
                        set pa_idx to 0
                        set a_len to length_list(args_list)
                        repeat while pa_idx < a_len:
                            set pa_val to get_list(args_list and pa_idx)
                            set ok to append_list(pending_args and pa_val)
                            set pa_idx to pa_idx + 1
                        set ok to map_insert(pending and "args_list" and pending_args)
                        
                        free_list(args_list)
                        free_list(values_list)
                        set ok to tools_set_active_session("")
                        return "PENDING_APPROVAL"
                else:
                    # Approval was granted — clear the flag and proceed
                    set ok to map_insert(ctx and "tool_approved" and 0)
            
            # --- Observer Security Audit (for dangerous commands) ---
            # E4: turing_grid_op(execute) runs a grid cell as a shell command — treat it
            # as a shell-exec sink and audit it like run_command (it's also admin-only
            # via tools_is_action_allowed).
            set is_grid_exec to 0
            if tool_name equals "turing_grid_op":
                if length_list(args_list) >= 1:
                    if get_list(args_list and 0) equals "execute":
                        set is_grid_exec to 1
            if tool_name equals "run_command" or else tool_name equals "codebase_write" or else tool_name equals "self_prompt_set" or else is_grid_exec == 1:
                set audit_payload to ""
                if tool_name equals "run_command":
                    if length_list(args_list) >= 1:
                        set cmd_arg to get_list(args_list and 0)
                        set audit_payload to concat("run_command: " and cmd_arg)
                else if is_grid_exec == 1:
                    set audit_payload to "turing_grid_op execute: runs a Turing-grid cell as a shell command"
                else if tool_name equals "self_prompt_set":
                    # F6: the agent rewriting its own behavior/skills is a powerful act — audit it.
                    if length_list(args_list) >= 1:
                        set sec_arg to get_list(args_list and 0)
                        set audit_payload to concat("self_prompt_set: agent is rewriting its own prompt section " and sec_arg)
                else:
                    if length_list(args_list) >= 1:
                        set path_arg to get_list(args_list and 0)
                        set audit_payload to concat("codebase_write: " and path_arg)
                
                if string_length(audit_payload) > 0:
                    set audit_map to observer_audit(ctx and current_prompt and audit_payload)
                    set verdict to map_get_val(audit_map and "verdict")
                    if verdict equals "BLOCKED":
                        # If the human already approved this action (via the approval gate
                        # or auto_approve), the observer's BLOCKED verdict is advisory only.
                        # The human is the authority — the observer cannot overrule explicit
                        # human approval. The concern is still logged for transparency.
                        if needs_approval == 1:
                            set block_reason to map_get_val(audit_map and "reason")
                            display f"Observer audit: BLOCKED (overridden by human approval). Reason: {block_reason}"
                            set ok to trace_emit(trace_db and trace_sid and "audit" and f"Observer: BLOCKED (human-approved, advisory only) — {block_reason}")
                        else:
                            set action_allowed to 0
                            set action_reason to map_get_val(audit_map and "reason")
                    free_map(audit_map)
                    
            set tool_result to ""
            if action_allowed == 0:
                display f"Observer action audit: BLOCKED. Reason: {action_reason}"
                set ok to trace_emit(trace_db and trace_sid and "audit" and f"Observer: BLOCKED — {action_reason}")
                set tool_result to concat("BLOCKED by Observer: " and action_reason)
            else:
                set ok to trace_emit(trace_db and trace_sid and "audit" and "Observer: ALLOWED")
                display f"Executing tool: {tool_name}..."
                set ok to trace_emit(trace_db and trace_sid and "tool_exec" and f"Executing: {tool_name}")
                set tool_result to tools_execute(tools_mgr and ctx and tool_name and args_list)
                display f"Tool result: {tool_result}"
                set ok to trace_emit(trace_db and trace_sid and "tool_result" and substring(tool_result and 0 and 1800))
                
            set ok to append_list(values_list and tool_result)
            
            # Store event in Tier 3 Timeline
            set ok to memory_store(memory_mgr and 3 and f"Action: {tool_name}" and f"Result: {tool_result}")
            
            if tool_name equals "reply_request":
                # Single inference-only audit — all LLM, no hardcoded checks
                set audit_map to observer_audit(ctx and current_prompt and tool_result)
                set verdict to map_get_val(audit_map and "verdict")
                set audit_reason to map_get_val(audit_map and "reason")
                free_map(audit_map)
                
                # Fail-open for reply_request when the observer had a parse failure.
                # reply_request is user-visible text, not a dangerous system action.
                # A parse failure should surface the response rather than silently
                # discard it and re-prompt. Dangerous tools retain fail-closed.
                set is_parse_fail to 0
                if string_contains(audit_reason and "Audit unavailable") == 1:
                    set is_parse_fail to 1
                if verdict equals "ALLOWED" or else is_parse_fail == 1:
                    display "Observer reply audit: ALLOWED. Final response ready."
                    set ok to trace_emit(trace_db and trace_sid and "reply_audit" and "Reply audit: ALLOWED")
                    set final_answer to tool_result
                    set finished to 1
                    set reply_blocks to 0
                else:
                    set reply_blocks to reply_blocks + 1
                    if reply_blocks >= 3:
                        display f"Observer reply audit: BLOCKED {reply_blocks} consecutive times. Delivering last reply to avoid unbounded prompt inflation."
                        set final_answer to tool_result
                        set finished to 1
                    else:
                        display f"Observer reply audit: BLOCKED. Reason: {audit_reason}. Re-prompting ({reply_blocks}/3)..."
                        set ok to trace_emit(trace_db and trace_sid and "reply_audit" and f"Reply audit: BLOCKED — {audit_reason} ({reply_blocks}/3)")
                        # Concise correction — do NOT append the full raw_output (which
                        # added ~700+ chars per blocked turn, inflating the prompt from
                        # 16KB to 43KB over 28 turns and causing the SIGSEGV).
                        set current_prompt to concat(current_prompt and "\n[SELF-CHECK FAIL: INVISIBLE TO USER] Your previous reply was blocked (")
                        set current_prompt to concat(current_prompt and audit_reason)
                        set current_prompt to concat(current_prompt and "). Produce a corrected reply now.\n")
            else:
                # Standard tool observation back to prompt — fit it to the model's
                # remaining context window (derived, never a fixed cap).
                set obs_model to ""
                if map_contains(ctx and "selected_model") == 1:
                    set obs_model to map_get_val(ctx and "selected_model")
                set obs_budget to react_observation_budget(obs_model and string_length(current_prompt))
                set current_prompt to concat(current_prompt and "\n")
                set current_prompt to concat(current_prompt and raw_output)
                # Guard: empty tool results cause the LLM to continuation-complete the
                # Observation line instead of starting a new Thought/Action block.
                set obs_text to tool_result
                if string_length(string_trim(tool_result)) == 0:
                    set obs_text to "[empty result — the tool returned no output]"
                set current_prompt to concat(current_prompt and "\nObservation: ")
                set current_prompt to concat(current_prompt and react_fit_observation(obs_text and obs_budget))
                set current_prompt to concat(current_prompt and "\n")
                
                set denials to 0
                if map_contains(ctx and "consecutive_denials") == 1:
                    set denials to map_get_val(ctx and "consecutive_denials")
                if denials >= 2:
                    set current_prompt to concat(current_prompt and "\n[SYSTEM: The user has denied tool execution twice in a row. You must call reply_request now to return your final answer based on the information you have. Do not use any other tool.]\n")
            # Free args_list AFTER all tool_result consumers (memory_store, observer_audit,
            # observation injection) are done. tool_result may alias args_list elements
            # via get_list — freeing earlier is use-after-free.
            free_list(args_list)
        else:
            display "No valid action parsed. Re-prompting for correct Action grammar..."
            set ok to trace_emit(trace_db and trace_sid and "no_action" and "No valid action parsed, re-prompting")
            # Enforce Turn Boundary Rejection — tell the model EXACTLY what it did wrong
            # and what it must do. Common cause: the LLM continuation-completed an empty
            # Observation instead of starting a new Thought/Action block.
            set current_prompt to concat(current_prompt and "\n")
            set current_prompt to concat(current_prompt and raw_output)
            set current_prompt to concat(current_prompt and "\n[FORMAT VIOLATION — YOUR OUTPUT ABOVE WAS INVALID]\nYour last output did NOT contain a valid Action call. What went wrong:\n1. You may have output raw data or continued from a previous Observation — stop. The Observation is COMPLETE. Move on.\n2. You may have written prose without calling any tool.\n\nYou MUST now output EXACTLY this format:\nThought: <your reasoning about what to do next>\nAction: <tool_name>([\"<arg1>\"])\n\nTo reply to the user: Action: reply_request([\"your response\"])\nTo call a tool: Action: <tool_name>([\"arg\"])\n\nDo NOT continue or amend the previous Observation. It is finished. Output your next Thought and Action now.\n")
            
        set loop_idx to loop_idx + 1

    # E3: if the loop exited on the iteration cap (not a natural reply_request), abort
    # instead of spinning — a model that never replies would otherwise run forever with
    # an ever-growing prompt (cost/compute DoS).
    if finished == 0:
        display f"[ReAct] Iteration cap ({max_iters}) reached — aborting."
        set ok to trace_emit(trace_db and trace_sid and "done" and f"Iteration cap ({max_iters}) reached")
        set final_answer to "I could not complete this request within the allowed number of steps."
    free_list(values_list)
    set ok to tools_set_active_session("")
    return final_answer


define react_resume_approved with model as Map and memory_mgr as Map and tools_mgr as Map and ctx as Map and approved as Int and auto_approve_flag as Int returning Str:
    # Resume execution after a tool approval/denial decision
    set pending to map_get_val(ctx and "pending_action")
    if pending == 0:
        return "Error: No pending action to resume."
    
    set tool_name to map_get_val(pending and "tool_name")
    set args_list to map_get_val(pending and "args_list")
    set current_prompt to map_get_val(pending and "prompt_state")
    set raw_output to map_get_val(pending and "raw_output")
    set trace_db to storage_get_db()
    set trace_sid to ""
    if map_contains(ctx and "session_id") == 1:
        set trace_sid to map_get_val(ctx and "session_id")
    
    set loop_idx to 0
    if map_contains(pending and "loop_idx") == 1:
        set loop_idx to map_get_val(pending and "loop_idx")

    # Restore the role captured when this action was queued, so the approved tool
    # runs with the original caller's authority (admin/owner) instead of the empty
    # role the IPC layer left behind. Without this, every approved admin tool is
    # denied. Must happen before pending is cleared below.
    set saved_role to ""
    if map_contains(pending and "sender_role") == 1:
        set saved_role to map_get_val(pending and "sender_role")
    set ok to map_insert(ctx and "sender_role" and saved_role)

    # Clear the pending action
    set ok to map_delete(ctx and "pending_action")
    
    set denials to 0
    if map_contains(ctx and "consecutive_denials") == 1:
        set denials to map_get_val(ctx and "consecutive_denials")

    if approved == 1:
        set denials to 0
    else:
        set denials to denials + 1
    set ok to map_insert(ctx and "consecutive_denials" and denials)

    set tool_result to ""
    if approved == 1:
        display f"User APPROVED tool: {tool_name}. Executing..."
        
        # Run observer security audit for dangerous commands before executing
        set action_allowed to 1
        if tool_name equals "run_command" or else tool_name equals "codebase_write" or else tool_name equals "self_prompt_set":
            set audit_payload to ""
            if tool_name equals "run_command":
                if length_list(args_list) >= 1:
                    set cmd_arg to get_list(args_list and 0)
                    set audit_payload to concat("run_command: " and cmd_arg)
            else if tool_name equals "self_prompt_set":
                if length_list(args_list) >= 1:
                    set sec_arg to get_list(args_list and 0)
                    set audit_payload to concat("self_prompt_set: agent is rewriting its own prompt section " and sec_arg)
            else:
                if length_list(args_list) >= 1:
                    set path_arg to get_list(args_list and 0)
                    set audit_payload to concat("codebase_write: " and path_arg)

            if string_length(audit_payload) > 0:
                set audit_map to observer_audit(ctx and current_prompt and audit_payload)
                set verdict to map_get_val(audit_map and "verdict")
                if verdict equals "BLOCKED":
                    # Since this is react_resume_approved, the action has been explicitly
                    # approved by the human user. The observer's BLOCKED verdict is advisory
                    # only and does not prevent execution.
                    set block_reason to map_get_val(audit_map and "reason")
                    display f"Observer audit: BLOCKED (overridden by human approval). Reason: {block_reason}"
                    set ok to trace_emit(trace_db and trace_sid and "audit" and f"Observer: BLOCKED (human-approved, advisory only) — {block_reason}")
                free_map(audit_map)
        
        if action_allowed == 1:
            set tool_result to tools_execute(tools_mgr and ctx and tool_name and args_list)
            display f"Tool result: {tool_result}"
    else:
        display f"User DENIED tool: {tool_name}. Skipping."
        # F2: distinguish a USER decision from a policy gate. The user actively chose
        # not to run this — acknowledge it, do not retry, and ask what they want instead.
        set tool_result to f"[USER DECLINED] The user chose not to run '{tool_name}'. This was the user's decision, not a system error or your own limitation. Acknowledge their choice, do NOT retry the same action, and ask what they would like to do instead."
    
    # Store event in Tier 3 Timeline
    set ok to memory_store(memory_mgr and 3 and f"Action: {tool_name}" and f"Result: {tool_result}")
    
    if tool_name equals "reply_request" and approved == 1:
        # reply_request was approved — run observer audit on the reply content
        set audit_map to observer_audit(ctx and current_prompt and tool_result)
        set verdict to map_get_val(audit_map and "verdict")
        set audit_reason to map_get_val(audit_map and "reason")
        free_map(audit_map)
        if verdict equals "ALLOWED":
            return tool_result
    
    # Inject the result as an Observation and re-enter the main loop — fit it to
    # the model's remaining context window (derived, never a fixed cap).
    set obs_model to ""
    if map_contains(ctx and "selected_model") == 1:
        set obs_model to map_get_val(ctx and "selected_model")
    set obs_budget to react_observation_budget(obs_model and string_length(current_prompt))
    set current_prompt to concat(current_prompt and "\n")
    set current_prompt to concat(current_prompt and raw_output)
    set current_prompt to concat(current_prompt and "\nObservation: ")
    set current_prompt to concat(current_prompt and react_fit_observation(tool_result and obs_budget))
    set current_prompt to concat(current_prompt and "\n")
    
    if denials >= 2:
        set current_prompt to concat(current_prompt and "\n[SYSTEM: The user has denied tool execution twice in a row. You must call reply_request now to return your final answer based on the information you have. Do not use any other tool.]\n")

    # Set approval flag so the loop can continue without re-gating
    set ok to map_insert(ctx and "tool_approved" and 0)
    
    set values_list to create_list()
    set ok to append_list(values_list and current_prompt)

    return react_run_loop(model and memory_mgr and tools_mgr and ctx and current_prompt and loop_idx + 1 and values_list and auto_approve_flag)


# F3: resume after the user answers a clarification (or chooses to proceed). Injects
# the answers as an Observation and re-enters the loop. The "__USE_CURRENT__"
# sentinel means "work with what we have" — stop asking and finish.
define react_resume_clarify with model as Map and memory_mgr as Map and tools_mgr as Map and ctx as Map and answers as Str and auto_approve_flag as Int returning Str:
    set pending to map_get_val(ctx and "pending_clarification")
    if pending == 0:
        return "Error: No pending clarification to resume."
    set current_prompt to map_get_val(pending and "prompt_state")
    set raw_output to map_get_val(pending and "raw_output")
    set loop_idx to 0
    if map_contains(pending and "loop_idx") == 1:
        set loop_idx to map_get_val(pending and "loop_idx")
    set saved_role to ""
    if map_contains(pending and "sender_role") == 1:
        set saved_role to map_get_val(pending and "sender_role")
    set ok to map_insert(ctx and "sender_role" and saved_role)
    set ok to map_delete(ctx and "pending_clarification")

    set obs to ""
    if answers equals "__USE_CURRENT__":
        set ok to map_insert(ctx and "clarify_done" and 1)
        set obs to "The user chose to proceed with the information already available. Do NOT ask for more clarification; complete the task now with your best understanding."
    else:
        set obs to concat("The user answered your clarifying question(s): " and answers)

    set ok to memory_store(memory_mgr and 3 and "Clarification" and obs)

    set obs_model to ""
    if map_contains(ctx and "selected_model") == 1:
        set obs_model to map_get_val(ctx and "selected_model")
    set obs_budget to react_observation_budget(obs_model and string_length(current_prompt))
    set current_prompt to concat(current_prompt and "\n")
    set current_prompt to concat(current_prompt and raw_output)
    set current_prompt to concat(current_prompt and "\nObservation: ")
    set current_prompt to concat(current_prompt and react_fit_observation(obs and obs_budget))
    set current_prompt to concat(current_prompt and "\n")

    set values_list to create_list()
    set ok to append_list(values_list and current_prompt)
    return react_run_loop(model and memory_mgr and tools_mgr and ctx and current_prompt and loop_idx + 1 and values_list and auto_approve_flag)


define react_run with model as Map and memory_mgr as Map and tools_mgr as Map and ctx as Map and user_prompt as Str returning Str:
    set active_runs to 0
    if map_contains(ctx and "active_runs") == 1:
        set active_runs to map_get_val(ctx and "active_runs")
    
    set max_runs to 4
    if map_contains(ctx and "resource_profile") == 1:
        set profile to map_get_val(ctx and "resource_profile")
        if profile equals "low":
            set max_runs to 1
        else if profile equals "standard":
            set max_runs to 2
        else if profile equals "extreme":
            set max_runs to 16
        else if profile equals "high":
            set max_runs to 8
    # Per-request override for operators who know their hardware.
    if map_contains(ctx and "max_concurrent_runs") == 1:
        set mc to map_get_val(ctx and "max_concurrent_runs")
        if mc > 0:
            set max_runs to mc

    if active_runs >= max_runs:
        return "Error: System is at capacity (concurrency limit reached). Please try again later."
        
    set ok to map_insert(ctx and "active_runs" and active_runs + 1)

    set ok to map_insert(ctx and "auto_approve" and 0)
    # Drain any stale whispers left over from a previous query. Without this,
    # whispers written during query A but not consumed before it finished would
    # bleed into query B's first LLM call.
    set stale_sid to ""
    if map_contains(ctx and "session_id") == 1:
        set stale_sid to map_get_val(ctx and "session_id")
    set stale_whispers to react_drain_whispers(stale_sid)
    if string_length(stale_whispers) > 0:
        display f"[ReAct] Discarded {string_length(stale_whispers)} chars of stale whispers from previous query."
    set sanitized_user_prompt to prompt_sanitize_input(user_prompt)
    # Trigger Hebbian learning on prompt concepts
    set ok to react_hebbian_trigger(memory_mgr and sanitized_user_prompt)
    
    # Context window compression check
    set sessions_mgr to map_get_val(ctx and "sessions")
    if sessions_mgr != 0:
        set sess to session_manager_get_active(sessions_mgr)
        if sess != 0:
            set selected_model to map_get_val(ctx and "selected_model")
            set ok to session_compress_active(sessions_mgr and sess and selected_model)

    set history to create_list()
    set values_list to create_list()
    set ok to append_list(values_list and history)
    
    set sender_role to ""
    if map_contains(ctx and "sender_role") == 1:
        set sender_role to map_get_val(ctx and "sender_role")
    
    set local_tools_mgr to tools_create(sender_role)
    set tools_schema to map_get_val(local_tools_mgr and "schemas")
    set ok to map_insert(ctx and "tools_schema" and tools_schema)
    set assembled_prompt to prompt_assemble(memory_mgr and ctx and sanitized_user_prompt and tools_schema)
    set ok to append_list(values_list and assembled_prompt)
    
    set res to react_run_loop(model and memory_mgr and local_tools_mgr and ctx and assembled_prompt and 0 and values_list and 0)
    
    set ok to map_delete(ctx and "tools_schema")
    set active_runs to map_get_val(ctx and "active_runs")
    if active_runs > 0:
        set ok to map_insert(ctx and "active_runs" and active_runs - 1)

    # Emit final trace event and schedule cleanup
    set trace_db to storage_get_db()
    set trace_sid to ""
    if map_contains(ctx and "session_id") == 1:
        set trace_sid to map_get_val(ctx and "session_id")
    set ok to trace_emit(trace_db and trace_sid and "done" and "Final answer ready")

    return res
