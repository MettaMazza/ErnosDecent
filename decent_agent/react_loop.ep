# ErnosPlain Rebuild of ErnOS Agent ReAct Loop Coordinator
# Component: decent_agent/react_loop.ep

import "collections"
import "string"
import "json"
import "llm"

import "prompt"
import "tools"
import "./access"
import "./orchestrator"
import "memory"
import "observer"
import "reply_format"
import "session"
import "sync"
import "trace"
import "../storage"
import "sql"

# Global cancel-all flag (C-level; injected by build.sh). A plain process word set by the
# web thread's /api/cancel and read here at each turn boundary. Used instead of a SQLite
# row (which contends on the global SQLite mutex and, under DB-heavy turns, delayed the
# cancel by seconds) and instead of a cross-thread ErnosPlain map (which would mutate a
# GC-managed object from another thread). ep_cancel_get takes a dummy arg for ABI parity.
external define ep_cancel_set with v returning Int
external define ep_cancel_get with dummy returning Int
# SAFETY: cancel EPOCH (monotonic latch) — the consume-once flag above could only halt
# ONE of N concurrent runs (main agent + sub-agents + background coordinators): whoever
# read it first cleared it. Every run now captures the epoch at its start and halts when
# the current value is GREATER; nothing consumes, so a single Stop halts EVERYTHING at
# once, and runs started after the Stop are unaffected. Any targeted cancel (per-session
# map/row) also BUMPS the epoch so a Stop from any surface is a global stop.
external define ep_cancel_epoch_get with dummy returning Int
external define ep_cancel_epoch_bump with dummy returning Int

# F4: cooperative cancellation registry. A Stop button / `AI CANCEL` IPC sets a
# per-session flag on a SEPARATE connection while react_run_loop is blocked on the
# first; the loop checks (and consumes) it at each turn boundary and halts cleanly.
# Mutex-guarded because requester and runner are different threads. An empty
# session id normalises to "default" so both sides agree on a key.
set RUN_CANCEL_MAP to create_map()
set RUN_CANCEL_LOCK to create_mutex()

# Concurrency model: agents run as cooperative ASYNC TASKS on a single thread (the
# LLM call yields at `await http_post_async`). The main user turn and every background
# sub-agent interleave at those await points on ONE thread, so there is no concurrent
# heap access and no GC race — and therefore no global run lock is needed. (An earlier
# thread-based design used a process-wide lock here; it's gone with the move to async.)

define react_cancel_key with session_id as Str returning Str:
    if string_length(session_id) == 0:
        return "default"
    return session_id

# Request cancellation of the active run for a session (called from the IPC handler).
define react_request_cancel with session_id as Str returning Int:
    set key to react_cancel_key(session_id)
    set ok to lock_mutex(RUN_CANCEL_LOCK)
    set ok to map_insert(RUN_CANCEL_MAP and key and 1)
    set ok to unlock_mutex(RUN_CANCEL_LOCK)
    
    # Also write to SQLite DB
    set db to storage_get_db()
    if db != 0:
        set es to string_replace(key and "'" and "''")
        set ok to sql_execute(db and f"INSERT OR REPLACE INTO trace_cancellations (session_id) VALUES ('{es}');")
    return 0

# Check a pending cancellation (called by every run at its turn boundaries).
# run_epoch is the cancel epoch the RUN captured at its start: any bump since then
# halts this run — compared, never consumed, so all concurrent runs see one Stop.
# Targeted cancels (per-session map/SQLite rows) are consumed as before, but ALSO bump
# the epoch: a Stop from any surface halts the whole system and every sub-agent.
define react_check_cancel with session_id as Str and run_epoch as Int returning Int:
    # 1. Epoch latch — cheapest check first; catches a Stop from ANY surface.
    if ep_cancel_epoch_get(0) > run_epoch:
        return 1

    set key to react_cancel_key(session_id)
    set ok to lock_mutex(RUN_CANCEL_LOCK)
    set hit to map_contains(RUN_CANCEL_MAP and key)
    if hit == 1:
        set ok to map_delete(RUN_CANCEL_MAP and key)
    set ok to unlock_mutex(RUN_CANCEL_LOCK)
    if hit == 1:
        set ok to ep_cancel_epoch_bump(0)
        return 1

    # Legacy consume-once flag (older callers of ep_cancel_set) — translate to a bump.
    if ep_cancel_get(0) == 1:
        set ok to ep_cancel_set(0)
        set ok to ep_cancel_epoch_bump(0)
        return 1

    # SQLite rows: the per-session 'AI CANCEL' path and the '__CANCEL_ALL__' sentinel
    # the bridge writes directly when the (single-threaded, busy) IPC daemon cannot be
    # reached mid-run. Consumed here, then broadcast via the epoch.
    set db to storage_get_db()
    if db != 0:
        set es to string_replace(key and "'" and "''")
        set rows to sql_query(db and f"SELECT COUNT(*) FROM trace_cancellations WHERE session_id='{es}' OR session_id='__CANCEL_ALL__';")
        if length_list(rows) > 0:
            set first_row to get_list(rows and 0)
            set count_str to get_list(first_row and 0)
            if string_to_int(count_str) > 0:
                set ok to sql_execute(db and f"DELETE FROM trace_cancellations WHERE session_id='{es}' OR session_id='__CANCEL_ALL__';")
                set ok to ep_cancel_epoch_bump(0)
                return 1
    return 0

# Drain guidance addressed to this exact active turn. Empty target ids remain valid for
# sub-agent steering, whose task id already uniquely identifies its running turn.
define react_drain_whispers with session_id as Str and turn_id as Str returning Str:
    set db to storage_get_db()
    if db == 0:
        return ""
    set key to session_id
    if string_length(key) == 0:
        set key to "default"
    set es to string_replace(key and "'" and "''")
    set et to string_replace(turn_id and "'" and "''")
    set rows to sql_query(db and f"SELECT id, content FROM trace_whispers WHERE session_id='{es}' AND (target_turn_id='' OR target_turn_id='{et}') ORDER BY id;")
    set count to length_list(rows)
    if count == 0:
        return ""
    set out to ""
    set idx to 0
    repeat while idx < count:
        set row to get_list(rows and idx)
        set w_id to get_list(row and 0)
        set w_content to get_list(row and 1)
        set out to concat(out and f"- {w_content}\n")
        set ok to sql_execute(db and f"DELETE FROM trace_whispers WHERE id={w_id};")
        set idx to idx + 1
    return out

# Remove only guidance explicitly bound to a different, already-ended turn. This
# prevents bleed-through without discarding guidance that arrived in the accept/start
# race for the current turn.
define react_discard_stale_whispers with session_id as Str and turn_id as Str returning Int:
    set db to storage_get_db()
    if db == 0:
        return 1
    set key to session_id
    if string_length(key) == 0:
        set key to "default"
    set es to string_replace(key and "'" and "''")
    set et to string_replace(turn_id and "'" and "''")
    return sql_execute(db and f"DELETE FROM trace_whispers WHERE session_id='{es}' AND target_turn_id != '' AND target_turn_id != '{et}';")

# Write a mid-turn message from the agent to the user via trace_events.
# The Discord bridge picks up events with type 'mid_message' and posts them
# in the main channel, NOT in the trace thread. Does NOT end the react loop.
define react_write_mid_message with session_id as Str and content as Str returning Int:
    set db to storage_get_db()
    if db == 0:
        return 1
    set key to session_id
    if string_length(key) == 0:
        set key to "default"
    set es to string_replace(key and "'" and "''")
    set ec to string_replace(content and "'" and "''")
    set ok to sql_execute(db and f"INSERT INTO trace_events (session_id, event_type, content, created_at, sent) VALUES ('{es}', 'mid_message', '{ec}', strftime('%s','now'), 0);")
    return ok

# Remove stray harmony/gemma channel-marker tokens from a string. Longer variants
# are stripped before their unterminated forms so nothing is left behind.
define react_strip_markers with s as Str returning Str:
    set out to s
    set out to string_replace(out and "<|thought|>" and "")
    set out to string_replace(out and "<|thought|" and "")
    set out to string_replace(out and "<|channel|>" and "")
    set out to string_replace(out and "<channel|>" and "")
    set out to string_replace(out and "<channel|" and "")
    set out to string_replace(out and "<|message|>" and "")
    set out to string_replace(out and "<|message|" and "")
    set out to string_replace(out and "<|start|>" and "")
    set out to string_replace(out and "<|end|>" and "")
    set out to string_replace(out and "<|assistant|>" and "")
    return out

# F1 (generalized): separate a turn's native reasoning from its ReAct content.
# Different local models emit reasoning differently: <think>...</think> (deepseek/
# qwen), or harmony/gemma channel markers like <|thought|> ... <channel|>Action:...
# (gemma4:26b). We capture the reasoning as its own channel and strip ALL of these
# markers so they never confuse action parsing or leak to the user. Returns
# {reasoning, clean}.
define react_extract_reasoning with text as Str returning Map:
    set result to create_map()
    set reasoning to ""
    set work to text

    # 1. <think>...</think>
    set open_pos to string_index_of(work and "<think>")
    if open_pos >= 0:
        set close_pos to string_index_of(work and "</think>")
        if close_pos < 0:
            set reasoning to concat(reasoning and substring(work and open_pos + 7 and string_length(work) - open_pos - 7))
            set work to substring(work and 0 and open_pos)
        else:
            set reasoning to concat(reasoning and substring(work and open_pos + 7 and close_pos - open_pos - 7))
            set before to substring(work and 0 and open_pos)
            set after_start to close_pos + 8
            set work to concat(before and substring(work and after_start and string_length(work) - after_start))

    # 2. Harmony/gemma: the final channel output follows the LAST <channel|> marker;
    #    everything before it is reasoning.
    set ch_pos to string_last_index_of(work and "<channel|>")
    if ch_pos >= 0:
        set reasoning to concat(reasoning and concat("\n" and substring(work and 0 and ch_pos)))
        set after_ch to ch_pos + 10
        set work to substring(work and after_ch and string_length(work) - after_ch)

    # 3. Strip any remaining stray marker tokens from both channels.
    set work to react_strip_markers(work)
    set reasoning to react_strip_markers(reasoning)

    set ok to map_insert(result and "reasoning" and string_trim(reasoning))
    set ok to map_insert(result and "clean" and string_trim(work))
    return result

# Characters of tool output we can fold into the prompt this turn, derived from
# the model's OWN context window (get_model_context_limit, which already scales by
# model + system RAM) minus what the prompt already holds. This is NOT a fixed
# cap: a 200k-token model (gemma4) gets ~hundreds of KB of headroom, an 8k model
# proportionally less. We convert tokens→chars at ~3.5 chars/token (BPE average
# for mixed prose + paths/code; deliberately low so we under-estimate the window
# and never overflow it) and reserve 25% of the window for the model's reply and
# the loop's remaining turns. Returns the remaining char budget (can be negative
# when the prompt has already filled the window).
define react_observation_budget with model_name as Str and prompt_len as Int returning Int:
    set ctx_tokens to get_model_context_limit(model_name)
    set window_chars to (ctx_tokens * 7) / 2
    set usable to (window_chars * 3) / 4
    return usable - prompt_len

# Fit a tool result into the per-turn budget. If it fits, it passes through whole.
# If not, keep the head that fits and tell the model it was clipped (with the real
# total) so it narrows its next query instead of silently losing the tail or
# blowing up the inference call. A small floor guarantees the model always sees
# some of the output even when the window is nearly full.
define react_fit_observation with text as Str and budget as Int returning Str:
    set room to budget
    set min_room to 2048
    if room < min_room:
        set room to min_room
    set n to string_length(text)
    if n <= room:
        return text
    set notice to f"\n\n[OUTPUT TRUNCATED to fit the model context window: {n} chars total, {room} kept. Narrow your request — target a specific directory, add a depth/count limit, or filter — and do not recurse into build/cache dirs (target/, node_modules/, .git/, deps/).]"
    set keep to room - string_length(notice)
    if keep < 0:
        set keep to 0
    set head to substring(text and 0 and keep)
    return concat(head and notice)

# Extract the raw string content from a JSON-like args_str (e.g. '["some text"]')
# by stripping the outer [" and "] wrappers. Used as a fallback when json_parse
# is confused by unescaped inner quotes from the LLM.
define react_extract_raw_arg with args_str as Str returning Str:
    set slen to string_length(args_str)
    if slen < 4:
        return args_str
    # Find the opening quote after '[' (skip whitespace)
    set start to 0
    set found_start to 0
    repeat while start < slen and found_start == 0:
        set ch to get_character(args_str and start)
        if ch == 34: # '"'
            set found_start to 1
        else:
            set start to start + 1
    if found_start == 0:
        return args_str
    # Find the closing quote before ']' (scan from end)
    set end_pos to slen - 1
    set found_end to 0
    repeat while end_pos > start and found_end == 0:
        set ch to get_character(args_str and end_pos)
        if ch == 34: # '"'
            set found_end to 1
        else:
            set end_pos to end_pos - 1
    if found_end == 0:
        return args_str
    # Extract content between the outermost quotes
    set content_start to start + 1
    set content_len to end_pos - content_start
    if content_len <= 0:
        return args_str
    return substring(args_str and content_start and content_len)

# Find a protocol marker only when it begins a real line (allowing indentation) and is
# outside a fenced code/example block. Inline/backticked/quoted examples cannot execute.
define react_find_line_marker_from with raw as Str and marker as Str and from_pos as Int returning Int:
    set raw_len to string_length(raw)
    set marker_len to string_length(marker)
    set raw_lower to string_lower(raw)
    set marker_lower to string_lower(marker)
    set minimum_pos to from_pos
    if minimum_pos < 0:
        set minimum_pos to 0
    # Always scan from the beginning so fenced-block state is correct even when a
    # batched-action search begins in the middle of the response.
    set line_start to 0
    set in_fence to 0

    repeat while line_start < raw_len:
        set candidate to line_start
        set skipping_indent to 1
        repeat while candidate < raw_len and skipping_indent == 1:
            set indent_ch to get_character(raw and candidate)
            if indent_ch == 32 or else indent_ch == 9:
                set candidate to candidate + 1
            else:
                set skipping_indent to 0
        set fence_line to 0
        if candidate + 3 <= raw_len:
            if substring(raw and candidate and 3) equals "```":
                set fence_line to 1
                if in_fence == 0:
                    set in_fence to 1
                else:
                    set in_fence to 0
        if fence_line == 0 and also in_fence == 0 and also candidate >= minimum_pos:
            if candidate + marker_len <= raw_len:
                set marker_candidate to substring(raw_lower and candidate and marker_len)
                if marker_candidate equals marker_lower:
                    return candidate

        set finding_end to 1
        repeat while line_start < raw_len and finding_end == 1:
            set line_ch to get_character(raw and line_start)
            set line_start to line_start + 1
            if line_ch == 10 or else line_ch == 13:
                set finding_end to 0
    return -1

define react_find_protocol_marker_from with raw as Str and from_pos as Int returning Int:
    set action_pos to react_find_line_marker_from(raw and "action:" and from_pos)
    set call_pos to react_find_line_marker_from(raw and "call:" and from_pos)
    if action_pos < 0:
        return call_pos
    if call_pos >= 0 and also call_pos < action_pos:
        return call_pos
    return action_pos

# Plain final prose is already a valid user response even when a model omits the ReAct
# wrapper. Recover it deterministically instead of paying for another inference and
# feeding a format error back into the conversation. Thought/Observation continuations
# and attempted action lines still go through the explicit correction path.
define react_is_implicit_reply with raw as Str returning Int:
    set clean to string_trim(raw)
    if string_length(clean) == 0:
        return 0
    set clean_lower to string_lower(clean)
    if string_index_of(clean_lower and "thought:") == 0:
        return 0
    if string_index_of(clean_lower and "observation:") == 0:
        return 0
    if react_find_line_marker_from(clean and "action:" and 0) >= 0:
        return 0
    if react_find_line_marker_from(clean and "call:" and 0) >= 0:
        return 0
    return 1

# A model response is one protocol variant, never a mixture. Tool turns may have a
# single explicit Thought prefix followed by Action lines; final prose has no Action
# marker and is handled by react_is_implicit_reply. Any other prose before an action
# is an invalid mixed response and must be regenerated, not silently discarded.
define react_action_prefix_is_valid with raw as Str and action_start as Int returning Int:
    if action_start <= 0:
        return 1
    set prefix to string_trim(substring(raw and 0 and action_start))
    if string_length(prefix) == 0:
        return 1
    set lower to string_lower(prefix)
    if string_index_of(lower and "thought:") != 0:
        return 0
    # A tool turn permits exactly one Thought line before the first Action. This
    # prevents "Thought: ...\n<final prose>\nAction: ..." from executing the tool
    # while silently discarding the prose.
    set first_nl to string_index_of(prefix and "\n")
    if first_nl >= 0:
        set after_thought to string_trim(substring(prefix and first_nl + 1 and string_length(prefix) - first_nl - 1))
        if string_length(after_thought) > 0:
            return 0
    return 1

# Validate the WHOLE tool response before executing its first Action. The previous
# guard checked only the prefix, so user-facing prose after the final Action was
# discarded by the batch slicer. For asynchronous/non-idempotent tools that turned a
# single request into repeated real dispatches. Only whitespace may occur between or
# after Action calls.
define react_action_turn_is_valid with raw as Str and first_start as Int and first_end as Int returning Int:
    if react_action_prefix_is_valid(raw and first_start) == 0:
        return 0
    set raw_len to string_length(raw)
    set current_end to first_end
    repeat while current_end < raw_len:
        set next_pos to react_find_protocol_marker_from(raw and current_end)
        if next_pos < 0:
            set tail to string_trim(substring(raw and current_end and raw_len - current_end))
            if string_length(tail) > 0:
                return 0
            return 1
        set gap to string_trim(substring(raw and current_end and next_pos - current_end))
        if string_length(gap) > 0:
            return 0
        set remainder to substring(raw and next_pos and raw_len - next_pos)
        set next_action to react_parse_action(remainder)
        if map_get_val(next_action and "found") == 0:
            free_map(next_action)
            return 0
        if map_get_val(next_action and "start_pos") != 0:
            free_map(next_action)
            return 0
        set current_end to next_pos + map_get_val(next_action and "end_pos")
        free_map(next_action)
    return 1

# Typed controller policy for tools whose successful execution IS the completion of
# the foreground request. Kept as a pure helper so terminal lifecycle and asynchronous
# dispatch invariants are regression-testable without invoking either real tool.
define react_tool_result_finishes_turn with tool_name as Str and action_allowed as Int and tool_result as Str returning Int:
    if action_allowed == 0:
        return 0
    if tool_name equals "generate_image":
        if string_index_of(tool_result and "ERROR:") != 0:
            return 1
    if tool_name equals "session_terminate":
        if string_index_of(tool_result and "Session closed by Echo.") == 0:
            return 1
    return 0

define react_parse_action with raw as Str returning Map:
    set result to create_map()
    set ok to map_insert(result and "found" and 0)

    set raw_len to string_length(raw)
    set raw_lower to string_lower(raw)
    set search_from to 0
    set pos to react_find_protocol_marker_from(raw and search_from)
    set marker_len to 0
    set tool_name_start to 0
    set tool_name_end to 0
    set start_args to -1
    set valid_header to 0

    # Skip malformed or illustrative marker lines and keep looking for the first
    # syntactically valid protocol action. This handles a quoted/example `Action:` line
    # before the real action without executing prose or discarding the valid call.
    repeat while pos >= 0 and valid_header == 0:
        set marker_len to 7
        if pos + 5 <= raw_len:
            if substring(raw_lower and pos and 5) equals "call:":
                set marker_len to 5
        set tool_name_start to pos + marker_len
        set skip_done to 0
        repeat while tool_name_start < raw_len and skip_done == 0:
            set ch to get_character(raw and tool_name_start)
            if ch == 32 or else ch == 9:
                set tool_name_start to tool_name_start + 1
            else:
                set skip_done to 1

        set first_name_ok to 0
        if tool_name_start < raw_len:
            set first_name_ch to get_character(raw and tool_name_start)
            if first_name_ch >= 65 and also first_name_ch <= 90:
                set first_name_ok to 1
            if first_name_ch >= 97 and also first_name_ch <= 122:
                set first_name_ok to 1
            if first_name_ch == 95:
                set first_name_ok to 1

        if first_name_ok == 1:
            set tool_name_end to tool_name_start
            set reading_name to 1
            repeat while tool_name_end < raw_len and reading_name == 1:
                set name_ch to get_character(raw and tool_name_end)
                set valid_name_ch to 0
                if name_ch >= 65 and also name_ch <= 90:
                    set valid_name_ch to 1
                if name_ch >= 97 and also name_ch <= 122:
                    set valid_name_ch to 1
                if name_ch >= 48 and also name_ch <= 57:
                    set valid_name_ch to 1
                if name_ch == 95:
                    set valid_name_ch to 1
                if valid_name_ch == 1:
                    set tool_name_end to tool_name_end + 1
                else:
                    set reading_name to 0

            set start_args to tool_name_end
            set skipping_gap to 1
            repeat while start_args < raw_len and skipping_gap == 1:
                set gap_ch to get_character(raw and start_args)
                if gap_ch == 32 or else gap_ch == 9:
                    set start_args to start_args + 1
                else:
                    set skipping_gap to 0
            if start_args < raw_len:
                if get_character(raw and start_args) == 40:
                    set valid_header to 1

        if valid_header == 0:
            set search_from to pos + marker_len
            set pos to react_find_protocol_marker_from(raw and search_from)

    if valid_header == 0:
        return result

    set tool_name to substring(raw and tool_name_start and tool_name_end - tool_name_start)
    set tool_name_trimmed to string_trim(tool_name)
    
    set end_args to -1
    set in_string to 0
    set escaped to 0
    set depth to 1
    set scan_idx to start_args + 1
    set scan_done to 0
    repeat while scan_idx < raw_len and scan_done == 0:
        set ch to get_character(raw and scan_idx)
        if escaped == 1:
            set escaped to 0
        else if ch == 92: # backslash '\'
            set escaped to 1
        else if ch == 34: # double quote '"'
            if in_string == 0:
                set in_string to 1
            else:
                set in_string to 0
        else if in_string == 0:
            if ch == 40: # '('
                set depth to depth + 1
            else if ch == 41: # ')'
                set depth to depth - 1
                if depth == 0:
                    set end_args to scan_idx
                    set scan_done to 1
        set scan_idx to scan_idx + 1

    if end_args < start_args:
        return result
        
    set args_str to substring(raw and start_args + 1 and end_args - start_args - 1)
    
    set ok to map_insert(result and "found" and 1)
    set ok to map_insert(result and "tool_name" and tool_name_trimmed)
    set ok to map_insert(result and "args_str" and args_str)
    # Span of THIS action within `raw` (marker start .. just past the closing paren). Used by
    # the batching queue to slice off any FURTHER actions in the same response without
    # re-matching inside this action's own arguments.
    set ok to map_insert(result and "start_pos" and pos)
    set ok to map_insert(result and "end_pos" and end_args + 1)

    set values_list to create_list()
    set ok to map_insert(result and "values_list" and values_list)
    set ok to append_list(values_list and tool_name_trimmed)
    set ok to append_list(values_list and args_str)
    return result


# Return the substring of `raw` starting at the NEXT line-anchored "Action:" (or "call:") marker at or
# after `from_pos`, or "" if there is none. `from_pos` is the position just past the FIRST
# action's closing paren, so a spurious "action:" inside the first action's arguments is
# never matched. This is what lets the model batch many tools into ONE response: the loop
# runs the first, then feeds this slice back as the next turn's raw_output with NO new
# inference call, and so on until the batch is drained.
define react_slice_from_next_action with raw as Str and from_pos as Int returning Str:
    set raw_len to string_length(raw)
    if from_pos < 0 or else from_pos >= raw_len:
        return ""
    set next_pos to react_find_protocol_marker_from(raw and from_pos)
    if next_pos < 0:
        return ""
    return substring(raw and next_pos and raw_len - next_pos)


# Scan a DROPPED text segment for orphaned tool calls — `name([...])` continuations the
# model emitted WITHOUT an 'Action:' marker (e.g. "Action: a([...]) → b([...]) → c([...])").
# The batching slicer only recognizes Action:/call: markers, so such calls were silently
# skipped (observed live: operate_scheduler list/delete reported "no observation
# returned" — they were never executed). Names are validated against the registered
# schema text ("- <name>(") so prose words never trigger a nudge; the caller injects a
# format note NAMING the dropped calls so the model re-emits them properly. Bare names
# are deliberately NOT auto-executed — tools only run from the auditable Action grammar.
# Segment is capped at 2000 chars (get_character is O(n); dropped segments are small).
define react_find_orphan_calls with segment as Str and schemas as Str returning Str:
    set found to ""
    set n to string_length(segment)
    if n > 2000:
        set n to 2000
    set i to 0
    repeat while i < n - 1:
        set ch to get_character(segment and i)
        if ch == 40:
            if get_character(segment and i + 1) == 91:
                # "([": walk back over [a-z0-9_] to recover the candidate tool name.
                set s to i
                set walking to 1
                repeat while walking == 1 and also s > 0:
                    set pc to get_character(segment and s - 1)
                    set is_ident to 0
                    if pc >= 97 and also pc <= 122:
                        set is_ident to 1
                    if pc >= 48 and also pc <= 57:
                        set is_ident to 1
                    if pc == 95:
                        set is_ident to 1
                    if is_ident == 1:
                        set s to s - 1
                    else:
                        set walking to 0
                if i - s >= 3:
                    set cand to substring(segment and s and i - s)
                    if string_contains(schemas and concat("- " and concat(cand and "("))) == 1:
                        if string_contains(found and cand) == 0:
                            if string_length(found) > 0:
                                set found to concat(found and ", ")
                            set found to concat(found and cand)
        set i to i + 1
    return found


define react_hebbian_trigger with memory_mgr as Map and text as Str returning Int:
    set concepts to create_list()
    set ok to append_list(concepts and "wallet")
    set ok to append_list(concepts and "ledger")
    set ok to append_list(concepts and "dht")
    set ok to append_list(concepts and "consensus")
    set ok to append_list(concepts and "identity")
    set ok to append_list(concepts and "speech")
    set ok to append_list(concepts and "turing")
    set ok to append_list(concepts and "name")
    
    set text_upper to string_upper(text)
    set len to length_list(concepts)
    
    set i to 0
    repeat while i < len:
        set c1 to get_list(concepts and i)
        set c1_upper to string_upper(c1)
        if string_contains(text_upper and c1_upper) == 1:
            set j to i + 1
            repeat while j < len:
                set c2 to get_list(concepts and j)
                set c2_upper to string_upper(c2)
                if string_contains(text_upper and c2_upper) == 1:
                    set ok to memory_strengthen_synapse(memory_mgr and c1 and c2)
                set j to j + 1
        set i to i + 1
        
    free_list(concepts)
    return 0


define react_simulate_inference with prompt as Str and loop_idx as Int returning Str:
    set prompt_upper to string_upper(prompt)
    
    if string_contains(prompt_upper and "AUTO_APPROVE_TEST") == 1:
        if loop_idx == 0:
            return "Thought: I will call money_transfer.\nAction: money_transfer([50, \"did:key:recipient\"])"
        else if loop_idx == 1:
            return "Thought: I will call dht_store.\nAction: dht_store([\"test_key\", \"test_val\"])"
        else:
            return "Thought: I will now reply correctly.\nAction: reply_request([\"ai:agent_rebuild,response:Success\"])"

    if string_contains(prompt_upper and "CONVERGENCE_TEST") == 1:
        if loop_idx == 0:
            return "Thought: I will output a message without a properly formatted Action statement to test loop convergence recovery."
        else:
            return "Thought: I will now reply correctly.\nAction: reply_request([\"ai:agent_rebuild,response:Success\"])"

    set req_pos to string_last_index_of(prompt_upper and "USER REQUEST:")
    set obs_pos to string_last_index_of(prompt_upper and "\nOBSERVATION:")
    if obs_pos > req_pos:
        set observation_text to substring(prompt and obs_pos + 13 and string_length(prompt) - obs_pos - 13)
        return f"Thought: I have received the observation. I will now reply to the user.\nAction: reply_request([\"ai:agent_rebuild,response:Success. Result is: {string_trim(observation_text)}\"])"
        
    if string_contains(prompt_upper and "TURING_GRID_OP") == 1:
        set op_start to string_index_of(prompt and "turing_grid_op(")
        if op_start > 0:
            set op_end to string_index_of(prompt and ")")
            if op_end > op_start:
                set op_args to substring(prompt and op_start + 15 and op_end - op_start - 15)
                return f"Thought: Running Turing Grid operation.\nAction: turing_grid_op({op_args})"
        
    if string_contains(prompt_upper and "RESOLVE NAME ") == 1:
        set name_pos to string_index_of(prompt_upper and "RESOLVE NAME ")
        set name_arg to substring(prompt and name_pos + 13 and string_length(prompt) - name_pos - 13)
        set name_trimmed to string_trim(name_arg)
        return f"Thought: The user wants me to resolve a name. I will call name_resolve.\nAction: name_resolve([\"{name_trimmed}\"])"
        
    if string_contains(prompt_upper and "CHECK BALANCE") == 1 or else string_contains(prompt_upper and "WALLET BALANCE") == 1:
        return "Thought: I need to check the wallet balance. I will call wallet_balance.\nAction: wallet_balance([])"
        
    if string_contains(prompt_upper and "TRANSFER ") == 1:
        return "Thought: I will call money_transfer.\nAction: money_transfer([50, \"did:key:recipient\"])"
        
    return "Thought: I will answer the user request directly.\nAction: reply_request([\"ai:agent_rebuild,response:Hello! I am the ErnOS Agent rebuilt in ErnosPlain. How can I help you today?\"])"


define react_run_loop with model as Map and memory_mgr as Map and tools_mgr as Map and ctx as Map and current_prompt as Str and start_loop_idx as Int and values_list as List and auto_approve_flag as Int returning Str:
    set loop_idx to start_loop_idx
    set final_answer to ""
    set finished to 0
    set reply_blocks to 0
    set override_output to ""
    # SAFETY: capture the cancel epoch at RUN start. Any Stop after this point (from any
    # surface, for any session) makes ep_cancel_epoch_get exceed this and halts the run
    # at its next boundary — while in-flight LLM reads abort within ~1s on their own.
    set run_epoch to ep_cancel_epoch_get(0)
    
    # Check if we are running under automated test suite
    set is_test to 0
    if map_contains(ctx and "is_test") == 1:
        set is_test to map_get_val(ctx and "is_test")
    
    # Check if a model is loaded. If model has no vocab (empty map), run simulation mode.
    set use_simulation to 1
    if map_contains(model and "vocab") == 1:
        set vocab_node to map_get_val(model and "vocab")
        if length_list(vocab_node) > 0:
            set use_simulation to 0

    # Tool-chaining horizon. The loop chains as many tools as the task needs, one per
    # turn; this is only a runaway guard (a model that never replies would otherwise
    # grow the prompt without bound). Default raised to 50 for long-horizon/complex
    # work and overridable per request via ctx "max_iterations".
    set max_iters to 50
    if map_contains(ctx and "max_iterations") == 1:
        set ov to map_get_val(ctx and "max_iterations")
        if ov > 0:
            set max_iters to ov
    repeat while finished == 0 and also loop_idx < max_iters:
        # F4: cancellation checkpoint — halt cleanly between turns (before spending
        # another inference). An in-flight LLM call cannot be interrupted here; that
        # is phase 2 (abortable socket). 'continue' re-checks the while condition,
        # which is now false, so the loop exits.
        set f4_sess to ""
        if map_contains(ctx and "session_id") == 1:
            set f4_sess to map_get_val(ctx and "session_id")
        set ok to tools_set_active_session(f4_sess)
        if react_check_cancel(f4_sess and run_epoch) == 1:
            display "[ReAct] Run halted by user (cancel)."
            set ok to map_insert(ctx and "was_cancelled" and 1)
            set final_answer to "Run halted at your request."
            set finished to 1
            continue
        display f"--- ReAct Loop Turn {loop_idx + 1} ---"
        display f"Prompt character length: {string_length(current_prompt)}"
        set trace_db to storage_get_db()
        set trace_sid to ""
        if map_contains(ctx and "session_id") == 1:
            set trace_sid to map_get_val(ctx and "session_id")
        
        set query_prompt to current_prompt
        # Whisper checkpoint — drain any mid-turn user guidance before the LLM call.
        set trace_turn_id to ""
        if map_contains(ctx and "turn_id") == 1:
            set trace_turn_id to map_get_val(ctx and "turn_id")
        set whispers to react_drain_whispers(trace_sid and trace_turn_id)
        if string_length(whispers) > 0:
            display f"[ReAct] Received mid-turn whisper(s) from user."
            set ok to trace_emit(trace_db and trace_sid and "whisper_received" and whispers)
            set query_prompt to concat(query_prompt and f"\n[MID-TURN USER GUIDANCE — the user has sent additional direction while you are processing. This is NOT a new request — it is live guidance for your CURRENT task. Read it carefully and adjust your approach. You may acknowledge it with mid_message but do NOT end your turn with reply_request unless the user explicitly tells you to stop.]\n{whispers}[/MID-TURN USER GUIDANCE]\n")

        # Sub-agent completion checkpoint — pull any of THIS session's finished
        # background sub-agents and inject their results, labelled distinctly from
        # the user whispers above (these are agent outputs, not user input).
        set sub_orch to 0
        if map_contains(ctx and "orchestrator") == 1:
            set sub_orch to map_get_val(ctx and "orchestrator")
        if sub_orch != 0:
            set sub_done to orchestrator_drain_completed(sub_orch and trace_sid)
            if string_length(sub_done) > 0:
                display f"[ReAct] Incorporating completed sub-agent result(s) mid-turn."
                set ok to trace_emit(trace_db and trace_sid and "subagent_result" and sub_done)
                set query_prompt to concat(query_prompt and concat("\n[SUB-AGENT RESULTS — background agents you dispatched have finished. The following are THEIR outputs (not user input). Use them and report to the user as appropriate.]\n" and concat(sub_done and "[/SUB-AGENT RESULTS]\n")))

        set raw_output to ""
        # A batched turn re-uses a queued action from THIS response (override_output) with no
        # new inference. It must NOT count against max_iters, which guards LLM ROUND-TRIPS, not
        # tool executions — otherwise a legitimate 20-tool batch could trip the runaway cap.
        set is_batched_turn to 0
        if string_length(override_output) > 0:
            set raw_output to override_output
            set override_output to ""
            set is_batched_turn to 1
            display f"[ReAct] Batched action — running queued tool from the same response, no new inference call."
        else:
            set ok to map_delete(ctx and "subagent_turn_auto_approve")
            if is_test == 0:
                set selected_model to ""
                if map_contains(ctx and "selected_model") == 1:
                    set selected_model to map_get_val(ctx and "selected_model")
                set ok to trace_emit(trace_db and trace_sid and "thinking" and f"Querying {selected_model}...")
                set turn_image_path to ""
                if map_contains(ctx and "image_path") == 1:
                    set turn_image_path to map_get_val(ctx and "image_path")
                if string_length(turn_image_path) > 0:
                    display f"[ReAct] Native vision input: {turn_image_path}"
                    set raw_output to query_local_llm_image(query_prompt and turn_image_path and selected_model)
                else:
                    set raw_output to query_local_llm(query_prompt and selected_model)
                
            if string_length(raw_output) == 0:
                if is_test == 1:
                    set raw_output to react_simulate_inference(query_prompt and loop_idx)
                else if use_simulation == 0:
                    set raw_output to inference_run(model and query_prompt and 0 and 200)
                else if ep_cancel_epoch_get(0) > run_epoch:
                    # The empty response came from a Stop-aborted read, not a dead
                    # server — report the halt, not a fake model failure.
                    display "[ReAct] Run halted by user (Stop aborted the in-flight inference)."
                    set ok to map_insert(ctx and "was_cancelled" and 1)
                    set final_answer to "Run halted at your request."
                    set finished to 1
                else:
                    # No LLM available — tell user instead of faking it with hardcoded heuristics
                    display "[ReAct] No LLM response and no local model loaded. Returning error."
                    set final_answer to "Error: No LLM model responded. Please check that your selected model is running in Ollama or LM Studio."
                    set finished to 1
            
        display f"LLM raw response:\n{raw_output}\n----------------"
        set ok to trace_emit(trace_db and trace_sid and "raw_output" and raw_output)
        set ok to append_list(values_list and raw_output)

        # F1: capture this turn's native reasoning (<think>...</think>) as its own
        # channel and strip it from raw_output so it never confuses action parsing or
        # leaks. Preserve it (timeline + ctx) for transparency and the look-back.
        set reason_split to react_extract_reasoning(raw_output)
        set turn_reasoning to map_get_val(reason_split and "reasoning")
        if string_length(turn_reasoning) > 0:
            set raw_output to map_get_val(reason_split and "clean")
            set ok to map_insert(ctx and "last_reasoning" and turn_reasoning)
            set ok to memory_store(memory_mgr and 3 and "REASONING" and turn_reasoning)
            display f"[reasoning] {turn_reasoning}"
            set ok to trace_emit(trace_db and trace_sid and "reasoning" and turn_reasoning)
        # reason_split is NOT freed here: turn_reasoning was extracted from it and
        # inserted into ctx["last_reasoning"]. Freeing the map would invalidate the
        # aliased string — use-after-free → SIGSEGV. Tracked in values_list for GC.
        set ok to append_list(values_list and reason_split)

        # Strengthen synapses based on generated thought
        set ok to react_hebbian_trigger(memory_mgr and raw_output)

        # F5: self-accountability look-back. Review this turn's own output against
        # ErnOS's values via LLM inference; on drift, log it to the timeline and
        # inject a private nudge. Fail-open: clean output does nothing.
        # LATENCY + VALUE: run the look-back ONLY on mid_message turns. reply_request text is
        # already judged by the reply audit (below) against a SUPERSET of these checks, and a
        # pure tool-call turn (search/read/store/run_command) has NO user-facing text to drift
        # on — its reasoning surfaces in a later reply, which IS audited. Firing a full LLM
        # look-back on every intermediate tool step cost ~11–31s each for zero added coverage
        # (measured: one multi-step request spent ~97s in look-back calls, ALL failing
        # "Audit unavailable"). mid_message is the single user-facing output that gets NO reply
        # audit, so it is the only turn where the look-back adds real coverage.
        if string_contains(raw_output and "mid_message") == 1:
            set lookback to observer_lookback(current_prompt and raw_output)
            if map_get_val(lookback and "drift") == 1:
                set lb_note to map_get_val(lookback and "note")
                display f"[Observer look-back] self-correction: {lb_note}"
                set ok to trace_emit(trace_db and trace_sid and "lookback" and lb_note)
                set ok to memory_store(memory_mgr and 3 and "SELF-CHECK" and lb_note)
                set current_prompt to concat(current_prompt and f"\n[SELF-CHECK — INVISIBLE TO USER] Your previous output drifted from your operating values ({lb_note}). Correct course now: speak as ErnOS in the first person, never use pre-trained-assistant disclaimers or claim to be another company's model, and state things plainly. Do not mention this note to the user.\n")
            free_map(lookback)

        set action_map to react_parse_action(raw_output)
        set found_action to map_get_val(action_map and "found")
        set implicit_reply to 0
        if found_action == 0 and also react_is_implicit_reply(raw_output) == 1:
            # The model already wrote the answer; only its transport wrapper is missing.
            # Route the text through the normal reply tool, formatter, Observer and
            # continuity capture without another model call.
            set implicit_reply to 1
            set found_action to 1
            set ok to map_insert(action_map and "found" and 1)
            set ok to map_insert(action_map and "tool_name" and "reply_request")
            set ok to map_insert(action_map and "args_str" and raw_output)
            set ok to map_insert(action_map and "start_pos" and 0)
            set ok to map_insert(action_map and "end_pos" and string_length(raw_output))
            display "[ReAct] Recovered complete plain-text output as an implicit reply_request."
            set ok to trace_emit(trace_db and trace_sid and "implicit_reply" and "Recovered plain-text final answer without an inference retry")
        
        if found_action == 1:
            # Root terminal-contract invariant: never discard native final prose merely
            # because a later Action marker exists. Mixed output is rejected before any
            # tool executes; the model must choose a tool turn OR a final-prose turn.
            if implicit_reply == 0 and also react_action_turn_is_valid(raw_output and map_get_val(action_map and "start_pos") and map_get_val(action_map and "end_pos")) == 0:
                display "[ReAct] Mixed final prose and Action output rejected; no content or tool was executed."
                set ok to trace_emit(trace_db and trace_sid and "no_action" and "Mixed final prose and Action output rejected")
                set current_prompt to concat(current_prompt and "\n[PROTOCOL CORRECTION — INVISIBLE TO USER]\nYour previous response mixed user-facing prose with an Action call. Nothing from it was delivered or executed. Choose exactly one response type: if the task is complete, output the complete answer again as plain final prose with no Thought, Action, JSON, or reply_request wrapper; if a tool is still needed, output only one short Thought line followed by Action lines.\n")
                free_map(action_map)
                if is_batched_turn == 0:
                    set loop_idx to loop_idx + 1
                continue
            set tool_name to map_get_val(action_map and "tool_name")
            set args_str to map_get_val(action_map and "args_str")
            # BATCHING: if the model emitted MORE than one Action: in this single response,
            # queue everything from the 2nd action onward to run on the next loop iterations
            # with NO new inference call. This collapses N independent tool calls from N LLM
            # round-trips (each 20–80s) into ONE. Every queued action still passes through the
            # full approval/audit/observation path below. Pause/finish paths (approval,
            # clarification, reply_request) drop the queue; the model re-emits any remaining
            # steps after the pause, which is self-healing. `assistant_text` records ONLY this
            # action in the transcript when more follow, so chained iterations don't restate the
            # whole remainder each time.
            set batch_rest to react_slice_from_next_action(raw_output and map_get_val(action_map and "end_pos"))
            set assistant_text to raw_output
            # P10: detect orphaned `tool([...])` continuations in the segment the slicer
            # DROPS — between this action's end and the next Action: marker (or the end of
            # the response). If any registered tool appears there without its Action:
            # prefix, a format note (appended after this action's Observation) names it so
            # the model re-emits it properly instead of believing it ran.
            set orphan_nudge to ""
            set a_end to map_get_val(action_map and "end_pos")
            set tail_len to string_length(raw_output) - a_end
            if tail_len > 0:
                set dropped_len to tail_len - string_length(batch_rest)
                if dropped_len > 0:
                    set dropped_seg to substring(raw_output and a_end and dropped_len)
                    set orphan_names to react_find_orphan_calls(dropped_seg and map_get_val(tools_mgr and "schemas"))
                    if string_length(orphan_names) > 0:
                        display f"[ReAct] Orphaned tool calls dropped by the batch slicer: {orphan_names}"
                        set ok to trace_emit(trace_db and trace_sid and "no_action" and f"Orphaned calls not executed: {orphan_names}")
                        set orphan_nudge to f"[FORMAT NOTE — INVISIBLE TO USER] Your response ALSO contained tool call(s) WITHOUT the 'Action:' prefix, which were NOT executed: {orphan_names}. A bare name([...]) in prose does not run. Re-emit each as its own 'Action: <name>([...])' line.\n"
            if string_length(batch_rest) > 0:
                set override_output to batch_rest
                # Record the transcript from the start (keeps any Thought:) THROUGH this action,
                # dropping only the trailing actions that haven't run yet — they get recorded as
                # each one executes on its own chained iteration.
                set assistant_text to substring(raw_output and 0 and a_end)
            display f"Parsed action: '{tool_name}' with args: '{args_str}'"
            set ok to trace_emit(trace_db and trace_sid and "action" and f"{tool_name}({args_str})")
            set ok to append_list(values_list and action_map)
            
            # Parse arguments as JSON array or fallback to raw string
            set args_list to create_list()
            set json_node to 0
            if implicit_reply == 1:
                set ok to append_list(args_list and raw_output)
            else:
                set json_node to json_parse(args_str)
            if implicit_reply == 0 and also json_node != 0:
                set j_type to get_json_type(json_node)
                if j_type == 3: # List
                    set parsed_items to get_json_value(json_node)
                    set items_len to length_list(parsed_items)
                    set item_i to 0
                    repeat while item_i < items_len:
                        set json_item to get_list(parsed_items and item_i)
                        # JSON type 1 is an Integer — get_json_value returns a raw int,
                        # not a string. Tool handlers (and the truncation guard below,
                        # which calls string_length on args[0]) expect STRINGS, so coerce
                        # numeric args to their string form. Without this, any tool called
                        # with a single numeric arg (e.g. get_lesson([1])) crashes.
                        if get_json_type(json_item) == 1:
                            set val to int_to_string(get_json_value(json_item))
                        else:
                            set val to get_json_value(json_item)
                        set ok to append_list(args_list and val)
                        set item_i to item_i + 1
                    # Truncation guard: if JSON parsed a single string that is
                    # drastically shorter than the raw args, the LLM likely
                    # emitted unescaped inner quotes. Fall back to raw extraction.
                    if items_len == 1:
                        set parsed_len to string_length(get_list(args_list and 0))
                        set raw_len to string_length(args_str)
                        if parsed_len < raw_len / 2:
                            display f"[react] JSON truncation detected ({parsed_len} vs {raw_len} chars). Using raw extraction."
                            set ok to set_list(args_list and 0 and react_extract_raw_arg(args_str))
                else:
                    if get_json_type(json_node) == 1:
                        set ok to append_list(args_list and int_to_string(get_json_value(json_node)))
                    else:
                        set ok to append_list(args_list and get_json_value(json_node))
            else if implicit_reply == 0:
                set ok to append_list(args_list and args_str)

            # Do this after JSON decoding (where the corruption is introduced) and
            # before observer, memory, tool execution, persistence or platform delivery.
            if tool_name equals "reply_request" and also length_list(args_list) > 0:
                set reply_arg to get_list(args_list and 0)
                set ok to set_list(args_list and 0 and reply_format_normalize(reply_arg))
                
            set action_allowed to 1
            set action_reason to ""

            # --- F3: Clarification request (pause + ask the user) ---
            # Mirrors the approval pause/resume rail. Bounded to 3 rounds; once the
            # budget is spent (or the user said "work with what we have"), further
            # requests are refused with a nudge to proceed instead of pausing.
            if tool_name equals "request_clarification":
                set clarify_rounds to 0
                if map_contains(ctx and "clarify_rounds") == 1:
                    set clarify_rounds to map_get_val(ctx and "clarify_rounds")
                set clarify_done to 0
                if map_contains(ctx and "clarify_done") == 1:
                    set clarify_done to map_get_val(ctx and "clarify_done")
                if clarify_rounds >= 3 or else clarify_done == 1:
                    set current_prompt to concat(current_prompt and "\n")
                    set current_prompt to concat(current_prompt and raw_output)
                    set current_prompt to concat(current_prompt and "\nObservation: You have used your clarification budget. Proceed now with your best understanding; do not ask the user again.\n")
                    free_list(args_list)
                    if is_batched_turn == 0:
                        set loop_idx to loop_idx + 1
                    continue
                set ok to map_insert(ctx and "clarify_rounds" and clarify_rounds + 1)
                set pendingc to create_map()
                set ok to map_insert(pendingc and "questions" and args_str)
                set ok to map_insert(pendingc and "prompt_state" and current_prompt)
                set ok to map_insert(pendingc and "raw_output" and raw_output)
                set ok to map_insert(pendingc and "loop_idx" and loop_idx)
                set pendc_role to ""
                if map_contains(ctx and "sender_role") == 1:
                    set pendc_role to map_get_val(ctx and "sender_role")
                set ok to map_insert(pendingc and "sender_role" and pendc_role)
                set ok to map_insert(ctx and "pending_clarification" and pendingc)
                free_list(args_list)
                free_list(values_list)
                set ok to tools_set_active_session("")
                return "PENDING_CLARIFICATION"

            # --- Mid-message response (does NOT end the turn) ---
            # Allows the agent to send a visible message to the user while continuing
            # its current task. Used to acknowledge whispers, give progress updates,
            # or respond to mid-turn guidance without stopping work.
            if tool_name equals "mid_message":
                set mid_content to react_extract_raw_arg(args_str)
                set mid_sess to ""
                if map_contains(ctx and "session_id") == 1:
                    set mid_sess to map_get_val(ctx and "session_id")
                set ok to react_write_mid_message(mid_sess and mid_content)
                display f"[ReAct] Mid-message sent to user: {substring(mid_content and 0 and 100)}"
                # Note: react_write_mid_message already writes to trace_events; do NOT also
                # trace_emit here (duplicate row). A SECOND action batched in the same response
                # is handled by the general batching queue (override_output set above) — no
                # mid_message-specific detection needed. If more actions follow, the next
                # iteration runs them with no new inference call.
                set current_prompt to concat(current_prompt and "\n")
                set current_prompt to concat(current_prompt and assistant_text)
                set current_prompt to concat(current_prompt and "\nObservation: Mid-message delivered to the user. Continue your current task.\n")
                if string_length(orphan_nudge) > 0:
                    set current_prompt to concat(current_prompt and orphan_nudge)
                free_list(args_list)
                if is_batched_turn == 0:
                    set loop_idx to loop_idx + 1
                continue

            # --- Tool Approval Gate ---
            set needs_approval to tools_requires_approval(tool_name and args_list)
            if needs_approval == 1:
                set has_approval to 0
                if map_contains(ctx and "tool_approved") == 1:
                    set has_approval to map_get_val(ctx and "tool_approved")
                
                # Check request-scoped auto_approve. The threaded auto_approve_flag is the
                # reliable source (it survives across tool executions); the ctx read is kept
                # as a secondary path but is unreliable when ctx is a borrow view — that was
                # the "Approve all approves the first then denies the rest" bug.
                set auto_approve_val to 0
                if map_contains(ctx and "auto_approve") == 1:
                    set auto_approve_val to map_get_val(ctx and "auto_approve")
                if auto_approve_flag == 1:
                    set auto_approve_val to 1
                if auto_approve_val == 0:
                    if map_contains(ctx and "subagent_turn_auto_approve") == 1:
                        if map_get_val(ctx and "subagent_turn_auto_approve") == 1:
                            set auto_approve_val to 1
                # P4: persistent per-session auto-approve toggle (AI AUTOAPPROVE ON via
                # Discord button//autoapprove/WebUI). Session-scoped and in-memory only —
                # a node restart resets to OFF. Checked alongside the request-scoped
                # flag; observer audits still run on every gated tool.
                if auto_approve_val == 0:
                    if map_contains(ctx and "session_auto_approve") == 1:
                        set sess_aa_map to map_get_val(ctx and "session_auto_approve")
                        if map_contains(sess_aa_map and f4_sess) == 1:
                            set auto_approve_val to 1
                if auto_approve_val == 1:
                    set has_approval to 1
                
                if has_approval == 0:
                    # If the user hit Stop while this turn was running, do NOT surface an
                    # approval prompt for a run they are killing — halt now. The top-of-loop
                    # cancel check cannot catch a Stop that arrives mid-turn (after that check
                    # but before we pause here); this closes that window so Stop always wins
                    # over a pending approval dialog.
                    set cxl_sess to ""
                    if map_contains(ctx and "session_id") == 1:
                        set cxl_sess to map_get_val(ctx and "session_id")
                    if react_check_cancel(cxl_sess and run_epoch) == 1:
                        display "[ReAct] Run halted by user (cancel) instead of pausing for approval."
                        set ok to map_insert(ctx and "was_cancelled" and 1)
                        free_list(args_list)
                        free_list(values_list)
                        set ok to tools_set_active_session("")
                        return "Run halted at your request."
                    set denials to 0
                    if map_contains(ctx and "consecutive_denials") == 1:
                        set denials to map_get_val(ctx and "consecutive_denials")
                    
                    if denials >= 2:
                        display f"Auto-denying tool '{tool_name}' because consecutive denials >= 2"
                        set action_allowed to 0
                        set action_reason to "Tool execution blocked because user has denied tool execution twice in a row."
                    else:
                        # Build a summary of what the tool wants to do
                        set approval_summary to concat(tool_name and "(")
                        set approval_summary to concat(approval_summary and args_str)
                        set approval_summary to concat(approval_summary and ")")
                        # Access-gate warning on the card (sensitive path / destructive cmd).
                        set acc_warn to access_warning(tool_name and args_str)
                        if string_length(acc_warn) > 0:
                            set approval_summary to concat(approval_summary and concat("  ⚠️ WARNING: " and acc_warn))

                        display f"Tool '{tool_name}' requires user approval. Pausing for confirmation."
                        set ok to trace_emit(trace_db and trace_sid and "approval" and f"Waiting for approval: {tool_name}({args_str})")
                        
                        # Store pending action state in context for the IPC layer to pick up
                        set pending to create_map()
                        set ok to map_insert(pending and "tool_name" and tool_name)
                        set ok to map_insert(pending and "args_str" and args_str)
                        set ok to map_insert(pending and "summary" and approval_summary)
                        set ok to map_insert(pending and "prompt_state" and current_prompt)
                        set ok to map_insert(pending and "raw_output" and raw_output)
                        set ok to map_insert(pending and "loop_idx" and loop_idx)
                        # Bind the caller's role to this pending action. The IPC layer
                        # deletes sender_role from ctx after the initiating turn, so the
                        # approval (a separate IPC round) would otherwise execute the tool
                        # with no role and fail the admin gate -> "restricted to
                        # administrators" on every approved tool since approve-all landed.
                        set pend_role to ""
                        if map_contains(ctx and "sender_role") == 1:
                            set pend_role to map_get_val(ctx and "sender_role")
                        set ok to map_insert(pending and "sender_role" and pend_role)
                        set ok to map_insert(ctx and "pending_action" and pending)
                        
                        # Store the parsed args list for later execution
                        set pending_args to create_list()
                        set pa_idx to 0
                        set a_len to length_list(args_list)
                        repeat while pa_idx < a_len:
                            set pa_val to get_list(args_list and pa_idx)
                            set ok to append_list(pending_args and pa_val)
                            set pa_idx to pa_idx + 1
                        set ok to map_insert(pending and "args_list" and pending_args)
                        
                        # SUB-AGENT APPROVAL FORWARDING: if this is a sub-agent (has
                        # parent_session_id), we cannot return PENDING_APPROVAL because
                        # nobody polls sub-agent ctx. Instead: insert a pending approval
                        # row into trace_approvals, emit a trace event to the parent
                        # session (so Discord/WebUI show the approval card), then poll
                        # with tools_sleep_yield until the IPC handler writes a decision.
                        # tools_sleep_yield yields the cooperative event loop so other
                        # async tasks (parent agent, sibling sub-agents) keep running.
                        if map_contains(ctx and "parent_session_id") == 1:
                            set sa_parent_sid to map_get_val(ctx and "parent_session_id")
                            set sa_task_id to trace_sid
                            set sa_db to storage_get_db()
                            # Insert pending approval row
                            set sa_tn_esc to string_replace(tool_name and "'" and "''")
                            set sa_as_esc to string_replace(args_str and "'" and "''")
                            set sa_sm_esc to string_replace(approval_summary and "'" and "''")
                            set sa_sid_esc to string_replace(sa_task_id and "'" and "''")
                            set sa_now to ep_time_now_sec()
                            set ok to sql_execute(sa_db and f"INSERT INTO trace_approvals (session_id, tool_name, args_str, summary, decision, created_at) VALUES ('{sa_sid_esc}', '{sa_tn_esc}', '{sa_as_esc}', '{sa_sm_esc}', NULL, {sa_now});")
                            # Notify parent session via trace event
                            set sa_desc to concat("Sub-agent " and concat(sa_task_id and concat(" requests permission to call " and concat(tool_name and concat("(" and concat(args_str and ")"))))))
                            set sa_desc_esc to string_replace(sa_desc and "\"" and "'")
                            set sa_tn_esc2 to string_replace(tool_name and "\"" and "'")
                            set sa_as_esc2 to string_replace(args_str and "\"" and "'")
                            set ok to trace_emit(sa_db and sa_parent_sid and "subagent_approval" and concat("{\"task_id\":\"" and concat(sa_task_id and concat("\",\"tool\":\"" and concat(sa_tn_esc2 and concat("\",\"args\":\"" and concat(sa_as_esc2 and concat("\",\"description\":\"" and concat(sa_desc_esc and "\"}")))))))))
                            display f"[APPROVAL] Sub-agent {sa_task_id} waiting for approval of {tool_name} — polling trace_approvals"
                            # Poll for decision — yield the event loop each second
                            set sa_decision to ""
                            set sa_poll_count to 0
                            repeat while string_length(sa_decision) == 0 and also sa_poll_count < 3600:
                                # Check for cancellation
                                if react_check_cancel(trace_sid and run_epoch) == 1:
                                    set ok to sql_execute(sa_db and f"DELETE FROM trace_approvals WHERE session_id='{sa_sid_esc}' AND decision IS NULL;")
                                    free_list(args_list)
                                    free_list(values_list)
                                    set ok to tools_set_active_session("")
                                    return "Run halted at your request."
                                set ok to tools_sleep_yield(1000)
                                set sa_poll_count to sa_poll_count + 1
                                # Query for a decision
                                set sa_rows to sql_query(sa_db and f"SELECT decision FROM trace_approvals WHERE session_id='{sa_sid_esc}' AND decision IS NOT NULL ORDER BY id DESC LIMIT 1;")
                                if length_list(sa_rows) > 0:
                                    set sa_row to get_list(sa_rows and 0)
                                    set sa_decision to get_list(sa_row and 0)
                            # Clean up the approval row
                            set ok to sql_execute(sa_db and f"DELETE FROM trace_approvals WHERE session_id='{sa_sid_esc}';")
                            if sa_decision equals "yes":
                                display f"[APPROVAL] Sub-agent {sa_task_id} APPROVED for {tool_name} — executing"
                                set action_allowed to 1
                                set ok to map_insert(ctx and "consecutive_denials" and 0)
                                set ok to map_insert(ctx and "subagent_turn_auto_approve" and 1)
                                # Fall through to tool execution below (action_allowed=1)
                            else:
                                display f"[APPROVAL] Sub-agent {sa_task_id} DENIED for {tool_name}"
                                set action_allowed to 0
                                set ok to map_insert(ctx and "consecutive_denials" and 0)
                                if sa_decision equals "no":
                                    set action_reason to f"Permission denied by operator for {tool_name}."
                                else:
                                    set action_reason to f"Approval timed out for {tool_name} after 1 hour."
                                free_list(args_list)
                                free_list(values_list)
                                # Continue the ReAct loop with the denial as observation
                                set observation to action_reason
                                # Skip tool execution, go to next iteration
                                set ok to tools_set_active_session("")
                                set current_prompt to concat(current_prompt and concat("\nObservation: " and observation))
                                set loop_idx to loop_idx + 1
                                if loop_idx >= max_iters:
                                    return "Max turns reached."
                                continue
                        else:
                            free_list(args_list)
                            free_list(values_list)
                            set ok to tools_set_active_session("")
                            return "PENDING_APPROVAL"
                else:
                    # Approval was granted — clear the flag and proceed
                    set ok to map_insert(ctx and "tool_approved" and 0)
            
            # --- Observer Security Audit (for dangerous commands) ---
            # E4: turing_grid_op(execute) runs a grid cell as a shell command — treat it
            # as a shell-exec sink and audit it like run_command (it's also admin-only
            # via tools_is_action_allowed).
            set is_grid_exec to 0
            if tool_name equals "turing_grid_op":
                if length_list(args_list) >= 1:
                    if get_list(args_list and 0) equals "execute":
                        set is_grid_exec to 1
            if tool_name equals "run_command" or else tool_name equals "codebase_write" or else tool_name equals "self_prompt_set" or else tool_name equals "persona_set" or else tool_name equals "persona_register" or else is_grid_exec == 1:
                set audit_payload to ""
                if tool_name equals "run_command":
                    if length_list(args_list) >= 1:
                        set cmd_arg to get_list(args_list and 0)
                        set audit_payload to concat("run_command: " and cmd_arg)
                else if is_grid_exec == 1:
                    set audit_payload to "turing_grid_op execute: runs a Turing-grid cell as a shell command"
                else if tool_name equals "self_prompt_set":
                    # F6: the agent rewriting its own behavior/skills is a powerful act — audit it.
                    if length_list(args_list) >= 1:
                        set sec_arg to get_list(args_list and 0)
                        set audit_payload to concat("self_prompt_set: agent is rewriting its own prompt section " and sec_arg)
                else if tool_name equals "persona_set" or else tool_name equals "persona_register":
                    # P9: swapping/registering the agent's IDENTITY is as powerful as a
                    # self-prompt rewrite — audited by the same rule.
                    if length_list(args_list) >= 1:
                        set pa_arg to get_list(args_list and 0)
                        set audit_payload to concat(tool_name and concat(": agent persona operation on '" and concat(pa_arg and "'")))
                else:
                    if length_list(args_list) >= 1:
                        set path_arg to get_list(args_list and 0)
                        set audit_payload to concat("codebase_write: " and path_arg)
                
                if string_length(audit_payload) > 0:
                    set audit_map to observer_audit(ctx and current_prompt and audit_payload)
                    set verdict to map_get_val(audit_map and "verdict")
                    set audit_record_reason to map_get_val(audit_map and "reason")
                    set ok to map_insert(ctx and "last_observer_verdict" and verdict)
                    set ok to map_insert(ctx and "last_observer_reason" and audit_record_reason)
                    if verdict equals "BLOCKED":
                        # If the human already approved this action (via the approval gate
                        # or auto_approve), the observer's BLOCKED verdict is advisory only.
                        # The human is the authority — the observer cannot overrule explicit
                        # human approval. The concern is still logged for transparency.
                        if needs_approval == 1:
                            set block_reason to map_get_val(audit_map and "reason")
                            display f"Observer audit: BLOCKED (overridden by human approval). Reason: {block_reason}"
                            set ok to trace_emit(trace_db and trace_sid and "audit" and f"Observer: BLOCKED (human-approved, advisory only) — {block_reason}")
                        else:
                            set action_allowed to 0
                            set action_reason to map_get_val(audit_map and "reason")
                    free_map(audit_map)
                    
            set tool_result to ""
            if action_allowed == 0:
                display f"Observer action audit: BLOCKED. Reason: {action_reason}"
                set ok to trace_emit(trace_db and trace_sid and "audit" and f"Observer: BLOCKED — {action_reason}")
                set tool_result to concat("BLOCKED by Observer: " and action_reason)
            else:
                set ok to trace_emit(trace_db and trace_sid and "audit" and "Observer: ALLOWED")
                display f"Executing tool: {tool_name}..."
                set ok to trace_emit(trace_db and trace_sid and "tool_exec" and f"Executing: {tool_name}")
                # KV-CACHE: expose this turn's prompt to tools that run their own LLM audit
                # (moderation_tool). An audit sent with a bare/stub context is a DIFFERENT
                # prefix on the same model slot — it evicts the main prompt's KV cache and
                # the next main call re-prefills the whole prompt from zero (~turn-1 TTFT).
                # With the real prompt as system context the audit shares the prefix.
                set ok to map_insert(ctx and "current_prompt" and current_prompt)
                # Artifact provenance records the actual tool that created/shared the
                # bytes. This is per-turn context, so concurrent sessions cannot race.
                set ok to map_insert(ctx and "current_action_name" and tool_name)
                set tool_result to tools_execute(tools_mgr and ctx and tool_name and args_list)
                display f"Tool result: {tool_result}"
                set ok to trace_emit(trace_db and trace_sid and "tool_result" and tool_result)
                
            set ok to append_list(values_list and tool_result)
            
            # Store event in Tier 3 Timeline
            set ok to memory_store(memory_mgr and 3 and f"Action: {tool_name}" and f"Result: {tool_result}")
            
            # Some successful tools are terminal by contract. Image generation already
            # schedules attachment delivery; session termination has closed the current
            # lifecycle. Neither may be fed back as an Observation or followed by another
            # inference, audit, action, or reply from the terminated foreground turn.
            if react_tool_result_finishes_turn(tool_name and action_allowed and tool_result) == 1:
                display f"[ReAct] Terminal tool '{tool_name}' completed; ending request without another inference."
                set ok to trace_emit(trace_db and trace_sid and "done" and concat("Terminal tool completed: " and tool_name))
                set final_answer to tool_result
                set finished to 1
                set override_output to ""
            else if tool_name equals "reply_request":
                # Single inference-only audit — all LLM, no hardcoded checks
                set ok to map_insert(ctx and "observer_capture_continuity" and 1)
                set audit_map to observer_audit(ctx and current_prompt and tool_result)
                set ok to map_delete(ctx and "observer_capture_continuity")
                set verdict to map_get_val(audit_map and "verdict")
                set audit_reason to map_get_val(audit_map and "reason")
                set audit_parsed to map_get_val(audit_map and "parsed")
                set audit_continuity to map_get_val(audit_map and "continuity_json")
                free_map(audit_map)
                
                # Reply audits fail closed too. Invalid/empty observer output is useful
                # corrective feedback, not permission to publish an unaudited response.
                # This also prevents the exact bug where reasoning prose containing the
                # word ALLOWED was mistaken for a valid audit verdict.
                if audit_parsed == 0:
                    # Regenerating Echo's candidate cannot repair an unavailable or
                    # malformed Observer. The old loop regenerated three candidates
                    # and retried two endpoints for each, turning one failed audit into
                    # an apparent hang before publishing unaudited text.
                    display "Observer reply audit unavailable. Withholding unaudited reply without regenerating it."
                    set ok to trace_emit(trace_db and trace_sid and "reply_audit" and "Reply audit unavailable; reply withheld without regeneration")
                    set final_answer to "Observer audit failed, so Echo's reply was withheld rather than published unaudited. Please retry this message; the failure has been logged."
                    set finished to 1
                else if verdict equals "ALLOWED":
                    if string_length(audit_continuity) > 0:
                        set ok to map_insert(ctx and "continuity_json" and audit_continuity)
                    display "Observer reply audit: ALLOWED. Final response ready."
                    set ok to trace_emit(trace_db and trace_sid and "reply_audit" and "Reply audit: ALLOWED")
                    set reply_blocks to 0
                    set final_answer to tool_result
                    set finished to 1
                else:
                    set reply_blocks to reply_blocks + 1
                    set ok to trace_emit(trace_db and trace_sid and "reply_audit" and f"Reply audit: BLOCKED — {audit_reason} ({reply_blocks}/3)")
                    if reply_blocks >= 3:
                        display f"Observer reply audit: BLOCKED {reply_blocks} consecutive times. Withholding the rejected draft."
                        set final_answer to "Echo's reply was withheld after three Observer rejections. The reasons were logged; please restate or narrow the request."
                        set finished to 1
                    else:
                        display f"Observer reply audit: BLOCKED. Reason: {audit_reason}. Re-prompting ({reply_blocks}/3)..."
                        # Concise correction — do NOT append the full raw_output (which
                        # added ~700+ chars per blocked turn, inflating the prompt from
                        # 16KB to 43KB over 28 turns and causing the SIGSEGV).
                        set current_prompt to concat(current_prompt and "\n[SELF-CHECK FAIL: INVISIBLE TO USER] Your previous reply was blocked (")
                        set current_prompt to concat(current_prompt and audit_reason)
                        set current_prompt to concat(current_prompt and "). Produce a corrected reply now.\n")
            else:
                # Standard tool observation back to prompt — fit it to the model's
                # remaining context window (derived, never a fixed cap).
                set obs_model to ""
                if map_contains(ctx and "selected_model") == 1:
                    set obs_model to map_get_val(ctx and "selected_model")
                # Align the budget with the model the LLM call ACTUALLY uses. When no
                # model is selected, query_local_llm falls back to gemma4:26b — so the
                # budget must use that too, otherwise it'd size for the unknown-model
                # default (8192) and clamp tool output to 2048 chars, truncating file
                # reads even though the real model window is large.
                if string_length(obs_model) == 0:
                    set obs_model to "gemma4:26b"
                set obs_budget to react_observation_budget(obs_model and string_length(current_prompt))
                set current_prompt to concat(current_prompt and "\n")
                set current_prompt to concat(current_prompt and assistant_text)
                # Guard: empty tool results cause the LLM to continuation-complete the
                # Observation line instead of starting a new Thought/Action block.
                set obs_text to tool_result
                if string_length(string_trim(tool_result)) == 0:
                    set obs_text to "[empty result — the tool returned no output]"
                set current_prompt to concat(current_prompt and "\nObservation: ")
                set current_prompt to concat(current_prompt and react_fit_observation(obs_text and obs_budget))
                set current_prompt to concat(current_prompt and "\n")
                if string_length(orphan_nudge) > 0:
                    set current_prompt to concat(current_prompt and orphan_nudge)

                set denials to 0
                if map_contains(ctx and "consecutive_denials") == 1:
                    set denials to map_get_val(ctx and "consecutive_denials")
                if denials >= 2:
                    set current_prompt to concat(current_prompt and "\n[SYSTEM: The user has denied tool execution twice in a row. You must call reply_request now to return your final answer based on the information you have. Do not use any other tool.]\n")
            # Free args_list AFTER all tool_result consumers (memory_store, observer_audit,
            # observation injection) are done. tool_result may alias args_list elements
            # via get_list — freeing earlier is use-after-free.
            free_list(args_list)
        else:
            display "No valid action parsed. Re-prompting for correct Action grammar..."
            set ok to trace_emit(trace_db and trace_sid and "no_action" and "No valid action parsed, re-prompting")
            # Enforce Turn Boundary Rejection — tell the model EXACTLY what it did wrong
            # and what it must do. Common cause: the LLM continuation-completed an empty
            # Observation instead of starting a new Thought/Action block.
            set current_prompt to concat(current_prompt and "\n")
            set current_prompt to concat(current_prompt and "[FORMAT CORRECTION — INVISIBLE TO USER]\nYour output attempted protocol scaffolding but contained no syntactically valid line-anchored Action call. Do not revisit, quote, summarize or analyze the rejected output. The current task remains the exact User Request above. Output one short Thought and then a valid line beginning `Action:`. To answer directly use: Action: reply_request([\"your response\"])\n")

        # Batched actions (queued from a single response) do NOT count against the LLM-turn cap;
        # only a turn that made a fresh inference call advances loop_idx.
        if is_batched_turn == 0:
            set loop_idx to loop_idx + 1

    # E3: if the loop exited on the iteration cap (not a natural reply_request), abort
    # instead of spinning — a model that never replies would otherwise run forever with
    # an ever-growing prompt (cost/compute DoS).
    if finished == 0:
        display f"[ReAct] Iteration cap ({max_iters}) reached — aborting."
        set ok to trace_emit(trace_db and trace_sid and "done" and f"Iteration cap ({max_iters}) reached")
        set final_answer to "I could not complete this request within the allowed number of steps."
    free_list(values_list)
    set ok to tools_set_active_session("")
    return reply_format_normalize(final_answer)


define react_resume_approved with model as Map and memory_mgr as Map and tools_mgr as Map and ctx as Map and approved as Int and auto_approve_flag as Int returning Str:
    # Resume execution after a tool approval/denial decision
    set pending to map_get_val(ctx and "pending_action")
    if pending == 0:
        return "Error: No pending action to resume."
    
    set tool_name to map_get_val(pending and "tool_name")
    set args_list to map_get_val(pending and "args_list")
    set current_prompt to map_get_val(pending and "prompt_state")
    set raw_output to map_get_val(pending and "raw_output")
    set trace_db to storage_get_db()
    set trace_sid to ""
    if map_contains(ctx and "session_id") == 1:
        set trace_sid to map_get_val(ctx and "session_id")
    
    set loop_idx to 0
    if map_contains(pending and "loop_idx") == 1:
        set loop_idx to map_get_val(pending and "loop_idx")

    # Restore the role captured when this action was queued, so the approved tool
    # runs with the original caller's authority (admin/owner) instead of the empty
    # role the IPC layer left behind. Without this, every approved admin tool is
    # denied. Must happen before pending is cleared below.
    set saved_role to ""
    if map_contains(pending and "sender_role") == 1:
        set saved_role to map_get_val(pending and "sender_role")
    set ok to map_insert(ctx and "sender_role" and saved_role)

    # Clear the pending action
    set ok to map_delete(ctx and "pending_action")
    
    set denials to 0
    if map_contains(ctx and "consecutive_denials") == 1:
        set denials to map_get_val(ctx and "consecutive_denials")

    if approved == 1:
        set denials to 0
    else:
        set denials to denials + 1
    set ok to map_insert(ctx and "consecutive_denials" and denials)

    set tool_result to ""
    if approved == 1:
        display f"User APPROVED tool: {tool_name}. Executing..."
        
        # Run observer security audit for dangerous commands before executing
        set action_allowed to 1
        if tool_name equals "run_command" or else tool_name equals "codebase_write" or else tool_name equals "self_prompt_set":
            set audit_payload to ""
            if tool_name equals "run_command":
                if length_list(args_list) >= 1:
                    set cmd_arg to get_list(args_list and 0)
                    set audit_payload to concat("run_command: " and cmd_arg)
            else if tool_name equals "self_prompt_set":
                if length_list(args_list) >= 1:
                    set sec_arg to get_list(args_list and 0)
                    set audit_payload to concat("self_prompt_set: agent is rewriting its own prompt section " and sec_arg)
            else:
                if length_list(args_list) >= 1:
                    set path_arg to get_list(args_list and 0)
                    set audit_payload to concat("codebase_write: " and path_arg)

            if string_length(audit_payload) > 0:
                set audit_map to observer_audit(ctx and current_prompt and audit_payload)
                set verdict to map_get_val(audit_map and "verdict")
                set audit_record_reason to map_get_val(audit_map and "reason")
                set ok to map_insert(ctx and "last_observer_verdict" and verdict)
                set ok to map_insert(ctx and "last_observer_reason" and audit_record_reason)
                if verdict equals "BLOCKED":
                    # Since this is react_resume_approved, the action has been explicitly
                    # approved by the human user. The observer's BLOCKED verdict is advisory
                    # only and does not prevent execution.
                    set block_reason to map_get_val(audit_map and "reason")
                    display f"Observer audit: BLOCKED (overridden by human approval). Reason: {block_reason}"
                    set ok to trace_emit(trace_db and trace_sid and "audit" and f"Observer: BLOCKED (human-approved, advisory only) — {block_reason}")
                free_map(audit_map)
        
        if action_allowed == 1:
            # KV-CACHE: same as the main loop — let tool-run audits share the prompt prefix.
            set ok to map_insert(ctx and "current_prompt" and current_prompt)
            set tool_result to tools_execute(tools_mgr and ctx and tool_name and args_list)
            display f"Tool result: {tool_result}"
    else:
        display f"User DENIED tool: {tool_name}. Skipping."
        # F2: distinguish a USER decision from a policy gate. The user actively chose
        # not to run this — acknowledge it, do not retry, and ask what they want instead.
        set tool_result to f"[USER DECLINED] The user chose not to run '{tool_name}'. This was the user's decision, not a system error or your own limitation. Acknowledge their choice, do NOT retry the same action, and ask what they would like to do instead."
    
    # Store event in Tier 3 Timeline
    set ok to memory_store(memory_mgr and 3 and f"Action: {tool_name}" and f"Result: {tool_result}")
    
    if tool_name equals "reply_request" and approved == 1:
        # reply_request was approved — run observer audit on the reply content
        set ok to map_insert(ctx and "observer_capture_continuity" and 1)
        set audit_map to observer_audit(ctx and current_prompt and tool_result)
        set ok to map_delete(ctx and "observer_capture_continuity")
        set verdict to map_get_val(audit_map and "verdict")
        set audit_reason to map_get_val(audit_map and "reason")
        set audit_parsed to map_get_val(audit_map and "parsed")
        set audit_continuity to map_get_val(audit_map and "continuity_json")
        free_map(audit_map)
        if audit_parsed == 0:
            set ok to trace_emit(trace_db and trace_sid and "reply_audit" and "Approved reply audit unavailable; reply withheld without regeneration")
            return "Observer audit failed, so Echo's reply was withheld rather than published unaudited. Please retry this message; the failure has been logged."
        if verdict equals "ALLOWED":
            if string_length(audit_continuity) > 0:
                set ok to map_insert(ctx and "continuity_json" and audit_continuity)
            return reply_format_normalize(tool_result)
    
    # Inject the result as an Observation and re-enter the main loop — fit it to
    # the model's remaining context window (derived, never a fixed cap).
    set obs_model to ""
    if map_contains(ctx and "selected_model") == 1:
        set obs_model to map_get_val(ctx and "selected_model")
    set obs_budget to react_observation_budget(obs_model and string_length(current_prompt))
    set current_prompt to concat(current_prompt and "\n")
    set current_prompt to concat(current_prompt and raw_output)
    set current_prompt to concat(current_prompt and "\nObservation: ")
    set current_prompt to concat(current_prompt and react_fit_observation(tool_result and obs_budget))
    set current_prompt to concat(current_prompt and "\n")
    
    if denials >= 2:
        set current_prompt to concat(current_prompt and "\n[SYSTEM: The user has denied tool execution twice in a row. You must call reply_request now to return your final answer based on the information you have. Do not use any other tool.]\n")

    # Set approval flag so the loop can continue without re-gating
    set ok to map_insert(ctx and "tool_approved" and 0)
    
    set values_list to create_list()
    set ok to append_list(values_list and current_prompt)

    return react_run_loop(model and memory_mgr and tools_mgr and ctx and current_prompt and loop_idx + 1 and values_list and auto_approve_flag)


# F3: resume after the user answers a clarification (or chooses to proceed). Injects
# the answers as an Observation and re-enters the loop. The "__USE_CURRENT__"
# sentinel means "work with what we have" — stop asking and finish.
define react_resume_clarify with model as Map and memory_mgr as Map and tools_mgr as Map and ctx as Map and answers as Str and auto_approve_flag as Int returning Str:
    set pending to map_get_val(ctx and "pending_clarification")
    if pending == 0:
        return "Error: No pending clarification to resume."
    set current_prompt to map_get_val(pending and "prompt_state")
    set raw_output to map_get_val(pending and "raw_output")
    set loop_idx to 0
    if map_contains(pending and "loop_idx") == 1:
        set loop_idx to map_get_val(pending and "loop_idx")
    set saved_role to ""
    if map_contains(pending and "sender_role") == 1:
        set saved_role to map_get_val(pending and "sender_role")
    set ok to map_insert(ctx and "sender_role" and saved_role)
    set ok to map_delete(ctx and "pending_clarification")

    set obs to ""
    if answers equals "__USE_CURRENT__":
        set ok to map_insert(ctx and "clarify_done" and 1)
        set obs to "The user chose to proceed with the information already available. Do NOT ask for more clarification; complete the task now with your best understanding."
    else:
        set obs to concat("The user answered your clarifying question(s): " and answers)

    set ok to memory_store(memory_mgr and 3 and "Clarification" and obs)

    set obs_model to ""
    if map_contains(ctx and "selected_model") == 1:
        set obs_model to map_get_val(ctx and "selected_model")
    set obs_budget to react_observation_budget(obs_model and string_length(current_prompt))
    set current_prompt to concat(current_prompt and "\n")
    set current_prompt to concat(current_prompt and raw_output)
    set current_prompt to concat(current_prompt and "\nObservation: ")
    set current_prompt to concat(current_prompt and react_fit_observation(obs and obs_budget))
    set current_prompt to concat(current_prompt and "\n")

    set values_list to create_list()
    set ok to append_list(values_list and current_prompt)
    return react_run_loop(model and memory_mgr and tools_mgr and ctx and current_prompt and loop_idx + 1 and values_list and auto_approve_flag)


define react_run with model as Map and memory_mgr as Map and tools_mgr as Map and ctx as Map and user_prompt as Str returning Str:
    set active_runs to 0
    if map_contains(ctx and "active_runs") == 1:
        set active_runs to map_get_val(ctx and "active_runs")
    
    set max_runs to 4
    if map_contains(ctx and "resource_profile") == 1:
        set profile to map_get_val(ctx and "resource_profile")
        if profile equals "low":
            set max_runs to 1
        else if profile equals "standard":
            set max_runs to 2
        else if profile equals "extreme":
            set max_runs to 16
        else if profile equals "high":
            set max_runs to 8
    # Per-request override for operators who know their hardware.
    if map_contains(ctx and "max_concurrent_runs") == 1:
        set mc to map_get_val(ctx and "max_concurrent_runs")
        if mc > 0:
            set max_runs to mc

    if active_runs >= max_runs:
        return "Error: System is at capacity (concurrency limit reached). Please try again later."

    set ok to map_insert(ctx and "active_runs" and active_runs + 1)

    set ok to map_insert(ctx and "auto_approve" and 0)
    # Discard whispers targeted to older turns while retaining any guidance that
    # arrived for THIS turn in the narrow accept/start race.
    set stale_sid to ""
    if map_contains(ctx and "session_id") == 1:
        set stale_sid to map_get_val(ctx and "session_id")
    set current_turn_id to ""
    if map_contains(ctx and "turn_id") == 1:
        set current_turn_id to map_get_val(ctx and "turn_id")
    set stale_rc to react_discard_stale_whispers(stale_sid and current_turn_id)
    if map_contains(ctx and "parent_session_id") == 0:
        set stale_db to storage_get_db()
        if stale_db != 0:
            set stale_main_es to string_replace(react_cancel_key(stale_sid) and "'" and "''")
            set ok to sql_execute(stale_db and f"DELETE FROM trace_whispers WHERE session_id='{stale_main_es}' AND target_turn_id='';")
    # Clear any stale global cancel sentinel left by a PREVIOUS run. /api/cancel writes a
    # '__CANCEL_ALL__' row; if a prior run exited (e.g. via a reply_request) without
    # crossing a turn boundary to consume it, that row would otherwise halt THIS fresh run
    # on turn 1. A Stop click issued DURING this run is written after this point and is
    # still honored at the next turn boundary.
    set cancel_db to storage_get_db()
    if cancel_db != 0:
        set ok to sql_execute(cancel_db and "DELETE FROM trace_cancellations WHERE session_id='__CANCEL_ALL__';")
        # Also clear a stale PER-SESSION row for this session: react_check_cancel now
        # BROADCASTS consumed cancels via the epoch, so a leftover row from a prior run
        # would otherwise halt not just this fresh run but every concurrent one.
        set stale_es to string_replace(react_cancel_key(stale_sid) and "'" and "''")
        set ok to sql_execute(cancel_db and f"DELETE FROM trace_cancellations WHERE session_id='{stale_es}';")
    # Clear the C-level legacy cancel-all flag too, so a Stop meant for a prior run
    # cannot halt this fresh one on turn 1 (the EPOCH needs no clearing — runs capture
    # the current value at start, so old bumps are already behind them).
    set ok to ep_cancel_set(0)
    set sanitized_user_prompt to prompt_sanitize_input(user_prompt)
    # Trigger Hebbian learning on prompt concepts
    set ok to react_hebbian_trigger(memory_mgr and sanitized_user_prompt)
    
    # Resolve THIS turn's session (never merely "the active one"): with parallel
    # per-session turns another dispatch may have moved the global active pointer.
    set sessions_mgr to map_get_val(ctx and "sessions")
    set sess to 0
    if sessions_mgr != 0:
        set comp_sid to ""
        if map_contains(ctx and "session_id") == 1:
            set comp_sid to map_get_val(ctx and "session_id")
        if string_length(comp_sid) > 0:
            set comp_map to map_get_val(sessions_mgr and "sessions")
            if map_contains(comp_map and comp_sid) == 1:
                set sess to map_get_val(comp_map and comp_sid)
        if sess == 0:
            set sess to session_manager_get_active(sessions_mgr)

    set history to create_list()
    set values_list to create_list()
    set ok to append_list(values_list and history)
    
    set sender_role to ""
    if map_contains(ctx and "sender_role") == 1:
        set sender_role to map_get_val(ctx and "sender_role")
    
    set local_tools_mgr to tools_create(sender_role)
    set tools_schema to map_get_val(local_tools_mgr and "schemas")
    set ok to map_insert(ctx and "tools_schema" and tools_schema)
    set assembled_prompt to prompt_assemble(memory_mgr and ctx and sanitized_user_prompt and tools_schema)

    # Provider-authoritative context accounting. Measure the fully assembled prompt,
    # expose capacity to Echo, warn the user once near the boundary, and compact only
    # at exactly 85% of the live provider's stated token window.
    set selected_model to ""
    if map_contains(ctx and "selected_model") == 1:
        set selected_model to map_get_val(ctx and "selected_model")
    set context_snapshot to llm_context_snapshot(selected_model and assembled_prompt)
    if map_get_val(context_snapshot and "ok") == 1:
        set context_provider to map_get_val(context_snapshot and "provider")
        set context_model to map_get_val(context_snapshot and "model")
        set context_limit to map_get_val(context_snapshot and "context_limit_tokens")
        set context_used to map_get_val(context_snapshot and "used_tokens")
        set capacity_text to session_context_capacity_text(context_provider and context_model and context_used and context_limit)
        set ok to map_insert(ctx and "context_capacity" and capacity_text)
        set assembled_prompt to prompt_assemble(memory_mgr and ctx and sanitized_user_prompt and tools_schema)
        # Count again with the capacity record included so the 85% comparison applies
        # to the actual prompt Echo receives, not a smaller preliminary prompt.
        set final_snapshot to llm_context_snapshot(selected_model and assembled_prompt)
        if map_get_val(final_snapshot and "ok") == 1:
            set context_used to map_get_val(final_snapshot and "used_tokens")
            set context_limit to map_get_val(final_snapshot and "context_limit_tokens")
            set context_provider to map_get_val(final_snapshot and "provider")
            set context_model to map_get_val(final_snapshot and "model")
            set capacity_text to session_context_capacity_text(context_provider and context_model and context_used and context_limit)
            set ok to map_insert(ctx and "context_capacity" and capacity_text)
            set assembled_prompt to prompt_assemble(memory_mgr and ctx and sanitized_user_prompt and tools_schema)
            if sess != 0:
                if session_context_approaching_compaction(context_used and context_limit) == 1:
                    set warning_sent to 0
                    if map_contains(sess and "compression_warning_emitted") == 1:
                        set warning_sent to map_get_val(sess and "compression_warning_emitted")
                    if warning_sent == 0:
                        set compaction_at to session_compaction_threshold(context_limit)
                        set remaining_tokens to compaction_at - context_used
                        set warning_message to f"⚠️ Context is approaching compaction: {context_used} of {context_limit} provider tokens are in use. Automatic compaction begins at {compaction_at} tokens (85%); {remaining_tokens} tokens remain before that point."
                        set ok to react_write_mid_message(comp_sid and warning_message)
                        set ok to map_insert(sess and "compression_warning_emitted" and 1)
                if session_should_compress(context_used and context_limit) == 1:
                    set compaction_at to session_compaction_threshold(context_limit)
                    set compaction_message to f"⚠️ Context reached the {compaction_at}-token compaction point (85% of the provider's {context_limit}-token window). Earlier turns are being archived and the active context compacted now."
                    set ok to react_write_mid_message(comp_sid and compaction_message)
                    set compressed to session_compress_active(sessions_mgr and sess and context_used and context_limit)
                    if compressed == 1:
                        set ok to map_insert(sess and "compression_warning_emitted" and 0)
                        set assembled_prompt to prompt_assemble(memory_mgr and ctx and sanitized_user_prompt and tools_schema)
                        set compacted_snapshot to llm_context_snapshot(selected_model and assembled_prompt)
                        if map_get_val(compacted_snapshot and "ok") == 1:
                            set capacity_text to session_context_capacity_text(map_get_val(compacted_snapshot and "provider") and map_get_val(compacted_snapshot and "model") and map_get_val(compacted_snapshot and "used_tokens") and map_get_val(compacted_snapshot and "context_limit_tokens"))
                            set ok to map_insert(ctx and "context_capacity" and capacity_text)
                            set assembled_prompt to prompt_assemble(memory_mgr and ctx and sanitized_user_prompt and tools_schema)
    else:
        set context_error to map_get_val(context_snapshot and "error")
        display concat("[CONTEXT CAPACITY] Measurement unavailable; compaction not performed without provider token evidence: " and context_error)
    set ok to append_list(values_list and assembled_prompt)
    
    set res to react_run_loop(model and memory_mgr and local_tools_mgr and ctx and assembled_prompt and 0 and values_list and 0)
    
    set ok to map_delete(ctx and "tools_schema")
    set active_runs to map_get_val(ctx and "active_runs")
    if active_runs > 0:
        set ok to map_insert(ctx and "active_runs" and active_runs - 1)

    # Emit final trace event and schedule cleanup
    set trace_db to storage_get_db()
    set trace_sid to ""
    if map_contains(ctx and "session_id") == 1:
        set trace_sid to map_get_val(ctx and "session_id")
    set ok to trace_emit(trace_db and trace_sid and "done" and "Final answer ready")

    return res
