# ErnosDecent edition resolver — selects which prompt/persona/branding assets the
# node loads, so the Business edition is a thin overlay on the same engine (no code
# fork). With no config/edition.json, or edition="default", every path returned is
# byte-identical to the original hardcoded path — main behaviour is unchanged.
#
# The edition is COSMETIC ONLY (prompts / persona / branding). It deliberately has
# no field that disables P2P / DHT / relay — a business node is a full mesh node,
# which is what makes the cost savings (and the passive mesh benefit) possible.
# Component: decent_agent/edition.ep

import "fs"
import "string"
import "json"

define edition_name returning Str:
    if file_exists("config/edition.json") == 0:
        return "default"
    set content to read_file("config/edition.json")
    set root to json_parse(content)
    if root == 0:
        return "default"
    set node to get_json_object_value(root and "edition")
    if node == 0:
        return "default"
    set val to get_json_value(node)
    if string_length(val) == 0:
        return "default"
    return val

# Pure resolution core (no file I/O) — testable. Business override only when the
# edition is "business" AND the override asset actually exists; otherwise default.
define edition_resolve with ed as Str and default_path as Str and business_path as Str and business_exists as Int returning Str:
    if ed equals "business":
        if business_exists == 1:
            return business_path
    return default_path

# Resolve an asset path for the active edition: a business override under
# config/business/ if it exists, otherwise the default config/ path. So the
# default edition always returns the original path.
define edition_asset_path with default_path as Str and business_path as Str returning Str:
    set bex to 0
    if file_exists(business_path) == 1:
        set bex to 1
    return edition_resolve(edition_name() and default_path and business_path and bex)

define edition_prompts_path returning Str:
    return edition_asset_path("config/prompts.json" and "config/business/prompts.json")

define edition_persona_path returning Str:
    return edition_asset_path("config/agent_persona.txt" and "config/business/agent_persona.txt")
