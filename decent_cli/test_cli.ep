# ErnosDecent — authenticated IPC client integration test

import "collections"
import "string"
import "net"
import "test"
import "client"

define cli_mock_server with listen_fd as Int and expected_token as Str and request_count as Int and done_ch as Int returning Int:
    set handled to 0
    set server_error to 0
    repeat while handled < request_count:
        set client_fd to ep_net_accept(listen_fd)
        if client_fd < 0:
            set server_error to 1
            set handled to request_count
        else:
            set request to string_trim(ep_net_recv(client_fd and 65536))
            set response to "error:unauthorized"
            set prefix to concat("AUTH " and concat(expected_token and " "))
            if string_index_of(request and prefix) == 0:
                set command to substring(request and string_length(prefix) and string_length(request) - string_length(prefix))
                if command equals "STATUS":
                    set response to "status:active"
                else if command equals "WALLET BALANCE":
                    set response to "wallet_balance:1000000"
                else if command equals "POOL STATUS":
                    set response to "pool:active"
                else:
                    set response to "error:unknown_command"
            set sent to ep_net_send(client_fd and response)
            if sent != string_length(response):
                set server_error to 2
            set close_client_err to ep_net_close(client_fd)
            if close_client_err != 0:
                set server_error to 3
            set handled to handled + 1
    set close_listen_err to ep_net_close(listen_fd)
    if close_listen_err != 0:
        set server_error to 4
    send server_error to done_ch
    return server_error

define assert_cli_response with result as Map and expected as Str returning Int:
    set ok_count to 0
    set ok_count to ok_count + assert_equal(map_get_val(result and "error") and CLI_ERR_NONE and "IPC client should report success")
    set response to ptr_to_str(map_get_val(result and "response"))
    set ok_count to ok_count + assert_true(string_contains(response and expected) == 1 and "IPC response should contain expected content")
    return ok_count

define main returning Int:
    display "==================================================="
    display "  ErnosDecent — Authenticated CLI Integration Test"
    display "==================================================="

    set passed to 0
    set total to 10
    set ipc_port to 25050
    set token to "test-token-with-exact-match"
    set listen_fd to ep_net_listen(ipc_port)
    set passed to passed + assert_true(listen_fd >= 0 and "Mock IPC server should bind")
    if listen_fd < 0:
        return 1

    set done_ch to create_channel()
    spawn cli_mock_server(listen_fd and token and 3 and done_ch)
    set sleep_err to ep_sleep_ms(50)
    set passed to passed + assert_true(sleep_err == 0 and "Mock IPC server should start")

    set missing_token to cli_send_command("127.0.0.1" and ipc_port and "" and "STATUS")
    set passed to passed + assert_equal(map_get_val(missing_token and "error") and CLI_ERR_INVALID_INPUT and "Empty authentication token should be rejected before connecting")

    set status_result to cli_send_command("127.0.0.1" and ipc_port and token and "STATUS")
    set passed to passed + assert_cli_response(status_result and "status:active")
    set wallet_result to cli_send_command("127.0.0.1" and ipc_port and token and "WALLET BALANCE")
    set passed to passed + assert_cli_response(wallet_result and "wallet_balance:")
    set pool_result to cli_send_command("127.0.0.1" and ipc_port and token and "POOL STATUS")
    set passed to passed + assert_cli_response(pool_result and "pool:active")

    set server_error to receive from done_ch
    set passed to passed + assert_equal(server_error and 0 and "Mock IPC server should complete without socket errors")

    display f"[+] {passed}/{total} CLI integration assertions passed."
    if passed == total:
        return 0
    return 1
