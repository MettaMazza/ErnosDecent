# ErnosDecent — Node Control CLI
# Component: decent_cli/decent_cli.ep
# Status: Production — OperationTrojanClaude Phase 14

import "collections"
import "string"
import "net"
import "os"
import "../config.ep"
import "../decent_id/auth"
import "client"

define get_command_from_args with args as List returning Str:
    set argc to length_list(args)
    if argc < 2:
        return ""
    set cmd to get_list(args and 1)
    set i to 2
    repeat while i < argc:
        set next_arg to get_list(args and i)
        set cmd to concat(cmd and " ")
        set cmd to concat(cmd and next_arg)
        set i to i + 1
    return cmd

define print_usage returning Int:
    display "==================================================="
    display "  ErnosDecent CLI Client"
    display "==================================================="
    display "Usage:"
    display "  decent_cli status          Check node status"
    display "  decent_cli wallet balance  Check wallet balance"
    display "  decent_cli pool status     Check resource pool status"
    display "  decent_cli stop            Stop the node daemon"
    display "==================================================="
    return 0

define main returning Int:
    set args to get_args()
    set argc to length_list(args)
    
    if argc < 2:
        print_usage()
        return 0
        
    set cmd to get_command_from_args(args)
    if string_length(cmd) == 0:
        print_usage()
        return 0
        
    # Resolve the IPC port from the same config the daemon uses (was hardcoded 5000),
    # so a node started with a non-default --port is still reachable. Defaults to 5000.
    set home to get_home_dir()
    set cfg to config_load(concat(home and "/.ernosdecent/config.toml"))
    if map_contains(cfg and "config.error") == 1:
        display concat("[-] Error: invalid configuration: " and ptr_to_str(map_get_val(cfg and "config.error")))
        return 1
    set ipc_port to config_get_int(cfg and "network.ipc_port")
    if ipc_port <= 0:
        set ipc_port to 5000

    # Read the IPC auth token; the daemon requires an "AUTH <token>" prefix.
    set tok to ipc_read_token()
    if string_length(tok) == 0:
        display "[-] Error: IPC authentication token is missing or unreadable."
        return 1

    set result to cli_send_command("127.0.0.1" and ipc_port and tok and cmd)
    set err to map_get_val(result and "error")
    set resp to ptr_to_str(map_get_val(result and "response"))
    if err != CLI_ERR_NONE:
        display f"[-] Error: IPC command failed with code {err}."
        return 1
    display resp
    return 0
