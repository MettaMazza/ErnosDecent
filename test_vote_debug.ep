# Debug election_handle_vote_response logic
import "collections"
import "string"
import "decent_consensus/raft"
import "decent_consensus/election"
import "decent_consensus/state"

define main:
    display "=== Vote Logic Debug ==="

    set peers to create_list()
    set ok to append_list(peers and str_to_ptr("node2"))
    set node to raft_create_node("node1" and peers)
    election_init_node(borrow node and 500)

    set r to ptr_to_str(map_get_val(node and "role"))
    set t to map_get_val(node and "current_term")
    display f"role: {r}  term: {t}"

    set reqs to election_start_vote(borrow node)
    set r to ptr_to_str(map_get_val(node and "role"))
    set t to map_get_val(node and "current_term")
    set votes to map_get_val(node and "votes_received")
    set vs to map_size(votes)
    display f"After start_vote: role={r} term={t} votes={vs}"

    display "Simulating vote from node2 (term=1, granted=1)..."
    set result to election_handle_vote_response(borrow node and "node2" and 1 and 1)
    display f"handle result: {result}"

    set r to ptr_to_str(map_get_val(node and "role"))
    set t to map_get_val(node and "current_term")
    set votes to map_get_val(node and "votes_received")
    set vs to map_size(votes)
    display f"After vote: role={r} term={t} votes={vs}"

    set num_peers to length_list(peers)
    set total to num_peers + 1
    set majority to total / 2 + 1
    display f"peers={num_peers} total={total} majority={majority}"

    display "=== DONE ==="
    return 0
