# Focused regression for bounded mix-pool mutation ordering.

import "collections"
import "mixnet"

set MIXNET_CAPACITY_TOTAL to 0
set MIXNET_TEST_POOL to create_map()

define mixnet_capacity_expect with condition as Int and label as Str returning Int:
    set MIXNET_CAPACITY_TOTAL to MIXNET_CAPACITY_TOTAL + 1
    if condition == 1:
        display concat("PASS: " and label)
        return 1
    display concat("FAIL: " and label)
    return 0

define mixnet_capacity_worker with packet as Str and result_channel as Int returning Int:
    set result to mixnet_add_packet(MIXNET_TEST_POOL and packet)
    send result to result_channel
    return 0

define main returning Int:
    set passed to 0
    set passed to passed + mixnet_capacity_expect(mixnet_create_pool(0 and 0) == 0 and "zero capacity is rejected")
    set passed to passed + mixnet_capacity_expect(mixnet_create_pool(0 - 1 and 2) == 0 and "negative delay is rejected")
    set passed to passed + mixnet_capacity_expect(mixnet_create_pool(37 and 100000) == 0 and "worst-case batch delay is bounded")
    set passed to passed + mixnet_capacity_expect(mixnet_create_pool(0 and MIXNET_MAX_POOL_SIZE + 1) == 0 and "oversized capacity is rejected")

    set pool to mixnet_create_pool(0 and 2)
    set first to mixnet_add_packet(pool and "first")
    set second to mixnet_add_packet(pool and "second")
    set packets to map_get_val(pool and "packets")
    set passed to passed + mixnet_capacity_expect(first == 0 and also second == 1 and also length_list(packets) == 2 and "capacity packet is queued and requests a flush")

    set rejected to mixnet_add_packet(pool and "must-not-append")
    set passed to passed + mixnet_capacity_expect(rejected == 2 and also length_list(packets) == 2 and "full-pool rejection does not append max_size plus one")
    set passed to passed + mixnet_capacity_expect((ptr_to_str(get_list(packets and 0)) equals "first") == 1 and also (ptr_to_str(get_list(packets and 1)) equals "second") == 1 and "rejection preserves queued packet order and content")

    set flushed to mixnet_flush_pool(pool)
    set passed to passed + mixnet_capacity_expect(length_list(flushed) == 2 and also length_list(map_get_val(pool and "packets")) == 0 and "flush returns the bounded batch and resets the live queue")
    set after_flush to mixnet_add_packet(pool and "third")
    set passed to passed + mixnet_capacity_expect(after_flush == 0 and also length_list(map_get_val(pool and "packets")) == 1 and "pool accepts packets again after flush")

    set MIXNET_TEST_POOL to mixnet_create_pool(0 and 8)
    set result_channel to create_channel()
    set worker_index to 0
    repeat while worker_index < 32:
        spawn mixnet_capacity_worker(concat("packet-" and int_to_string(worker_index)) and result_channel)
        set worker_index to worker_index + 1
    set accepted to 0
    set rejected_count to 0
    set worker_index to 0
    repeat while worker_index < 32:
        set worker_result to receive from result_channel
        if worker_result == 0 or else worker_result == 1:
            set accepted to accepted + 1
        else:
            if worker_result == 2:
                set rejected_count to rejected_count + 1
        set worker_index to worker_index + 1
    set passed to passed + mixnet_capacity_expect(accepted == 8 and also rejected_count == 24 and also length_list(map_get_val(MIXNET_TEST_POOL and "packets")) == 8 and "concurrent producers cannot exceed the exact pool capacity")

    set invalid_pool to create_map()
    set passed to passed + mixnet_capacity_expect(mixnet_add_packet(MIXNET_TEST_POOL and "") == 2 and also mixnet_flush_pool(invalid_pool) == 0 and "invalid packet and flush inputs fail explicitly")

    display f"RESULT: {passed}/{MIXNET_CAPACITY_TOTAL} passed"
    if passed != MIXNET_CAPACITY_TOTAL:
        return 1
    return 0
