import "decent_id/keys"
import "decent_id/did"
import "stdlib/string"

# Negative-control for B6: validates the exact crypto the DHT_STORE handler enforces
# on ownership records — sig over key||value verifies, the stored DID must equal the
# signer-derived DID, tampering is caught, and a different key derives a different DID
# (so an attacker cannot front-run a victim's name/repo claim).
define main returning Int:
    set kp to generate_signing_keypair()
    set pub to ptr_to_str(map_get_val(kp and "public_key"))
    set sec to ptr_to_str(map_get_val(kp and "secret_key"))
    set did to create_did_key_from_ed25519(pub)

    set key to "name:alice"
    set value to did
    set sig_res to sign_message(concat(key and value) and sec)
    set sig to ptr_to_str(map_get_val(sig_res and "signature"))

    set p to 0
    set t to 0

    set v1 to verify_signature(concat(key and value) and sig and pub)
    set t to t + 1
    if v1 == 0:
        set p to p + 1
        display "[PASS] valid signed ownership record verifies"
    else:
        display "[FAIL] valid signature rejected"

    set t to t + 1
    if value equals create_did_key_from_ed25519(pub):
        set p to p + 1
        display "[PASS] stored DID matches signer-derived DID"
    else:
        display "[FAIL] DID binding broken"

    set v3 to verify_signature(concat(key and "did:key:zATTACKER") and sig and pub)
    set t to t + 1
    if v3 != 0:
        set p to p + 1
        display "[PASS] tampered value fails signature check"
    else:
        display "[FAIL] tampered value accepted"

    set kp2 to generate_signing_keypair()
    set pub2 to ptr_to_str(map_get_val(kp2 and "public_key"))
    set did2 to create_did_key_from_ed25519(pub2)
    set t to t + 1
    if did2 equals did:
        display "[FAIL] two keypairs derived same DID"
    else:
        set p to p + 1
        display "[PASS] attacker key derives a different DID (cannot impersonate)"

    display f"RESULT: {p}/{t} passed"
