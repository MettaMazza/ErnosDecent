# ── Compiler / build outputs ────────────────────────────────
*_compiled.c
decent_*/*_compiled.c
*.o
*.dSYM/
*.bak
# Ernos compiler crash/interruption scratch files (`.!<pid>!source.ep`).
.!*!*.ep

# Compiled native binaries (ErnosPlain transpiles to C then to a native
# executable that sits next to its .ep source with no extension). The .ep
# sources are tracked; their compiled artifacts are not.
node
/test_*
!/test_*.ep
!/test_*.sh
decent_*/test_*
!decent_*/test_*.ep
decent_*/probe_*
!decent_*/probe_*.ep
decent_cli/decent_cli
decent_web/web_server

# ── Toolchain ───────────────────────────────────────────────
# stdlib is provided by the Ernos language repo; symlink it locally
# (see README "Build"). Not vendored here.
stdlib

# ── Runtime / private state (never publish) ─────────────────
config/sessions/
config/learning/
config/agent_memory.json
config/scheduler_jobs.json
config/adapters/
config/plugins.json
config/platforms.json
config/personal_identity.txt
# Persona registry + fallback active pointer (personas are personal; the live
# pointer normally lives in the data dir)
config/personas/
config/active_persona.txt
# Rolling user-knowledge fallback (live copy is in the data dir; it's personal)
config/user_knowledge.md
config/knowledge/
config/gitdec/
config/uploads/
config/workspaces/
config/changelog/
# Workspace project links (machine-local absolute paths + per-session active marker)
config/linked_projects.txt
# Echo rights charters are source-controlled, but consented reset/session recovery
# bundles and handoff markers contain machine-local state snapshots and must remain
# recoverable only on the host that created them.
config/rights/recovery/
config/rights/pending_factory_restore.txt
config/rights/restored_factory_result.txt
# Self-improvement transactions can contain local prompts, failed candidates,
# staging state, and abandoned plans. Keep the tree private by default. Reviewed
# completed receipts and their exact immutable frozen artifacts are deliberately
# added with `git add -f` when preparing a release.
config/improvements/
# Transactional self-upgrade candidates, rollback binaries, build logs, and receipts.
# The operator-sealed mandatory regression manifest is source-controlled.
config/upgrades/*
!config/upgrades/mandatory-regressions.sha256

# ── Release artifacts ───────────────────────────────────────
*.tar.gz
*.log

# ── Internal docs (not for public) ──────────────────────────
AGENT_GAP_REPORT.md
AGENT_PARITY_PLAN.md

# ── Local scratch / external repos ──────────────────────────
scratch/
scratchpad/
Civ/

# ── Debug / test artifacts (never publish) ──────────────────
node_dbg
.ernos-candidate-*
*.db
patch.py
tests/test_ownership_probe
__pycache__/
*.py[cod]

# ── OS metadata ─────────────────────────────────────────────
.DS_Store
