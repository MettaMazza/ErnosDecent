define storage_discord_context_load with username as Str returning Str:
    set eu to string_replace(username and "'" and "''")
    set sql to concat("SELECT context_history FROM discord_user_contexts WHERE username = '" and concat(eu and "';"))
    set rows to sql_query(STORAGE_DB and sql)
    if length_list(rows) > 0:
        set first_row to get_list(rows and 0)
        return get_list(first_row and 0)
    return ""

define storage_discord_context_save with username as Str and history_json as Str returning Int:
    set eu to string_replace(username and "'" and "''")
    set eh to string_replace(history_json and "'" and "''")
    set now to ep_time_now_sec()
    set sql to concat("INSERT OR REPLACE INTO discord_user_contexts (username, context_history, updated_at) VALUES ('" and concat(eu and concat("', '" and concat(eh and concat("', " and concat(int_to_string(now) and ");"))))))
    set ok to sql_execute(STORAGE_DB and sql)
    if ok != 0:
        return STORAGE_ERR_EXEC_FAILED
    return STORAGE_ERR_NONE

