    set to_a to string_replace(to_addr and "'" and "''")
    set subj to string_replace(subject and "'" and "''")
    set bdy to string_replace(body and "'" and "''")
    set fld to string_replace(folder and "'" and "''")
    set sql to concat("INSERT OR REPLACE INTO email_messages (msg_id, from_addr, to_addr, subject, body, folder, is_read, timestamp) VALUES ('" and concat(mid and concat("', '" and concat(frm and concat("', '" and concat(to_a and concat("', '" and concat(subj and concat("', '" and concat(bdy and concat("', '" and concat(fld and concat("', " and concat(int_to_string(is_read) and concat(", " and concat(int_to_string(timestamp) and ");"))))))))))))))))
    set ok to sql_execute(STORAGE_DB and sql)
    if ok != 0:
        return STORAGE_ERR_EXEC_FAILED
    return STORAGE_ERR_NONE

define storage_email_delete with msg_id as Str returning Int:
