define storage_social_put_event with event_id as Str and pubkey as Str and kind as Int and content as Str and sig as Str and created_at as Int returning Int:
    set ei to string_replace(event_id and "'" and "''")
    set ep to string_replace(pubkey and "'" and "''")
    set ec to string_replace(content and "'" and "''")
    set es to string_replace(sig and "'" and "''")
    set sql to concat("INSERT OR REPLACE INTO social_events (event_id, pubkey, kind, content, sig, created_at) VALUES ('" and concat(ei and concat("', '" and concat(ep and concat("', " and concat(int_to_string(kind) and concat(", '" and concat(ec and concat("', '" and concat(es and concat("', " and concat(int_to_string(created_at) and ");"))))))))))))
    set ok to sql_execute(STORAGE_DB and sql)
    if ok != 0:
        return STORAGE_ERR_EXEC_FAILED
