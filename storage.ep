    return ""

# ================================================================
# Utility
# ================================================================

define storage_get_db returning Int:
    return STORAGE_DB

define storage_get_data_dir returning Str:
    return STORAGE_DATA_DIR

# Live path for the agent's self-authored prompt sections (behavior/skills). This lives
# in the persistent DATA DIR (~/.ernosdecent/), NOT in the git working tree — a tracked
# config file was reverted to its committed default by any git op (branch switch, checkout,
# reset around a rebuild), which is why the self-prompt reset on reboot. The data dir is
# immune to git. Callers fall back to the tracked template (config/agent_self_sections.json)
# for first-run defaults until the agent first writes its own; see tools_self_read_section.
define storage_self_sections_path returning Str:
    set d to STORAGE_DATA_DIR
    if string_length(d) == 0:
        # Storage not initialised (e.g. unit tests) — use the in-tree template directly.
        return "config/agent_self_sections.json"
    return concat(d and "/agent_self_sections.json")

