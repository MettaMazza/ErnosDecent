    set sql to concat("SELECT msg_id, from_addr, to_addr, subject, body, folder, is_read, timestamp FROM email_messages WHERE folder = '" and concat(fld and "' ORDER BY timestamp DESC;"))
    set rows to sql_query(STORAGE_DB and sql)
    set length to length_list(rows)
    set i to 0
