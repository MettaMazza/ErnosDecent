define storage_search_index_page with url as Str and title as Str and body as Str returning Int:
    set eu to string_replace(url and "'" and "''")
    set et to string_replace(title and "'" and "''")
    set eb to string_replace(body and "'" and "''")
    set now to ep_time_now_sec()
    set sql to concat("INSERT OR REPLACE INTO search_pages (url, title, body, indexed_at) VALUES ('" and concat(eu and concat("', '" and concat(et and concat("', '" and concat(eb and concat("', " and concat(int_to_string(now) and ");"))))))))
    set ok to sql_execute(STORAGE_DB and sql)
    if ok != 0:
        return STORAGE_ERR_EXEC_FAILED
    return STORAGE_ERR_NONE

