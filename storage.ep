# Messaging Persistence
# ================================================================

define storage_save_conversation with remote_id as Str and local_id as Str and state as Int and unread_count as Int and updated_at as Int returning Int:
    set er to string_replace(remote_id and "'" and "''")
    set el to string_replace(local_id and "'" and "''")
    set sql to concat("INSERT OR REPLACE INTO conversations (remote_id, local_id, state, unread_count, updated_at) VALUES ('" and concat(er and concat("', '" and concat(el and concat("', " and concat(int_to_string(state) and concat(", " and concat(int_to_string(unread_count) and concat(", " and concat(int_to_string(updated_at) and ");"))))))))))
    set ok to sql_execute(STORAGE_DB and sql)
    if ok != 0:
        return STORAGE_ERR_EXEC_FAILED
    return STORAGE_ERR_NONE

define storage_save_message with message_id as Str and conversation_id as Str and sender as Str and recipient as Str and body as Str and type as Int and state as Int and timestamp as Int returning Int:
    set em to string_replace(message_id and "'" and "''")
    set ec to string_replace(conversation_id and "'" and "''")
    set es to string_replace(sender and "'" and "''")
    set er to string_replace(recipient and "'" and "''")
    set eb to string_replace(body and "'" and "''")
    set sql to concat("INSERT OR REPLACE INTO messages (message_id, conversation_id, sender, recipient, body, type, state, timestamp) VALUES ('" and concat(em and concat("', '" and concat(ec and concat("', '" and concat(es and concat("', '" and concat(er and concat("', '" and concat(eb and concat("', " and concat(int_to_string(type) and concat(", " and concat(int_to_string(state) and concat(", " and concat(int_to_string(timestamp) and ");"))))))))))))))))
    set ok to sql_execute(STORAGE_DB and sql)
    if ok != 0:
        return STORAGE_ERR_EXEC_FAILED
    return STORAGE_ERR_NONE

define storage_load_conversations returning List:
    set list to create_list()
    set sql to "SELECT remote_id, local_id, state, unread_count, updated_at FROM conversations;"
    set rows to sql_query(STORAGE_DB and sql)
    set length to length_list(rows)
    set i to 0
    repeat while i < length:
        set row to get_list(rows and i)
        set conv_map to create_map()
        set ok to map_insert(conv_map and "remote_id" and get_list(row and 0))
        set ok to map_insert(conv_map and "local_id" and get_list(row and 1))
        set ok to map_insert(conv_map and "state" and string_to_int(get_list(row and 2)))
        set ok to map_insert(conv_map and "unread_count" and string_to_int(get_list(row and 3)))
        set ok to map_insert(conv_map and "updated_at" and string_to_int(get_list(row and 4)))
        set ok to append_list(list and conv_map)
        set i to i + 1
    return list

define storage_load_messages with conversation_id as Str returning List:
    set list to create_list()
    set ec to string_replace(conversation_id and "'" and "''")
    set sql to concat("SELECT message_id, conversation_id, sender, recipient, body, type, state, timestamp FROM messages WHERE conversation_id = '" and concat(ec and "' ORDER BY timestamp ASC;"))
    set rows to sql_query(STORAGE_DB and sql)
    set length to length_list(rows)
    set i to 0
    repeat while i < length:
        set row to get_list(rows and i)
        set msg_map to create_map()
        set ok to map_insert(msg_map and "message_id" and get_list(row and 0))
        set ok to map_insert(msg_map and "conversation_id" and get_list(row and 1))
        set ok to map_insert(msg_map and "sender" and get_list(row and 2))
        set ok to map_insert(msg_map and "recipient" and get_list(row and 3))
        set ok to map_insert(msg_map and "body" and get_list(row and 4))
        set ok to map_insert(msg_map and "type" and string_to_int(get_list(row and 5)))
        set ok to map_insert(msg_map and "state" and string_to_int(get_list(row and 6)))
        set ok to map_insert(msg_map and "timestamp" and string_to_int(get_list(row and 7)))
        set ok to append_list(list and msg_map)
        set i to i + 1
    return list

