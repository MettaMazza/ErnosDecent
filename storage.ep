        set ok to map_insert(email_map and "subject" and get_list(row and 3))
        set ok to map_insert(email_map and "body" and get_list(row and 4))
        set ok to map_insert(email_map and "folder" and get_list(row and 5))
        set ok to map_insert(email_map and "is_read" and string_to_int(get_list(row and 6)))
        set ok to map_insert(email_map and "timestamp" and string_to_int(get_list(row and 7)))
        set ok to append_list(list and email_map)
        set i to i + 1
    return list

