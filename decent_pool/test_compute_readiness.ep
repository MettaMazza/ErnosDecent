import "compute"
import "collections"
import "string"
import "net"

define compute_ready_pass with label as Str and condition as Int returning Int:
    if condition == 1:
        display concat("  [PASS] " and label)
        return 1
    display concat("  [FAIL] " and label)
    return 0

define compute_ready_free_port with start_port as Int returning Int:
    set port to start_port
    repeat while port <= 65000:
        set fd to ep_net_listen(port)
        if fd >= 0:
            set ok to ep_net_close(fd)
            return port
        set port to port + 1
    return 0

define main returning Int:
    display "Compute listener readiness tests"
    set passed to 0
    set total to 0
    set mgr to compute_create_manager()

    set invalid_rc to compute_start_server(mgr and 0)
    set total to total + 1
    set passed to passed + compute_ready_pass("invalid port rejected" and invalid_rc == COMPUTE_ERR_INVALID_INPUT)
    set total to total + 1
    set passed to passed + compute_ready_pass("invalid port never marks ready" and map_get_val(mgr and "server_ready") == 0)

    set conflict_port to compute_ready_free_port(47000)
    set blocker to ep_net_listen(conflict_port)
    set conflict_rc to compute_start_server(mgr and conflict_port)
    set total to total + 1
    set passed to passed + compute_ready_pass("occupied port fails synchronously" and conflict_rc == COMPUTE_ERR_LISTEN_FAILED)
    set total to total + 1
    set passed to passed + compute_ready_pass("bind failure leaves server not ready" and map_get_val(mgr and "server_ready") == 0)
    if blocker >= 0:
        set ok to ep_net_close(blocker)

    set live_port to compute_ready_free_port(48000)
    set start_rc to compute_start_server(mgr and live_port)
    set total to total + 1
    set passed to passed + compute_ready_pass("successful start returns after bind" and start_rc == COMPUTE_ERR_NONE)
    set total to total + 1
    set passed to passed + compute_ready_pass("successful bind marks server ready" and map_get_val(mgr and "server_ready") == 1)
    set duplicate_rc to compute_start_server(mgr and live_port)
    set total to total + 1
    set passed to passed + compute_ready_pass("duplicate start is rejected" and duplicate_rc == COMPUTE_ERR_ALREADY_RUNNING)

    set stop_rc to compute_stop_server(mgr)
    set total to total + 1
    set passed to passed + compute_ready_pass("clean stop request succeeds" and stop_rc == COMPUTE_ERR_NONE)
    set waited to 0
    repeat while map_get_val(mgr and "server_ready") == 1 and also waited < 2000:
        set ok to ep_sleep_ms(10)
        set waited to waited + 10
    set total to total + 1
    set passed to passed + compute_ready_pass("worker clears readiness after close" and map_get_val(mgr and "server_ready") == 0)
    set rebound to ep_net_listen(live_port)
    set total to total + 1
    set passed to passed + compute_ready_pass("stopped compute port is reusable" and rebound >= 0)
    if rebound >= 0:
        set ok to ep_net_close(rebound)

    # Exercise the complete manager/worker protocol, including the external ACK.
    # A successful worker submission is not reported until the manager has stored
    # the exact result and returned COMPUTE_RESULT_ACK.
    set protocol_mgr to compute_create_manager()
    set protocol_job to compute_submit_job(protocol_mgr and "delegator" and "payload")
    set protocol_port to compute_ready_free_port(49000)
    set protocol_start to compute_start_server(protocol_mgr and protocol_port)
    set total to total + 1
    set passed to passed + compute_ready_pass("protocol server starts synchronously" and protocol_start == COMPUTE_ERR_NONE)

    set worker_one to compute_worker_connect("127.0.0.1" and protocol_port and "worker-one")
    set total to total + 1
    set passed to passed + compute_ready_pass("first worker receives a real assignment" and worker_one.error == COMPUTE_ERR_NONE)
    set worker_one_conn to worker_one.conn
    set worker_one_submit to compute_worker_submit(worker_one_conn and protocol_job and "worker-one" and "verified-result")
    set total to total + 1
    set passed to passed + compute_ready_pass("first result succeeds only after manager ACK" and worker_one_submit == COMPUTE_ERR_NONE)

    set worker_two to compute_worker_connect("127.0.0.1" and protocol_port and "worker-two")
    set total to total + 1
    set passed to passed + compute_ready_pass("second distinct worker receives redundant assignment" and worker_two.error == COMPUTE_ERR_NONE)
    set worker_two_conn to worker_two.conn
    set worker_two_submit to compute_worker_submit(worker_two_conn and protocol_job and "worker-two" and "verified-result")
    set total to total + 1
    set passed to passed + compute_ready_pass("second result succeeds only after manager ACK" and worker_two_submit == COMPUTE_ERR_NONE)

    set verify_rc to compute_verify_result(protocol_mgr and protocol_job)
    set total to total + 1
    set passed to passed + compute_ready_pass("two acknowledged results reach consensus" and verify_rc == COMPUTE_ERR_NONE)

    set protocol_stop to compute_stop_server(protocol_mgr)
    set total to total + 1
    set passed to passed + compute_ready_pass("protocol server stops cleanly" and protocol_stop == COMPUTE_ERR_NONE)

    display f"Compute readiness: {passed}/{total} passed"
    if passed != total:
        return 1
    return 0
