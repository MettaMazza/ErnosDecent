# G1 negative-control: real <a href> extraction + absolute-URL resolution.

import "string"
import "collections"
import "crawl"

define check_eq with label as Str and got as Str and want as Str returning Int:
    if got equals want:
        display concat("PASS: " and label)
        return 1
    display concat(concat(concat("FAIL: " and label) and " got=[") and concat(got and "]"))
    return 0

define check_int with label as Str and got as Int and want as Int returning Int:
    if got == want:
        display concat("PASS: " and label)
        return 1
    display concat(concat(concat("FAIL: " and label) and " got=") and int_to_string(got))
    return 0

define main:
    set passes to 0

    set html to "<html><body><a href=\"https://a.com/x\">x</a> <a href='/rel'>r</a> <a href=\"#frag\">f</a> <a href=\"mailto:z@z.com\">m</a> <a href=\"sub/page\">s</a> <a href=\"https://a.com/x\">dup</a></body></html>"
    set links to crawl_extract_links(html and "https://base.org/dir/page.html")

    # Expect: absolute kept, root-relative -> origin, relative -> origin/, dup removed,
    # fragment + mailto skipped => 3 unique links.
    set passes to passes + check_int("link_count" and length_list(links) and 3)
    set passes to passes + check_eq("absolute" and ptr_to_str(get_list(links and 0)) and "https://a.com/x")
    set passes to passes + check_eq("root_relative" and ptr_to_str(get_list(links and 1)) and "https://base.org/rel")
    set passes to passes + check_eq("relative" and ptr_to_str(get_list(links and 2)) and "https://base.org/sub/page")

    set origin to crawl_base_origin("https://base.org/dir/page.html")
    set passes to passes + check_eq("origin" and origin and "https://base.org")

    display concat("RESULT: " and concat(int_to_string(passes) and "/5 passed"))
    return 0
