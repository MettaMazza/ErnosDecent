# ErnosDecent -- Phase 7: Security Test Suite
# Tests rate limiting, ban list, input validation, and max message enforcement

import "collections"
import "string"
import "decent_net/security"
import "decent_net/transport"

# ================================================================
# Test 7.1: Rate Limiting
# ================================================================

define test_7_1:
    display "TEST 7.1: Rate limiting"
    set t_ok to 1
    set limiter to security_create_rate_limiter()

    # First request should be allowed
    set r1 to security_check_rate_limit(borrow limiter and "192.168.1.1")
    if r1 != 1:
        display f"  FAIL: First request rejected (got {r1})"
        set t_ok to 0

    # Send 100 requests — all should pass
    set i to 1
    repeat while i < RATE_LIMIT_MAX_REQUESTS:
        set r to security_check_rate_limit(borrow limiter and "192.168.1.1")
        set i to i + 1
    display f"  {RATE_LIMIT_MAX_REQUESTS} requests within limit: OK"

    # Request 101 should be rate limited (return 0)
    set r_over to security_check_rate_limit(borrow limiter and "192.168.1.1")
    if r_over != 0:
        display f"  FAIL: Request {RATE_LIMIT_MAX_REQUESTS} + 1 not rate limited (got {r_over})"
        set t_ok to 0
    else:
        display "  Rate limit triggered at threshold: OK"

    # Different IP should still be allowed
    set r_other to security_check_rate_limit(borrow limiter and "10.0.0.1")
    if r_other != 1:
        display f"  FAIL: Different IP rejected (got {r_other})"
        set t_ok to 0
    else:
        display "  Different IP unaffected: OK"

    # Push past ban threshold
    set i to 0
    repeat while i < 150:
        set r to security_check_rate_limit(borrow limiter and "192.168.1.1")
        set i to i + 1

    set r_ban to security_check_rate_limit(borrow limiter and "192.168.1.1")
    if r_ban != 0 - 1:
        display f"  FAIL: Expected ban (-1), got {r_ban}"
        set t_ok to 0
    else:
        display "  Auto-ban after excessive requests: OK"

    if t_ok == 1:
        display "  PASS"
    return t_ok

# ================================================================
# Test 7.2: Ban List
# ================================================================

define test_7_2:
    display "TEST 7.2: Ban list management"
    set t_ok to 1
    set limiter to security_create_rate_limiter()

    # Manually ban an IP
    set ok to security_ban_ip(borrow limiter and "evil.example.com" and 60000)

    set banned to security_is_banned(borrow limiter and "evil.example.com")
    if banned != 1:
        display f"  FAIL: Banned IP not detected (got {banned})"
        set t_ok to 0
    else:
        display "  Manual ban: OK"

    # Non-banned IP should not be detected
    set not_banned to security_is_banned(borrow limiter and "good.example.com")
    if not_banned != 0:
        display "  FAIL: Non-banned IP incorrectly detected"
        set t_ok to 0
    else:
        display "  Non-banned IP clear: OK"

    # Unban
    set ok to security_unban_ip(borrow limiter and "evil.example.com")
    set after_unban to security_is_banned(borrow limiter and "evil.example.com")
    if after_unban != 0:
        display "  FAIL: IP still banned after unban"
        set t_ok to 0
    else:
        display "  Unban: OK"

    # Ban count
    set ok to security_ban_ip(borrow limiter and "attacker1" and 60000)
    set ok to security_ban_ip(borrow limiter and "attacker2" and 60000)
    set count to security_get_ban_count(borrow limiter)
    if count != 2:
        display f"  FAIL: Expected 2 banned, got {count}"
        set t_ok to 0
    else:
        display "  Ban count tracking: OK"

    if t_ok == 1:
        display "  PASS"
    return t_ok

# ================================================================
# Test 7.3: Max Message Size Enforcement
# ================================================================

define test_7_3:
    display "TEST 7.3: Max message size enforcement"
    set t_ok to 1

    # TRANSPORT_MAX_MESSAGE_SIZE is 1048576 (1MB) — verified in transport.ep
    # The transport_recv function rejects payloads > this size
    # We verify the constant exists and is reasonable
    if TRANSPORT_MAX_MESSAGE_SIZE != 1048576:
        display f"  FAIL: Max message size is {TRANSPORT_MAX_MESSAGE_SIZE}, expected 1048576"
        set t_ok to 0
    else:
        display "  Max message size constant: 1MB ✓"

    # Verify max lengths in security module
    if MAX_NODE_ID_LENGTH != 256:
        display f"  FAIL: Max node ID length is {MAX_NODE_ID_LENGTH}"
        set t_ok to 0
    if MAX_COMMAND_LENGTH != 65536:
        display f"  FAIL: Max command length is {MAX_COMMAND_LENGTH}"
        set t_ok to 0
    if MAX_KEY_LENGTH != 1024:
        display f"  FAIL: Max key length is {MAX_KEY_LENGTH}"
        set t_ok to 0

    display "  All size limits configured: OK"

    if t_ok == 1:
        display "  PASS"
    return t_ok

# ================================================================
# Test 7.4: Input Validation Sweep
# ================================================================

define test_7_4:
    display "TEST 7.4: Input validation sweep"
    set t_ok to 1

    # Valid node ID
    set v1 to security_validate_node_id("node1")
    if v1 != 1:
        display "  FAIL: Valid node_id rejected"
        set t_ok to 0

    # Empty node ID
    set v2 to security_validate_node_id("")
    if v2 != 0:
        display "  FAIL: Empty node_id accepted"
        set t_ok to 0

    # Oversized node ID
    set big_id to ""
    set i to 0
    repeat while i < 300:
        set big_id to concat(big_id and "X")
        set i to i + 1
    set v3 to security_validate_node_id(big_id)
    if v3 != 0:
        display "  FAIL: Oversized node_id accepted"
        set t_ok to 0
    else:
        display "  Node ID validation: OK"

    # Valid command
    set v4 to security_validate_command("SET x=42")
    if v4 != 1:
        display "  FAIL: Valid command rejected"
        set t_ok to 0

    # Empty command
    set v5 to security_validate_command("")
    if v5 != 0:
        display "  FAIL: Empty command accepted"
        set t_ok to 0
    else:
        display "  Command validation: OK"

    # Port validation
    set v6 to security_validate_port(8080)
    if v6 != 1:
        display "  FAIL: Valid port rejected"
        set t_ok to 0
    set v7 to security_validate_port(0)
    if v7 != 0:
        display "  FAIL: Port 0 accepted"
        set t_ok to 0
    set v8 to security_validate_port(70000)
    if v8 != 0:
        display "  FAIL: Port 70000 accepted"
        set t_ok to 0
    set v9 to security_validate_port(0 - 1)
    if v9 != 0:
        display "  FAIL: Negative port accepted"
        set t_ok to 0
    else:
        display "  Port validation: OK"

    # Term validation
    set v10 to security_validate_term(1)
    if v10 != 1:
        display "  FAIL: Valid term rejected"
        set t_ok to 0
    set v11 to security_validate_term(0 - 5)
    if v11 != 0:
        display "  FAIL: Negative term accepted"
        set t_ok to 0
    else:
        display "  Term validation: OK"

    if t_ok == 1:
        display "  PASS"
    return t_ok

# ================================================================
# Test 7.5: Security Test with Raft Deserializer
# ================================================================

define test_7_5:
    display "TEST 7.5: Security combined test"
    set t_ok to 1

    # Rate limiter + validation combined
    set limiter to security_create_rate_limiter()

    # Simulate mixed valid/invalid traffic
    set valid_count to 0
    set rejected_count to 0
    set i to 0
    repeat while i < 50:
        set allowed to security_check_rate_limit(borrow limiter and "test_client")
        if allowed == 1:
            # Validate some inputs
            set node_ok to security_validate_node_id("node_x")
            set cmd_ok to security_validate_command("GET key1")
            if node_ok == 1 && cmd_ok == 1:
                set valid_count to valid_count + 1
        else:
            set rejected_count to rejected_count + 1
        set i to i + 1

    display f"  Valid requests: {valid_count}, Rejected: {rejected_count}"
    if valid_count < 40:
        display "  FAIL: Too many valid requests rejected"
        set t_ok to 0
    else:
        display "  Combined security check: OK"

    # Cleanup
    set ok to security_cleanup_expired(borrow limiter)
    display "  Cleanup completed: OK"

    if t_ok == 1:
        display "  PASS"
    return t_ok

# ================================================================
# Test 7.6: ASAN Clean Run
# ================================================================

define test_7_6:
    display "TEST 7.6: AddressSanitizer verification"
    set t_ok to 1

    # Exercise all security functions to verify no memory issues
    set limiter to security_create_rate_limiter()
    set i to 0
    repeat while i < 20:
        set ip to concat("192.168.1." and int_to_string(i))
        set r to security_check_rate_limit(borrow limiter and ip)
        set ok to security_validate_node_id(ip)
        set ok to security_validate_command(concat("SET k" and int_to_string(i)))
        set ok to security_validate_port(8000 + i)
        set ok to security_validate_term(i)
        set i to i + 1

    # Ban and cleanup cycle
    set ok to security_ban_ip(borrow limiter and "test_ban_1" and 1000)
    set ok to security_ban_ip(borrow limiter and "test_ban_2" and 1000)
    set ok to security_cleanup_expired(borrow limiter)
    set ok to security_unban_ip(borrow limiter and "test_ban_1")
    set count to security_get_ban_count(borrow limiter)
    display f"  Remaining bans after cleanup: {count}"

    # If we reach here without ASAN errors, pass
    display "  No memory errors detected"
    if t_ok == 1:
        display "  PASS"
    return t_ok

# ================================================================
# Main
# ================================================================

define main:
    display "==================================================="
    display "  ErnosDecent -- Phase 7 Security Test Suite"
    display "==================================================="
    display ""

    set passed to 0
    set total to 6

    set r1 to test_7_1()
    set passed to passed + r1
    set r2 to test_7_2()
    set passed to passed + r2
    set r3 to test_7_3()
    set passed to passed + r3
    set r4 to test_7_4()
    set passed to passed + r4
    set r5 to test_7_5()
    set passed to passed + r5
    set r6 to test_7_6()
    set passed to passed + r6

    display ""
    display "==================================================="
    display f"  {passed}/{total} Security tests passed."
    if passed == total:
        display "  ALL PHASE 7 SECURITY TESTS PASSED!"
    else:
        display "  SOME TESTS FAILED"
    display "==================================================="
    return 0
