# ErnosDecent — Low-level Sodium FFI wrappers
# Component: decent_id/sodium_ffi.ep
# These wrappers call libsodium functions directly via ep_dlcall,
# accepting mixed Str/Int types that the bridge's typed signatures reject.
# Status: Production — OperationTrojanClaude Phase 1

external define ep_dlopen with lib as Str returning Int:
external define ep_dlsym with handle as Int and name as Str returning Int:
external define ep_dlcall0 with fn as Int returning Int:
external define ep_dlcall1 with fn as Int and a0 as Int returning Int:
external define ep_dlcall2 with fn as Int and a0 as Int and a1 as Int returning Int:
external define ep_dlcall3 with fn as Int and a0 as Int and a1 as Int and a2 as Int returning Int:
external define ep_dlcall4 with fn as Int and a0 as Int and a1 as Int and a2 as Int and a3 as Int returning Int:
external define ep_dlcall5 with fn as Int and a0 as Int and a1 as Int and a2 as Int and a3 as Int and a4 as Int returning Int:
external define ep_dlcall6 with fn as Int and a0 as Int and a1 as Int and a2 as Int and a3 as Int and a4 as Int and a5 as Int returning Int:
external define ep_dlcall7 with fn as Int and a0 as Int and a1 as Int and a2 as Int and a3 as Int and a4 as Int and a5 as Int and a6 as Int returning Int:

set SODIUM_LIB to 0

define sodium_ffi_load returning Int:
    if SODIUM_LIB != 0:
        return SODIUM_LIB
    set SODIUM_LIB to ep_dlopen("libsodium.dylib")
    if SODIUM_LIB == 0:
        set SODIUM_LIB to ep_dlopen("/opt/homebrew/lib/libsodium.dylib")
    if SODIUM_LIB == 0:
        set SODIUM_LIB to ep_dlopen("/usr/local/lib/libsodium.dylib")
    if SODIUM_LIB == 0:
        set SODIUM_LIB to ep_dlopen("libsodium.so")
    if SODIUM_LIB == 0:
        set SODIUM_LIB to ep_dlopen("libsodium.so.26")
    if SODIUM_LIB == 0:
        set SODIUM_LIB to ep_dlopen("libsodium.so.23")
    if SODIUM_LIB == 0:
        set SODIUM_LIB to ep_dlopen("libsodium.dll")
    if SODIUM_LIB == 0:
        set SODIUM_LIB to ep_dlopen("sodium.dll")
    return SODIUM_LIB

define ffi_sodium_init returning Int:
    set ok to sodium_ffi_load()
    set fn to ep_dlsym(SODIUM_LIB and "sodium_init")
    return ep_dlcall0(fn)

# Keypair generation — takes raw Int pointers
define ffi_sign_keypair with pk_ptr as Int and sk_ptr as Int returning Int:
    set fn to ep_dlsym(SODIUM_LIB and "crypto_sign_keypair")
    return ep_dlcall2(fn and pk_ptr and sk_ptr)

define ffi_box_keypair with pk_ptr as Int and sk_ptr as Int returning Int:
    set fn to ep_dlsym(SODIUM_LIB and "crypto_box_keypair")
    return ep_dlcall2(fn and pk_ptr and sk_ptr)

# Random bytes
define ffi_randombytes with buf_ptr as Int and size as Int returning Int:
    set fn to ep_dlsym(SODIUM_LIB and "randombytes_buf")
    return ep_dlcall2(fn and buf_ptr and size)

# Hex <-> bin conversion
define ffi_bin2hex with hex_ptr as Int and hex_maxlen as Int and bin_ptr as Int and bin_len as Int returning Int:
    set fn to ep_dlsym(SODIUM_LIB and "sodium_bin2hex")
    return ep_dlcall4(fn and hex_ptr and hex_maxlen and bin_ptr and bin_len)

define ffi_hex2bin with bin_ptr as Int and bin_maxlen as Int and hex_str as Int and hex_len as Int and ignore as Int and binlen_out as Int and hex_end as Int returning Int:
    # hex_str is a Str but ep_dlcall passes it as long long = char* pointer
    set fn to ep_dlsym(SODIUM_LIB and "sodium_hex2bin")
    return ep_dlcall7(fn and bin_ptr and bin_maxlen and hex_str and hex_len and ignore and binlen_out and hex_end)

# Sign detached — msg can be Str (char*)
define ffi_sign_detached with sig_ptr as Int and siglen_ptr as Int and msg as Int and msglen as Int and sk_ptr as Int returning Int:
    set fn to ep_dlsym(SODIUM_LIB and "crypto_sign_detached")
    return ep_dlcall5(fn and sig_ptr and siglen_ptr and msg and msglen and sk_ptr)

# Verify detached — msg can be Str (char*)
define ffi_sign_verify_detached with sig_ptr as Int and msg as Int and msglen as Int and pk_ptr as Int returning Int:
    set fn to ep_dlsym(SODIUM_LIB and "crypto_sign_verify_detached")
    return ep_dlcall4(fn and sig_ptr and msg and msglen and pk_ptr)

# Secretbox (symmetric) — msg can be Str (char*)
define ffi_secretbox_easy with cipher_ptr as Int and msg as Int and msglen as Int and nonce_ptr as Int and key_ptr as Int returning Int:
    set fn to ep_dlsym(SODIUM_LIB and "crypto_secretbox_easy")
    return ep_dlcall5(fn and cipher_ptr and msg and msglen and nonce_ptr and key_ptr)

define ffi_secretbox_open_easy with msg_ptr as Int and cipher_ptr as Int and cipherlen as Int and nonce_ptr as Int and key_ptr as Int returning Int:
    set fn to ep_dlsym(SODIUM_LIB and "crypto_secretbox_open_easy")
    return ep_dlcall5(fn and msg_ptr and cipher_ptr and cipherlen and nonce_ptr and key_ptr)

# Box (public-key) — msg can be Str (char*)
define ffi_box_easy with cipher_ptr as Int and msg as Int and msglen as Int and nonce_ptr as Int and pk_ptr as Int and sk_ptr as Int returning Int:
    set fn to ep_dlsym(SODIUM_LIB and "crypto_box_easy")
    return ep_dlcall6(fn and cipher_ptr and msg and msglen and nonce_ptr and pk_ptr and sk_ptr)

define ffi_box_open_easy with msg_ptr as Int and cipher_ptr as Int and cipherlen as Int and nonce_ptr as Int and pk_ptr as Int and sk_ptr as Int returning Int:
    set fn to ep_dlsym(SODIUM_LIB and "crypto_box_open_easy")
    return ep_dlcall6(fn and msg_ptr and cipher_ptr and cipherlen and nonce_ptr and pk_ptr and sk_ptr)

# Memory zeroing
define ffi_memzero with ptr as Int and len as Int returning Int:
    set fn to ep_dlsym(SODIUM_LIB and "sodium_memzero")
    return ep_dlcall2(fn and ptr and len)
