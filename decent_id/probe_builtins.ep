# Probe: verify all new builtins compile
import "crypto"
import "string"

define main returning Int:
    display "=== Verifying new EP builtins ==="

    # 1. str_to_ptr / ptr_to_str
    set test_str to "hello from EP"
    set ptr to str_to_ptr(test_str)
    display f"str_to_ptr: {ptr}"
    set recovered to ptr_to_str(ptr)
    display f"ptr_to_str: {recovered}"

    # 2. alloc_bytes / free_bytes
    set buf to alloc_bytes(32)
    display f"alloc_bytes(32): {buf}"

    # 3. peek_byte / poke_byte
    poke_byte(buf and 0 and 65)
    poke_byte(buf and 1 and 66)
    poke_byte(buf and 2 and 67)
    set b0 to peek_byte(buf and 0)
    set b1 to peek_byte(buf and 1)
    set b2 to peek_byte(buf and 2)
    display f"peek_byte: {b0} {b1} {b2}"

    # 4. list_to_bytes / bytes_to_list
    set my_list to create_list()
    set ok to append_list(my_list and 72)
    set ok to append_list(my_list and 73)
    set ok to append_list(my_list and 74)
    set packed to list_to_bytes(my_list)
    display f"list_to_bytes: {packed}"
    set back_list to bytes_to_list(packed and 3)
    display f"bytes_to_list len: {length_list(back_list)}"
    display f"bytes_to_list[0]: {get_list(back_list and 0)}"

    # Borrow-checker rejection is a compile-time negative test and is exercised by
    # the compiler suite rather than this executable runtime probe.
    display "borrow checker coverage: compiler suite"

    set ok to free_bytes(buf)
    set ok to free_bytes(packed)

    display "=== Selected runtime builtins verified ==="
    return 0
