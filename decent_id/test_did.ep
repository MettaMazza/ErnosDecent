# ErnosDecent -- Test Suite for decent_id/did.ep
# Tests: DID creation, resolution, roundtrip, base58, auth challenge
# Status: Production -- OperationTrojanClaude Phase 2

import "did"
import "keys"
import "string"
import "test"
import "../storage"

# ================================================================
# Test 1: Base58btc encode/decode roundtrip
# ================================================================

define test_base58_roundtrip returning Int:
    display "TEST 1: Base58btc encode/decode roundtrip"
    # Known test vector: 0x0000 prefix + random bytes
    set hex_input to "ed01aabbccdd00112233445566778899aabbccdd00112233445566778899aabb"
    set encoded to base58_encode(hex_input)
    assert_true(string_length(encoded) > 0 and "base58 encode should produce output")

    set decoded to base58_decode(encoded)
    if decoded equals hex_input:
        display "  PASS"
    else:
        display "  FAIL: roundtrip mismatch"
        display f"    input:   {hex_input}"
        display f"    encoded: {encoded}"
        display f"    decoded: {decoded}"
        return 1
    return 0

# ================================================================
# Test 2: DID:key from Ed25519 public key
# ================================================================

define test_did_key_ed25519 returning Int:
    display "TEST 2: DID:key from Ed25519 public key"
    set kp to generate_signing_keypair()
    set pub_key to ptr_to_str(map_get_val(kp and "public_key"))

    set did to create_did_key_from_ed25519(pub_key)
    assert_true(string_length(did) > 0 and "DID should be non-empty")

    # DID must start with "did:key:z"
    set prefix to substring(did and 0 and 9)
    if prefix equals "did:key:z":
        set ok to 1
    else:
        display "  FAIL: DID does not start with did:key:z"
        display f"    got: {prefix}"
        return 1

    display f"  DID: {did}"
    display "  PASS"
    return 0

# ================================================================
# Test 3: DID:key from X25519 public key
# ================================================================

define test_did_key_x25519 returning Int:
    display "TEST 3: DID:key from X25519 public key"
    set kp to generate_encryption_keypair()
    set pub_key to map_get_val(kp and "public_key")

    set did to create_did_key_from_x25519(pub_key)
    assert_true(string_length(did) > 0 and "DID should be non-empty")

    set prefix to substring(did and 0 and 9)
    if prefix equals "did:key:z":
        set ok to 1
    else:
        display "  FAIL: DID does not start with did:key:z"
        return 1

    display f"  DID: {did}"
    display "  PASS"
    return 0

# ================================================================
# Test 4: DID:key resolve roundtrip (Ed25519)
# ================================================================

define test_did_key_resolve_ed25519 returning Int:
    display "TEST 4: DID:key resolve roundtrip (Ed25519)"
    set kp to generate_signing_keypair()
    set pub_key to map_get_val(kp and "public_key")

    set did to create_did_key_from_ed25519(pub_key)
    set resolved to resolve_did_key(did)
    assert_true(map_get_val(resolved and "error") == DID_ERR_NONE and "resolve should succeed")

    set resolved_key to ptr_to_str(map_get_val(resolved and "public_key_hex"))
    if string_equals(resolved_key and pub_key) == 1:
        set ok to 1
    else:
        display "  FAIL: resolved public key does not match original"
        display f"    original: {pub_key}"
        display f"    resolved: {resolved_key}"
        return 1

    set key_type to map_get_val(resolved and "key_type")
    if key_type equals DID_KEY_TYPE_ED25519:
        set ok to 1
    else:
        display "  FAIL: key type mismatch"
        return 1

    display "  PASS"
    return 0

