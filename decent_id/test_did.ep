# ================================================================
# Test 6: Two DIDs from different keys must differ
# ================================================================

define test_did_uniqueness returning Int:
    display "TEST 6: Two DIDs from different keys must differ"
    set kp1 to generate_signing_keypair()
    set kp2 to generate_signing_keypair()

    set did1 to create_did_key_from_ed25519(map_get_val(kp1 and "public_key"))
    set did2 to create_did_key_from_ed25519(map_get_val(kp2 and "public_key"))

    if did1 equals did2:
        display "  FAIL: two different keys produced the same DID"
        return 1

    display "  PASS"
    return 0

# ================================================================
# Test 7: Same key always produces the same DID (deterministic)
# ================================================================

define test_did_deterministic returning Int:
    display "TEST 7: Same key always produces same DID (deterministic)"
    set kp to generate_signing_keypair()
    set pub_key to ptr_to_str(map_get_val(kp and "public_key"))

    set did1 to create_did_key_from_ed25519(pub_key)
    set did2 to create_did_key_from_ed25519(pub_key)

    if did1 equals did2:
        display "  PASS"
    else:
        display "  FAIL: same key produced different DIDs"
        return 1
    return 0

# ================================================================
# Test 8: Invalid DID resolution must fail
# ================================================================

define test_invalid_did returning Int:
    display "TEST 8: Invalid DID resolution must fail"

    # Empty DID
    set r1 to resolve_did_key("")
    assert_true(map_get_val(r1 and "error") != DID_ERR_NONE and "empty DID should fail")

    # Wrong method
    set r2 to resolve_did_key("did:web:example.com")
    assert_true(map_get_val(r2 and "error") != DID_ERR_NONE and "wrong method should fail")

    # Truncated DID
    set r3 to resolve_did_key("did:key:z")
    assert_true(map_get_val(r3 and "error") != DID_ERR_NONE and "truncated DID should fail")

    display "  PASS"
    return 0

# ================================================================
# Test 9: DID Document creation
# ================================================================

define test_did_document returning Int:
    display "TEST 9: DID Document creation"
    set kp_sign to generate_signing_keypair()
    set kp_enc to generate_encryption_keypair()
    set sign_pub to map_get_val(kp_sign and "public_key")
    set enc_pub to map_get_val(kp_enc and "public_key")

    set doc_result to create_did_document(sign_pub and enc_pub)
    assert_true(map_get_val(doc_result and "error") == DID_ERR_NONE and "doc creation should succeed")

    set did to map_get_val(doc_result and "did")
    assert_true(string_length(did) > 0 and "DID should be non-empty")

    set document to map_get_val(doc_result and "document")
    assert_true(string_length(document) > 100 and "document should be substantial")
    assert_true(string_contains(document and "verificationMethod") == 1 and "document should contain verificationMethod")
    assert_true(string_contains(document and "authentication") == 1 and "document should contain authentication")
    assert_true(string_contains(document and "keyAgreement") == 1 and "document should contain keyAgreement")
    assert_true(string_contains(document and sign_pub) == 1 and "document should contain signing public key")
    assert_true(string_contains(document and enc_pub) == 1 and "document should contain encryption public key")

    display "  PASS"
    return 0

# ================================================================
# Test 10: Challenge-response authentication
# ================================================================

define test_auth_challenge returning Int:
    display "TEST 10: Challenge-response authentication"
    set kp to generate_signing_keypair()
    set pub_key to map_get_val(kp and "public_key")
    set sec_key to map_get_val(kp and "secret_key")

    # Create challenge
    set challenge to create_auth_challenge()
    assert_true(string_length(challenge) == 64 and "challenge should be 64 hex chars (32 bytes)")

    # Respond to challenge
    set response to respond_to_challenge(challenge and sec_key)
    assert_true(map_get_val(response and "error") == DID_ERR_NONE and "response should succeed")

    set sig to map_get_val(response and "response")
    assert_true(string_length(sig) == 128 and "response should be 128 hex chars (Ed25519 sig)")

    # Verify
    set verify_result to verify_challenge_response(challenge and sig and pub_key)
    assert_true(verify_result == DID_ERR_NONE and "verification should succeed")

    display "  PASS"
    return 0

# ================================================================
# Test 11: Challenge-response with wrong key must fail
# ================================================================

define test_auth_wrong_key returning Int:
    display "TEST 11: Challenge-response with wrong key must fail"
    set kp1 to generate_signing_keypair()
    set kp2 to generate_signing_keypair()

    set challenge to create_auth_challenge()
    set response to respond_to_challenge(challenge and map_get_val(kp1 and "secret_key"))
    set sig to map_get_val(response and "response")

    # Verify with wrong key
    set verify_result to verify_challenge_response(challenge and sig and map_get_val(kp2 and "public_key"))
    assert_true(verify_result == DID_ERR_VERIFICATION_FAILED and "wrong key should fail verification")

    display "  PASS"
    return 0

# ================================================================
# Test 12: Full identity creation
# ================================================================

define test_create_identity returning Int:
    display "TEST 12: Full identity creation"
    set id to create_identity()
    assert_true(map_get_val(id and "error") == DID_ERR_NONE and "identity creation should succeed")

    set did to map_get_val(id and "did")
    assert_true(string_length(did) > 0 and "DID should be non-empty")

    set document to map_get_val(id and "document")
    assert_true(string_length(document) > 100 and "document should be substantial")

    set sign_pub to map_get_val(id and "signing_public_key")
    set sign_sec to map_get_val(id and "signing_secret_key")
    set enc_pub to map_get_val(id and "encryption_public_key")
    set enc_sec to map_get_val(id and "encryption_secret_key")
    set id_hash to map_get_val(id and "identity_hash")

    assert_true(string_length(sign_pub) == 64 and "signing public key should be 64 hex chars")
    assert_true(string_length(sign_sec) == 128 and "signing secret key should be 128 hex chars")
    assert_true(string_length(enc_pub) == 64 and "encryption public key should be 64 hex chars")
    assert_true(string_length(enc_sec) == 64 and "encryption secret key should be 64 hex chars")
    assert_true(string_length(id_hash) == 64 and "identity hash should be 64 hex chars")

    # DID should resolve back to the signing public key
    set resolved to resolve_did_key(did)
    assert_true(map_get_val(resolved and "error") == DID_ERR_NONE and "DID should resolve")
    set resolved_key to map_get_val(resolved and "public_key_hex")
    if resolved_key equals sign_pub:
        set ok to 1
    else:
        display "  FAIL: resolved key mismatch"
        return 1

    display f"  DID: {did}"
    display "  PASS"
    return 0

# ================================================================
# Test 13: DID:peer creation and resolution
# ================================================================

define test_did_peer returning Int:
    display "TEST 13: DID:peer creation and resolution"
    set kp to generate_signing_keypair()
    set pub_key to map_get_val(kp and "public_key")

    set peer_did to create_did_peer(pub_key)
    assert_true(string_length(peer_did) > 0 and "peer DID should be non-empty")

    set prefix to substring(peer_did and 0 and 11)
    if prefix equals "did:peer:0z":
        set ok to 1
    else:
        display "  FAIL: peer DID does not start with did:peer:0z"
        return 1

    # Resolve back
    set resolved to resolve_did_peer(peer_did)
    assert_true(map_get_val(resolved and "error") == DID_ERR_NONE and "peer DID should resolve")

    set resolved_key to ptr_to_str(map_get_val(resolved and "public_key_hex"))
    if string_equals(resolved_key and pub_key) == 1:
        set ok to 1
    else:
        display "  FAIL: resolved key mismatch"
        return 1

    display f"  Peer DID: {peer_did}"
    display "  PASS"
    return 0

# ================================================================
# Test 14: Wrong key length must be rejected
# ================================================================

define test_invalid_key_length returning Int:
    display "TEST 14: Wrong key length must be rejected"

    # Too short
    set short_did to create_did_key_from_ed25519("aabb")
    assert_true(string_length(short_did) == 0 and "short key should produce empty DID")

    # Too long
    set long_key to "aabbccdd00112233445566778899aabbccdd00112233445566778899aabbccddee"
    set long_did to create_did_key_from_ed25519(long_key)
    assert_true(string_length(long_did) == 0 and "long key should produce empty DID")

    # Document with wrong key
    set doc_result to create_did_document("short" and "alsoshort")
    assert_true(map_get_val(doc_result and "error") == DID_ERR_KEY_LENGTH and "short keys should fail")

    display "  PASS"
    return 0

# ================================================================
# Main -- Run all tests
# ================================================================

define main returning Int:
    display "==================================================="
    display "  ErnosDecent -- decent_id/did.ep Test Suite"
    display "  OperationTrojanClaude Phase 2"
    display "==================================================="
    display ""

    set test_storage_dir to concat("/tmp/ernos_did_test_" and int_to_string(ep_time_now_ms()))
    set storage_err to storage_init(test_storage_dir)
    if storage_err != STORAGE_ERR_NONE:
        display f"FATAL: test storage initialization failed with {storage_err}"
        return 1

    set failures to 0
    set failures to failures + test_base58_roundtrip()
    set failures to failures + test_did_key_ed25519()
    set failures to failures + test_did_key_x25519()
    set failures to failures + test_did_key_resolve_ed25519()
    set failures to failures + test_did_key_resolve_x25519()
    set failures to failures + test_did_uniqueness()
    set failures to failures + test_did_deterministic()
    set failures to failures + test_invalid_did()
    set failures to failures + test_did_document()
    set failures to failures + test_auth_challenge()
    set failures to failures + test_auth_wrong_key()
    set failures to failures + test_create_identity()
    set failures to failures + test_did_peer()
    set failures to failures + test_invalid_key_length()

    display ""
    display "==================================================="
    display f"  14 tests executed; {failures} failed."
    display "==================================================="
    if failures > 0:
        return 1
    return 0
