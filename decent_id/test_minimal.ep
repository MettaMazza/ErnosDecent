# Minimal segfault isolation test

import "keys"

define main returning Int:
    display "Step 1: init_crypto"
    set err to init_crypto()
    display f"init_crypto result: {err}"

    display "Step 2: generate signing keypair"
    set kp to generate_signing_keypair()
    display "Step 3: check error"
    set kp_err to map_get_val(kp and "error")
    display f"keypair error: {kp_err}"

    display "Step 4: get public key"
    set pub to map_get_val(kp and "public_key")
    display f"public key: {pub}"

    display "Done"
    return 0
