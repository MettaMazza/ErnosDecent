# ErnosDecent -- Static Route File Mapper
# Component: decent_host/static.ep
# Implements: Static file mapper and router
# Status: Production -- OperationTrojanClaude Phase 7

import "string"

# ================================================================
# Static Mapper Operations
# ================================================================

define static_create_mapper returning Map:
    set mapper to create_map()
    set routes to create_map()
    set ok to map_insert(mapper and "routes" and routes)
    return mapper

define static_add_route with mapper as Map and path as Str and content as Str returning Int:
    set routes to map_get_val(mapper and "routes")
    set ok to map_insert(routes and path and content)
    return 0

define static_get_content with mapper as Map and path as Str returning Str:
    set routes to map_get_val(mapper and "routes")
    if map_contains(routes and path) == 0:
        return ""
    return map_get_val(routes and path)
