import "decent_money/wallet"
import "stdlib/string"
import "stdlib/collections"

define my_split with s as Str and delimiter as Str returning List:
    set result to create_list()
    set current to create_list()
    set slen to string_length(s)
    set dlen to string_length(delimiter)
    display concat("my_split: slen=" and int_to_string(slen))
    display concat("my_split: dlen=" and int_to_string(dlen))
    set i to 0
    repeat while i < slen:
        if i + dlen < slen + 1:
            set sub to substring(s and i and dlen)
            set eq to string_equals(sub and delimiter)
            if eq == 1:
                set word to string_from_list(current)
                set ok to append_list(result and word)
                set current to create_list()
                set i to i + dlen
            else:
                set ok to append_list(current and get_character(s and i))
                set i to i + 1
        else:
            set ok to append_list(current and get_character(s and i))
            set i to i + 1
    set word to string_from_list(current)
    set ok to append_list(result and word)
    return result

define main:
    set crypto_err to init_crypto()
    set gc_guard to create_list()
    set mnemonic to wallet_generate_mnemonic()
    set ok to append_list(gc_guard and mnemonic)
    display mnemonic
    
    set words to my_split(mnemonic and " ")
    display concat("my_split words length: " and int_to_string(length_list(words)))
    
    if length_list(gc_guard) >= 0:
        set dummy to 1
        
    return 0
