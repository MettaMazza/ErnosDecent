# ErnosDecent executable-test assertions.
#
# The compiler standard-library assertions return 0 after printing a failure.
# Legacy executable tests ignored that return value and therefore exited 0.
# These assertions are deliberately fail-fast so every failed assertion is
# observable by shell, CI, and higher-level test runners.

import "os"

define assert_true with condition as Int and message as Str returning Int:
    if condition != 0:
        return 1
    display concat("FAIL: " and message)
    exit_program(1)
    return 0

define assert_equal with actual as Int and expected as Int and message as Str returning Int:
    if actual == expected:
        return 1
    display concat("FAIL: " and message)
    display f"  expected: {expected}"
    display f"  actual: {actual}"
    exit_program(1)
    return 0
