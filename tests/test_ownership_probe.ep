import "collections"

define ownership_make_nested returning List:
    set outer to create_list()
    set child to create_map()
    set ok to map_insert(child and "value" and "alive")
    set ok to append_list(outer and child)
    return outer

define main returning Int:
    set nested to ownership_make_nested()
    set i to 0
    repeat while i < 100000:
        set churn to create_map()
        set ok to map_insert(churn and "i" and i)
        set i to i + 1
    set child to get_list(nested and 0)
    if (map_get_val(child and "value") equals "alive") == 0:
        display "FAIL: nested map did not survive its creator"
        return 1
    display "PASS: nested map survived its creator"
    return 0
