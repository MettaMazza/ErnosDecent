# ErnosDecent -- Relay-over-Transport Test Suite
# Component: decent_net/test_relay_transport.ep
# Tests: Register, Connect, Forward, Heartbeat over real TCP

import "relay_transport"
import "relay"
import "transport"
import "string"
import "collections"
import "net"
import "../decent_id/keys"

define relay_test_server with relay as Int and listen_fd as Int and msg_count as Int:
    set i to 0
    repeat while i < msg_count:
        set client_fd to ep_net_accept(listen_fd)
        if client_fd >= 0:
            set conn to create_map()
            set ok to map_insert(conn and "fd" and client_fd)
            set ok to map_insert(conn and "connected" and 1)
            set ok to relay_handle_transport_message(relay and conn)
            transport_close(conn)
            free_map(conn)
        set i to i + 1
    return 0

define main:
    display "==================================================="
    display "  ErnosDecent -- Relay-over-Transport Test Suite"
    display "  Relay Protocol over TCP — Phase 2"
    display "==================================================="
    display ""

    set tests_passed to 0
    set tests_failed to 0

    set init_err to init_crypto()

    # ===========================================================
    # TEST 1: Register with relay over TCP
    # ===========================================================
    display "TEST 1: Register with relay over TCP"
    set t1_ok to 1

    set relay1 to create_relay_node("relay_alpha")
    set listen_fd to ep_net_listen(22001)
    if listen_fd < 0:
        display "  FAIL: could not listen"
        set t1_ok to 0

    if t1_ok == 1:
        spawn relay_test_server(relay1 and listen_fd and 1)
        set ok to ep_sleep_ms(50)

        set reg_err to relay_rpc_register("127.0.0.1" and 22001 and "node_A" and "aaaa1111bbbb2222cccc3333dddd4444")
        if reg_err != RELAY_NET_ERR_NONE:
            display f"  FAIL: register failed with error {reg_err}"
            set t1_ok to 0

    if t1_ok == 1:
        display "  PASS"
        set tests_passed to tests_passed + 1
    else:
        set tests_failed to tests_failed + 1

    set ok to ep_sleep_ms(100)
    if listen_fd >= 0:
        set ok to ep_net_close(listen_fd)

    # ===========================================================
    # TEST 2: Connect circuit through relay over TCP
    # ===========================================================
    display "TEST 2: Connect circuit through relay over TCP"
    set t2_ok to 1

    # Pre-register two nodes on the relay
    set relay2 to create_relay_node("relay_beta")
    set ok to relay_register(relay2 and "node_B" and "bbbb1111")
    set ok to relay_register(relay2 and "node_C" and "cccc2222")

    set listen_fd2 to ep_net_listen(22002)
    if listen_fd2 < 0:
        display "  FAIL: could not listen"
        set t2_ok to 0

    if t2_ok == 1:
        spawn relay_test_server(relay2 and listen_fd2 and 1)
        set ok to ep_sleep_ms(50)

        set connect_result to relay_rpc_connect("127.0.0.1" and 22002 and "node_B" and "node_C")
        set connect_err to map_get_val(connect_result and "error")
        if connect_err != RELAY_NET_ERR_NONE:
            display f"  FAIL: connect failed with error {connect_err}"
            set t2_ok to 0
        else:
            set circuit_id to map_get_val(connect_result and "circuit_id")
            if string_length(circuit_id) < 10:
                display f"  FAIL: circuit_id too short: {circuit_id}"
                set t2_ok to 0
        free_map(connect_result)

    if t2_ok == 1:
        display "  PASS"
        set tests_passed to tests_passed + 1
    else:
        set tests_failed to tests_failed + 1

    set ok to ep_sleep_ms(100)
    if listen_fd2 >= 0:
        set ok to ep_net_close(listen_fd2)

    # ===========================================================
    # TEST 3: Forward data through relay over TCP
    # ===========================================================
    display "TEST 3: Forward data through relay circuit"
    set t3_ok to 1

    set relay3 to create_relay_node("relay_gamma")
    set ok to relay_register(relay3 and "node_D" and "dddd3333")
    set ok to relay_register(relay3 and "node_E" and "eeee4444")
    set circuit3 to relay_create_circuit(relay3 and "node_D" and "node_E")
    set circuit3_err to map_get_val(circuit3 and "error")
    set circuit3_id to ""
    if circuit3_err == RELAY_ERR_NONE:
        set circuit3_id to map_get_val(circuit3 and "circuit_id")

    if circuit3_err != RELAY_ERR_NONE:
        display f"  FAIL: could not create circuit: {circuit3_err}"
        set t3_ok to 0

    set listen_fd3 to ep_net_listen(22003)
    if listen_fd3 < 0:
        display "  FAIL: could not listen"
        set t3_ok to 0

    if t3_ok == 1:
        spawn relay_test_server(relay3 and listen_fd3 and 1)
        set ok to ep_sleep_ms(50)

        set fwd_err to relay_rpc_forward("127.0.0.1" and 22003 and circuit3_id and "deadbeefcafe1234")
        if fwd_err != RELAY_NET_ERR_NONE:
            display f"  FAIL: forward failed with error {fwd_err}"
            set t3_ok to 0

    if t3_ok == 1:
        display "  PASS"
        set tests_passed to tests_passed + 1
    else:
        set tests_failed to tests_failed + 1

    set ok to ep_sleep_ms(100)
    if listen_fd3 >= 0:
        set ok to ep_net_close(listen_fd3)

    # ===========================================================
    # TEST 4: Heartbeat over TCP
    # ===========================================================
    display "TEST 4: Heartbeat over TCP"
    set t4_ok to 1

    set relay4 to create_relay_node("relay_delta")
    set ok to relay_register(relay4 and "node_F" and "ffff5555")

    set listen_fd4 to ep_net_listen(22004)
    if listen_fd4 < 0:
        display "  FAIL: could not listen"
        set t4_ok to 0

    if t4_ok == 1:
        spawn relay_test_server(relay4 and listen_fd4 and 1)
        set ok to ep_sleep_ms(50)

        set hb_err to relay_rpc_heartbeat("127.0.0.1" and 22004 and "node_F")
        if hb_err != RELAY_NET_ERR_NONE:
            display f"  FAIL: heartbeat failed with error {hb_err}"
            set t4_ok to 0

    if t4_ok == 1:
        display "  PASS"
        set tests_passed to tests_passed + 1
    else:
        set tests_failed to tests_failed + 1

    set ok to ep_sleep_ms(100)
    if listen_fd4 >= 0:
        set ok to ep_net_close(listen_fd4)

    # ===========================================================
    # TEST 5: Connect to unregistered target fails
    # ===========================================================
    display "TEST 5: Connect to unregistered target fails"
    set t5_ok to 1

    set relay5 to create_relay_node("relay_epsilon")
    set ok to relay_register(relay5 and "node_G" and "gggg6666")
    # node_H NOT registered

    set listen_fd5 to ep_net_listen(22005)
    if listen_fd5 < 0:
        display "  FAIL: could not listen"
        set t5_ok to 0

    if t5_ok == 1:
        spawn relay_test_server(relay5 and listen_fd5 and 1)
        set ok to ep_sleep_ms(50)

        set connect_result to relay_rpc_connect("127.0.0.1" and 22005 and "node_G" and "node_H")
        set connect_err to map_get_val(connect_result and "error")
        if connect_err == RELAY_NET_ERR_NONE:
            display "  FAIL: should not connect to unregistered target"
            set t5_ok to 0
        free_map(connect_result)

    if t5_ok == 1:
        display "  PASS"
        set tests_passed to tests_passed + 1
    else:
        set tests_failed to tests_failed + 1

    set ok to ep_sleep_ms(100)
    if listen_fd5 >= 0:
        set ok to ep_net_close(listen_fd5)

    # ===========================================================
    # Summary
    # ===========================================================
    display ""
    display "==================================================="
    set total to tests_passed + tests_failed
    display f"  {tests_passed}/{total} tests passed."
    if tests_failed > 0:
        display f"  {tests_failed} FAILED!"
    display "==================================================="
    return 0
