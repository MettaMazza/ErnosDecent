# ErnosDecent -- Transport Layer Test Suite
# Component: decent_net/test_transport.ep
# Tests: TCP connection, framed send/recv, multi-message, error handling

import "transport"
import "string"
import "collections"
import "net"

define echo_server with listen_fd as Int:
    # Accept one client and echo back all messages with "ECHO:" prefix
    set client_fd to ep_net_accept(listen_fd)
    if client_fd < 0:
        display "  SERVER: accept failed"
        return 0

    set server_conn to create_map()
    set ok to map_insert(server_conn and "fd" and client_fd)
    set ok to map_insert(server_conn and "connected" and 1)

    set msg_count to 0
    set running to 1
    repeat while running == 1:
        set received to transport_recv(server_conn)
        set recv_err to map_get_val(received and "error")
        if recv_err != TRANSPORT_ERR_NONE:
            set running to 0
        else:
            set msg_type to map_get_val(received and "msg_type")
            set payload to map_get_val(received and "payload")

            if msg_type equals "STOP":
                set err to transport_send(server_conn and "STOP_ACK" and "bye")
                set running to 0
            else:
                set echo_payload to concat("ECHO:" and payload)
                set err to transport_send(server_conn and msg_type and echo_payload)
            set msg_count to msg_count + 1
        free_map(received)

    transport_close(server_conn)
    free_map(server_conn)
    return msg_count

define multi_echo_server with listen_fd as Int and client_count as Int:
    # Accept multiple sequential clients
    set ci to 0
    repeat while ci < client_count:
        set ok to echo_server(listen_fd)
        set ci to ci + 1
    return 0

define main:
    display "==================================================="
    display "  ErnosDecent -- decent_net/transport.ep Test Suite"
    display "  Transport Layer — Phase 2"
    display "==================================================="
    display ""

    set tests_passed to 0
    set tests_failed to 0

    # ===========================================================
    # TEST 1: Basic connect, send, receive, close
    # ===========================================================
    display "TEST 1: Basic framed send/receive over TCP"
    set t1_ok to 1

    set listener to transport_listen(19001)
    set listen_err to map_get_val(listener and "error")
    if listen_err != TRANSPORT_ERR_NONE:
        display "  FAIL: could not listen on port 19001"
        set t1_ok to 0

    if t1_ok == 1:
        # Start echo server in background
        set listen_fd to map_get_val(listener and "fd")
        spawn echo_server(listen_fd)
        set ok to ep_sleep_ms(50)

        # Connect client
        set conn to transport_connect("127.0.0.1" and 19001)
        set conn_err to map_get_val(conn and "error")
        if conn_err != TRANSPORT_ERR_NONE:
            display "  FAIL: connect failed"
            set t1_ok to 0

        if t1_ok == 1:
            # Send a DHT_PING
            set send_err to transport_send(conn and "DHT_PING" and "hello_from_test")
            if send_err != TRANSPORT_ERR_NONE:
                display "  FAIL: send failed"
                set t1_ok to 0

        if t1_ok == 1:
            # Receive echoed response
            set resp to transport_recv(conn)
            set recv_err to map_get_val(resp and "error")
            if recv_err != TRANSPORT_ERR_NONE:
                display f"  FAIL: recv failed with error {recv_err}"
                set t1_ok to 0
            else:
                set resp_type to map_get_val(resp and "msg_type")
                set resp_payload to map_get_val(resp and "payload")
                if resp_type equals "DHT_PING":
                    set ok to 1
                else:
                    display f"  FAIL: expected msg_type DHT_PING, got {resp_type}"
                    set t1_ok to 0
                if resp_payload equals "ECHO:hello_from_test":
                    set ok to 1
                else:
                    display f"  FAIL: expected ECHO:hello_from_test, got {resp_payload}"
                    set t1_ok to 0
            free_map(resp)

        # Send STOP to close server
        if t1_ok == 1:
            set ok to transport_send(conn and "STOP" and "done")
            set stop_resp to transport_recv(conn)
            free_map(stop_resp)

        transport_close(conn)
        free_map(conn)

    if t1_ok == 1:
        display "  PASS"
        set tests_passed to tests_passed + 1
    else:
        set tests_failed to tests_failed + 1

    set ok to ep_sleep_ms(100)
    set ok to ep_net_close(map_get_val(listener and "fd"))
    free_map(listener)

    # ===========================================================
    # TEST 2: Multiple messages on same connection
    # ===========================================================
    display "TEST 2: Multiple messages on same connection"
    set t2_ok to 1

    set listener2 to transport_listen(19002)
    if map_get_val(listener2 and "error") != TRANSPORT_ERR_NONE:
        display "  FAIL: could not listen on port 19002"
        set t2_ok to 0

    if t2_ok == 1:
        set listen_fd2 to map_get_val(listener2 and "fd")
        spawn echo_server(listen_fd2)
        set ok to ep_sleep_ms(50)

        set conn2 to transport_connect("127.0.0.1" and 19002)
        if map_get_val(conn2 and "error") != TRANSPORT_ERR_NONE:
            display "  FAIL: connect failed"
            set t2_ok to 0

        if t2_ok == 1:
            # Send 5 messages
            set mi to 0
            repeat while mi < 5:
                set msg_body to concat("msg_" and int_to_string(mi))
                set err to transport_send(conn2 and "CONSENSUS" and msg_body)
                if err != TRANSPORT_ERR_NONE:
                    display f"  FAIL: send {mi} failed"
                    set t2_ok to 0
                set mi to mi + 1

            # Receive 5 echoed messages
            set ri to 0
            repeat while ri < 5:
                set resp to transport_recv(conn2)
                set recv_err to map_get_val(resp and "error")
                if recv_err != TRANSPORT_ERR_NONE:
                    display f"  FAIL: recv {ri} failed"
                    set t2_ok to 0
                else:
                    set resp_type to map_get_val(resp and "msg_type")
                    if resp_type equals "CONSENSUS":
                        set ok to 1
                    else:
                        display f"  FAIL: msg {ri} wrong type: {resp_type}"
                        set t2_ok to 0
                    set expected_body to concat("ECHO:msg_" and int_to_string(ri))
                    set resp_payload to map_get_val(resp and "payload")
                    if resp_payload equals expected_body:
                        set ok to 1
                    else:
                        display f"  FAIL: msg {ri} wrong payload: {resp_payload}"
                        set t2_ok to 0
                free_map(resp)
                set ri to ri + 1

            # Close
            set ok to transport_send(conn2 and "STOP" and "done")
            set stop_resp to transport_recv(conn2)
            free_map(stop_resp)

        transport_close(conn2)
        free_map(conn2)

    if t2_ok == 1:
        display "  PASS"
        set tests_passed to tests_passed + 1
    else:
        set tests_failed to tests_failed + 1

    set ok to ep_sleep_ms(100)
    set ok to ep_net_close(map_get_val(listener2 and "fd"))
    free_map(listener2)

    # ===========================================================
    # TEST 3: Large payload
    # ===========================================================
    display "TEST 3: Large payload (4KB)"
    set t3_ok to 1

    set listener3 to transport_listen(19003)
    if map_get_val(listener3 and "error") != TRANSPORT_ERR_NONE:
        display "  FAIL: could not listen on port 19003"
        set t3_ok to 0

    if t3_ok == 1:
        set listen_fd3 to map_get_val(listener3 and "fd")
        spawn echo_server(listen_fd3)
        set ok to ep_sleep_ms(50)

        set conn3 to transport_connect("127.0.0.1" and 19003)
        if map_get_val(conn3 and "error") != TRANSPORT_ERR_NONE:
            display "  FAIL: connect failed"
            set t3_ok to 0

        if t3_ok == 1:
            # Build a large payload: repeat "A" 4096 times
            set big to ""
            set bi to 0
            repeat while bi < 256:
                set big to concat(big and "AAAAAAAAAAAAAAAA")
                set bi to bi + 1
            # big is now 4096 chars
            set big_len to string_length(big)
            if big_len != 4096:
                display f"  FAIL: expected 4096, built {big_len}"
                set t3_ok to 0

            set err to transport_send(conn3 and "DHT_STORE" and big)
            if err != TRANSPORT_ERR_NONE:
                display "  FAIL: large send failed"
                set t3_ok to 0

        if t3_ok == 1:
            set resp to transport_recv(conn3)
            set recv_err to map_get_val(resp and "error")
            if recv_err != TRANSPORT_ERR_NONE:
                display f"  FAIL: large recv failed with error {recv_err}"
                set t3_ok to 0
            else:
                set resp_payload to map_get_val(resp and "payload")
                # Echo adds "ECHO:" prefix (5 chars) -> 4101 total
                set resp_len to string_length(resp_payload)
                if resp_len != 4101:
                    display f"  FAIL: expected 4101 chars, got {resp_len}"
                    set t3_ok to 0
            free_map(resp)

            set ok to transport_send(conn3 and "STOP" and "done")
            set stop_resp to transport_recv(conn3)
            free_map(stop_resp)

        transport_close(conn3)
        free_map(conn3)

    if t3_ok == 1:
        display "  PASS"
        set tests_passed to tests_passed + 1
    else:
        set tests_failed to tests_failed + 1

    set ok to ep_sleep_ms(100)
    set ok to ep_net_close(map_get_val(listener3 and "fd"))
    free_map(listener3)

    # ===========================================================
    # TEST 4: Connection refused error handling
    # ===========================================================
    display "TEST 4: Connection refused error handling"
    set t4_ok to 1
    set bad_conn to transport_connect("127.0.0.1" and 19999)
    set bad_err to map_get_val(bad_conn and "error")
    if bad_err != TRANSPORT_ERR_CONNECT_FAILED:
        display f"  FAIL: expected CONNECT_FAILED (901), got {bad_err}"
        set t4_ok to 0
    free_map(bad_conn)

    if t4_ok == 1:
        display "  PASS"
        set tests_passed to tests_passed + 1
    else:
        set tests_failed to tests_failed + 1

    # ===========================================================
    # TEST 5: Convenience functions
    # ===========================================================
    display "TEST 5: Convenience typed message functions"
    set t5_ok to 1

    set listener5 to transport_listen(19005)
    if map_get_val(listener5 and "error") != TRANSPORT_ERR_NONE:
        display "  FAIL: could not listen on port 19005"
        set t5_ok to 0

    if t5_ok == 1:
        set listen_fd5 to map_get_val(listener5 and "fd")
        spawn echo_server(listen_fd5)
        set ok to ep_sleep_ms(50)

        set conn5 to transport_connect("127.0.0.1" and 19005)
        if map_get_val(conn5 and "error") != TRANSPORT_ERR_NONE:
            display "  FAIL: connect failed"
            set t5_ok to 0

        if t5_ok == 1:
            set err to transport_send_dht_ping(conn5 and "node_abc")
            if err != TRANSPORT_ERR_NONE:
                display "  FAIL: dht_ping send failed"
                set t5_ok to 0

        if t5_ok == 1:
            set resp to transport_recv(conn5)
            set recv_err to map_get_val(resp and "error")
            if recv_err != TRANSPORT_ERR_NONE:
                display "  FAIL: recv failed"
                set t5_ok to 0
            else:
                set resp_type to map_get_val(resp and "msg_type")
                if resp_type equals "DHT_PING":
                    set ok to 1
                else:
                    display f"  FAIL: expected DHT_PING, got {resp_type}"
                    set t5_ok to 0
                set resp_payload to map_get_val(resp and "payload")
                if resp_payload equals "ECHO:node_abc":
                    set ok to 1
                else:
                    display f"  FAIL: expected ECHO:node_abc, got {resp_payload}"
                    set t5_ok to 0
            free_map(resp)

            set ok to transport_send(conn5 and "STOP" and "done")
            set stop_resp to transport_recv(conn5)
            free_map(stop_resp)

        transport_close(conn5)
        free_map(conn5)

    if t5_ok == 1:
        display "  PASS"
        set tests_passed to tests_passed + 1
    else:
        set tests_failed to tests_failed + 1

    set ok to ep_sleep_ms(100)
    set ok to ep_net_close(map_get_val(listener5 and "fd"))
    free_map(listener5)

    # ===========================================================
    # TEST 6: Peer disconnect detection
    # ===========================================================
    display "TEST 6: Peer disconnect detection"
    set t6_ok to 1

    set listener6 to transport_listen(19006)
    if map_get_val(listener6 and "error") != TRANSPORT_ERR_NONE:
        display "  FAIL: could not listen on port 19006"
        set t6_ok to 0

    if t6_ok == 1:
        set listen_fd6 to map_get_val(listener6 and "fd")

        # Spawn a server that accepts and immediately closes
        spawn echo_server(listen_fd6)
        set ok to ep_sleep_ms(50)

        set conn6 to transport_connect("127.0.0.1" and 19006)
        if map_get_val(conn6 and "error") != TRANSPORT_ERR_NONE:
            display "  FAIL: connect failed"
            set t6_ok to 0

        if t6_ok == 1:
            # Send STOP to make server close
            set ok to transport_send(conn6 and "STOP" and "now")
            set stop_resp to transport_recv(conn6)
            free_map(stop_resp)
            set ok to ep_sleep_ms(50)

            # Now try to read from a closed connection
            set resp to transport_recv(conn6)
            set recv_err to map_get_val(resp and "error")
            # Should get PEER_DISCONNECTED or RECV_FAILED
            if recv_err == TRANSPORT_ERR_PEER_DISCONNECTED:
                set ok to 1
            else:
                if recv_err == TRANSPORT_ERR_MALFORMED_FRAME:
                    # Also acceptable — empty recv
                    set ok to 1
                else:
                    if recv_err == TRANSPORT_ERR_NONE:
                        display "  FAIL: should not succeed on closed connection"
                        set t6_ok to 0
            free_map(resp)

        transport_close(conn6)
        free_map(conn6)

    if t6_ok == 1:
        display "  PASS"
        set tests_passed to tests_passed + 1
    else:
        set tests_failed to tests_failed + 1

    set ok to ep_sleep_ms(100)
    set ok to ep_net_close(map_get_val(listener6 and "fd"))
    free_map(listener6)

    # ===========================================================
    # Summary
    # ===========================================================
    display ""
    display "==================================================="
    set total to tests_passed + tests_failed
    display f"  {tests_passed}/{total} tests passed."
    if tests_failed > 0:
        display f"  {tests_failed} FAILED!"
    display "==================================================="
    return 0
