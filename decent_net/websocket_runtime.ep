# ErnosDecent checked WebSocket runtime.

import "string"

external define ed_ws_send_text with fd as Int and message as Str and masked as Int returning Int:
external define ed_ws_send_close with fd as Int and masked as Int returning Int:
external define ed_ws_read_text with fd as Int and expect_masked as Int returning Str:
external define ed_ws_generate_key returning Str:
external define ed_ws_set_timeout with fd as Int and timeout_ms as Int returning Int:
external define ep_sha1 with data as Str returning Str:

define websocket_expected_accept with client_key as Str returning Str:
    return ep_sha1(concat(client_key and "258EAFA5-E914-47DA-95CA-C5AB0DC85B11"))

define websocket_send_server_text with fd as Int and message as Str returning Int:
    set result to ed_ws_send_text(fd and message and 0)
    if result != 0:
        display f"[WebSocket] server send failed on fd {fd}: {result}"
    return result

define websocket_send_client_text with fd as Int and message as Str returning Int:
    set result to ed_ws_send_text(fd and message and 1)
    if result != 0:
        display f"[WebSocket] client send failed on fd {fd}: {result}"
    return result

define websocket_send_client_close with fd as Int returning Int:
    set result to ed_ws_send_close(fd and 1)
    if result != 0:
        display f"[WebSocket] client close frame failed on fd {fd}: {result}"
    return result

define websocket_read_client_text with fd as Int returning Str:
    return ed_ws_read_text(fd and 1)

define websocket_read_server_text with fd as Int returning Str:
    return ed_ws_read_text(fd and 0)
