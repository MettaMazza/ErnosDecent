import "storage"

# Round-trip test for the GitDec auto-update per-repo config layer.
# Proves set/get/pending/list accessors persist and read back correctly.
define main returning Int:
    set r to storage_init("/tmp/gitdec_test_data")
    display "[test] storage_init done"

    # auto_update_enabled round-trip
    set s1 to storage_gitdec_set_auto_update("repoA" and 1)
    set g1 to storage_gitdec_get_auto_update("repoA")
    display concat("[test] repoA auto_update = " and int_to_string(g1))

    set s2 to storage_gitdec_set_auto_update("repoB" and 0)
    set g2 to storage_gitdec_get_auto_update("repoB")
    display concat("[test] repoB auto_update = " and int_to_string(g2))

    # toggle repoA off then on again (upsert path)
    set s1b to storage_gitdec_set_auto_update("repoA" and 0)
    set g1b to storage_gitdec_get_auto_update("repoA")
    display concat("[test] repoA after toggle-off = " and int_to_string(g1b))
    set s1c to storage_gitdec_set_auto_update("repoA" and 1)

    # last_seen round-trip
    set s3 to storage_gitdec_set_last_seen("repoA" and "abc123def")
    set ls to storage_gitdec_get_last_seen("repoA")
    display concat("[test] repoA last_seen = " and ls)

    # pending flag + count
    set s4 to storage_gitdec_set_pending("repoA" and 1)
    set cnt to storage_gitdec_count_pending()
    display concat("[test] pending count = " and int_to_string(cnt))
    set s5 to storage_gitdec_set_pending("repoA" and 0)
    set cnt2 to storage_gitdec_count_pending()
    display concat("[test] pending count after clear = " and int_to_string(cnt2))

    # list_auto_repos should contain repoA (enabled) but not repoB (disabled)
    set lst to storage_gitdec_list_auto_repos()
    display concat("[test] auto-repo count = " and int_to_string(length_list(lst)))

    display "[test] DONE"
    return 0
