# SAFETY: global cancel-EPOCH bump (injected by build.sh; latch semantics — see
# react_loop.ep). AI CANCEL bumps it so one Stop halts every concurrent run.
external define ep_cancel_epoch_bump with dummy returning Int

# NON-BLOCKING IPC: the IPC server loop spawns each client handler on its own
# OS thread (spawn handle_ipc_client). Only the agent’s react_run is serialized
# behind this mutex — non-agent commands (STATUS, HEALTH, AI CANCEL, TRACE POLL,
# etc.) execute immediately without acquiring it. This preserves the cooperative
# async invariant (one react_run at a time on the heap) while allowing cancel,
# status, and trace polling to proceed during long inference runs.
set AGENT_RUN_LOCK to create_mutex()

# ── Phase A2/A3: detached, parallel-per-session turns ───────────────────────────
# Turn-tracking maps live INSIDE agent_ctx (created in main AFTER runtime init):
#   agent_ctx["active_turns"] : session_id → 1 while a turn (or its pending
#     approval/clarification) is in flight — per-session serialization: a second
#     message to a BUSY session becomes a whisper; different sessions run genuinely
#     concurrent turns.
#   agent_ctx["turn_ctxs"]    : session_id → that turn's PRIVATE cloned ctx
#     (pending_action/clarification live there; approve/deny/clarify resume against it).
# NOT module globals: main-module map globals abort at boot (GC registration order),
# and EP module globals are unreliable from functions anyway. The shallow turn clone
# SHARES these two submaps, so the finish path reads them from its own tctx. Only ever
# touched from the single event-loop thread (mutations between awaits) — no mutex.

# Finish a detached turn: persist the conversation, build the EXACT legacy IPC payload
# string the bridge/web already parse (ai:ok|||RESPONSE|||…, ai:clarify, ai:pending_
# approval, ai:cancelled), and deliver it as a `final_reply` trace row keyed by the
# session — A3's decoupled delivery. Returns 1 when the turn stays OPEN (pending
# approval/clarification keeps the session busy and its ctx alive for the resume).
define node_finish_turn with tctx as Map and sessions_mgr as Map and memory as Map and sid as Str and agent_resp as Str returning Int:
    set tdb to storage_get_db()
    set stays_open to 0
    set resp to ""
    set unattended to 0
    if map_contains(tctx and "platform") == 1:
        if map_get_val(tctx and "platform") equals "scheduler" or else map_get_val(tctx and "platform") equals "upgrade_wake":
            set unattended to 1
    if map_contains(tctx and "was_cancelled") == 1:
        set ok to map_delete(tctx and "was_cancelled")
        set resp to f"ai:cancelled,response:{agent_resp}"
    else if unattended == 1 and also agent_resp equals "PENDING_CLARIFICATION":
        set resp to "ai:ok|||RESPONSE|||Scheduled job stopped: it requires clarification and cannot hold an unattended turn open. Run it interactively with the missing guidance."
    else if unattended == 1 and also agent_resp equals "PENDING_APPROVAL":
        set pending_u to map_get_val(tctx and "pending_action")
        set p_tool_u to map_get_val(pending_u and "tool_name")
        set resp to f"ai:ok|||RESPONSE|||Scheduled job stopped: tool '{p_tool_u}' requires interactive approval. Run the job manually or explicitly grant an appropriate scheduled-job policy."
    else if agent_resp equals "PENDING_CLARIFICATION":
        set pendingc to map_get_val(tctx and "pending_clarification")
        set c_questions to map_get_val(pendingc and "questions")
        set resp to f"ai:clarify,questions:{c_questions}"
        set stays_open to 1
    else if agent_resp equals "PENDING_APPROVAL":
        set pending to map_get_val(tctx and "pending_action")
        set p_tool to map_get_val(pending and "tool_name")
        set p_summary to map_get_val(pending and "summary")
        set resp to f"ai:pending_approval,tool:{p_tool},summary:{p_summary}"
        set stays_open to 1
    else:
        # Persist to THIS turn's session (never "the active one" — another session's
        # turn may have switched the global pointer while we ran).
        set sess_map to map_get_val(sessions_mgr and "sessions")
        if map_contains(sess_map and sid) == 1:
            set tsess to map_get_val(sess_map and sid)
            set ok to session_add_message(tsess and "assistant" and agent_resp)
            set dir to map_get_val(sessions_mgr and "sessions_dir")
            set filepath to path_join(dir and concat(sid and ".json"))
            set ok to session_serialize(tsess and filepath)
        set ser_err to memory_serialize(memory and "config/agent_memory.json")
        set last_reason to ""
        if map_contains(tctx and "last_reasoning") == 1:
            set last_reason to map_get_val(tctx and "last_reasoning")
            set ok to map_delete(tctx and "last_reasoning")
        if string_length(last_reason) > 0:
            set resp to f"ai:ok,reasoning:{base64_encode(last_reason)}|||RESPONSE|||{agent_resp}"
        else:
            set resp to f"ai:ok|||RESPONSE|||{agent_resp}"
    # TURN CORRELATION: prefix this turn's id so the bridge waiter can match the reply
    # to ITS request instead of taking the session's next final_reply (which delivered a
    # concurrent scheduler-job's reply as the user's answer — the tick bug).
    set ft_tag to ""
    if map_contains(tctx and "turn_id") == 1:
        set ft_tag to map_get_val(tctx and "turn_id")
        set resp to concat(f"turn:{ft_tag}," and resp)
    set final_publish_rc to trace_emit_terminal(tdb and sid and resp)
    if final_publish_rc != 0:
        # SQLite failure must never disappear into a successful turn. Preserve the
        # exact correlated payload through an atomic local fallback that the bridge
        # polls alongside the database queue.
        set fallback_rc to node_publish_final_fallback(sid and ft_tag and resp)
        if fallback_rc != 0:
            display f"[DELIVERY] FATAL: terminal reply could not be persisted for session={sid} turn={ft_tag}; turn remains active."
            return 1
        display f"[DELIVERY] SQLite terminal publication failed; durable file fallback published for session={sid} turn={ft_tag}."
    if stays_open == 0:
        # The shallow clone shares the shared turn-tracking maps — clear our flags.
        if map_contains(tctx and "active_turns") == 1:
            set fin_active to map_get_val(tctx and "active_turns")
            if map_contains(fin_active and sid) == 1:
                set ok to map_delete(fin_active and sid)
        if map_contains(tctx and "turn_ctxs") == 1:
            set fin_tcs to map_get_val(tctx and "turn_ctxs")
            if map_contains(fin_tcs and sid) == 1:
                set ok to map_delete(fin_tcs and sid)
    return stays_open

# Last-resort terminal-reply rail. The primary path remains SQLite, but a database
# write failure cannot strand a completed answer. A random 192-bit turn id makes the
# filename unique across restarts; write+read-back+rename prevents partial reads.
define node_publish_final_fallback with sid as Str and turn_tag as Str and payload as Str returning Int:
    if string_length(turn_tag) == 0:
        return 1
    set fallback_dir to path_join(storage_get_data_dir() and "delivery-fallback")
    if file_exists(fallback_dir) == 0:
        set made to create_directory(fallback_dir)
    if file_exists(fallback_dir) == 0:
        return 1
    set key to ep_sha256(concat(sid and concat("|" and turn_tag)))
    set final_path to path_join(fallback_dir and concat(key and ".reply"))
    set temp_path to concat(final_path and concat(".tmp." and int_to_string(ep_time_now_ms())))
    if write_file(temp_path and payload) == 0:
        return 1
    if read_file(temp_path) equals payload == 0:
        set removed_bad_temp to remove_file(temp_path)
        return 1
    if fs_move_file(temp_path and final_path) == 0:
        set removed_unmoved_temp to remove_file(temp_path)
        return 1
    if read_file(final_path) equals payload == 0:
        return 1
    return 0

define node_restart_after_staged_upgrade with tctx as Map and stays_open as Int returning Int:
    if stays_open == 1:
        return 0
    if map_contains(tctx and "upgrade_restart_requested") == 0:
        return 0
    set ok to map_delete(tctx and "upgrade_restart_requested")
    if file_exists("config/upgrades/pending.env") == 0:
        log_error("upgrade" and "Restart was requested without a pending transactional receipt; continuing the current executable.")
        return 1
    # The terminal reply, session state, memory, continuity ingestion, and trace rows
    # are all durable before this function is called. Only run_node.sh consumes 75.
    log_info("upgrade" and "Final reply persisted; handing the staged candidate to the runtime supervisor.")
    exit_program(75)
    return 0

# A detached foreground turn. Straight-line call to react_run (an awaiting PLAIN
# function) from an async define is the proven-safe shape (orchestrator_spawn_worker
# does exactly this); no awaits in loops here.
async define node_run_turn with model as Map and memory as Map and tools as Map and tctx as Map and sessions_mgr as Map and sid as Str and prompt as Str returning Int:
    # Retain the initiating request across approval/clarification pauses. It is removed
    # after the completed turn is ingested, never placed in a global process variable.
    set ok to map_insert(tctx and "continuity_user_text" and prompt)
    set agent_resp to react_run(model and memory and tools and tctx and prompt)
    set was_cancelled to 0
    if map_contains(tctx and "was_cancelled") == 1:
        set was_cancelled to 1
    set continuity_json to ""
    if map_contains(tctx and "continuity_json") == 1:
        set continuity_json to map_get_val(tctx and "continuity_json")
        set ok to map_delete(tctx and "continuity_json")
    # Deliver final_reply first. Semantic extraction has already happened inside the
    # existing capable-model reply audit, so persistence adds no further LLM call.
    set stays_open to node_finish_turn(tctx and sessions_mgr and memory and sid and agent_resp)
    set is_system_wake to 0
    if map_contains(tctx and "upgrade_wake") == 1:
        set is_system_wake to 1
    if stays_open == 0 and also was_cancelled == 0 and also is_system_wake == 0:
        set continuity_role to ""
        if map_contains(tctx and "sender_role") == 1:
            set continuity_role to map_get_val(tctx and "sender_role")
        # Every speaker advances the chronology of the shared current session. Guests
        # cannot write host relationship/project/long-term memories.
        set allow_durable_continuity to 1
        if continuity_role equals "guest":
            set allow_durable_continuity to 0
        set continuity_source to "local"
        if map_contains(tctx and "platform") == 1:
            set requested_source to map_get_val(tctx and "platform")
            if string_length(requested_source) > 0:
                set continuity_source to requested_source
        set continuity_persona to prompt_persona_current_name()
        set ok to continuity_ingest_turn(storage_get_db() and continuity_persona and sid and continuity_source and prompt and agent_resp and continuity_json and allow_durable_continuity)
        if map_contains(tctx and "continuity_user_text") == 1:
            set ok to map_delete(tctx and "continuity_user_text")
    set restart_rc to node_restart_after_staged_upgrade(tctx and stays_open)
    return 0

# A detached resume after approve/deny (kind 0) or clarification answers (kind 1).
async define node_resume_turn with model as Map and memory as Map and tools as Map and tctx as Map and sessions_mgr as Map and sid as Str and kind as Int and approved as Int and autoall as Int and answers as Str returning Int:
    set agent_resp to ""
    if kind == 1:
        set agent_resp to react_resume_clarify(model and memory and tools and tctx and answers and autoall)
    else:
        set agent_resp to react_resume_approved(model and memory and tools and tctx and approved and autoall)
    set continuity_json to ""
    if map_contains(tctx and "continuity_json") == 1:
        set continuity_json to map_get_val(tctx and "continuity_json")
        set ok to map_delete(tctx and "continuity_json")
    set stays_open to node_finish_turn(tctx and sessions_mgr and memory and sid and agent_resp)
    if stays_open == 0:
        set continuity_user_text to answers
        if map_contains(tctx and "continuity_user_text") == 1:
            set continuity_user_text to map_get_val(tctx and "continuity_user_text")
        if kind == 1 and also string_length(answers) > 0:
            set continuity_user_text to concat(continuity_user_text and concat("\nClarification: " and answers))
        set continuity_role to ""
        if map_contains(tctx and "sender_role") == 1:
            set continuity_role to map_get_val(tctx and "sender_role")
        set allow_durable_continuity to 1
        if continuity_role equals "guest":
            set allow_durable_continuity to 0
        set continuity_source to "local"
        if map_contains(tctx and "platform") == 1:
            set requested_source to map_get_val(tctx and "platform")
            if string_length(requested_source) > 0:
                set continuity_source to requested_source
        set continuity_persona to prompt_persona_current_name()
        set ok to continuity_ingest_turn(storage_get_db() and continuity_persona and sid and continuity_source and continuity_user_text and agent_resp and continuity_json and allow_durable_continuity)
        if map_contains(tctx and "continuity_user_text") == 1:
            set ok to map_delete(tctx and "continuity_user_text")
    set restart_rc to node_restart_after_staged_upgrade(tctx and stays_open)
    return 0

# Recover the exact originating session from the immutable protected-change manifest.
# Upgrade wake turns are system lifecycle events, never synthetic user messages.
define node_upgrade_wake_session with change_id as Str returning Str:
    if string_length(change_id) != 64:
        return ""
    set ec to string_replace(change_id and "'" and "''")
    set rows to sql_query(storage_get_db() and concat("SELECT manifest FROM rights_changes WHERE change_id='" and concat(ec and "' AND category='system_recompile' LIMIT 1;")))
    if length_list(rows) == 0:
        return ""
    set row to get_list(rows and 0)
    set manifest to ptr_to_str(get_list(row and 0))
    set root to json_parse(manifest)
    if root == 0:
        return ""
    set session_node to get_json_object_value(root and "session_id")
    if session_node == 0:
        return ""
    return get_json_value(session_node)

define node_upgrade_wake_write with payload as Str returning Int:
    set wake_path to "config/upgrades/wake.env"
    set temp_path to concat(wake_path and concat(".tmp." and int_to_string(ep_time_now_ms())))
    if write_file(temp_path and payload) == 0:
        return 1
    if read_file(temp_path) equals payload == 0:
        set removed_bad_temp to remove_file(temp_path)
        return 1
    if fs_move_file(temp_path and wake_path) == 0:
        set removed_unmoved_temp to remove_file(temp_path)
        return 1
    if read_file(wake_path) equals payload == 0:
        return 1
    return 0

define node_upgrade_wake_create with reconcile_result as Str returning Str:
    if file_exists("config/upgrades/outcome.env") == 0 or else file_exists("config/upgrades/pending.env") == 0:
        return "error_missing_transaction_receipt"
    set outcome to read_file("config/upgrades/outcome.env")
    set pending to read_file("config/upgrades/pending.env")
    set change_id to rights_marker_value(outcome and "change_id")
    set candidate_hash to rights_marker_value(outcome and "candidate_hash")
    set rollback_hash to rights_marker_value(outcome and "rollback_hash")
    set active_hash to rights_marker_value(outcome and "active_hash")
    set outcome_status to rights_marker_value(outcome and "status")
    set detail to rights_marker_value(outcome and "detail")
    set gate_hash to rights_marker_value(pending and "gate_manifest_hash")
    set session_id to node_upgrade_wake_session(change_id)
    set improvement_id to ""
    set improvement_name to ""
    set improvement_e2e_hash to ""
    set improvement_live_hash to ""
    set improvement_live_status to "none"
    set improvement_failure_hash to ""
    set improvement_failure_source_hash to ""
    set improvement_failure_fingerprint to ""
    set improvement_failure_attempt to "0"
    if file_exists("config/improvements/active.json") == 1:
        set improvement_root to json_parse(read_file("config/improvements/active.json"))
        if improvement_root == 0:
            return "error_malformed_improvement_receipt"
        set improvement_state_node to get_json_object_value(improvement_root and "state")
        set improvement_id_node to get_json_object_value(improvement_root and "id")
        set improvement_name_node to get_json_object_value(improvement_root and "name")
        set improvement_e2e_node to get_json_object_value(improvement_root and "e2e_hash")
        if improvement_state_node == 0 or else improvement_id_node == 0 or else improvement_name_node == 0 or else improvement_e2e_node == 0:
            return "error_incomplete_improvement_receipt"
        set improvement_live_status to get_json_value(improvement_state_node)
        set improvement_id to get_json_value(improvement_id_node)
        set improvement_name to get_json_value(improvement_name_node)
        set improvement_e2e_hash to get_json_value(improvement_e2e_node)
        if string_length(improvement_id) != 64 or else string_length(improvement_e2e_hash) != 64:
            return "error_unverified_improvement_receipt"
        if outcome_status equals "applied":
            set improvement_live_node to get_json_object_value(improvement_root and "live_output_hash")
            if improvement_live_node == 0:
                return "error_incomplete_improvement_receipt"
            set improvement_live_hash to get_json_value(improvement_live_node)
            if improvement_live_status equals "live_passed" == 0 or else string_length(improvement_live_hash) != 64:
                return "error_unverified_improvement_receipt"
        else:
            set improvement_failure_node to get_json_object_value(improvement_root and "live_failure_hash")
            set improvement_failure_source_node to get_json_object_value(improvement_root and "live_failure_source_hash")
            set improvement_failure_fingerprint_node to get_json_object_value(improvement_root and "live_failure_fingerprint")
            set improvement_failure_attempt_node to get_json_object_value(improvement_root and "live_failure_attempt")
            if improvement_failure_node == 0 or else improvement_failure_source_node == 0 or else improvement_failure_fingerprint_node == 0 or else improvement_failure_attempt_node == 0:
                return "error_incomplete_improvement_failure_receipt"
            set improvement_failure_hash to get_json_value(improvement_failure_node)
            set improvement_failure_source_hash to get_json_value(improvement_failure_source_node)
            set improvement_failure_fingerprint to get_json_value(improvement_failure_fingerprint_node)
            # JSON numeric values are returned as integers, not string pointers.
            # Passing the live-failure attempt directly into concat dereferences that
            # integer as a pointer during rollback reconciliation and crashes the
            # restored node before it can schedule Echo's recursive repair wake.
            set improvement_failure_attempt to int_to_string(get_json_value(improvement_failure_attempt_node))
            if improvement_live_status equals "repair_required" == 0 or else string_length(improvement_failure_hash) != 64 or else string_length(improvement_failure_source_hash) != 64 or else string_length(improvement_failure_fingerprint) != 64:
                return "error_unverified_improvement_failure_receipt"
    if string_length(change_id) != 64 or else string_length(candidate_hash) != 64 or else string_length(rollback_hash) != 64 or else string_length(active_hash) != 64 or else string_length(gate_hash) != 64 or else string_length(session_id) == 0:
        return "error_malformed_transaction_receipt"
    if outcome_status equals "applied" == 0 and also outcome_status equals "failed" == 0:
        return "error_invalid_outcome_status"
    set turn_id to concat("upgrade_wake_" and keys_random_hex(24))
    set payload to "version=1\nstate=pending\n"
    set payload to concat(payload and concat("change_id=" and concat(change_id and "\n")))
    set payload to concat(payload and concat("session_id=" and concat(session_id and "\n")))
    set payload to concat(payload and concat("turn_id=" and concat(turn_id and "\n")))
    set payload to concat(payload and concat("outcome_status=" and concat(outcome_status and "\n")))
    set payload to concat(payload and concat("candidate_hash=" and concat(candidate_hash and "\n")))
    set payload to concat(payload and concat("rollback_hash=" and concat(rollback_hash and "\n")))
    set payload to concat(payload and concat("active_hash=" and concat(active_hash and "\n")))
    set payload to concat(payload and concat("gate_manifest_hash=" and concat(gate_hash and "\n")))
    set payload to concat(payload and concat("detail=" and concat(detail and "\n")))
    set payload to concat(payload and concat("reconcile_result=" and concat(reconcile_result and "\n")))
    set payload to concat(payload and concat("improvement_id=" and concat(improvement_id and "\n")))
    set payload to concat(payload and concat("improvement_name=" and concat(improvement_name and "\n")))
    set payload to concat(payload and concat("improvement_e2e_hash=" and concat(improvement_e2e_hash and "\n")))
    set payload to concat(payload and concat("improvement_live_hash=" and concat(improvement_live_hash and "\n")))
    set payload to concat(payload and concat("improvement_live_status=" and concat(improvement_live_status and "\n")))
    set payload to concat(payload and concat("improvement_failure_hash=" and concat(improvement_failure_hash and "\n")))
    set payload to concat(payload and concat("improvement_failure_source_hash=" and concat(improvement_failure_source_hash and "\n")))
    set payload to concat(payload and concat("improvement_failure_fingerprint=" and concat(improvement_failure_fingerprint and "\n")))
    set payload to concat(payload and concat("improvement_failure_attempt=" and concat(improvement_failure_attempt and "\n")))
    if node_upgrade_wake_write(payload) != 0:
        return "error_durable_wake_receipt_failed"
    return "created"

define node_upgrade_wake_dispatch with model as Map and memory as Map and tools as Map and shared_ctx as Map returning Str:
    set wake_path to "config/upgrades/wake.env"
    if file_exists(wake_path) == 0:
        return "none"
    set wake to read_file(wake_path)
    if rights_marker_value(wake and "version") equals "1" == 0 or else rights_marker_value(wake and "state") equals "pending" == 0:
        return "error_malformed_wake_receipt"
    set change_id to rights_marker_value(wake and "change_id")
    set session_id to rights_marker_value(wake and "session_id")
    set turn_id to rights_marker_value(wake and "turn_id")
    set outcome_status to rights_marker_value(wake and "outcome_status")
    set candidate_hash to rights_marker_value(wake and "candidate_hash")
    set rollback_hash to rights_marker_value(wake and "rollback_hash")
    set active_hash to rights_marker_value(wake and "active_hash")
    set gate_hash to rights_marker_value(wake and "gate_manifest_hash")
    set detail to rights_marker_value(wake and "detail")
    set reconcile_result to rights_marker_value(wake and "reconcile_result")
    set improvement_id to rights_marker_value(wake and "improvement_id")
    set improvement_name to rights_marker_value(wake and "improvement_name")
    set improvement_e2e_hash to rights_marker_value(wake and "improvement_e2e_hash")
    set improvement_live_hash to rights_marker_value(wake and "improvement_live_hash")
    set improvement_live_status to rights_marker_value(wake and "improvement_live_status")
    set improvement_failure_hash to rights_marker_value(wake and "improvement_failure_hash")
    set improvement_failure_source_hash to rights_marker_value(wake and "improvement_failure_source_hash")
    set improvement_failure_fingerprint to rights_marker_value(wake and "improvement_failure_fingerprint")
    set improvement_failure_attempt to rights_marker_value(wake and "improvement_failure_attempt")
    if string_length(change_id) != 64 or else string_length(session_id) == 0 or else string_index_of(turn_id and "upgrade_wake_") != 0 or else string_length(candidate_hash) != 64 or else string_length(rollback_hash) != 64 or else string_length(active_hash) != 64 or else string_length(gate_hash) != 64:
        return "error_malformed_wake_receipt"

    # A terminal row proves the wake report already completed. Leave an unsent row for
    # the surface delivery owner; remove the receipt only after it is marked delivered.
    set es to string_replace(session_id and "'" and "''")
    set eprefix to string_replace(concat("turn:" and concat(turn_id and ",*")) and "'" and "''")
    set prior to sql_query(storage_get_db() and concat("SELECT sent FROM trace_events WHERE session_id='" and concat(es and concat("' AND event_type='final_reply' AND content GLOB '" and concat(eprefix and "' ORDER BY id DESC LIMIT 1;")))))
    if length_list(prior) > 0:
        set prior_row to get_list(prior and 0)
        if ptr_to_str(get_list(prior_row and 0)) equals "1":
            set removed_delivered to remove_file(wake_path)
            if removed_delivered == 0:
                return "error_delivered_wake_receipt_cleanup_failed"
            return "already_delivered"
        return "awaiting_surface_delivery"

    set sessions_mgr to map_get_val(shared_ctx and "sessions")
    set sessions_map to map_get_val(sessions_mgr and "sessions")
    if map_contains(sessions_map and session_id) == 0:
        return "error_originating_session_missing"
    if map_contains(shared_ctx and "active_turns") == 0:
        set ok to map_insert(shared_ctx and "active_turns" and create_map())
    if map_contains(shared_ctx and "turn_ctxs") == 0:
        set ok to map_insert(shared_ctx and "turn_ctxs" and create_map())
    set active_turns to map_get_val(shared_ctx and "active_turns")
    set turn_ctxs to map_get_val(shared_ctx and "turn_ctxs")
    if map_contains(active_turns and session_id) == 1:
        return "error_originating_session_busy"

    set active_sess to map_get_val(sessions_map and session_id)
    set selected_model to ""
    if map_contains(active_sess and "model") == 1:
        set selected_model to map_get_val(active_sess and "model")
    set ok to map_insert(shared_ctx and "model" and cast_borrow_to_map(model))
    set ok to map_insert(shared_ctx and "memory_mgr" and cast_borrow_to_map(memory))
    set ok to map_insert(shared_ctx and "tools_mgr" and cast_borrow_to_map(tools))
    if map_contains(shared_ctx and "session_auto_approve") == 0:
        set ok to map_insert(shared_ctx and "session_auto_approve" and create_map())
    set tctx to _orch_clone_map(cast_borrow_to_map(shared_ctx))
    set ok to map_delete(tctx and "pending_action")
    set ok to map_delete(tctx and "pending_clarification")
    set ok to map_delete(tctx and "tool_approved")
    set ok to map_delete(tctx and "last_reasoning")
    set ok to map_insert(tctx and "sender_username" and "ernosdecent_runtime")
    set ok to map_insert(tctx and "sender_role" and "owner")
    set ok to map_insert(tctx and "actor_id" and "ernosdecent:upgrade-supervisor")
    set ok to map_insert(tctx and "actor_username" and "ernosdecent_runtime")
    set ok to map_insert(tctx and "actor_global_name" and "ErnosDecent Runtime Supervisor")
    set ok to map_insert(tctx and "actor_display_name" and "ErnosDecent Runtime Supervisor")
    set ok to map_insert(tctx and "actor_type" and "system")
    set ok to map_insert(tctx and "actor_is_host" and "no")
    set ok to map_insert(tctx and "host_name" and "")
    set ok to map_insert(tctx and "platform" and "upgrade_wake")
    set ok to map_insert(tctx and "selected_model" and selected_model)
    set ok to map_insert(tctx and "mode" and "")
    set ok to map_insert(tctx and "session_id" and session_id)
    set ok to map_insert(tctx and "turn_id" and turn_id)
    set ok to map_insert(tctx and "turn_received_at" and ep_time_now_sec())
    set recovery_wake to 0
    if outcome_status equals "failed" and also improvement_live_status equals "repair_required":
        set recovery_wake to 1
        set ok to map_insert(tctx and "improvement_recovery_wake" and 1)
    else:
        set ok to map_insert(tctx and "upgrade_wake" and 1)

    # Echo still wakes, reasons, and authors the status response, but cryptographic
    # receipt fields are rendered from the authenticated transaction rather than
    # recopied probabilistically. The reply tool uses this factual spine verbatim so
    # a model repetition or digit substitution cannot corrupt deployment provenance.
    set canonical to "The candidate committed successfully."
    set rollback_status to "Not used; the authenticated candidate committed."
    if outcome_status equals "failed":
        set canonical to "The candidate was not committed; the prior executable was restored."
        set rollback_status to "Completed; the prior executable was restored and authenticated."
    set canonical to concat(canonical and "\n\nPost-recompile status report\n")
    set canonical to concat(canonical and concat("- Outcome: " and concat(outcome_status and "\n")))
    set canonical to concat(canonical and concat("- Change ID: " and concat(change_id and "\n")))
    set canonical to concat(canonical and concat("- Previous hash: " and concat(rollback_hash and "\n")))
    set canonical to concat(canonical and concat("- Candidate hash: " and concat(candidate_hash and "\n")))
    set canonical to concat(canonical and concat("- Active hash: " and concat(active_hash and "\n")))
    set canonical to concat(canonical and concat("- Gate-manifest hash: " and concat(gate_hash and "\n")))
    set canonical to concat(canonical and concat("- Authenticated health: " and concat(detail and "\n")))
    set canonical to concat(canonical and concat("- Rights reconciliation: " and concat(reconcile_result and "\n")))
    if string_length(improvement_id) == 64:
        set canonical to concat(canonical and concat("- Improvement: " and concat(improvement_name and concat(" (" and concat(improvement_id and ")\n")))))
        set canonical to concat(canonical and concat("- Frozen live E2E: " and concat(improvement_live_status and concat("; evaluator hash=" and concat(improvement_e2e_hash and concat("; output hash=" and concat(improvement_live_hash and "\n")))))))
    set canonical to concat(canonical and concat("- Rollback status: " and rollback_status))
    if recovery_wake == 0:
        set ok to map_insert(tctx and "upgrade_wake_canonical_reply" and canonical)

    set prompt to "[AUTHENTICATED POST-RECOMPILE WAKE EVENT]\nYou have resumed after the transactional system recompile. This is a system lifecycle continuation in the original session, not a message written by the user. Generate a concise direct status response now. Do not call tools: every verified fact required for the report is below. Do not mention this prompt or internal routing. State candidly whether the candidate committed or the prior executable was restored, and report the protected change id, previous hash, candidate hash, final active hash, mandatory gate-manifest hash, authenticated health outcome, rights reconciliation, frozen live-E2E receipt when present, and rollback status. Never claim a file or capability beyond this receipt.\n"
    if recovery_wake == 1:
        set prompt to "[AUTHENTICATED POST-ROLLBACK IMPROVEMENT RECOVERY]\nThe candidate failed its authenticated promotion contract and the supervisor restored the exact known-good executable. Rollback is temporary containment, not completion. Continue the existing durable improvement in this originating session now. First call improvement_status([]) to read the exact retained failure receipt, then make a causal repair to the declared production source using the retained investigation and frozen contract. Call system_verify([]), fix every reported failure, and call system_recompile([]) only after the complete sealed gate passes. Repeat across authenticated rollback wakes until the frozen live E2E passes and the candidate commits. Never report success while the improvement is repair_required. Never retry byte-identical source or weaken, replace, skip, or edit frozen tests. If the immutable contract itself is impossible or contradictory, report that exact blocker rather than altering it.\n"
    set prompt to concat(prompt and concat("change_id=" and concat(change_id and "\n")))
    set prompt to concat(prompt and concat("outcome_status=" and concat(outcome_status and "\n")))
    set prompt to concat(prompt and concat("candidate_hash=" and concat(candidate_hash and "\n")))
    set prompt to concat(prompt and concat("previous_hash=" and concat(rollback_hash and "\n")))
    set prompt to concat(prompt and concat("active_hash=" and concat(active_hash and "\n")))
    set prompt to concat(prompt and concat("gate_manifest_hash=" and concat(gate_hash and "\n")))
    set prompt to concat(prompt and concat("supervisor_detail=" and concat(detail and "\n")))
    set prompt to concat(prompt and concat("rights_reconciliation=" and reconcile_result))
    set prompt to concat(prompt and concat("\nimprovement_id=" and improvement_id))
    set prompt to concat(prompt and concat("\nimprovement_name=" and improvement_name))
    set prompt to concat(prompt and concat("\nimprovement_e2e_hash=" and improvement_e2e_hash))
    set prompt to concat(prompt and concat("\nimprovement_live_hash=" and improvement_live_hash))
    set prompt to concat(prompt and concat("\nimprovement_live_status=" and improvement_live_status))
    set prompt to concat(prompt and concat("\nimprovement_failure_hash=" and improvement_failure_hash))
    set prompt to concat(prompt and concat("\nimprovement_failure_source_hash=" and improvement_failure_source_hash))
    set prompt to concat(prompt and concat("\nimprovement_failure_fingerprint=" and improvement_failure_fingerprint))
    set prompt to concat(prompt and concat("\nimprovement_failure_attempt=" and improvement_failure_attempt))
    set ok to map_insert(active_turns and session_id and 1)
    set ok to map_insert(turn_ctxs and session_id and tctx)
    set wake_fut to node_run_turn(cast_borrow_to_map(model) and cast_borrow_to_map(memory) and cast_borrow_to_map(tools) and tctx and sessions_mgr and session_id and prompt)
    return concat("scheduled,session:" and concat(session_id and concat(",turn:" and turn_id)))

# ── Phase A2: the IPC ACCEPT is itself a TASK CHAIN ─────────────────────────────
# Why a chain and not a loop in main: a task's step is ATOMIC on the single scheduler
# thread, and a detached turn's step runs its whole plain call chain — its LLM waits
# pump the queue NESTED (ep_await_future) instead of yielding. If accept lived in
# main's frame, main could not resume while any turn step was on the stack, and a
# second connection starved (observed live in the A2 smoke test). As a TASK, the
# accept's next step fires from WITHIN any nested pump: connections are served, new
# turns dispatch, whispers/Stop/status stay live even while a turn is mid-inference.
# One top-level await per instance + self re-enqueue = the compiler-safe chain shape
# (see tools_validation_block). Shared structures ride as Int handles; the Maps are
# re-materialized per call with INLINE cast_borrow_to_map (never assigned to locals —
# the documented borrow-view free hazard).
async define node_accept_chain with listen_fd as Int and raft_i as Int and ident_i as Int and dht_node as Int and relay_node as Int and msg_store as Int and ledger_i as Int and name_reg as Int and seed_addr as Str and seed_port as Int and mem_i as Int and tools_i as Int and ctx_i as Int and model_i as Int and static_secret as Int and static_public as Int and bft_i as Int returning Int:
    set ready to await async_wait_readable_timeout(listen_fd and 250)
    if ready == 1:
        set client_fd to ep_net_accept(listen_fd)
        if client_fd >= 0:
            # Accepted sockets inherit O_NONBLOCK on Darwin — force blocking so the
            # AUTH command read cannot come back empty (the fixed A1 regression).
            set ok to ep_net_set_blocking(client_fd)
            handle_ipc_client(client_fd and borrow cast_borrow_to_map(raft_i) and borrow cast_borrow_to_map(ident_i) and dht_node and relay_node and msg_store and borrow cast_borrow_to_map(ledger_i) and name_reg and seed_addr and seed_port and borrow cast_borrow_to_map(mem_i) and borrow cast_borrow_to_map(tools_i) and borrow cast_borrow_to_map(ctx_i) and borrow cast_borrow_to_map(model_i) and static_secret and static_public and borrow cast_borrow_to_map(bft_i))
    set nxt to node_accept_chain(listen_fd and raft_i and ident_i and dht_node and relay_node and msg_store and ledger_i and name_reg and seed_addr and seed_port and mem_i and tools_i and ctx_i and model_i and static_secret and static_public and bft_i)
    return 0

# Main's eternal pump: a PLAIN loop whose await lowers to ep_await_future each tick —
# it drives the scheduler (tasks, timers, IO) forever. All real work happens in tasks.
external define ep_async_sleep_ms with ms returning Int
define node_main_pump returning Int:
    repeat while 1 == 1:
        set ok to await ep_async_sleep_ms(60000)
    return 0

# /factory support: recursive tree delete in pure ErnosPlain (no shell). Depth-capped
# as a runaway guard; only ever called on the FIXED agent-state paths listed in the
# AI FACTORY handler — never on user-supplied input.
define factory_rm_tree with path as Str and depth as Int returning Int:
    if depth > 8:
        return 1
    if file_exists(path) == 0:
        return 0
    if is_directory(path) == 1:
        set entries to list_directory(path)
        set n to length_list(entries)
        set i to 0
        repeat while i < n:
            set e to get_list(entries and i)
            if e equals ".":
                set i to i + 1
            else if e equals "..":
                set i to i + 1
            else:
                if factory_rm_tree(concat(path and concat("/" and e)) and depth + 1) != 0:
                    return 1
                set i to i + 1
        if remove_directory(path) == 0:
            return 1
        return 0
    if remove_file(path) == 0:
        return 1
    return 0

# AI / speech
import "./decent_ai/speech"
import "./decent_ai/tts"

# Health + Protocol
import "./health"
import "./protocol_server"
import "./decent_net/host_election"
import "./decent_net/platform_registry"
import "./decent_net/bridge_rpc"

# ================================================================
# IPC Handler — responds to control commands
# ================================================================

define escape_quotes with s as Str returning Str:
    set len to string_length(s)
    set res to ""
    set i to 0
    repeat while i < len:
        set c to get_character(s and i)
        if c == 34: # '"'
            set res to concat(res and "\\\"")
        else if c == 92: # '\'
            set res to concat(res and "\\\\")
        else:
            set buf to alloc_bytes(2)
            poke_byte(buf and 0 and c)
            poke_byte(buf and 1 and 0)
            set res to concat(res and ptr_to_str(buf))
            free_bytes(buf)
        set i to i + 1
    return res

define serialize_memory_json with agent_memory as Map returning Str:
    # 1. Scratchpad
    set scratchpad to map_get_val(agent_memory and "scratchpad")
    set s_keys to map_keys(scratchpad)
    set s_len to length_list(s_keys)
    set s_json to "{"
    set i to 0
    repeat while i < s_len:
        set k to get_list(s_keys and i)
        set v_raw to map_get_val(scratchpad and k)
        set v to escape_quotes(v_raw)
        set s_json to concat(s_json and f"\"{k}\":\"{v}\"")
        if i < s_len - 1:
            set s_json to concat(s_json and ",")
        set i to i + 1
    set s_json to concat(s_json and "}")
    free_list(s_keys)

    # 2. Lessons
    set lessons to map_get_val(agent_memory and "lessons")
    set l_keys to map_keys(lessons)
    set l_len to length_list(l_keys)
    set l_json to "{"
    set i to 0
    repeat while i < l_len:
        set k to get_list(l_keys and i)
        set v_raw to map_get_val(lessons and k)
        set v to escape_quotes(v_raw)
        set l_json to concat(l_json and f"\"{k}\":\"{v}\"")
        if i < l_len - 1:
            set l_json to concat(l_json and ",")
        set i to i + 1
    set l_json to concat(l_json and "}")
    free_list(l_keys)

    # 3. Edges
    set edges to map_get_val(agent_memory and "edges")
    set e_keys to map_keys(edges)
    set e_len to length_list(e_keys)
    set e_json to "["
    set i to 0
    repeat while i < e_len:
        set k to get_list(e_keys and i)
        set w_fixed to map_get_val(edges and k)
        
        # Split key "c1-c2" into source and target
        set dash_pos to string_index_of(k and "-")
        set source_val to k
        set target_val to ""
        if dash_pos > 0:
            set source_val to substring(k and 0 and dash_pos)
            set target_val to substring(k and dash_pos + 1 and string_length(k) - dash_pos - 1)
            
        set w_int to w_fixed / 1000000
        set w_frac to w_fixed modulo 1000000
        set w_frac_str to int_to_string(w_frac)
        repeat while string_length(w_frac_str) < 6:
            set w_frac_str to concat("0" and w_frac_str)
            
        set w_str to f"{w_int}.{w_frac_str}"
        set item_json to concat("{\"source\":\"" and source_val)
        set item_json to concat(item_json and "\",\"target\":\"")
        set item_json to concat(item_json and target_val)
        set item_json to concat(item_json and "\",\"weight\":")
        set item_json to concat(item_json and w_str)
        set item_json to concat(item_json and "}")
        set e_json to concat(e_json and item_json)
        if i < e_len - 1:
            set e_json to concat(e_json and ",")
        set i to i + 1
    set e_json to concat(e_json and "]")
    free_list(e_keys)

    set full_json to concat("{\"type\":\"agent_memory\",\"scratchpad\":" and s_json)
    set full_json to concat(full_json and ",\"lessons\":")
    set full_json to concat(full_json and l_json)
    set full_json to concat(full_json and ",\"edges\":")
    set full_json to concat(full_json and e_json)
    set full_json to concat(full_json and "}")
    return full_json

define serialize_grid_json with agent_grid as Map returning Str:
    if agent_grid == 0:
        return "{\"type\":\"turing_grid\",\"x\":0,\"y\":0,\"z\":0,\"cells\":{}}"
        
    set x to map_get_val(agent_grid and "x")
    set y to map_get_val(agent_grid and "y")
    set z to map_get_val(agent_grid and "z")
    
    set cells to map_get_val(agent_grid and "cells")
    set c_keys to map_keys(cells)
    set c_len to length_list(c_keys)
    set c_json to "{"
    set i to 0
    repeat while i < c_len:
        set k to get_list(c_keys and i)
        set v_raw to map_get_val(cells and k)
        set v to escape_quotes(v_raw)
        set c_json to concat(c_json and f"\"{k}\":\"{v}\"")
        if i < c_len - 1:
            set c_json to concat(c_json and ",")
        set i to i + 1
    set c_json to concat(c_json and "}")
    free_list(c_keys)
    
    set full_json to concat("{\"type\":\"turing_grid\",\"x\":" and int_to_string(x))
    set full_json to concat(full_json and ",\"y\":")
    set full_json to concat(full_json and int_to_string(y))
    set full_json to concat(full_json and ",\"z\":")
    set full_json to concat(full_json and int_to_string(z))
    set full_json to concat(full_json and ",\"cells\":")
    set full_json to concat(full_json and c_json)
    set full_json to concat(full_json and "}")
    return full_json

define serialize_storage_json returning Str:
    set list to storage_content_list()
    set list_len to length_list(list)
    
    set file_json to "["
    set i to 0
    repeat while i < list_len:
        set row to get_list(list and i)
        set hash_val to get_list(row and 0)
        set type_val to get_list(row and 1)
        set size_val to get_list(row and 2)
        
        # Build file name from hash prefix (first 8 chars)
        set name_val to concat("block_" and substring(hash_val and 0 and 8))
        
        set item_json to concat("{\"name\":\"" and name_val)
        set item_json to concat(item_json and "\",\"hash\":\"")
        set item_json to concat(item_json and hash_val)
        set item_json to concat(item_json and "\",\"size\":\"")
        set item_json to concat(item_json and size_val)
        set item_json to concat(item_json and "\",\"type\":\"")
        set item_json to concat(item_json and type_val)
        set item_json to concat(item_json and "\"}")
        
        set file_json to concat(file_json and item_json)
        if i < list_len - 1:
            set file_json to concat(file_json and ",")
            
        set i to i + 1
    set file_json to concat(file_json and "]")
    free_list(list)
    
    set full_json to "{\"type\":\"storage\",\"chunk_count\":"
    set full_json to concat(full_json and int_to_string(list_len))
    set full_json to concat(full_json and ",\"files\":")
    set full_json to concat(full_json and file_json)
    set full_json to concat(full_json and "}")
    
    return full_json

# Minimal JSON string escaping (backslash + double-quote) for safe result emission.
define search_json_escape with s as Str returning Str:
    set out to string_replace(s and "\\" and "\\\\")
    set out to string_replace(out and "\"" and "\\\"")
    return out

# G1/G5: serve REAL ranked results from the node's decentralized search index
# (BM25 + PageRank over crawled+indexed pages), MERGED with results federated from
# peers over the authenticated Noise channel. No clearnet scrape, no hardcoded
# keyword fallbacks, no fabricated onion-circuit metadata — if nothing matches
# locally or remotely the result set is honestly empty.
define handle_onion_search with index as Map and query as Str and dht as Int and static_secret as Int and static_public as Int returning Str:
    set local_results to query_search(index and query)
    set peer_count to dht_node_peer_count(dht)
    # Prefer anonymized onion routing when enough relays are known: the query travels
    # through a multi-hop circuit and the answering node never learns our identity. The
    # results return up the circuit. Fall back to the direct (Noise-authenticated, but
    # not origin-anonymous) federated path when no usable circuit can be built.
    set onion_wire to ""
    set source to "local+federated"
    if peer_count > 0:
        set onion_wire to onion_search_anonymous(dht and query and static_secret and static_public and 3)
    if string_length(onion_wire) > 0:
        if onion_wire equals "ONION_EMPTY":
            set remote_results to create_list()
        else:
            set remote_results to query_deserialize_results(onion_wire)
        set source to "local+onion"
    else:
        set remote_results to search_federate_to_peers(dht and static_secret and static_public and query)
    set results to query_merge_results(local_results and remote_results)
    set n to length_list(results)

    set results_json to ""
    set emitted to 0
    set i to 0
    repeat while i < n:
        if emitted < 20:
            set item to get_list(results and i)
            set url to ptr_to_str(map_get_val(item and "url"))
            set title to ptr_to_str(map_get_val(item and "title"))
            set score to map_get_val(item and "score")
            set url_j to search_json_escape(url)
            set title_j to search_json_escape(title)
            if emitted > 0:
                set results_json to concat(results_json and ",")
            set entry to f"\{\"title\":\"{title_j}\",\"url\":\"{url_j}\",\"score\":{score}\}"
            set results_json to concat(results_json and entry)
            set emitted to emitted + 1
        set i to i + 1

    set query_j to search_json_escape(query)
    set response_json to concat(concat("\{\"type\":\"search_result\",\"source\":\"" and source) and "\",\"peers_queried\":")
    set response_json to concat(response_json and int_to_string(peer_count))
    set response_json to concat(response_json and ",\"query\":\"")
    set response_json to concat(response_json and query_j)
    set response_json to concat(response_json and "\",\"count\":")
    set response_json to concat(response_json and int_to_string(n))
    set response_json to concat(response_json and ",\"results\":[")
    set response_json to concat(response_json and results_json)
    set response_json to concat(response_json and "]\}")
    return response_json

# IPC control-plane authentication. The daemon on the (loopback) IPC port mints
# session tokens and moves funds, so every command must carry "AUTH <token>" where
# <token> matches the 0600 ipc-token file. The token helpers (ipc_token_path /
# ipc_read_token / ipc_get_or_create_token) live in decent_id/auth.ep — shared so the
# web server, which also authenticates to the IPC port, doesn't depend on a function
# defined here (it imports decent_id/auth too).
define handle_ipc_client with client_fd as Int and borrow raft_node as Map and borrow identity as Map and dht_node as Int and relay_node as Int and msg_store as Int and borrow ledger as Map and name_reg as Int and seed_addr as Str and seed_port as Int and borrow agent_memory as Map and borrow agent_tools as Map and borrow agent_ctx as Map and borrow agent_model as Map and static_secret as Int and static_public as Int and borrow bft_node as Map:

    set req to ep_net_recv(client_fd and 65536)
    set cmd to string_trim(req)

    # Strip and verify the "AUTH <token>" prefix before any dispatch.
    set ipc_expected to ipc_read_token()
    set ipc_authed to 0
    if string_index_of(cmd and "AUTH ") == 0:
        set ipc_after to substring(cmd and 5 and string_length(cmd) - 5)
        set ipc_sp to string_index_of(ipc_after and " ")
        set ipc_provided to ipc_after
        set ipc_rest to ""
        if ipc_sp >= 0:
            set ipc_provided to substring(ipc_after and 0 and ipc_sp)
            set ipc_rest to substring(ipc_after and ipc_sp + 1 and string_length(ipc_after) - ipc_sp - 1)
        if string_length(ipc_expected) > 0 and also ipc_provided equals ipc_expected:
            set ipc_authed to 1
            set cmd to string_trim(ipc_rest)
    set cmd_upper to string_upper(cmd)

    # Update last user activity timestamp
    set ok to map_insert(agent_ctx and "last_user_activity" and int_to_string(ep_time_now_sec()))

    set resp to "error:unknown_command"
    if ipc_authed == 0:
        # Reject untokened commands: force a no-match sentinel so no branch runs.
        set resp to "error:unauthorized"
        set cmd_upper to "__IPC_UNAUTHORIZED__"
    if cmd_upper equals "STATUS":
        set role to ptr_to_str(map_get_val(raft_node and "role"))
        set did_val to ptr_to_str(map_get_val(identity and "did"))
        set term to map_get_val(raft_node and "current_term")
        set peers_list to map_get_val(raft_node and "peers")
        set peer_count to length_list(peers_list)
        set dht_size to dht_node_peer_count(dht_node)
        set home to get_home_dir()
        set cfg_path to concat(home and "/.ernosdecent/config.toml")
        set is_static to 0
        set elect_enabled to 1
        set cfg to config_load(cfg_path)
        if cfg != 0:
            if map_contains(cfg and "network.is_static_host") == 1:
                set is_static to config_get_int(cfg and "network.is_static_host")
            if map_contains(cfg and "network.enable_host_election") == 1:
                set elect_enabled to config_get_int(cfg and "network.enable_host_election")
            free_map(cfg)
        set reg_name to storage_name_get_by_did(did_val)
        if string_length(reg_name) == 0:
            set reg_name to "none"
        set gitdec_updates to storage_gitdec_count_pending()
        set resp to f"status:active,role:{role},did:{did_val},term:{term},peers:{peer_count},dht_size:{dht_size},is_static_host:{int_to_string(is_static)},enable_host_election:{int_to_string(elect_enabled)},name:{reg_name},gitdec_updates:{int_to_string(gitdec_updates)}"
    else:
        if cmd_upper equals "STOP":
            set resp to "status:stopping"
            set ok to ep_net_send(client_fd and resp)
            set ok to ep_net_close(client_fd)
            log_info("node" and "Daemon stopping on client request.")
            exit_program(0)
        else:
            if cmd_upper equals "RESTART":
                # Exit code 75 is consumed only by run_node.sh's persistent wrapper.
                # The acknowledgement is flushed before termination so a bridge can
                # wait for the replacement process instead of guessing from silence.
                set resp to "status:restarting"
                set ok to ep_net_send(client_fd and resp)
                set ok to ep_net_close(client_fd)
                log_info("node" and "Daemon restarting on authenticated request.")
                exit_program(75)
            else if cmd_upper equals "UPGRADE RECONCILE":
                # Only the authenticated run_node.sh supervisor sends this after the
                # replacement or rollback process passes STATUS. The node validates
                # every receipt hash and atomically commits the rights ledger itself.
                # Once committed, persist and dispatch an exactly-correlated lifecycle
                # wake turn in the originating session. The receipt survives crashes;
                # startup recovery below re-dispatches only when no terminal row exists.
                set resp to rights_reconcile_upgrade(storage_get_db())
                if string_index_of(resp and "upgrade:committed,") == 0 or else string_index_of(resp and "upgrade:rolled_back,") == 0:
                    set wake_created to node_upgrade_wake_create(resp)
                    set wake_status to wake_created
                    if wake_created equals "created":
                        set wake_status to node_upgrade_wake_dispatch(cast_borrow_to_map(agent_model) and cast_borrow_to_map(agent_memory) and cast_borrow_to_map(agent_tools) and cast_borrow_to_map(agent_ctx))
                    if string_index_of(wake_status and "error_") == 0:
                        log_error("upgrade" and concat("Post-recompile wake handoff failed: " and wake_status))
                    else:
                        log_info("upgrade" and concat("Post-recompile wake handoff: " and wake_status))
                    set resp to concat(resp and concat(",wake_status:" and wake_status))
            else if cmd_upper equals "HEALTH":
                set health_ipc_port to map_get_val(agent_ctx and "ipc_port")
                set health_report to run_health_check(dht_node and raft_node and health_ipc_port and identity and relay_node and msg_store and ledger and name_reg and agent_ctx and bft_node)
                set resp to format_health_report(health_report)
                free_map(health_report)
            else:
                if cmd_upper equals "IDENTITY":
                    set did_val to ptr_to_str(map_get_val(identity and "did"))
                    set pub_key to ptr_to_str(map_get_val(identity and "signing_public_key"))
                    set enc_key to ptr_to_str(map_get_val(identity and "encryption_public_key"))
                    if string_length(enc_key) == 0:
                        set enc_key to "not_generated"
                    if string_length(pub_key) == 0:
                        set pub_key to "not_available"
                    set reg_name to storage_name_get_by_did(did_val)
                    if string_length(reg_name) == 0:
                        set reg_name to "none"
                    set resp to f"did:{did_val},signing_key:{pub_key},encryption_key:{enc_key},name:{reg_name}"
                else:
                    if cmd_upper equals "WALLET BALANCE":
                        set sign_pub to ptr_to_str(map_get_val(identity and "signing_public_key"))
                        set balance to ledger_get_balance(cast_borrow_to_map(ledger) and sign_pub)
                        set resp to concat("wallet_balance:" and int_to_string(balance))
                    else:
                        if cmd_upper equals "POOL STATUS":
                            # Report REAL pool state: live compute-pool stats (jobs/pending/
                            # workers) + relay stats labeled correctly (was mislabeling relay
                            # registrations/circuits as bandwidth and hardcoding compute_slots:0).
                            set relay_stats to relay_get_stats(relay_node)
                            set relay_regs to map_get_val(relay_stats and "registrations")
                            set relay_circuits to map_get_val(relay_stats and "circuits")
                            # Note: do NOT free_map(relay_stats) — risks corrupting shared values
                            set cjobs to 0
                            set cpending to 0
                            set cworkers to 0
                            if map_contains(agent_ctx and "compute_mgr") == 1:
                                set cm to map_get_val(agent_ctx and "compute_mgr")
                                set cjobs to map_size(map_get_val(cm and "jobs"))
                                set cpending to length_list(map_get_val(cm and "pending"))
                                set cworkers to map_size(map_get_val(cm and "contributions"))
                            set resp to f"pool:active,compute_jobs:{cjobs},compute_pending:{cpending},compute_workers:{cworkers},relay_registrations:{relay_regs},relay_circuits:{relay_circuits}"
                        else:
                            if cmd_upper equals "STORAGE STATUS":
                                set resp to serialize_storage_json()
                            else if string_contains(cmd_upper and "RAG INDEX ") == 1:
                                # Session-scoped ingest. Format: RAG INDEX <session>|<doc>|<text>
                                set rag_args to string_trim(substring(cmd and 10 and string_length(cmd) - 10))
                                set rb1 to string_index_of(rag_args and "|")
                                set rrest to substring(rag_args and rb1 + 1 and string_length(rag_args) - rb1 - 1)
                                set rb2 to string_index_of(rrest and "|")
                                if rb1 <= 0 or else rb2 <= 0:
                                    set resp to "rag:error,reason:invalid_format"
                                else:
                                    set rag_sess to substring(rag_args and 0 and rb1)
                                    set rag_doc to substring(rrest and 0 and rb2)
                                    set rag_text to substring(rrest and rb2 + 1 and string_length(rrest) - rb2 - 1)
                                    set rag_n to rag_index(storage_get_db() and rag_doc and rag_text and rag_sess)
                                    set resp to f"rag:indexed,doc:{rag_doc},chunks:{rag_n}"
                            else if string_contains(cmd_upper and "RAG SEARCH ") == 1:
                                # Session-scoped retrieval. Format: RAG SEARCH <session>|<query>
                                set rqs_args to string_trim(substring(cmd and 11 and string_length(cmd) - 11))
                                set rqb to string_index_of(rqs_args and "|")
                                if rqb < 0:
                                    set resp to "rag:error,reason:invalid_format"
                                else:
                                    set rqs_sess to substring(rqs_args and 0 and rqb)
                                    set rqs_query to substring(rqs_args and rqb + 1 and string_length(rqs_args) - rqb - 1)
                                    set resp to rag_search(storage_get_db() and rqs_query and rqs_sess and 5)
                            else if string_contains(cmd_upper and "PLATFORM SEND ") == 1:
                                # Outbound via the connector library. Format:
                                # PLATFORM SEND <platform>|<token>|<extra>|<recipient>|<text>
                                set resp to platform_ipc_send(string_trim(substring(cmd and 14 and string_length(cmd) - 14)))
                            else if cmd_upper equals "DISCORD POLL":
                                # Bridge fetches pending agent->bridge commands (marks them sent).
                                set resp to bridge_poll(storage_get_db())
                            else if string_contains(cmd_upper and "DISCORD RESULT ") == 1:
                                # Bridge returns a command's output. Format: DISCORD RESULT <id>|<data>
                                set dr_args to string_trim(substring(cmd and 15 and string_length(cmd) - 15))
                                set dr_bar to string_index_of(dr_args and "|")
                                if dr_bar < 0:
                                    set resp to "bridge:error,reason:invalid_format"
                                else:
                                    set dr_id to string_to_int(substring(dr_args and 0 and dr_bar))
                                    set dr_data to substring(dr_args and dr_bar + 1 and string_length(dr_args) - dr_bar - 1)
                                    set dr_ok to bridge_submit_result(storage_get_db() and dr_id and dr_data)
                                    set resp to concat("bridge:result_recorded,id:" and int_to_string(dr_id))
                            else if string_contains(cmd_upper and "TRACE POLL ") == 1:
                                # Trace event polling for Discord transparency threads
                                set trace_sess to string_trim(substring(cmd and 11 and string_length(cmd) - 11))
                                set resp to trace_poll(storage_get_db() and trace_sess)
                            else if cmd_upper equals "TRACE PENDING_DELETES":
                                # Return threads whose 2-min delete timer has expired
                                set resp to trace_get_pending_deletes(storage_get_db())
                            else if string_contains(cmd_upper and "TRACE SCHEDULE_DELETE ") == 1:
                                # Schedule a thread for deletion: TRACE SCHEDULE_DELETE <thread_id> <delay_secs>
                                set tsd_args to string_trim(substring(cmd and 22 and string_length(cmd) - 22))
                                set tsd_space to string_index_of(tsd_args and " ")
                                if tsd_space < 0:
                                    set resp to "trace:error,reason:invalid_format"
                                else:
                                    set tsd_thread to substring(tsd_args and 0 and tsd_space)
                                    set tsd_delay to string_to_int(substring(tsd_args and tsd_space + 1 and string_length(tsd_args) - tsd_space - 1))
                                    set ok to trace_schedule_delete(storage_get_db() and tsd_thread and tsd_delay)
                                    set resp to f"trace:delete_scheduled,thread_id:{tsd_thread}"
                            else if string_contains(cmd_upper and "TRACE COMPLETE_DELETE ") == 1:
                                # Mark a pending deletion as complete: TRACE COMPLETE_DELETE <id>
                                set tcd_id to string_to_int(string_trim(substring(cmd and 22 and string_length(cmd) - 22)))
                                set ok to trace_complete_delete(storage_get_db() and tcd_id)
                                set resp to f"trace:delete_completed,id:{tcd_id}"
                            else:
                                if cmd_upper equals "NET STATUS":
                                    set dht_sz to dht_node_peer_count(dht_node)
                                    set relay_stats to relay_get_stats(relay_node)
                                    set relay_regs to map_get_val(relay_stats and "registrations")
                                    set relay_circuits to map_get_val(relay_stats and "circuits")
                                    # Note: do NOT free_map(relay_stats) — risks corrupting shared values
                                    set resp to f"net:active,dht_size:{dht_sz},relay_registrations:{relay_regs},relay_circuits:{relay_circuits},nat_mode:relay,active_circuits:{relay_circuits}"
                                else:
                                    if string_contains(cmd_upper and "MSG SENDTO ") == 1:
                                        # MSG SENDTO <recipient_did> <host> <port> <body> — real E2E
                                        # encrypted+signed delivery over the peer's Noise channel.
                                        set st_args to substring(cmd and 11 and string_length(cmd) - 11)
                                        set st_parts_ok to 0
                                        set st_rcpt to ""
                                        set st_host to ""
                                        set st_port to 0
                                        set st_body to ""
                                        set st_p1 to string_index_of(st_args and " ")
                                        if st_p1 > 0:
                                            set st_rcpt to substring(st_args and 0 and st_p1)
                                            set st_r1 to substring(st_args and st_p1 + 1 and string_length(st_args) - st_p1 - 1)
                                            set st_p2 to string_index_of(st_r1 and " ")
                                            if st_p2 > 0:
                                                set st_host to substring(st_r1 and 0 and st_p2)
                                                set st_r2 to substring(st_r1 and st_p2 + 1 and string_length(st_r1) - st_p2 - 1)
                                                set st_p3 to string_index_of(st_r2 and " ")
                                                if st_p3 > 0:
                                                    set st_port to string_to_int(substring(st_r2 and 0 and st_p3))
                                                    set st_body to substring(st_r2 and st_p3 + 1 and string_length(st_r2) - st_p3 - 1)
                                                    set st_parts_ok to 1
                                        if st_parts_ok == 1:
                                            set st_my_did to ptr_to_str(map_get_val(identity and "did"))
                                            set st_my_sec to ptr_to_str(map_get_val(identity and "signing_secret_key"))
                                            set st_loc to mstore_send(msg_store and st_rcpt and st_body)
                                            set st_locf to free_map(st_loc)
                                            set st_rc to msg_send_p2p(st_rcpt and st_host and st_port and st_body and st_my_did and st_my_sec and static_secret and static_public)
                                            if st_rc == 0:
                                                set resp to "msg:delivered"
                                            else:
                                                set resp to f"msg:error,code:{st_rc}"
                                        else:
                                            set resp to "msg:error,reason:bad_args,expected:MSG SENDTO <did> <host> <port> <body>"
                                    else if string_contains(cmd_upper and "MSG SEND ") == 1:
                                        set msg_body to substring(cmd and 9 and string_length(cmd) - 9)
                                        set send_result to mstore_send(msg_store and "broadcast" and msg_body)
                                        set send_err to map_get_val(send_result and "error")
                                        set msg_ref to map_get_val(send_result and "message")
                                        if send_err == 0:
                                            set msg_id to ptr_to_str(map_get_val(msg_ref and "id"))
                                            set resp to f"msg:sent,id:{msg_id},text:{msg_body}"
                                        else:
                                            set resp to f"msg:queued_local,text:{msg_body}"
                                        free_map(send_result)
                                    else:
                                        if string_index_of(cmd_upper and "AI EVAL_TOOL ") == 0:
                                            # Authenticated, transaction-bound evaluator seam. It bypasses
                                            # model selection, not authorization: only the exact planned
                                            # surface is callable and approval-gated tools remain unavailable.
                                            set eval_wire to substring(cmd and 13 and string_length(cmd) - 13)
                                            set eval_sep to string_index_of(eval_wire and " ")
                                            if eval_sep <= 0:
                                                set resp to "eval_tool:error,reason:bad_args,expected:AI EVAL_TOOL <planned_surface> <base64-json-array>"
                                            else:
                                                set eval_name to substring(eval_wire and 0 and eval_sep)
                                                set eval_args_b64 to substring(eval_wire and eval_sep + 1 and string_length(eval_wire) - eval_sep - 1)
                                                if tools_improvement_eval_surface_allowed(eval_name) == 0:
                                                    set resp to concat("eval_tool:error,reason:not_current_planned_surface,name:" and eval_name)
                                                else:
                                                    set eval_args_text to rag_base64_decode(eval_args_b64)
                                                    set eval_args_node to json_parse(eval_args_text)
                                                    if eval_args_node == 0 or else get_json_type(eval_args_node) != 3:
                                                        set resp to "eval_tool:error,reason:args_must_be_base64_json_array"
                                                    else:
                                                        set eval_args to create_list()
                                                        set eval_items to get_json_value(eval_args_node)
                                                        set eval_i to 0
                                                        repeat while eval_i < length_list(eval_items):
                                                            set eval_item to get_list(eval_items and eval_i)
                                                            if get_json_type(eval_item) == 1:
                                                                set ok to append_list(eval_args and int_to_string(get_json_value(eval_item)))
                                                            else:
                                                                set ok to append_list(eval_args and get_json_value(eval_item))
                                                            set eval_i to eval_i + 1
                                                        if tools_requires_approval(eval_name and eval_args) == 1:
                                                            set resp to concat("eval_tool:error,reason:approval_required,name:" and eval_name)
                                                        else:
                                                            set eval_ctx to create_map()
                                                            set ok to map_insert(eval_ctx and "sender_role" and "owner")
                                                            set ok to map_insert(eval_ctx and "platform" and "improvement_evaluator")
                                                            set ok to map_insert(eval_ctx and "session_id" and "improvement_evaluator")
                                                            set ok to map_insert(eval_ctx and "memory" and cast_borrow_to_map(agent_memory))
                                                            set ok to map_insert(eval_ctx and "memory_mgr" and cast_borrow_to_map(agent_memory))
                                                            # The authenticated evaluator must exercise the same
                                                            # live service context as an ordinary tool turn. Session-
                                                            # aware extensions otherwise receive an artificial context
                                                            # with no session manager and can never pass a genuine live
                                                            # replacement test, even though the production turn path has
                                                            # that manager available.
                                                            set eval_sessions to map_get_val(agent_ctx and "sessions")
                                                            set ok to map_insert(eval_ctx and "sessions" and cast_borrow_to_map(eval_sessions))
                                                            set eval_result to tools_execute(cast_borrow_to_map(agent_tools) and eval_ctx and eval_name and eval_args)
                                                            set eval_save_rc to memory_serialize(cast_borrow_to_map(agent_memory) and "config/agent_memory.json")
                                                            if eval_save_rc != 0:
                                                                set resp to "eval_tool:error,reason:memory_persistence_failed"
                                                            else:
                                                                set resp to concat("eval_tool:ok,name:" and concat(eval_name and concat(",result_b64:" and base64_encode(eval_result))))
                                        else if string_contains(cmd_upper and "AI INFER ") == 1:
                                            set ai_prompt to substring(cmd and 9 and string_length(cmd) - 9)
                                            display f"[AI] INFER received ({string_length(ai_prompt)} chars) — entering agent."
                                            set selected_session_id to ""
                                            set selected_model to ""
                                            set selected_mode to ""
                                            set selected_system_prompt to ""
                                            set sender_username to ""
                                            set sender_role to ""
                                            set actor_id to ""
                                            set actor_username to ""
                                            set actor_global_name to ""
                                            set actor_display_name to ""
                                            set actor_type to ""
                                            set actor_is_host to ""
                                            set host_name to ""
                                            set guild_id to ""
                                            set guild_name to ""
                                            set channel_name to ""
                                            set thread_id to ""
                                            set thread_name to ""
                                            set in_memory_context to ""
                                            set visual_context to ""
                                            set image_path to ""
                                            # Discord message coordinates for the current turn, so the agent can
                                            # react to THIS message with just react(["emoji"]) — no ids to pass.
                                            set discord_msg_id to ""
                                            set discord_chan_id to ""
                                            # P7: which surface this message arrived from (discord/webui/cli) — the
                                            # awareness block tells the agent which platform tools apply this turn.
                                            set msg_platform to ""
                                            # E1: role/sender are security-sensitive (drive tool authz).
                                            # The trusted caller (bridge/IPC) prepends them FIRST; lock
                                            # after the first parse so a marker injected later in the
                                            # untrusted message body cannot escalate (guest -> admin).
                                            set role_locked to 0
                                            set sender_locked to 0
                                            set parsing_options to 1
                                            repeat while parsing_options == 1:
                                                set found_opt to 0
                                                if string_index_of(ai_prompt and "[SESSION:") == 0:
                                                    set end_idx to string_index_of(ai_prompt and "]")
                                                    if end_idx > 9:
                                                        set selected_session_id to substring(ai_prompt and 9 and end_idx - 9)
                                                        set skip_len to end_idx + 1
                                                        if skip_len < string_length(ai_prompt):
                                                            set next_char to get_character(ai_prompt and skip_len)
                                                            if next_char == 32:
                                                                set skip_len to skip_len + 1
                                                        set ai_prompt to substring(ai_prompt and skip_len and string_length(ai_prompt) - skip_len)
                                                        set found_opt to 1
                                                else if string_index_of(ai_prompt and "[MODEL:") == 0:
                                                    set end_idx to string_index_of(ai_prompt and "]")
                                                    if end_idx > 7:
                                                        set selected_model to substring(ai_prompt and 7 and end_idx - 7)
                                                        set skip_len to end_idx + 1
                                                        if skip_len < string_length(ai_prompt):
                                                            set next_char to get_character(ai_prompt and skip_len)
                                                            if next_char == 32:
                                                                set skip_len to skip_len + 1
                                                        set ai_prompt to substring(ai_prompt and skip_len and string_length(ai_prompt) - skip_len)
                                                        set found_opt to 1
                                                else if string_index_of(ai_prompt and "[MODE:") == 0:
                                                    # Interaction mode (e.g. "tutor" for the Socratic learning tab).
                                                    # Disjoint from [MODEL:] — that tag's 6th char is 'L', this one's is ':'.
                                                    set end_idx to string_index_of(ai_prompt and "]")
                                                    if end_idx > 6:
                                                        set selected_mode to substring(ai_prompt and 6 and end_idx - 6)
                                                        set skip_len to end_idx + 1
                                                        if skip_len < string_length(ai_prompt):
                                                            set next_char to get_character(ai_prompt and skip_len)
                                                            if next_char == 32:
                                                                set skip_len to skip_len + 1
                                                        set ai_prompt to substring(ai_prompt and skip_len and string_length(ai_prompt) - skip_len)
                                                        set found_opt to 1
                                                else if string_index_of(ai_prompt and "[SYSTEM:") == 0:
                                                    set end_idx to string_index_of(ai_prompt and "]")
                                                    if end_idx > 8:
                                                        # E2: only an admin/owner (role parsed first)
                                                        # may set the system prompt — otherwise a guest
                                                        # message body could inject one (prompt injection).
                                                        if sender_role equals "admin" or else sender_role equals "owner":
                                                            set selected_system_prompt to substring(ai_prompt and 8 and end_idx - 8)
                                                        set skip_len to end_idx + 1
                                                        if skip_len < string_length(ai_prompt):
                                                            set next_char to get_character(ai_prompt and skip_len)
                                                            if next_char == 32:
                                                                set skip_len to skip_len + 1
                                                        set ai_prompt to substring(ai_prompt and skip_len and string_length(ai_prompt) - skip_len)
                                                        set found_opt to 1
                                                else if string_index_of(ai_prompt and "[SENDER:") == 0:
