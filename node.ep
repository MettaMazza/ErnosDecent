                                                            set next_char to get_character(ai_prompt and skip_len)
                                                            if next_char == 32:
                                                                set skip_len to skip_len + 1
                                                        set ai_prompt to substring(ai_prompt and skip_len and string_length(ai_prompt) - skip_len)
                                                        set found_opt to 1
                                                else if string_index_of(ai_prompt and "[ROLE:") == 0:
                                                    set end_idx to string_index_of(ai_prompt and "]")
                                                    if end_idx > 6:
                                                        if role_locked == 0:
                                                            set sender_role to substring(ai_prompt and 6 and end_idx - 6)
                                                            set role_locked to 1
                                                        set skip_len to end_idx + 1
