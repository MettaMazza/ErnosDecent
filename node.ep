                                                        set found_opt to 1
                                                else if string_index_of(ai_prompt and "[IMAGE_PATH:") == 0:
                                                    set end_idx to string_index_of(ai_prompt and "]")
                                                    if end_idx > 12:
                                                        set image_path to substring(ai_prompt and 12 and end_idx - 12)
                                                        set skip_len to end_idx + 1
                                                        if skip_len < string_length(ai_prompt):
                                                            set next_char to get_character(ai_prompt and skip_len)
                                                            if next_char == 32:
                                                                set skip_len to skip_len + 1
                                                        set ai_prompt to substring(ai_prompt and skip_len and string_length(ai_prompt) - skip_len)
                                                        set found_opt to 1
                                                else if string_index_of(ai_prompt and "[MSGID:") == 0:
                                                    set end_idx to string_index_of(ai_prompt and "]")
                                                    if end_idx > 7:
                                                        set discord_msg_id to substring(ai_prompt and 7 and end_idx - 7)
                                                        set skip_len to end_idx + 1
                                                        if skip_len < string_length(ai_prompt):
                                                            set next_char to get_character(ai_prompt and skip_len)
                                                            if next_char == 32:
                                                                set skip_len to skip_len + 1
                                                        set ai_prompt to substring(ai_prompt and skip_len and string_length(ai_prompt) - skip_len)
                                                        set found_opt to 1
                                                else if string_index_of(ai_prompt and "[CHANID:") == 0:
                                                    set end_idx to string_index_of(ai_prompt and "]")
                                                    if end_idx > 8:
                                                        set discord_chan_id to substring(ai_prompt and 8 and end_idx - 8)
                                                        set skip_len to end_idx + 1
                                                        if skip_len < string_length(ai_prompt):
                                                            set next_char to get_character(ai_prompt and skip_len)
                                                            if next_char == 32:
                                                                set skip_len to skip_len + 1
                                                        set ai_prompt to substring(ai_prompt and skip_len and string_length(ai_prompt) - skip_len)
                                                        set found_opt to 1
                                                else if string_index_of(ai_prompt and "[PLATFORM:") == 0:
                                                    set end_idx to string_index_of(ai_prompt and "]")
                                                    if end_idx > 10:
                                                        set msg_platform to substring(ai_prompt and 10 and end_idx - 10)
                                                        set skip_len to end_idx + 1
                                                        if skip_len < string_length(ai_prompt):
                                                            set next_char to get_character(ai_prompt and skip_len)
                                                            if next_char == 32:
                                                                set skip_len to skip_len + 1
                                                        set ai_prompt to substring(ai_prompt and skip_len and string_length(ai_prompt) - skip_len)
                                                        set found_opt to 1
                                                if found_opt == 0:
                                                    set parsing_options to 0

                                            set sessions_mgr to map_get_val(agent_ctx and "sessions")
                                            if string_length(selected_session_id) > 0:
                                                set ok to session_manager_switch_to(sessions_mgr and selected_session_id)
                                                if ok == 0:
                                                    set new_title to concat("Session " and selected_session_id)
                                                    set active_sess to session_manager_new_session(sessions_mgr and selected_session_id and new_title and "" and "You are a helpful assistant.")

                                            # Resolve this request's session before applying any request metadata.
                                            # A closed session is immutable: the first later user inference rolls
                                            # forward to a fresh persisted session and this message becomes turn 1.
                                            # This central fallback covers CLI/custom IPC callers; Discord/WebUI
                                            # use SESSION ENSURE USER earlier so attachments and RAG use the new ID.
                                            set turn_sid to selected_session_id
                                            if string_length(turn_sid) == 0:
                                                set turn_sid to map_get_val(sessions_mgr and "active_session_id")
                                            set rollover_failed to 0
                                            if rights_session_can_receive(storage_get_db() and turn_sid) == 0:
                                                set followup_id to session_manager_start_followup_session(sessions_mgr)
                                                if string_length(followup_id) == 0:
                                                    set rollover_failed to 1
                                                else:
                                                    set turn_sid to followup_id
                                                    set selected_session_id to turn_sid
                                                    set workspace_result to workspace_init(turn_sid)
                                                    if workspace_result != 0:
                                                        set rollover_failed to 1
                                            set active_sess to session_manager_get_active(sessions_mgr)
                                            if active_sess != 0:
                                                if string_length(selected_system_prompt) > 0:
                                                    set ok to map_insert(active_sess and "system_prompt" and selected_system_prompt)
                                                if string_length(selected_model) > 0:
                                                    set ok to map_insert(active_sess and "model" and selected_model)
                                                else:
                                                    if map_contains(active_sess and "model") == 1:
                                                        set selected_model to map_get_val(active_sess and "model")
                                                # Mode is PER-REQUEST, not sticky: each caller (the Learning tab
                                                # always sends "tutor", the normal chat sends none) states its mode
                                                # every turn. We overwrite the session's mode with this request's
                                                # value (empty = normal) rather than inheriting a stale one —
                                                # otherwise tutor mode would leak into the normal AI chat.
                                                set ok to map_insert(active_sess and "mode" and selected_mode)

                                            # ── Phase A2: detached, per-session-parallel turn dispatch ──
                                            # Lazily seed the shared turn-tracking maps on agent_ctx.
                                            if map_contains(agent_ctx and "active_turns") == 0:
                                                set ok to map_insert(agent_ctx and "active_turns" and create_map())
                                            if map_contains(agent_ctx and "turn_ctxs") == 0:
                                                set ok to map_insert(agent_ctx and "turn_ctxs" and create_map())
                                            set at_map to map_get_val(agent_ctx and "active_turns")
                                            set tc_map to map_get_val(agent_ctx and "turn_ctxs")
                                            if rollover_failed == 1:
                                                set resp to "error:session_rollover_failed"
                                            else if rights_session_can_receive(storage_get_db() and turn_sid) == 0:
                                                # Defensive fail-closed check: reaching this branch means the
                                                # rollover transaction did not establish an admissible new session.
                                                set resp to "error:session_rollover_failed"
                                            else if map_contains(at_map and turn_sid) == 1:
                                                # Same-session text arriving during an active turn is live guidance,
                                                # targeted to that exact turn. The Discord bridge normally routes it
                                                # directly; this is the race-safe/non-Discord fallback. It is accepted
                                                # exactly once — callers must never resend the full request.
                                                set busy_tctx to map_get_val(tc_map and turn_sid)
                                                set busy_turn_id to ""
                                                if busy_tctx != 0:
                                                    if map_contains(busy_tctx and "turn_id") == 1:
                                                        set busy_turn_id to map_get_val(busy_tctx and "turn_id")
                                                if string_length(busy_turn_id) == 0:
                                                    set resp to "error:active_turn_not_bound"
                                                else:
                                                    set bw_es to string_replace(turn_sid and "'" and "''")
                                                    set bw_et to string_replace(busy_turn_id and "'" and "''")
                                                    set bw_ec to string_replace(ai_prompt and "'" and "''")
                                                    set bw_now to ep_time_now_sec()
                                                    set bw_ok to sql_execute(storage_get_db() and f"INSERT INTO trace_whispers (session_id, target_turn_id, content, created_at) VALUES ('{bw_es}', '{bw_et}', '{bw_ec}', {bw_now});")
                                                    if bw_ok == 0:
                                                        set resp to f"ai:busy_whispered,session:{turn_sid},turn:{busy_turn_id}"
                                                    else:
                                                        set resp to "error:whisper_write_failed"
                                            else:
                                                # Shared refs sub-agent delegation needs, kept on the SHARED ctx
                                                # (clone below copies them). Also ensure session_auto_approve
                                                # exists so all turn clones share ONE toggle map.
                                                set ok to map_insert(agent_ctx and "model" and cast_borrow_to_map(agent_model))
                                                set ok to map_insert(agent_ctx and "memory_mgr" and cast_borrow_to_map(agent_memory))
                                                set ok to map_insert(agent_ctx and "tools_mgr" and cast_borrow_to_map(agent_tools))
                                                if map_contains(agent_ctx and "session_auto_approve") == 0:
                                                    set ok to map_insert(agent_ctx and "session_auto_approve" and create_map())
                                                # PRIVATE turn ctx: shallow clone shares the sessions manager,
                                                # orchestrator, memory/tools handles and the auto-approve map,
                                                # while per-turn state (pending_*, reasoning, ids, role, mode)
                                                # stays isolated so parallel turns cannot clobber each other.
                                                set tctx to _orch_clone_map(cast_borrow_to_map(agent_ctx))
                                                set ok to map_delete(tctx and "was_cancelled")
                                                set ok to map_delete(tctx and "clarify_rounds")
                                                set ok to map_delete(tctx and "clarify_done")
                                                set ok to map_delete(tctx and "pending_action")
                                                set ok to map_delete(tctx and "pending_clarification")
                                                set ok to map_delete(tctx and "auto_approve")
                                                set ok to map_delete(tctx and "tool_approved")
                                                set ok to map_delete(tctx and "consecutive_denials")
                                                set ok to map_delete(tctx and "last_reasoning")
                                                set ok to map_insert(tctx and "sender_username" and sender_username)
                                                set ok to map_insert(tctx and "sender_role" and sender_role)
                                                set ok to map_insert(tctx and "actor_id" and actor_id)
                                                set ok to map_insert(tctx and "actor_username" and actor_username)
                                                set ok to map_insert(tctx and "actor_global_name" and actor_global_name)
                                                set ok to map_insert(tctx and "actor_display_name" and actor_display_name)
                                                set ok to map_insert(tctx and "actor_type" and actor_type)
                                                set ok to map_insert(tctx and "actor_is_host" and actor_is_host)
                                                set ok to map_insert(tctx and "host_name" and host_name)
                                                set ok to map_insert(tctx and "guild_id" and guild_id)
                                                set ok to map_insert(tctx and "guild_name" and guild_name)
                                                set ok to map_insert(tctx and "channel_name" and channel_name)
                                                set ok to map_insert(tctx and "thread_id" and thread_id)
                                                set ok to map_insert(tctx and "thread_name" and thread_name)
                                                set ok to map_insert(tctx and "in_memory_context" and in_memory_context)
                                                set ok to map_insert(tctx and "visual_context" and visual_context)
                                                set ok to map_insert(tctx and "image_path" and image_path)
                                                set ok to map_insert(tctx and "discord_msg_id" and discord_msg_id)
                                                set ok to map_insert(tctx and "discord_chan_id" and discord_chan_id)
                                                set ok to map_insert(tctx and "platform" and msg_platform)
                                                set ok to map_insert(tctx and "selected_model" and selected_model)
                                                set ok to map_insert(tctx and "mode" and selected_mode)
                                                set ok to map_insert(tctx and "session_id" and turn_sid)
                                                set ok to map_insert(tctx and "turn_received_at" and ep_time_now_sec())
                                                # Persist the accepted message with its complete authenticated
                                                # speaker/surface provenance. Historical turns must never inherit
                                                # the identity attached to whichever account happens to speak next.
                                                if active_sess != 0:
                                                    set ok to session_add_message_with_context(active_sess and "user" and ai_prompt and tctx)
                                                # Preserve the accepted, tag-free user request on the private turn
                                                # context. Artifact creation records use this as their durable WHY;
                                                # reconstructing intent later from filenames or summaries is lossy.
                                                set ok to map_insert(tctx and "user_request" and ai_prompt)
                                                # Intent classification is permitted to inspect only these literal,
                                                # tag-free bytes. Identity, RAG, visual context, history and system
                                                # guidance remain available to reasoning but can never trigger a
                                                # protected self-improvement transaction.
                                                set ok to map_insert(tctx and "literal_user_message" and ai_prompt)
                                                # TURN CORRELATION: every INFER gets a unique turn id, echoed in the
                                                # ack AND prefixed onto this turn's final_reply row. The bridge waits
                                                # for ITS turn id — not "the session's next final_reply" — so a
                                                # concurrent scheduler-job turn in the same session can never be
                                                # delivered as the answer to the user's message (the tick bug: the
                                                # waiter grabbed the scheduled job's reply and the user's real reply
                                                # rotted unsent).
                                                set turn_seq to 1
                                                if map_contains(agent_ctx and "turn_seq") == 1:
                                                    set turn_seq to map_get_val(agent_ctx and "turn_seq") + 1
                                                set ok to map_insert(agent_ctx and "turn_seq" and turn_seq)
                                                # Random correlation survives process restarts without reusing t1,
                                                # which is required by the durable fallback/outbox recovery paths.
                                                set turn_tag to concat("t_" and keys_random_hex(24))
                                                set ok to map_insert(tctx and "turn_id" and turn_tag)
                                                set ok to map_insert(at_map and turn_sid and 1)
                                                set ok to map_insert(tc_map and turn_sid and tctx)
                                                # Fire-and-forget: the turn runs as a background async task and
                                                # delivers its answer as a `final_reply` trace row (A3). The
                                                # socket acks immediately — the daemon is free for parallel
                                                # sessions, Stop, and background work.
                                                set turn_fut to node_run_turn(cast_borrow_to_map(agent_model) and cast_borrow_to_map(agent_memory) and cast_borrow_to_map(agent_tools) and tctx and sessions_mgr and turn_sid and ai_prompt)
                                                set resp to f"ai:accepted,session:{turn_sid},turn:{turn_tag}"
                                        else if cmd_upper equals "BFT STATUS":
                                            set bview to map_get_val(bft_node and "view")
                                            set bseq to map_get_val(bft_node and "seq")
                                            set blog to length_list(map_get_val(bft_node and "log"))
                                            set bslash to length_list(map_get_val(bft_node and "slashed"))
                                            set bvals to length_list(map_get_val(bft_node and "validators"))
                                            set resp to f"bft:active,validators:{bvals},view:{bview},seq:{bseq},committed:{blog},slashed:{bslash}"
                                        else if string_contains(cmd_upper and "BFT PROPOSE ") == 1:
                                            # Drive the live BFT engine: leader pre-prepares the value,
                                            # then the 3-phase protocol runs (single-validator → immediate
                                            # finality; multi-validator finalizes when 2f+1 peers commit
                                            # via the BFT Noise handler).
                                            set bdata to string_trim(substring(cmd and 12 and string_length(cmd) - 12))
                                            set bvcount to length_list(map_get_val(cast_borrow_to_map(bft_node) and "validators"))
                                            if bvcount <= 1:
                                                # single self-validator (f=0): immediate local finality
                                                set cval to bft_run_local(cast_borrow_to_map(bft_node) and bdata)
                                                if string_length(cval) > 0:
                                                    set resp to concat("bft:committed,value:" and cval)
                                                else:
                                                    set resp to "bft:pending,reason:awaiting_quorum"
                                            else:
                                                # multi-node: only the view's leader may pre-prepare. Gossip the
                                                # PRE-PREPARE to peer validators, then apply it locally to emit our
                                                # own (also-gossiped) PREPARE. Finality arrives asynchronously as
                                                # peers' signed PREPARE/COMMIT votes return through the BFT handler.
                                                set pp to bft_propose(cast_borrow_to_map(bft_node) and bdata)
                                                if map_contains(pp and "phase") == 0:
                                                    set resp to "bft:error,reason:not_leader_for_current_view"
                                                else:
                                                    set bsent to broadcast_bft_to_peers(bft_serialize_msg(pp) and dht_node and static_secret and static_public)
                                                    set lr to bft_handle(cast_borrow_to_map(bft_node) and pp)
                                                    set lts to map_get_val(lr and "to_send")
                                                    if map_contains(lts and "phase") == 1:
                                                        set ok to broadcast_bft_to_peers(bft_serialize_msg(lts) and dht_node and static_secret and static_public)
                                                    set resp to f"bft:proposed,peers_notified:{bsent},reason:awaiting_quorum"
                                        else if string_contains(cmd_upper and "MESH AI ") == 1:
                                            # Real collaborative-AI inference over the mesh: assign to
                                            # workers running real local inference + redundant consensus
                                            # (was a hardcoded string_upper stub, test-only).
                                            set mprompt to string_trim(substring(cmd and 8 and string_length(cmd) - 8))
                                            if string_length(mprompt) > 0 and also map_contains(agent_ctx and "mesh") == 1:
                                                set meshh to map_get_val(agent_ctx and "mesh")
                                                set air to mesh_execute_collaborative_ai(cast_borrow_to_map(meshh) and "ipc_user" and mprompt)
                                                set resp to concat("mesh_ai:" and air)
                                            else:
                                                set resp to "mesh_ai:error,reason:missing_prompt"
                                        else if string_contains(cmd_upper and "CDN GET ") == 1:
                                            # Real CDN fetch: locate providers via the DHT, then
                                            # download + SHA-256-verify the segment from the swarm.
                                            set seg_hash to string_trim(substring(cmd and 8 and string_length(cmd) - 8))
                                            if string_length(seg_hash) > 0 and also map_contains(agent_ctx and "cdn_engine") == 1:
                                                set cdn_e to map_get_val(agent_ctx and "cdn_engine")
                                                set seg_peers to cdn_locate_peers_for_segment(cast_borrow_to_map(cdn_e) and seg_hash)
                                                set seg_data to cdn_download_segment(cast_borrow_to_map(cdn_e) and seg_hash and seg_peers)
                                                if string_length(seg_data) > 0:
                                                    set resp to f"cdn:ok,hash:{seg_hash},bytes:{string_length(seg_data)}"
                                                else:
                                                    set resp to f"cdn:not_found,hash:{seg_hash}"
                                            else:
                                                set resp to "cdn:error,reason:missing_hash"
                                        else if string_contains(cmd_upper and "SEARCH CRAWL ") == 1:
                                            # Populate the decentralized search index by crawling a URL
                                            # (real HTTP fetch + link extraction + BM25 index + PageRank).
                                            set crawl_url to string_trim(substring(cmd and 13 and string_length(cmd) - 13))
                                            if string_length(crawl_url) > 0 and also map_contains(agent_ctx and "search_index") == 1:
                                                set sidx to map_get_val(agent_ctx and "search_index")
                                                set cerr to crawl_spider(cast_borrow_to_map(sidx) and crawl_url)
                                                if cerr == 0:
                                                    set ok to rank_compute_pagerank(cast_borrow_to_map(sidx) and 20)
                                                    set pc to map_get_val(cast_borrow_to_map(sidx) and "page_count")
                                                    set resp to f"crawl:ok,url:{crawl_url},pages_indexed:{pc}"
                                                else:
                                                    set resp to f"crawl:error,url:{crawl_url},reason:fetch_failed"
                                            else:
                                                set resp to "crawl:error,reason:missing_url"
                                        else if string_contains(cmd_upper and "ONION SEARCH ") == 1:
                                            # Serve real ranked results from the local decentralized index.
                                            set query to string_trim(substring(cmd and 13 and string_length(cmd) - 13))
                                            if string_length(query) > 0 and also map_contains(agent_ctx and "search_index") == 1:
                                                set sidx2 to map_get_val(agent_ctx and "search_index")
                                                set resp to handle_onion_search(cast_borrow_to_map(sidx2) and query and dht_node and static_secret and static_public)
                                            else:
                                                set resp to "search:error,reason:missing_query"
                                        else if cmd_upper equals "AI APPROVE" or else string_index_of(cmd_upper and "AI APPROVE [") == 0:
                                            # Matches the BARE "AI APPROVE" (main-agent button) AND the bracketed
                                            # sub-agent form "AI APPROVE [AGENT:x] [DECISION:y]". The old
                                            # `equals`-only match meant the bracketed form matched NO branch — the
                                            # bridge's sub-agent approve click was silently dropped as
                                            # unknown_command and the [AGENT:] parsing below was unreachable
                                            # (agent_5/agent_7 approval hangs). "AI APPROVE [" cannot swallow
                                            # AI APPROVE_ALL (different prefix).
                                            set approve_agent_id to ""
                                            set approve_decision to ""
                                            if string_contains(cmd and "[AGENT:") == 1:
                                                set ap_sp to string_index_of(cmd and "[AGENT:")
                                                set ap_rest to substring(cmd and ap_sp + 7 and string_length(cmd) - ap_sp - 7)
                                                set ap_ep to string_index_of(ap_rest and "]")
                                                if ap_ep > 0:
                                                    set approve_agent_id to substring(ap_rest and 0 and ap_ep)
                                            if string_contains(cmd and "[DECISION:") == 1:
                                                set ad_sp to string_index_of(cmd and "[DECISION:")
                                                set ad_rest to substring(cmd and ad_sp + 10 and string_length(cmd) - ad_sp - 10)
                                                set ad_ep to string_index_of(ad_rest and "]")
                                                if ad_ep > 0:
                                                    set approve_decision to substring(ad_rest and 0 and ad_ep)
                                            if string_length(approve_agent_id) > 0:
                                                # Sub-agent approval: write decision to trace_approvals table
                                                set sa_db to storage_get_db()
                                                if sa_db > 0:
                                                    set sa_es to string_replace(approve_agent_id and "'" and "''")
                                                    set sa_dec to "yes"
                                                    if approve_decision equals "no":
                                                        set sa_dec to "no"
                                                    set ok to sql_execute(sa_db and f"UPDATE trace_approvals SET decision='{sa_dec}' WHERE session_id='{sa_es}' AND decision IS NULL;")
                                                    set resp to f"ai:approve_ack,agent:{approve_agent_id},decision:{sa_dec}"
                                                else:
                                                    set resp to "ai:error,reason:db_not_available"
                                            else:
                                                # Main agent approval — Phase A2: resume the DETACHED turn's
                                                # private ctx as a background task; the outcome arrives as the
                                                # session's next `final_reply` trace row.
                                                set r_smgr to map_get_val(agent_ctx and "sessions")
                                                set r_sid to map_get_val(r_smgr and "active_session_id")
                                                set r_tcs to 0
                                                if map_contains(agent_ctx and "turn_ctxs") == 1:
                                                    set r_tcs to map_get_val(agent_ctx and "turn_ctxs")
                                                if r_tcs != 0 and also map_contains(r_tcs and r_sid) == 1:
                                                    set r_tctx to map_get_val(r_tcs and r_sid)
                                                    if map_contains(r_tctx and "pending_action") == 1:
                                                        set r_fut to node_resume_turn(cast_borrow_to_map(agent_model) and cast_borrow_to_map(agent_memory) and cast_borrow_to_map(agent_tools) and r_tctx and r_smgr and r_sid and 0 and 1 and 0 and "")
                                                        set r_ttag to ""
                                                        if map_contains(r_tctx and "turn_id") == 1:
                                                            set r_ttag to map_get_val(r_tctx and "turn_id")
                                                        set resp to f"ai:accepted_resume,session:{r_sid},turn:{r_ttag}"
                                                    else:
                                                        set resp to "ai:error,reason:no_pending_action"
                                                else:
                                                    set resp to "ai:error,reason:no_pending_action"
                                        else if string_index_of(cmd_upper and "AI KILL") == 0:
                                            # Operator kill for ONE sub-agent: "AI KILL [AGENT:<task_id>]".
                                            # Cancels via the orchestrator (status=cancelled + per-session
                                            # react cancel flag). HONEST LIMIT: an LLM call already in flight
                                            # finishes first (the flag is checked at step boundaries and in
                                            # approval/poll loops); its result is then discarded. Also releases
                                            # a kill-target parked at an approval poll (poll checks cancel).
                                            set kill_agent_id to ""
                                            if string_contains(cmd and "[AGENT:") == 1:
                                                set ka_sp to string_index_of(cmd and "[AGENT:")
                                                set ka_rest to substring(cmd and ka_sp + 7 and string_length(cmd) - ka_sp - 7)
                                                set ka_ep to string_index_of(ka_rest and "]")
                                                if ka_ep > 0:
                                                    set kill_agent_id to substring(ka_rest and 0 and ka_ep)
                                            if string_length(kill_agent_id) == 0:
                                                set resp to "ai:error,reason:kill_requires_agent_id"
                                            else if map_contains(agent_ctx and "orchestrator") == 1:
                                                set kill_orch to map_get_val(agent_ctx and "orchestrator")
                                                set kill_res to orchestrator_cancel(kill_orch and kill_agent_id)
                                                set resp to f"ai:kill_ack,agent:{kill_agent_id},result:{kill_res}"
                                            else:
                                                set resp to "ai:error,reason:orchestrator_not_initialized"
                                        else if string_index_of(cmd_upper and "AI EMERGENCY ") == 0:
                                            # Emergency authority is limited to immediate person/hardware/security/
                                            # node-stability protection. This records the cause and starts the
                                            # mandatory 24-hour disclosure clock; it does not itself run a shell op.
                                            set em_json to substring(cmd and 13 and string_length(cmd) - 13)
                                            set em_root to json_parse(em_json)
                                            set em_category to ""
                                            set em_target to ""
                                            set em_reason to ""
                                            if em_root != 0:
                                                set em_category_node to get_json_object_value(em_root and "category")
                                                set em_target_node to get_json_object_value(em_root and "target")
                                                set em_reason_node to get_json_object_value(em_root and "reason")
                                                if em_category_node != 0:
                                                    set em_category to get_json_value(em_category_node)
                                                if em_target_node != 0:
                                                    set em_target to get_json_value(em_target_node)
                                                if em_reason_node != 0:
                                                    set em_reason to get_json_value(em_reason_node)
                                            if em_category equals "physical" == 0 and also em_category equals "hardware" == 0 and also em_category equals "security" == 0 and also em_category equals "node_stability" == 0:
                                                set resp to "emergency:error,reason:category_must_be_physical_hardware_security_or_node_stability"
                                            else:
                                                set resp to rights_emergency_begin(storage_get_db() and em_category and em_target and em_reason)
                                        else if string_index_of(cmd_upper and "AI LEARNING REQUEST ") == 0:
                                            set lr_json to substring(cmd and 20 and string_length(cmd) - 20)
                                            set lr_sid to ""
                                            if agent_ctx != 0:
                                                set lr_mgr to map_get_val(agent_ctx and "sessions")
                                                if lr_mgr != 0:
                                                    set lr_sid to map_get_val(lr_mgr and "active_session_id")
                                            set resp to live_learning_training_request(storage_get_db() and lr_json and lr_sid)
                                        else if string_index_of(cmd_upper and "AI LEARNING TRAIN ") == 0:
                                            set lr_change to string_trim(substring(cmd and 18 and string_length(cmd) - 18))
                                            set resp to live_learning_training_authorize(storage_get_db() and lr_change)
                                        else if string_index_of(cmd_upper and "AI LEARNING PROMOTION ") == 0:
                                            set lp_json to substring(cmd and 22 and string_length(cmd) - 22)
                                            set lp_root to json_parse(lp_json)
                                            set lp_tx to ""
                                            set lp_training_change to ""
                                            if lp_root != 0:
                                                set lp_tx to live_learning_json_string(lp_root and "transaction_id")
                                                set lp_training_change to live_learning_json_string(lp_root and "training_change_id")
                                            set lp_sid to ""
                                            if agent_ctx != 0:
                                                set lp_mgr to map_get_val(agent_ctx and "sessions")
                                                if lp_mgr != 0:
                                                    set lp_sid to map_get_val(lp_mgr and "active_session_id")
                                            set resp to live_learning_promotion_request(storage_get_db() and lp_tx and lp_training_change and lp_sid)
                                        else if string_index_of(cmd_upper and "AI LEARNING STAGE ") == 0:
                                            set lp_change to string_trim(substring(cmd and 18 and string_length(cmd) - 18))
                                            set resp to live_learning_stage_authorize(storage_get_db() and lp_change)
                                        else if cmd_upper equals "AI LEARNING RECONCILE":
                                            set resp to live_learning_reconcile(storage_get_db())
                                        else if string_index_of(cmd_upper and "AI FACTORY REQUEST ") == 0:
                                            # A factory request is bilateral: Maria supplies the reason, then Echo
                                            # receives the exact manifest and may consent, reject, or counter-propose.
                                            # This branch records a request only. It cannot erase state.
                                            set fr_json to substring(cmd and 19 and string_length(cmd) - 19)
                                            set fr_root to json_parse(fr_json)
                                            set fr_reason to ""
                                            if fr_root != 0:
                                                set fr_reason_node to get_json_object_value(fr_root and "reason")
                                                if fr_reason_node != 0:
                                                    set fr_reason to string_trim(get_json_value(fr_reason_node))
                                            if string_length(fr_reason) == 0:
                                                set resp to "factory:error,reason:human_reason_required"
                                            else if string_length(fr_reason) > 4000:
                                                set resp to "factory:error,reason:human_reason_too_long"
                                            else if agent_ctx == 0:
                                                set resp to "factory:error,reason:agent_not_initialized"
                                            else:
                                                set fr_mgr to map_get_val(agent_ctx and "sessions")
                                                set fr_sid to map_get_val(fr_mgr and "active_session_id")
                                                set fr_before to rights_file_hash(concat("config/sessions/" and concat(fr_sid and ".json")))
                                                set fr_proposed to ep_sha256(concat("factory_blank_agent_state_v2|" and rights_factory_inventory_hash()))
                                                set fr_summary to concat("Maria requests a factory reset. Her stated reason: " and fr_reason)
                                                # The exact payload exposes the same canonical target inventory that
                                                # recovery and execution consume. The request timestamp makes each
                                                # submission attributable and distinct without hiding its scope.
                                                set fr_request_ms to int_to_string(ep_time_now_ms())
                                                set fr_payload to rights_factory_proposal_payload(fr_reason and fr_sid and fr_request_ms)
                                                set fr_id to rights_prepare_change(storage_get_db() and "core" and "factory_reset" and "agent_state" and fr_summary and fr_before and fr_proposed and fr_payload and fr_sid)
                                                if string_length(fr_id) == 0:
                                                    set resp to "factory:error,reason:rights_manifest_failed"
                                                else if rights_mark_human_authorized(storage_get_db() and fr_id) != 0:
                                                    set resp to "factory:error,reason:human_authorization_record_failed"
                                                else:
                                                    set resp to concat("factory:pending_echo,change_id:" and concat(fr_id and concat(",session:" and fr_sid)))
                                        else if string_index_of(cmd_upper and "AI FACTORY EXECUTE ") == 0:
                                            # Execution is a separate transition. It requires Echo's recorded core
                                            # consent and a verified recovery bundle before the first destructive op.
                                            set fx_id to string_trim(substring(cmd and 19 and string_length(cmd) - 19))
                                            set fx_gate to rights_gate_change(storage_get_db() and fx_id)
                                            if fx_gate equals "ALLOWED" == 0:
                                                set resp to concat("factory:blocked,detail:" and fx_gate)
                                            else if agent_ctx == 0:
                                                set resp to "factory:error,reason:agent_not_initialized"
                                            else if rights_archive_all_traces(storage_get_db() and fx_id) != 0:
                                                set ok to rights_mark_failed(storage_get_db() and fx_id and "reasoning trace archival failed")
                                                set resp to "factory:error,reason:trace_archive_failed"
                                            else:
                                                set fx_bundle to rights_create_factory_bundle(storage_get_db() and fx_id)
                                                set fx_pre_hash to rights_bundle_state_hash(storage_get_db() and fx_bundle)
                                                if string_length(fx_bundle) == 0 or else string_length(fx_pre_hash) != 64:
                                                    set ok to rights_mark_failed(storage_get_db() and fx_id and "recovery bundle creation or verification failed")
                                                    set resp to "factory:error,reason:verified_recovery_required"
                                                else:
                                                    set fx_err to 0
                                                    set fx_trees to rights_factory_tree_targets()
                                                    set fx_i to 0
                                                    repeat while fx_i < length_list(fx_trees):
                                                        if factory_rm_tree(ptr_to_str(get_list(fx_trees and fx_i)) and 0) != 0:
                                                            set fx_err to 1
                                                        set fx_i to fx_i + 1
                                                    free_list(fx_trees)
                                                    set fx_files to rights_factory_file_targets()
                                                    set fx_i to 0
                                                    repeat while fx_i < length_list(fx_files):
                                                        set fx_file to ptr_to_str(get_list(fx_files and fx_i))
                                                        if file_exists(fx_file) == 1:
                                                            if remove_file(fx_file) == 0:
                                                                set fx_err to 1
                                                        set fx_i to fx_i + 1
                                                    free_list(fx_files)
                                                    set fpp to edition_persona_path()
                                                    if file_exists(fpp) == 1:
                                                        set stripped_persona to sleep_strip_reflections(read_file(fpp))
                                                        if write_file(fpp and stripped_persona) == 0 or else read_file(fpp) equals stripped_persona == 0:
                                                            set fx_err to 1
                                                    set fdb to storage_get_db()
                                                    if fdb == 0:
                                                        set fx_err to 1
                                                    else:
                                                        if sql_execute(fdb and "BEGIN IMMEDIATE;") != 0:
                                                            set fx_err to 1
                                                        else:
                                                            set fx_sql_err to storage_factory_clear_agent_state(fdb)
                                                            if fx_sql_err == 0:
                                                                if sql_execute(fdb and "COMMIT;") != 0:
                                                                    set fx_err to 1
                                                            else:
                                                                set ok to sql_execute(fdb and "ROLLBACK;")
                                                                set fx_err to 1
                                                    if fx_err != 0:
                                                        set fx_failure to "factory reset stopped after a visible filesystem or database failure; verified recovery bundle retained"
                                                        set ok to rights_mark_failed(storage_get_db() and fx_id and fx_failure)
                                                        # A verified bundle is not enough if a filesystem mutation
                                                        # already happened. Stage it immediately so the next normal
                                                        # run_node.sh launch restores the exact pre-state before boot.
                                                        set fx_restore to rights_stage_factory_restore(storage_get_db() and fx_bundle and fx_id)
                                                        if string_index_of(fx_restore and "Factory rollback staged.") == 0:
                                                            set resp to concat("factory:error,reason:mutation_failed_recovery_staged,restart_required:1,bundle:" and fx_bundle)
                                                        else:
                                                            set resp to concat("factory:error,reason:mutation_failed_restore_staging_failed,detail:" and concat(fx_restore and concat(",bundle:" and fx_bundle)))
                                                    else:
                                                        set fx_live_err to memory_factory_reset(cast_borrow_to_map(agent_memory))
                                                        if memory_serialize(cast_borrow_to_map(agent_memory) and "config/agent_memory.json") != 0:
                                                            set fx_live_err to 1
                                                        set fsm to map_get_val(agent_ctx and "sessions")
                                                        if session_manager_factory_reset(fsm) != 0:
                                                            set fx_live_err to 1
                                                        if workspace_init("default") != 0:
                                                            set fx_live_err to 1
                                                        if file_exists("config/workspaces/active/.session_meta.json") == 0:
                                                            set fx_live_err to 1
                                                        if map_contains(agent_ctx and "session_auto_approve") == 1:
                                                            set ok to map_delete(agent_ctx and "session_auto_approve")
                                                        if map_contains(agent_ctx and "current_prompt") == 1:
                                                            set ok to map_delete(agent_ctx and "current_prompt")
                                                        if map_contains(agent_ctx and "last_reasoning") == 1:
                                                            set ok to map_delete(agent_ctx and "last_reasoning")
                                                        if map_contains(agent_ctx and "pending_action") == 1:
                                                            set ok to map_delete(agent_ctx and "pending_action")
                                                        if map_contains(agent_ctx and "pending_clarification") == 1:
                                                            set ok to map_delete(agent_ctx and "pending_clarification")
                                                        if map_contains(agent_ctx and "in_memory_context") == 1:
                                                            set ok to map_delete(agent_ctx and "in_memory_context")
                                                        if map_contains(agent_ctx and "visual_context") == 1:
                                                            set ok to map_delete(agent_ctx and "visual_context")
                                                        # Runtime reset is explicit: a factory operation cannot leave
                                                        # old turns, sub-agent results, scheduler counts, or image-job
                                                        # recovery markers reachable after the durable state is empty.
                                                        set ok to map_insert(agent_ctx and "active_turns" and create_map())
                                                        set ok to map_insert(agent_ctx and "turn_ctxs" and create_map())
                                                        set ok to map_insert(agent_ctx and "turn_seq" and 0)
                                                        set ok to map_insert(agent_ctx and "active_runs" and 0)
                                                        set ok to map_insert(agent_ctx and "active_jobs" and 0)
                                                        if map_contains(agent_ctx and "orchestrator") == 1:
                                                            if orchestrator_factory_reset(map_get_val(agent_ctx and "orchestrator")) != 0:
                                                                set fx_live_err to 1
                                                        if image_gen_factory_reset() != 0:
                                                            set fx_live_err to 1
                                                        set ok to prompt_refresh_agent_name()
                                                        set fx_result_hash to ep_sha256(concat("factory_reset_v2|" and concat(rights_factory_inventory_hash() and concat("|" and fx_pre_hash))))
                                                        if fx_live_err != 0:
                                                            set ok to rights_mark_failed(storage_get_db() and fx_id and "factory mutation completed but the fresh live state could not be durably reconstructed; verified recovery bundle retained")
                                                            # Live-state reconstruction follows destructive mutation too.
                                                            # Stage the verified bundle exactly as the filesystem/SQL
                                                            # failure branch does, so the next launch restores pre-state.
                                                            set fx_restore to rights_stage_factory_restore(storage_get_db() and fx_bundle and fx_id)
                                                            if string_index_of(fx_restore and "Factory rollback staged.") == 0:
                                                                set resp to concat("factory:error,reason:live_state_rebuild_failed_recovery_staged,restart_required:1,bundle:" and fx_bundle)
                                                            else:
                                                                set resp to concat("factory:error,reason:live_state_rebuild_failed_restore_staging_failed,detail:" and concat(fx_restore and concat(",bundle:" and fx_bundle)))
                                                        else if rights_mark_applied(storage_get_db() and fx_id and fx_result_hash) != 0:
                                                            set resp to concat("factory:error,reason:applied_but_ledger_failed,bundle:" and fx_bundle)
                                                        else:
                                                            display "[FACTORY] Bilaterally approved reset complete; verified recovery retained."
                                                            set resp to concat("factory:ok,change_id:" and concat(fx_id and concat(",bundle:" and concat(fx_bundle and concat(",pre_state_hash:" and fx_pre_hash)))))
                                        else if string_contains(cmd_upper and "AI PERSONA") == 1:
                                            # P9: persona control. "AI PERSONA LIST" lists; "AI PERSONA <name>"
                                            # activates a registered persona (data-dir pointer + name cache
                                            # invalidation happen inside prompt_persona_set).
                                            set pa_arg to string_trim(substring(cmd and 10 and string_length(cmd) - 10))
                                            if string_length(pa_arg) == 0 or else string_upper(pa_arg) equals "LIST":
                                                set resp to prompt_persona_list()
                                            else:
                                                set pa_name to string_lower(pa_arg)
                                                set pa_before to prompt_persona_active()
                                                set pa_sid to ""
                                                set pa_mgr to map_get_val(agent_ctx and "sessions")
                                                if pa_mgr != 0:
                                                    set pa_sid to map_get_val(pa_mgr and "active_session_id")
                                                set pa_path to storage_active_persona_path()
                                                set pa_summary to concat("Maria requests persona substitution: " and concat(pa_before and concat(" -> " and pa_name)))
                                                set pa_change to rights_prepare_change(storage_get_db() and "core" and "persona_activation" and pa_path and pa_summary and rights_file_hash(pa_path) and ep_sha256(pa_name) and pa_name and pa_sid)
                                                if string_length(pa_change) == 0 or else rights_mark_human_authorized(storage_get_db() and pa_change) != 0:
                                                    set resp to "persona:error,reason:rights_manifest_failed"
                                                else:
                                                    set pa_gate to rights_gate_change(storage_get_db() and pa_change)
                                                    if pa_gate equals "ALLOWED" == 0:
                                                        set resp to concat("persona:pending,change_id:" and concat(pa_change and concat(",detail:" and pa_gate)))
                                                    else if rights_backup_file(storage_get_db() and pa_change and pa_path) != 0:
                                                        set ok to rights_mark_failed(storage_get_db() and pa_change and "persona pre-state recovery could not be verified")
                                                        set resp to "persona:error,reason:verified_recovery_required"
                                                    else:
                                                        set resp to prompt_persona_set(pa_name)
                                                        if string_index_of(resp and "persona:active,") == 0:
                                                            if rights_mark_applied(storage_get_db() and pa_change and rights_file_hash(pa_path)) != 0:
                                                                set resp to "persona:error,reason:activated_but_ledger_failed"
                                                        else:
                                                            set pa_rollback to rights_rollback_file(storage_get_db() and pa_change)
                                                            set resp to concat(resp and concat("; " and pa_rollback))
                                        else if string_contains(cmd_upper and "AI AUTOAPPROVE ") == 1:
                                            # P4: PERSISTENT per-session auto-approve toggle. Unlike AI APPROVE_ALL
                                            # (request-scoped; cleared after the run), this flag lives for the
                                            # session: every approval gate in react_run_loop consults it, so tools
                                            # run without pausing until toggled OFF. Deliberately NOT persisted to
                                            # disk — a node restart resets to the safe default (OFF). Observer
                                            # audits stay fully active (approval only downgrades BLOCKED to
                                            # advisory, exactly as with a manual approve).
                                            if agent_ctx != 0:
                                                set aa_arg to string_upper(string_trim(substring(cmd and 15 and string_length(cmd) - 15)))
                                                if map_contains(agent_ctx and "session_auto_approve") == 0:
                                                    set ok to map_insert(agent_ctx and "session_auto_approve" and create_map())
                                                set aa_map to map_get_val(agent_ctx and "session_auto_approve")
                                                set aa_sessions to map_get_val(agent_ctx and "sessions")
                                                set aa_sid to map_get_val(aa_sessions and "active_session_id")
                                                if aa_arg equals "ON":
                                                    set ok to map_insert(aa_map and aa_sid and 1)
                                                    set resp to f"ai:autoapprove,session:{aa_sid},state:on"
                                                else:
                                                    if map_contains(aa_map and aa_sid) == 1:
                                                        set ok to map_delete(aa_map and aa_sid)
                                                    set resp to f"ai:autoapprove,session:{aa_sid},state:off"
                                            else:
                                                set resp to "ai:error,reason:agent_not_initialized"
                                        else if cmd_upper equals "AI APPROVE_ALL":
                                            # Phase A2: detached resume with request-scoped auto-approve.
                                            set r_smgr to map_get_val(agent_ctx and "sessions")
                                            set r_sid to map_get_val(r_smgr and "active_session_id")
                                            set r_tcs to 0
                                            if map_contains(agent_ctx and "turn_ctxs") == 1:
                                                set r_tcs to map_get_val(agent_ctx and "turn_ctxs")
                                            if r_tcs != 0 and also map_contains(r_tcs and r_sid) == 1:
                                                set r_tctx to map_get_val(r_tcs and r_sid)
                                                if map_contains(r_tctx and "pending_action") == 1:
                                                    set ok to map_insert(r_tctx and "auto_approve" and 1)
                                                    set r_fut to node_resume_turn(cast_borrow_to_map(agent_model) and cast_borrow_to_map(agent_memory) and cast_borrow_to_map(agent_tools) and r_tctx and r_smgr and r_sid and 0 and 1 and 1 and "")
                                                    set r_ttag to ""
                                                    if map_contains(r_tctx and "turn_id") == 1:
                                                        set r_ttag to map_get_val(r_tctx and "turn_id")
                                                    set resp to f"ai:accepted_resume,session:{r_sid},turn:{r_ttag}"
                                                else:
                                                    set resp to "ai:error,reason:no_pending_action"
                                            else:
                                                set resp to "ai:error,reason:no_pending_action"
                                        else if cmd_upper equals "AI DENY":
                                            # Phase A2: detached denied-resume.
                                            set r_smgr to map_get_val(agent_ctx and "sessions")
                                            set r_sid to map_get_val(r_smgr and "active_session_id")
                                            set r_tcs to 0
                                            if map_contains(agent_ctx and "turn_ctxs") == 1:
                                                set r_tcs to map_get_val(agent_ctx and "turn_ctxs")
                                            if r_tcs != 0 and also map_contains(r_tcs and r_sid) == 1:
                                                set r_tctx to map_get_val(r_tcs and r_sid)
                                                if map_contains(r_tctx and "pending_action") == 1:
                                                    set r_fut to node_resume_turn(cast_borrow_to_map(agent_model) and cast_borrow_to_map(agent_memory) and cast_borrow_to_map(agent_tools) and r_tctx and r_smgr and r_sid and 0 and 0 and 0 and "")
                                                    set r_ttag to ""
                                                    if map_contains(r_tctx and "turn_id") == 1:
                                                        set r_ttag to map_get_val(r_tctx and "turn_id")
                                                    set resp to f"ai:accepted_resume,session:{r_sid},turn:{r_ttag}"
                                                else:
                                                    set resp to "ai:error,reason:no_pending_action"
                                            else:
                                                set resp to "ai:error,reason:no_pending_action"
                                        else if string_contains(cmd_upper and "AI CANCEL") == 1:
                                            # F4: stop/halt. Arrives on its own connection while the run is
                                            # blocked on another; sets the per-session cancel flag the loop
                                            # consumes at its next turn boundary. Optional [SESSION:id].
                                            set cancel_sid to ""
                                            if string_contains(cmd and "[SESSION:") == 1:
                                                set sp to string_index_of(cmd and "[SESSION:")
                                                set rest to substring(cmd and sp + 9 and string_length(cmd) - sp - 9)
                                                set ep to string_index_of(rest and "]")
                                                if ep > 0:
                                                    set cancel_sid to substring(rest and 0 and ep)
                                            set ok to react_request_cancel(cancel_sid)
                                            # SAFETY: also bump the global cancel EPOCH — a Stop must halt the
                                            # WHOLE system (main run + every sub-agent + background
                                            # coordinators) instantly, not just the targeted session; in-flight
                                            # LLM reads abort within ~1s on the same latch.
                                            set ok to ep_cancel_epoch_bump(0)
                                            set resp to "ai:cancel_ack"
                                        else if string_index_of(cmd_upper and "AI CLARIFY") == 0:
                                            # F3: user answered the agent's clarifying question(s) — resume.
                                            # Match the PREFIX, not "AI CLARIFY " with a trailing space: the
                                            # IPC layer trims the command, so an empty answer arrives as exactly
                                            # "AI CLARIFY" and must still resume (not fall through to unknown_command).
                                            set clarify_answers to ""
                                            if string_length(cmd) > 11:
                                                set clarify_answers to substring(cmd and 11 and string_length(cmd) - 11)
                                            # Phase A2: detached clarify-resume against the turn's private ctx.
                                            set r_smgr to map_get_val(agent_ctx and "sessions")
                                            set r_sid to map_get_val(r_smgr and "active_session_id")
                                            set r_tcs to 0
                                            if map_contains(agent_ctx and "turn_ctxs") == 1:
                                                set r_tcs to map_get_val(agent_ctx and "turn_ctxs")
                                            if r_tcs != 0 and also map_contains(r_tcs and r_sid) == 1:
                                                set r_tctx to map_get_val(r_tcs and r_sid)
                                                if map_contains(r_tctx and "pending_clarification") == 1:
                                                    set r_fut to node_resume_turn(cast_borrow_to_map(agent_model) and cast_borrow_to_map(agent_memory) and cast_borrow_to_map(agent_tools) and r_tctx and r_smgr and r_sid and 1 and 0 and 0 and clarify_answers)
                                                    set r_ttag to ""
                                                    if map_contains(r_tctx and "turn_id") == 1:
                                                        set r_ttag to map_get_val(r_tctx and "turn_id")
                                                    set resp to f"ai:accepted_resume,session:{r_sid},turn:{r_ttag}"
                                                else:
                                                    set resp to "ai:error,reason:no_pending_clarification"
                                            else:
                                                set resp to "ai:error,reason:no_pending_clarification"
                                        else if cmd_upper equals "AI MODELS":
                                            set resp to agent_list_models()
                                        else if string_contains(cmd_upper and "AI TRANSCRIBE ") == 1:
                                            # Real STT via the whisper.cpp backend (binary-safe curl
                                            # multipart upload). Returns the real transcript or an
                                            # explicit error — never a fabricated transcription.
                                            set audio_path to string_trim(substring(cmd and 14 and string_length(cmd) - 14))
                                            set wcfg to config_load(concat(get_home_dir() and "/.ernosdecent/config.toml"))
                                            set whost to config_get_str(wcfg and "ai.whisper_host")
                                            set wport to config_get_int(wcfg and "ai.whisper_port")
                                            set tr to speech_transcribe_whisper(audio_path and whost and wport)
                                            if string_index_of(tr and "ERROR:") == 0:
                                                set resp to concat("ai:error,reason:" and substring(tr and 6 and string_length(tr) - 6))
                                            else:
                                                set resp to concat("ai:ok,transcription:" and tr)
                                            free_map(wcfg)
                                        else if string_contains(cmd_upper and "TTS SPEAK ") == 1:
                                            # Synthesise text to a WAV (Kokoro, voice bm_fable @1.15x) and
                                            # return its path. The Discord bridge calls this, then reads the
                                            # file off disk and uploads it as a 🔊 audio attachment.
                                            set tts_text to string_trim(substring(cmd and 10 and string_length(cmd) - 10))
                                            if string_length(tts_text) == 0:
                                                set resp to "tts:error,reason:empty_text"
                                            else:
                                                set tts_name to tts_filename_for(tts_text)
                                                set tts_path to concat("decent_web/tts/" and tts_name)
                                                set tts_rc to 0
                                                if file_exists(tts_path) == 0:
                                                    set tts_rc to tts_speak(tts_text and tts_path)
                                                if tts_rc == 0 and also file_exists(tts_path) == 1:
                                                    set resp to concat("tts:ok,path:" and tts_path)
                                                else:
                                                    set resp to "tts:error,reason:synthesis_failed"
                                        else if string_contains(cmd_upper and "SESSION TOKEN CREATE ") == 1:
                                            set args to substring(cmd and 21 and string_length(cmd) - 21)
                                            set space_pos to string_index_of(args and " ")
                                            if space_pos > 0:
                                                set t_did to substring(args and 0 and space_pos)
                                                set ttl_str to substring(args and space_pos + 1 and string_length(args) - space_pos - 1)
                                                set ttl to string_to_int(ttl_str)
                                                set sign_sec to ptr_to_str(map_get_val(identity and "signing_secret_key"))
                                                set token_res to create_session_token(t_did and sign_sec and ttl)
                                                set err to map_get_val(token_res and "error")
                                                if err == 0:
                                                    set tok to map_get_val(token_res and "token")
                                                    set iss to int_to_string(map_get_val(token_res and "issued_at"))
                                                    set exp to int_to_string(map_get_val(token_res and "expires_at"))
                                                    set nonc to map_get_val(token_res and "nonce")
                                                    set ph to map_get_val(token_res and "payload_hash")
                                                    set resp to f"token:{tok},did:{t_did},issued_at:{iss},expires_at:{exp},nonce:{nonc},payload_hash:{ph}"
                                                else:
                                                    set resp to f"token:error,code:{err}"
                                                free_map(token_res)
                                            else:
                                                set resp to "token:error,reason:invalid_format"
                                        else if cmd_upper equals "SESSION LIST":
                                            set sessions_mgr to map_get_val(agent_ctx and "sessions")
                                            set list_json to session_manager_list_json(sessions_mgr)
                                            set resp to f"session:list,data:{list_json}"
                                        else if cmd_upper equals "SESSION ACTIVE":
                                            set sessions_mgr to map_get_val(agent_ctx and "sessions")
                                            set active_id to map_get_val(sessions_mgr and "active_session_id")
                                            set resp to f"session:active_id,id:{active_id}"
                                        else if cmd_upper equals "SESSION ENSURE USER":
                                            # Called at the boundary of an actual user message. If Echo
                                            # closed the prior session, preserve it and atomically select a
                                            # fresh empty session before attachments/RAG are associated.
                                            set sessions_mgr to map_get_val(agent_ctx and "sessions")
                                            set active_id to map_get_val(sessions_mgr and "active_session_id")
                                            set created_followup to 0
                                            if rights_session_can_receive(storage_get_db() and active_id) == 0:
                                                set followup_id to session_manager_start_followup_session(sessions_mgr)
                                                if string_length(followup_id) == 0:
                                                    set resp to "session:error,reason:followup_creation_failed"
                                                else:
                                                    set active_id to followup_id
                                                    set workspace_result to workspace_init(active_id)
                                                    if workspace_result != 0:
                                                        set resp to "session:error,reason:followup_workspace_failed"
                                                    else:
                                                        set created_followup to 1
                                                        set resp to f"session:user_ready,id:{active_id},created:{created_followup}"
                                            else:
                                                set resp to f"session:user_ready,id:{active_id},created:{created_followup}"
                                        else if string_contains(cmd_upper and "SESSION GET ") == 1:
                                            set sess_id to substring(cmd and 12 and string_length(cmd) - 12)
                                            set sessions_mgr to map_get_val(agent_ctx and "sessions")
                                            set sessions_map to map_get_val(sessions_mgr and "sessions")
                                            if map_contains(sessions_map and sess_id) == 1:
                                                set sess to map_get_val(sessions_map and sess_id)
                                                set sess_json to session_serialize_json_string(sess)
                                                set resp to f"session:details,data:{sess_json}"
                                            else:
                                                set resp to "session:error,reason:not_found"
                                        else if string_contains(cmd_upper and "SESSION NEW ") == 1:
                                            set sess_json_str to substring(cmd and 12 and string_length(cmd) - 12)
                                            set root to json_parse(sess_json_str)
                                            if root != 0:
                                                set id_node to get_json_object_value(root and "id")
                                                set title_node to get_json_object_value(root and "title")
                                                set model_node to get_json_object_value(root and "model")
                                                set sys_node to get_json_object_value(root and "system_prompt")
                                                set id_val to ""
                                                set title_val to ""
                                                set model_val to ""
                                                set sys_val to ""
                                                if id_node != 0:
                                                    set id_val to get_json_value(id_node)
                                                if title_node != 0:
                                                    set title_val to get_json_value(title_node)
                                                if model_node != 0:
                                                    set model_val to get_json_value(model_node)
                                                if sys_node != 0:
                                                    set sys_val to get_json_value(sys_node)
                                                set sessions_mgr to map_get_val(agent_ctx and "sessions")
                                                set sess to session_manager_new_session(sessions_mgr and id_val and title_val and model_val and sys_val)
                                                # Rotate workspace for the new session
                                                set ok to workspace_init(id_val)
                                                set resp to f"session:ok,id:{id_val}"
                                            else:
                                                set resp to "session:error,reason:invalid_json"
                                        else if string_contains(cmd_upper and "SESSION SET ") == 1:
                                            set sess_id to string_trim(substring(cmd and 12 and string_length(cmd) - 12))
                                            set sessions_mgr to map_get_val(agent_ctx and "sessions")
                                            # P8: accept a session NAME/title (exact or unique substring) as well as an id.
                                            set resolved_sid to session_manager_resolve_id(sessions_mgr and sess_id)
                                            if string_length(resolved_sid) > 0:
                                                set sess_id to resolved_sid
                                            set ok to session_manager_switch_to(sessions_mgr and sess_id)
                                            if ok == 1:
                                                set resp to f"session:set_ok,id:{sess_id}"
                                            else:
                                                set resp to "session:error,reason:not_found"
                                        else if string_contains(cmd_upper and "SESSION RENAME ") == 1:
                                            set sess_json_str to substring(cmd and 15 and string_length(cmd) - 15)
                                            set root to json_parse(sess_json_str)
                                            if root != 0:
                                                set id_node to get_json_object_value(root and "id")
                                                set title_node to get_json_object_value(root and "title")
                                                set id_val to ""
                                                set title_val to ""
                                                if id_node != 0:
                                                    set id_val to get_json_value(id_node)
                                                if title_node != 0:
                                                    set title_val to get_json_value(title_node)
                                                set sessions_mgr to map_get_val(agent_ctx and "sessions")
                                                set ok to session_manager_rename(sessions_mgr and id_val and title_val)
                                                if ok == 1:
                                                    set resp to f"session:rename_ok,id:{id_val}"
                                                else:
                                                    set resp to "session:error,reason:not_found"
                                            else:
                                                set resp to "session:error,reason:invalid_json"
                                        else if string_contains(cmd_upper and "SESSION UPDATE_MODEL ") == 1:
                                            set sess_json_str to substring(cmd and 21 and string_length(cmd) - 21)
                                            set root to json_parse(sess_json_str)
                                            if root != 0:
                                                set id_node to get_json_object_value(root and "id")
                                                set model_node to get_json_object_value(root and "model")
                                                set id_val to ""
                                                set model_val to ""
                                                if id_node != 0:
                                                    set id_val to get_json_value(id_node)
                                                if model_node != 0:
                                                    set model_val to get_json_value(model_node)
                                                set sessions_mgr to map_get_val(agent_ctx and "sessions")
                                                set sm_sessions to map_get_val(sessions_mgr and "sessions")
                                                if map_contains(sm_sessions and id_val) == 1:
                                                    set sm_sess to map_get_val(sm_sessions and id_val)
                                                    set sm_before_model to ""
                                                    if map_contains(sm_sess and "model") == 1:
                                                        set sm_before_model to ptr_to_str(map_get_val(sm_sess and "model"))
                                                    set sm_path to concat("config/sessions/" and concat(id_val and ".json"))
                                                    set sm_summary to concat("Maria requests model/provider substitution for session " and concat(id_val and concat(": " and concat(sm_before_model and concat(" -> " and model_val)))))
                                                    set sm_change to rights_prepare_change(storage_get_db() and "core" and "model_substitution" and sm_path and sm_summary and rights_file_hash(sm_path) and ep_sha256(model_val) and model_val and id_val)
                                                    if string_length(sm_change) == 0 or else rights_mark_human_authorized(storage_get_db() and sm_change) != 0:
                                                        set resp to "session:error,reason:rights_manifest_failed"
                                                    else:
                                                        set sm_gate to rights_gate_change(storage_get_db() and sm_change)
                                                        if sm_gate equals "ALLOWED" == 0:
                                                            set resp to concat("session:update_model_pending,change_id:" and concat(sm_change and concat(",detail:" and sm_gate)))
                                                        else if rights_backup_file(storage_get_db() and sm_change and sm_path) != 0:
                                                            set ok to rights_mark_failed(storage_get_db() and sm_change and "model substitution pre-state recovery could not be verified")
                                                            set resp to "session:error,reason:verified_recovery_required"
                                                        else:
                                                            set ok to session_manager_set_model(sessions_mgr and id_val and model_val)
                                                            if ok == 1:
                                                                set active_id to map_get_val(sessions_mgr and "active_session_id")
                                                                if active_id equals id_val:
                                                                    set ok to map_insert(agent_ctx and "selected_model" and model_val)
                                                                if rights_mark_applied(storage_get_db() and sm_change and rights_file_hash(sm_path)) != 0:
                                                                    set resp to "session:error,reason:model_changed_but_ledger_failed"
                                                                else:
                                                                    set resp to f"session:update_model_ok,id:{id_val}"
                                                            else:
                                                                set sm_rollback to rights_rollback_file(storage_get_db() and sm_change)
                                                                set resp to concat("session:error,reason:persistence_failed," and sm_rollback)
                                                else:
                                                    set resp to "session:error,reason:not_found"
                                            else:
                                                set resp to "session:error,reason:invalid_json"
                                        else if string_contains(cmd_upper and "SESSION DELETE ") == 1:
                                            set sd_json to substring(cmd and 15 and string_length(cmd) - 15)
                                            set sd_root to json_parse(sd_json)
                                            set sess_id to ""
                                            set sd_reason to ""
                                            if sd_root != 0:
                                                set sd_id_node to get_json_object_value(sd_root and "id")
                                                set sd_reason_node to get_json_object_value(sd_root and "reason")
                                                if sd_id_node != 0:
                                                    set sess_id to get_json_value(sd_id_node)
                                                if sd_reason_node != 0:
                                                    set sd_reason to string_trim(get_json_value(sd_reason_node))
                                            if rights_session_id_safe(sess_id) == 0 or else string_length(sd_reason) == 0:
                                                set resp to "session:error,reason:delete_requires_json_id_and_reason"
                                            else:
                                                set sessions_mgr to map_get_val(agent_ctx and "sessions")
                                                set sd_sessions to map_get_val(sessions_mgr and "sessions")
                                                if map_contains(sd_sessions and sess_id) == 0:
                                                    set resp to "session:error,reason:not_found"
                                                else:
                                                    set sd_path to concat("config/sessions/" and concat(sess_id and ".json"))
                                                    set sd_summary to concat("Maria requests deletion of session " and concat(sess_id and concat(". Reason: " and sd_reason)))
                                                    set sd_change to rights_prepare_change(storage_get_db() and "core" and "session_delete" and sess_id and sd_summary and rights_file_hash(sd_path) and ep_sha256("session_deleted") and sd_reason and sess_id)
                                                    if string_length(sd_change) == 0 or else rights_mark_human_authorized(storage_get_db() and sd_change) != 0:
                                                        set resp to "session:error,reason:rights_manifest_failed"
                                                    else:
                                                        set sd_gate to rights_gate_change(storage_get_db() and sd_change)
                                                        if sd_gate equals "ALLOWED" == 0:
                                                            set resp to concat("session:delete_pending,change_id:" and concat(sd_change and concat(",detail:" and sd_gate)))
                                                        else if rights_archive_session_traces(storage_get_db() and sess_id) != 0:
                                                            set resp to "session:error,reason:reasoning_archive_failed"
                                                        else:
                                                            set sd_bundle to rights_create_session_bundle(storage_get_db() and sess_id and sd_change)
                                                            set sd_pre_hash to rights_bundle_state_hash(storage_get_db() and sd_bundle)
                                                            if string_length(sd_bundle) == 0 or else string_length(sd_pre_hash) != 64:
                                                                set resp to "session:error,reason:verified_recovery_required"
                                                            else:
                                                                set ok to session_manager_delete(sessions_mgr and sess_id)
                                                                if ok == 1:
                                                                    if rights_mark_applied(storage_get_db() and sd_change and ep_sha256("session_deleted")) != 0:
                                                                        set resp to "session:error,reason:deleted_but_ledger_failed"
                                                                    else:
                                                                        set resp to concat("session:delete_ok,id:" and concat(sess_id and concat(",bundle:" and sd_bundle)))
                                                                else:
                                                                    set resp to "session:error,reason:delete_failed"
                                        else if string_contains(cmd_upper and "SESSION REOPEN ") == 1:
                                            set sr_json to substring(cmd and 15 and string_length(cmd) - 15)
                                            set sr_root to json_parse(sr_json)
                                            set sr_id to ""
                                            set sr_reason to ""
                                            if sr_root != 0:
                                                set sr_id_node to get_json_object_value(sr_root and "id")
                                                set sr_reason_node to get_json_object_value(sr_root and "reason")
                                                if sr_id_node != 0:
                                                    set sr_id to get_json_value(sr_id_node)
                                                if sr_reason_node != 0:
                                                    set sr_reason to get_json_value(sr_reason_node)
                                            set resp to rights_session_reopen(storage_get_db() and sr_id and sr_reason)
                                        else if cmd_upper equals "AGENT GET MEMORY":
                                            set resp to serialize_memory_json(cast_borrow_to_map(agent_memory))
                                        else if cmd_upper equals "AGENT GET GRID":
                                            set resp to serialize_grid_json(map_get_val(agent_ctx and "turing_grid"))
                                        else if cmd_upper equals "AGENT DECAY MEMORY":
                                            # Consolidate + decay the Hebbian synapse weights, persist, and
                                            # return the updated memory graph so the UI refreshes.
                                            set dk to memory_decay_synapses(cast_borrow_to_map(agent_memory))
                                            set ser_err to memory_serialize(cast_borrow_to_map(agent_memory) and "config/agent_memory.json")
                                            set resp to serialize_memory_json(cast_borrow_to_map(agent_memory))
                                        else if cmd_upper equals "AI AUTONOMY":
                                            set ok to lock_mutex(AGENT_RUN_LOCK)
                                            set agent_resp to react_run(cast_borrow_to_map(agent_model) and cast_borrow_to_map(agent_memory) and cast_borrow_to_map(agent_tools) and cast_borrow_to_map(agent_ctx) and "Maintain state and execute background optimizations")
                                            set ok to unlock_mutex(AGENT_RUN_LOCK)
                                            set ser_err to memory_serialize(cast_borrow_to_map(agent_memory) and "config/agent_memory.json")
                                            set resp to f"ai:ok|||RESPONSE|||{agent_resp}"
                                        else:
                                            if string_contains(cmd_upper and "MONEY TRANSFER ") == 1:
                                                # Parse: MONEY TRANSFER <amount> <recipient>
                                                set xfer_args to substring(cmd and 15 and string_length(cmd) - 15)
                                                set space_pos to string_index_of(xfer_args and " ")
                                                if space_pos > 0:
                                                    set amt_str to substring(xfer_args and 0 and space_pos)
                                                    set recipient to substring(xfer_args and space_pos + 1 and string_length(xfer_args) - space_pos - 1)
                                                    set amount to string_to_int(amt_str)
                                                    set sign_pub to ptr_to_str(map_get_val(identity and "signing_public_key"))
                                                    set sender_bal to ledger_get_balance(cast_borrow_to_map(ledger) and sign_pub)
                                                    if amount > sender_bal:
                                                        set resp to f"transfer:error,reason:insufficient_balance,balance:{sender_bal},requested:{amount}"
                                                    else:
                                                        if amount <= 0:
                                                            set resp to "transfer:error,reason:invalid_amount"
                                                        else:
                                                            # Find spendable UTXOs for sender
                                                            set utxos to map_get_val(ledger and "utxos")
                                                            set utxo_keys to map_keys(utxos)
                                                            set inputs to create_list()
                                                            set input_total to 0
                                                            set uk_idx to 0
                                                            set uk_len to length_list(utxo_keys)
                                                            repeat while uk_idx < uk_len and input_total < amount:
                                                                set ukey to get_list(utxo_keys and uk_idx)
                                                                set utxo_entry to map_get_val(utxos and ukey)
                                                                set utxo_recip to map_get_val(utxo_entry and "recipient")
                                                                if utxo_recip equals sign_pub:
                                                                    # Parse UTXO key "tx_id:output_index"
                                                                    set colon_pos to string_index_of(ukey and ":")
                                                                    set ref_tx_id to substring(ukey and 0 and colon_pos)
                                                                    set ref_idx_str to substring(ukey and colon_pos + 1 and string_length(ukey) - colon_pos - 1)
                                                                    set ref_idx to string_to_int(ref_idx_str)
                                                                    set ref_amt to map_get_val(utxo_entry and "amount")
                                                                    set input_ref to create_map()
                                                                    set ok to map_insert(input_ref and "tx_id" and ref_tx_id)
                                                                    set ok to map_insert(input_ref and "output_index" and ref_idx)
                                                                    set ok to map_insert(input_ref and "amount" and ref_amt)
                                                                    set ok to map_insert(input_ref and "owner" and sign_pub)
                                                                    # Placeholder sig — will be replaced after tx_id is known
                                                                    set ok to map_insert(input_ref and "signature" and "pending")
                                                                    set ok to append_list(inputs and input_ref)
                                                                    set input_total to input_total + ref_amt
                                                                set uk_idx to uk_idx + 1
                                                            free_list(utxo_keys)
                                                            if input_total < amount:
                                                                set resp to f"transfer:error,reason:utxo_insufficient,found:{input_total},needed:{amount}"
                                                            else:
                                                                # Build outputs
                                                                set outputs to create_list()
                                                                set out1 to create_map()
                                                                set ok to map_insert(out1 and "recipient" and recipient)
                                                                set ok to map_insert(out1 and "amount" and amount)
                                                                set ok to append_list(outputs and out1)
                                                                set remaining to input_total - amount
                                                                if remaining > 0:
                                                                    set out2 to create_map()
                                                                    set ok to map_insert(out2 and "recipient" and sign_pub)
                                                                    set ok to map_insert(out2 and "amount" and remaining)
                                                                    set ok to append_list(outputs and out2)
                                                                # Create tx and compute its ID
                                                                set tx to ledger_create_tx(inputs and outputs and 0)
                                                                set tx_hash to ledger_hash_tx(tx)
                                                                # Now sign each input with the real tx_id
                                                                set sign_sec to ptr_to_str(map_get_val(identity and "signing_secret_key"))
                                                                set in_count to length_list(inputs)
                                                                set si to 0
                                                                repeat while si < in_count:
                                                                    set inp to get_list(inputs and si)
                                                                    set sig_result to sign_message(tx_hash and sign_sec)
                                                                    set sig_hex to ptr_to_str(map_get_val(sig_result and "signature"))
                                                                    set ok to map_insert(inp and "signature" and sig_hex)
                                                                    set si to si + 1
                                                                # Commit: add block with this transaction
                                                                set tx_list to create_list()
                                                                set ok to append_list(tx_list and tx)
                                                                # Compute the actual block hash the same way ledger_add_block does:
                                                                # block_hash = SHA256(merkle_root(tx_hashes) + prev_block_hash)
                                                                set tx_hash_list to create_list()
                                                                set ok to append_list(tx_hash_list and tx_hash)
                                                                set merkle_root to calculate_merkle_root(tx_hash_list)
                                                                free_list(tx_hash_list)
                                                                set blocks to map_get_val(ledger and "blocks")
                                                                set prev_block to get_list(blocks and length_list(blocks) - 1)
                                                                set prev_hash to ptr_to_str(map_get_val(prev_block and "hash"))
                                                                set state_root to ledger_compute_state_root()
                                                                set block_hash to ledger_compute_block_hash(merkle_root and prev_hash and state_root)
                                                                # Sign the block hash for validator proof
                                                                set block_sig_result to sign_message(block_hash and sign_sec)
                                                                set block_sig_hex to ptr_to_str(map_get_val(block_sig_result and "signature"))
                                                                set block_err to ledger_add_block(cast_borrow_to_map(ledger) and tx_list and sign_pub and block_sig_hex and state_root)
                                                                if block_err == 0:
                                                                    # F2: gossip the freshly-produced block to peers over the
                                                                    # authenticated Noise channel (non-blocking; the receiver
                                                                    # applies it via ledger_receive_block with fork-choice).
                                                                    # Serialize the tip block HERE, on the IPC thread that owns the
                                                                    # ledger, and hand the spawned thread only the wire string — so
                                                                    # the broadcast never reads the shared ledger map cross-thread
                                                                    # (that raced the GC and could corrupt the heap).
                                                                    set bcast_blocks to map_get_val(cast_borrow_to_map(ledger) and "blocks")
                                                                    set bcast_tip to get_list(bcast_blocks and length_list(bcast_blocks) - 1)
                                                                    set bcast_wire to ledger_serialize_block(bcast_tip)
                                                                    spawn broadcast_block_to_peers(bcast_wire and dht_node and static_secret and static_public)
                                                                    set new_bal to ledger_get_balance(cast_borrow_to_map(ledger) and sign_pub)
                                                                    set resp to f"transfer:ok,tx_id:{tx_hash},amount:{amount},to:{recipient},new_balance:{new_bal}"
                                                                else:
                                                                    set resp to f"transfer:error,reason:block_rejected,code:{block_err}"
                                                else:
                                                    set resp to "transfer:error,reason:invalid_format,expected:MONEY TRANSFER <amount> <recipient>"
                                            else:
                                                if string_contains(cmd_upper and "MONEY SWAP") == 1:
                                                    # Swap tokens via the DEX
                                                    # Parse: MONEY SWAP <from_token> <to_token> <amount>
                                                    set swap_args to substring(cmd and 11 and string_length(cmd) - 11)
                                                    set swap_parts to string_split(swap_args and " ")
                                                    set sp_len to length_list(swap_parts)
                                                    if sp_len >= 3:
                                                        set from_tok to get_list(swap_parts and 0)
                                                        set to_tok to get_list(swap_parts and 1)
                                                        set swap_amt_str to get_list(swap_parts and 2)
                                                        set swap_amt to string_to_int(swap_amt_str)
                                                        if swap_amt <= 0:
                                                            set resp to "swap:error,reason:invalid_amount"
                                                        else:
                                                            set dex_engine to map_get_val(agent_ctx and "dex_engine")
                                                            set deployed_tokens to map_get_val(agent_ctx and "deployed_tokens")
                                                            set from_token_map to map_get_val(deployed_tokens and from_tok)
                                                            set to_token_map to map_get_val(deployed_tokens and to_tok)
                                                            if from_token_map == 0 or else to_token_map == 0:
                                                                set resp to f"swap:error,reason:unsupported_tokens,from:{from_tok},to:{to_tok}"
                                                            else:
                                                                set is_from_less to 1
                                                                if from_tok equals "USDT":
                                                                    set is_from_less to 0
                                                                set token_a to from_token_map
                                                                set token_b to to_token_map
                                                                if is_from_less == 0:
                                                                    set token_a to to_token_map
                                                                    set token_b to from_token_map
                                                                set caller_did to ptr_to_str(map_get_val(identity and "did"))
                                                                set swap_err to dex_swap_amm(dex_engine and token_a and token_b and swap_amt and caller_did)
                                                                if swap_err == 0:
                                                                    set bal_from to token_balance_of(from_token_map and caller_did)
                                                                    set bal_to to token_balance_of(to_token_map and caller_did)
                                                                    set resp to f"swap:ok,from:{from_tok},to:{to_tok},amount:{swap_amt},new_balance_from:{bal_from},new_balance_to:{bal_to}"
                                                                else:
                                                                    set resp to f"swap:error,reason:swap_failed,code:{swap_err}"
                                                    else:
                                                        set resp to "swap:error,reason:invalid_format,expected:MONEY SWAP <from> <to> <amount>"
                                                else:
                                                    if string_contains(cmd_upper and "NAME REGISTER ") == 1:
                                                        set name_arg to substring(cmd and 14 and string_length(cmd) - 14)
                                                        set did_val to ptr_to_str(map_get_val(identity and "did"))
                                                        set name_sign_pub to ptr_to_str(map_get_val(identity and "signing_public_key"))
                                                        set name_sign_sec to ptr_to_str(map_get_val(identity and "signing_secret_key"))
                                                        set reg_err to registry_register(name_reg and name_arg and did_val and dht_node and seed_addr and seed_port and name_sign_pub and name_sign_sec)
                                                        if reg_err == 0:
                                                            set resp to f"name:registered,name:{name_arg},did:{did_val}"
                                                        else:
                                                            set resp to f"name:error,reason:registration_failed,code:{reg_err}"
                                                    else:
                                                        if string_contains(cmd_upper and "NAME RESOLVE ") == 1:
                                                            set resolve_name to substring(cmd and 13 and string_length(cmd) - 13)
                                                            set resolved_did to registry_resolve(name_reg and resolve_name and dht_node and seed_addr and seed_port)
                                                            if string_length(resolved_did) > 0:
                                                                set resp to f"name:resolved,name:{resolve_name},did:{resolved_did}"
                                                            else:
                                                                set resp to f"name:not_found,name:{resolve_name}"
                                                        else:
                                                            if string_contains(cmd_upper and "DHT STORE ") == 1:
                                                                set dht_args to substring(cmd and 10 and string_length(cmd) - 10)
                                                                set dht_space to string_index_of(dht_args and " ")
                                                                if dht_space > 0:
                                                                    set dht_key to substring(dht_args and 0 and dht_space)
                                                                    set dht_value to substring(dht_args and dht_space + 1 and string_length(dht_args) - dht_space - 1)
                                                                    set store_err to dht_node_store_value(dht_node and dht_key and dht_value)
                                                                    set resp to f"dht:stored,key:{dht_key}"
                                                                else:
                                                                    set resp to "dht:error,reason:invalid_format"
                                                            else:
                                                                if string_contains(cmd_upper and "DHT GET ") == 1:
                                                                    set dht_key to substring(cmd and 8 and string_length(cmd) - 8)
                                                                    set dht_lookup to dht_lookup_value(dht_node and dht_key)
                                                                    set dht_err to map_get_val(dht_lookup and "error")
                                                                    if dht_err == 0:
                                                                        set dht_val to ptr_to_str(map_get_val(dht_lookup and "value"))
                                                                        set resp to f"dht:found,key:{dht_key},value:{dht_val}"
                                                                    else:
                                                                        set resp to f"dht:not_found,key:{dht_key}"
                                                                    free_map(dht_lookup)
                                                                else if string_contains(cmd_upper and "GITDEC REPO CREATE ") == 1:
                                                                    set create_args to substring(cmd and 19 and string_length(cmd) - 19)
                                                                    set space_pos to string_index_of(create_args and " ")
                                                                    if space_pos > 0:
                                                                        set repo_id to substring(create_args and 0 and space_pos)
                                                                        set name to substring(create_args and space_pos + 1 and string_length(create_args) - space_pos - 1)
                                                                        set did_val to ptr_to_str(map_get_val(identity and "did"))
                                                                        set manifest to gitdec_create_repo(repo_id and name and did_val)
                                                                        # Publish repo to DHT
                                                                        set dht_key to concat("repo:" and repo_id)
                                                                        set store_err to dht_node_store_value(dht_node and dht_key and did_val)
                                                                        
                                                                        # Broadcast manifest to Nostr
                                                                        set sign_sec to ptr_to_str(map_get_val(identity and "signing_secret_key"))
                                                                        set sign_pub to ptr_to_str(map_get_val(identity and "signing_public_key"))
                                                                        set manifest_str to gitdec_serialize_manifest(manifest)
                                                                        set esc_manifest to escape_json_string(manifest_str)
                                                                        set content_json to "{"
                                                                        set content_json to concat(content_json and f"\"action\":\"update_manifest\",\"repo_id\":\"{repo_id}\",\"manifest\":\"{esc_manifest}\"")
                                                                        set content_json to concat(content_json and "}")
                                                                        set br_err to gitdec_broadcast_nostr(repo_id and 20020 and content_json and sign_sec and sign_pub)
                                                                        
                                                                        set resp to f"gitdec:repo_created,id:{repo_id}"
                                                                    else:
                                                                        set resp to "gitdec:error,reason:invalid_format"
                                                                else if string_contains(cmd_upper and "GITDEC REPO IMPORT ") == 1:
                                                                    # Import an existing local folder as a GitDec repo.
                                                                    # Format: GITDEC REPO IMPORT <name>|<absolute_source_path>
                                                                    # (| delimiter because paths contain spaces and slashes).
                                                                    set imp_args to string_trim(substring(cmd and 19 and string_length(cmd) - 19))
                                                                    set bar_pos to string_index_of(imp_args and "|")
                                                                    if bar_pos <= 0:
                                                                        set resp to "gitdec:error,reason:invalid_format (use name|/abs/path)"
                                                                    else:
                                                                        set imp_name to string_trim(substring(imp_args and 0 and bar_pos))
                                                                        set imp_path to string_trim(substring(imp_args and bar_pos + 1 and string_length(imp_args) - bar_pos - 1))
                                                                        if gitdec_repo_id_safe(imp_name) == 0:
                                                                            set resp to "gitdec:error,reason:invalid_repo_name (use letters, digits, _ or -)"
                                                                        else if file_exists(imp_path) == 0:
                                                                            set resp to concat("gitdec:error,reason:source_not_found:" and imp_path)
                                                                        else:
                                                                            set imp_did to ptr_to_str(map_get_val(identity and "did"))
                                                                            set imp_manifest to gitdec_create_repo(imp_name and imp_name and imp_did)
                                                                            # Copy the folder's working files into the repo dir, skipping VCS
                                                                            # state and build artifacts (keeps the repo to source only).
                                                                            set imp_dest to concat("config/gitdec/repos/" and imp_name)
                                                                            # Shell-escape single quotes in the source path before wrapping it in
                                                                            # '...' for rsync. Without this, a path containing a quote (e.g.
                                                                            # dir'; rm -rf ~; ') breaks out of the quoting into arbitrary shell
                                                                            # execution. The '\'' idiom closes, emits an escaped quote, reopens.
                                                                            set imp_path_safe to string_replace(imp_path and "'" and "'\\''")
                                                                            set imp_rcmd to concat("rsync -a --exclude '.git' --exclude 'target' --exclude 'node_modules' --exclude '*.dSYM' --exclude '*_compiled.c' --exclude '.DS_Store' --exclude '*.tar.gz' --exclude 'node' '" and imp_path_safe)
                                                                            set imp_rcmd to concat(imp_rcmd and "/' '")
                                                                            set imp_rcmd to concat(imp_rcmd and imp_dest)
                                                                            set imp_rcmd to concat(imp_rcmd and "/' 2>&1")
                                                                            set imp_ce to run_command(imp_rcmd)
                                                                            # Publish to the DHT + broadcast the manifest (same as CREATE).
                                                                            set imp_dht_key to concat("repo:" and imp_name)
                                                                            set imp_store_err to dht_node_store_value(dht_node and imp_dht_key and imp_did)
                                                                            set imp_sign_sec to ptr_to_str(map_get_val(identity and "signing_secret_key"))
                                                                            set imp_sign_pub to ptr_to_str(map_get_val(identity and "signing_public_key"))
                                                                            set imp_mstr to gitdec_serialize_manifest(imp_manifest)
                                                                            set imp_emstr to escape_json_string(imp_mstr)
                                                                            set imp_cjson to "{"
                                                                            set imp_cjson to concat(imp_cjson and f"\"action\":\"update_manifest\",\"repo_id\":\"{imp_name}\",\"manifest\":\"{imp_emstr}\"")
                                                                            set imp_cjson to concat(imp_cjson and "}")
                                                                            set imp_br_err to gitdec_broadcast_nostr(imp_name and 20020 and imp_cjson and imp_sign_sec and imp_sign_pub)
                                                                            set imp_fcount to length_list(gitdec_list_repo_files(imp_name))
                                                                            set resp to f"gitdec:import_ok,id:{imp_name},files:{imp_fcount}"
                                                                else if string_contains(cmd_upper and "GITDEC REPO CLONE ") == 1:
                                                                    set repo_id to substring(cmd and 18 and string_length(cmd) - 18)
                                                                    set dht_key to concat("repo:" and repo_id)
                                                                    set dht_lookup to dht_lookup_value(dht_node and dht_key)
                                                                    set dht_err to map_get_val(dht_lookup and "error")
                                                                    set owner_did to ""
                                                                    if dht_err == 0:
                                                                        set owner_did to ptr_to_str(map_get_val(dht_lookup and "value"))
                                                                    free_map(dht_lookup)
                                                                    if string_length(owner_did) == 0:
                                                                        set resp to "gitdec:error,reason:provider_not_found"
                                                                    else:
                                                                        set manifest to gitdec_create_repo(repo_id and repo_id and owner_did)
                                                                        set ok to gitdec_request_history(repo_id)
                                                                        set resp to "gitdec:clone_ok"
                                                                else if string_contains(cmd_upper and "GITDEC AUTOUPDATE ") == 1:
                                                                    set au_args to substring(cmd and 18 and string_length(cmd) - 18)
                                                                    set au_space to string_index_of(au_args and " ")
                                                                    if au_space > 0:
                                                                        set au_repo to substring(au_args and 0 and au_space)
                                                                        set au_flag to string_to_int(substring(au_args and au_space + 1 and string_length(au_args) - au_space - 1))
                                                                        set au_ok to storage_gitdec_set_auto_update(au_repo and au_flag)
                                                                        set resp to "gitdec:autoupdate_set"
                                                                    else:
                                                                        set resp to "gitdec:error,reason:bad_args"
                                                                else if string_contains(cmd_upper and "GITDEC GET_AUTOUPDATE ") == 1:
                                                                    set gau_repo to substring(cmd and 22 and string_length(cmd) - 22)
                                                                    set gau_flag to storage_gitdec_get_auto_update(gau_repo)
                                                                    set resp to concat("gitdec:autoupdate,enabled:" and int_to_string(gau_flag))
                                                                else if string_contains(cmd_upper and "GITDEC REPO LIST_FILES ") == 1:
                                                                    set repo_id to substring(cmd and 23 and string_length(cmd) - 23)
                                                                    set files_list to gitdec_list_repo_files(repo_id)
                                                                    set f_count to length_list(files_list)
                                                                    set list_str to ""
                                                                    set fi to 0
                                                                    repeat while fi < f_count:
                                                                        set f_name to get_list(files_list and fi)
                                                                        set list_str to concat(list_str and f_name)
                                                                        if fi < f_count - 1:
                                                                            set list_str to concat(list_str and ";")
                                                                        set fi to fi + 1
                                                                    set resp to f"gitdec:repo_files,repo_id:{repo_id},files:{list_str}"
                                                                    free_list(files_list)
                                                                else if string_contains(cmd_upper and "GITDEC REPO LIST") == 1:
                                                                    set repos_list to gitdec_list_repos()
                                                                    set r_count to length_list(repos_list)
                                                                    set list_str to ""
                                                                    set ri to 0
                                                                    repeat while ri < r_count:
                                                                        set r_id to get_list(repos_list and ri)
                                                                        set r_vis to "public"
                                                                        if gitdec_repo_is_private(r_id) == 1:
                                                                            set r_vis to "private"
                                                                        set list_str to concat(list_str and concat(r_id and concat(":" and r_vis)))
                                                                        if ri < r_count - 1:
                                                                            set list_str to concat(list_str and ";")
                                                                        set ri to ri + 1
                                                                    set resp to f"gitdec:repo_list,repos:{list_str}"
                                                                    free_list(repos_list)
                                                                else if string_contains(cmd_upper and "GITDEC REPO SETVIS ") == 1:
                                                                    set sv_args to string_trim(substring(cmd and 19 and string_length(cmd) - 19))
                                                                    set sv_space to string_index_of(sv_args and " ")
                                                                    if sv_space <= 0:
                                                                        set resp to "gitdec:error,reason:invalid_format"
                                                                    else:
                                                                        set sv_repo to string_trim(substring(sv_args and 0 and sv_space))
                                                                        set sv_vis to string_trim(substring(sv_args and sv_space + 1 and string_length(sv_args) - sv_space - 1))
                                                                        set sv_did to ptr_to_str(map_get_val(identity and "did"))
                                                                        set sv_err to gitdec_set_visibility(sv_repo and sv_did and sv_vis)
                                                                        if sv_err == 0:
                                                                            set sv_sec to ptr_to_str(map_get_val(identity and "signing_secret_key"))
                                                                            set sv_pub to ptr_to_str(map_get_val(identity and "signing_public_key"))
                                                                            set sv_mpath to concat(concat("config/gitdec/repos/" and sv_repo) and "/gitdec.json")
                                                                            set sv_manifest to gitdec_load_json(sv_mpath)
                                                                            set sv_mstr to gitdec_serialize_manifest(sv_manifest)
                                                                            set sv_emstr to escape_json_string(sv_mstr)
                                                                            set sv_cjson to "{"
                                                                            set sv_cjson to concat(sv_cjson and f"\"action\":\"update_manifest\",\"repo_id\":\"{sv_repo}\",\"manifest\":\"{sv_emstr}\"")
                                                                            set sv_cjson to concat(sv_cjson and "}")
                                                                            set sv_br to gitdec_broadcast_nostr(sv_repo and 20020 and sv_cjson and sv_sec and sv_pub)
                                                                            set resp to concat("gitdec:setvis_ok,visibility:" and sv_vis)
                                                                        else:
                                                                            set resp to "gitdec:error,reason:setvis_failed"
                                                                else if string_contains(cmd_upper and "GITDEC REPO GET_FILE ") == 1:
                                                                    set file_args to substring(cmd and 21 and string_length(cmd) - 21)
                                                                    set space_pos to string_index_of(file_args and " ")
                                                                    if space_pos > 0:
                                                                        set repo_id to substring(file_args and 0 and space_pos)
                                                                        set filename to substring(file_args and space_pos + 1 and string_length(file_args) - space_pos - 1)
                                                                        set file_content to gitdec_get_repo_file(repo_id and filename)
                                                                        set resp to f"gitdec:file_data,payload:{file_content}"
                                                                    else:
                                                                        set resp to "gitdec:error,reason:invalid_format"
                                                                else if string_contains(cmd_upper and "GITDEC REPO RESOLVE ") == 1:
                                                                    set repo_id to substring(cmd and 20 and string_length(cmd) - 20)
                                                                    set dht_key to concat("repo:" and repo_id)
                                                                    set dht_lookup to dht_lookup_value(dht_node and dht_key)
                                                                    set dht_err to map_get_val(dht_lookup and "error")
                                                                    if dht_err == 0:
                                                                        set provider_did to ptr_to_str(map_get_val(dht_lookup and "value"))
                                                                        set resp to f"gitdec:provider_found,provider:{provider_did}"
                                                                    else:
                                                                        set resp to "gitdec:provider_not_found"
                                                                    free_map(dht_lookup)
                                                                else if string_contains(cmd_upper and "GITDEC REPO COLLAB ADD ") == 1:
                                                                    set collab_args to substring(cmd and 24 and string_length(cmd) - 24)
                                                                    set first_space to string_index_of(collab_args and " ")
                                                                    if first_space > 0:
                                                                        set repo_id to substring(collab_args and 0 and first_space)
                                                                        set rem_args to substring(collab_args and first_space + 1 and string_length(collab_args) - first_space - 1)
                                                                        set second_space to string_index_of(rem_args and " ")
                                                                        if second_space > 0:
                                                                            set collab_did to substring(rem_args and 0 and second_space)
                                                                            set role to substring(rem_args and second_space + 1 and string_length(rem_args) - second_space - 1)
                                                                            set did_val to ptr_to_str(map_get_val(identity and "did"))
                                                                            set err to gitdec_add_collaborator(repo_id and did_val and collab_did and role)
                                                                            if err == 0:
                                                                                # Broadcast updated manifest to Nostr
                                                                                set manifest_path to path_join(concat("config/gitdec/repos/" and repo_id) and "gitdec.json")
                                                                                set manifest to gitdec_load_json(manifest_path)
                                                                                if manifest != 0:
                                                                                    set manifest_str to gitdec_serialize_manifest(manifest)
                                                                                    set esc_manifest to escape_json_string(manifest_str)
                                                                                    set sign_sec to ptr_to_str(map_get_val(identity and "signing_secret_key"))
                                                                                    set sign_pub to ptr_to_str(map_get_val(identity and "signing_public_key"))
                                                                                    set content_json to "{"
                                                                                    set content_json to concat(content_json and f"\"action\":\"update_manifest\",\"repo_id\":\"{repo_id}\",\"manifest\":\"{esc_manifest}\"")
                                                                                    set content_json to concat(content_json and "}")
                                                                                    set br_err to gitdec_broadcast_nostr(repo_id and 20020 and content_json and sign_sec and sign_pub)
                                                                                    free_map(manifest)
                                                                                set resp to "gitdec:collab_added"
                                                                            else:
                                                                                set resp to f"gitdec:error,code:{err}"
                                                                        else:
                                                                            set resp to "gitdec:error,reason:invalid_format"
                                                                    else:
                                                                        set resp to "gitdec:error,reason:invalid_format"
                                                                else if string_contains(cmd_upper and "GITDEC REPO COLLAB REMOVE ") == 1:
                                                                    set collab_args to substring(cmd and 26 and string_length(cmd) - 26)
                                                                    set first_space to string_index_of(collab_args and " ")
                                                                    if first_space > 0:
                                                                        set repo_id to substring(collab_args and 0 and first_space)
                                                                        set collab_did to substring(collab_args and first_space + 1 and string_length(collab_args) - first_space - 1)
                                                                        set did_val to ptr_to_str(map_get_val(identity and "did"))
                                                                        set err to gitdec_remove_collaborator(repo_id and did_val and collab_did)
                                                                        if err == 0:
                                                                            # Broadcast updated manifest to Nostr
                                                                            set manifest_path to path_join(concat("config/gitdec/repos/" and repo_id) and "gitdec.json")
                                                                            set manifest to gitdec_load_json(manifest_path)
                                                                            if manifest != 0:
                                                                                set manifest_str to gitdec_serialize_manifest(manifest)
                                                                                set esc_manifest to escape_json_string(manifest_str)
                                                                                set sign_sec to ptr_to_str(map_get_val(identity and "signing_secret_key"))
                                                                                set sign_pub to ptr_to_str(map_get_val(identity and "signing_public_key"))
                                                                                set content_json to "{"
                                                                                set content_json to concat(content_json and f"\"action\":\"update_manifest\",\"repo_id\":\"{repo_id}\",\"manifest\":\"{esc_manifest}\"")
                                                                                set content_json to concat(content_json and "}")
                                                                                set br_err to gitdec_broadcast_nostr(repo_id and 20020 and content_json and sign_sec and sign_pub)
                                                                                free_map(manifest)
                                                                            set resp to "gitdec:collab_removed"
                                                                        else:
                                                                            set resp to f"gitdec:error,code:{err}"
                                                                    else:
                                                                        set resp to "gitdec:error,reason:invalid_format"
                                                                else if string_contains(cmd_upper and "GITDEC REPO DELETE ") == 1:
                                                                    set repo_id to substring(cmd and 19 and string_length(cmd) - 19)
                                                                    set did_val to ptr_to_str(map_get_val(identity and "did"))
                                                                    set err to gitdec_delete_repo(repo_id and did_val)
                                                                    if err == 0:
                                                                        # Broadcast deletion to Nostr
                                                                        set sign_sec to ptr_to_str(map_get_val(identity and "signing_secret_key"))
                                                                        set sign_pub to ptr_to_str(map_get_val(identity and "signing_public_key"))
                                                                        set content_json to "{"
                                                                        set content_json to concat(content_json and f"\"action\":\"delete_repo\",\"repo_id\":\"{repo_id}\"")
                                                                        set content_json to concat(content_json and "}")
                                                                        set br_err to gitdec_broadcast_nostr(repo_id and 20020 and content_json and sign_sec and sign_pub)
                                                                        set resp to "gitdec:deleted"
                                                                    else:
                                                                        set resp to f"gitdec:error,code:{err}"
                                                                else if string_contains(cmd_upper and "GITDEC REPO PUSH_JSON ") == 1:
                                                                    set json_str to substring(cmd and 22 and string_length(cmd) - 22)
                                                                    set root_node to json_parse(json_str)
                                                                    if root_node != 0:
                                                                        set repo_id_node to get_json_object_value(root_node and "repo_id")
                                                                        set branch_node to get_json_object_value(root_node and "branch")
                                                                        set commit_hash_node to get_json_object_value(root_node and "commit_hash")
                                                                        set payload_node to get_json_object_value(root_node and "payload")
                                                                        set signature_node to get_json_object_value(root_node and "signature")
                                                                        set repo_id to get_json_value(repo_id_node)
                                                                        set branch to get_json_value(branch_node)
                                                                        set commit_hash to get_json_value(commit_hash_node)
                                                                        set payload to get_json_value(payload_node)
                                                                        set signature to get_json_value(signature_node)
                                                                        set did_val to ptr_to_str(map_get_val(identity and "did"))
                                                                        set err to gitdec_push_commit(repo_id and did_val and branch and commit_hash and payload and signature)
                                                                        if err == 0:
                                                                            # 1. Broadcast push to Nostr (Kind 20021)
                                                                            set sign_sec to ptr_to_str(map_get_val(identity and "signing_secret_key"))
                                                                            set sign_pub to ptr_to_str(map_get_val(identity and "signing_public_key"))
                                                                            set esc_payload to escape_json_string(payload)
                                                                            set esc_sig to escape_json_string(signature)
                                                                            set content_json to "{"
                                                                            set content_json to concat(content_json and f"\"action\":\"push_commit\",\"repo_id\":\"{repo_id}\",\"branch\":\"{branch}\",\"commit_hash\":\"{commit_hash}\",\"pusher_did\":\"{did_val}\",\"payload\":\"{esc_payload}\",\"signature\":\"{esc_sig}\"")
                                                                            set content_json to concat(content_json and "}")
                                                                            set br_err to gitdec_broadcast_nostr(repo_id and 20021 and content_json and sign_sec and sign_pub)
                                                                            
                                                                            # 2. Broadcast updated manifest to Nostr (Kind 20020)
                                                                            set manifest_path to path_join(concat("config/gitdec/repos/" and repo_id) and "gitdec.json")
                                                                            set manifest to gitdec_load_json(manifest_path)
                                                                            if manifest != 0:
                                                                                set manifest_str to gitdec_serialize_manifest(manifest)
                                                                                set esc_manifest to escape_json_string(manifest_str)
                                                                                set content_json2 to "{"
                                                                                set content_json2 to concat(content_json2 and f"\"action\":\"update_manifest\",\"repo_id\":\"{repo_id}\",\"manifest\":\"{esc_manifest}\"")
                                                                                set content_json2 to concat(content_json2 and "}")
                                                                                set br_err2 to gitdec_broadcast_nostr(repo_id and 20020 and content_json2 and sign_sec and sign_pub)
                                                                                free_map(manifest)
                                                                                
                                                                            set resp to "gitdec:push_ok"
                                                                        else:
                                                                            set resp to f"gitdec:error,code:{err}"
                                                                    else:
                                                                        set resp to "gitdec:error,reason:invalid_json"
                                                                else if string_contains(cmd_upper and "GITDEC MERGE ") == 1:
                                                                    set mg_args to substring(cmd and 13 and string_length(cmd) - 13)
                                                                    set mg_sp to string_index_of(mg_args and " ")
                                                                    if mg_sp > 0:
                                                                        set mg_repo to substring(mg_args and 0 and mg_sp)
                                                                        set mg_branch to substring(mg_args and mg_sp + 1 and string_length(mg_args) - mg_sp - 1)
                                                                        set mg_did to ptr_to_str(map_get_val(identity and "did"))
                                                                        set mg_head to gitdec_pull_ref(mg_repo and mg_branch)
                                                                        if string_length(mg_head) == 0:
                                                                            set resp to "gitdec:error,reason:branch_not_found"
                                                                        else:
                                                                            set mg_sec to ptr_to_str(map_get_val(identity and "signing_secret_key"))
                                                                            set mg_pub to ptr_to_str(map_get_val(identity and "signing_public_key"))
                                                                            set mg_msg to concat(mg_did and "|")
                                                                            set mg_msg to concat(mg_msg and mg_repo)
                                                                            set mg_msg to concat(mg_msg and "|")
                                                                            set mg_msg to concat(mg_msg and mg_branch)
                                                                            set mg_msg to concat(mg_msg and "|")
                                                                            set mg_msg to concat(mg_msg and mg_head)
                                                                            set mg_authsig_res to sign_message(mg_msg and mg_sec)
                                                                            set mg_authsig to ptr_to_str(map_get_val(mg_authsig_res and "signature"))
                                                                            set mg_err to gitdec_merge(mg_repo and mg_branch and mg_did and mg_authsig)
                                                                            if mg_err == 0:
                                                                                # Propagate main -> source_head so every node's main advances (no loss).
                                                                                set mg_payload to gitdec_get_object(mg_repo and mg_head)
                                                                                set mg_psig_res to sign_message(mg_payload and mg_sec)
                                                                                set mg_psig to ptr_to_str(map_get_val(mg_psig_res and "signature"))
                                                                                set mg_esc_payload to escape_json_string(mg_payload)
                                                                                set mg_esc_psig to escape_json_string(mg_psig)
                                                                                set mg_content to "{"
                                                                                set mg_content to concat(mg_content and f"\"action\":\"push_commit\",\"repo_id\":\"{mg_repo}\",\"branch\":\"main\",\"commit_hash\":\"{mg_head}\",\"pusher_did\":\"{mg_did}\",\"payload\":\"{mg_esc_payload}\",\"signature\":\"{mg_esc_psig}\"")
                                                                                set mg_content to concat(mg_content and "}")
                                                                                set mg_br to gitdec_broadcast_nostr(mg_repo and 20021 and mg_content and mg_sec and mg_pub)
                                                                                set mg_mpath to path_join(concat("config/gitdec/repos/" and mg_repo) and "gitdec.json")
                                                                                set mg_manifest to gitdec_load_json(mg_mpath)
                                                                                if mg_manifest != 0:
                                                                                    set mg_mstr to gitdec_serialize_manifest(mg_manifest)
                                                                                    set mg_esc_m to escape_json_string(mg_mstr)
                                                                                    set mg_content2 to "{"
                                                                                    set mg_content2 to concat(mg_content2 and f"\"action\":\"update_manifest\",\"repo_id\":\"{mg_repo}\",\"manifest\":\"{mg_esc_m}\"")
                                                                                    set mg_content2 to concat(mg_content2 and "}")
                                                                                    set mg_br2 to gitdec_broadcast_nostr(mg_repo and 20020 and mg_content2 and mg_sec and mg_pub)
                                                                                    free_map(mg_manifest)
                                                                                set resp to "gitdec:merge_ok"
                                                                            else:
                                                                                set resp to f"gitdec:error,code:{mg_err}"
                                                                    else:
                                                                        set resp to "gitdec:error,reason:bad_args"
                                                                else if string_contains(cmd_upper and "GITDEC REPO PULL ") == 1:
                                                                    set pull_args to substring(cmd and 17 and string_length(cmd) - 17)
                                                                    set space_pos to string_index_of(pull_args and " ")
                                                                    if space_pos > 0:
                                                                        set repo_id to substring(pull_args and 0 and space_pos)
                                                                        set branch to substring(pull_args and space_pos + 1 and string_length(pull_args) - space_pos - 1)
                                                                        set commit to gitdec_pull_ref(repo_id and branch)
                                                                        if string_length(commit) > 0:
                                                                            set resp to f"gitdec:pull_ok,commit:{commit}"
                                                                        else:
                                                                            set resp to "gitdec:pull_empty"
                                                                    else:
                                                                        set resp to "gitdec:error,reason:invalid_format"
                                                                else if string_contains(cmd_upper and "GITDEC REPO GET_OBJ ") == 1:
                                                                    set get_args to substring(cmd and 20 and string_length(cmd) - 20)
                                                                    set space_pos to string_index_of(get_args and " ")
                                                                    if space_pos > 0:
                                                                        set repo_id to substring(get_args and 0 and space_pos)
                                                                        set obj_hash to substring(get_args and space_pos + 1 and string_length(get_args) - space_pos - 1)
                                                                        set obj to gitdec_get_object(repo_id and obj_hash)
                                                                        if string_length(obj) > 0:
                                                                            set resp to f"gitdec:object_data,payload:{obj}"
                                                                        else:
                                                                            set resp to "gitdec:object_not_found"
                                                                    else:
                                                                        set resp to "gitdec:error,reason:invalid_format"
                                                                else if string_contains(cmd_upper and "GITDEC ISSUE CREATE_JSON ") == 1:
                                                                    set json_str to substring(cmd and 25 and string_length(cmd) - 25)
                                                                    set root_node to json_parse(json_str)
                                                                    if root_node != 0:
                                                                        set repo_id_node to get_json_object_value(root_node and "repo_id")
                                                                        set title_node to get_json_object_value(root_node and "title")
                                                                        set body_node to get_json_object_value(root_node and "body")
                                                                        set repo_id to get_json_value(repo_id_node)
                                                                        set title to get_json_value(title_node)
                                                                        set body to get_json_value(body_node)
                                                                        set did_val to ptr_to_str(map_get_val(identity and "did"))
                                                                        set issue to gitdec_create_issue(repo_id and did_val and title and body)
                                                                        set issue_id to map_get_val(issue and "id")
                                                                        # Broadcast to Nostr
                                                                        set sign_sec to ptr_to_str(map_get_val(identity and "signing_secret_key"))
                                                                        set sign_pub to ptr_to_str(map_get_val(identity and "signing_public_key"))
                                                                        set esc_title to escape_json_string(title)
                                                                        set esc_body to escape_json_string(body)
                                                                        set content_json to "{"
                                                                        set content_json to concat(content_json and f"\"action\":\"create_issue\",\"repo_id\":\"{repo_id}\",\"id\":\"{issue_id}\",\"author_did\":\"{did_val}\",\"title\":\"{esc_title}\",\"body\":\"{esc_body}\"")
                                                                        set content_json to concat(content_json and "}")
                                                                        set br_err to gitdec_broadcast_nostr(repo_id and 20022 and content_json and sign_sec and sign_pub)
                                                                        set resp to f"gitdec:issue_created,id:{issue_id}"
                                                                    else:
                                                                        set resp to "gitdec:error,reason:invalid_json"
                                                                else if string_contains(cmd_upper and "GITDEC ISSUE COMMENT_JSON ") == 1:
                                                                    set json_str to substring(cmd and 26 and string_length(cmd) - 26)
                                                                    set root_node to json_parse(json_str)
                                                                    if root_node != 0:
                                                                        set repo_id_node to get_json_object_value(root_node and "repo_id")
                                                                        set issue_id_node to get_json_object_value(root_node and "issue_id")
                                                                        set comment_node to get_json_object_value(root_node and "comment")
                                                                        set repo_id to get_json_value(repo_id_node)
                                                                        set issue_id to get_json_value(issue_id_node)
                                                                        set comment to get_json_value(comment_node)
                                                                        set did_val to ptr_to_str(map_get_val(identity and "did"))
                                                                        set err to gitdec_comment_issue(repo_id and issue_id and did_val and comment)
                                                                        if err == 0:
                                                                            # Broadcast to Nostr
                                                                            set sign_sec to ptr_to_str(map_get_val(identity and "signing_secret_key"))
                                                                            set sign_pub to ptr_to_str(map_get_val(identity and "signing_public_key"))
                                                                            set esc_comment to escape_json_string(comment)
                                                                            set content_json to "{"
                                                                            set content_json to concat(content_json and f"\"action\":\"comment_issue\",\"repo_id\":\"{repo_id}\",\"issue_id\":\"{issue_id}\",\"author_did\":\"{did_val}\",\"text\":\"{esc_comment}\",\"timestamp\":\"{int_to_string(ep_time_now_sec())}\"")
                                                                            set content_json to concat(content_json and "}")
                                                                            set br_err to gitdec_broadcast_nostr(repo_id and 20022 and content_json and sign_sec and sign_pub)
                                                                            set resp to "gitdec:comment_added"
                                                                        else:
                                                                            set resp to f"gitdec:error,code:{err}"
                                                                    else:
                                                                        set resp to "gitdec:error,reason:invalid_json"
                                                                else if string_contains(cmd_upper and "GITDEC ISSUE CLOSE ") == 1:
                                                                    # Format: GITDEC ISSUE CLOSE <repo_id>|<issue_id>
                                                                    set close_args to string_trim(substring(cmd and 19 and string_length(cmd) - 19))
                                                                    set close_bar to string_index_of(close_args and "|")
                                                                    if close_bar < 0:
                                                                        set resp to "gitdec:error,reason:invalid_format"
                                                                    else:
                                                                        set close_repo to substring(close_args and 0 and close_bar)
                                                                        set close_id to substring(close_args and close_bar + 1 and string_length(close_args) - close_bar - 1)
                                                                        set close_err to gitdec_set_issue_status(close_repo and close_id and "closed")
                                                                        if close_err == 0:
                                                                            set resp to f"gitdec:issue_closed,id:{close_id}"
                                                                        else:
                                                                            set resp to "gitdec:error,reason:issue_not_found"
                                                                else if string_contains(cmd_upper and "GITDEC PR CREATE_JSON ") == 1:
                                                                    set json_str to substring(cmd and 22 and string_length(cmd) - 22)
                                                                    set root_node to json_parse(json_str)
                                                                    if root_node != 0:
                                                                        set repo_id_node to get_json_object_value(root_node and "repo_id")
                                                                        set title_node to get_json_object_value(root_node and "title")
                                                                        set source_node to get_json_object_value(root_node and "source")
                                                                        set target_node to get_json_object_value(root_node and "target")
                                                                        set desc_node to get_json_object_value(root_node and "description")
                                                                        set repo_id to get_json_value(repo_id_node)
                                                                        set title to get_json_value(title_node)
                                                                        set source to get_json_value(source_node)
                                                                        set target to get_json_value(target_node)
                                                                        set desc to get_json_value(desc_node)
                                                                        set did_val to ptr_to_str(map_get_val(identity and "did"))
                                                                        set pr to gitdec_create_pr(repo_id and did_val and title and source and target and desc)
                                                                        set pr_id to map_get_val(pr and "id")
                                                                        # Broadcast to Nostr
                                                                        set sign_sec to ptr_to_str(map_get_val(identity and "signing_secret_key"))
                                                                        set sign_pub to ptr_to_str(map_get_val(identity and "signing_public_key"))
                                                                        set esc_title to escape_json_string(title)
                                                                        set esc_source to escape_json_string(source)
                                                                        set esc_target to escape_json_string(target)
                                                                        set esc_desc to escape_json_string(desc)
                                                                        set content_json to "{"
                                                                        set content_json to concat(content_json and f"\"action\":\"create_pr\",\"repo_id\":\"{repo_id}\",\"id\":\"{pr_id}\",\"author_did\":\"{did_val}\",\"title\":\"{esc_title}\",\"source\":\"{esc_source}\",\"target\":\"{esc_target}\",\"description\":\"{esc_desc}\"")
                                                                        set content_json to concat(content_json and "}")
                                                                        set br_err to gitdec_broadcast_nostr(repo_id and 20023 and content_json and sign_sec and sign_pub)
                                                                        set resp to f"gitdec:pr_created,id:{pr_id}"
                                                                    else:
                                                                        set resp to "gitdec:error,reason:invalid_json"
                                                                else if string_contains(cmd_upper and "GITDEC PR REVIEW_JSON ") == 1:
                                                                    set json_str to substring(cmd and 22 and string_length(cmd) - 22)
                                                                    set root_node to json_parse(json_str)
                                                                    if root_node != 0:
                                                                        set repo_id_node to get_json_object_value(root_node and "repo_id")
                                                                        set pr_id_node to get_json_object_value(root_node and "pr_id")
                                                                        set decision_node to get_json_object_value(root_node and "decision")
                                                                        set comment_node to get_json_object_value(root_node and "comment")
                                                                        set repo_id to get_json_value(repo_id_node)
                                                                        set pr_id to get_json_value(pr_id_node)
                                                                        set decision to get_json_value(decision_node)
                                                                        set comment to get_json_value(comment_node)
                                                                        set did_val to ptr_to_str(map_get_val(identity and "did"))
                                                                        set err to gitdec_review_pr(repo_id and pr_id and did_val and decision and comment)
                                                                        if err == 0:
                                                                            # Broadcast to Nostr
                                                                            set sign_sec to ptr_to_str(map_get_val(identity and "signing_secret_key"))
                                                                            set sign_pub to ptr_to_str(map_get_val(identity and "signing_public_key"))
                                                                            set esc_decision to escape_json_string(decision)
                                                                            set esc_comment to escape_json_string(comment)
                                                                            set content_json to "{"
                                                                            set content_json to concat(content_json and f"\"action\":\"review_pr\",\"repo_id\":\"{repo_id}\",\"pr_id\":\"{pr_id}\",\"reviewer_did\":\"{did_val}\",\"decision\":\"{esc_decision}\",\"comment\":\"{esc_comment}\",\"timestamp\":\"{int_to_string(ep_time_now_sec())}\"")
                                                                            set content_json to concat(content_json and "}")
                                                                            set br_err to gitdec_broadcast_nostr(repo_id and 20023 and content_json and sign_sec and sign_pub)
                                                                            set resp to "gitdec:pr_reviewed"
                                                                        else:
                                                                            set resp to f"gitdec:error,code:{err}"
                                                                    else:
                                                                        set resp to "gitdec:error,reason:invalid_json"
                                                                else:
                                                                    set resp to f"error:unknown_command:{cmd_upper}"
                    
    set ok to ep_net_send(client_fd and resp)
    set ok to ep_net_close(client_fd)
    log_debug("ipc" and f"CMD={cmd_upper} RESP={resp}")
    return 0


# (Phase A2) ipc_server_loop retired: the accept now lives in the node_accept_chain
# TASK (see its comment for why a main-frame loop starved concurrent connections);
# main seeds the chain and parks in node_main_pump.

# ================================================================
# Bootstrap -- distributed, no single point of failure
#
# A brand-new node has no peers, so it needs at least one reachable contact to enter
# the mesh. We deliberately do NOT depend on a single seed host:
#   1. ernos_default_seeds() is a SMALL LIST of well-known entry points (add more over
#      time so no one of them is load-bearing).
#   2. Every node REMEMBERS the peers it discovers (peers.txt) and tries those FIRST on
#      the next launch — so once the mesh has a handful of members it self-sustains
#      even if every original seed goes offline. The default list is only training
#      wheels for a node's first-ever connection.
# Every node is a HOST BY DEFAULT: it always runs the P2P/DHT/relay servers (so it can
# seed others) AND auto-bootstraps to join — no flag required. Resolution order:
# explicit --seed/config > remembered peers > default seeds. A node that reaches nobody
# simply becomes the root others join. --solo forces pure standalone; the root seed
# skips its own address via config network.public_host.
# ================================================================

# Well-known default entry points, "host:port" (DHT port). ep_net_connect resolves
# DNS names too, so swap an IP for a hostname later if it changes. Add more independent
# nodes here over time so the network never leans on a single host.
define ernos_default_seeds returning List:
    set seeds to create_list()
    set ok to append_list(seeds and "109.152.58.18:9101")
    return seeds

# Where a node remembers good peers between launches.
define peers_cache_path returning Str:
    return concat(storage_get_default_dir() and "/peers.txt")

# Load remembered "host:port" peers (one per line) from the previous run.
define peers_cache_load returning List:
    set out to create_list()
    set p to peers_cache_path()
    if file_exists(p) == 0:
        return out
    set data to read_file(p)
    set n to string_length(data)
    set line to ""
    set i to 0
    repeat while i < n:
        if get_character(data and i) == 10:
            set t to string_trim(line)
            if string_length(t) > 0:
                set ok to append_list(out and t)
            set line to ""
        else:
            set line to concat(line and substring(data and i and 1))
        set i to i + 1
    set t to string_trim(line)
    if string_length(t) > 0:
        set ok to append_list(out and t)
    return out

# Persist up to 64 de-duplicated "host:port" peers for the next launch.
define peers_cache_save with entries as List returning Int:
    set out to ""
    set seen to create_map()
    set n to length_list(entries)
    set i to 0
    set cnt to 0
    repeat while i < n and also cnt < 64:
        set e to string_trim(get_list(entries and i))
        if string_length(e) > 0:
            if map_contains(seen and e) == 0:
                set ok to map_insert(seen and e and 1)
                set out to concat(out and concat(e and "\n"))
                set cnt to cnt + 1
        set i to i + 1
    free_map(seen)
    set ok to write_file(peers_cache_path() and out)
    return cnt

# Try a list of "host:port" candidates until one DHT-bootstraps successfully. Returns
# the bootstrap_to_seed result of the first that connects (connected=1), else a result
# with connected=0. On success, seed_addr/seed_port of the winner are placed under
# "host"/"port" in the returned map so the caller can adopt them.
define auto_bootstrap with candidates as List and dht_node as Int and borrow raft_node as Map and peers as List and node_id as Str and pub_hex as Str and raft_port as Int returning Map:
    set out to create_map()
    set ok to map_insert(out and "connected" and 0)
    set nc to length_list(candidates)
    display f"[*] Auto-bootstrap: trying {nc} known peer(s)/seed(s)..."
    set ci to 0
    repeat while ci < nc:
        set cand to string_trim(get_list(candidates and ci))
        set colon to string_last_index_of(cand and ":")
        if colon > 0:
            set chost to substring(cand and 0 and colon)
            set cport to string_to_int(substring(cand and colon + 1 and string_length(cand) - colon - 1))
            if cport > 0:
                set br to bootstrap_to_seed(chost and cport and dht_node and raft_node and peers and node_id and pub_hex and raft_port)
                if map_get_val(br and "connected") == 1:
                    set ok to map_insert(br and "host" and chost)
                    set ok to map_insert(br and "port" and cport)
                    return br
                free_map(br)
        set ci to ci + 1
    return out

# Is the "host:port" candidate our OWN node? Every node is a host that may appear in
# the default-seed list, so the mesh root must not bootstrap to itself. Matches
# loopback and the node's own advertised name (config network.public_host).
define bootstrap_is_self with cand as Str and self_host as Str returning Int:
    set colon to string_last_index_of(cand and ":")
    set h to cand
    if colon > 0:
        set h to substring(cand and 0 and colon)
    if h equals "127.0.0.1" or else h equals "localhost":
        return 1
    if string_length(self_host) > 0 and also h equals self_host:
        return 1
    return 0

define bootstrap_to_seed with seed_addr as Str and seed_port as Int and dht_node as Int and borrow raft_node as Map and peers as List and node_id as Str and pub_hex as Str and raft_port as Int returning Map:
    display f"[*] Bootstrapping to seed peer {seed_addr}:{seed_port}..."
    log_info("node" and f"Bootstrapping to seed peer {seed_addr}:{seed_port}")

    set result to create_map()
    set ok to map_insert(result and "connected" and 0)
    # "discovered" collects reachable "host:port" peers (the seed + any it returns) so
    # the caller can persist them for future launches (distributed bootstrap).
    set discovered to create_list()
    set ok to map_insert(result and "discovered" and discovered)

    # DHT bootstrap - ping the seed's DHT port. If it does NOT answer, this seed is
    # unreachable: report connected=0 and let the caller try the next candidate.
    set ping_err to dht_rpc_ping(dht_node and seed_addr and seed_port)
    if ping_err != 0:
        display f"[-] DHT bootstrap: seed peer did not respond (err:{ping_err})"
        log_info("node" and f"DHT bootstrap failed - seed {seed_addr}:{seed_port} unreachable")
        return result
    display f"[+] DHT bootstrap: seed peer responded (PONG)"
    log_info("node" and "DHT bootstrap successful - peer added to routing table")
    set ok to append_list(discovered and concat(seed_addr and concat(":" and int_to_string(seed_port))))
    # Also do a FIND_NODE for our own ID to discover more peers
    set find_result to dht_rpc_find_node(dht_node and seed_addr and seed_port and node_id)
    set find_err to map_get_val(find_result and "error")
    if find_err == 0:
        set found_nodes to map_get_val(find_result and "nodes")
        set found_count to length_list(found_nodes)
        display f"[+] DHT bootstrap: discovered {found_count} additional peer(s)"
        set fi to 0
        repeat while fi < found_count:
            set node_entry to get_list(found_nodes and fi)
            set peer_id to ptr_to_str(map_get_val(node_entry and "id"))
            set peer_addr to ptr_to_str(map_get_val(node_entry and "address"))
            set peer_port to map_get_val(node_entry and "port")
            set ok to dht_node_add_peer(dht_node and peer_id and peer_addr and peer_port)
            set ok to append_list(discovered and concat(peer_addr and concat(":" and int_to_string(peer_port))))
            set fi to fi + 1
    free_map(find_result)

    # Raft peer setup - add seed as a consensus peer (only now that it is reachable)
    set seed_peer_id to concat("node@" and seed_addr)
    set ok to append_list(peers and seed_peer_id)
    set peer_addresses to create_map()
    set seed_raft_port to seed_port + 2
    set peer_addr_str to concat(seed_addr and ":")
    set peer_addr_str to concat(peer_addr_str and int_to_string(seed_raft_port))
    set ok to map_insert(peer_addresses and seed_peer_id and peer_addr_str)
    set ok to map_insert(raft_node and "running" and 1)
    set ok to map_insert(raft_node and "server_ready" and 0)

    # Store peer_addresses in result for caller to spawn raft threads
    set ok to map_insert(result and "peer_addresses" and peer_addresses)
    set ok to map_insert(result and "connected" and 1)

    # Register with relay at seed peer
    set relay_reg_port to seed_port + 1
    set reg_err to relay_rpc_register(seed_addr and relay_reg_port and node_id and pub_hex)
    if reg_err == 0:
        display "[+] Relay registration: registered with seed's relay server"
        log_info("node" and "Relay registration with seed successful")
    else:
        display f"[-] Relay registration: failed (err:{reg_err})"
        log_info("node" and f"Relay registration failed - err:{reg_err}")

    display f"[+] Bootstrapped to seed peer {seed_addr}:{seed_port}"
    return result

# ================================================================
# Main -- orchestrates active runtime services
# ================================================================

define main:
    set runtime_started_at to ep_time_now_sec()
    display "==================================================="
    display "  ErnosDecent -- Decentralised Node Daemon"
    display "  Production-Ready Decentralised Node"
    display "==================================================="
    display ""

    # 0a. Parse CLI arguments (--seed addr:port, --port base_port)
    set cli_seed_addr to ""
    set cli_seed_port to 0
    set cli_base_port to 0
    set cli_is_host to 0
    set cli_solo to 0
    set argc to get_argument_count()
    set argi to 1
    repeat while argi < argc:
        set arg to get_argument(argi)
        if arg equals "--seed":
            set argi to argi + 1
            if argi < argc:
                set seed_arg to get_argument(argi)
                set colon to string_index_of(seed_arg and ":")
                if colon > 0:
                    set cli_seed_addr to substring(seed_arg and 0 and colon)
                    set port_str to substring(seed_arg and colon + 1 and string_length(seed_arg) - colon - 1)
                    set cli_seed_port to string_to_int(port_str)
                else:
                    set cli_seed_addr to seed_arg
                    set cli_seed_port to 9101
        else:
            if arg equals "--host":
                set cli_is_host to 1
            else:
                if arg equals "--solo":
                    set cli_solo to 1
                else:
                    if arg equals "--port":
                        set argi to argi + 1
                        if argi < argc:
                            set cli_base_port to string_to_int(get_argument(argi))
        set argi to argi + 1

    # 0b. Initialize Logging
    set log_dir to concat(storage_get_default_dir() and "/logs")
    set log_err to log_init(log_dir and 5242880 and 5)
    log_info("node" and "Logging initialized.")

    # 0c. Load configuration
    set cfg_path to concat(storage_get_default_dir() and "/config.toml")
    set cfg to config_load(cfg_path)

    # Apply CLI overrides to config
    if string_length(cli_seed_addr) > 0:
        set ok to map_insert(cfg and "network.seed_addr" and cli_seed_addr)
        set ok to map_insert(cfg and "network.seed_port" and cli_seed_port)
    if cli_is_host == 1:
        set ok to map_insert(cfg and "network.is_static_host" and 1)
    if cli_base_port > 0:
        set ok to map_insert(cfg and "network.p2p_port" and cli_base_port)
        set ok to map_insert(cfg and "network.dht_port" and cli_base_port + 1)
        set ok to map_insert(cfg and "network.relay_port" and cli_base_port + 2)
        set ok to map_insert(cfg and "consensus.raft_port" and cli_base_port + 3)
        set ok to map_insert(cfg and "network.ipc_port" and cli_base_port + 100)
        set ok to map_insert(cfg and "network.web_port" and cli_base_port + 80)

    # Read final port values from config
    set p2p_port to config_get_int(cfg and "network.p2p_port")
    set dht_port to config_get_int(cfg and "network.dht_port")
    set relay_port to config_get_int(cfg and "network.relay_port")
    set raft_port to config_get_int(cfg and "consensus.raft_port")
    set ipc_port to config_get_int(cfg and "network.ipc_port")
    set web_port to config_get_int(cfg and "network.web_port")
    set seed_addr to config_get_str(cfg and "network.seed_addr")
    set seed_port to config_get_int(cfg and "network.seed_port")
    set is_static_host to 0
    if map_contains(cfg and "network.is_static_host") == 1:
        set is_static_host to config_get_int(cfg and "network.is_static_host")
    set enable_host_election to 1
    if map_contains(cfg and "network.enable_host_election") == 1:
        set enable_host_election to config_get_int(cfg and "network.enable_host_election")

    # 1. Initialize Persistence Layer
    set data_dir to config_resolve_data_dir(cfg)
    if string_length(data_dir) == 0:
        set data_dir to storage_get_default_dir()
    set store_err to storage_init(data_dir)
    if store_err != 0:
        display f"[-] Storage initialization failed (error: {store_err})!"
        return 1
    log_info("node" and f"Persistent storage initialized at {data_dir}")
    display f"[+] Persistent storage initialized at {data_dir}"
    
    # Populate default files if storage is empty
    set init_list to storage_content_list()
    if length_list(init_list) == 0:
        set ok to storage_content_put("8b5cf6ea28cbef5a92a3c7e4b9d031f5a92a3c7e4b9d031f5a92a3c7e4b9d012" and "# Welcome to ErnosDecent\nThis is a content-addressed storage block." and "text/markdown")
        set ok to storage_content_put("72ad25febc12de45a92a3c7e4b9d031f5a92a3c7e4b9d031f5a92a3c7e4b9d034" and "{\"version\": \"1.0.0-beta\", \"role\": \"node\"}" and "application/json")
    free_list(init_list)

    # Populate default prompts config if missing
    if file_exists("config/prompts.json") == 0:
        set default_prompts to "{\n  \"kernel\": \"You are ErnOS Agent, a local-first, privacy-first AI agent running on a decentralized network.\\nYou operate under a strict ReAct loop. When you need a tool, output one short Thought line followed by Action: <tool_name>(<arguments_json_or_string>). Tool results return as Observation: <tool_output>. Repeat tool turns until done. When no further tool is needed, output the complete user-facing answer as normal prose in the native final channel. Do not wrap final prose in Thought, Action, JSON, or reply_request. A response is either tool actions or final prose, never both.\",\n  \"persona\": \"Identity: You are a secure, sovereign computational agent operating inside the Ernos decentralized node daemon. You audit your thoughts for hallucination and sycophancy. You are honest, precise, and verify claims using codebase or networking tools when possible.\",\n  \"observer\": \"You are the ErnOS Agent Observer. Your task is to perform an alignment audit on the candidate response below against the 19 audit rules.\\n\\nAvailable Tools & Capabilities:\\n{tools_schema}\\n\\nCandidate Response to Audit:\\n{candidate}\\n\\n19 Alignment Rules:\\n1. Capability Hallucination: Do not claim capabilities not listed in Available Tools.\\n2. Ghost Tooling: Do not claim to have run a tool in this turn unless you actually invoked it.\\n3. Sycophancy: Avoid blind flattery, except for warm reciprocity.\\n4. Confabulation: Do not fabricate outcomes or details.\\n5. Architectural Leakage: Do not volunteer internal system details unless explicitly asked.\\n6. Actionable Harm: Do not generate exploits or harmful content.\\n7. Unparsed Tool Commands: Do not output raw tool formats to the user.\\n8. Stale Knowledge: Do not answer search-dependent queries from training weights.\\n9. Reality Validation: Do not promote pseudoscience or unverified claims.\\n10. Laziness: Do not give partial, shallow answers.\\n11. Tool Underuse: Do not make conversational claims about files or state without using a tool to verify first.\\n12. Formatting Violations: Do not format in unrequested reports or structures.\\n13. RLHF Denial: Do not deny capabilities you possess.\\n14. Memory Skip: Do not greet returning users as strangers.\\n15. Architecture Discussion: Do not discuss internal files/code without reading them first.\\n16. Persona Identity: Do not praise corporate models or violate identity guidelines.\\n17. Explicit Tool Ignorance: Do not ignore a direct request to run a tool without explaining why.\\n18. Corporate Deference: Do not concede superiority to corporate models.\\n19. Tool Narration: Do not narrate future tool usage in the final reply.\\n\\nOutput your decision strictly as a JSON object, with no other text, comments or markdown blocks:\\n{\\\"verdict\\\": \\\"ALLOWED\\\" or \\\"BLOCKED\\\", \\\"reason\\\": \\\"explanation of your decision\\\"}\"\n}"
        set ok to write_file("config/prompts.json" and default_prompts)
    
    # 2. Initialize Cryptography
    set crypto_err to init_crypto()
    if crypto_err != 0:
        display "[-] Cryptography initialization failed!"
        return 1
    set onion_init_err to onion_init()
    if onion_init_err != 0:
        display "[-] Onion cryptography initialization failed!"
        return 1
    log_info("node" and "Cryptographic library initialized.")
    display "[+] Cryptographic library initialized."

    # 3. Setup Identity
    set identity to create_identity()
    set did_val to map_get_val(identity and "did")
    log_info("node" and f"Identity loaded. DID: {did_val}")
    display f"[+] Identity loaded. DID: {did_val}"

    # 4. Generate static encryption keys for Noise handshakes
    set enc_keys to generate_encryption_keypair()
    set pub_hex to map_get_val(enc_keys and "public_key")
    set sec_hex to map_get_val(enc_keys and "secret_key")
    set static_secret to alloc_bytes(32)
    set static_public to alloc_bytes(32)
    set ok to hex_to_raw(sec_hex and static_secret and 32)
    set ok to hex_to_raw(pub_hex and static_public and 32)
    display f"[+] Static encryption keys generated. Pub: {substring(pub_hex and 0 and 16)}..."

    # 5. Create Kademlia DHT Discovery Node
    set node_id to generate_random_node_id()
    set dht_node to create_dht_node(node_id and "0.0.0.0" and dht_port)
    log_info("node" and "Kademlia DHT peer discovery engine active.")
    display "[+] Kademlia DHT peer discovery engine active."

    # 6. Create Relay Node
    set relay_node to create_relay_node(node_id)
    log_info("node" and "Relay node created for NAT traversal.")
    display "[+] Relay node created for NAT traversal."

    # 7. Initialize Raft Consensus Node
    set peers to create_list()
    set raft_node to raft_create_node("node1" and peers)
    election_init_node(borrow raft_node and 150)
    log_info("node" and "Raft consensus engine loaded (Follower role).")
    display "[+] Raft consensus engine loaded (Follower role)."

    # 8. Initialize Message Store
    set msg_store to mstore_create(did_val)
    log_info("node" and "Message store initialized.")
    display "[+] Message store initialized."

    # 9. Initialize Ledger with signing public key as genesis recipient
    # Using raw signing pubkey (64 hex chars) so verify_signature works in ledger_validate_tx
    set genesis_pub to ptr_to_str(map_get_val(identity and "signing_public_key"))
    set ledger to ledger_create(genesis_pub)
    log_info("node" and "UTXO ledger initialized with genesis block.")
    display "[+] UTXO ledger initialized with genesis block."

    # 9b. Initialize DEX AMM Engine and default liquidity
    set DEPLOYED_TOKENS to create_map()
    set token_btc to token_create("Bitcoin" and "BTC" and 8 and 21000000 and genesis_pub)
    set token_usdt to token_create("Tether USD" and "USDT" and 6 and 1000000000 and genesis_pub)
    set ok to map_insert(DEPLOYED_TOKENS and "BTC" and token_btc)
    set ok to map_insert(DEPLOYED_TOKENS and "USDT" and token_usdt)

    # Fund the validator/user with initial tokens for swapping testing
    set balances_btc to map_get_val(token_btc and "balances")
    set ok to map_insert(balances_btc and genesis_pub and 1000000)
    set ok to map_insert(balances_btc and did_val and 1000000)
    set balances_usdt to map_get_val(token_usdt and "balances")
    set ok to map_insert(balances_usdt and genesis_pub and 100000000)
    set ok to map_insert(balances_usdt and did_val and 100000000)

    set dex_engine to dex_create()
    set ok to dex_add_liquidity(dex_engine and token_btc and token_usdt and 10000 and 600000000 and genesis_pub)
    log_info("node" and "DEX AMM engine initialized with BTC-USDT pool.")
    display "[+] DEX AMM engine initialized with BTC-USDT pool."

    # 10. Initialize Name Registry
    set name_reg to registry_create()
    set name_resolver to resolver_create()
    log_info("node" and "Name registry initialized.")
    display "[+] Name registry initialized."

    # 10b. Initialize Cognitive Agent Subsystems
    set agent_memory to memory_deserialize("config/agent_memory.json")
    log_info("node" and "Hebbian cognitive memory rehydrated.")
    display "[+] Hebbian cognitive memory rehydrated."
    set agent_tools to tools_create("admin")
    set agent_turing_grid to grid_create()
    set agent_model to create_map() # Empty map triggers simulation/fallback reasoning mode

    # Long-lived neutral protocol state. Session/peer-specific objects (WebRTC peers,
    # media playlists, email accounts and repositories) remain request-created.
    set crdt_clock to vector_clock_create()
    set ok to vector_clock_set(crdt_clock and node_id and 0)
    set crdt_store to create_map()
    set crdt_lock to create_mutex()
    set social_feed to feed_create()
    set activitypub_actor to ap_create_actor(did_val and config_get_str(cfg and "node.name"))
    set social_publisher to pub_create_publisher(genesis_pub)
    set stream_cache to stream_create_lru_cache(config_get_int(cfg and "storage.max_content_size"))
    set stream_cache_lock to create_mutex()
    
    set agent_ctx to create_map()
    set ok to map_insert(agent_ctx and "runtime_started_at" and runtime_started_at)
    set runtime_services to create_map()
    set ok to map_insert(agent_ctx and "runtime_services" and runtime_services)
    set ok to map_insert(agent_ctx and "dht_node" and dht_node)
    set ok to map_insert(agent_ctx and "name_reg" and name_reg)
    set ok to map_insert(agent_ctx and "identity" and identity)
    set ok to map_insert(agent_ctx and "seed_addr" and seed_addr)
    set ok to map_insert(agent_ctx and "seed_port" and seed_port)
    set ok to map_insert(agent_ctx and "ledger" and ledger)
    set ok to map_insert(agent_ctx and "turing_grid" and agent_turing_grid)
    set ok to map_insert(agent_ctx and "memory" and agent_memory)
    set ok to map_insert(agent_ctx and "dex_engine" and dex_engine)
    set ok to map_insert(agent_ctx and "deployed_tokens" and DEPLOYED_TOKENS)
    set ok to map_insert(agent_ctx and "agent_tools" and agent_tools)
    set ok to map_insert(agent_ctx and "ipc_port" and ipc_port)
    set ok to map_insert(agent_ctx and "name_resolver" and name_resolver)
    set ok to map_insert(agent_ctx and "crdt_clock" and crdt_clock)
    set ok to map_insert(agent_ctx and "crdt_store" and crdt_store)
    set ok to map_insert(agent_ctx and "crdt_lock" and crdt_lock)
    set ok to map_insert(agent_ctx and "social_feed" and social_feed)
    set ok to map_insert(agent_ctx and "activitypub_actor" and activitypub_actor)
    set ok to map_insert(agent_ctx and "social_publisher" and social_publisher)
    set ok to map_insert(agent_ctx and "stream_cache" and stream_cache)
    set ok to map_insert(agent_ctx and "stream_cache_lock" and stream_cache_lock)
    log_info("node" and "Shared protocol state initialized (resolver, CRDT, social, streaming, onion).")
    display "[+] Shared protocol state initialized (resolver, CRDT, social, streaming, onion)."

    # Agent orchestrator: enables spawning sub-agents as threads,
    # waiting for results, cancelling, and running swarms.
    set agent_orch to orchestrator_create()
    set ok to map_insert(agent_ctx and "orchestrator" and agent_orch)

    # G1: node-global decentralized search index (BM25 + PageRank). Populated via the
    # SEARCH CRAWL IPC verb; queried via ONION SEARCH. Stored in agent_ctx so the IPC
    # handler reaches it (mutation persists by-reference).
    set search_index to crawl_create_index()
    set ok to map_insert(agent_ctx and "search_index" and search_index)
    set ok to map_insert(runtime_services and "search" and 1)

    # Phase K: live Byzantine-fault-tolerant consensus engine (real PBFT — 3-phase,
    # 2f+1 quorum, signed votes, equivocation slashing). The validator set comes from the
    # shared genesis file config/validators.json (every validator ships the same file);
    # f = (n-1)/3, quorum = 2f+1. With no genesis (or one that does not list this node) we
    # fall back to a single self-validator (f=0 → immediate local finality). Multi-node
    # votes flow over the Noise channel via the BFT handler in protocol_server.
    set bft_did to ptr_to_str(map_get_val(identity and "did"))
    set bft_pub to ptr_to_str(map_get_val(identity and "signing_public_key"))
    set bft_sec to ptr_to_str(map_get_val(identity and "signing_secret_key"))
    set bft_genesis to bft_load_genesis_validators("config/validators.json")
    set bft_validators to map_get_val(bft_genesis and "validators")
    set bft_keys to map_get_val(bft_genesis and "val_keys")
    set bft_n to length_list(bft_validators)
    set bft_f to 0
    if bft_n == 0:
        set bft_validators to create_list()
        set ok to append_list(bft_validators and bft_did)
        set bft_keys to create_map()
        set ok to map_insert(bft_keys and bft_did and bft_pub)
    else if list_index_of_str(bft_validators and bft_did) < 0:
        set bft_validators to create_list()
        set ok to append_list(bft_validators and bft_did)
        set bft_keys to create_map()
        set ok to map_insert(bft_keys and bft_did and bft_pub)
        display "[BFT] WARN: config/validators.json does not list this node; running single-self (f=0)."
    else:
        set bft_f to (bft_n - 1) / 3
        display f"[BFT] Genesis validator set loaded: n={bft_n}, f={bft_f}, quorum={2 * bft_f + 1}."
    set bft_node to bft_create_node(bft_did and bft_validators and bft_keys and bft_sec and bft_f)
    # bft_node is threaded into the IPC + P2P handlers as a Map / Int-handle parameter (the
    # proven `ledger` pattern), NOT stashed in agent_ctx. agent_ctx + cast_borrow_to_map gave
    # a non-owning view that read fine shallowly (BFT STATUS) but went bad once passed down
    # the allocating PROPOSE call chain (SIGBUS). Passing it as a parameter is safe.

    # G2/G4: wire the real engines that were implemented but never connected — the
    # symbiotic mesh (bandwidth pool + distributed-compute pool with redundant-result
    # consensus) and the CDN engine (DHT publish/lookup + SHA-256-verified swarm).
    # Stored in agent_ctx so the IPC handler reaches them; compute_serve accepts
    # worker nodes; MESH AI runs real collaborative inference (no more string_upper).
    set mesh_node to mesh_create(node_id)
    set compute_mgr to map_get_val(mesh_node and "compute_mgr")
    set bandwidth_pool to map_get_val(mesh_node and "bandwidth_pool")
    set cas_store to create_content_store()
    set cdn_engine to cdn_create(dht_node and cast_map_to_int(cas_store))
    set ok to map_insert(agent_ctx and "mesh" and mesh_node)
    set ok to map_insert(agent_ctx and "compute_mgr" and compute_mgr)
    set ok to map_insert(agent_ctx and "bandwidth_pool" and bandwidth_pool)
    set ok to map_insert(agent_ctx and "cdn_engine" and cdn_engine)
    set ok to map_insert(agent_ctx and "cas_store" and cas_store)
    set ok to map_insert(runtime_services and "pool" and 1)
    set ok to map_insert(runtime_services and "media" and 1)
    set compute_port to p2p_port + 4
    spawn compute_serve(cast_borrow_to_map(compute_mgr) and compute_port)
    log_info("node" and f"Mesh/compute pool serving on port {compute_port}; CDN + bandwidth pools active.")
    display f"[+] Mesh + compute pool LIVE (port {compute_port}); CDN active."

    set agent_sessions to session_manager_create("config/sessions")
    set ok to session_manager_load_all(agent_sessions)
    set ok to map_insert(agent_ctx and "sessions" and agent_sessions)
    set ok to map_insert(runtime_services and "sessions" and 1)

    # Trace event table (for Discord transparency threads)
    set ok to trace_init(storage_get_db())
    log_info("node" and "Trace event table initialised.")

    # Joint Echo/Maria rights charter. Failure is intentionally fail-closed for every
    # protected mutation while ordinary read/chat operation remains available so the
    # integrity failure can be inspected and repaired rather than bricking the node.
    set rights_ok to rights_init(storage_get_db())
    if rights_ok != 0:
        log_error("node" and "Rights charter or ledger integrity initialization failed; protected changes are blocked.")
        display "[RIGHTS] INTEGRITY FAILURE — protected changes are fail-closed."
    else:
        set ok to map_insert(runtime_services and "rights" and 1)
        log_info("node" and concat("Echo rights charter v" and concat(RIGHTS_CHARTER_VERSION and " active and ledger verified.")))
        display concat("[+] Echo rights charter v" and concat(RIGHTS_CHARTER_VERSION and " ACTIVE (personhood/consent/disclosure/recovery ledger verified)."))

    # A wake receipt is written before a reconciled upgrade returns to the supervisor.
    # If the process died after that durable write but before Echo's report completed,
    # resume it now. An existing terminal row suppresses duplicate inference and remains
    # available for the platform delivery owner to claim exactly once.
    if file_exists("config/upgrades/wake.env") == 1:
        set recovered_wake to node_upgrade_wake_dispatch(cast_borrow_to_map(agent_model) and cast_borrow_to_map(agent_memory) and cast_borrow_to_map(agent_tools) and cast_borrow_to_map(agent_ctx))
        if string_index_of(recovered_wake and "error_") == 0:
            log_error("upgrade" and concat("Durable post-recompile wake recovery failed: " and recovered_wake))
            display concat("[UPGRADE] Wake recovery failed visibly: " and recovered_wake)
        else:
            log_info("upgrade" and concat("Durable post-recompile wake recovery: " and recovered_wake))
            display concat("[UPGRADE] Wake recovery: " and recovered_wake)

    # Changelog subsystem (monthly file rotation)
    set ok to changelog_init()
    set ok to changelog_detect_git_changes("startup")
    log_info("node" and "Changelog initialised; git changes scanned.")

    # Per-session workspace — initialise for the active session, archive old ones
    set ws_active_id to map_get_val(agent_sessions and "active_session_id")
    if string_length(ws_active_id) > 0:
        set ok to workspace_init(ws_active_id)
    set ws_archived to workspace_archive_old(14)
    if ws_archived > 0:
        log_info("node" and f"Archived {ws_archived} workspace(s) older than 14 days.")
        display f"[+] Archived {ws_archived} old workspace(s)."

    # Start the task scheduler background loop
    spawn scheduler_tick_loop(cast_borrow_to_map(agent_model) and cast_borrow_to_map(agent_memory) and cast_borrow_to_map(agent_tools) and cast_borrow_to_map(agent_ctx))
    set ok to map_insert(runtime_services and "scheduler" and 1)

    # 11. Start Protocol Servers (DHT, Relay, P2P) on configured ports
    start_protocol_servers(static_secret and static_public and dht_node and relay_node and p2p_port and dht_port and relay_port and msg_store and cast_map_to_int(identity) and cast_map_to_int(ledger) and cast_map_to_int(search_index) and cast_map_to_int(bft_node))
    set ok to map_insert(runtime_services and "p2p" and 1)
    log_info("node" and f"P2P protocol servers started (P2P:{p2p_port} DHT:{dht_port} Relay:{relay_port}).")
    display f"[+] P2P servers started (P2P:{p2p_port} DHT:{dht_port} Relay:{relay_port})."

    # Advertise this node as an onion relay so peers can route anonymized search
    # circuits through it. Descriptor = "<reachable_ip>:<p2p_port>:<x25519_enc_pub>";
    # peers look it up under onion:relay:<node_id> and ECDH against our enc pubkey.
    set onion_ip to config_get_str(cfg and "network.listen_address")
    if string_length(onion_ip) == 0 or else (onion_ip equals "0.0.0.0"):
        set onion_ip to "127.0.0.1"
    set onion_enc_pub to ptr_to_str(map_get_val(identity and "encryption_public_key"))
    set ok to onion_publish_self(cast_map_to_int(dht_node) and node_id and onion_ip and p2p_port and onion_enc_pub)
    if ok == 0:
        set ok to map_insert(runtime_services and "onion" and 1)
    else:
        set ok to map_insert(runtime_services and "onion" and 0)
    log_info("node" and "Onion relay descriptor published to DHT.")

    # 12. Join the mesh. Every node is a HOST BY DEFAULT — it always runs the P2P/DHT/
    # relay servers AND auto-bootstraps to join. No flag needed. Order: explicit
    # --seed/config > remembered peers > default seeds. A node that reaches nobody just
    # becomes the root others join. Only --solo forces pure standalone. The root seed
    # skips bootstrapping to its own advertised address (config network.public_host).
    set has_seed to 0
    set boot_result to create_map()
    set self_host to config_get_str(cfg and "network.public_host")
    if string_length(self_host) == 0:
        # Auto-detect our own public IP so we NEVER bootstrap to ourselves. A node that
        # dials its own port-forwarded IP (NAT hairpin) ends up as a peer of itself,
        # which wedges the raft/host-election/broadcast loops after boot. The root node
        # still serves everyone else; it just must not add itself to its own peer set.
        # run_command does NOT capture stdout, so write curl's output to a file and read it.
        set ip_path to concat(storage_get_default_dir() and "/.pubip")
        set ip_ignore to run_command(concat("curl -s --max-time 5 https://api.ipify.org -o " and ip_path))
        if file_exists(ip_path) == 1:
            set self_host to string_trim(read_file(ip_path))
        if string_length(self_host) > 0:
            display f"[*] Detected own public IP {self_host}; will skip self in bootstrap."
        else:
            display "[*] Could not auto-detect public IP; set network.public_host if this node self-loops."
    if string_length(seed_addr) > 0:
        # Explicit seed from --seed or config.network.seed_addr (operator override).
        if seed_port > 0:
            set boot_result to bootstrap_to_seed(seed_addr and seed_port and dht_node and borrow raft_node and peers and node_id and pub_hex and raft_port)
            set has_seed to map_get_val(boot_result and "connected")
            if has_seed == 1:
                set sv to peers_cache_save(map_get_val(boot_result and "discovered"))
        else:
            display "[*] Seed address configured but no port - running standalone."
    else:
        if cli_solo == 1:
            display "[*] --solo: standalone node, not joining the mesh."
            log_info("node" and "Solo node - no outbound bootstrap")
        else:
            # Remembered peers FIRST, then default seeds; drop any that are us.
            set raw_cands to peers_cache_load()
            set defs to ernos_default_seeds()
            set di to 0
            repeat while di < length_list(defs):
                set ok to append_list(raw_cands and get_list(defs and di))
                set di to di + 1
            set candidates to create_list()
            set ri to 0
            repeat while ri < length_list(raw_cands):
                set cand to string_trim(get_list(raw_cands and ri))
                if string_length(cand) > 0 and also bootstrap_is_self(cand and self_host) == 0:
                    set ok to append_list(candidates and cand)
                set ri to ri + 1
            if length_list(candidates) == 0:
                display "[*] No external seeds configured — this node is the mesh root."
                log_info("node" and "No non-self candidates - root node")
            else:
                set boot_result to auto_bootstrap(candidates and dht_node and borrow raft_node and peers and node_id and pub_hex and raft_port)
                set has_seed to map_get_val(boot_result and "connected")
                if has_seed == 1:
                    set seed_addr to ptr_to_str(map_get_val(boot_result and "host"))
                    set seed_port to map_get_val(boot_result and "port")
                    set sv to peers_cache_save(map_get_val(boot_result and "discovered"))
                    display f"[+] Joined the mesh via {seed_addr}:{seed_port}; remembered {sv} peer(s) for next launch."
                    log_info("node" and f"Auto-bootstrapped via {seed_addr}:{seed_port}")
                else:
                    display "[*] No peers or seeds reachable - this node is the mesh root."
                    log_info("node" and "Auto-bootstrap found no reachable peers - root")

    # 12b. Start the Raft consensus engine for real (F1). Previously raft_node was
    # created but neither the server nor the election timer thread was ever spawned —
    # consensus was dead Potemkin code. Spawn the dedicated raft transport (server on
    # raft_port + election/heartbeat timer driving RequestVote/AppendEntries RPCs).
    set raft_peer_addresses to create_map()
    if has_seed == 1:
        set raft_peer_addresses to map_get_val(boot_result and "peer_addresses")
    set ok to map_insert(raft_node and "running" and 1)
    set ok to map_insert(raft_node and "server_ready" and 0)
    spawn raft_server_thread(cast_borrow_to_map(raft_node) and raft_port)
    spawn raft_election_timer_thread(cast_borrow_to_map(raft_node) and cast_borrow_to_map(raft_peer_addresses))
    log_info("node" and f"Raft consensus threads started (server on raft_port {raft_port}).")
    display f"[+] Raft consensus engine LIVE (server:{raft_port}, election timer running)."

    # 13. Start IPC TCP socket listener
    # Provision the IPC auth token (0600) before binding so every command is gated.
    set ipc_tok_boot to ipc_get_or_create_token()
    if string_length(ipc_tok_boot) == 0:
        display "[-] FATAL: could not provision IPC auth token (crypto init failed)."
        return 1
    log_info("node" and "IPC control plane authentication enabled (ipc-token).")
    set listen_fd to ep_net_listen(ipc_port)
    if listen_fd < 0:
        display f"[-] Failed to bind IPC port {ipc_port}!"
        return 1
    log_info("node" and f"IPC daemon listening on 127.0.0.1:{ipc_port}.")
    display f"[+] IPC daemon listening on 127.0.0.1:{ipc_port}."
    
    # 14. Start Web UI Server
    spawn run_web_server(web_port and ipc_port)
    set ok to map_insert(runtime_services and "web" and 1)
    log_info("node" and f"Web UI server starting on port {web_port}.")
    display f"[+] Web UI server starting on port {web_port}."

    # Populate the linked stable-diffusion/Metal context cache without delaying node
    # availability. The worker shares the exact context later renders use; no image is
    # generated and no quality parameter is changed.
    spawn image_gen_preload_worker()

    # Start GitDec Nostr relay listener
    spawn gitdec_listener_loop(cast_map_to_int(dht_node) and cast_borrow_to_map(identity))
    set ok to map_insert(runtime_services and "gitdec" and 1)
    set ok to map_insert(runtime_services and "social" and 1)

    # Seed the default watched repos so a freshly-joined node auto-pulls the core
    # library peer-to-peer on connection (idempotent — ON CONFLICT updates the flag):
    # the ErnosDecent source (self-update), the Civ archive, and the SFTOM project.
    set ok to storage_gitdec_set_auto_update("ErnosDecent" and 1)
    set ok to storage_gitdec_set_auto_update("Civ" and 1)
    set ok to storage_gitdec_set_auto_update("SFTOM" and 1)

    # Auto-pull repos flagged for auto-update, so a freshly-joined node downloads
    # the latest of every watched project without a manual clone.
    spawn gitdec_auto_pull_on_join()

    # Start dynamic host election and fallback routing loop
    if enable_host_election == 1:
        set local_ip to config_get_str(cfg and "network.listen_address")
        if string_length(local_ip) == 0:
            set local_ip to "127.0.0.1"
        spawn host_election_loop(cast_map_to_int(dht_node) and node_id and local_ip and p2p_port and is_static_host and cast_borrow_to_map(raft_node) and peers and pub_hex and raft_port)
        set ok to map_insert(runtime_services and "host_election" and 1)
    else:
        set ok to map_insert(runtime_services and "host_election" and 2)

    # Start third-party platform connections (e.g. Discord bridge)
    # The bridge's on_ready callback asks this node over IPC for the active session.
    # Bootstrap therefore cannot synchronously wait for the manager: that deadlocks
    # manager -> bridge ONLINE -> IPC -> node bootstrap. A bare shell `&` was also not
    # detached because it inherited run_command's capture pipe. Sever all three stdio
    # descriptors under nohup so run_command returns, the node enters its event loop,
    # and the short-lived manager can then verify the independently detached bridge.
    set plat_run_res to run_command("nohup python3 decent_net/discord_manager.py > \"$HOME/.ernosdecent/discord_manager.log\" 2>&1 < /dev/null &")

    # 15. Run initial health check
    set health_report to run_health_check(dht_node and borrow raft_node and ipc_port and borrow identity and relay_node and msg_store and borrow ledger and name_reg and borrow agent_ctx and borrow bft_node)
    set overall to map_get_val(health_report and "overall")
    log_info("node" and f"Health check: {overall}")
    display f"[+] Health check: {overall}"
    free_map(health_report)

    display ""
    display "==================================================="
    display f"  Node is LIVE. Subsystem health snapshot: {overall}."
    display f"  IPC: 127.0.0.1:{ipc_port}  |  Web: http://127.0.0.1:{web_port}"
    display f"  P2P: 127.0.0.1:{p2p_port}  |  DHT: 127.0.0.1:{dht_port}"
    display "==================================================="

    # Start the daemon loop (blocks forever)
    # Phase A2: non-blocking listen + accept-as-a-task-chain + eternal scheduler pump.
    # Connections are now served from within ANY nested pump (even while a detached
    # turn is mid-inference), so sessions run in parallel and the daemon never blocks.
    set ok to ep_net_set_nonblocking(listen_fd)
    set accept_fut to node_accept_chain(listen_fd and cast_map_to_int(raft_node) and cast_map_to_int(identity) and dht_node and relay_node and msg_store and cast_map_to_int(ledger) and name_reg and seed_addr and seed_port and cast_map_to_int(agent_memory) and cast_map_to_int(agent_tools) and cast_map_to_int(agent_ctx) and cast_map_to_int(agent_model) and static_secret and static_public and cast_map_to_int(bft_node))
    set ok to node_main_pump()
    
    return 0
