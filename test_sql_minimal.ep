# Minimal SQLite test
import "sql"

define main returning Int:
    display "Step 1: Opening database..."
    set db to sql_open("/tmp/ernos_test.db")
    display f"Step 2: Got db handle: {db}"
    if db == 0:
        display "FAIL: Could not open database"
        return 1
    display "Step 3: Creating table..."
    set ok to sql_execute(db and "CREATE TABLE IF NOT EXISTS test (key TEXT PRIMARY KEY, value TEXT);")
    display f"Step 4: Create table result: {ok}"
    set ok to sql_execute(db and "INSERT OR REPLACE INTO test (key, value) VALUES ('hello', 'world');")
    display f"Step 5: Insert result: {ok}"
    display "Step 6: About to query..."
    set rows to sql_query(db and "SELECT value FROM test WHERE key = 'hello';")
    display f"Step 7: Query returned, row count: {length_list(rows)}"
    if length_list(rows) > 0:
        set val to get_list(rows and 0)
        display f"Step 8: Value = {val}"
    set ok to sql_close(db)
    display "Step 9: Closed. SQLite works!"
    set ok to run_command("rm -f /tmp/ernos_test.db")
    return 0
