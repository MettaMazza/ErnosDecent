# ErnosDecent -- Unified Feed Aggregation
# Component: decent_social/feed.ep
# Implements: Unified chronological feed aggregator translating protocols to a single format
# Status: Production -- OperationTrojanClaude Phase 6

import "string"

# ================================================================
# Unified Feed Operations
# ================================================================

define feed_create returning Map:
    set feed to create_map()
    set items to create_list()
    set ok to map_insert(feed and "items" and items)
    return feed

define feed_add_nostr_event with feed as Map and event as Map returning Int:
    set items to map_get_val(feed and "items")
    
    set item to create_map()
    set ok to map_insert(item and "author" and map_get_val(event and "pubkey"))
    set ok to map_insert(item and "content" and map_get_val(event and "content"))
    set ok to map_insert(item and "timestamp" and map_get_val(event and "created_at"))
    set ok to map_insert(item and "source" and "nostr")
    
    set ok to append_list(items and item)
    return 0

define feed_add_ap_activity with feed as Map and activity as Map returning Int:
    set items to map_get_val(feed and "items")
    set obj to map_get_val(activity and "object")
    
    set item to create_map()
    set ok to map_insert(item and "author" and map_get_val(activity and "actor"))
    set ok to map_insert(item and "content" and map_get_val(obj and "content"))
    set ok to map_insert(item and "timestamp" and map_get_val(activity and "timestamp"))
    set ok to map_insert(item and "source" and "activitypub")
    
    set ok to append_list(items and item)
    return 0

define feed_get_sorted with feed as Map returning List:
    set items to map_get_val(feed and "items")
    set count to length_list(items)
    
    # Create copy list for sorting
    set sorted_list to create_list()
    set i to 0
    repeat while i < count:
        set ok to append_list(sorted_list and get_list(items and i))
        set i to i + 1
        
    # Bubble sort descending (latest first)
    set swapped to 1
    repeat while swapped == 1:
        set swapped to 0
        set j to 0
        repeat while j < count - 1:
            set item_a to get_list(sorted_list and j)
            set item_b to get_list(sorted_list and j + 1)
            set ts_a to map_get_val(item_a and "timestamp")
            set ts_b to map_get_val(item_b and "timestamp")
            if ts_a < ts_b:
                set ok to set_list(sorted_list and j and item_b)
                set ok to set_list(sorted_list and j + 1 and item_a)
                set swapped to 1
            set j to j + 1
            
    return sorted_list
