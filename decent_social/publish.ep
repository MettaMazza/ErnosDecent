# ErnosDecent -- Content Publishing
# Component: decent_social/publish.ep
# Implements: Follower registration and broadcast note publishing to Nostr + ActivityPub feeds
# Status: Production -- OperationTrojanClaude Phase 6

import "nostr"
import "activitypub"
import "feed"
import "string"

# ================================================================
# Publisher Operations
# ================================================================

define pub_create_publisher with identity_id as Str:
    set publisher to create_map()
    set ok to map_insert(publisher and "id" and identity_id)
    set followers to create_list()
    set ok to map_insert(publisher and "followers" and followers)
    return publisher

define pub_is_follower with publisher as Int and follower_id as Str returning Int:
    set followers to map_get_val(publisher and "followers")
    set count to length_list(followers)
    set i to 0
    repeat while i < count:
        set fid to get_list(followers and i)
        if fid equals follower_id:
            return 1
        set i to i + 1
    return 0

define pub_follow with publisher as Int and follower_id as Str returning Int:
    set exists to pub_is_follower(publisher and follower_id)
    if exists == 0:
        set followers to map_get_val(publisher and "followers")
        set ok to append_list(followers and follower_id)
    return 0

define pub_publish_note with publisher as Int and content as Str and signing_key_hex as Str and feed_list as List returning Int:
    set publisher_id to map_get_val(publisher and "id")
    
    # 1. Create and sign Nostr event
    set tags to create_list()
    set event to nostr_create_event(publisher_id and 1 and tags and content)
    set sign_err to nostr_sign_event(event and signing_key_hex)
    
    # 2. Create ActivityPub note and activity
    set note_obj to create_map()
    set ok to map_insert(note_obj and "content" and content)
    set activity to ap_create_activity(publisher_id and "Create" and note_obj)
    
    # 3. Broadcast to all target feeds in list
    set count to length_list(feed_list)
    set i to 0
    repeat while i < count:
        set target_feed to get_list(feed_list and i)
        set ok to feed_add_nostr_event(target_feed and event)
        set ok to feed_add_ap_activity(target_feed and activity)
        set i to i + 1
        
    return 0
