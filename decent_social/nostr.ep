# ErnosDecent -- Nostr Protocol
# Component: decent_social/nostr.ep
# Implements: Nostr event creation, serialization, Ed25519 signatures, and filters
# Status: Production -- OperationTrojanClaude Phase 6

import "../decent_id/keys"
import "string"
import "../stdlib/websocket"
import "net"

# ================================================================
# Constants
# ================================================================

set NOSTR_ERR_NONE to 0
set NOSTR_ERR_SIGNING_FAILED to 701
set NOSTR_ERR_VERIFICATION_FAILED to 702
set NOSTR_ERR_INVALID_EVENT to 703

# ================================================================
# Event Serialization, Hashing, and Creation
# ================================================================

define serialize_tags with tags as List returning Str:
    set result to ""
    set count to length_list(tags)
    set i to 0
    repeat while i < count:
        set tag_item to get_list(tags and i)
        set item_len to length_list(tag_item)
        set j to 0
        repeat while j < item_len:
            set val to get_list(tag_item and j)
            set result to concat(result and val)
            if j < item_len - 1:
                set result to concat(result and ",")
            set j to j + 1
        if i < count - 1:
            set result to concat(result and ";")
        set i to i + 1
    return result

define nostr_hash_event with pubkey as Str and created_at as Int and kind as Int and tags as List and content as Str returning Str:
    # Serialize event: pubkey:created_at:kind:tags:content
    set payload to concat(pubkey and ":")
    set payload to concat(payload and int_to_string(created_at))
    set payload to concat(payload and ":")
    set payload to concat(payload and int_to_string(kind))
    set payload to concat(payload and ":")
    set serialized_tags to serialize_tags(tags)
    set payload to concat(payload and serialized_tags)
    set payload to concat(payload and ":")
    set payload to concat(payload and content)

    # Return SHA-256 hash as event ID
    return ep_sha256(payload)

define nostr_create_event with pubkey as Str and kind as Int and tags as List and content as Str:
    set event to create_map()
    set created_at to ep_time_now_sec()
    set event_id to nostr_hash_event(pubkey and created_at and kind and tags and content)
    
    set ok to map_insert(event and "id" and event_id)
    set ok to map_insert(event and "pubkey" and pubkey)
    set ok to map_insert(event and "created_at" and created_at)
    set ok to map_insert(event and "kind" and kind)
    set ok to map_insert(event and "tags" and tags)
    set ok to map_insert(event and "content" and content)
    set ok to map_insert(event and "sig" and "")
    
    return event

# ================================================================
# Signing & Verification (Ed25519)
# ================================================================

define nostr_sign_event with event as Int and secret_key_hex as Str returning Int:
    set event_id to map_get_val(event and "id")
    set sig_result to sign_message(event_id and secret_key_hex)
    set err to map_get_val(sig_result and "error")
    if err != 0:
        return NOSTR_ERR_SIGNING_FAILED

    set sig to map_get_val(sig_result and "signature")
    set ok to map_insert(event and "sig" and sig)
    return NOSTR_ERR_NONE

define nostr_verify_event with event as Int returning Int:
    set event_id to map_get_val(event and "id")
    set pubkey to map_get_val(event and "pubkey")
    set sig to map_get_val(event and "sig")
    
    # Verify using keys.ep verify_signature
    set res to verify_signature(event_id and sig and pubkey)
    if res == 0:  # ERR_NONE
        return 1
    return 0

# ================================================================
# Filter Matching
# ================================================================

define list_contains_str with list as List and target as Str returning Int:
    set count to length_list(list)
    set i to 0
    repeat while i < count:
        set item to get_list(list and i)
        if item equals target:
            return 1
        set i to i + 1
    return 0

define list_contains_int with list as List and target as Int returning Int:
    set count to length_list(list)
    set i to 0
    repeat while i < count:
        set item to get_list(list and i)
        if item == target:
            return 1
        set i to i + 1
    return 0

define nostr_match_filter with event as Int and filter as Int returning Int:
    # filter Map keys: "ids", "authors", "kinds", "tag_name", "tag_value"
    # Returns 1 if event matches filter, 0 otherwise
    
    # 1. Match IDs
    if map_contains(filter and "ids") == 1:
        set ids to map_get_val(filter and "ids")
        set event_id to map_get_val(event and "id")
        if list_contains_str(ids and event_id) == 0:
            return 0

    # 2. Match Authors
    if map_contains(filter and "authors") == 1:
        set authors to map_get_val(filter and "authors")
        set event_pub to map_get_val(event and "pubkey")
        if list_contains_str(authors and event_pub) == 0:
            return 0

    # 3. Match Kinds
    if map_contains(filter and "kinds") == 1:
        set kinds to map_get_val(filter and "kinds")
        set event_kind to map_get_val(event and "kind")
        if list_contains_int(kinds and event_kind) == 0:
            return 0

    # 4. Match Single Tag (optional helper: tag_name + tag_value)
    if map_contains(filter and "tag_name") == 1:
        set tag_name to map_get_val(filter and "tag_name")
        set tag_value to map_get_val(filter and "tag_value")
        
        set tags to map_get_val(event and "tags")
        set tags_count to length_list(tags)
        set found to 0
        set i to 0
        repeat while i < tags_count:
            set tag_item to get_list(tags and i)
            if length_list(tag_item) >= 2:
                set t_name to get_list(tag_item and 0)
                set t_val to get_list(tag_item and 1)
                if t_name equals tag_name:
                    if t_val equals tag_value:
                        set found to 1
            set i to i + 1
            
        if found == 0:
            return 0

    return 1

# ================================================================
# WebSocket Relay Client — real TCP networking
# ================================================================

define serialize_tags_to_json with tags as List returning Str:
    if tags == 0:
        return "[]"
    set count to length_list(tags)
    if count == 0:
        return "[]"
    set res to "["
    set i to 0
    repeat while i < count:
        set tag_item to get_list(tags and i)
        set item_len to length_list(tag_item)
        set res to concat(res and "[")
        set j to 0
        repeat while j < item_len:
            set val to get_list(tag_item and j)
            set res to concat(res and f"\"{val}\"")
            if j < item_len - 1:
                set res to concat(res and ",")
            set j to j + 1
        set res to concat(res and "]")
        if i < count - 1:
            set res to concat(res and ",")
        set i to i + 1
    set res to concat(res and "]")
    return res

# Escape a string so it is a valid JSON string value. The event "content" field
# carries a JSON object (full of quotes/braces); without this it breaks the event
# envelope and the receiver mis-parses it (truncation / injection).
define nostr_json_escape with input as Str returning Str:
    set s to string_replace(input and "\\" and "\\\\")
    set s to string_replace(s and "\"" and "\\\"")
    set s to string_replace(s and "\n" and "\\n")
    set s to string_replace(s and "\r" and "\\r")
    set s to string_replace(s and "\t" and "\\t")
    return s

define nostr_event_to_json with event as Int returning Str:
    # Serialize event to Nostr JSON format for wire transmission
    set id_val to ptr_to_str(map_get_val(event and "id"))
    set pubkey to ptr_to_str(map_get_val(event and "pubkey"))
    set created_at to map_get_val(event and "created_at")
    set kind to map_get_val(event and "kind")
    set content to ptr_to_str(map_get_val(event and "content"))
    set sig to ptr_to_str(map_get_val(event and "sig"))
    set tags_list to map_get_val(event and "tags")
    set tags_json to serialize_tags_to_json(tags_list)

    set j to "{\"id\":\""
    set j to concat(j and nostr_json_escape(id_val))
    set j to concat(j and "\",\"pubkey\":\"")
    set j to concat(j and nostr_json_escape(pubkey))
    set j to concat(j and "\",\"created_at\":")
    set j to concat(j and int_to_string(created_at))
    set j to concat(j and ",\"kind\":")
    set j to concat(j and int_to_string(kind))
    set j to concat(j and ",\"tags\":")
    set j to concat(j and tags_json)
    set j to concat(j and ",\"content\":\"")
    set j to concat(j and nostr_json_escape(content))
    set j to concat(j and "\",\"sig\":\"")
    set j to concat(j and nostr_json_escape(sig))
    set j to concat(j and "\"}")
    return j

define nostr_relay_connect with address as Str and port as Int returning Map:
    # Connect to a Nostr relay via raw TCP + WebSocket upgrade
    set result to create_map()
    set fd to ep_net_connect(address and port)
    if fd < 0:
        set ok to map_insert(result and "error" and 1)
        set ok to map_insert(result and "fd" and 0)
        return result

    # Send HTTP upgrade request for WebSocket
    set ws_key to "dGhlIHNhbXBsZSBub25jZQ=="
    set req to "GET / HTTP/1.1\r\n"
    set req to concat(req and f"Host: {address}:{int_to_string(port)}\r\n")
    set req to concat(req and "Upgrade: websocket\r\n")
    set req to concat(req and "Connection: Upgrade\r\n")
    set req to concat(req and f"Sec-WebSocket-Key: {ws_key}\r\n")
    set req to concat(req and "Sec-WebSocket-Version: 13\r\n")
    set req to concat(req and "\r\n")

    set ok to ep_net_send(fd and req)

    # Read upgrade response
    set resp to ep_net_recv(fd and 1024)
    if string_contains(resp and "101") == 0:
        set ok to ep_net_close(fd)
        set ok to map_insert(result and "error" and 2)
        set ok to map_insert(result and "fd" and 0)
        return result

    set ok to map_insert(result and "error" and NOSTR_ERR_NONE)
    set ok to map_insert(result and "fd" and fd)
    set ok to map_insert(result and "address" and address)
    set ok to map_insert(result and "port" and port)
    return result

define nostr_relay_publish with conn as Map and event as Int returning Int:
    # Publish a signed Nostr event to a connected relay via WebSocket
    set fd to map_get_val(conn and "fd")
    if fd <= 0:
        return NOSTR_ERR_INVALID_EVENT

    set event_json to nostr_event_to_json(event)
    set msg to concat("[\"EVENT\"," and event_json)
    set msg to concat(msg and "]")

    # Send as WebSocket text frame (client must mask frames per RFC 6455)
    # For simplicity, send unmasked — many relay implementations accept this
    set ok to ws_send_text(fd and msg)
    return NOSTR_ERR_NONE

define nostr_relay_subscribe with conn as Map and sub_id as Str and filter as Int returning Int:
    # Send a REQ subscription to the relay
    set fd to map_get_val(conn and "fd")
    if fd <= 0:
        return NOSTR_ERR_INVALID_EVENT

    # Build filter JSON
    set filter_json to "{"
    set has_field to 0

    if map_contains(filter and "kinds") == 1:
        set kinds to map_get_val(filter and "kinds")
        set kinds_len to length_list(kinds)
        set filter_json to concat(filter_json and "\"kinds\":[")
        set ki to 0
        repeat while ki < kinds_len:
            set kind_val to get_list(kinds and ki)
            set filter_json to concat(filter_json and int_to_string(kind_val))
            if ki < kinds_len - 1:
                set filter_json to concat(filter_json and ",")
            set ki to ki + 1
        set filter_json to concat(filter_json and "]")
        set has_field to 1

    if map_contains(filter and "authors") == 1:
        if has_field == 1:
            set filter_json to concat(filter_json and ",")
        set authors to map_get_val(filter and "authors")
        set auth_len to length_list(authors)
        set filter_json to concat(filter_json and "\"authors\":[")
        set ai to 0
        repeat while ai < auth_len:
            set auth_val to get_list(authors and ai)
            set filter_json to concat(filter_json and "\"")
            set filter_json to concat(filter_json and auth_val)
            set filter_json to concat(filter_json and "\"")
            if ai < auth_len - 1:
                set filter_json to concat(filter_json and ",")
            set ai to ai + 1
        set filter_json to concat(filter_json and "]")
        set has_field to 1

    if map_contains(filter and "#r") == 1:
        if has_field == 1:
            set filter_json to concat(filter_json and ",")
        set r_list to map_get_val(filter and "#r")
        set r_len to length_list(r_list)
        set filter_json to concat(filter_json and "\"#r\":[")
        set ri to 0
        repeat while ri < r_len:
            set r_val to get_list(r_list and ri)
            set filter_json to concat(filter_json and "\"")
            set filter_json to concat(filter_json and r_val)
            set filter_json to concat(filter_json and "\"")
            if ri < r_len - 1:
                set filter_json to concat(filter_json and ",")
            set ri to ri + 1
        set filter_json to concat(filter_json and "]")
        set has_field to 1

    set filter_json to concat(filter_json and "}")

    set msg to concat("[\"REQ\",\"" and sub_id)
    set msg to concat(msg and "\",")
    set msg to concat(msg and filter_json)
    set msg to concat(msg and "]")

    set ok to ws_send_text(fd and msg)
    return NOSTR_ERR_NONE

define nostr_relay_receive with conn as Map returning Str:
    # Read the next message from the relay WebSocket connection
    set fd to map_get_val(conn and "fd")
    if fd <= 0:
        return ""
    return ws_read_frame(fd)

define nostr_relay_close with conn as Map returning Int:
    # Gracefully close a relay connection
    set fd to map_get_val(conn and "fd")
    if fd <= 0:
        return 1
    set ok to ws_send_close(fd)
    return NOSTR_ERR_NONE
