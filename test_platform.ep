import "platform"

define main returning Int:
    display "=== Platform Detection Test ==="
    set p to detect_platform()
    set name to platform_name(p)
    set os_str to platform_os_string()
    display f"  Platform ID: {p}"
    display f"  Platform Name: {name}"
    display f"  OS String: {os_str}"
    if p == PLATFORM_MACOS and also os_str equals "macos":
        display "  PASS: Detected macOS"
        return 0
    if p == PLATFORM_LINUX and also os_str equals "linux":
        display "  PASS: Detected Linux"
        return 0
    if p == PLATFORM_WINDOWS and also os_str equals "windows":
        display "  PASS: Detected Windows"
        return 0
    display "  FAIL: Platform ID and OS string are inconsistent or unsupported"
    return 1
