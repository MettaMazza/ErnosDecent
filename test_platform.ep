import "platform"

define main returning Int:
    display "=== Platform Detection Test ==="
    set p to detect_platform()
    set name to platform_name(p)
    set os_str to platform_os_string()
    display f"  Platform ID: {p}"
    display f"  Platform Name: {name}"
    display f"  OS String: {os_str}"
    if p == PLATFORM_MACOS:
        display "  PASS: Detected macOS"
    else:
        display "  WARN: Expected macOS on this system"
    return 0
