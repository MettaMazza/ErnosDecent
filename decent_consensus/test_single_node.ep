# F1 negative-control: a standalone (0-peer) Raft node must self-elect to LEADER.
# Before the fix it stayed CANDIDATE forever (no vote responses ever arrived to
# drive the majority check). majority for 1 node is 1, so the self-vote suffices.

import "string"
import "collections"
import "raft"
import "election"

define main returning Int:
    set peers to create_list()
    set node to raft_create_node("solo" and peers)
    set ok to election_init_node(borrow node and 150)

    # Advance past the election timeout to trigger an election.
    set reqs to election_tick(borrow node and 200)
    free_list(reqs)

    set role to ptr_to_str(map_get_val(node and "role"))
    if role equals RAFT_ROLE_LEADER:
        display "PASS: single-node self-elected to LEADER"
        display "RESULT: 1/1 passed"
    else:
        display concat("FAIL: expected leader, got " and role)
        display "RESULT: 0/1 passed"
    return 0
