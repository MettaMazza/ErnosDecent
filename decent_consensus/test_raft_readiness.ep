import "raft_transport"
import "raft"
import "collections"
import "string"
import "net"

define raft_ready_pass with label as Str and condition as Int returning Int:
    if condition == 1:
        display concat("  [PASS] " and label)
        return 1
    display concat("  [FAIL] " and label)
    return 0

define raft_ready_free_port with start_port as Int returning Int:
    set port to start_port
    repeat while port <= 65000:
        set fd to ep_net_listen(port)
        if fd >= 0:
            set ok to ep_net_close(fd)
            return port
        set port to port + 1
    return 0

define main returning Int:
    display "Raft listener readiness tests"
    set passed to 0
    set total to 0
    set peers to create_list()
    set node to raft_create_node("readiness-node" and peers)

    set invalid_rc to raft_start_server(node and 0)
    set total to total + 1
    set passed to passed + raft_ready_pass("invalid port rejected" and invalid_rc == TRANSPORT_ERR_LISTEN_FAILED)
    set total to total + 1
    set passed to passed + raft_ready_pass("invalid port never marks ready" and map_get_val(node and "server_ready") == 0)

    set conflict_port to raft_ready_free_port(49000)
    set blocker to ep_net_listen(conflict_port)
    set conflict_rc to raft_start_server(node and conflict_port)
    set total to total + 1
    set passed to passed + raft_ready_pass("occupied Raft port fails synchronously" and conflict_rc == TRANSPORT_ERR_LISTEN_FAILED)
    set total to total + 1
    set passed to passed + raft_ready_pass("Raft bind failure leaves server not ready" and map_get_val(node and "server_ready") == 0)
    if blocker >= 0:
        set ok to ep_net_close(blocker)

    set live_port to raft_ready_free_port(50000)
    set start_rc to raft_start_server(node and live_port)
    set total to total + 1
    set passed to passed + raft_ready_pass("successful Raft start returns after bind" and start_rc == RAFT_TRANSPORT_ERR_NONE)
    set total to total + 1
    set passed to passed + raft_ready_pass("successful Raft bind marks ready" and map_get_val(node and "server_ready") == 1)
    set duplicate_rc to raft_start_server(node and live_port)
    set total to total + 1
    set passed to passed + raft_ready_pass("duplicate Raft start is rejected" and duplicate_rc == RAFT_TRANSPORT_ERR_ALREADY_RUNNING)

    set stop_rc to raft_stop_server(node)
    set total to total + 1
    set passed to passed + raft_ready_pass("Raft stop request succeeds" and stop_rc == RAFT_TRANSPORT_ERR_NONE)
    set waited to 0
    repeat while map_get_val(node and "server_ready") == 1 and also waited < 2000:
        set ok to ep_sleep_ms(10)
        set waited to waited + 10
    set total to total + 1
    set passed to passed + raft_ready_pass("Raft worker clears readiness after close" and map_get_val(node and "server_ready") == 0)
    set rebound to ep_net_listen(live_port)
    set total to total + 1
    set passed to passed + raft_ready_pass("stopped Raft port is reusable" and rebound >= 0)
    if rebound >= 0:
        set ok to ep_net_close(rebound)

    display f"Raft readiness: {passed}/{total} passed"
    if passed != total:
        return 1
    return 0
