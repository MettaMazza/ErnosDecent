# Test that the Ernos compiler is operational
import "string"
import "crypto"

define main returning Int:
    display "ErnosDecent compiler test"
    set hash to crypto_sha256("hello ernosdecent")
    display f"SHA256: {hash}"
    set bytes to random_bytes(16)
    display f"Random bytes generated: {length_list(bytes)}"
    display "Compiler verified operational."
    return 0
