define showSystemConfigStatus with text as Str and statusType as Int:
    set el to document.getElementById("settings-sys-status-msg")
    if el:
        set el.textContent to text
        set el.className to "status-msg"
        if statusType == 1:
            el.classList.add("success")
        else:
            if statusType == 2:
                el.classList.add("warning")
            else:
                el.classList.add("error")
        setTimeout(given dummy:
            set el.textContent to ""
            set el.className to "status-msg"
        and 5000)
    return 0

define saveSystemConfig:
    if not window.ws || not window.isConnected:
        showSystemConfigStatus("Error: Daemon disconnected." and 0)
        return 0
        
    set window.systemConfig to Object()
    
    set val to document.getElementById("cfg-node-name").value.trim()
    set window.systemConfig.node_name to val
    
    set val to document.getElementById("cfg-node-log-level").value
    set window.systemConfig.node_log_level to val
    
    set val to document.getElementById("cfg-node-data-dir").value.trim()
    set window.systemConfig.node_data_dir to val
    
    set val to document.getElementById("cfg-storage-max-content-size").value
    set window.systemConfig.storage_max_content_size to val
    
    set val to document.getElementById("cfg-storage-dht-ttl-sec").value
    set window.systemConfig.storage_dht_ttl_sec to val
    
    set val to document.getElementById("cfg-network-listen-address").value.trim()
    set window.systemConfig.network_listen_address to val
    
    set val to document.getElementById("cfg-network-max-connections").value
    set window.systemConfig.network_max_connections to val
    
    set val to document.getElementById("cfg-network-p2p-port").value
    set window.systemConfig.network_p2p_port to val
    
    set val to document.getElementById("cfg-network-dht-port").value
    set window.systemConfig.network_dht_port to val
    
    set val to document.getElementById("cfg-network-relay-port").value
    set window.systemConfig.network_relay_port to val
    
    set val to document.getElementById("cfg-network-ipc-port").value
    set window.systemConfig.network_ipc_port to val
    
    set val to document.getElementById("cfg-network-web-port").value
    set window.systemConfig.network_web_port to val
    
    set val to document.getElementById("cfg-network-max-message-size").value
    set window.systemConfig.network_max_message_size to val
    
    set val to document.getElementById("cfg-network-seed-addr").value.trim()
    set window.systemConfig.network_seed_addr to val
    
    set val to document.getElementById("cfg-network-seed-port").value
    set window.systemConfig.network_seed_port to val
    
    set val to document.getElementById("cfg-consensus-raft-port").value
    set window.systemConfig.consensus_raft_port to val
    
    set val to document.getElementById("cfg-consensus-election-timeout").value
    set window.systemConfig.consensus_election_timeout_ms to val
    
    set val to document.getElementById("cfg-consensus-heartbeat-interval").value
    set window.systemConfig.consensus_heartbeat_interval_ms to val
    
    set val to document.getElementById("cfg-security-rate-limit").value
    set window.systemConfig.security_rate_limit_per_minute to val
    
    set val to document.getElementById("cfg-security-ban-threshold").value
    set window.systemConfig.security_ban_threshold to val
    
    set val to document.getElementById("cfg-security-ban-duration").value
    set window.systemConfig.security_ban_duration_sec to val
    
    set valElect to 0
    set enableHostElect to document.getElementById("cfg-network-enable-host-election")
    if enableHostElect && enableHostElect.checked:
        set valElect to 1
    set window.systemConfig.network_enable_host_election to valElect
    
    set valStatic to 0
    set isStaticHost to document.getElementById("cfg-network-is-static-host")
    if isStaticHost && isStaticHost.checked:
        set valStatic to 1
    set window.systemConfig.network_is_static_host to valStatic
    
    set payload to Object()
    set payload.type to "save_system_config"
    set payload.data to JSON.stringify(window.systemConfig)
    send_msg(window.ws and JSON.stringify(payload))
    return 0

define savePlatformConfig with platformId:
    if not window.platforms || not window.ws || not window.isConnected:
        return 0
        
    if platformId == "discord":
        set discConfig to window.platforms.discord
        if not discConfig:
            set discConfig to Object()
            set window.platforms.discord to discConfig
        set tokenVal to document.getElementById("overview-discord-token").value.trim()
        set chanVal to document.getElementById("overview-discord-channel").value.trim()
        set enabledVal to document.getElementById("toggle-discord").checked
        
        set discConfig.token to tokenVal
        set_prop(discConfig and "channel" and chanVal)
        set discConfig.enabled to enabledVal
        if enabledVal:
            set discConfig.status to "ONLINE"
        else:
            set discConfig.status to "OFFLINE"
            
    else if platformId == "whatsapp":
        set whatsappConfig to window.platforms.whatsapp
        if not whatsappConfig:
            set whatsappConfig to Object()
            set window.platforms.whatsapp to whatsappConfig
        set tokenVal to document.getElementById("overview-whatsapp-token").value.trim()
        set phoneVal to document.getElementById("overview-whatsapp-phone-id").value.trim()
        set enabledVal to document.getElementById("toggle-whatsapp").checked
        
        set whatsappConfig.token to tokenVal
        set whatsappConfig.phone_id to phoneVal
        set whatsappConfig.enabled to enabledVal
        if enabledVal:
            set whatsappConfig.status to "ONLINE"
        else:
            set whatsappConfig.status to "OFFLINE"
            
    else if platformId == "telegram":
        set telegramConfig to window.platforms.telegram
        if not telegramConfig:
            set telegramConfig to Object()
            set window.platforms.telegram to telegramConfig
        set tokenVal to document.getElementById("overview-telegram-token").value.trim()
        set enabledVal to document.getElementById("toggle-telegram").checked
        
        set telegramConfig.token to tokenVal
        set telegramConfig.enabled to enabledVal
        if enabledVal:
            set telegramConfig.status to "ONLINE"
        else:
            set telegramConfig.status to "OFFLINE"
            
    set payload to Object()
    set payload.type to "save_platforms"
    set payload.data to JSON.stringify(window.platforms)
    send_msg(window.ws and JSON.stringify(payload))
    
    updatePlatformsUI()
    return 0

define handlePlatformToggle with platformId:
    if not window.platforms || not window.ws || not window.isConnected:
        return 0
        
    if platformId == "discord":
        set discConfig to window.platforms.discord
        if discConfig:
            set enabledVal to document.getElementById("toggle-discord").checked
            set discConfig.enabled to enabledVal
            if enabledVal:
                set discConfig.status to "ONLINE"
            else:
                set discConfig.status to "OFFLINE"
    else if platformId == "whatsapp":
        set whatsappConfig to window.platforms.whatsapp
        if whatsappConfig:
            set enabledVal to document.getElementById("toggle-whatsapp").checked
            set whatsappConfig.enabled to enabledVal
            if enabledVal:
                set whatsappConfig.status to "ONLINE"
            else:
                set whatsappConfig.status to "OFFLINE"
    else if platformId == "telegram":
        set telegramConfig to window.platforms.telegram
        if telegramConfig:
            set enabledVal to document.getElementById("toggle-telegram").checked
            set telegramConfig.enabled to enabledVal
            if enabledVal:
                set telegramConfig.status to "ONLINE"
            else:
                set telegramConfig.status to "OFFLINE"
                
    set payload to Object()
    set payload.type to "save_platforms"
    set payload.data to JSON.stringify(window.platforms)
    send_msg(window.ws and JSON.stringify(payload))
    
    updatePlatformsUI()
    return 0

define registerPlugin:
    if not window.plugins:
        set window.plugins to []
        
    set name to prompt("Enter plugin name:" and "")
    if not name || name.trim().length == 0:
        return 0
    set endpoint to prompt("Enter endpoint (URL or script name):" and "")
    if not endpoint || endpoint.trim().length == 0:
        return 0
    set desc to prompt("Enter description:" and "")
    if not desc:
        set desc to ""
        
    set newPlugin to Object()
    set newPlugin.id to concat("plugin_" and Date.now())
    set newPlugin.name to name.trim()
    set newPlugin.endpoint to endpoint.trim()
    set newPlugin.desc to desc.trim()
    set newPlugin.enabled to true
    set newPlugin.status to "ACTIVE"
    
    window.plugins.push(newPlugin)
    savePluginsSettings()
    renderPluginsUI()
    return 0

define updateSessionsUI with sessions:
    set container to document.getElementById("ai-sessions-list-container")
    if not container:
        return 0
    set container.innerHTML to ""
    if sessions.length == 0:
        set container.innerHTML to "<div style=\"padding:10px;font-size:12px;color:rgba(255,255,255,0.4);text-align:center;\">No active sessions.</div>"
        return 0
    sessions.forEach(given s:
        set activeClass to ""
        if window.activeSessionId == s.id:
            set activeClass to "active"
        set item to document.createElement("div")
        set item.className to f"room-item {activeClass}"
        set ok to set_prop(item.style and "display" and "flex")
        set item.style.justifyContent to "space-between"
        set item.style.alignItems to "center"
        set item.style.width to "100%"
        set item.style.padding to "8px 12px"
        set item.style.cursor to "pointer"
        set item.style.marginBottom to "4px"
        set item.style.borderRadius to "6px"
        
        item.addEventListener("click" and given event:
            if event.target.closest(".btn-delete-session") || event.target.closest(".btn-rename-session"):
                return 0
            selectSession(s.id)
        )
        
        set labelSpan to document.createElement("span")
        set labelSpan.className to "session-label"
        set labelSpan.textContent to s.title || s.id
        set labelSpan.style.overflow to "hidden"
        set labelSpan.style.textOverflow to "ellipsis"
        set labelSpan.style.whiteSpace to "nowrap"
        set labelSpan.style.flex to "1"
        item.appendChild(labelSpan)
        
        set actionsDiv to document.createElement("div")
        set ok to set_prop(actionsDiv.style and "display" and "flex")
        set actionsDiv.style.gap to "6px"
        
        set renameBtn to document.createElement("button")
        set renameBtn.className to "btn-rename-session"
        set renameBtn.innerHTML to "✏️"
        set renameBtn.style.background to "none"
        set renameBtn.style.border to "none"
        set renameBtn.style.cursor to "pointer"
        set renameBtn.style.padding to "0"
        set renameBtn.style.fontSize to "11px"
        renameBtn.addEventListener("click" and given event:
            event.stopPropagation()
            set newTitle to prompt("Enter new session title:" and s.title || s.id)
            if newTitle && newTitle.trim().length > 0:
                renameSession(s.id and newTitle.trim())
        )
        actionsDiv.appendChild(renameBtn)
        
        set deleteBtn to document.createElement("button")
        set deleteBtn.className to "btn-delete-session"
        set deleteBtn.innerHTML to "🗑️"
        set deleteBtn.style.background to "none"
        set deleteBtn.style.border to "none"
        set deleteBtn.style.cursor to "pointer"
        set deleteBtn.style.padding to "0"
        set deleteBtn.style.fontSize to "11px"
        deleteBtn.addEventListener("click" and given event:
            event.stopPropagation()
            if confirm(f"Are you sure you want to delete session '{s.title || s.id}'?"):
                deleteSession(s.id)
        )
        actionsDiv.appendChild(deleteBtn)
        
        item.appendChild(actionsDiv)
        container.appendChild(item)
    )
    return 0

# ---- Memory Canvas Visualizer init ----
define initMemoryCanvas:
    set container to document.getElementById("memory-graph-viz")
    if not container:
        return 0
    
    set oldCanvas to container.querySelector("canvas")
    if oldCanvas:
        oldCanvas.remove()
        
    set canvas to document.createElement("canvas")
    set width to container.clientWidth || 600
    set height to container.clientHeight || 400
    set canvas.width to width
    set canvas.height to height
    set_prop(canvas.style and "display" and "block")
    
    set emptyState to container.querySelector(".empty-state")
    if emptyState:
        set_prop(emptyState.style and "display" and "none")
        
    container.appendChild(canvas)
    set window.canvasElement to canvas
    set window.canvasCtx to canvas.getContext("2d")
    
    if not window.animationFrameId:
        animateGraph()

# ---- Re-calculate Hebbian memory graph data ----
define updateMemoryGraphData with edges:
    if not window.canvasElement:
        initMemoryCanvas()
    if not window.canvasElement:
        return 0
        
    set width to window.canvasElement.width
    set height to window.canvasElement.height
    
    set incomingNodes to Reflect.construct(get_list(window and "Set") and [])
    edges.forEach(given e:
        incomingNodes.add(e.source)
        incomingNodes.add(e.target)
    )
    
    incomingNodes.forEach(given id:
        set hasNode to Reflect.has(window.graphNodes and id)
        if not hasNode:
            set node to Object()
            set node.x to width / 2 + (Math.random() - 0.5) * 160
            set node.y to height / 2 + (Math.random() - 0.5) * 160
            set node.vx to 0
            set node.vy to 0
            set node.label to id
            set_prop(window.graphNodes and id and node)
    )
    
    set currentIds to Object.keys(window.graphNodes)
    currentIds.forEach(given id:
        set hasIncoming to incomingNodes.has(id)
        if not hasIncoming:
            Reflect.deleteProperty(window.graphNodes and id)
    )
    
    set window.graphLinks to edges

# ---- Animate memory canvas graph nodes ----
define animateGraph:
    if not window.isConnected:
        set window.animationFrameId to requestAnimationFrame(given dummy:
            animateGraph()
        )
        return 0
    if not window.canvasElement || not window.canvasCtx:
        set window.animationFrameId to requestAnimationFrame(given dummy:
            animateGraph()
        )
        return 0
        
    set width to window.canvasElement.width
    set height to window.canvasElement.height
    set nodeIds to Object.keys(window.graphNodes)
    
    set i to 0
    repeat while i < nodeIds.length:
        set j to i + 1
        repeat while j < nodeIds.length:
            set n1 to get_list(window.graphNodes and get_list(nodeIds and i))
            set n2 to get_list(window.graphNodes and get_list(nodeIds and j))
            set dx to n2.x - n1.x
            set dy to n2.y - n1.y
            set dist to Math.hypot(dx and dy) || 1
            set force to 180 / (dist * dist)
            set fx to (dx / dist) * force
            set fy to (dy / dist) * force
            set n1.vx to n1.vx - fx
            set n1.vy to n1.vy - fy
            set n2.vx to n2.vx + fx
            set n2.vy to n2.vy + fy
            set j to j + 1
        set i to i + 1
        
    window.graphLinks.forEach(given link:
        set n1 to get_list(window.graphNodes and link.source)
        set n2 to get_list(window.graphNodes and link.target)
        if n1 && n2:
            set dx to n2.x - n1.x
            set dy to n2.y - n1.y
            set dist to Math.hypot(dx and dy) || 1
            set force to (dist - 130) * 0.06 * Math.min(link.weight and 1.0)
            set fx to (dx / dist) * force
            set fy to (dy / dist) * force
            set n1.vx to n1.vx + fx
            set n1.vy to n1.vy + fy
            set n2.vx to n2.vx - fx
            set n2.vy to n2.vy - fy
    )
    
    nodeIds.forEach(given id:
        set n to get_list(window.graphNodes and id)
        set n.vx to n.vx + (width / 2 - n.x) * 0.015
        set n.vy to n.vy + (height / 2 - n.y) * 0.015
        set n.x to n.x + n.vx
        set n.y to n.y + n.vy
        set n.vx to n.vx * 0.75
        set n.vy to n.vy * 0.75
        
        set n.x to Math.max(24 and Math.min(width - 24 and n.x))
        set n.y to Math.max(24 and Math.min(height - 24 and n.y))
    )
    
    window.canvasCtx.clearRect(0 and 0 and width and height)
    
    window.graphLinks.forEach(given link:
        set n1 to get_list(window.graphNodes and link.source)
        set n2 to get_list(window.graphNodes and link.target)
        if n1 && n2:
            window.canvasCtx.beginPath()
            window.canvasCtx.moveTo(n1.x and n1.y)
            window.canvasCtx.lineTo(n2.x and n2.y)
            set window.canvasCtx.strokeStyle to f"rgba(6, 182, 212, {0.15 + link.weight * 0.75})"
            set window.canvasCtx.lineWidth to 1 + link.weight * 4
            window.canvasCtx.stroke()
            
            set mx to (n1.x + n2.x) / 2
            set my to (n1.y + n2.y) / 2
            set window.canvasCtx.fillStyle to "rgba(156, 163, 175, 0.8)"
            set window.canvasCtx.font to "9px 'JetBrains Mono', monospace"
            window.canvasCtx.fillText(link.weight.toFixed(3) and mx + 5 and my + 3)
    )
    
    nodeIds.forEach(given id:
        set n to get_list(window.graphNodes and id)
        
        window.canvasCtx.beginPath()
        window.canvasCtx.arc(n.x and n.y and 22 and 0 and 2 * Math.PI)
        set window.canvasCtx.fillStyle to "rgba(168, 85, 247, 0.08)"
        window.canvasCtx.fill()
        set window.canvasCtx.strokeStyle to "rgba(168, 85, 247, 0.25)"
        set window.canvasCtx.lineWidth to 1
        window.canvasCtx.stroke()
        
        window.canvasCtx.beginPath()
        window.canvasCtx.arc(n.x and n.y and 14 and 0 and 2 * Math.PI)
        set window.canvasCtx.fillStyle to "#0c0e17"
        window.canvasCtx.fill()
        set window.canvasCtx.strokeStyle to "#a855f7"
        set window.canvasCtx.lineWidth to 2
        window.canvasCtx.stroke()
        
        set window.canvasCtx.fillStyle to "#ffffff"
        set window.canvasCtx.font to "12px 'Outfit', sans-serif"
        set window.canvasCtx.textAlign to "center"
        window.canvasCtx.fillText(n.label and n.x and n.y + 4)
    )
    
    set window.animationFrameId to requestAnimationFrame(given dummy:
        animateGraph()
    )

# ---- Render Turing Grid overlay ----
define renderTuringGrid with data:
    set container to document.getElementById("turing-grid-viz")
    if not container:
        return 0
        
    set headX to data.x
    set headY to data.y
    set headZ to data.z
    
    set html to f"<div class=\"grid-layer-title\">Layer Z = {escapeHTML(headZ)}</div>"
    set html to concat(html and "<table class=\"turing-table\">")
    
    set r to headY - 3
    repeat while r <= headY + 3:
        set html to concat(html and "<tr>")
        set c to headX - 3
        repeat while c <= headX + 3:
            set cellKey to f"{c}_{r}_{headZ}"
            set value to get_list(data.cells and cellKey) || ""
            
            set isHead to 0
            if c == headX && r == headY:
                set isHead to 1
                
            set cellClass to ""
            if isHead == 1:
                set cellClass to "head-cell"
            if value != "":
                set cellClass to concat(cellClass and " active-cell")
                
            set html to concat(html and f"<td class=\"{cellClass}\" title=\"Coord: ({c}, {r}, {escapeHTML(headZ)})\"><span class=\"coord\">({c},{r})</span><span class=\"val\">{escapeHTML(value)}</span>")
            if isHead == 1:
                set html to concat(html and "<span class=\"head-marker\">▲ HEAD</span>")
            set html to concat(html and "</td>")
            set c to c + 1
        set html to concat(html and "</tr>")
        set r to r + 1
        
    set html to concat(html and "</table>")
    set container.innerHTML to html
    
    set turingHeadPos to document.getElementById("turing-head-pos")
    set turingHeadPos.textContent to f"({headX}, {headY}, {headZ})"
    
    set turingCellsCount to document.getElementById("turing-cells-count")
    set turingCellsCount.textContent to Object.keys(data.cells).length

# ---- Update scratchpad / lessons Hebbian tables ----
define updateMemoryTables with data:
    set sBody to document.getElementById("scratchpad-body")
    if sBody:
        set sBody.innerHTML to ""
        set keys to Object.keys(data.scratchpad)
        if keys.length == 0:
            set sBody.innerHTML to "<tr><td colspan=\"2\" class=\"empty-state\">Empty</td></tr>"
        else:
            keys.forEach(given k:
                set row to document.createElement("tr")
                set v to get_list(data.scratchpad and k)
                set row.innerHTML to f"<td><code>{escapeHTML(k)}</code></td><td>{escapeHTML(v)}</td>"
                sBody.appendChild(row)
            )
            
    set lBody to document.getElementById("lessons-body")
    if lBody:
        set lBody.innerHTML to ""
        set keys to Object.keys(data.lessons)
        if keys.length == 0:
            set lBody.innerHTML to "<tr><td colspan=\"2\" class=\"empty-state\">Empty</td></tr>"
        else:
            keys.forEach(given k:
                set row to document.createElement("tr")
                set v to get_list(data.lessons and k)
                set row.innerHTML to f"<td><code>{escapeHTML(k)}</code></td><td>{escapeHTML(v)}</td>"
                lBody.appendChild(row)
            )

# ---- Handle incoming telemetry daemon payloads ----
define handleDaemonMessage with msg:
    set type to msg.type
    if type == "status":
        set roleUpper to msg.role.toUpperCase()
        set nodeRole to document.getElementById("node-role")
        set nodeRole.textContent to roleUpper
        
        set nodeTerm to document.getElementById("node-term")
        set nodeTerm.textContent to f"Term {msg.term} (Raft)"
        
        set headerDid to document.getElementById("header-did")
        if msg.name && msg.name != "none":
            set headerDid.textContent to msg.name
        else:
            set headerDid.textContent to concat(substring(msg.did and 0 and 15) and "...")
        
        set didFull to document.getElementById("did-full-string")
        set didFull.textContent to msg.did
        set window.localIdentityDid to msg.did
        
        set nodePeers to document.getElementById("node-peers")
        set nodePeers.textContent to msg.peers
        
        set dhtSize to document.getElementById("dht-size")
        set dhtSize.textContent to f"{msg.dht_size} entries"

        # GitDec "update available" badge: lit when one or more watched repos
        # have advanced past the last-seen commit (pending count from the node).
        set gdBadge to document.getElementById("gitdec-update-badge")
        if gdBadge:
            if msg.gitdec_updates && msg.gitdec_updates > 0:
                set gdBadge.textContent to msg.gitdec_updates
                set_prop(gdBadge.style and "display" and "inline-block")
            else:
                set_prop(gdBadge.style and "display" and "none")

        set uiHostElect to document.getElementById("ui-host-election-status")
        if uiHostElect:
            if msg.enable_host_election == 1:
                set uiHostElect.textContent to "Enabled"
                set_prop(uiHostElect.style and "color" and "var(--neon-cyan)")
            else:
                set uiHostElect.textContent to "Disabled"
                set_prop(uiHostElect.style and "color" and "var(--text-muted)")
                
        set uiStaticHost to document.getElementById("ui-static-host-status")
        if uiStaticHost:
            if msg.is_static_host == 1:
                set uiStaticHost.textContent to "Active (Host Node)"
                set_prop(uiStaticHost.style and "color" and "var(--neon-purple)")
            else:
                set uiStaticHost.textContent to "Inactive"
                set_prop(uiStaticHost.style and "color" and "var(--text-muted)")
        
    else if type == "identity":
        set didFull to document.getElementById("did-full-string")
        set didFull.textContent to msg.did
        set window.localIdentityDid to msg.did
        
        set idNameEl to document.getElementById("identity-registered-name")
        if idNameEl:
            if msg.name && msg.name != "none":
                set idNameEl.textContent to msg.name
                set nameInput to document.getElementById("name-input")
                if nameInput && not nameInput.value:
                    set nameInput.value to msg.name
            else:
                set idNameEl.textContent to "Not Registered"
        
        set sigKeyEl to document.getElementById("signing-key-display")
        set encKeyEl to document.getElementById("encryption-key-display")
        if sigKeyEl:
            set sigKeyEl.textContent to msg.signing_key || "—"
        if encKeyEl:
            set encKeyEl.textContent to msg.encryption_key || "—"
            
    else if type == "wallet":
        set walletVal to document.getElementById("wallet-val")
        set walletVal.textContent to parseFloat(msg.balance).toFixed(2)
        
    else if type == "storage":
        set chunkCount to document.getElementById("chunk-count")
        set chunkCount.textContent to msg.chunk_count
        set storageBody to document.getElementById("storage-files-body")
        if storageBody:
            set storageBody.innerHTML to ""
            if not msg.files || msg.files.length == 0:
                set storageBody.innerHTML to "<tr><td colspan=\"4\" class=\"empty-state\">No content blocks stored.</td></tr>"
            else:
                msg.files.forEach(given f:
                    set row to document.createElement("tr")
                    set row.innerHTML to f"<td><code>{escapeHTML(f.name)}</code></td><td><code class=\"small-code\">{escapeHTML(f.hash)}</code></td><td>{escapeHTML(f.size)}</td><td><span class=\"badge badge-green\">{escapeHTML(f.type)}</span></td>"
                    storageBody.appendChild(row)
                )
                
    else if type == "pool":
        set bwUp to document.getElementById("bandwidth-up")
        set bwDown to document.getElementById("bandwidth-down")
        set computeSlots to document.getElementById("compute-slots")
        if bwUp:
            set bwUp.textContent to msg.bandwidth_up || "0"
        if bwDown:
            set bwDown.textContent to msg.bandwidth_down || "0"
        if computeSlots:
            set computeSlots.textContent to msg.compute_slots || "0"
            
    else if type == "network":
        set natMode to document.getElementById("nat-mode")
        set activeCircuits to document.getElementById("active-circuits")
        if natMode:
            set natMode.textContent to msg.nat_mode || "relay"
        if activeCircuits:
            set activeCircuits.textContent to msg.active_circuits || "0"
            
    else if type == "chat_msg":
        appendMessage(window.chatContainer and msg.sender and msg.text and "received")
        
    else if type == "ai_token":
        appendAiToken(msg.token)
        
    else if type == "tool_pending_approval":
        appendApprovalCard(msg.tool and msg.summary)
        
    else if type == "ai_complete":
        if window.currentAiResponseBubble:
            set textNode to window.currentAiResponseBubble.querySelector(".ai-text")
            if textNode:
                set aiText to textNode.textContent
                set dateStr to Date()
                set timeParts to dateStr.split(" ")
                set timeStrSec to get_list(timeParts and 4)
                set secParts to timeStrSec.split(":")
                set timeStr to concat(get_list(secParts and 0) and concat(":" and get_list(secParts and 1)))
                saveAiMessage("AI (Local Model)" and aiText and "received" and timeStr)

        set_prop(window.aiLoader.style and "display" and "none")
        set window.aiInput.disabled to false
        
        set btnSubmit to document.getElementById("btn-submit-ai")
        set btnSubmit.disabled to false
        
        set window.currentAiResponseBubble to null
        
    else if type == "ai_models":
        updateAiModelsUI(msg.models || [])
        
    else if type == "agent_memory":
        updateMemoryGraphData(msg.edges || [])
        updateMemoryTables(msg)
        
    else if type == "turing_grid":
        renderTuringGrid(msg)
        
    else if type == "platforms":
        set window.platforms to msg.data
        updatePlatformsUI()
        
    else if type == "plugins":
        set window.plugins to msg.data || []
        renderPluginsUI()
        
    else if type == "platforms_saved" || type == "plugins_saved":
        console.log(f"Daemon successfully saved configuration: {type}")
        
    else if type == "prompts":
        set window.prompts to msg.data
        updatePromptsUI()
        
    else if type == "prompts_saved":
        showPromptsStatus("Settings saved successfully!" and 1)
        
    else if type == "system_config":
        set window.systemConfig to msg.data
        updateSystemConfigUI()
        
    else if type == "system_config_saved":
        showSystemConfigStatus("Configuration saved! Restart daemon to apply network changes." and 2)
        
    else if type == "error":
        console.error(f"Daemon error: {msg.message}")
        
    else if type == "swap_result":
        if not msg.success:
            appendMessage(window.chatContainer and "system" and f"Swap failed: {msg.reason}" and "received")
            
    else if type == "dht_result":
        handleDhtResult(msg)
        
    else if type == "name_result":
        handleNameResult(msg)
        
    else if type == "session_list":
        updateSessionsUI(msg.sessions || [])
        
    else if type == "session_active" || type == "session_details":
        set sess to msg.session
        set window.activeSessionId to sess.id
        set window.aiSystemPrompt.value to sess.system_prompt || "You are a local assistant operating privately inside the ErnosDecent mesh."
        selectAiModel(sess.model || "" and true)
        set window.aiContainer.innerHTML to ""
        if not sess.messages || sess.messages.length == 0:
            appendMessageRaw(window.aiContainer and "AI (Local Model)" and "Greetings! I am loaded inside the decent_ai subsystem. My weights are decoded using Float32 fixed-point attention queries. Ask me anything." and "received" and "00:00")
        else:
            sess.messages.forEach(given m:
                set senderLabel to "AI (Local Model)"
                set msgType to "received"
                if m.role == "user":
                    set senderLabel to "You"
                    set msgType to "sent"
                appendMessageRaw(window.aiContainer and senderLabel and m.content and msgType and "00:00")
            )
            
        if sess.compression_summary && sess.compression_summary.length > 0:
            set summaryNotice to f"ℹ️ [CONTEXT COMPRESSED]\nSummary of prior conversation: {sess.compression_summary}"
            appendMessageRaw(window.aiContainer and "system" and summaryNotice and "received" and "00:00")
            
        # Re-fetch session list to update styles
        set msgSessions to Object()
        set msgSessions.type to "session_list"
        send_msg(window.ws and JSON.stringify(msgSessions))
        
    else if type == "session_active_id":
        set sess_id to msg.id
        set window.activeSessionId to sess_id
        selectSession(sess_id)
        
    else if type == "session_new_result":
        if msg.success:
            selectSession(msg.id)
            
    else if type == "session_rename_result" || type == "session_delete_result":
        set msgSessions to Object()
        set msgSessions.type to "session_list"
        send_msg(window.ws and JSON.stringify(msgSessions))
        
        if type == "session_delete_result" && window.activeSessionId == msg.id:
            selectSession("default")
            
    else if type == "onion_result":
        handleOnionResult(msg)
        
    else if type == "onion_view_result":
        handleOnionViewResult(msg)
        
    else if type == "gitdec_repos":
        updateGitDecRepos(msg.repos)

    else if type == "gitdec_auto_update_state":
        set auToggle to document.getElementById("gitdec-settings-autoupdate-toggle")
        if auToggle:
            set auToggle.checked to msg.enabled == 1

    else if type == "gitdec_merge_ok":
        alert("Merged to main and broadcast to the network.")
        set refresh to Object()
        set refresh.type to "gitdec_get_repos"
        send_msg(window.ws and JSON.stringify(refresh))

    else if type == "gitdec_merge_error":
        alert(msg.message)

    else if type == "gitdec_file":
        handleGitDecFile(msg.repo_id and msg.filename and msg.content)
        
    else if type == "gitdec_files":
        renderGitDecFiles(msg.repo_id and msg.files)
        
    else if type == "gitdec_delete_ok":
        alert("Repository deleted successfully!")
        set window.gitdecActiveRepo to null
        set noSelected to document.getElementById("gitdec-no-repo-selected")
        set detailsPanel to document.getElementById("gitdec-repo-details")
        set_prop(noSelected.style and "display" and "block")
        set_prop(detailsPanel.style and "display" and "none")
        # Refresh repo list
        set refresh to Object()
        set refresh.type to "gitdec_get_repos"
        send_msg(window.ws and JSON.stringify(refresh))
        
    else if type == "gitdec_delete_error":
        alert(concat("Error deleting repository: " and (msg.message || "Unauthorized")))
        
    else if type == "gitdec_collab_ok":
        # Refresh gitdec.json to reload collaborators list
        set refresh to Object()
        set refresh.type to "gitdec_get_repo_file"
        set refresh.repo_id to window.gitdecActiveRepo
        set refresh.filename to "gitdec.json"
        send_msg(window.ws and JSON.stringify(refresh))
        
    else if type == "gitdec_collab_error":
        alert(concat("Collaborator error: " and (msg.message || "Unauthorized")))

define handleOnionResult with msg:
    set resultsBox to document.getElementById("onion-results-box")
    if not resultsBox:
        return 0
        
    set results to msg.results
    if not results || results.length == 0:
        set resultsBox.innerHTML to "<div style='color: var(--text-muted); text-align: center; padding: 20px 0;'>No results found.</div>"
        return 0
        
    set html to ""
    results.forEach(given r:
        set decodedTitle to decodeHTMLEntities(r.title)
        set decodedSnippet to decodeHTMLEntities(r.snippet)
        set escTitle to escapeHTML(decodedTitle)
        set escUrl to escapeHTML(r.url)
        set escSnippet to escapeHTML(decodedSnippet)
        
        set html to concat(html and f"<div class=\"search-result-item\"><a class=\"search-result-title\" onclick=\"window.onionViewPage('{r.url}')\">{escTitle}</a><span class=\"search-result-url\">{escUrl}</span><p class=\"search-result-snippet\">{escSnippet}</p></div>")
    )
    set resultsBox.innerHTML to html
    return 0

define getActiveTab returning Obj:
    set activeTab to null
    window.browserTabs.forEach(given t:
        if t.id == window.activeTabId:
            set activeTab to t
    )
    return activeTab

define createBrowserTab with url and activate returning Int:
    set id to concat("tab_" and Math.random().toString(36).substring(2 and 9))
    set tab to Object()
    set tab.id to id
    set tab.url to url
    set tab.title to "New Tab"
    set tab.html to ""
    set tab.history to [url]
    set tab.historyIndex to 0
    set tab.loading to false

    window.browserTabs.push(tab)
    if activate:
        set window.activeTabId to id

    renderBrowserTabs()
    if url == "ernos://newtab":
        renderNewTabPage(tab)
    else:
        navigateTab(tab and url)
        
    return 0

define renderBrowserTabs returning Int:
    set tabbar to document.getElementById("browser-tabbar")
    if not tabbar:
        return 0
    set tabbar.innerHTML to ""

    window.browserTabs.forEach(given tab:
        set tabEl to document.createElement("div")
        set tabEl.className to "browser-tab"
        if tab.id == window.activeTabId:
            tabEl.classList.add("active")

        set iconSpan to document.createElement("span")
        set iconSpan.className to "browser-tab-icon"
        if tab.loading:
            set iconSpan.innerHTML to "<div class='modal-spinner' style='width:12px; height:12px; border-width:2px; border-top-color:var(--neon-cyan); margin:0;'></div>"
        else:
            if tab.url == "ernos://newtab":
                set iconSpan.textContent to "🌱"
            else:
                set iconSpan.textContent to "🌱"

        set titleSpan to document.createElement("span")
        set titleSpan.className to "browser-tab-title"
        set titleSpan.textContent to tab.title

        set closeBtn to document.createElement("span")
        set closeBtn.className to "browser-tab-close"
        set closeBtn.innerHTML to "&times;"
        closeBtn.addEventListener("click" and given e:
            e.stopPropagation()
            closeBrowserTab(tab.id)
        )

        tabEl.appendChild(iconSpan)
        tabEl.appendChild(titleSpan)
        tabEl.appendChild(closeBtn)

        tabEl.addEventListener("click" and given e:
            switchBrowserTab(tab.id)
        )

        tabbar.appendChild(tabEl)
    )
    return 0

define switchBrowserTab with tabId returning Int:
    set window.activeTabId to tabId
    renderBrowserTabs()
    
    set tab to null
    window.browserTabs.forEach(given t:
        if t.id == tabId:
            set tab to t
    )
    if not tab:
        return 0

    set addressInput to document.getElementById("browser-address-input")
    if addressInput:
        if tab.url == "ernos://newtab":
            set addressInput.value to ""
        else:
            set addressInput.value to tab.url

    set contentArea to document.getElementById("reader-modal-content")
    set loader to document.getElementById("reader-modal-loader")

    if tab.loading:
        set_prop(loader.style and "display" and "flex")
        set_prop(contentArea.style and "display" and "none")
    else:
        set_prop(loader.style and "display" and "none")
        set_prop(contentArea.style and "display" and "block")
        if tab.url == "ernos://newtab":
            renderNewTabPage(tab)
        else:
            set_prop(contentArea and "innerHTML" and tab.html)
            interceptViewportClicks()

    updateNavButtons(tab)
    updateStarButton(tab)
    return 0

define closeBrowserTab with tabId returning Int:
    set idx to -1
    set i to 0
    window.browserTabs.forEach(given t:
        if t.id == tabId:
            set idx to i
        set i to i + 1
    )

    if idx == -1:
        return 0

    window.browserTabs.splice(idx and 1)

    if window.browserTabs.length == 0:
        set modal to document.getElementById("reader-view-modal")
        modal.classList.remove("active")
        return 0

    if window.activeTabId == tabId:
        if idx < window.browserTabs.length:
            set tObj to Reflect.get(window.browserTabs and idx)
            set window.activeTabId to tObj.id
        else:
            set tObj to Reflect.get(window.browserTabs and window.browserTabs.length - 1)
            set window.activeTabId to tObj.id

    switchBrowserTab(window.activeTabId)
    return 0

define navigateTab with tab and url returning Int:
    set targetUrl to url.trim()
    if targetUrl == "":
        return 0

    set isSearch to false
    if string_index_of(targetUrl and " ") >= 0:
        set isSearch to true
    else:
        set hasProtocol to false
        if string_index_of(targetUrl and "://") >= 0:
            set hasProtocol to true
        
        set hasDot to false
        if string_index_of(targetUrl and ".") >= 0:
            set hasDot to true

        if not hasProtocol and not hasDot:
            set isSearch to true

    if isSearch:
        set targetUrl to concat("https://html.duckduckgo.com/html/?q=" and encodeURIComponent(targetUrl))
    else:
        if string_index_of(targetUrl and "://") < 0:
            set targetUrl to concat("https://" and targetUrl)

    set tab.url to targetUrl
    set tab.loading to true
    set tab.title to targetUrl
    
    if tab.id == window.activeTabId:
        set addressInput to document.getElementById("browser-address-input")
        if addressInput:
            set addressInput.value to targetUrl
        
        set loader to document.getElementById("reader-modal-loader")
        set contentArea to document.getElementById("reader-modal-content")
        set_prop(loader.style and "display" and "flex")
        set_prop(contentArea.style and "display" and "none")
        
        set progressBar to document.getElementById("browser-progress-bar")
        if progressBar:
            set_prop(progressBar.style and "width" and "30%")
            
        renderBrowserTabs()

    set viewMsg to Object()
    set viewMsg.type to "onion_view"
    set viewMsg.url to targetUrl
    set viewMsg.tabId to tab.id
    send_msg(window.ws and JSON.stringify(viewMsg))
    return 0

define navigateActiveTab with url and isHistoryNavigation returning Int:
    set activeTab to getActiveTab()
    if not activeTab:
        return 0
        
    if not isHistoryNavigation:
        set activeTab.history to activeTab.history.slice(0 and activeTab.historyIndex + 1)
        activeTab.history.push(url)
        set activeTab.historyIndex to activeTab.history.length - 1
        
    navigateTab(activeTab and url)
    return 0

define updateNavButtons with tab returning Int:
    set btnBack to document.getElementById("btn-browser-back")
    if btnBack:
        set btnBack.disabled to tab.historyIndex <= 0
        
    set btnForward to document.getElementById("btn-browser-forward")
    if btnForward:
        set btnForward.disabled to tab.historyIndex >= tab.history.length - 1
    return 0

define updateStarButton with tab returning Int:
    set btnStar to document.getElementById("btn-browser-star")
    if not btnStar:
        return 0
        
    if tab.url == "ernos://newtab":
        set_prop(btnStar.style and "display" and "none")
        return 0
        
    set_prop(btnStar.style and "display" and "block")
    
    set isBookmarked to false
    window.browserBookmarks.forEach(given b:
        if b.url == tab.url:
            set isBookmarked to true
    )
    
    if isBookmarked:
        btnStar.classList.add("active")
        set btnStar.textContent to "\u2605"
    else:
        btnStar.classList.remove("active")
        set btnStar.textContent to "\u2606"
    return 0

define toggleBookmarkActiveTab returning Int:
    set activeTab to getActiveTab()
    if not activeTab || activeTab.url == "ernos://newtab":
        return 0
        
    set existingIdx to -1
    set i to 0
    window.browserBookmarks.forEach(given b:
        if b.url == activeTab.url:
            set existingIdx to i
        set i to i + 1
    )
            
    if existingIdx >= 0:
        window.browserBookmarks.splice(existingIdx and 1)
    else:
        set newBookmark to Object()
        set newBookmark.title to activeTab.title
        set newBookmark.url to activeTab.url
        window.browserBookmarks.push(newBookmark)
        
    renderBookmarksBar()
    updateStarButton(activeTab)
    return 0

define renderBookmarksBar returning Int:
    set bar to document.getElementById("browser-bookmarks-bar")
    if not bar:
        return 0
        
    set bar.innerHTML to ""
    
    set homeItem to document.createElement("div")
    set homeItem.className to "browser-bookmark-item"
    set homeItem.innerHTML to "🌱 Ernos Home"
    homeItem.addEventListener("click" and given event:
        navigateActiveTab("ernos://newtab" and false)
    )
    bar.appendChild(homeItem)
    
    window.browserBookmarks.forEach(given b:
        set item to document.createElement("div")
        set item.className to "browser-bookmark-item"
        
        set shortTitle to b.title
        if shortTitle.length > 20:
            set shortTitle to concat(shortTitle.substring(0 and 17) and "...")
            
        set item.textContent to concat("🔖 " and shortTitle)
        set item.title to b.url
        item.addEventListener("click" and given event:
            navigateActiveTab(b.url and false)
        )
        bar.appendChild(item)
    )
    return 0

define resolveRelativeUrl with baseUrl and relativeUrl returning Str:
    if string_index_of(relativeUrl and "://") >= 0 || string_index_of(relativeUrl and "data:") == 0:
        return relativeUrl
        
    if string_index_of(relativeUrl and "/") == 0:
        set protoIdx to string_index_of(baseUrl and "://")
        if protoIdx >= 0:
            set afterProto to protoIdx + 3
            set firstSlash to baseUrl.indexOf("/" and afterProto)
            if firstSlash >= 0:
                set domain to baseUrl.substring(0 and firstSlash)
                return concat(domain and relativeUrl)
            else:
                return concat(baseUrl and relativeUrl)
        else:
            return relativeUrl
            
    set lastSlash to baseUrl.lastIndexOf("/")
    set protoIdx to string_index_of(baseUrl and "://")
    if lastSlash <= protoIdx + 2:
        return concat(concat(baseUrl and "/") and relativeUrl)
        
    set baseFolder to baseUrl.substring(0 and lastSlash + 1)
    return concat(baseFolder and relativeUrl)

define interceptViewportClicks returning Int:
    set contentArea to document.getElementById("reader-modal-content")
    if not contentArea:
        return 0
        
    set links to contentArea.querySelectorAll("a")
    links.forEach(given aLink:
        aLink.addEventListener("click" and given event:
            event.preventDefault()
            set href to aLink.getAttribute("href")
            if href:
                set activeTab to getActiveTab()
                set absoluteUrl to resolveRelativeUrl(activeTab.url and href)
                navigateActiveTab(absoluteUrl and false)
        )
    )
    return 0

define renderNewTabPage with tab returning Int:
    set contentArea to document.getElementById("reader-modal-content")
    if tab.id != window.activeTabId:
        return 0
        
    set newTabHtml to "<div class=\"newtab-container\"><div class=\"newtab-logo\">&#x1F331;</div><div class=\"newtab-title\">Ernos Private Browser</div><div class=\"newtab-search-box\"><form id=\"newtab-search-form\" class=\"newtab-search-form\" onsubmit=\"return false;\"><input type=\"text\" id=\"newtab-search-input\" class=\"newtab-search-input\" placeholder=\"Search privately with DuckDuckGo or enter URL...\" required><button type=\"submit\" class=\"newtab-search-btn\">Search</button></form></div><div class=\"newtab-grid\"><div class=\"newtab-shortcut\" id=\"shortcut-ddg\"><span class=\"newtab-shortcut-icon\">&#x1F50D;</span><span class=\"newtab-shortcut-title\">DuckDuckGo</span></div><div class=\"newtab-shortcut\" id=\"shortcut-wiki\"><span class=\"newtab-shortcut-icon\">&#x1F4D6;</span><span class=\"newtab-shortcut-title\">Wikipedia</span></div><div class=\"newtab-shortcut\" id=\"shortcut-tor\"><span class=\"newtab-shortcut-icon\">&#x1F9C5;</span><span class=\"newtab-shortcut-title\">Tor Project</span></div><div class=\"newtab-shortcut\" id=\"shortcut-github\"><span class=\"newtab-shortcut-icon\">&#x1F47E;</span><span class=\"newtab-shortcut-title\">GitHub</span></div></div><div class=\"newtab-circuit-info\"><strong>&#x1F512; Secure DHT Onion Circuit:</strong> Traffic is encrypted and routed through multiple nodes of the Ernos decentralized network. No tracking, no censorship.</div></div>"
    
    set_prop(contentArea and "innerHTML" and newTabHtml)
    
    set form to document.getElementById("newtab-search-form")
    if form:
        form.addEventListener("submit" and given event:
            set inputVal to document.getElementById("newtab-search-input").value
            navigateActiveTab(inputVal and false)
        )
        
    set scDdg to document.getElementById("shortcut-ddg")
    if scDdg:
        scDdg.addEventListener("click" and given event: 
            navigateActiveTab("https://html.duckduckgo.com/html/" and false)
        )
    set scWiki to document.getElementById("shortcut-wiki")
    if scWiki:
        scWiki.addEventListener("click" and given event: 
            navigateActiveTab("https://www.wikipedia.org" and false)
        )
    set scTor to document.getElementById("shortcut-tor")
    if scTor:
        scTor.addEventListener("click" and given event: 
            navigateActiveTab("https://www.torproject.org" and false)
        )
    set scGithub to document.getElementById("shortcut-github")
    if scGithub:
        scGithub.addEventListener("click" and given event: 
            navigateActiveTab("https://github.com" and false)
        )
    return 0

define handleOnionViewResult with msg:
    set tabId to msg.tabId
    set targetTab to null
    
    window.browserTabs.forEach(given t:
        if t.id == tabId:
            set targetTab to t
    )
    
    if not targetTab:
        window.browserTabs.forEach(given t:
            if t.id == window.activeTabId:
                set targetTab to t
        )
        
    if not targetTab:
        return 0

    set targetTab.loading to false
    set targetTab.html to msg.html
    
    set title to "Page Title"
    set htmlLower to msg.html.toLowerCase()
    set tStart to htmlLower.indexOf("<title>")
    if tStart >= 0:
        set tEnd to htmlLower.indexOf("</title>" and tStart)
        if tEnd >= 0:
            set title to msg.html.substring(tStart + 7 and tEnd).trim()
        else:
            set urlParts to msg.url.split("/")
            if urlParts.length > 2:
                set title to Reflect.get(urlParts and 2)
            else:
                set title to msg.url
    else:
        set urlParts to msg.url.split("/")
        if urlParts.length > 2:
            set title to Reflect.get(urlParts and 2)
        else:
            set title to msg.url
            
    set targetTab.title to title
    
    if targetTab.id == window.activeTabId:
        set progressBar to document.getElementById("browser-progress-bar")
        if progressBar:
            set_prop(progressBar.style and "width" and "100%")
            setTimeout(given dummy:
                set_prop(progressBar.style and "width" and "0%")
            and 500)
            
        set loader to document.getElementById("reader-modal-loader")
        set contentArea to document.getElementById("reader-modal-content")
        set_prop(loader.style and "display" and "none")
        set_prop(contentArea.style and "display" and "block")
        set_prop(contentArea and "innerHTML" and concat(f"<base href=\"{targetTab.url}\">" and msg.html))
        
        interceptViewportClicks()
        
    renderBrowserTabs()
    
    set activeTab to getActiveTab()
    if activeTab:
        updateNavButtons(activeTab)
        updateStarButton(activeTab)
        
    return 0

# ---- GitDec Frontend Functions ----
define updateGitDecRepos with reposStr:
    set listContainer to document.getElementById("gitdec-repo-list")
    if not listContainer:
        return 0
    set listContainer.innerHTML to ""
    
    if string_length(reposStr) == 0:
        set listContainer.innerHTML to "<div style='color: var(--text-muted); text-align: center; padding: 20px;'>No repositories loaded.</div>"
        return 0
        
    set parts to reposStr.split(";")
    parts.forEach(given repoId:
        if string_length(repoId) > 0:
            set row to document.createElement("div")
            set row.className to "log-entry"
            set_prop(row.style and "cursor" and "pointer")
            set_prop(row.style and "margin-bottom" and "5px")
            set_prop(row.style and "padding" and "10px")
            set_prop(row.style and "border-radius" and "6px")
            set_prop(row.style and "background" and "rgba(255,255,255,0.03)")
            set_prop(row and "innerHTML" and f"<strong>📁 {escapeHTML(repoId)}</strong>")
            
            row.addEventListener("click" and given event:
                selectGitDecRepo(repoId)
            )
            listContainer.appendChild(row)
    )
    return 0

define selectGitDecRepo with repoId:
    set window.gitdecActiveRepo to repoId
    
    set noSelected to document.getElementById("gitdec-no-repo-selected")
    set detailsPanel to document.getElementById("gitdec-repo-details")
    set_prop(noSelected.style and "display" and "none")
    set_prop(detailsPanel.style and "display" and "block")
    
    set activeIdEl to document.getElementById("gitdec-active-repo-id")
    set activeIdEl.textContent to repoId
    
    # Reset file viewer
    set viewerName to document.getElementById("gitdec-active-file-name")
    set viewerContent to document.getElementById("gitdec-file-viewer")
    if viewerName:
        set viewerName.textContent to "Select a file to view"
    if viewerContent:
        set viewerContent.textContent to ""
        
    # Request files from daemon
    set msg1 to Object()
    set msg1.type to "gitdec_get_repo_file"
    set msg1.repo_id to repoId
    set msg1.filename to "gitdec.json"
    send_msg(window.ws and JSON.stringify(msg1))
    
    set msg2 to Object()
    set msg2.type to "gitdec_get_repo_file"
    set msg2.repo_id to repoId
    set msg2.filename to "issues.json"
    send_msg(window.ws and JSON.stringify(msg2))
    
    set msg3 to Object()
    set msg3.type to "gitdec_get_repo_file"
    set msg3.repo_id to repoId
    set msg3.filename to "pull_requests.json"
    send_msg(window.ws and JSON.stringify(msg3))
    
    # Request files list
    set msgFileList to Object()
    set msgFileList.type to "gitdec_list_files"
    set msgFileList.repo_id to repoId
    send_msg(window.ws and JSON.stringify(msgFileList))
    
    return 0

define handleGitDecFile with repoId and filename and content:
    if repoId equals "ErnosDecent" and also (filename equals "docs/gitdec_user_guide.md" or else filename equals "docs/system_guide_synthesis.md" or else filename equals "docs/ERNOS_REFERENCE.md" or else filename equals "README.md" or else filename equals "docs/settings_guide.md" or else filename equals "docs/identity_registry_guide.md" or else filename equals "docs/network_dht_guide.md" or else filename equals "docs/resource_pooling_guide.md" or else filename equals "docs/turing_hebbian_guide.md" or else filename equals "docs/messaging_social_guide.md" or else filename equals "docs/storage_crdt_guide.md" or else filename equals "docs/ledger_dex_guide.md"):
        set guideViewer to document.getElementById("guide-text-content")
        if guideViewer:
            set guideViewer.textContent to content
        return 0

    if repoId != window.gitdecActiveRepo:
        return 0
        
    if filename == "gitdec.json":
        if string_length(content) == 0:
            return 0
        set manifest to JSON.parse(content)
        set titleEl to document.getElementById("gitdec-active-repo-name")
        set titleEl.textContent to manifest.name || repoId
        
        # Populate branch select
        set branchSelect to document.getElementById("gitdec-active-branch")
        set branchSelect.innerHTML to ""
        if manifest.ref_heads:
            set branches to Object.keys(manifest.ref_heads)
            branches.forEach(given b:
                set opt to document.createElement("option")
                set opt.value to b
                set opt.textContent to b
                branchSelect.appendChild(opt)
            )
            if branches.indexOf("main") < 0:
                set opt to document.createElement("option")
                set opt.value to "main"
                set opt.textContent to "main"
                branchSelect.appendChild(opt)
        else:
            set opt to document.createElement("option")
            set opt.value to "main"
            set opt.textContent to "main"
            branchSelect.appendChild(opt)
            
        set commitListEl to document.getElementById("gitdec-commit-list")
        set commitListEl.innerHTML to ""
        if manifest.ref_heads:
            set b_keys to Object.keys(manifest.ref_heads)
            b_keys.forEach(given bName:
                set c_hash to get_list(manifest.ref_heads and bName)
                set row to document.createElement("div")
                set row.className to "log-entry"
                set_prop(row and "innerHTML" and f"<span style='color: var(--neon-cyan);'>[{escapeHTML(bName)}]</span> commit <code style='color: var(--neon-purple);'>{escapeHTML(c_hash)}</code>")
                commitListEl.appendChild(row)
            )
        else:
            set commitListEl.innerHTML to "<div class='log-entry' style='color: var(--text-muted);'>No commits found. Pushes will appear here.</div>"
            
        set window.gitdecActiveManifest to manifest
        
        # Populate Settings repository info
        set sRepoName to document.getElementById("gitdec-settings-repo-name")
        set sRepoId to document.getElementById("gitdec-settings-repo-id")
        if sRepoName && sRepoId:
            set sRepoName.textContent to manifest.name || repoId
            set sRepoId.textContent to repoId

        # Query this node's current auto-update setting for the repo so the
        # toggle reflects real local state (it is per-node, not in the manifest).
        set auQuery to Object()
        set auQuery.type to "gitdec_get_auto_update"
        set auQuery.repo_id to repoId
        send_msg(window.ws and JSON.stringify(auQuery))

        # Render Settings collaborators list
        set listEl to document.getElementById("gitdec-settings-collabs-list")
        if listEl:
            set listEl.innerHTML to ""
            
            set isOwner to 0
            if window.localIdentityDid && manifest.authorized_collaborators:
                set localRole to get_list(manifest.authorized_collaborators and window.localIdentityDid)
                if localRole equals "owner":
                    set isOwner to 1
                    
            if manifest.authorized_collaborators:
                set keys to Object.keys(manifest.authorized_collaborators)
                if keys.length > 0:
                    keys.forEach(given k:
                        set r to get_list(manifest.authorized_collaborators and k)
                        set row to document.createElement("div")
                        set row.className to "log-entry"
                        set_prop(row.style and "display" and "flex")
                        set_prop(row.style and "justify-content" and "space-between")
                        set_prop(row.style and "align-items" and "center")
                        set_prop(row.style and "margin-bottom" and "8px")
                        
                        set innerHTMLVal to f"<div><span class='badge badge-cyan' style='margin-right: 8px;'>{escapeHTML(r)}</span><code style='font-size:0.8rem; word-break: break-all;'>{escapeHTML(k)}</code></div>"
                        
                        if isOwner == 1 && (r equals "owner") == 0:
                            set innerHTMLVal to concat(innerHTMLVal and f"<button class='btn-danger btn-sm gitdec-btn-remove-collab' data-collab-did='{escapeHTML(k)}' style='background:#ef4444; border:none; color:white; padding:4px 8px; border-radius:4px; font-size:0.75rem; cursor:pointer;'>Remove</button>")
                            
                        set_prop(row and "innerHTML" and innerHTMLVal)
                        listEl.appendChild(row)
                    )
                    
                    # Bind click listeners to remove buttons
                    set removeBtns to listEl.querySelectorAll(".gitdec-btn-remove-collab")
                    removeBtns.forEach(given btn:
                        btn.addEventListener("click" and given e:
                            set targetDid to btn.getAttribute("data-collab-did")
                            if confirm(f"Are you sure you want to remove collaborator {targetDid}?"):
                                set removeMsg to Object()
                                set removeMsg.type to "gitdec_remove_collab"
                                set removeMsg.repo_id to repoId
                                set removeMsg.collab_did to targetDid
                                send_msg(window.ws and JSON.stringify(removeMsg))
                        )
                    )
                else:
                    set listEl.innerHTML to "<div class='log-entry' style='color: var(--text-muted);'>No collaborators loaded.</div>"
            else:
                set listEl.innerHTML to "<div class='log-entry' style='color: var(--text-muted);'>No collaborators loaded.</div>"
        
    else if filename == "issues.json":
        set issueListEl to document.getElementById("gitdec-issue-list")
        set issueListEl.innerHTML to ""
        
        if string_length(content) == 0:
            set issueListEl.innerHTML to "<div class='log-entry' style='color: var(--text-muted);'>No issues found.</div>"
            return 0
            
        set data to JSON.parse(content)
        if not data.issues || data.issues.length == 0:
            set issueListEl.innerHTML to "<div class='log-entry' style='color: var(--text-muted);'>No issues found.</div>"
            return 0
            
        data.issues.forEach(given issue:
            set row to document.createElement("div")
            set row.className to "log-entry"
            set_prop(row.style and "cursor" and "pointer")
            set badgeClass to "badge-green"
            if issue.status != "open":
                set badgeClass to "badge-muted"
            set_prop(row and "innerHTML" and f"<strong>#{escapeHTML(issue.id)}</strong> {escapeHTML(issue.title)} <span class='badge {badgeClass}' style='float:right;'>{escapeHTML(issue.status)}</span>")
            
            row.addEventListener("click" and given event:
                showGitDecIssueDetail(issue)
            )
            issueListEl.appendChild(row)
        )
        
    else if filename == "pull_requests.json":
        set prListEl to document.getElementById("gitdec-pr-list")
        set prListEl.innerHTML to ""
        
        if string_length(content) == 0:
            set prListEl.innerHTML to "<div class='log-entry' style='color: var(--text-muted);'>No PRs found.</div>"
            return 0
            
        set data to JSON.parse(content)
        if not data.pull_requests || data.pull_requests.length == 0:
            set prListEl.innerHTML to "<div class='log-entry' style='color: var(--text-muted);'>No PRs found.</div>"
            return 0
            
        data.pull_requests.forEach(given pr:
            set row to document.createElement("div")
            set row.className to "log-entry"
            set_prop(row.style and "cursor" and "pointer")
            set badgeClass to "badge-cyan"
            if pr.status == "approved":
                set badgeClass to "badge-green"
            else if pr.status != "open":
                set badgeClass to "badge-muted"
            set_prop(row and "innerHTML" and f"<strong>#{escapeHTML(pr.id)}</strong> {escapeHTML(pr.title)} <span class='badge {badgeClass}' style='float:right;'>{escapeHTML(pr.status)}</span>")
            
            row.addEventListener("click" and given event:
                showGitDecPrDetail(pr)
            )
            prListEl.appendChild(row)
        )
    else:
        set activeFileSpan to document.getElementById("gitdec-active-file-name")
        set fileViewer to document.getElementById("gitdec-file-viewer")
        if activeFileSpan && fileViewer:
            set activeFileSpan.textContent to filename
            set fileViewer.textContent to content
    return 0

define renderGitDecFiles with repoId and filesStr:
    if repoId != window.gitdecActiveRepo:
        return 0
        
    set fileListEl to document.getElementById("gitdec-file-list")
    if not fileListEl:
        return 0
        
    set fileListEl.innerHTML to ""
    
    if string_length(filesStr) == 0:
        set fileListEl.innerHTML to "<div class='log-entry' style='color: var(--text-muted);'>No files found.</div>"
        return 0
        
    set files to filesStr.split(";")
    set count to 0
    files.forEach(given f:
        if f != "gitdec.json" && f != "issues.json" && f != "pull_requests.json" && f != "objects" && f != ".git" && f != ".DS_Store":
            set row to document.createElement("div")
            set row.className to "log-entry"
            set_prop(row.style and "cursor" and "pointer")
            set_prop(row.style and "padding" and "6px 8px")
            set_prop(row.style and "border-radius" and "4px")
            set_prop(row.style and "margin-bottom" and "4px")
            set row.textContent to f
            
            row.addEventListener("mouseover" and given e:
                set_prop(row.style and "background" and "rgba(255,255,255,0.05)")
            )
            row.addEventListener("mouseout" and given e:
                set_prop(row.style and "background" and "transparent")
            )
            
            row.addEventListener("click" and given e:
                set items to fileListEl.querySelectorAll(".log-entry")
                items.forEach(given item:
                    set_prop(item.style and "color" and "var(--text-color)")
                    set_prop(item.style and "font-weight" and "normal")
                )
                set_prop(row.style and "color" and "var(--neon-cyan)")
                set_prop(row.style and "font-weight" and "bold")
                
                set viewerHeader to document.getElementById("gitdec-active-file-name")
                set viewerHeader.textContent to concat("Loading " and f)
                
                set msg to Object()
                set msg.type to "gitdec_get_repo_file"
                set msg.repo_id to repoId
                set msg.filename to f
                send_msg(window.ws and JSON.stringify(msg))
            )
            
            fileListEl.appendChild(row)
            set count to count + 1
    )
    
    if count == 0:
        set fileListEl.innerHTML to "<div class='log-entry' style='color: var(--text-muted);'>No source files.</div>"
        
    return 0

define showGitDecIssueDetail with issue:
    set window.gitdecActiveIssue to issue
    set detailCard to document.getElementById("gitdec-issue-detail-card")
    set_prop(detailCard.style and "display" and "block")
    
    set titleEl to document.getElementById("gitdec-active-issue-title")
    set titleEl.textContent to f"#{issue.id}: {issue.title}"
    
    set commentsContainer to document.getElementById("gitdec-issue-comments")
    set commentsContainer.innerHTML to ""
    
    set bodyRow to document.createElement("div")
    set_prop(bodyRow.style and "margin-bottom" and "15px")
    set_prop(bodyRow.style and "border-bottom" and "1px solid rgba(255,255,255,0.05)")
    set_prop(bodyRow.style and "padding-bottom" and "10px")
    set_prop(bodyRow and "innerHTML" and f"<div style='font-weight:bold; color:var(--neon-cyan);'>{escapeHTML(issue.author)}</div><div style='margin-top:5px;'>{escapeHTML(issue.body)}</div>")
    commentsContainer.appendChild(bodyRow)
    
    if issue.comments:
        issue.comments.forEach(given comment:
            set row to document.createElement("div")
            set_prop(row.style and "margin-bottom" and "10px")
            set_prop(row and "innerHTML" and f"<div style='font-size:0.8rem; color:var(--text-muted);'>{escapeHTML(comment.author)} commented:</div><div style='margin-top:2px;'>{escapeHTML(comment.text)}</div>")
            commentsContainer.appendChild(row)
        )
    return 0

define showGitDecPrDetail with pr:
    set window.gitdecActivePr to pr
    set detailCard to document.getElementById("gitdec-pr-detail-card")
    set_prop(detailCard.style and "display" and "block")
    
    set titleEl to document.getElementById("gitdec-active-pr-title")
    set titleEl.textContent to f"#{pr.id}: {pr.title}"
    
    set branchEl to document.getElementById("gitdec-active-pr-branches")
    set branchEl.textContent to f"merge: {pr.source_branch} -> {pr.target_branch}"
    
    set reviewsContainer to document.getElementById("gitdec-pr-reviews")
    set reviewsContainer.innerHTML to ""
    
    set descRow to document.createElement("div")
    set_prop(descRow.style and "margin-bottom" and "15px")
    set_prop(descRow.style and "border-bottom" and "1px solid rgba(255,255,255,0.05)")
    set_prop(descRow.style and "padding-bottom" and "10px")
    set_prop(descRow and "innerHTML" and f"<div style='font-weight:bold; color:var(--neon-cyan);'>{escapeHTML(pr.author)}</div><div style='margin-top:5px;'>{escapeHTML(pr.description)}</div>")
    reviewsContainer.appendChild(descRow)
    
    if pr.reviews:
        pr.reviews.forEach(given review:
            set row to document.createElement("div")
            set_prop(row.style and "margin-bottom" and "10px")
            set badgeColor to "var(--neon-cyan)"
            if review.decision == "approve":
                set badgeColor to "var(--neon-green)"
            else:
                set badgeColor to "var(--neon-red)"
            set_prop(row and "innerHTML" and f"<div style='font-size:0.8rem; color:var(--text-muted);'>{escapeHTML(review.reviewer)} reviewed (<span style='color:{badgeColor};font-weight:bold;'>{escapeHTML(review.decision)}</span>):</div><div style='margin-top:2px;'>{escapeHTML(review.comment)}</div>")
            reviewsContainer.appendChild(row)
        )
    return 0

define initGuide returning Int:
    set navList to document.getElementById("guide-nav-list")
    if not navList:
        return 0
        
    set btns to navList.querySelectorAll("button")
    btns.forEach(given btn:
        btn.addEventListener("click" and given e:
            btns.forEach(given b:
                b.classList.remove("active")
            )
            btn.classList.add("active")
            
            set file to btn.getAttribute("data-guide-file")
            
            set viewer to document.getElementById("guide-text-content")
            if viewer:
                set viewer.textContent to concat("Loading " and file)
                
            set msg to Object()
            set msg.type to "gitdec_get_repo_file"
            set msg.repo_id to "ErnosDecent"
            set msg.filename to file
            send_msg(window.ws and JSON.stringify(msg))
        )
    )
    
    # Load default doc
    set activeBtn to navList.querySelector("button.active")
    if activeBtn:
        set file to activeBtn.getAttribute("data-guide-file")
        set msg to Object()
        set msg.type to "gitdec_get_repo_file"
        set msg.repo_id to "ErnosDecent"
        set msg.filename to file
        send_msg(window.ws and JSON.stringify(msg))
        
    return 0

define initGitDec returning Int:
    set commitsBtn to document.getElementById("gitdec-tab-commits")
    set filesBtn to document.getElementById("gitdec-tab-files")
    set issuesBtn to document.getElementById("gitdec-tab-issues")
    set prsBtn to document.getElementById("gitdec-tab-prs")
    set settingsBtn to document.getElementById("gitdec-tab-settings")
    
    set commitsPanel to document.getElementById("gitdec-panel-commits")
    set filesPanel to document.getElementById("gitdec-panel-files")
    set issuesPanel to document.getElementById("gitdec-panel-issues")
    set prsPanel to document.getElementById("gitdec-panel-prs")
    set settingsPanel to document.getElementById("gitdec-panel-settings")
    
    if commitsBtn && filesBtn && issuesBtn && prsBtn && settingsBtn:
        commitsBtn.addEventListener("click" and given event:
            commitsBtn.classList.add("active")
            filesBtn.classList.remove("active")
            issuesBtn.classList.remove("active")
            prsBtn.classList.remove("active")
            settingsBtn.classList.remove("active")
            set_prop(commitsPanel.style and "display" and "block")
            set_prop(filesPanel.style and "display" and "none")
            set_prop(issuesPanel.style and "display" and "none")
            set_prop(prsPanel.style and "display" and "none")
            set_prop(settingsPanel.style and "display" and "none")
        )
        filesBtn.addEventListener("click" and given event:
            commitsBtn.classList.remove("active")
            filesBtn.classList.add("active")
            issuesBtn.classList.remove("active")
            prsBtn.classList.remove("active")
            settingsBtn.classList.remove("active")
            set_prop(commitsPanel.style and "display" and "none")
            set_prop(filesPanel.style and "display" and "block")
            set_prop(issuesPanel.style and "display" and "none")
            set_prop(prsPanel.style and "display" and "none")
            set_prop(settingsPanel.style and "display" and "none")
        )
        issuesBtn.addEventListener("click" and given event:
            commitsBtn.classList.remove("active")
            filesBtn.classList.remove("active")
            issuesBtn.classList.add("active")
            prsBtn.classList.remove("active")
            settingsBtn.classList.remove("active")
            set_prop(commitsPanel.style and "display" and "none")
            set_prop(filesPanel.style and "display" and "none")
            set_prop(issuesPanel.style and "display" and "block")
            set_prop(prsPanel.style and "display" and "none")
            set_prop(settingsPanel.style and "display" and "none")
        )
        prsBtn.addEventListener("click" and given event:
            commitsBtn.classList.remove("active")
            filesBtn.classList.remove("active")
            issuesBtn.classList.remove("active")
            prsBtn.classList.add("active")
            settingsBtn.classList.remove("active")
            set_prop(commitsPanel.style and "display" and "none")
            set_prop(filesPanel.style and "display" and "none")
            set_prop(issuesPanel.style and "display" and "none")
            set_prop(prsPanel.style and "display" and "block")
            set_prop(settingsPanel.style and "display" and "none")
        )
        settingsBtn.addEventListener("click" and given event:
            commitsBtn.classList.remove("active")
            filesBtn.classList.remove("active")
            issuesBtn.classList.remove("active")
            prsBtn.classList.remove("active")
            settingsBtn.classList.add("active")
            set_prop(commitsPanel.style and "display" and "none")
            set_prop(filesPanel.style and "display" and "none")
            set_prop(issuesPanel.style and "display" and "none")
            set_prop(prsPanel.style and "display" and "none")
            set_prop(settingsPanel.style and "display" and "block")
        )
    
    set btnNewRepo to document.getElementById("gitdec-btn-new-repo")
    set modalNewRepo to document.getElementById("gitdec-modal-create-repo")
    set btnCloseNewRepo to document.getElementById("gitdec-btn-close-create-repo")
    if btnNewRepo && modalNewRepo && btnCloseNewRepo:
        btnNewRepo.addEventListener("click" and given event:
            modalNewRepo.classList.add("active")
        )
        btnCloseNewRepo.addEventListener("click" and given event:
            modalNewRepo.classList.remove("active")
        )
        
    set btnCloneRepo to document.getElementById("gitdec-btn-clone-repo")
    set modalCloneRepo to document.getElementById("gitdec-modal-clone-repo")
    set btnCloseCloneRepo to document.getElementById("gitdec-btn-close-clone-repo")
    if btnCloneRepo && modalCloneRepo && btnCloseCloneRepo:
        btnCloneRepo.addEventListener("click" and given event:
            modalCloneRepo.classList.add("active")
        )
        btnCloseCloneRepo.addEventListener("click" and given event:
            modalCloneRepo.classList.remove("active")
        )

    set btnImportRepo to document.getElementById("gitdec-btn-import-repo")
    set modalImportRepo to document.getElementById("gitdec-modal-import-repo")
    set btnCloseImportRepo to document.getElementById("gitdec-btn-close-import-repo")
    if btnImportRepo && modalImportRepo && btnCloseImportRepo:
        btnImportRepo.addEventListener("click" and given event:
            modalImportRepo.classList.add("active")
        )
        btnCloseImportRepo.addEventListener("click" and given event:
            modalImportRepo.classList.remove("active")
        )

    set btnNewIssue to document.getElementById("gitdec-btn-new-issue")
    set modalNewIssue to document.getElementById("gitdec-modal-create-issue")
    set btnCloseNewIssue to document.getElementById("gitdec-btn-close-create-issue")
    if btnNewIssue && modalNewIssue && btnCloseNewIssue:
        btnNewIssue.addEventListener("click" and given event:
            modalNewIssue.classList.add("active")
        )
        btnCloseNewIssue.addEventListener("click" and given event:
            modalNewIssue.classList.remove("active")
        )
        
    set btnNewPr to document.getElementById("gitdec-btn-new-pr")
    set modalNewPr to document.getElementById("gitdec-modal-create-pr")
    set btnCloseNewPr to document.getElementById("gitdec-btn-close-create-pr")
    if btnNewPr && modalNewPr && btnCloseNewPr:
        btnNewPr.addEventListener("click" and given event:
            modalNewPr.classList.add("active")
        )
        btnCloseNewPr.addEventListener("click" and given event:
            modalNewPr.classList.remove("active")
        )
        
    set btnDeleteRepo to document.getElementById("gitdec-btn-delete-repo")
    if btnDeleteRepo:
        btnDeleteRepo.addEventListener("click" and given event:
            if confirm("Are you sure you want to permanently delete this repository from this node and request other nodes to clean it up?"):
                set msg to Object()
                set msg.type to "gitdec_delete_repo"
                set msg.repo_id to window.gitdecActiveRepo
                send_msg(window.ws and JSON.stringify(msg))
        )

    set autoUpdateToggle to document.getElementById("gitdec-settings-autoupdate-toggle")
    if autoUpdateToggle:
        autoUpdateToggle.addEventListener("change" and given event:
            set msg to Object()
            set msg.type to "gitdec_set_auto_update"
            set msg.repo_id to window.gitdecActiveRepo
            if autoUpdateToggle.checked:
                set msg.enabled to 1
            else:
                set msg.enabled to 0
            send_msg(window.ws and JSON.stringify(msg))
        )

    set btnMergeMain to document.getElementById("gitdec-btn-merge-main")
    if btnMergeMain:
        btnMergeMain.addEventListener("click" and given event:
            set branchSel to document.getElementById("gitdec-active-branch")
            set srcBranch to branchSel.value
            if srcBranch == "main":
                alert("Select a non-main branch to merge into main.")
            else:
                if confirm(concat("Merge branch '" and concat(srcBranch and "' into main and broadcast to the network?"))):
                    set msg to Object()
                    set msg.type to "gitdec_merge"
                    set msg.repo_id to window.gitdecActiveRepo
                    set msg.source_branch to srcBranch
                    send_msg(window.ws and JSON.stringify(msg))
        )

    set formCreateRepo to document.getElementById("gitdec-form-create-repo")
    if formCreateRepo:
        formCreateRepo.addEventListener("submit" and given event:
            event.preventDefault()
            set repoIdInput to document.getElementById("gitdec-input-repo-id")
            set repoNameInput to document.getElementById("gitdec-input-repo-name")
            set repoId to repoIdInput.value
            set name to repoNameInput.value
            
            set msg to Object()
            set msg.type to "gitdec_create_repo"
            set msg.repo_id to repoId
            set msg.name to name
            send_msg(window.ws and JSON.stringify(msg))
            
            modalNewRepo.classList.remove("active")
            set repoIdInput.value to ""
            set repoNameInput.value to ""
            
            setTimeout(given dummy:
                set refresh to Object()
                set refresh.type to "gitdec_get_repos"
                send_msg(window.ws and JSON.stringify(refresh))
            and 500)
        )
        
    set formCloneRepo to document.getElementById("gitdec-form-clone-repo")
    if formCloneRepo:
        formCloneRepo.addEventListener("submit" and given event:
            event.preventDefault()
            set repoIdInput to document.getElementById("gitdec-input-clone-repo-id")
            set repoId to repoIdInput.value
            
            set msg to Object()
            set msg.type to "gitdec_clone_repo"
            set msg.repo_id to repoId
            send_msg(window.ws and JSON.stringify(msg))
            
            modalCloneRepo.classList.remove("active")
            set repoIdInput.value to ""
            
            setTimeout(given dummy:
                set refresh to Object()
                set refresh.type to "gitdec_get_repos"
                send_msg(window.ws and JSON.stringify(refresh))
            and 1500)
        )

    set formImportRepo to document.getElementById("gitdec-form-import-repo")
    if formImportRepo:
        formImportRepo.addEventListener("submit" and given event:
            event.preventDefault()
            set importNameInput to document.getElementById("gitdec-input-import-name")
            set importPathInput to document.getElementById("gitdec-input-import-path")
            set importName to importNameInput.value
            set importPath to importPathInput.value

            set msg to Object()
            set msg.type to "gitdec_import_repo"
            set msg.name to importName
            set msg.path to importPath
            send_msg(window.ws and JSON.stringify(msg))

            modalImportRepo.classList.remove("active")
            set importNameInput.value to ""
            set importPathInput.value to ""

            setTimeout(given dummy:
                set refresh to Object()
                set refresh.type to "gitdec_get_repos"
                send_msg(window.ws and JSON.stringify(refresh))
            and 2500)
        )

    set formSettingsAddCollab to document.getElementById("gitdec-settings-form-add-collab")
    if formSettingsAddCollab:
        formSettingsAddCollab.addEventListener("submit" and given event:
            event.preventDefault()
            set collabDidInput to document.getElementById("gitdec-settings-input-collab-did")
            set collabRoleInput to document.getElementById("gitdec-settings-select-collab-role")
            set collabDid to collabDidInput.value
            set role to collabRoleInput.value
            
            set msg to Object()
            set msg.type to "gitdec_add_collab"
            set msg.repo_id to window.gitdecActiveRepo
            set msg.collab_did to collabDid
            set msg.role to role
            send_msg(window.ws and JSON.stringify(msg))
            
            set collabDidInput.value to ""
        )
        
    set formCreateIssue to document.getElementById("gitdec-form-create-issue")
    if formCreateIssue:
        formCreateIssue.addEventListener("submit" and given event:
            event.preventDefault()
            set titleInput to document.getElementById("gitdec-input-issue-title")
            set bodyInput to document.getElementById("gitdec-input-issue-body")
            
            set msg to Object()
            set msg.type to "gitdec_create_issue"
            set msg.repo_id to window.gitdecActiveRepo
            set msg.title to titleInput.value
            set msg.body to bodyInput.value
            send_msg(window.ws and JSON.stringify(msg))
            
            modalNewIssue.classList.remove("active")
            set titleInput.value to ""
            set bodyInput.value to ""
            
            setTimeout(given dummy:
                set refresh to Object()
                set refresh.type to "gitdec_get_repo_file"
                set refresh.repo_id to window.gitdecActiveRepo
                set refresh.filename to "issues.json"
                send_msg(window.ws and JSON.stringify(refresh))
            and 500)
        )
        
    set formCommentIssue to document.getElementById("gitdec-comment-form")
    if formCommentIssue:
        formCommentIssue.addEventListener("submit" and given event:
            event.preventDefault()
            set commentInput to document.getElementById("gitdec-comment-input")
            
            set msg to Object()
            set msg.type to "gitdec_comment_issue"
            set msg.repo_id to window.gitdecActiveRepo
            set msg.issue_id to window.gitdecActiveIssue.id
            set msg.comment to commentInput.value
            send_msg(window.ws and JSON.stringify(msg))
            
            set commentInput.value to ""
            
            setTimeout(given dummy:
                set refresh to Object()
                set refresh.type to "gitdec_get_repo_file"
                set refresh.repo_id to window.gitdecActiveRepo
                set refresh.filename to "issues.json"
                send_msg(window.ws and JSON.stringify(refresh))
            and 500)
        )
        
    set formCreatePr to document.getElementById("gitdec-form-create-pr")
    if formCreatePr:
        formCreatePr.addEventListener("submit" and given event:
            event.preventDefault()
            set titleInput to document.getElementById("gitdec-input-pr-title")
            set sourceInput to document.getElementById("gitdec-input-pr-source")
            set targetInput to document.getElementById("gitdec-input-pr-target")
            set descInput to document.getElementById("gitdec-input-pr-desc")
            
            set msg to Object()
            set msg.type to "gitdec_create_pr"
            set msg.repo_id to window.gitdecActiveRepo
            set msg.title to titleInput.value
            set msg.source to sourceInput.value
            set msg.target to targetInput.value
            set msg.description to descInput.value
            send_msg(window.ws and JSON.stringify(msg))
            
            modalNewPr.classList.remove("active")
            set titleInput.value to ""
            set sourceInput.value to ""
            set descInput.value to ""
            
            setTimeout(given dummy:
                set refresh to Object()
                set refresh.type to "gitdec_get_repo_file"
                set refresh.repo_id to window.gitdecActiveRepo
                set refresh.filename to "pull_requests.json"
                send_msg(window.ws and JSON.stringify(refresh))
            and 500)
        )
        
    set formReviewPr to document.getElementById("gitdec-review-form")
    if formReviewPr:
        formReviewPr.addEventListener("submit" and given event:
            event.preventDefault()
            set commentInput to document.getElementById("gitdec-review-comment")
            set decisionSelect to document.getElementById("gitdec-review-decision")
            
            set msg to Object()
            set msg.type to "gitdec_review_pr"
            set msg.repo_id to window.gitdecActiveRepo
            set msg.pr_id to window.gitdecActivePr.id
            set msg.decision to decisionSelect.value
            set msg.comment to commentInput.value
            send_msg(window.ws and JSON.stringify(msg))
            
            set commentInput.value to ""
            
            setTimeout(given dummy:
                set refresh to Object()
                set refresh.type to "gitdec_get_repo_file"
                set refresh.repo_id to window.gitdecActiveRepo
                set refresh.filename to "pull_requests.json"
                send_msg(window.ws and JSON.stringify(refresh))
            and 500)
        )
    return 0

# ---- Document initialization / event routing ----
define main:
    # Set up global mutable parameters on window
    set window.ws to null
    set window.isConnected to false
    set window.uptimeSeconds to 0
    set window.activeChannel to "general-mesh"
    set window.activeSessionId to "default"
    set window.selectedAiModel to ""
    set window.currentAiResponseBubble to null
    set window.graphNodes to Object()
    set window.graphLinks to []
    set window.canvasElement to null
    set window.canvasCtx to null
    set window.animationFrameId to null
    set window.platforms to null
    set window.plugins to []
    
    # Store DOM handlers
    set window.chatContainer to document.getElementById("chat-messages-container")
    set window.aiContainer to document.getElementById("ai-messages-container")
    set window.aiLoader to document.getElementById("ai-loader")
    set window.aiInput to document.getElementById("ai-input-text")
    set window.aiSystemPrompt to document.getElementById("ai-system-prompt")
    set window.recipientDidInput to document.getElementById("recipient-did")
    set window.transferAmountInput to document.getElementById("transfer-amount")
    set window.swapFromAmount to document.getElementById("swap-from-amount")
    set window.swapToAmount to document.getElementById("swap-to-amount")
    set window.chatInput to document.getElementById("chat-input-text")
    set dhtCardWide to document.querySelector("#tab-network .card-wide")
    if dhtCardWide:
        dhtCardWide.classList.remove("card-wide")
        dhtCardWide.classList.add("card")
        
        set onionCard to document.createElement("div")
        set onionCard.className to "card"
        set onionCard.id to "onion-search-card"
        
        set onionSearchHtml to "<h3>Private Onion Search Browser</h3><form id=\"onion-search-form\" class=\"standard-form inline-form\" onsubmit=\"return false;\"><div class=\"form-row\"><div class=\"form-group\" style=\"flex: 0 0 120px;\"><label for=\"onion-engine\">Engine</label><select id=\"onion-engine\"><option value=\"DuckDuckGo\">DuckDuckGo</option><option value=\"Google\">Google</option><option value=\"Bing\">Bing</option></select></div><div class=\"form-group\" style=\"flex: 1;\"><label for=\"onion-query-input\">Query</label><input type=\"text\" id=\"onion-query-input\" placeholder=\"Search privately...\" required></div><button type=\"submit\" class=\"btn-primary\" id=\"btn-onion-search\">Search Privately</button></div></form><div id=\"onion-circuit-container\" style=\"display: none; margin: 20px 0;\"><div class=\"circuit-title\">Secure Onion Route:</div><svg id=\"onion-circuit-svg\" width=\"100%\" height=\"80\" viewBox=\"0 0 400 80\"><line x1=\"50\" y1=\"40\" x2=\"150\" y2=\"40\" class=\"circuit-line\" /><line x1=\"150\" y1=\"40\" x2=\"250\" y2=\"40\" class=\"circuit-line\" /><line x1=\"250\" y1=\"40\" x2=\"350\" y2=\"40\" class=\"circuit-line\" /><circle cx=\"50\" cy=\"40\" r=\"4\" class=\"circuit-pulse\" id=\"pulse-1\" style=\"display:none;\"><animate attributeName=\"cx\" from=\"50\" to=\"150\" dur=\"0.3s\" fill=\"freeze\" begin=\"indefinite\" id=\"anim-1\" /></circle><circle cx=\"150\" cy=\"40\" r=\"4\" class=\"circuit-pulse\" id=\"pulse-2\" style=\"display:none;\"><animate attributeName=\"cx\" from=\"150\" to=\"250\" dur=\"0.3s\" fill=\"freeze\" begin=\"indefinite\" id=\"anim-2\" /></circle><circle cx=\"250\" cy=\"40\" r=\"4\" class=\"circuit-pulse\" id=\"pulse-3\" style=\"display:none;\"><animate attributeName=\"cx\" from=\"250\" to=\"350\" dur=\"0.4s\" fill=\"freeze\" begin=\"indefinite\" id=\"anim-3\" /></circle><circle cx=\"50\" cy=\"40\" r=\"12\" class=\"circuit-node client\" /><text x=\"50\" y=\"43\" class=\"circuit-node-label\" text-anchor=\"middle\">UA</text><circle cx=\"150\" cy=\"40\" r=\"10\" class=\"circuit-node guard\" /><text x=\"150\" y=\"43\" class=\"circuit-node-label\" text-anchor=\"middle\">G</text><circle cx=\"250\" cy=\"40\" r=\"10\" class=\"circuit-node middle\" /><text x=\"250\" y=\"43\" class=\"circuit-node-label\" text-anchor=\"middle\">M</text><circle cx=\"350\" cy=\"40\" r=\"12\" class=\"circuit-node exit\" /><text x=\"350\" y=\"43\" class=\"circuit-node-label\" text-anchor=\"middle\">E</text><text x=\"50\" y=\"68\" class=\"circuit-node-text\" text-anchor=\"middle\">Client</text><text x=\"150\" y=\"68\" class=\"circuit-node-text\" text-anchor=\"middle\">Guard</text><text x=\"250\" y=\"68\" class=\"circuit-node-text\" text-anchor=\"middle\">Middle</text><text x=\"350\" y=\"68\" class=\"circuit-node-text\" text-anchor=\"middle\">Exit</text></svg></div><div class=\"search-results-box\" id=\"onion-results-box\"><div style=\"color: var(--text-muted); text-align: center; padding: 20px 0;\">Anonymous search results will appear here...</div></div>"
        
        set_prop(onionCard and "innerHTML" and onionSearchHtml)
        
        set networkGrid to document.querySelector("#tab-network .grid-layout")
        if networkGrid:
            if networkGrid.firstChild:
                networkGrid.insertBefore(onionCard and networkGrid.firstChild)
            else:
                networkGrid.appendChild(onionCard)

    # Inject Safe Reader View Modal overlay (Chrome-Style Browser frame)
    set readerModal to document.createElement("div")
    set readerModal.className to "modal-overlay"
    set readerModal.id to "reader-view-modal"
    
    set readerModalHtml to "<div class=\"browser-window\"><div class=\"browser-titlebar\"><div class=\"mac-dots\"><span class=\"dot close\"></span><span class=\"dot minimize\"></span><span class=\"dot maximize\"></span></div><div class=\"browser-tabbar\" id=\"browser-tabbar\"></div><button class=\"browser-add-tab-btn\" id=\"btn-browser-add-tab\">+</button><div class=\"browser-window-controls\"><button class=\"browser-close-btn\" id=\"btn-close-browser\">&times;</button></div></div><div class=\"browser-toolbar\"><div class=\"browser-nav-controls\"><button class=\"browser-nav-btn\" id=\"btn-browser-back\" title=\"Back\">&larr;</button><button class=\"browser-nav-btn\" id=\"btn-browser-forward\" title=\"Forward\">&rarr;</button><button class=\"browser-nav-btn\" id=\"btn-browser-reload\" title=\"Reload\">&#x21BB;</button><button class=\"browser-nav-btn\" id=\"btn-browser-home\" title=\"Home\">&#x2302;</button></div><div class=\"browser-address-container\"><span class=\"browser-security-icon\" id=\"browser-security-icon\">&#x1F9C5;</span><input type=\"text\" class=\"browser-address-input\" id=\"browser-address-input\" placeholder=\"Search privately or enter URL...\"><button class=\"browser-bookmark-star\" id=\"btn-browser-star\" title=\"Bookmark this page\">&#x2606;</button></div><div class=\"browser-extensions\"><button class=\"browser-ext-btn shield-active\" id=\"btn-browser-shield\" title=\"Ernos Shield: Active (Blocking Trackers)\">&#x1F6E1;</button><button class=\"browser-ext-btn\" id=\"btn-browser-menu\" title=\"Customize and control Ernos Browser\">&#x22EE;</button><div class=\"browser-menu-dropdown\" id=\"browser-menu-dropdown\" style=\"display: none;\"><div class=\"menu-item\" id=\"menu-new-tab\">New tab <span class=\"shortcut\">Ctrl+T</span></div><div class=\"menu-item\" id=\"menu-new-incognito\">New incognito tab</div><div class=\"menu-divider\"></div><div class=\"menu-item\" id=\"menu-reload\">Reload</div><div class=\"menu-item\" id=\"menu-bookmark\">Bookmark this tab</div><div class=\"menu-divider\"></div><div class=\"menu-item\" id=\"menu-history\">History</div><div class=\"menu-item\" id=\"menu-settings\">Settings</div><div class=\"menu-divider\"></div><div class=\"menu-item\" id=\"menu-exit\">Exit Browser</div></div></div></div><div class=\"browser-bookmarks-bar\" id=\"browser-bookmarks-bar\"></div><div class=\"browser-progress-bar-container\"><div class=\"browser-progress-bar\" id=\"browser-progress-bar\" style=\"width: 0%;\"></div></div><div class=\"browser-viewport\" id=\"browser-viewport\"><div class=\"modal-loader\" id=\"reader-modal-loader\" style=\"display: none;\"><div class=\"modal-spinner\"></div><span style=\"color: var(--text-muted);\">Routing through secure onion circuits...</span></div><div id=\"reader-modal-content\"></div></div></div>"
    
    set_prop(readerModal and "innerHTML" and readerModalHtml)
    document.body.appendChild(readerModal)

    # Initialize browser variables
    set window.browserTabs to []
    set window.activeTabId to ""
    set window.browserBookmarks to []
    
    # Add default bookmarks
    set ddgBookmark to Object()
    set ddgBookmark.title to "DuckDuckGo"
    set ddgBookmark.url to "https://html.duckduckgo.com/html/"
    window.browserBookmarks.push(ddgBookmark)
    
    set wikiBookmark to Object()
    set wikiBookmark.title to "Wikipedia"
    set wikiBookmark.url to "https://www.wikipedia.org"
    window.browserBookmarks.push(wikiBookmark)
    
    set torBookmark to Object()
    set torBookmark.title to "Tor Project"
    set torBookmark.url to "https://www.torproject.org"
    window.browserBookmarks.push(torBookmark)

    # Set up events for the browser
    set btnCloseBrowser to document.getElementById("btn-close-browser")
    if btnCloseBrowser:
        btnCloseBrowser.addEventListener("click" and given event:
            set modal to document.getElementById("reader-view-modal")
            modal.classList.remove("active")
        )
        
    set btnAddTab to document.getElementById("btn-browser-add-tab")
    if btnAddTab:
        btnAddTab.addEventListener("click" and given event:
            createBrowserTab("ernos://newtab" and true)
        )
        
    set btnBack to document.getElementById("btn-browser-back")
    if btnBack:
        btnBack.addEventListener("click" and given event:
            set activeTab to getActiveTab()
            if activeTab && activeTab.historyIndex > 0:
                set activeTab.historyIndex to activeTab.historyIndex - 1
                set url to Reflect.get(activeTab.history and activeTab.historyIndex)
                navigateActiveTab(url and true)
        )
        
    set btnForward to document.getElementById("btn-browser-forward")
    if btnForward:
        btnForward.addEventListener("click" and given event:
            set activeTab to getActiveTab()
            if activeTab && activeTab.historyIndex < activeTab.history.length - 1:
                set activeTab.historyIndex to activeTab.historyIndex + 1
                set url to Reflect.get(activeTab.history and activeTab.historyIndex)
                navigateActiveTab(url and true)
        )
        
    set btnReload to document.getElementById("btn-browser-reload")
    if btnReload:
        btnReload.addEventListener("click" and given event:
            set activeTab to getActiveTab()
            if activeTab:
                navigateActiveTab(activeTab.url and true)
        )
        
    set btnHome to document.getElementById("btn-browser-home")
    if btnHome:
        btnHome.addEventListener("click" and given event:
            navigateActiveTab("ernos://newtab")
        )
        
    set addressInput to document.getElementById("browser-address-input")
    if addressInput:
        addressInput.addEventListener("keydown" and given event:
            if event.key == "Enter":
                navigateActiveTab(addressInput.value and false)
        )
        
    set btnStar to document.getElementById("btn-browser-star")
    if btnStar:
        btnStar.addEventListener("click" and given event:
            toggleBookmarkActiveTab()
        )
        
    set btnMenu to document.getElementById("btn-browser-menu")
    if btnMenu:
        btnMenu.addEventListener("click" and given event:
            event.stopPropagation()
            set dropdown to document.getElementById("browser-menu-dropdown")
            if dropdown:
                if dropdown.style.display == "none":
                    set_prop(dropdown.style and "display" and "block")
                else:
                    set_prop(dropdown.style and "display" and "none")
        )
        
    # Close menu when clicking outside
    document.addEventListener("click" and given event:
        set dropdown to document.getElementById("browser-menu-dropdown")
        if dropdown:
            set_prop(dropdown.style and "display" and "none")
    )
    
    # Bind dropdown menu options
    set menuNewTab to document.getElementById("menu-new-tab")
    if menuNewTab:
        menuNewTab.addEventListener("click" and given event:
            createBrowserTab("ernos://newtab" and true)
        )
    set menuNewIncognito to document.getElementById("menu-new-incognito")
    if menuNewIncognito:
        menuNewIncognito.addEventListener("click" and given event:
            createBrowserTab("ernos://newtab" and true)
        )
    set menuReloadOption to document.getElementById("menu-reload")
    if menuReloadOption:
        menuReloadOption.addEventListener("click" and given event:
            set activeTab to getActiveTab()
            if activeTab:
                navigateActiveTab(activeTab.url and true)
        )
    set menuBookmarkOption to document.getElementById("menu-bookmark")
    if menuBookmarkOption:
        menuBookmarkOption.addEventListener("click" and given event:
            toggleBookmarkActiveTab()
        )
    set menuExitOption to document.getElementById("menu-exit")
    if menuExitOption:
        menuExitOption.addEventListener("click" and given event:
            set modal to document.getElementById("reader-view-modal")
            modal.classList.remove("active")
        )
        
    # Initialize bookmarks bar view
    renderBookmarksBar()

    set onionForm to document.getElementById("onion-search-form")
    if onionForm:
        onionForm.addEventListener("submit" and given event:
            event.preventDefault()
            set engineSelect to document.getElementById("onion-engine")
            set queryInput to document.getElementById("onion-query-input")
            set engine to engineSelect.value
            set query to queryInput.value
            
            set circuitContainer to document.getElementById("onion-circuit-container")
            set_prop(circuitContainer.style and "display" and "block")
            
            set pulse1 to document.getElementById("pulse-1")
            set pulse2 to document.getElementById("pulse-2")
            set pulse3 to document.getElementById("pulse-3")
            
            set_prop(pulse1.style and "display" and "none")
            set_prop(pulse2.style and "display" and "none")
            set_prop(pulse3.style and "display" and "none")
            
            set resultsBox to document.getElementById("onion-results-box")
            set_prop(resultsBox and "innerHTML" and "<div style='color: var(--text-muted); text-align: center; padding: 20px 0;'><div class='modal-spinner' style='width:24px; height:24px; margin:0 auto 10px auto;'></div>Routing encrypted packet through onion hops...</div>")
            
            setTimeout(given dummy:
                set_prop(pulse1.style and "display" and "block")
                set anim1 to document.getElementById("anim-1")
                anim1.beginElement()
                
                setTimeout(given dummy2:
                    set_prop(pulse2.style and "display" and "block")
                    set anim2 to document.getElementById("anim-2")
                    anim2.beginElement()
                    
                    setTimeout(given dummy3:
                        set_prop(pulse3.style and "display" and "block")
                        set anim3 to document.getElementById("anim-3")
                        anim3.beginElement()
                        
                        set searchMsg to Object()
                        set searchMsg.type to "onion_search"
                        set searchMsg.engine to engine
                        set searchMsg.query to query
                        send_msg(window.ws and JSON.stringify(searchMsg))
                    and 400)
                and 300)
            and 300)
        )

    # Attach onion view callback to window
    set window.onionViewPage to given viewUrl:
        set modal to document.getElementById("reader-view-modal")
        modal.classList.add("active")
        createBrowserTab(viewUrl and true)
    
    set navItems to document.querySelectorAll(".nav-item")
    set tabPanels to document.querySelectorAll(".tab-panel")
    set pageTitle to document.getElementById("page-title")
    
    navItems.forEach(given item:
        item.addEventListener("click" and given event:
            set targetTab to item.getAttribute("data-tab")
            window.localStorage.setItem("ernode_active_tab" and targetTab)
            navItems.forEach(given n:
                n.classList.remove("active")
            )
            tabPanels.forEach(given p:
                p.classList.remove("active")
            )
            item.classList.add("active")
            
            set targetPanel to document.getElementById(f"tab-{targetTab}")
            targetPanel.classList.add("active")
            set pageTitle.textContent to item.textContent.trim()
            
            if targetTab == "messaging":
                renderChatHistory(window.activeChannel)
            else if targetTab == "ai":
                renderAiHistory()
            else if targetTab == "guide":
                set navList to document.getElementById("guide-nav-list")
                if navList:
                    set activeBtn to navList.querySelector("button.active")
                    if activeBtn:
                        set file to activeBtn.getAttribute("data-guide-file")
                        set msg to Object()
                        set msg.type to "gitdec_get_repo_file"
                        set msg.repo_id to "ErnosDecent"
                        set msg.filename to file
                        send_msg(window.ws and JSON.stringify(msg))
                
            if window.isConnected && window.ws:
                if targetTab == "agent-memory":
                    set msg to Object()
                    set msg.type to "get_agent_memory"
                    send_msg(window.ws and JSON.stringify(msg))
                    setTimeout(given dummy:
                        initMemoryCanvas()
                    and 50)
                else if targetTab == "turing-grid":
                    set msg to Object()
                    set msg.type to "get_turing_grid"
                    send_msg(window.ws and JSON.stringify(msg))
                else if targetTab == "gitdec":
                    set msg to Object()
                    set msg.type to "gitdec_get_repos"
                    send_msg(window.ws and JSON.stringify(msg))
        )
    )
    
    setInterval(given dummy:
        if window.isConnected:
            set window.uptimeSeconds to window.uptimeSeconds + 1
            set hours to Math.floor(window.uptimeSeconds / 3600).toString().padStart(2 and "0")
            set minutes to Math.floor((window.uptimeSeconds % 3600) / 60).toString().padStart(2 and "0")
            set seconds to (window.uptimeSeconds % 60).toString().padStart(2 and "0")
            set nodeUptime to document.getElementById("node-uptime")
            set nodeUptime.textContent to f"{hours}:{minutes}:{seconds}"
    and 1000)
    
    setInterval(given dummy:
        if window.isConnected && window.ws:
            set msgStatus to Object()
            set msgStatus.type to "get_status"
            send_msg(window.ws and JSON.stringify(msgStatus))
            
            set msgWallet to Object()
            set msgWallet.type to "get_wallet"
            send_msg(window.ws and JSON.stringify(msgWallet))
            
            set msgStorage to Object()
            set msgStorage.type to "get_storage"
            send_msg(window.ws and JSON.stringify(msgStorage))
            
            set msgPool to Object()
            set msgPool.type to "get_pool"
            send_msg(window.ws and JSON.stringify(msgPool))
            
            set msgMemory to Object()
            set msgMemory.type to "get_agent_memory"
            send_msg(window.ws and JSON.stringify(msgMemory))
            
            set msgTuring to Object()
            set msgTuring.type to "get_turing_grid"
            send_msg(window.ws and JSON.stringify(msgTuring))
            
            set msgModels to Object()
            set msgModels.type to "get_ai_models"
            send_msg(window.ws and JSON.stringify(msgModels))
            
            set msgHosts to Object()
            set msgHosts.type to "dht_get"
            set msgHosts.key to "network:host_nodes"
            send_msg(window.ws and JSON.stringify(msgHosts))
    and 10000)
    
    set transferForm to document.getElementById("transfer-form")
    transferForm.addEventListener("submit" and given event:
        event.preventDefault()
        if not window.isConnected:
            return 0
        set recipient to window.recipientDidInput.value
        set amount to parseFloat(window.transferAmountInput.value)
        if isNaN(amount) || amount <= 0:
            return 0
            
        set msg to Object()
        set msg.type to "transfer"
        set_prop(msg and "to" and recipient)
        set msg.amount to amount.toString()
        send_msg(window.ws and JSON.stringify(msg))
        
        set window.recipientDidInput.value to ""
        set window.transferAmountInput.value to ""
    )
    
    window.swapFromAmount.addEventListener("input" and given event:
        set val to parseFloat(window.swapFromAmount.value)
        if isNaN(val) || val <= 0:
            set window.swapToAmount.value to ""
        else:
            set window.swapToAmount.value to "N/A"
    )
    
    set btnSwapTokens to document.getElementById("btn-swap-tokens")
    btnSwapTokens.addEventListener("click" and given event:
        if not window.isConnected:
            return 0
        set fromVal to parseFloat(window.swapFromAmount.value)
        if isNaN(fromVal) || fromVal <= 0:
            return 0
            
        set msg to Object()
        set msg.type to "swap"
        set msg.from_token to document.getElementById("swap-from-token").value
        set msg.to_token to document.getElementById("swap-to-token").value
        set msg.amount to fromVal.toString()
        send_msg(window.ws and JSON.stringify(msg))
        
        set window.swapFromAmount.value to ""
        set window.swapToAmount.value to ""
    )
    
    set chatForm to document.getElementById("chat-send-form")
    chatForm.addEventListener("submit" and given event:
        event.preventDefault()
        set text to window.chatInput.value.trim()
        if not text || not window.isConnected:
            return 0
            
        appendMessage(window.chatContainer and "You" and text and "sent")
        set window.chatInput.value to ""
        
        set msg to Object()
        set msg.type to "send_chat"
        set msg.text to text
        send_msg(window.ws and JSON.stringify(msg))
    )
    
    set aiForm to document.getElementById("ai-send-form")
    aiForm.addEventListener("submit" and given event:
        event.preventDefault()
        set prompt to window.aiInput.value.trim()
        if not prompt || not window.isConnected:
            return 0
            
        appendMessage(window.aiContainer and "You" and prompt and "sent")
        set window.aiInput.value to ""
        set_prop(window.aiLoader.style and "display" and "flex")
        set window.aiInput.disabled to true
        
        set btnSubmit to document.getElementById("btn-submit-ai")
        set btnSubmit.disabled to true
        
        set msg to Object()
        set msg.type to "ai_prompt"
        set msg.prompt to prompt
        set msg.system to window.aiSystemPrompt.value
        set msg.model to window.selectedAiModel
        send_msg(window.ws and JSON.stringify(msg))
    )
    
    set channelBtns to document.querySelectorAll("[data-channel]")
    channelBtns.forEach(given btn:
        btn.addEventListener("click" and given event:
            set channelName to btn.getAttribute("data-channel")
            set window.activeChannel to channelName
            
            channelBtns.forEach(given b:
                b.classList.remove("active")
            )
            btn.classList.add("active")
            
            renderChatHistory(channelName)
        )
    )
    
    set aiModelSelect to document.getElementById("ai-model-select")
    if aiModelSelect:
        aiModelSelect.addEventListener("change" and given event:
            selectAiModel(event.target.value and false)
        )
        
    if window.aiModelsListContainer:
        window.aiModelsListContainer.addEventListener("click" and given event:
            set btn to event.target.closest("[data-model]")
            if btn:
                set modelName to btn.getAttribute("data-model")
                selectAiModel(modelName and false)
        )
        
    set btnRefreshHosts to document.getElementById("btn-refresh-hosts")
    if btnRefreshHosts:
        btnRefreshHosts.addEventListener("click" and given event:
            if window.isConnected && window.ws:
                set msgHosts to Object()
                set msgHosts.type to "dht_get"
                set msgHosts.key to "network:host_nodes"
                send_msg(window.ws and JSON.stringify(msgHosts))
        )

    set dhtForm to document.getElementById("dht-form")
    if dhtForm:
        dhtForm.addEventListener("submit" and given event:
            event.preventDefault()
            if not window.isConnected:
                return 0
            set action to document.getElementById("dht-action").value
            set key to document.getElementById("dht-key-input").value.trim()
            if not key:
                return 0
            if action == "store":
                set val to document.getElementById("dht-value-input").value.trim()
                if not val:
                    return 0
                set msg to Object()
                set msg.type to "dht_store"
                set msg.key to key
                set msg.value to val
                send_msg(window.ws and JSON.stringify(msg))
            else:
                set msg to Object()
                set msg.type to "dht_get"
                set msg.key to key
                send_msg(window.ws and JSON.stringify(msg))
        )
        
    set nameForm to document.getElementById("name-form")
    if nameForm:
        nameForm.addEventListener("submit" and given event:
            event.preventDefault()
            if not window.isConnected:
                return 0
            set action to document.getElementById("name-action").value
            set name to document.getElementById("name-input").value.trim()
            if not name:
                return 0
            window.localStorage.setItem("ernode_last_name" and name)
            if action == "register":
                set msg to Object()
                set msg.type to "name_register"
                set msg.name to name
                send_msg(window.ws and JSON.stringify(msg))
                # Re-fetch identity once the registry write has committed so the
                # Identity tab's "Registered Name" updates immediately (not only on
                # the next status poll).
                setTimeout(given dummy:
                    set msgId to Object()
                    set msgId.type to "get_identity"
                    send_msg(window.ws and JSON.stringify(msgId))
                and 800)
            else:
                set msg to Object()
                set msg.type to "name_resolve"
                set msg.name to name
                send_msg(window.ws and JSON.stringify(msg))
        )
        
    set btnDecayMemory to document.getElementById("btn-decay-memory")
    if btnDecayMemory:
        btnDecayMemory.addEventListener("click" and given event:
            if not window.isConnected:
                return 0
            # Consolidate + decay the Hebbian synapses; the daemon returns the updated
            # memory graph, which the agent_memory renderer picks up to refresh the view.
            set msg to Object()
            set msg.type to "decay_memory"
            send_msg(window.ws and JSON.stringify(msg))
        )
        
    set turingForm to document.getElementById("turing-form")
    if turingForm:
        turingForm.addEventListener("submit" and given event:
            event.preventDefault()
            if not window.isConnected:
                return 0
            set action to document.getElementById("turing-action").value
            set args to document.getElementById("turing-args").value.trim()
            
            set cmdStr to f"Action: turing_grid_op([\"{action}\", \"{args}\"])"
            if action == "read" || action == "execute":
                set cmdStr to f"Action: turing_grid_op([\"{action}\", \"\"])"
                
            set turingLog to document.getElementById("turing-log")
            set entry to document.createElement("div")
            set entry.className to "turing-log-entry"
            set entry.textContent to f"Running: {cmdStr}..."
            turingLog.appendChild(entry)
            set turingLog.scrollTop to turingLog.scrollHeight
            
            set msg to Object()
            set msg.type to "ai_prompt"
            set msg.prompt to cmdStr
            set msg.system to "Execute the tool action directly."
            send_msg(window.ws and JSON.stringify(msg))
            
            setTimeout(given dummy:
                set msgGrid to Object()
                set msgGrid.type to "get_turing_grid"
                send_msg(window.ws and JSON.stringify(msgGrid))
            and 1200)
        )
        
    set btnTriggerAutonomy to document.getElementById("btn-trigger-autonomy")
    if btnTriggerAutonomy:
        btnTriggerAutonomy.addEventListener("click" and given event:
            if not window.isConnected:
                return 0
            set_prop(window.aiLoader.style and "display" and "flex")
            set msg to Object()
            set msg.type to "run_autonomy_agent"
            send_msg(window.ws and JSON.stringify(msg))
        )
        
    set guideBtns to document.querySelectorAll(".guide-menu-item")
    set guideSections to document.querySelectorAll(".guide-section")
    guideBtns.forEach(given btn:
        btn.addEventListener("click" and given event:
            set targetGuide to btn.getAttribute("data-guide")
            guideBtns.forEach(given b:
                b.classList.remove("active")
            )
            guideSections.forEach(given s:
                s.classList.remove("active")
            )
            btn.classList.add("active")
            
            set targetSec to document.getElementById(f"guide-{targetGuide}")
            if targetSec:
                targetSec.classList.add("active")
        )
    )

    set btnNewSession to document.getElementById("btn-new-session")
    if btnNewSession:
        btnNewSession.addEventListener("click" and given event:
            set newId to f"session_{Date.now()}"
            set newTitle to prompt("Enter session title:" and "New Session")
            if not newTitle || newTitle.trim().length == 0:
                return 0
            set msg to Object()
            set msg.type to "session_new"
            set msg.id to newId
            set msg.title to newTitle.trim()
            set msg.model to window.selectedAiModel || ""
            set msg.system to window.aiSystemPrompt.value
            send_msg(window.ws and JSON.stringify(msg))
        )

    # Platform settings click/change listeners
    set btnSaveDiscord to document.getElementById("btn-save-discord")
    if btnSaveDiscord:
        btnSaveDiscord.addEventListener("click" and given event:
            savePlatformConfig("discord")
        )
        
    set toggleDiscord to document.getElementById("toggle-discord")
    if toggleDiscord:
        toggleDiscord.addEventListener("change" and given event:
            handlePlatformToggle("discord")
        )
        
    set btnSaveWhatsapp to document.getElementById("btn-save-whatsapp")
    if btnSaveWhatsapp:
        btnSaveWhatsapp.addEventListener("click" and given event:
            savePlatformConfig("whatsapp")
        )
        
    set toggleWhatsapp to document.getElementById("toggle-whatsapp")
    if toggleWhatsapp:
        toggleWhatsapp.addEventListener("change" and given event:
            handlePlatformToggle("whatsapp")
        )
        
    set btnSaveTelegram to document.getElementById("btn-save-telegram")
    if btnSaveTelegram:
        btnSaveTelegram.addEventListener("click" and given event:
            savePlatformConfig("telegram")
        )
        
    set toggleTelegram to document.getElementById("toggle-telegram")
    if toggleTelegram:
        toggleTelegram.addEventListener("change" and given event:
            handlePlatformToggle("telegram")
        )
        
    set btnAddPlugin to document.getElementById("btn-add-plugin")
    if btnAddPlugin:
        btnAddPlugin.addEventListener("click" and given event:
            registerPlugin()
        )
        
    set btnSavePrompts to document.getElementById("btn-save-prompts")
    if btnSavePrompts:
        btnSavePrompts.addEventListener("click" and given event:
            savePromptsConfig()
        )

    set btnSaveSystemConfig to document.getElementById("btn-save-system-config")
    if btnSaveSystemConfig:
        btnSaveSystemConfig.addEventListener("click" and given event:
            saveSystemConfig()
        )

    set subTabs to document.querySelectorAll(".settings-tab-btn")
    if subTabs:
        subTabs.forEach(given tab:
            tab.addEventListener("click" and given event:
                subTabs.forEach(given t:
                    t.classList.remove("active")
                )
                tab.classList.add("active")
                
                set tabContents to document.querySelectorAll(".settings-tab-content")
                if tabContents:
                    tabContents.forEach(given content:
                        set ok to set_prop(content.style and "display" and "none")
                        content.classList.remove("active")
                    )
                
                set tabAttr to tab.getAttribute("data-settings-tab")
                set targetId to concat("settings-" and tabAttr)
                set targetEl to document.getElementById(targetId)
                if targetEl:
                    set ok to set_prop(targetEl.style and "display" and "block")
                    targetEl.classList.add("active")
            )
        )

    initGitDec()
    initGuide()
    handleDisconnect()
    connectDaemon()
    renderChatHistory(window.activeChannel)
    
    # Pre-fill names input from local storage if available
    set savedLastName to window.localStorage.getItem("ernode_last_name")
    if savedLastName:
        set nameInput to document.getElementById("name-input")
        if nameInput && not nameInput.value:
            set nameInput.value to savedLastName

    # Restore last active tab
    set savedTab to window.localStorage.getItem("ernode_active_tab")
    if savedTab:
        set targetBtn to document.querySelector(f".nav-item[data-tab='{savedTab}']")
        if targetBtn:
            set clickFn to get_list(targetBtn and "click")
            clickFn.call(targetBtn)
            
    # Set activeSessionId to default initially, but let connectDaemon request the last active one
    set window.activeSessionId to "default"
    
    return 0
