# ErnosDecent Node Console Client
# Component: decent_web/app.ep
# Auto-compiled to app.js via: ernos emit app.ep --js -o app.js

# ---- Helper functions for keyword compatibility ----
define set_prop with target and key and value:
    set setFn to get_list(Reflect and "set")
    setFn.call(Reflect and target and key and value)

define send_msg with ws and payload:
    if not ws:
        return 0
    set readyState to get_list(ws and "readyState")
    if readyState != 1:
        return 0
    set sendFn to get_list(ws and "send")
    sendFn.call(ws and payload)

define substring with str and start and len:
    if not str:
        return ""
    set subFn to get_list(str and "substring")
    return subFn.call(str and start and start + len)

define string_index_of with str and sub:
    if not str:
        return 0 - 1
    set idxFn to get_list(str and "indexOf")
    return idxFn.call(str and sub)

define string_length with str:
    if not str:
        return 0
    return get_list(str and "length")

# ---- HTML Escaping for XSS Prevention ----
define escapeHTML with str:
    if not str:
        return ""
    set reClass to get_list(window and "RegExp")
    set reAmp to Reflect.construct(reClass and ["&", "g"])
    set reLt to Reflect.construct(reClass and ["<", "g"])
    set reGt to Reflect.construct(reClass and [">", "g"])
    set reQuot to Reflect.construct(reClass and ["\"", "g"])
    set reApos to Reflect.construct(reClass and ["'", "g"])
    set res to str.replace(reAmp and "&amp;").replace(reLt and "&lt;").replace(reGt and "&gt;").replace(reQuot and "&quot;").replace(reApos and "&#039;")
    return res

define decodeHTMLEntities with str:
    if not str:
        return ""
    set temp to document.createElement("textarea")
    set temp.innerHTML to str
    return temp.value

# ---- Controls state helper ----
define setControlsEnabled with enabled:
    set inputs to document.querySelectorAll("input, button[type='submit'], .btn-primary, .btn-secondary")
    inputs.forEach(given el:
        set isNav to el.closest(".nav-menu")
        if not isNav:
            if not enabled:
                set el.disabled to true
                set el.title to "Connect to daemon to use this feature"
            else:
                set el.disabled to false
                set el.title to ""
    )

# ---- Disconnect handler ----
define handleDisconnect:
    set window.isConnected to false
    set indicator to document.getElementById("connection-indicator")
    indicator.classList.remove("online")
    indicator.classList.add("offline")
    set statusText to indicator.querySelector(".status-text")
    set statusText.textContent to "Daemon Offline"
    
    set headerDid to document.getElementById("header-did")
    set headerDid.textContent to "—"
    
    set nodeRole to document.getElementById("node-role")
    set nodeRole.textContent to "—"
    
    set nodeTerm to document.getElementById("node-term")
    set nodeTerm.textContent to "—"
    
    set nodePeers to document.getElementById("node-peers")
    set nodePeers.textContent to "—"
    
    set dhtSize to document.getElementById("dht-size")
    set dhtSize.textContent to "—"
    
    set didFull to document.getElementById("did-full-string")
    set didFull.textContent to "Connect to daemon to view identity"
    
    set walletVal to document.getElementById("wallet-val")
    set walletVal.textContent to "—"
    
    set chunkCount to document.getElementById("chunk-count")
    set chunkCount.textContent to "—"
    
    setControlsEnabled(false)

# ---- Connect to daemon ----
define connectDaemon:
    set port to window.location.port || "8080"
    set hostname to window.location.hostname || "127.0.0.1"
    if hostname equals "localhost":
        set hostname to "127.0.0.1"
    set wsUrl to f"ws://{hostname}:{port}/ws"
    console.log(f"Connecting to Daemon: {wsUrl}")
    
    set wsClass to get_list(window and "WebSocket")
    set ws to Reflect.construct(wsClass and [wsUrl])
    set window.ws to ws
    
    set ws.onopen to given event:
        console.log("Connected to ErnosDecent Daemon.")
        set window.isConnected to true
        set indicator to document.getElementById("connection-indicator")
        indicator.classList.remove("offline")
        indicator.classList.add("online")
        set statusText to indicator.querySelector(".status-text")
        set statusText.textContent to "Daemon Connected"
        setControlsEnabled(true)
        
        # Fetch status and other dashboard info on connection
        set msgStatus to Object()
        set msgStatus.type to "get_status"
        send_msg(ws and JSON.stringify(msgStatus))
        
        set msgIdentity to Object()
        set msgIdentity.type to "get_identity"
        send_msg(ws and JSON.stringify(msgIdentity))
        
        set msgWallet to Object()
        set msgWallet.type to "get_wallet"
        send_msg(ws and JSON.stringify(msgWallet))
        
        set msgStorage to Object()
        set msgStorage.type to "get_storage"
        send_msg(ws and JSON.stringify(msgStorage))
        
        set msgPool to Object()
        set msgPool.type to "get_pool"
        send_msg(ws and JSON.stringify(msgPool))
        
        set msgNetwork to Object()
        set msgNetwork.type to "get_network"
        send_msg(ws and JSON.stringify(msgNetwork))
        
        set msgHosts to Object()
        set msgHosts.type to "dht_get"
        set msgHosts.key to "network:host_nodes"
        send_msg(ws and JSON.stringify(msgHosts))
        
        set msgMemory to Object()
        set msgMemory.type to "get_agent_memory"
        send_msg(ws and JSON.stringify(msgMemory))
        
        set msgTuring to Object()
        set msgTuring.type to "get_turing_grid"
        send_msg(ws and JSON.stringify(msgTuring))
        
        set msgModels to Object()
        set msgModels.type to "get_ai_models"
        send_msg(ws and JSON.stringify(msgModels))
        
        set msgPlatforms to Object()
        set msgPlatforms.type to "get_platforms"
        send_msg(ws and JSON.stringify(msgPlatforms))
        
        set msgPlugins to Object()
        set msgPlugins.type to "get_plugins"
        send_msg(ws and JSON.stringify(msgPlugins))
        
        set msgPrompts to Object()
        set msgPrompts.type to "get_prompts"
        send_msg(ws and JSON.stringify(msgPrompts))
        
        set msgSys to Object()
        set msgSys.type to "get_system_config"
        send_msg(ws and JSON.stringify(msgSys))
        
        set msgSessActive to Object()
        set msgSessActive.type to "session_get_active"
        send_msg(ws and JSON.stringify(msgSessActive))
        
        # If currently on the guide tab, load the active document
        set activeTab to window.localStorage.getItem("ernode_active_tab") || "overview"
        if activeTab == "guide":
            set navList to document.getElementById("guide-nav-list")
            if navList:
                set activeBtn to navList.querySelector("button.active")
                if activeBtn:
                    set file to activeBtn.getAttribute("data-guide-file")
                    set msg to Object()
                    set msg.type to "gitdec_get_repo_file"
                    set msg.repo_id to "ErnosDecent"
                    set msg.filename to file
                    send_msg(ws and JSON.stringify(msg))
        
    set ws.onmessage to given event:
        set dataStr to event.data
        set msg to JSON.parse(dataStr)
        handleDaemonMessage(msg)
        
    set ws.onclose to given event:
        console.log("Daemon disconnected.")
        handleDisconnect()
        setTimeout(given dummy:
            connectDaemon()
        and 5000)
        
    set ws.onerror to given event:
        console.log("Daemon connection error.")

# ---- Local Storage Persistence Helpers ----
define saveChatMessage with chanName and sender and text and type and timeStr:
    set historyStr to window.localStorage.getItem("ernode_chat_history")
    set historyObj to Object()
    if historyStr:
        set historyObj to JSON.parse(historyStr)
        
    set hasChannel to Reflect.has(historyObj and chanName)
    if not hasChannel:
        set_prop(historyObj and chanName and [])
        
    set channelList to get_list(historyObj and chanName)
    set msg to Object()
    set msg.sender to sender
    set msg.text to text
    set msg.type to type
    set msg.time to timeStr
    channelList.push(msg)
    
    window.localStorage.setItem("ernode_chat_history" and JSON.stringify(historyObj))

define saveAiMessage with sender and text and type and timeStr:
    set historyStr to window.localStorage.getItem("ernode_ai_history")
    set historyList to []
    if historyStr:
        set historyList to JSON.parse(historyStr)
        
    set msg to Object()
    set msg.sender to sender
    set msg.text to text
    set msg.type to type
    set msg.time to timeStr
    historyList.push(msg)
    
    window.localStorage.setItem("ernode_ai_history" and JSON.stringify(historyList))

define renderChatHistory with chanName:
    set window.chatContainer.innerHTML to ""
    set historyStr to window.localStorage.getItem("ernode_chat_history")
    if not historyStr:
        appendMessage(window.chatContainer and "system" and f"Welcome to #{chanName}" and "received")
        return 0
        
    set historyObj to JSON.parse(historyStr)
    set hasChannel to Reflect.has(historyObj and chanName)
    if not hasChannel:
        appendMessage(window.chatContainer and "system" and f"Welcome to #{chanName}" and "received")
        return 0
        
    set channelList to get_list(historyObj and chanName)
    channelList.forEach(given msg:
        appendMessageRaw(window.chatContainer and msg.sender and msg.text and msg.type and msg.time)
    )
    return 0

define renderAiHistory:
    set window.aiContainer.innerHTML to ""
    set historyStr to window.localStorage.getItem("ernode_ai_history")
    if not historyStr:
        appendMessageRaw(window.aiContainer and "AI (Local Model)" and "Greetings! I am loaded inside the decent_ai subsystem. My weights are decoded using Float32 fixed-point attention queries. Ask me anything." and "received" and "00:00")
        return 0
        
    set historyList to JSON.parse(historyStr)
    historyList.forEach(given msg:
        appendMessageRaw(window.aiContainer and msg.sender and msg.text and msg.type and msg.time)
    )
    return 0

# ---- Append chat messages ----
define appendMessageRaw with container and sender and text and type and timeStr:
    set bubble to document.createElement("div")
    set bubble.className to f"chat-bubble {type}"
    set escapedText to escapeHTML(text).replace("\n" and "<br>")
    set bubble.innerHTML to f"<span class=\"sender\">{escapeHTML(sender)}</span><p>{escapedText}</p><span class=\"timestamp\">{escapeHTML(timeStr)}</span>"
    container.appendChild(bubble)
    set container.scrollTop to container.scrollHeight

define appendMessage with container and sender and text and type:
    set dateStr to Date()
    set timeParts to dateStr.split(" ")
    set timeStrSec to get_list(timeParts and 4)
    set secParts to timeStrSec.split(":")
    set timeStr to concat(get_list(secParts and 0) and concat(":" and get_list(secParts and 1)))
    
    appendMessageRaw(container and sender and text and type and timeStr)
    
    if container == window.chatContainer:
        saveChatMessage(window.activeChannel and sender and text and type and timeStr)
    else if container == window.aiContainer:
        saveAiMessage(sender and text and type and timeStr)

# ---- Append streaming AI token ----
define appendAiToken with token:
    if not window.currentAiResponseBubble:
        set bubble to document.createElement("div")
        set bubble.className to "chat-bubble received ai-bot"
        set bubble.innerHTML to "<span class=\"sender\">AI (Local Model)</span><p class=\"ai-text\"></p>"
        window.aiContainer.appendChild(bubble)
        set window.currentAiResponseBubble to bubble
        
    set textNode to window.currentAiResponseBubble.querySelector(".ai-text")
    set textNode.textContent to concat(textNode.textContent and token)
    set window.aiContainer.scrollTop to window.aiContainer.scrollHeight

# ---- Tool Pending Approval Card ----
define appendApprovalCard with toolName and summary:
    set bubble to document.createElement("div")
    set bubble.className to "chat-bubble received"
    set_prop(bubble.style and "border" and "1px solid rgba(245, 158, 11, 0.3)")
    set_prop(bubble.style and "background" and "rgba(245, 158, 11, 0.05)")
    set_prop(bubble.style and "animation" and "approvalPulse 2s infinite")
    
    set escapedTool to escapeHTML(toolName)
    set escapedSummary to escapeHTML(summary)
    
    set contentHtml to f"<span class=\"sender\">System (Approval Required)</span>"
    set contentHtml to concat(contentHtml and f"<p>🔒 <strong>Tool Approval Required</strong><br><code class=\"small-code\">Tool: {escapedTool}</code><br><code class=\"small-code\">Args: {escapedSummary}</code></p>")
    
    set actionsHtml to "<div class=\"approval-actions\">"
    set actionsHtml to concat(actionsHtml and "<button class=\"btn-approve\" id=\"btn-approve-action\">Approve ✅</button>")
    set actionsHtml to concat(actionsHtml and "<button class=\"btn-approve-all\" id=\"btn-approve-all-action\">Approve All ⚡</button>")
    set actionsHtml to concat(actionsHtml and "<button class=\"btn-deny\" id=\"btn-deny-action\">Deny ❌</button>")
    set actionsHtml to concat(actionsHtml and "</div>")
    
    set_prop(bubble and "innerHTML" and concat(contentHtml and actionsHtml))
    window.aiContainer.appendChild(bubble)
    set_prop(window.aiContainer and "scrollTop" and window.aiContainer.scrollHeight)
    
    set_prop(window.aiInput and "disabled" and true)
    set btnSubmit to document.getElementById("btn-submit-ai")
    if btnSubmit != 0:
        set_prop(btnSubmit and "disabled" and true)
        
    set approveBtn to bubble.querySelector("#btn-approve-action")
    set approveAllBtn to bubble.querySelector("#btn-approve-all-action")
    set denyBtn to bubble.querySelector("#btn-deny-action")
    
    set approveBtn.onclick to given f:
        set_prop(approveBtn and "disabled" and true)
        set_prop(approveAllBtn and "disabled" and true)
        set_prop(denyBtn and "disabled" and true)
        set_prop(bubble.style and "animation" and "none")
        set_prop(bubble.style and "border" and "1px solid rgba(16, 185, 129, 0.3)")
        set_prop(bubble.style and "background" and "rgba(16, 185, 129, 0.03)")
        
        set actionsDiv to bubble.querySelector(".approval-actions")
        set_prop(actionsDiv.style and "display" and "none")
        
        set statusText to document.createElement("div")
        set statusText.className to "status-label"
        set_prop(statusText.style and "color" and "var(--neon-green)")
        set_prop(statusText.style and "padding" and "10px 18px")
        set_prop(statusText and "innerHTML" and f"✅ Approved `{escapedTool}` — executing...")
        bubble.appendChild(statusText)
        
        set approveMsg to "{\"type\":\"tool_approve\"}"
        set_prop(window.ws and "send" and approveMsg)
        
    set approveAllBtn.onclick to given f:
        set_prop(approveBtn and "disabled" and true)
        set_prop(approveAllBtn and "disabled" and true)
        set_prop(denyBtn and "disabled" and true)
        set_prop(bubble.style and "animation" and "none")
        set_prop(bubble.style and "border" and "1px solid rgba(168, 85, 247, 0.3)")
        set_prop(bubble.style and "background" and "rgba(168, 85, 247, 0.03)")
        
        set actionsDiv to bubble.querySelector(".approval-actions")
        set_prop(actionsDiv.style and "display" and "none")
        
        set statusText to document.createElement("div")
        set statusText.className to "status-label"
        set_prop(statusText.style and "color" and "var(--neon-purple)")
        set_prop(statusText.style and "padding" and "10px 18px")
        set_prop(statusText and "innerHTML" and f"⚡ Approved `{escapedTool}` and all subsequent actions — executing...")
        bubble.appendChild(statusText)
        
        set approveAllMsg to "{\"type\":\"tool_approve_all\"}"
        set_prop(window.ws and "send" and approveAllMsg)
        
    set denyBtn.onclick to given f:
        set_prop(approveBtn and "disabled" and true)
        set_prop(approveAllBtn and "disabled" and true)
        set_prop(denyBtn and "disabled" and true)
        set_prop(bubble.style and "animation" and "none")
        set_prop(bubble.style and "border" and "1px solid rgba(239, 68, 68, 0.3)")
        set_prop(bubble.style and "background" and "rgba(239, 68, 68, 0.03)")
        
        set actionsDiv to bubble.querySelector(".approval-actions")
        set_prop(actionsDiv.style and "display" and "none")
        
        set statusText to document.createElement("div")
        set statusText.className to "status-label"
        set_prop(statusText.style and "color" and "var(--neon-red)")
        set_prop(statusText.style and "padding" and "10px 18px")
        set_prop(statusText and "innerHTML" and f"❌ Denied `{escapedTool}` — cancelled.")
        bubble.appendChild(statusText)
        
        set_prop(window.aiInput and "disabled" and false)
        if btnSubmit != 0:
            set_prop(btnSubmit and "disabled" and false)
            
        set denyMsg to "{\"type\":\"tool_deny\"}"
        set_prop(window.ws and "send" and denyMsg)

define updateHostsTableUI with jsonStr:
    set tbody to document.getElementById("hosts-table-body")
    if not tbody:
        return 0
    set tbody.innerHTML to ""
    set list to JSON.parse(jsonStr)
    if not list || list.length == 0:
        set tbody.innerHTML to "<tr><td colspan=\"5\" style=\"text-align: center; color: var(--text-muted); padding: 20px;\">No active host nodes registered in the DHT network tree.</td></tr>"
        return 0
        
    set electedHostEl to document.getElementById("ui-current-elected-host")
    if electedHostEl:
        if list.length > 0:
            set primary to get_list(list and 0)
            set electedHostEl.textContent to f"{primary.node_id} ({primary.address}:{primary.port})"
        else:
            set electedHostEl.textContent to "—"
            
    set i to 0
    list.forEach(given host:
        set i to i + 1
        set row to document.createElement("tr")
        set rankText to i.toString()
        if i == 1:
            set rankText to "🏆 1 (Primary Host)"
        
        set priorityText to "Standard"
        if host.is_static == 1:
            set priorityText to "⭐ Static Preferred"
            
        set lastSeenDiff to Math.max(0 and Math.floor(Date.now() / 1000) - host.last_seen)
        set lastSeenText to f"{lastSeenDiff}s ago"
        if lastSeenDiff > 120:
            set lastSeenText to "Stale"
            
        set row.innerHTML to f"<td>{rankText}</td><td><code>{escapeHTML(host.node_id)}</code><br><span style=\"font-size:0.8rem;color:var(--text-muted);\">{escapeHTML(host.address)}:{host.port}</span></td><td>{host.connections} connection(s)</td><td>{priorityText}</td><td>{lastSeenText}</td>"
        tbody.appendChild(row)
    )
    return 0

# ---- DHT log handler ----
define handleDhtResult with msg:
    if msg.key == "network:host_nodes":
        if msg.found:
            updateHostsTableUI(msg.value)
        return 0
        
    set dhtLog to document.getElementById("dht-log")
    if not dhtLog:
        return 0
    set entry to document.createElement("div")
    set entry.className to "dht-log-entry"
    if msg.action == "store":
        set entry.textContent to f"✓ Stored key: {msg.key}"
        set entry.style.color to "var(--color-success)"
    else if msg.action == "get":
        if msg.found:
            set entry.textContent to f"↓ {msg.key} = {msg.value}"
            set entry.style.color to "var(--color-accent)"
        else:
            set entry.textContent to f"✗ Key not found: {msg.key}"
            set entry.style.color to "var(--color-error)"
    dhtLog.appendChild(entry)
    set dhtLog.scrollTop to dhtLog.scrollHeight

# ---- Name resolution log handler ----
define handleNameResult with msg:
    set nameLog to document.getElementById("name-log")
    if not nameLog:
        return 0
    set entry to document.createElement("div")
    set entry.className to "name-log-entry"
    if msg.action == "register":
        if msg.success:
            set entry.textContent to f"✓ Registered: {msg.name} → {substring(msg.did and 0 and 25)}..."
            set entry.style.color to "var(--color-success)"
            # Immediately reflect the newly registered name in the header chip.
            # It otherwise only updates on the next periodic status push, so the
            # user sees the old name until then.
            set headerDid to document.getElementById("header-did")
            if headerDid:
                set headerDid.textContent to msg.name
        else:
            set entry.textContent to f"✗ Registration failed: {msg.name}"
            set entry.style.color to "var(--color-error)"
    else if msg.action == "resolve":
        if msg.found:
            set entry.textContent to f"↓ {msg.name} → {msg.did}"
            set entry.style.color to "var(--color-accent)"
        else:
            set entry.textContent to f"✗ Name not found: {msg.name}"
            set entry.style.color to "var(--color-error)"
    nameLog.appendChild(entry)
    set nameLog.scrollTop to nameLog.scrollHeight

# ---- Select AI model ----
define selectAiModel with modelName and skipSave:
    set window.selectedAiModel to modelName
    
    set aiModelSelect to document.getElementById("ai-model-select")
    if aiModelSelect:
        set aiModelSelect.value to modelName
        
    if window.aiModelsListContainer:
        set btns to window.aiModelsListContainer.querySelectorAll("[data-model]")
        btns.forEach(given btn:
            if btn.getAttribute("data-model") == modelName:
                btn.classList.add("active")
            else:
                btn.classList.remove("active")
        )
    set modelText to modelName || "Auto (Cascade)"
    appendMessage(window.aiContainer and "system" and f"Model set to: {modelText}" and "received")
    
    if not skipSave && window.ws && window.ws.readyState == 1:
        set msg to Object()
        set msg.type to "session_update_model"
        set msg.id to window.activeSessionId
        set msg.model to modelName
        send_msg(window.ws and JSON.stringify(msg))

# ---- Update models dropdown and sidebar list ----
define updateAiModelsUI with models:
    set aiModelSelect to document.getElementById("ai-model-select")
    if aiModelSelect:
        set currentSelected to window.selectedAiModel
        set aiModelSelect.innerHTML to "<option value=\"\">Auto (Cascade)</option>"
        models.forEach(given m:
            set opt to document.createElement("option")
            set opt.value to m
            set opt.textContent to m
            aiModelSelect.appendChild(opt)
        )
        set aiModelSelect.value to currentSelected
        
        if currentSelected:
            set isIncluded to models.includes(currentSelected)
            if not isIncluded:
                set window.selectedAiModel to ""
                set aiModelSelect.value to ""
                
    if window.aiModelsListContainer:
        set activeClass to ""
        if window.selectedAiModel == "":
            set activeClass to "active"
        set window.aiModelsListContainer.innerHTML to f"<button class=\"room-item {activeClass}\" data-model=\"\"><span class=\"model-name\">Auto (Cascade)</span><span class=\"model-meta\">GGUF • Active</span></button>"
        
        models.forEach(given m:
            set itemClass to ""
            if window.selectedAiModel == m:
                set itemClass to "active"
            set btn to document.createElement("button")
            set btn.className to f"room-item {itemClass}"
            btn.setAttribute("data-model" and m)
            set btn.innerHTML to f"<span class=\"model-name\">{escapeHTML(m)}</span><span class=\"model-meta\">Detected • Local</span>"
            window.aiModelsListContainer.appendChild(btn)
        )

# ---- Session Management Client Helpers ----
define selectSession with id:
    set window.activeSessionId to id
    if window.isConnected && window.ws:
        set msg to Object()
        set msg.type to "session_switch"
        set msg.id to id
        send_msg(window.ws and JSON.stringify(msg))
    return 0

define renameSession with id and title:
    set msg to Object()
    set msg.type to "session_rename"
    set msg.id to id
    set msg.title to title
    send_msg(window.ws and JSON.stringify(msg))
    return 0

define deleteSession with id:
    set msg to Object()
    set msg.type to "session_delete"
    set msg.id to id
    send_msg(window.ws and JSON.stringify(msg))
    return 0

define updatePlatformsUI:
    if not window.platforms:
        return 0
        
    # Discord
    set discordConfig to window.platforms.discord
    if discordConfig:
        set discStatus to document.getElementById("overview-discord-status")
        if discStatus:
            set statusText to discordConfig.status || "OFFLINE"
            if discordConfig.enabled == false || discordConfig.enabled == 0:
                set statusText to "DISABLED"
            set discStatus.textContent to statusText.toUpperCase()
            if statusText == "ONLINE":
                set_prop(discStatus.style and "background" and "rgba(16, 185, 129, 0.15)")
                set_prop(discStatus.style and "color" and "var(--neon-green)")
                set_prop(discStatus.style and "border" and "1px solid rgba(16, 185, 129, 0.3)")
            else:
                set_prop(discStatus.style and "background" and "rgba(239, 68, 68, 0.15)")
                set_prop(discStatus.style and "color" and "var(--neon-red)")
                set_prop(discStatus.style and "border" and "1px solid rgba(239, 68, 68, 0.3)")
        
        set discToken to document.getElementById("overview-discord-token")
        if discToken:
            set discToken.value to discordConfig.token || ""
            
        set discChannel to document.getElementById("overview-discord-channel")
        if discChannel:
            set discChannel.value to get_list(discordConfig and "channel") || ""
            
        set discToggle to document.getElementById("toggle-discord")
        if discToggle:
            set discToggle.checked to discordConfig.enabled || false

    # WhatsApp
    set whatsappConfig to window.platforms.whatsapp
    if whatsappConfig:
        set waStatus to document.getElementById("overview-whatsapp-status")
        if waStatus:
            set statusText to whatsappConfig.status || "OFFLINE"
            if whatsappConfig.enabled == false || whatsappConfig.enabled == 0:
                set statusText to "DISABLED"
            set waStatus.textContent to statusText.toUpperCase()
            if statusText == "ONLINE":
                set_prop(waStatus.style and "background" and "rgba(16, 185, 129, 0.15)")
                set_prop(waStatus.style and "color" and "var(--neon-green)")
                set_prop(waStatus.style and "border" and "1px solid rgba(16, 185, 129, 0.3)")
            else:
                set_prop(waStatus.style and "background" and "rgba(239, 68, 68, 0.15)")
                set_prop(waStatus.style and "color" and "var(--neon-red)")
                set_prop(waStatus.style and "border" and "1px solid rgba(239, 68, 68, 0.3)")
        
        set waToken to document.getElementById("overview-whatsapp-token")
        if waToken:
            set waToken.value to whatsappConfig.token || ""
            
        set waPhoneId to document.getElementById("overview-whatsapp-phone-id")
        if waPhoneId:
            set waPhoneId.value to whatsappConfig.phone_id || ""
            
        set waToggle to document.getElementById("toggle-whatsapp")
        if waToggle:
            set waToggle.checked to whatsappConfig.enabled || false

    # Telegram
    set telegramConfig to window.platforms.telegram
    if telegramConfig:
        set tgStatus to document.getElementById("overview-telegram-status")
        if tgStatus:
            set statusText to telegramConfig.status || "OFFLINE"
            if telegramConfig.enabled == false || telegramConfig.enabled == 0:
                set statusText to "DISABLED"
            set tgStatus.textContent to statusText.toUpperCase()
            if statusText == "ONLINE":
                set_prop(tgStatus.style and "background" and "rgba(16, 185, 129, 0.15)")
                set_prop(tgStatus.style and "color" and "var(--neon-green)")
                set_prop(tgStatus.style and "border" and "1px solid rgba(16, 185, 129, 0.3)")
            else:
                set_prop(tgStatus.style and "background" and "rgba(239, 68, 68, 0.15)")
                set_prop(tgStatus.style and "color" and "var(--neon-red)")
                set_prop(tgStatus.style and "border" and "1px solid rgba(239, 68, 68, 0.3)")
        
        set tgToken to document.getElementById("overview-telegram-token")
        if tgToken:
            set tgToken.value to telegramConfig.token || ""
            
        set tgToggle to document.getElementById("toggle-telegram")
        if tgToggle:
            set tgToggle.checked to telegramConfig.enabled || false
            
    return 0

define updatePromptsUI:
    if not window.prompts:
        return 0
    set kernelArea to document.getElementById("settings-prompt-kernel")
    if kernelArea:
        set kernelArea.value to window.prompts.kernel || ""
    set personaArea to document.getElementById("settings-prompt-persona")
    if personaArea:
        set personaArea.value to window.prompts.persona || ""
    set observerArea to document.getElementById("settings-prompt-observer")
    if observerArea:
        set observerArea.value to window.prompts.observer || ""
    return 0

define showPromptsStatus with text as Str and isSuccess as Int:
    set el to document.getElementById("settings-status-msg")
    if el:
        set el.textContent to text
        set el.className to "status-msg"
        if isSuccess == 1:
            el.classList.add("success")
        else:
            el.classList.add("error")
        setTimeout(given dummy:
            set el.textContent to ""
            set el.className to "status-msg"
        and 4000)
    return 0

define renderPluginsUI:
    set body to document.getElementById("plugins-list-body")
    if not body:
        return 0
        
    set body.innerHTML to ""
    if not window.plugins || window.plugins.length == 0:
        set body.innerHTML to "<tr><td colspan=\"5\" class=\"empty-state\">No user plugins registered. Click Register Plugin to add custom extensions.</td></tr>"
        return 0
        
    window.plugins.forEach(given p:
        set row to document.createElement("tr")
        
        set badgeClass to "badge"
        set badgeStyle to "font-size: 11px; padding: 2px 8px; border-radius: 4px; font-weight: 600;"
        set statusText to "INACTIVE"
        if p.enabled:
            set statusText to "ACTIVE"
            set badgeStyle to concat(badgeStyle and " background: rgba(16, 185, 129, 0.15); color: var(--neon-green); border: 1px solid rgba(16, 185, 129, 0.3);")
        else:
            set badgeStyle to concat(badgeStyle and " background: rgba(239, 68, 68, 0.15); color: var(--neon-red); border: 1px solid rgba(239, 68, 68, 0.3);")
            
        set toggleText to "Enable"
        set toggleBtnStyle to "padding: 4px 8px; font-size: 11px; border-radius: 4px; cursor: pointer; border: 1px solid var(--border-color); background: rgba(16, 185, 129, 0.1); color: var(--neon-green); margin-right: 6px;"
        if p.enabled:
            set toggleText to "Disable"
            set toggleBtnStyle to "padding: 4px 8px; font-size: 11px; border-radius: 4px; cursor: pointer; border: 1px solid var(--border-color); background: rgba(239, 68, 68, 0.1); color: var(--neon-red); margin-right: 6px;"
            
        set deleteBtnStyle to "padding: 4px 8px; font-size: 11px; border-radius: 4px; cursor: pointer; border: 1px solid rgba(239, 68, 68, 0.3); background: rgba(239, 68, 68, 0.15); color: var(--neon-red);"
        
        set row.innerHTML to f"<td><strong>{escapeHTML(p.name)}</strong></td><td><code>{escapeHTML(p.endpoint)}</code></td><td>{escapeHTML(p.desc)}</td><td><span class=\"{badgeClass}\" style=\"{badgeStyle}\">{statusText}</span></td><td><button class=\"toggle-plugin-btn\" data-id=\"{escapeHTML(p.id)}\" style=\"{toggleBtnStyle}\">{toggleText}</button><button class=\"delete-plugin-btn\" data-id=\"{escapeHTML(p.id)}\" style=\"{deleteBtnStyle}\">Delete</button></td>"
        body.appendChild(row)
    )
    
    set toggleBtns to body.querySelectorAll(".toggle-plugin-btn")
    toggleBtns.forEach(given btn:
        btn.addEventListener("click" and given event:
            set id to btn.getAttribute("data-id")
            togglePlugin(id)
        )
    )
    
    set deleteBtns to body.querySelectorAll(".delete-plugin-btn")
    deleteBtns.forEach(given btn:
        btn.addEventListener("click" and given event:
            set id to btn.getAttribute("data-id")
            deletePlugin(id)
        )
    )
    
    return 0

define togglePlugin with id:
    if not window.plugins:
        return 0
    window.plugins.forEach(given p:
        if p.id == id:
            set p.enabled to not p.enabled
            if p.enabled:
                set p.status to "ACTIVE"
            else:
                set p.status to "INACTIVE"
    )
    savePluginsSettings()
    renderPluginsUI()
    return 0

define deletePlugin with id:
    if not window.plugins:
        return 0
    if not confirm("Are you sure you want to delete this plugin?"):
        return 0
    set filtered to []
    window.plugins.forEach(given p:
        if p.id != id:
            filtered.push(p)
    )
    set window.plugins to filtered
    savePluginsSettings()
    renderPluginsUI()
    return 0

define savePluginsSettings:
    if not window.ws || not window.isConnected:
        return 0
    set payload to Object()
    set payload.type to "save_plugins"
    set payload.data to JSON.stringify(window.plugins)
    send_msg(window.ws and JSON.stringify(payload))
    return 0

define savePromptsConfig:
    if not window.ws || not window.isConnected:
        showPromptsStatus("Error: Daemon disconnected." and 0)
        return 0
    set kernelArea to document.getElementById("settings-prompt-kernel")
    set personaArea to document.getElementById("settings-prompt-persona")
    set observerArea to document.getElementById("settings-prompt-observer")
    if not kernelArea || not personaArea || not observerArea:
        return 0
    set window.prompts to Object()
    set window.prompts.kernel to kernelArea.value
    set window.prompts.persona to personaArea.value
    set window.prompts.observer to observerArea.value
    
    set payload to Object()
    set payload.type to "save_prompts"
    set payload.data to JSON.stringify(window.prompts)
    send_msg(window.ws and JSON.stringify(payload))
    return 0

