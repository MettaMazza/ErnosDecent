import "decent_net/security"
import "stdlib/string"

# Negative-control for B2: the rate limiter must actually throttle a flooding IP
# (it was previously dead-wired) and must isolate per-IP (one attacker does not
# block everyone). RATE_LIMIT_MAX_REQUESTS = 100 per 60s window.
define main returning Int:
    set rl to security_create_rate_limiter()
    set allowed_count to 0
    set blocked_count to 0
    set i to 0
    repeat while i < 150:
        set r to security_check_rate_limit(rl and "1.2.3.4")
        if r > 0:
            set allowed_count to allowed_count + 1
        else:
            set blocked_count to blocked_count + 1
        set i to i + 1
    display concat("allowed=" and int_to_string(allowed_count))
    display concat("blocked=" and int_to_string(blocked_count))

    set other to security_check_rate_limit(rl and "9.9.9.9")
    display concat("other_ip_first=" and int_to_string(other))

    if blocked_count > 0 and also other > 0:
        display "[PASS] limiter throttles a flooding IP and isolates per-IP"
    else:
        display "[FAIL] limiter did not throttle or wrongly blocked another IP"
