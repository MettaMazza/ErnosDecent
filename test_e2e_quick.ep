import "collections"
import "string"
import "decent_id/keys"
import "decent_id/did"
import "decent_msg/message"
import "decent_store/content"
import "decent_money/ledger"
import "decent_net/dht"
import "decent_net/relay"

define main returning Int:
    display "pre-init"
    set ok to init_crypto()
    display "post-init"
    set r1 to test_6_1()
    display f"6.1 = {r1}"
    return 0

define test_6_1 returning Int:
    display "  6.1 start"
    set identity to create_identity()
    set id_err to map_get_val(identity and "error")
    display f"  6.1 done, err={id_err}"
    return 1
